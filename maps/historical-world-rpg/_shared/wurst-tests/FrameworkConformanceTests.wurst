package FrameworkConformanceTests

import FrameworkPorts
import ConformanceData
import ScenarioData
import CampaignRegistration
import CampaignHandoff
import CampaignSaveManager
import CampaignTimeline
import CommandRouter
import PlayableCampaignRuntime
import PlayableTrade
import WarcraftRegionalRuntime
import WarcraftRpgRuntime
import MilitarySettlementRuntime
import ReligionRuntime
import PlayablePiracy

/** Both campaigns execute this exact contract. Only native observations and
 * storage are recorded; registration, authority, transactions and codecs are
 * the production packages. Catalogue trimming bounds the interpreter's 20s
 * deadline AFTER production registration, without inventing replacement data. */
class ConformanceSession
	StartupPorts ports = new StartupPorts()
	CampaignClock clock = configureCampaignTimeline()
	CampaignHandoff handoff
	NewCampaignOriginController selector
	PlayableCampaignServices campaign
	PlayableTradeRuntime trade
	construct(StartupStorage cache, StartupStorage saves, string mapId)
		ports.handoff = cache
		ports.clock = clock
		installCampaignClock(clock)
		ports.selectorIdentity = new PlayerCampaignIdentity()
		handoff = new CampaignHandoff(cache, ports)
		selector = new NewCampaignOriginController(8, ports, ports.selectorIdentity)
		selector.setObserver(handoff)
		configureGeneratedOrigins(selector)
		campaign = new PlayableCampaignServices(new WarcraftRegionalAdapter(), clock, mapId, new ReligionRuntime(ports), saves, handoff, ports, ports)
		campaign.state.arrivalPathing = ports
		campaign.registerPiracyRuntime(createGeneratedPiracyRuntime())
		trade = registerCampaignDomains(campaign, new WarcraftRpgRuntime(ports), new MilitarySettlementRuntime(ports), ports)
		campaign.registered.assertTrue()
		let rpg = campaign.state.rpg
		rpg.interactions.actors = ports
		let hero = rpg.heroes.get(CONTRACT_HERO)
		(hero != null).assertTrue()
		for i = 0 to rpg.heroes.count - 1
			if rpg.heroes.heroes[i] != hero
				destroy rpg.heroes.heroes[i]
			rpg.heroes.heroes[i] = null
		rpg.heroes.heroes[0] = hero
		rpg.heroes.count = 1
		let questDefinition = rpg.journal.get(CONTRACT_QUEST)
		(questDefinition != null).assertTrue()
		for i = 0 to rpg.journal.count - 1
			if rpg.journal.quests[i] != questDefinition
				destroy rpg.journal.quests[i]
			rpg.journal.quests[i] = null
		rpg.journal.quests[0] = questDefinition
		rpg.journal.count = 1
		for i = 0 to rpg.treasures.count - 1
			destroy rpg.treasures.treasures[i]
			rpg.treasures.treasures[i] = null
		rpg.treasures.count = 0
		let m = campaign.state.militarySettlements
		let originalCount = m.settlementCount
		let origin = selector.find(CONTRACT_ORIGIN)
		var kept = 0
		for i = 0 to originalCount - 1
			let city = m.settlements[i]
			if city.id == CONTRACT_SETTLEMENT or city.id == origin.settlementId
				m.settlements[kept] = city
				kept++
			else
				destroy city
		m.definitions = null
		m.settlementCount = kept
		for i = kept to originalCount - 1
			m.settlements[i] = null
		kept = 0
		let forceCount = m.forceCount
		for i = 0 to forceCount - 1
			let runtimeForce = m.forces[i]
			var retain = false
			for j = 0 to m.settlementCount - 1
				if runtimeForce.id == "core:" + m.settlements[j].id or runtimeForce.id == "defense:" + m.settlements[j].id + ":primary"
					retain = true
			if retain
				m.forces[kept] = runtimeForce
				kept++
			else
				destroy runtimeForce
		m.forceCount = kept
		for i = kept to forceCount - 1
			m.forces[i] = null
		for i = 0 to m.administratorCount - 1
			destroy m.administrators[i]
			m.administrators[i] = null
		m.administratorCount = 0
		for i = 0 to m.traditionCount - 1
			destroy m.traditions[i]
			m.traditions[i] = null
		m.traditionCount = 0
		for i = 0 to m.conflictCount - 1
			destroy m.conflicts[i]
			m.conflicts[i] = null
		m.conflictCount = 0
		m.initialConflicts = ""
		let countries = campaign.countries
		let owner = m.settlements[m.settlementIndex(CONTRACT_SETTLEMENT)].legalOwnerId
		let countryCount = countries.polityCount
		kept = 0
		for i = 0 to countryCount - 1
			let id = countries.polityIds[i]
			if id == CONTRACT_ORIGIN or id == CONTRACT_CAPTOR or id == owner
				countries.polityIds[kept] = id
				countries.known[kept] = countries.known[i]
				countries.treasury[kept] = countries.treasury[i]
				countries.materialStock[kept] = countries.materialStock[i]
				countries.reputation[kept] = countries.reputation[i]
				countries.favor[kept] = countries.favor[i]
				countries.contribution[kept] = countries.contribution[i]
				kept++
		countries.polityCount = kept
		for i = kept to countryCount - 1
			countries.polityIds[i] = ""
		let profileCount = countries.profileCount
		kept = 0
		for i = 0 to profileCount - 1
			let profile = countries.profiles[i]
			if countries.polityIndex(profile.polityId) >= 0
				countries.profiles[kept] = profile
				kept++
			else
				destroy profile
		countries.profileCount = kept
		for i = kept to profileCount - 1
			countries.profiles[i] = null
		let market = trade.findMarket(CONTRACT_SETTLEMENT, CONTRACT_GOOD)
		(market != null).assertTrue()
		for i = 0 to trade.marketCount - 1
			if trade.markets[i] != market
				destroy trade.markets[i]
			trade.markets[i] = null
		trade.markets[0] = market
		trade.marketCount = 1
		for i = 1 to trade.storeCount - 1
			destroy trade.stores[i]
			trade.stores[i] = null
		trade.storeCount = 1
		campaign.finishRegistration().assertTrue()
	function start()
		selector.choose(CONTRACT_ORIGIN).assertTrue()
		resume()
	function resume()
		let started = campaign.startup()
		if not started
			print(campaign.diagnostic() + "; " + campaign.state.diagnostic())
		started.assertTrue()
		ports.activePlayers.assertEquals(1)
	function atSettlement()
		let point = campaign.state.rpg.interactions.get(CONTRACT_SETTLEMENT)
		(point != null).assertTrue()
		ports.memberX[0] = point.x
		ports.memberY[0] = point.y

@test function productionCampaignContentContract()
	let cache = new StartupStorage()
	let saves = new StartupStorage()
	let f = new ConformanceSession(cache, saves, CONTRACT_SOURCE_MAP)
	f.start()
	f.campaign.identity.originId().assertEquals(CONTRACT_ORIGIN)
	f.handoff.readRequest().status.assertEquals("consumed")
	let rpg = f.campaign.state.rpg
	rpg.heroes.get(CONTRACT_HERO).recruited.assertTrue()
	f.atSettlement()
	// The local RPG action uses generated positions and the physical adapter.
	rpg.interact(Player(0), CONTRACT_SETTLEMENT, f.clock.campaignDay()).assertTrue()
	let acceptedQuest = rpg.journal.get(CONTRACT_QUEST)
	acceptedQuest.state.assertEquals(QUEST_ACTIVE)
	acceptedQuest.graph.activeStageId.assertEquals(acceptedQuest.graph.initialStageId)
	acceptedQuest.graph.completedObjectiveIds.assertEquals("")
	// Scenario-specific objectives are not proven by accepting at the board.
	// The partial graph then survives the shared save and travel contract below.
	rpg.turnInQuest(Player(0), CONTRACT_QUEST, CONTRACT_HERO, f.clock.campaignDay(), 30).assertFalse()
	let itemId = CONTRACT_ITEM
	rpg.inventory.grant(itemId).assertTrue()
	f.trade.chooseMarket(Player(0), CONTRACT_SETTLEMENT, CONTRACT_GOOD)
	f.trade.chooseStore(Player(0), f.trade.hold.id)
	let stock = f.trade.markets[0].stock
	let money = f.trade.hold.money
	let marketMoney = f.trade.markets[0].money
	f.trade.markets[0].baseUnitPrice.assertEquals(CONTRACT_GOOD_BASE_PRICE)
	let charge = f.trade.markets[0].quoteAmount(1, true)
	f.trade.exchange(Player(0), "buy", 1)
	f.trade.hold.cargo.assertEquals(1)
	f.trade.markets[0].stock.assertEquals(stock - 1)
	f.trade.hold.money.assertEquals(money - charge)
	f.trade.markets[0].money.assertEquals(marketMoney + charge)
	(charge > 0).assertTrue()
	// Occupation uses the registered military authority and retains legal title.
	let military = f.campaign.state.militarySettlements
	let city = military.settlements[military.settlementIndex(CONTRACT_SETTLEMENT)]
	let owner = city.legalOwnerId
	military.registerConflictMember("conformance_conflict", CONTRACT_CAPTOR, 1).assertTrue()
	military.registerConflictMember("conformance_conflict", city.controllerId, 2).assertTrue()
	military.capture(CONTRACT_SETTLEMENT, CONTRACT_CAPTOR, 100.).assertTrue()
	city.legalOwnerId.assertEquals(owner)
	city.controllerId.assertEquals(CONTRACT_CAPTOR)
	f.clock.subscribe(f.ports)
	f.clock.setPaused(false)
	f.clock.advanceTo(f.clock.occurrences[0].day + 1).assertTrue()
	(f.ports.events > 0).assertTrue()
	let savedDay = f.clock.campaignDay()
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "conformance").assertTrue()
	let saved = f.campaign.state.captureAuthoritativeState()
	f.trade.hold.money = 0
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.campaign.state.captureAuthoritativeState().assertEquals(saved)
	rpg.inventory.owns(itemId).assertTrue()
	let beforeEvents = f.ports.events
	f.clock.setPaused(false)
	f.clock.advanceTo(savedDay).assertTrue()
	f.ports.events.assertEquals(beforeEvents)
	// Checkpoint, handoff and destination reconstruction share production code.
	let boundary = f.campaign.state.boundary(CONTRACT_BOUNDARY)
	(boundary != null).assertTrue()
	f.campaign.travel.transition(boundary, CONTRACT_POSITION, "conformance").assertTrue()
	let destination = new ConformanceSession(cache, saves, CONTRACT_DESTINATION_MAP)
	destination.resume()
	destination.campaign.identity.originId().assertEquals(CONTRACT_ORIGIN)
	destination.campaign.identity.physicalMapId().assertEquals(CONTRACT_DESTINATION_MAP)
	destination.clock.campaignDay().assertEquals(savedDay)
	destination.trade.hold.cargo.assertEquals(1)
	let resumedQuest = destination.campaign.state.rpg.journal.get(CONTRACT_QUEST)
	resumedQuest.state.assertEquals(QUEST_ACTIVE)
	resumedQuest.graph.activeStageId.assertEquals(acceptedQuest.graph.activeStageId)
	resumedQuest.graph.completedObjectiveIds.assertEquals("")
	destination.campaign.state.rpg.inventory.owns(itemId).assertTrue()
	let restored = destination.campaign.state.militarySettlements
	restored.settlements[restored.settlementIndex(CONTRACT_SETTLEMENT)].controllerId.assertEquals(CONTRACT_CAPTOR)
	restored.settlements[restored.settlementIndex(CONTRACT_SETTLEMENT)].legalOwnerId.assertEquals(owner)
	destination.campaign.saves.save(SAVE_SLOT_MANUAL, 2, "destination").assertTrue()
	destination.campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertTrue()
	destination.ports.activePlayers.assertEquals(1)
