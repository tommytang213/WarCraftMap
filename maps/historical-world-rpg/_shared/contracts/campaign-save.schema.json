{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-save.schema.json",
  "title": "WarCraftMap campaign save envelope",
  "type": "object",
  "required": ["format", "schemaVersion", "buildVersion", "scenario", "slot", "createdAt", "state", "integrity"],
  "properties": {
    "format": {"const": "warcraftmap_campaign"},
    "schemaVersion": {"const": 8},
    "buildVersion": {"type": "string", "minLength": 1},
    "scenario": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "slot": {
      "oneOf": [
        {"type": "object", "required": ["kind", "id", "index"], "properties": {"kind": {"const": "autosave"}, "id": {"pattern": "^autosave_(0[1-9]|1[0-5])$"}, "index": {"type": "integer", "minimum": 1, "maximum": 15}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "id", "index"], "properties": {"kind": {"const": "manual"}, "id": {"pattern": "^manual_[0-9]{2,}$"}, "index": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "session_start"}, "id": {"const": "session_start"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "major_milestone"}, "id": {"const": "major_milestone"}}, "additionalProperties": false}
      ]
    },
    "createdAt": {"type": "string", "minLength": 1},
    "state": {"type": "object", "required": ["world", "players"], "properties": {"world": {"type": "object"}, "players": {"type": "object"}}, "additionalProperties": false},
    "integrity": {"type": "object", "required": ["algorithm", "canonicalization", "checksum"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "json_utf8_sorted_v1"}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
