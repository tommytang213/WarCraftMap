{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warcraftmap.local/schemas/world.schema.json",
  "title": "Historical World Scenario",
  "type": "object",
  "required": [
    "schemaVersion",
    "timeline",
    "navigationZones",
    "navigationSafePoints",
    "activeUnitNavigationStates",
    "regionalGeography",
    "polities",
    "provinces",
    "settlements",
    "settlementServiceDefinitions",
    "settlementObjectTemplates",
    "cityCores",
    "defenseLayouts",
    "officers",
    "strategicUnits",
    "armies",
    "fleets",
    "traits",
    "skills",
    "professions",
    "personalQuests",
    "characters",
    "relationshipThresholds",
    "companionRelationships",
    "researchBranches",
    "technologies",
    "institutions",
    "polityResearchStates",
    "provinceAdoptionStates",
    "titleStyles",
    "titleGrants",
    "territorialHoldings",
    "allegiances",
    "quests",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "navigationZones": {
      "type": "array",
      "items": {
        "$ref": "navigation.schema.json#/$defs/navigationZone"
      }
    },
    "navigationSafePoints": {
      "type": "array",
      "items": {
        "$ref": "navigation.schema.json#/$defs/safePoint"
      }
    },
    "activeUnitNavigationStates": {
      "type": "array",
      "items": {
        "$ref": "navigation.schema.json#/$defs/activeUnitNavigationState"
      }
    },
    "regionalGeography": {"$ref": "regional-navigation.schema.json#/$defs/regionalGeography"},
    "schemaVersion": {
      "type": "integer",
      "const": 9
    },
    "polities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/polity"
      }
    },
    "provinces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/province"
      }
    },
    "settlements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settlement"
      }
    },
    "settlementServiceDefinitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/settlementServiceDefinition"}
    },
    "settlementObjectTemplates": {
      "type": "array",
      "items": {"$ref": "#/$defs/settlementObjectTemplate"}
    },
    "cityCores": {
      "type": "array",
      "items": {"$ref": "#/$defs/cityCore"}
    },
    "defenseLayouts": {
      "type": "array",
      "items": {"$ref": "#/$defs/defenseLayout"}
    },
    "officers": {
      "type": "array",
      "items": {
        "$ref": "military.schema.json#/$defs/officer"
      }
    },
    "strategicUnits": {
      "type": "array",
      "items": {
        "$ref": "military.schema.json#/$defs/strategicUnit"
      }
    },
    "armies": {
      "type": "array",
      "items": {
        "$ref": "military.schema.json#/$defs/army"
      }
    },
    "fleets": {
      "type": "array",
      "items": {
        "$ref": "military.schema.json#/$defs/fleet"
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/displayDefinition"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/displayDefinition"
      }
    },
    "professions": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/displayDefinition"
      }
    },
    "personalQuests": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/personalQuest"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/character"
      }
    },
    "relationshipThresholds": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/relationshipThreshold"
      }
    },
    "companionRelationships": {
      "type": "array",
      "items": {
        "$ref": "character.schema.json#/$defs/companionRelationship"
      }
    },
    "officeTypes": {"type":"array","items":{"$ref":"administration.schema.json#/$defs/officeType"}},
    "officeNameCultures": {"type":"array","items":{"$ref":"administration.schema.json#/$defs/nameCulture"}},
    "politicalOffices": {"type":"array","items":{"$ref":"administration.schema.json#/$defs/office"}},
    "researchBranches": {
      "type": "array",
      "items": {
        "$ref": "technology.schema.json#/$defs/researchBranch"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "$ref": "technology.schema.json#/$defs/researchNode"
      }
    },
    "institutions": {
      "type": "array",
      "items": {
        "$ref": "technology.schema.json#/$defs/researchNode"
      }
    },
    "polityResearchStates": {
      "type": "array",
      "items": {
        "$ref": "technology.schema.json#/$defs/polityResearchState"
      }
    },
    "provinceAdoptionStates": {
      "type": "array",
      "items": {
        "$ref": "technology.schema.json#/$defs/provinceAdoptionState"
      }
    },
    "titleStyles": {
      "type": "array",
      "items": {
        "$ref": "government.schema.json#/$defs/titleStyle"
      }
    },
    "titleGrants": {
      "type": "array",
      "items": {
        "$ref": "government.schema.json#/$defs/titleGrant"
      }
    },
    "territorialHoldings": {
      "type": "array",
      "items": {
        "$ref": "government.schema.json#/$defs/territorialHolding"
      }
    },
    "allegiances": {
      "type": "array",
      "items": {
        "$ref": "government.schema.json#/$defs/allegiance"
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "$ref": "quest-event.schema.json#/$defs/quest"
      }
    },
    "questLocations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "quest-event.schema.json#/$defs/event"
      }
    },
    "timeline": {
      "$ref": "timeline.schema.json"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "polity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "adjective",
        "sovereignTier",
        "capitalSettlementId",
        "provinceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "adjective": {
          "type": "string",
          "minLength": 1
        },
        "sovereignTier": {
          "type": "string",
          "enum": [
            "none",
            "knight",
            "baron",
            "count",
            "marquess",
            "duke",
            "prince",
            "king",
            "emperor"
          ]
        },
        "nativeSovereignTitle": {
          "type": "string"
        },
        "capitalSettlementId": {
          "$ref": "#/$defs/stableId"
        },
        "provinceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "specialUnitIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "province": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "administrativeType",
        "legalOwnerPolityId",
        "controllerPolityId",
        "settlementIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "administrativeType": {
          "type": "string",
          "minLength": 1
        },
        "legalOwnerPolityId": {
          "$ref": "#/$defs/stableId"
        },
        "controllerPolityId": {
          "$ref": "#/$defs/stableId"
        },
        "settlementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "provinceId",
        "legalOwnerPolityId",
        "controllerPolityId",
        "capturable",
        "civilianFacilitiesInvulnerable",
        "serviceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "capital",
            "major_city",
            "city",
            "town",
            "village",
            "port",
            "fort",
            "trading_post",
            "mission",
            "mine",
            "plantation",
            "pirate_haven"
          ]
        },
        "provinceId": {
          "$ref": "#/$defs/stableId"
        },
        "legalOwnerPolityId": {
          "$ref": "#/$defs/stableId"
        },
        "controllerPolityId": {
          "$ref": "#/$defs/stableId"
        },
        "capturable": {
          "type": "boolean"
        },
        "civilianFacilitiesInvulnerable": {
          "const": true
        },
        "navigationZoneId": {
          "$ref": "#/$defs/stableId"
        },
        "cityCoreId": {
          "$ref": "#/$defs/stableId"
        },
        "defenseLayoutId": {
          "$ref": "#/$defs/stableId"
        },
        "serviceIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "regionalInstanceId": {"$ref": "#/$defs/stableId"},
        "localPosition": {"$ref": "regional-navigation.schema.json#/$defs/position"},
        "terrainClass": {"enum": ["coast", "riverbank", "plains", "upland", "forest", "steppe"]},
        "roleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "portAccess": {"type": "object", "additionalProperties": false, "required": ["maritimeZoneId", "access"], "properties": {"maritimeZoneId": {"$ref": "#/$defs/stableId"}, "access": {"$ref": "#/$defs/stableId"}}},
        "activation": {"type": "object", "additionalProperties": false, "required": ["runtimeState", "representationTemplateId", "deterministicKey"], "properties": {"runtimeState": {"const": "abstract"}, "representationTemplateId": {"$ref": "#/$defs/stableId"}, "deterministicKey": {"$ref": "#/$defs/stableId"}}},
        "productionRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}
      }
    },
    "settlementServiceDefinition": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "name": {"type": "string", "minLength": 1}}
    },
    "settlementObjectTemplate": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "kind": {"enum": ["city_core", "defense"]}}
    },
    "cityCore": {
      "type": "object", "additionalProperties": false, "required": ["id", "objectTemplateId"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "objectTemplateId": {"$ref": "#/$defs/stableId"}}
    },
    "defenseLayout": {
      "type": "object", "additionalProperties": false, "required": ["id", "objectTemplateIds"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "objectTemplateIds": {"type": "array", "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true}}
    }
  }
}
