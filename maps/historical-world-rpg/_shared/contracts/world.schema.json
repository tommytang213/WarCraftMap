{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warcraftmap.local/schemas/world.schema.json",
  "title": "Historical World Scenario",
  "type": "object",
  "required": ["schemaVersion", "polities", "provinces", "settlements", "officers", "strategicUnits", "armies", "fleets", "traits", "skills", "professions", "personalQuests", "characters", "relationshipThresholds", "companionRelationships", "researchBranches", "technologies", "institutions", "polityResearchStates", "provinceAdoptionStates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 3 },
    "polities": {
      "type": "array",
      "items": { "$ref": "#/$defs/polity" }
    },
    "provinces": {
      "type": "array",
      "items": { "$ref": "#/$defs/province" }
    },
    "settlements": {
      "type": "array",
      "items": { "$ref": "#/$defs/settlement" }
    },
    "officers": {
      "type": "array",
      "items": { "$ref": "military.schema.json#/$defs/officer" }
    },
    "strategicUnits": {
      "type": "array",
      "items": { "$ref": "military.schema.json#/$defs/strategicUnit" }
    },
    "armies": {
      "type": "array",
      "items": { "$ref": "military.schema.json#/$defs/army" }
    },
    "fleets": {
      "type": "array",
      "items": { "$ref": "military.schema.json#/$defs/fleet" }
    },
    "traits": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/displayDefinition" } },
    "skills": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/displayDefinition" } },
    "professions": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/displayDefinition" } },
    "personalQuests": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/personalQuest" } },
    "characters": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/character" } },
    "relationshipThresholds": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/relationshipThreshold" } },
    "companionRelationships": { "type": "array", "items": { "$ref": "character.schema.json#/$defs/companionRelationship" } },
    "researchBranches": { "type": "array", "items": { "$ref": "technology.schema.json#/$defs/researchBranch" } },
    "technologies": { "type": "array", "items": { "$ref": "technology.schema.json#/$defs/researchNode" } },
    "institutions": { "type": "array", "items": { "$ref": "technology.schema.json#/$defs/researchNode" } },
    "polityResearchStates": { "type": "array", "items": { "$ref": "technology.schema.json#/$defs/polityResearchState" } },
    "provinceAdoptionStates": { "type": "array", "items": { "$ref": "technology.schema.json#/$defs/provinceAdoptionState" } }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "polity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "adjective", "sovereignTier",
        "capitalSettlementId", "provinceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "adjective": { "type": "string", "minLength": 1 },
        "sovereignTier": {
          "type": "string",
          "enum": [
            "none", "knight", "baron", "count", "marquess",
            "duke", "prince", "king", "emperor"
          ]
        },
        "nativeSovereignTitle": { "type": "string" },
        "capitalSettlementId": { "$ref": "#/$defs/stableId" },
        "provinceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "specialUnitIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "province": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "administrativeType", "legalOwnerPolityId",
        "controllerPolityId", "settlementIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "administrativeType": { "type": "string", "minLength": 1 },
        "legalOwnerPolityId": { "$ref": "#/$defs/stableId" },
        "controllerPolityId": { "$ref": "#/$defs/stableId" },
        "settlementIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "provinceId", "legalOwnerPolityId",
        "controllerPolityId", "capturable", "civilianFacilitiesInvulnerable"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "capital", "major_city", "city", "town", "village",
            "port", "fort", "trading_post", "mission", "mine",
            "plantation", "pirate_haven"
          ]
        },
        "provinceId": { "$ref": "#/$defs/stableId" },
        "legalOwnerPolityId": { "$ref": "#/$defs/stableId" },
        "controllerPolityId": { "$ref": "#/$defs/stableId" },
        "capturable": { "type": "boolean" },
        "civilianFacilitiesInvulnerable": { "const": true },
        "navigationZoneId": { "$ref": "#/$defs/stableId" },
        "cityCoreId": { "$ref": "#/$defs/stableId" },
        "defenseLayoutId": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
