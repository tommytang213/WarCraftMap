{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://warcraftmap.local/schemas/player-items.schema.json",
  "title":"Scenario player-use item catalogue",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","rarities","effects","merchantArchetypes","equipmentSets","items","historicalEvidence"],
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "named":{"type":"object","required":["id"],"properties":{"id":{"$ref":"#/$defs/id"}}}
  },
  "properties":{
    "schemaVersion":{"const":1},
    "rarities":{"type":"array","minItems":2,"items":{"allOf":[{"$ref":"#/$defs/named"},{"required":["name","rank"],"properties":{"name":{"type":"string"},"rank":{"type":"integer","minimum":0}}}]}},
    "effects":{"type":"array","items":{"$ref":"#/$defs/named"}},
    "merchantArchetypes":{"type":"array","minItems":1,"items":{"allOf":[{"$ref":"#/$defs/named"},{"required":["stockLimit"],"properties":{"stockLimit":{"type":"integer","minimum":1,"maximum":30}}}]}},
    "equipmentSets":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/named"},{"required":["name","itemTypeIds","thresholds"],"properties":{"name":{"type":"string"},"itemTypeIds":{"$ref":"#/$defs/ids"},"thresholds":{"type":"array"}}}]}},
    "historicalEvidence":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/named"},{"required":["citation","note"]}]}},
    "items":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/named"},{"required":["name","category","itemLevel","rarityId","provenance","unique","requirements","enhancement","merchant","comparison","evidenceIds"],"properties":{"itemLevel":{"type":"integer","minimum":1,"maximum":300},"rarityId":{"$ref":"#/$defs/id"},"unique":{"type":"boolean"},"evidenceIds":{"$ref":"#/$defs/ids"},"enhancement":{"type":"object","required":["maxRank","maxRestoration"],"properties":{"maxRank":{"type":"integer","minimum":0,"maximum":10},"maxRestoration":{"type":"integer","minimum":0,"maximum":5}}}}}]}}
  }
}
