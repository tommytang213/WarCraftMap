{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warcraftmap.local/schemas/timeline.schema.json",
  "title": "Generic deterministic campaign timeline",
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 64},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "recurrence": {"type": "object", "additionalProperties": false, "required": ["unit", "interval", "untilDate"], "properties": {"unit": {"enum": ["days", "months", "years"]}, "interval": {"type": "integer", "minimum": 1}, "untilDate": {"$ref": "#/$defs/date"}, "maxOccurrences": {"type": "integer", "minimum": 1}}}
  },
  "type": "object", "additionalProperties": false,
  "required": ["calendar", "startDate", "endDate", "initialDate", "eras", "eventDefinitions", "schedules"],
  "properties": {
    "calendar": {"const": "proleptic_gregorian"}, "startDate": {"$ref": "#/$defs/date"}, "endDate": {"$ref": "#/$defs/date"}, "initialDate": {"$ref": "#/$defs/date"},
    "eras": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "startDate", "endDate"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "name": {"type": "string", "minLength": 1}, "startDate": {"$ref": "#/$defs/date"}, "endDate": {"$ref": "#/$defs/date"}}}},
    "eventDefinitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/stableId"}}}},
    "schedules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "eventId", "firstDate", "priority"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "eventId": {"$ref": "#/$defs/stableId"}, "firstDate": {"$ref": "#/$defs/date"}, "priority": {"type": "integer", "description": "Ascending priority then schedule ID determines simultaneous ordering."}, "eraId": {"$ref": "#/$defs/stableId"}, "recurrence": {"$ref": "#/$defs/recurrence"}}}}
  }
}
