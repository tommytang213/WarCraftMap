{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warcraftmap.local/schemas/combat-effect-bindings.schema.json",
  "title": "Versioned scenario combat effect bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "balanceNote",
    "attackPredicates",
    "attributes",
    "effects",
    "researchEffects"
  ],
  "properties": {
    "format": {
      "const": "warcraftmap_combat_effect_bindings_v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "balanceNote": {
      "type": "string",
      "minLength": 1
    },
    "attackPredicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryId",
          "weaponIds",
          "abilityIds",
          "rosterCategories",
          "movementClassIds",
          "requiresShip",
          "nativeTemplates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "weaponIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "abilityIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rosterCategories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "movementClassIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiresShip": {
            "type": "boolean"
          },
          "nativeTemplates": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "normal",
                "pierce",
                "siege"
              ]
            }
          }
        }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryId",
          "numerator",
          "denominator",
          "attackId",
          "stat"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "numerator": {
            "type": "integer"
          },
          "denominator": {
            "type": "integer",
            "minimum": 1
          },
          "attackId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stat": {
            "enum": [
              "damage",
              "discipline",
              null
            ]
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "categoryId",
          "milestoneId",
          "threshold",
          "mode",
          "replacesEffectId",
          "description",
          "contributions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "milestoneId": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "enum": [
              "additive",
              "upgrade",
              "replacement"
            ]
          },
          "replacesEffectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "contributions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stat",
                "attackId",
                "basisPoints"
              ],
              "properties": {
                "stat": {
                  "enum": [
                    "damage",
                    "resistance"
                  ]
                },
                "attackId": {
                  "type": "string",
                  "minLength": 1
                },
                "basisPoints": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "researchEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "entitlement",
          "recipient",
          "stat",
          "basisPoints",
          "description"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "entitlement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "contentId"
            ],
            "properties": {
              "kind": {
                "const": "modifier"
              },
              "contentId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "recipient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "categoryId"
            ],
            "properties": {
              "kind": {
                "const": "force_category"
              },
              "categoryId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "stat": {
            "const": "discipline"
          },
          "basisPoints": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
