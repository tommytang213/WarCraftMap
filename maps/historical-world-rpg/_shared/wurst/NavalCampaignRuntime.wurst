package NavalCampaignRuntime

import CampaignTimeline
import NavalServices
import CivicCampaignRuntime
import initlater PlayableCampaignRuntime
import MilitarySettlementRuntime
import initlater PlayableTrade
import WarcraftRpgRuntime
import CommandRouter

function navalDate(int day) returns string
	let date = new CampaignClock(day, day, day, 1.)
	let result = I2S(date.campaignYear()) + "/" + I2S(date.campaignMonth()) + "/" + I2S(date.campaignMonthDay())
	destroy date
	return result

/** Player and AI call this same resource-conserving campaign adapter. */
public class NavalBuildQuote
	string owner
	string yard
	string blueprint
	string fingerprint
	construct(string owner, string yard, string blueprint, string fingerprint)
		this.owner = owner
		this.yard = yard
		this.blueprint = blueprint
		this.fingerprint = fingerprint

public class NavalCampaignRuntime
	PlayableCampaignState campaign
	CampaignCivicEconomy economy
	NavalResearchEffects effects
	construct(PlayableCampaignState campaign, PlayableTradeRuntime trade, NavalResearchEffects effects)
		this.campaign = campaign
		this.effects = effects
		economy = new CampaignCivicEconomy(campaign, trade)
	function marketOpen(string id, string good) returns boolean
		let stock = economy.trade.findMarket(id, good)
		return stock != null and not stock.blockaded and not stock.occupiedByHostile
	function accessible(NavalYard d, string owner) returns boolean
		let ledger = campaign.militarySettlements.naval
		let city = economy.settlement(d.id)
		return marketOpen(d.id, ledger.woodGood) and marketOpen(d.id, ledger.ironGood) and marketOpen(d.id, ledger.supplyGood) and city != null and city.manpower > 0 and economy.lawful(d.id) and economy.controller(d.id) == owner and economy.accessible(d.id) and campaign.rpg.technologies.isUnlocked(owner, d.prerequisite)
	function requirements(NavalYard d, string owner) returns boolean
		// Recheck the authored stable IDs each construction day, including
		// revoked prerequisites. Walking the whole technology catalogue here
		// makes long replay depend on unrelated catalogue size.
		var remaining = d.researchRequirements
		while remaining != ""
			let cut = remaining.indexOf("|")
			if cut < 0
				return false
			let id = SubString(remaining, 0, cut)
			if id != "" and not campaign.rpg.technologies.isUnlocked(owner, id)
				return false
			remaining = SubString(remaining, cut + 1, StringLength(remaining))
		return true
	function actor(NavalYard d, string owner, string id) returns RuntimeForce
		let m = campaign.militarySettlements
		let i = m.forceIndex(id)
		if i < 0
			return null
		let f = m.forces[i]
		if f.controllerId != owner or f.kind != FORCE_FLEET or not f.active or f.strength <= 0 or f.hull.integrity <= 0 or f.navigation.pending() or m.science.busy(id) or not militaryMapMatches(f.regionId, d.mapId) or (f.x - d.x) * (f.x - d.x) + (f.y - d.y) * (f.y - d.y) > 128. * 128. or not m.naval.hullType(f.unitTypeId)
			return null
		return f
	/** Validate the complete multi-resource bill before the first mutation. */
	function pay(NavalYard d, string owner, int money, int wood, int metalUnits, int provisions, int crew) returns boolean
		return bill(d, owner, money, wood, metalUnits, provisions, crew, true)
	function bill(NavalYard d, string owner, int money, int wood, int metalUnits, int provisions, int crew, boolean spend) returns boolean
		let p = campaign.countries.polityIndex(owner)
		let s = economy.settlement(d.id)
		let ledger = campaign.militarySettlements.naval
		let woodStock = economy.trade.findMarket(d.id, ledger.woodGood)
		let metal = economy.trade.findMarket(d.id, ledger.ironGood)
		let food = economy.trade.findMarket(d.id, ledger.supplyGood)
		if p < 0 or money < 1 or campaign.countries.treasury[p] < money or s == null or s.manpower <= crew or s.supply < provisions
			return false
		if wood > 0 and (woodStock == null or woodStock.blockaded or woodStock.occupiedByHostile or woodStock.stock < wood)
			return false
		if metalUnits > 0 and (metal == null or metal.blockaded or metal.occupiedByHostile or metal.stock < metalUnits)
			return false
		if provisions > 0 and (food == null or food.blockaded or food.occupiedByHostile or food.stock < provisions)
			return false
		if not spend
			return true
		charge(p, money)
		s.manpower -= crew
		s.supply -= provisions
		if wood > 0
			woodStock.stock -= wood
		if metalUnits > 0
			metal.stock -= metalUnits
		if provisions > 0
			food.stock -= provisions
		return true
	/** Successful payment boundary, after every component of the bill validates. */
	private function charge(int polity, int money)
		campaign.countries.treasury[polity] -= money
	function buildFingerprint(string owner, string id, string blueprint) returns string
		let p = campaign.countries.polityIndex(owner)
		var result = owner + "|" + id + "|" + blueprint + "|" + I2S(campaign.clock.currentDay) + "|" + I2S(campaign.countries.treasury[p]) + "|" + campaign.militarySettlements.snapshot() + "|" + campaign.rpg.captureState()
		let l = campaign.militarySettlements.naval
		let h = l.blueprint(blueprint, l.yards[l.index(id)])
		result += "|" + I2S(h.price) + "," + I2S(h.crew) + "," + I2S(h.supply) + "," + I2S(l.buildWood) + "," + I2S(l.buildIron) + "," + I2S(l.buildDays)
		for i = 0 to economy.trade.marketCount - 1
			let m = economy.trade.markets[i]
			if m.id == id
				result += "|" + m.goodName + "," + I2S(m.stock) + "," + navalBool(m.blockaded) + "," + navalBool(m.occupiedByHostile)
		return result
	function quote(string owner, string id, string blueprint) returns NavalBuildQuote
		let m = campaign.militarySettlements
		let l = m.naval
		let i = l.index(id)
		if not campaign.isSaveSafe() or i < 0 or owner == "" or campaign.countries.polityIndex(owner) < 0
			return null
		let d = l.yards[i]
		let s = l.states[i]
		let h = l.blueprint(blueprint, d)
		let day = campaign.clock.currentDay
		if h == null or not accessible(d, owner) or s.job != "" or s.ready == 0 or s.ready > day or day < s.lastDay or (h.boardRequired and s.boardOwner != owner) or not effects.entitled(owner, h.entitlement) or not requirements(h, owner) or day < h.firstDay or day > h.lastDay or m.forceCount >= 4096 or s.serial >= 1000000 or m.combatBindings == null or m.combatBindings.profile(h.profileId, h.unitTypeId, FORCE_FLEET) == null
			return null
		if not bill(d, owner, h.price, l.buildWood, l.buildIron, h.supply, h.crew, false)
			return null
		return new NavalBuildQuote(owner, id, blueprint, buildFingerprint(owner, id, blueprint))
	function commit(string owner, NavalBuildQuote quote) returns string
		if quote == null or owner != quote.owner
			return "Invalid construction quote or unauthorized controller."
		let current = this.quote(owner, quote.yard, quote.blueprint)
		if current == null
			return "Construction conditions changed; request a new quote."
		let valid = current.fingerprint == quote.fingerprint
		destroy current
		if not valid
			return "Construction quote is stale or already committed."
		return act(owner, "build", quote.yard, quote.blueprint)
	function act(string owner, string action, string id, string target) returns string
		if not campaign.isSaveSafe()
			return "Naval actions unavailable during restoration or transfer."
		let m = campaign.militarySettlements
		if m.orderCallbacks != null
			m.orderCallbacks.capture()
		let ledger = m.naval
		let i = ledger.index(id)
		if i < 0 or owner == ""
			return "Choose an authored port shipyard."
		let d = ledger.yards[i]
		let s = ledger.states[i]
		var hull = d
		if action == "build"
			hull = ledger.blueprint(target, d)
			if hull == null
				return "Unknown roster blueprint."
		let day = campaign.clock.currentDay
		if not accessible(d, owner) or day < s.lastDay
			return "Requires lawful administered port, labor, market/supply access and dockyard technology."
		if action == "stop"
			if s.owner != owner
				return "No project belongs to this controller."
			let previous = s.target
			s.stop()
			if s.serial < 1000000
				s.serial++
			let found = m.forceIndex(previous)
			if found >= 0
				m.instantiate(m.forces[found])
			return ""
		if s.serial >= 1000000
			return "Construction history is full."
		if s.job != ""
			return "A paid project already occupies this berth."
		var money = 0
		var wood = 0
		var metalUnits = 0
		var provisions = 0
		var crew = 0
		if action == "dock"
			if s.ready != 0 or target != ""
				return "Dock already exists or invalid target."
			money = ledger.dockCost
			wood = ledger.dockWood
			metalUnits = ledger.dockIron
		else
			if s.ready == 0 or day < s.ready
				return "Commission and finish a paid dock first."
			if action == "board"
				if s.boardOwner == owner or target != ""
					return "Naval board already enacted or invalid target."
				money = ledger.boardCost
			else if action == "build"
				if (hull.boardRequired and s.boardOwner != owner) or not effects.entitled(owner, hull.entitlement) or not requirements(hull, owner) or day < hull.firstDay or day > hull.lastDay or m.forceCount >= 4096 or s.serial >= 1000000
					return "Requires historical roster availability, exact unit entitlement, all roster research, required naval administration, crew and provisions."
				money = hull.price
				wood = ledger.buildWood
				metalUnits = ledger.buildIron
				provisions = hull.supply
				crew = hull.crew
			else
				let f = actor(d, owner, target)
				if f == null or ledger.busy(target)
					return "Requires a compatible owned ship at this operational dock."
				let profile = ledger.profile(f.combatProfileId, f.unitTypeId)
				if action == "repair"
					if f.hull.integrity >= 10000
						return "Hull already sound."
					// Repair bills are paid for each actual day of output.
					money = ledger.repairCost
					wood = ledger.repairWood
					provisions = 1
				else if action == "supply"
					if f.supply > 2147483647 - d.supply
						return "Ship provision capacity exceeded."
					money = d.supply * ledger.provisionPrice
					provisions = d.supply
				else if action == "mount"
					if day < ledger.mountFirstDay or (profile == null or not profile.carronadeMount) or f.hull.carronades or not effects.earned(owner, "close_range_naval_gunfire_damage")
						return "Requires historical compatible carronade mounts and earned research."
					money = ledger.mountCost
					wood = ledger.mountWood
					metalUnits = ledger.mountIron
				else if action == "carvel"
					if day < ledger.carvelFirstDay or (profile == null or not profile.carvelRefit or profile.carvelBuilt) or f.hull.carvel or not effects.earned(owner, "voyage_hull_weather_resilience")
						return "Requires a historically compatible paid carvel refit and earned research."
					money = ledger.carvelCost
					wood = ledger.carvelWood
					metalUnits = ledger.carvelIron
				else
					return "Use dock, board, build, repair, supply, mount, carvel or stop."
		if action == "build" and (m.combatBindings == null or m.combatBindings.profile(hull.profileId, hull.unitTypeId, FORCE_FLEET) == null)
			return "Authoritative roster weapon profile unavailable."
		if not pay(d, owner, money, wood, metalUnits, provisions, crew)
			return "Treasury, materials, crew or local supply insufficient; no payment taken."
		if target != "" and action != "build"
			m.forces[m.forceIndex(target)].cancelOrder()
			m.adapter.removeRepresentation(target)
		s.serial++
		s.owner = owner
		s.job = action
		s.target = target
		s.work = 0
		s.lastDay = day
		if action == "repair"
			// The first bill prepays the first day; one paid day never repeats.
			s.work = 1
		return ""
	/** Completion is separate from purchase and runs only after funded work. */
	private function completeBuild(NavalYard d, NavalYard hull, NavalYardState s, string owner)
		let m = campaign.militarySettlements
		let shipId = "naval:" + d.id + ":" + I2S(s.serial)
		if m.forceIndex(shipId) < 0
			let ship = new RuntimeForce(shipId, owner, d.mapId, m.combatBindings.profile(hull.profileId, hull.unitTypeId, FORCE_FLEET).categoryId, FORCE_FLEET, hull.unitTypeId, hull.strength, hull.supply, d.x, d.y)
			ship.combatProfileId = hull.profileId
			ship.hull.lastDay = s.lastDay
			m.recruit(ship)
		s.stop()
	function advance(int day)
		let m = campaign.militarySettlements
		let ledger = m.naval
		for i = 0 to ledger.count - 1
			let d = ledger.yards[i]
			let s = ledger.states[i]
			let previousTarget = s.target
			while s.job != "" and s.lastDay < day
				s.lastDay++
				let owner = s.owner
				var valid = accessible(d, owner)
				RuntimeForce f = null
				let hull = ledger.blueprint(s.target, d)
				if s.target != "" and s.job != "build"
					f = actor(d, owner, s.target)
					valid = valid and f != null
				if not valid
					s.stop()
				else if s.job == "repair"
					if s.work == 1 or pay(d, owner, ledger.repairCost, ledger.repairWood, 0, 1, 0)
						f.hull.repair(ledger.repairOutput, effects.rate(owner, "hull_repair_throughput"))
						s.work = 0
						if f.hull.integrity == 10000
							s.stop()
				else
					if s.job == "build" and (hull == null or not requirements(hull, owner) or (hull.boardRequired and s.boardOwner != owner) or not effects.entitled(owner, hull.entitlement) or s.lastDay < hull.firstDay or s.lastDay > hull.lastDay)
						s.stop()
					else
						s.work++
						if s.job == "build"
							s.work = IMinBJ(s.work, ledger.buildDays)
						if s.job == "dock" and s.work >= ledger.dockDays
							s.ready = s.lastDay
							s.stop()
						else if s.job == "board" and s.work >= ledger.boardDays
							s.boardOwner = owner
							s.stop()
						else if s.job == "supply" and s.work >= 1
							f.supply += d.supply
							s.stop()
						else if s.job == "mount" and s.work >= ledger.mountDays
							f.hull.installCarronades()
							s.stop()
						else if s.job == "carvel" and s.work >= ledger.carvelDays
							f.hull.carvel = true
							s.stop()
						else if s.job == "build" and s.work >= ledger.buildDays and m.forceCount < 4096
							completeBuild(d, hull, s, owner)
			if previousTarget != "" and not ledger.busy(previousTarget)
				let found = m.forceIndex(previousTarget)
				if found >= 0
					m.instantiate(m.forces[found])
		for i = 0 to m.forceCount - 1
			let f = m.forces[i]
			let profile = ledger.profile(f.combatProfileId, f.unitTypeId)
			if f.kind == FORCE_FLEET
				if f.hull.lastDay == 0
					f.hull.lastDay = day
				while f.hull.lastDay < day
					let at = f.hull.lastDay
					f.hull.lastDay++
					if f.active and f.strength > 0
						// Existing hulls retain their existing supply. New roster
						// hulls additionally pay the roster's monthly maintenance.
						NavalYard maintenance = null
						if ledger.count > 0 and f.combatProfileId == ledger.yards[0].profileId
							maintenance = ledger.yards[0]
						for b = 0 to ledger.blueprintCount - 1
							if f.combatProfileId == ledger.blueprints[b].profileId
								maintenance = ledger.blueprints[b]
						if maintenance != null
							let credit = f.hull.upkeepCredit + maintenance.upkeep
							let bill = credit div 30
							f.hull.upkeepCredit = credit mod 30
							let p = campaign.countries.polityIndex(f.controllerId)
							f.hull.maintained = p >= 0 and campaign.countries.treasury[p] >= bill and f.supply > 0
							if f.hull.maintained
								campaign.countries.treasury[p] -= bill
								f.supply--
						if f.navigation.pending() and m.voyages != null and at >= f.navigation.lastDay and at < f.navigation.lastDay + m.voyages.route(f.navigation.routeId).days - f.navigation.elapsedDays and ledger.weatherPeriod > 0 and at mod ledger.weatherPeriod < ledger.weatherDays
							var rate = 0
							if at >= ledger.carvelFirstDay and profile != null and f.hull.maintained and (profile.carvelBuilt or f.hull.carvel)
								rate = effects.rate(f.controllerId, "voyage_hull_weather_resilience")
							f.hull.weather(ledger.stormLoss, rate)
							if f.hull.integrity == 0
								m.recordLoss(f.id, f.strength)
	function overview(string owner, string id) returns string
		let ledger = campaign.militarySettlements.naval
		let i = ledger.index(id)
		if i < 0
			var result = "Naval yards:"
			for j = 0 to ledger.count - 1
				result += " " + ledger.yards[j].id
			return result
		let d = ledger.yards[i]
		let s = ledger.states[i]
		var recruitment = ""
		for b = 0 to ledger.blueprintCount - 1
			let h = ledger.blueprints[b]
			recruitment += "\n/naval build " + id + " " + h.profileId + ": " + I2S(h.price) + " currency, " + I2S(h.crew) + " crew, " + I2S(h.supply) + " provisions and local supply, " + I2S(ledger.buildWood) + " " + ledger.woodGood + ", " + I2S(ledger.buildIron) + " " + ledger.ironGood + "; " + I2S(ledger.buildDays) + " construction days; " + I2S(h.upkeep) + " currency/30 days and 1 provision/day. Requires unit:" + h.entitlement + ", all roster research " + h.researchRequirements + ", commissioned paid dock and historical availability " + navalDate(h.firstDay) + " through " + navalDate(h.lastDay) + ". Naval board required: " + navalBool(h.boardRequired) + "."
		return recruitment + "\n" + id + ": requires lawful administration, port access, local labor and " + d.prerequisite + ". Dock " + I2S(ledger.dockCost) + " currency + " + I2S(ledger.dockWood) + " " + ledger.woodGood + " + " + I2S(ledger.dockIron) + " " + ledger.ironGood + ", " + I2S(ledger.dockDays) + " days. Naval board is a separate paid choice: " + I2S(ledger.boardCost) + " currency, " + I2S(ledger.boardDays) + " days.\nBuild " + d.profileId + ": " + I2S(d.price) + " currency, " + I2S(d.crew) + " manpower, " + I2S(d.supply) + " provisions and settlement supply, " + I2S(ledger.buildWood) + " " + ledger.woodGood + ", " + I2S(ledger.buildIron) + " " + ledger.ironGood + " (includes naval ordnance); " + I2S(ledger.buildDays) + " days; " + I2S(d.upkeep) + " currency per 30 days + 1 provision/day. Historical availability " + navalDate(d.firstDay) + " through " + navalDate(d.lastDay) + "; all roster research required: " + d.researchRequirements + ".\nRepair: " + I2S(ledger.repairCost) + " currency + " + I2S(ledger.repairWood) + " " + ledger.woodGood + " + 1 provision/supply per day; " + I2S(ledger.repairOutput) + " hull integrity/day + " + I2S(effects.rate(owner, "hull_repair_throughput")) + " bp. Hull maximum 10000. Supply: " + I2S(d.supply) + " provisions, " + I2S(d.supply * ledger.provisionPrice) + " currency and matching local stock/supply, 1 day. Mount: " + I2S(ledger.mountCost) + " currency + " + I2S(ledger.mountWood) + " " + ledger.woodGood + " + " + I2S(ledger.mountIron) + " " + ledger.ironGood + "; " + I2S(ledger.mountDays) + " days, available from " + navalDate(ledger.mountFirstDay) + ". Carvel refit: " + I2S(ledger.carvelCost) + " currency + " + I2S(ledger.carvelWood) + " " + ledger.woodGood + " + " + I2S(ledger.carvelIron) + " " + ledger.ironGood + "; " + I2S(ledger.carvelDays) + " days, from " + navalDate(ledger.carvelFirstDay) + ". Compatible hulls only. Carronades add " + I2S(effects.rate(owner, "close_range_naval_gunfire_damage")) + " bp only within " + R2S(ledger.closeRange) + " range; carvel avoids " + I2S(effects.rate(owner, "voyage_hull_weather_resilience")) + " bp actual voyage hull weather loss.\nProject " + s.job + " " + s.target + ", funded work " + I2S(s.work) + ". Capture cancels projects/board; completed dock and gear survive. No refunds. Use /naval <inspect|dock|board|build|repair|supply|mount|carvel|stop> PORT [SHIP]."

class NavalCommand implements CommandHandler
	NavalCampaignRuntime runtime
	CommandOutput output
	construct(NavalCampaignRuntime runtime, CommandOutput output)
		this.runtime = runtime
		this.output = output
	override function execute(player sender, string arguments)
		if sender != Player(0)
			output.show(sender, "This controller cannot issue naval commands.")
			return
		let cut = arguments.indexOf(" ")
		if cut < 1
			output.show(sender, runtime.overview("", ""))
			return
		let action = SubString(arguments, 0, cut)
		var id = SubString(arguments, cut + 1, StringLength(arguments))
		var target = ""
		let targetCut = id.indexOf(" ")
		if targetCut > 0
			target = SubString(id, targetCut + 1, StringLength(id))
			id = SubString(id, 0, targetCut)
		let owner = runtime.campaign.rpg.researchResources.controllerId(sender)
		if action == "inspect"
			output.show(sender, runtime.overview(owner, id))
		else
			var result = ""
			if action == "build"
				let quote = runtime.quote(owner, id, target)
				result = runtime.commit(owner, quote)
				if quote != null
					destroy quote
			else
				result = runtime.act(owner, action, id, target)
			if result == ""
				result = "Naval action completed."
			output.show(sender, result)

public function registerNavalCommands(CommandRegistry commands, NavalCampaignRuntime runtime) returns string
	return commands.register("naval", "", "naval <inspect|dock|board|build|repair|supply|mount|carvel|stop> PORT [SHIP]", "Manage paid shipyards, construction and fleet maintenance.", "Inspect bills, historical availability, research, port, crew and supply conditions. Player and AI use the same paid actions.", 1, 3, COMMAND_RELEASE, new NavalCommand(runtime, commands.output))
