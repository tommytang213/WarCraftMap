package VoyageNavigation

import ResearchEntitlements

/** No world IDs or balance values live here. A voyage is a scenario-defined
 * station-return circuit; it never changes geography, knowledge or the clock. */
public class NavigationResearchEffects implements TechnologyEffectPort
	TechnologyEffectPort other
	string kind
	string contentId
	construct(TechnologyEffectPort other, string kind, string contentId)
		this.other = other
		this.kind = kind
		this.contentId = contentId
	override function bindingStatus(ResearchUnlock definition) returns string
		if definition.kind == kind and definition.contentId == contentId
			return RESEARCH_BOUND
		if other != null
			return other.bindingStatus(definition)
		return RESEARCH_UNBOUND
	override function replaceResearchEntitlements(ResearchEntitlements result)
		if other != null
			other.replaceResearchEntitlements(result)
		else
			destroy result

/** Per-source fractions are attribution only. Only the common bucket refunds. */
public class VoyageCredit
	string sourceId
	int remainder = 0
	boolean restored = false
	VoyageCredit next = null
	construct(string sourceId)
		this.sourceId = sourceId

public class VoyageSource
	string id
	string kind
	string contentId
	int reductionBasisPoints
	string equipmentSiteId
	string qualification
	string inspection = ""
	VoyageSource next = null
	construct(string id, string kind, string contentId, int reductionBasisPoints, string equipmentSiteId, string qualification)
		this.id = id
		this.kind = kind
		this.contentId = contentId
		this.reductionBasisPoints = reductionBasisPoints
		this.equipmentSiteId = equipmentSiteId
		this.qualification = qualification

public class VoyageProgress
	boolean equipment = false
	string routeId = ""
	int elapsedDays = 0
	int lastDay = 0
	int reserved = 0
	int creditBasisPoints = 0
	VoyageCredit credits = null
	function credit(string sourceId) returns VoyageCredit
		var entry = credits
		while entry != null
			if entry.sourceId == sourceId
				return entry
			entry = entry.next
		entry = new VoyageCredit(sourceId)
		entry.next = credits
		credits = entry
		return entry
	function fraction(string sourceId) returns int
		var entry = credits
		while entry != null
			if entry.sourceId == sourceId
				return entry.remainder
			entry = entry.next
		return 0
	function sourceFractional() returns boolean
		var entry = credits
		while entry != null
			if entry.remainder > 0
				return true
			entry = entry.next
		return false
	function sourceRecords(string forceId, VoyageSource first) returns string
		var source = first
		var result = ""
		while source != null
			result += "|x," + forceId + "," + source.id + "," + I2S(fraction(source.id))
			source = source.next
		return result
	ondestroy
		while credits != null
			let following = credits.next
			destroy credits
			credits = following
	boolean saved = false
	function pending() returns boolean
		return routeId != ""
	function interrupt() returns int
		let released = reserved
		routeId = ""
		elapsedDays = 0
		lastDay = 0
		reserved = 0
		return released
	function record() returns string
		var equipped = "0"
		if equipment
			equipped = "1"
		return equipped + "," + routeId + "," + elapsedDays.toString() + "," + lastDay.toString() + "," + reserved.toString() + "," + creditBasisPoints.toString()

public class VoyageRoute
	string id
	string mapId
	string knownRegionId
	int days
	int dailyProvisions
	int dailyPositionFindingProvisions
	string coastalBearingDays = ""
	VoyageRoute next = null
	construct(string id, string mapId, string knownRegionId, int days, int dailyProvisions, int dailyPositionFindingProvisions)
		this.id = id
		this.mapId = mapId
		this.knownRegionId = knownRegionId
		this.days = days
		this.dailyProvisions = dailyProvisions
		this.dailyPositionFindingProvisions = dailyPositionFindingProvisions

public class VoyageShip
	string forceId
	int unitTypeId
	string mapId
	real stationX
	real stationY
	string routeIds
	boolean coastalBearingCapable = false
	VoyageShip next = null
	construct(string forceId, int unitTypeId, string mapId, real stationX, real stationY, string routeIds)
		this.forceId = forceId
		this.unitTypeId = unitTypeId
		this.mapId = mapId
		this.stationX = stationX
		this.stationY = stationY
		this.routeIds = routeIds

public class VoyageContract
	string kind
	string contentId
	int reductionBasisPoints
	int equipmentMoneyCost
	VoyageSource sources = null
	VoyageRoute routes = null
	VoyageShip ships = null
	construct(string kind, string contentId, int reductionBasisPoints, int equipmentMoneyCost)
		this.kind = kind
		this.contentId = contentId
		this.reductionBasisPoints = reductionBasisPoints
		this.equipmentMoneyCost = equipmentMoneyCost
	function addSource(VoyageSource source)
		source.next = sources
		sources = source
	function source(string id) returns VoyageSource
		var source = sources
		while source != null
			if source.id == id
				return source
			source = source.next
		return null
	function addRoute(VoyageRoute route)
		route.next = routes
		routes = route
	function addShip(VoyageShip ship)
		ship.next = ships
		ships = ship
	function route(string id) returns VoyageRoute
		var route = routes
		while route != null
			if route.id == id
				return route
			route = route.next
		return null
	function ship(string forceId) returns VoyageShip
		var ship = ships
		while ship != null
			if ship.forceId == forceId
				return ship
			ship = ship.next
		return null
	function supports(string forceId, int unitTypeId, string routeId) returns boolean
		var ship = ships
		while ship != null
			if ship.forceId == forceId and ship.unitTypeId == unitTypeId and (routeId == "" or ship.routeIds.indexOf("|" + routeId + "|") >= 0)
				return true
			ship = ship.next
		return false
	function valid(VoyageProgress state) returns boolean
		if state.elapsedDays < 0 or state.lastDay < 0 or state.lastDay > 1000000 or state.reserved < 0 or state.creditBasisPoints < 0 or state.creditBasisPoints >= 10000
			return false
		if not state.pending()
			return state.elapsedDays == 0 and state.lastDay == 0 and state.reserved == 0
		let route = route(state.routeId)
		return route != null and state.elapsedDays < route.days and state.reserved == (route.days - state.elapsedDays) * route.dailyProvisions
	/** Reserve the full undiscounted provisions. Research cannot legalize a
	 * voyage that lacks provisions; eligibility is checked at resolution. */
	function start(VoyageProgress state, VoyageRoute route, int day, int provisions) returns boolean
		let required = route.days * route.dailyProvisions
		if state.pending() or day < 0 or provisions < required
			return false
		state.routeId = route.id
		state.elapsedDays = 0
		state.lastDay = day
		state.reserved = required
		return true
	/** Exact fixed point. Fractions survive interruption and repeated voyages;
	 * no floating arithmetic, floor-per-callback loss or repeated-day credits. */
	function resolve(VoyageProgress state, int day, boolean eligible) returns int
		var qualified = ""
		if eligible and state.equipment
			var source = sources
			while source != null
				if source.qualification == "astronomical_observation"
					qualified += "|" + source.id + "|"
				source = source.next
		return resolveSources(state, day, qualified)
	function commitSource(VoyageProgress state, VoyageSource source, int amount)
		let entry = state.credit(source.id)
		entry.remainder = (entry.remainder + amount) mod 10000
	function resolveSources(VoyageProgress state, int day, string qualified) returns int
		if not state.pending() or day < state.lastDay
			return 0
		let route = route(state.routeId)
		let elapsed = IMinBJ(day - state.lastDay, route.days - state.elapsedDays)
		var credit = state.creditBasisPoints
		for offset = 0 to elapsed - 1
			var source = sources
			while source != null
				if qualified.contains("|" + source.id + "|") and (source.qualification != "coastal_bearings" or SubString(route.coastalBearingDays, state.elapsedDays + offset, state.elapsedDays + offset + 1) == "1")
					let amount = route.dailyPositionFindingProvisions * source.reductionBasisPoints
					commitSource(state, source, amount)
					credit += amount
				source = source.next
		state.reserved -= elapsed * route.dailyProvisions
		state.elapsedDays += elapsed
		state.lastDay += elapsed
		let released = credit div 10000
		state.creditBasisPoints = credit mod 10000
		if state.elapsedDays == route.days
			state.interrupt()
		return released
	ondestroy
		while sources != null
			let following = sources.next
			destroy sources
			sources = following
		while routes != null
			let following = routes.next
			destroy routes
			routes = following
		while ships != null
			let following = ships.next
			destroy ships
			ships = following
