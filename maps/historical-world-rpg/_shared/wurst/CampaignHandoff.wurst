package CampaignHandoff

import CommandRouter
import CampaignSaveManager
import WC3Compatibility

import public ScenarioSettings
public constant string HANDOFF_REQUEST = "request"
public constant string HANDOFF_CHECKPOINT = "campaign_start_"

public interface PhysicalMapLoader
	function load(string packagePath)

public class WarcraftPhysicalMapLoader implements PhysicalMapLoader
	override function load(string packagePath)
		compatLoadPhysicalMap(packagePath)

/** Version 1 replaces the four unversioned bootstrap keys with one atomic
 * record. The sequence binds the codec checkpoint to this particular request,
 * even when the player selects the same origin for a later new campaign. */
public class CampaignStartRequest
	int sequence
	string status
	string origin
	string mapId
	string instanceId
	string settlementId
	construct(int sequence, string status, string origin, string mapId, string instanceId, string settlementId)
		this.sequence = sequence
		this.status = status
		this.origin = origin
		this.mapId = mapId
		this.instanceId = instanceId
		this.settlementId = settlementId
	function encode() returns string
		return "v1|" + sequence.toString() + "|" + status + "|" + origin + "|" + mapId + "|" + instanceId + "|" + settlementId
	function checkpointSlot() returns string
		return HANDOFF_CHECKPOINT + sequence.toString()
	function valid(OriginCatalog records) returns boolean
		return sequence > 0 and (status == "pending" or status == "consumed") and records.accepts(origin, mapId, instanceId, settlementId)

public function decodeCampaignStartRequest(string value) returns CampaignStartRequest
	string array[7] fields
	var start = 0
	var count = 0
	for i = 0 to StringLength(value)
		if i == StringLength(value) or SubString(value, i, i + 1) == "|"
			if count >= 7 or start == i
				return null
			fields[count] = SubString(value, start, i)
			count++
			start = i + 1
	if count != 7 or fields[0] != "v1" or S2I(fields[1]) <= 0 or S2I(fields[1]).toString() != fields[1] or (fields[2] != "pending" and fields[2] != "consumed")
		return null
	return new CampaignStartRequest(S2I(fields[1]), fields[2], fields[3], fields[4], fields[5], fields[6])

/** No gameplay imports: this is the production writer used by the minimal
 * selector, and the same storage contract read by every regional runtime. */
public class CampaignHandoff implements OriginSelectionObserver
	CampaignSaveStorage storage
	PhysicalMapLoader loader
	construct(CampaignSaveStorage storage, PhysicalMapLoader loader)
		this.storage = storage
		this.loader = loader
	function hasRequest() returns boolean
		return storage.contains(HANDOFF_REQUEST) or storage.contains("origin") or storage.contains("map") or storage.contains("instance") or storage.contains("settlement")
	function readRequest() returns CampaignStartRequest
		if storage.contains(HANDOFF_REQUEST)
			return decodeCampaignStartRequest(storage.read(HANDOFF_REQUEST))
		// Read-only migration from #359. Validation against generated records
		// occurs before use. The first durable acknowledgement writes version 1.
		if hasRequest()
			return new CampaignStartRequest(1, "pending", storage.read("origin"), storage.read("map"), storage.read("instance"), storage.read("settlement"))
		return null
	override function commitSelection(string polityId, string physicalMapId, string regionalInstanceId, string settlementId) returns boolean
		var sequence = 1
		let previous = readRequest()
		// A corrupt durable request may still own a private checkpoint slot.
		// Never silently reset its sequence to 1 and risk replaying that slot.
		// A genuinely empty cache and supported legacy keys still work.
		if previous == null and hasRequest()
			return false
		if previous != null
			sequence = previous.sequence + 1
			// readRequest constructs a transient request; never retain it after
			// the sequence decision (including the exhausted-sequence path).
			destroy previous
		if sequence <= 0
			return false
		let request = new CampaignStartRequest(sequence, "pending", polityId, physicalMapId, regionalInstanceId, settlementId)
		let committed = storage.writeTransactional(HANDOFF_REQUEST, request.encode())
		// The cache owns serialized bytes, not the temporary request object.
		destroy request
		return committed
	override function campaignStarted(string polityId, string physicalMapId, string packagePath, string regionalInstanceId, string settlementId)
		loader.load(packagePath)
	function acknowledge(CampaignStartRequest request) returns boolean
		// A stale callback must never consume a newer origin selection or
		// overwrite a damaged handoff. The legacy unversioned request compares
		// through readRequest() and migrates only when the write succeeds.
		if request == null or request.status != "pending"
			return false
		let current = readRequest()
		let matches = current != null and current.encode() == request.encode()
		if current != null
			destroy current
		if not matches
			return false
		let consumed = new CampaignStartRequest(request.sequence, "consumed", request.origin, request.mapId, request.instanceId, request.settlementId)
		let written = storage.writeTransactional(HANDOFF_REQUEST, consumed.encode())
		destroy consumed
		return written
