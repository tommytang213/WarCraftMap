package MilitaryCombatEvents

import WC3Compatibility
import MilitarySettlementRuntime
import ManagementScreenPauseController
import CommandRouter
import PlayableCampaignRuntime

/** Only native operations are replaceable. Registration, identity resolution,
 * hostility checks, event routing and deadline scheduling run in production and
 * in the recording-boundary tests. Representation IDs never enter a save. */
public interface MilitaryCombatNatives
	function install(MilitaryCombatEvents events, int generation)
	function uninstall()
	function armTimer(real seconds, int serial)
	function stopTimer()
	function timerElapsed() returns real
	function heroRepresentationId(int index) returns int

public class MilitaryCombatEvents implements MilitaryRuntimeCallbacks, CampaignPauseListener
	MilitarySettlementRuntime runtime
	PlayerCampaignIdentity identity
	ManagementScreenPauseController pause
	MilitaryCombatNatives natives
	boolean installed = false
	boolean paused = false
	int suspension = 0
	int generation = 0
	int timerSerial = 0
	boolean timerArmed = false
	real sampledElapsed = 0.
	construct(MilitarySettlementRuntime runtime, PlayerCampaignIdentity identity, ManagementScreenPauseController pause, MilitaryCombatNatives natives)
		this.runtime = runtime
		this.identity = identity
		this.pause = pause
		this.natives = natives
	function install()
		if installed
			return
		installed = true
		paused = pause.isCampaignPaused()
		runtime.callbacks = this
		pause.subscribe(this)
		startCallbacks()
	function stop()
		if not installed
			return
		synchronize()
		installed = false
		generation++
		cancelTimer()
		natives.uninstall()
		pause.unsubscribe(this)
		runtime.callbacks = null
	function startCallbacks()
		generation++
		natives.install(this, generation)
		schedule()
	override function suspend()
		if suspension == 0
			synchronize()
			generation++
			cancelTimer()
			natives.uninstall()
		suspension++
	override function resume()
		if suspension <= 0
			return
		suspension--
		if suspension == 0 and installed
			startCallbacks()
	override function synchronize()
		if installed and suspension == 0 and not paused and timerArmed
			let elapsed = natives.timerElapsed()
			if elapsed >= sampledElapsed
				runtime.gameplaySeconds += elapsed - sampledElapsed
				sampledElapsed = elapsed
	override function onCampaignPause(boolean value)
		synchronize()
		paused = value
		cancelTimer()
		if not paused
			schedule()
	function cancelTimer()
		timerSerial++
		timerArmed = false
		natives.stopTimer()
	function schedule()
		// One timer, at most one wave per settlement per wake; no catch-up loop.
		// A one-second ceiling bounds housekeeping. Shorter deadlines (including
		// fractional capture expiry) are scheduled at their exact remaining time.
		synchronize()
		cancelTimer()
		if not installed or suspension > 0 or paused
			return
		var delay = 1.
		let now = runtime.gameplaySeconds
		for i = 0 to runtime.settlementCount - 1
			let state = runtime.settlements[i]
			if state.captureImmuneUntil > 0.
				delay = RMinBJ(delay, RMaxBJ(0., state.captureImmuneUntil - now))
			if state.underAttack
				delay = RMinBJ(delay, RMaxBJ(0., state.lastCombatAt + state.quietPeriod - now))
				delay = RMinBJ(delay, RMaxBJ(0., state.nextWaveAt - now))
		sampledElapsed = 0.
		timerArmed = true
		natives.armTimer(delay, timerSerial)
	function onTimer(int serial)
		if not installed or suspension > 0 or paused or not timerArmed or serial != timerSerial
			return
		synchronize()
		cancelTimer()
		runtime.releaseCaptureProtection(runtime.gameplaySeconds)
		runtime.tick(runtime.gameplaySeconds)
		schedule()
	function accepts(int epoch) returns boolean
		return installed and suspension == 0 and not paused and epoch == generation
	function representedForce(int representation) returns int
		if representation == 0
			return -1
		let found = runtime.forceIndex(runtime.adapter.forceIdForRepresentation(representation))
		if found >= 0
			let runtimeForce = runtime.forces[found]
			if runtimeForce.active and runtimeForce.strength > 0 and runtimeForce.regionId == runtime.activeRegionId
				return found
		return -1
	function controller(string owner) returns string
		if owner == "player"
			return identity.allegianceId()
		return owner
	function attackerController(int representation) returns string
		let runtimeForce = representedForce(representation)
		if runtimeForce >= 0
			return controller(runtime.forces[runtimeForce].controllerId)
		if representation != 0 and runtime.rpg != null
			for i = 0 to runtime.rpg.heroes.count - 1
				let hero = runtime.rpg.heroes.heroes[i]
				if hero.recruited and hero.assignment == "field" and not hero.incapacitated and natives.heroRepresentationId(i) == representation
					return identity.allegianceId()
		return ""
	function legalTarget(int forceIndex, string attacker) returns boolean
		let runtimeForce = runtime.forces[forceIndex]
		let city = runtime.settlementForForce(runtimeForce)
		if attacker == "" or not runtime.atWar(attacker, controller(runtimeForce.controllerId))
			return false
		if city >= 0
			let state = runtime.settlements[city]
			return state.controllerId == runtimeForce.controllerId and state.regionId == runtime.activeRegionId and runtime.gameplaySeconds >= state.captureImmuneUntil
		return runtimeForce.kind == FORCE_ARMY or runtimeForce.kind == FORCE_FLEET
	/** -1 cancels illegal damage before it kills a represented unit; 0 leaves
	 * unrelated Warcraft objects alone; 1 routes an authorized combat event. */
	function onDamage(int epoch, int target, int source, real damage) returns int
		if not accepts(epoch)
			return -1
		synchronize()
		let runtimeForce = representedForce(target)
		if runtimeForce < 0
			return 0
		let attacker = attackerController(source)
		if damage <= 0.
			return 0
		if not legalTarget(runtimeForce, attacker)
			return -1
		let city = runtime.settlementForForce(runtime.forces[runtimeForce])
		if city >= 0
			runtime.beginSettlementAttack(runtime.settlements[city].id, attacker, runtime.gameplaySeconds)
		// A local garrison firing on an enemy is also ongoing combat.
		let attackingForce = representedForce(source)
		if attackingForce >= 0
			let home = runtime.settlementForForce(runtime.forces[attackingForce])
			if home >= 0
				runtime.beginSettlementAttack(runtime.settlements[home].id, controller(runtime.forces[runtimeForce].controllerId), runtime.gameplaySeconds)
		schedule()
		return 1
	function onDeath(int epoch, int target, int killer)
		if not accepts(epoch)
			return
		synchronize()
		let found = representedForce(target)
		if found < 0
			return
		let runtimeForce = runtime.forces[found]
		let attacker = attackerController(killer)
		if not legalTarget(found, attacker)
			// Scripted/environmental/illegal kills cannot delete campaign troops.
			// Recreate from authority; the old handle is detached before removal.
			runtime.instantiate(runtimeForce)
			return
		let city = runtime.settlementForForce(runtimeForce)
		if runtimeForce.kind == FORCE_CITY_CORE
			runtime.capture(runtime.settlements[city].id, attacker, runtime.gameplaySeconds)
		else if runtimeForce.kind == FORCE_GARRISON
			runtime.recordGarrisonLoss(runtime.settlements[city].id, runtimeForce.id, runtimeForce.strength, runtime.gameplaySeconds)
		else
			runtime.recordLoss(runtimeForce.id, runtimeForce.strength)
		schedule()

WarcraftMilitaryCombatNatives activeCombatNatives = null

function militaryDamageEvent()
	let port = activeCombatNatives
	if port != null and GetTriggeringTrigger() == port.damageTrigger
		if port.events.onDamage(port.generation, GetHandleId(GetTriggerUnit()), GetHandleId(GetEventDamageSource()), GetEventDamage()) < 0
			compatCancelCombatDamage()

function militaryDeathEvent()
	let port = activeCombatNatives
	if port != null and GetTriggeringTrigger() == port.deathTrigger
		port.events.onDeath(port.generation, GetHandleId(GetTriggerUnit()), GetHandleId(GetKillingUnit()))

function militaryTimerEvent()
	let port = activeCombatNatives
	if port != null and GetExpiredTimer() == port.wakeTimer
		port.events.onTimer(port.serial)

public class WarcraftMilitaryCombatNatives implements MilitaryCombatNatives
	MilitaryCombatEvents events
	int generation = 0
	int serial = 0
	trigger damageTrigger = null
	trigger deathTrigger = null
	timer wakeTimer = null
	override function install(MilitaryCombatEvents events, int generation)
		uninstall()
		if activeCombatNatives != null
			activeCombatNatives.events.stop()
		activeCombatNatives = this
		this.events = events
		this.generation = generation
		damageTrigger = CreateTrigger()
		deathTrigger = CreateTrigger()
		compatRegisterCombatEvents(damageTrigger, deathTrigger)
		TriggerAddAction(damageTrigger, function militaryDamageEvent)
		TriggerAddAction(deathTrigger, function militaryDeathEvent)
	override function uninstall()
		stopTimer()
		if damageTrigger != null
			DestroyTrigger(damageTrigger)
			damageTrigger = null
		if deathTrigger != null
			DestroyTrigger(deathTrigger)
			deathTrigger = null
		if activeCombatNatives == this
			activeCombatNatives = null
	override function armTimer(real seconds, int serial)
		stopTimer()
		this.serial = serial
		wakeTimer = CreateTimer()
		TimerStart(wakeTimer, seconds, false, function militaryTimerEvent)
	override function stopTimer()
		if wakeTimer != null
			let obsolete = wakeTimer
			wakeTimer = null
			PauseTimer(obsolete)
			DestroyTimer(obsolete)
	override function timerElapsed() returns real
		if wakeTimer == null
			return 0.
		return TimerGetElapsed(wakeTimer)
	override function heroRepresentationId(int index) returns int
		let hero = events.runtime.rpg.heroes.projected[index]
		if hero == null or GetUnitTypeId(hero) == 0
			return 0
		return GetHandleId(hero)

/** Regional startup invokes this only after committing the campaign. Repeated
 * installation returns the existing owner without duplicating subscriptions. */
public function installMilitaryCombatEvents(PlayableCampaignServices campaign, MilitaryCombatNatives natives) returns MilitaryCombatEvents
	return installMilitaryCombatEvents(campaign, natives, getManagementScreenPauseController())

public function installMilitaryCombatEvents(PlayableCampaignServices campaign, MilitaryCombatNatives natives, ManagementScreenPauseController pause) returns MilitaryCombatEvents
	if not campaign.started or campaign.state.startupLocked or campaign.state.loading or campaign.state.militarySettlements == null
		return null
	let runtime = campaign.state.militarySettlements
	if runtime.callbacks != null
		return runtime.callbacks castTo MilitaryCombatEvents
	let events = new MilitaryCombatEvents(runtime, campaign.identity, pause, natives)
	events.install()
	return events
