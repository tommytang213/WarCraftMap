package WC3CompatibilityCompileFixture
import WC3Compatibility

// Compile-only consumer fixture; no init block or runtime side effects.
@test function compatibilityTargetAndCapabilitiesArePinned()
	WC3_COMPAT_PATCH_FAMILY.assertEquals("v3.0")
	WC3_COMPAT_SCRIPT_BACKEND.assertEquals("LUA")
	WC3_HAS_MODERN_INVENTORY.assertEquals(true)
	WC3_HAS_NATIVE_SAVE_MANAGEMENT.assertEquals(true)
	WC3_HAS_FRAME_UI.assertEquals(true)
	WC3_HAS_PATHING_QUERIES.assertEquals(true)
	WC3_HAS_MODERN_UNIT_FIELDS.assertEquals(true)

function exerciseCompatibility(unit u, item i, equipmentType e, loadoutslot s, framehandle p, pathingtype t)
	requireWC3Compatibility()
	let _a = compatGetEquippedItem()
	let _b = compatGetUnequippedItem()
	let _c = compatGetItemEquipmentType(i)
	let _d = compatGetItemTag(i)
	let _e1 = compatIsItemEquipped(i)
	let _f = compatIsItemInBag(i)
	let _g = compatEquipItem(u, i)
	compatUnequipItem(u, i)
	let _h = compatUnequipItemFromSlot(u, s)
	let _j = compatExtendedInventorySize(u)
	let _k = compatItemInBagSlot(u, 0)
	let _l = compatItemInEquipmentSlot(u, s)
	let _m = compatHasItemBagged(u, i)
	let _n = compatHasItemEquipped(u, i)
	let _o = compatHasLoadoutSlotEmpty(u, s)
	let _q = compatHasAnyItemEquipped(u)
	let _r = compatHasEquipmentType(u, e)
	let _v = compatCanEquipItemOfType(u, e)
	let _cache = compatInitGameCache("fixture.w3v")
	compatStoreString(_cache, "campaign", "slot", "payload")
	let _stored = compatHaveStoredString(_cache, "campaign", "slot")
	let _payload = compatGetStoredString(_cache, "campaign", "slot")
	compatFlushStoredString(_cache, "campaign", "slot")
	let _cacheSaved = compatSaveGameCache(_cache)
	compatSaveGame("fixture")
	compatLoadGame("fixture", false)
	let _w = compatSaveGameExists("fixture")
	let _x = compatCopySaveGame("fixture", "copy")
	let _y = compatRenameSaveDirectory("fixture", "renamed")
	let _z = compatRemoveSaveDirectory("renamed")
	compatSaveCheckpoint("fixture", false)
	let _timer = compatCreateOwnedTimer()
	compatDestroyOwnedTimer(_timer)
	let _effect = compatCreateOwnedEffect("fixture.mdl", 0., 0.)
	compatDestroyOwnedEffect(_effect)
	let _sound = compatCreateOwnedSound("fixture.wav")
	compatStopOwnedSound(_sound)
	let _frame = compatCreateFrame("FRAME", "fixture", p, "", 0)
	compatSetFrameVisible(_frame, true)
	compatSetFrameEnabled(_frame, true)
	let _blocked = compatIsTerrainPathable(0., 0., t)
	compatSetUnitPosition(u, 0., 0.)
	compatSetUnitCoordinates(u, 0., 0.)
	compatTeleportUnit(u, 0., 0.)
	let _regionalUnit = compatCreateUnit(GetOwningPlayer(u), GetUnitTypeId(u), 0., 0., 0.)
	compatPanCamera(GetOwningPlayer(u), 0., 0., 0.)
	compatRemoveUnit(_regionalUnit)
	let _life = compatGetUnitMaxLife(u)
	compatSetUnitMaxLife(u, _life)
	let _collision = compatGetUnitCollisionSize(u)
