package LocalBattleBenchmark
import WC3Compatibility
// Compile-covered only: no init block or release activation.
public class LocalBattleMeasurements
	int activeObjects = 0
	int peakActiveObjects = 0
	int handlesCreated = 0
	int handlesRetired = 0
	int effectsCreated = 0
	int effectsRetired = 0
	int ordersIssued = 0
	int pathingQueries = 0
	function recordActiveDelta(int delta)
		activeObjects += delta
		peakActiveObjects = IMaxBJ(peakActiveObjects, activeObjects)
public class WarcraftLocalBattleRuntime
	LocalBattleMeasurements measurements
	construct(LocalBattleMeasurements measurements)
		this.measurements = measurements
	function createRepresentation(player owner, int unitType, real x, real y) returns unit
		let result = compatBenchmarkCreateUnit(owner, unitType, x, y)
		measurements.handlesCreated++
		measurements.recordActiveDelta(1)
		return result
	function retireRepresentation(unit target)
		compatBenchmarkRemoveUnit(target)
		measurements.handlesRetired++
		measurements.recordActiveDelta(-1)
	function createBattleEffect(string modelPath, real x, real y) returns effect
		let result = compatBenchmarkCreateEffect(modelPath, x, y)
		measurements.effectsCreated++
		measurements.recordActiveDelta(1)
		return result
	function retireBattleEffect(effect target)
		compatBenchmarkDestroyEffect(target)
		measurements.effectsRetired++
		measurements.recordActiveDelta(-1)
	function issuePointOrder(unit target, string order, real x, real y)
		compatBenchmarkIssuePointOrder(target, order, x, y)
		measurements.ordersIssued++
	function queryPathing(real x, real y, pathingtype kind) returns boolean
		measurements.pathingQueries++
		return compatBenchmarkIsTerrainPathable(x, y, kind)
	function clockMilliseconds() returns real
		return compatBenchmarkClockMilliseconds()
