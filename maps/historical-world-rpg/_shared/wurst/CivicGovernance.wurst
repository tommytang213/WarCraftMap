package CivicGovernance

import ResearchEntitlements
import ExactNatural

/** Integer currency and outcome boundaries: floor gains, ceil positive bills.
 * Products never pass through a real or overflow a native intermediate. */
public function civicScale(int value, int basisPoints) returns int
	return exactNaturalNativeInt(exactNaturalScaleFloor(I2S(value), basisPoints, 10000))

public function civicTax(int normalTax, int collectionBasisPoints, int bonusBasisPoints) returns int
	let assessed = exactNaturalMultiply(I2S(normalTax), collectionBasisPoints)
	let adjusted = exactNaturalMultiply(assessed, 10000 + bonusBasisPoints)
	let result = exactNaturalDivide(adjusted, 100000000)
	if exactNaturalCompare(result, I2S(normalTax)) > 0
		return normalTax
	return exactNaturalNativeInt(result)

public function civicBill(int value, int basisPoints) returns int
	let product = exactNaturalMultiply(I2S(value), basisPoints)
	return IMaxBJ(1, exactNaturalNativeInt(exactNaturalDivide(exactNaturalAdd(product, "9999"), 10000)))

public class CivicEffect
	string kind
	string contentId
	string metric
	int basisPoints
	construct(string kind, string contentId, string metric, int basisPoints)
		this.kind = kind
		this.contentId = contentId
		this.metric = metric
		this.basisPoints = basisPoints

/** One named research layer per controller. Duplicate provenance does not
 * multiply a typed content identity; unrelated binding ports retain ownership. */
public class CivicResearchEffects extends UnboundResearchEffects
	TechnologyEffectPort upstream
	CivicEffect array[32] definitions
	int definitionCount = 0
	construct(TechnologyEffectPort upstream)
		this.upstream = upstream
	function register(CivicEffect binding)
		for i = 0 to definitionCount - 1
			if definitions[i].kind == binding.kind and definitions[i].contentId == binding.contentId
				destroy binding
				return
		definitions[definitionCount] = binding
		definitionCount++
	function rate(string controllerId, string metric) returns int
		let layer = get(controllerId)
		var result = 0
		if layer != null
			for i = 0 to definitionCount - 1
				let binding = definitions[i]
				if binding.metric == metric and layer.has(binding.kind, binding.contentId)
					result += binding.basisPoints
		return result
	override function bindingStatus(ResearchUnlock definition) returns string
		for i = 0 to definitionCount - 1
			let binding = definitions[i]
			if definition.kind == binding.kind and definition.contentId == binding.contentId
				return RESEARCH_BOUND
		return upstream.bindingStatus(definition)
	override function replaceResearchEntitlements(ResearchEntitlements result)
		let copy = new ResearchEntitlements(result.controllerId)
		var entry = result.first
		while entry != null
			copy.add(entry)
			entry = entry.next
		upstream.replaceResearchEntitlements(copy)
		super.replaceResearchEntitlements(result)

/** Immutable, scenario-owned local economic/institutional conditions.
 * A survey covers this named tax district, never unknown surrounding land. */
public class CivicDistrict
	string id
	string provinceId
	int annualTax
	int urbanization = 0
	boolean civicCenter
	int discussionFirstDay
	int discussionPerDay
	int outbreakFirstDay
	int outbreakDays
	int diseaseLossPerDay
	string medicalGood
	int medicalUnits
	int tradeCapacity
	construct(string id, string provinceId, int annualTax, boolean civicCenter, int discussionFirstDay, int discussionPerDay, int outbreakFirstDay, int outbreakDays, int diseaseLossPerDay, string medicalGood, int medicalUnits, int tradeCapacity)
		this.id = id
		this.provinceId = provinceId
		this.annualTax = annualTax
		this.civicCenter = civicCenter
		this.discussionFirstDay = discussionFirstDay
		this.discussionPerDay = discussionPerDay
		this.outbreakFirstDay = outbreakFirstDay
		this.outbreakDays = outbreakDays
		this.diseaseLossPerDay = diseaseLossPerDay
		this.medicalGood = medicalGood
		this.medicalUnits = medicalUnits
		this.tradeCapacity = tradeCapacity

public class CivicLocalState
	boolean careRestored = false
	string careOwner = ""
	int careReady = 0
	int careThrough = 0
	int diseaseRemainder = 0
	int recordsDays = 0
	int careDays = 0
	boolean municipalRestored = false
	string municipalOwner = ""
	int municipalReady = 0
	int municipalThrough = 0
	int urbanization = 0
	boolean restored = false
	string policyOwner = ""
	int policyReady = 0
	int upkeepThrough = 0
	string surveyOwner = ""
	int surveyReady = 0
	boolean surveyed = false
	string responseOwner = ""
	int responseEnd = 0
	int cooldownEnd = 0
	int lastDay = 0
	int discussion = 0
	int taxesCollected = 0
	int diseaseLost = 0
	int diseaseAvoided = 0
	int tradeDay = 0
	int tradedUnits = 0
	construct(int day)
		lastDay = day

/** The campaign port reads current control and real stocks, not projected
 * object handles. Transactions must validate the entire bill before mutation. */
public interface CivicEconomyPort
	function administration(string id) returns int
	function controller(string id) returns string
	function lawful(string id) returns boolean
	function known(string controllerId, string id) returns boolean
	function dispatchAccess(string originId, string recipientId) returns boolean
	function accessible(string id) returns boolean
	function pay(string controllerId, string id, int money, string good, int units) returns boolean
	function collect(string controllerId, string id, int maximum) returns int
	function diseaseAvailable(string id) returns int
	function disease(string id, int maximum) returns int

public class DispatchRelayLink
	string originId
	string recipientId
	construct(string originId, string recipientId)
		this.originId = originId
		this.recipientId = recipientId

public class CivicLedger
	CivicDistrict array[1024] districts
	CivicLocalState array[1024] states
	int count = 0
	DispatchRelayLink array[64] dispatchLinks
	int dispatchLinkCount = 0
	string dispatchRelayKind = ""
	string dispatchRelayContent = ""
	int dispatchOperatingBasisPoints = 0
	// Derived lookup only; save records still use exact district identities.
	// Chain hash collisions so registration and staged forks stay linear in
	// catalogue size without treating a hash as an authoritative identity.
	hashtable districtIndex = InitHashtable()
	int array[1024] previousDistrict
	string municipalNode = ""
	int municipalMinimumUrbanization = 101
	int archiveUpkeepBasisPoints = 25
	int minimumAdministration = 40
	int transitionDays = 90
	int enactmentBasisPoints = 100
	int upkeepBasisPoints = 50
	int surveyBasisPoints = 100
	int responseBasisPoints = 200
	int responseDays = 90
	int cooldownDays = 90
	int tradePenaltyBasisPoints = 1000
	int baseTaxBasisPoints = 9000
	int carePreparationDays = 90
	int careCommissionBasisPoints = 100
	int careUpkeepBasisPoints = 50
	int careDailyMaterials = 1
	int recordsDailyMoney = 1
	int recordsDailyMaterials = 1
	string recordsGood = ""
	function fork() returns CivicLedger
		let copy = new CivicLedger()
		copy.dispatchRelayKind = dispatchRelayKind
		copy.dispatchRelayContent = dispatchRelayContent
		copy.dispatchOperatingBasisPoints = dispatchOperatingBasisPoints
		for i = 0 to dispatchLinkCount - 1
			copy.addDispatchLink(dispatchLinks[i].originId, dispatchLinks[i].recipientId)
		copy.municipalNode = municipalNode
		copy.municipalMinimumUrbanization = municipalMinimumUrbanization
		copy.archiveUpkeepBasisPoints = archiveUpkeepBasisPoints
		copy.minimumAdministration = minimumAdministration
		copy.transitionDays = transitionDays
		copy.enactmentBasisPoints = enactmentBasisPoints
		copy.upkeepBasisPoints = upkeepBasisPoints
		copy.surveyBasisPoints = surveyBasisPoints
		copy.responseBasisPoints = responseBasisPoints
		copy.responseDays = responseDays
		copy.cooldownDays = cooldownDays
		copy.tradePenaltyBasisPoints = tradePenaltyBasisPoints
		copy.baseTaxBasisPoints = baseTaxBasisPoints
		copy.carePreparationDays = carePreparationDays
		copy.careCommissionBasisPoints = careCommissionBasisPoints
		copy.careUpkeepBasisPoints = careUpkeepBasisPoints
		copy.careDailyMaterials = careDailyMaterials
		copy.recordsDailyMoney = recordsDailyMoney
		copy.recordsDailyMaterials = recordsDailyMaterials
		copy.recordsGood = recordsGood
		for i = 0 to count - 1
			copy.register(districts[i], 0)
		return copy
	function addDispatchLink(string originId, string recipientId)
		for i = 0 to dispatchLinkCount - 1
			if dispatchLinks[i].originId == originId and dispatchLinks[i].recipientId == recipientId
				return
		if dispatchLinkCount < 64
			dispatchLinks[dispatchLinkCount] = new DispatchRelayLink(originId, recipientId)
			dispatchLinkCount++
	/** Re-read the named research layer and live network at the outcome boundary.
	 * A saved normal deadline never embeds a stale dispatch entitlement. */
	function dispatchDays(string owner, string id, CivicResearchEffects research, CivicEconomyPort economy) returns int
		let layer = research.get(owner)
		if layer == null or dispatchOperatingBasisPoints <= 0 or not layer.has(dispatchRelayKind, dispatchRelayContent)
			return 0
		let rate = IMinBJ(1000, research.rate(owner, "remote_survey_dispatch_time_reduction"))
		if rate <= 0
			return 0
		for i = 0 to dispatchLinkCount - 1
			let link = dispatchLinks[i]
			if link.recipientId == id and economy.dispatchAccess(link.originId, id)
				return civicScale(transitionDays, rate)
		return 0
	function index(string id) returns int
		var i = LoadInteger(districtIndex, 0, StringHash(id)) - 1
		while i >= 0
			if districts[i].id == id
				return i
			i = previousDistrict[i]
		return -1
	function register(CivicDistrict district, int day)
		if index(district.id) < 0 and count < 1024
			let hash = StringHash(district.id)
			previousDistrict[count] = LoadInteger(districtIndex, 0, hash) - 1
			SaveInteger(districtIndex, 0, hash, count + 1)
			districts[count] = district
			states[count] = new CivicLocalState(day)
			states[count].urbanization = district.urbanization
			count++
	function configureAdministration(string id, int urbanization)
		let i = index(id)
		if i >= 0
			districts[i].urbanization = urbanization
			states[i].urbanization = urbanization
	function municipalEligible(int i, string owner, CivicResearchEffects research, CivicEconomyPort economy) returns boolean
		return owner != "" and economy.controller(districts[i].id) == owner and economy.lawful(districts[i].id) and economy.administration(districts[i].id) >= minimumAdministration and states[i].urbanization >= municipalMinimumUrbanization and research.rate(owner, "archive_tax_collection_efficiency") > 0 and research.rate(owner, "municipal_tax_collection_efficiency") > 0
	/** One operational records service, shared by distinct research sources.
	 * Re-read current office qualification; appointment never grants revenue. */
	function recordsBonus(string id, string owner, CivicResearchEffects research, CivicEconomyPort economy) returns int
		if owner == "" or economy.controller(id) != owner or not economy.lawful(id)
			return 0
		let skill = economy.administration(id)
		if skill < minimumAdministration
			return 0
		return civicScale(research.rate(owner, "archive_tax_collection_efficiency"), skill * 100) + research.rate(owner, "records_tax_collection_efficiency")
	function collectionBonus(int i, string owner, int day, CivicResearchEffects research, CivicEconomyPort economy, boolean recordsFunded) returns int
		var bonus = 0
		if states[i].surveyed
			bonus += research.rate(owner, "land_tax_collection_efficiency")
		if recordsFunded
			bonus += recordsBonus(districts[i].id, owner, research, economy)
		let s = states[i]
		if s.municipalOwner == owner and owner != "" and day >= s.municipalReady and day < s.municipalThrough and municipalEligible(i, owner, research, economy)
			bonus += research.rate(owner, "municipal_tax_collection_efficiency")
		return bonus
	function controlChanged(string id)
		let i = index(id)
		if i >= 0
			let s = states[i]
			// Infrastructure survives capture; prepaid operation and fractions do not.
			if s.careReady > s.lastDay
				s.careReady = 0
			s.careOwner = ""
			s.careThrough = 0
			s.diseaseRemainder = 0
			s.municipalOwner = ""
			s.municipalReady = 0
			s.municipalThrough = 0
			s.policyOwner = ""
			s.policyReady = 0
			s.upkeepThrough = 0
			if not s.surveyed
				s.surveyOwner = ""
				s.surveyReady = 0
			s.responseOwner = ""
			s.responseEnd = 0
	function outbreak(int index, int day) returns boolean
		let d = districts[index]
		return d.outbreakFirstDay > 0 and day >= d.outbreakFirstDay and day < d.outbreakFirstDay + d.outbreakDays
	function responseActive(int index, string controllerId, int day) returns boolean
		let s = states[index]
		return controllerId != "" and s.responseOwner == controllerId and day < s.responseEnd
	function tradeAllowed(string id, string controllerId, int day, int quantity) returns boolean
		let i = index(id)
		if i < 0
			return true
		let s = states[i]
		var used = 0
		if s.tradeDay == day
			used = s.tradedUnits
		var rate = 10000
		if responseActive(i, controllerId, day)
			rate -= tradePenaltyBasisPoints
		return quantity <= civicScale(districts[i].tradeCapacity, rate) - used
	function recordTrade(string id, int day, int quantity)
		let i = index(id)
		if i >= 0
			let s = states[i]
			if s.tradeDay != day
				s.tradeDay = day
				s.tradedUnits = 0
			s.tradedUnits = IMinBJ(2147483647 - quantity, s.tradedUnits) + quantity
	function action(string controllerId, string id, string action, int day, CivicResearchEffects research, CivicEconomyPort economy) returns string
		let i = index(id)
		if i < 0 or controllerId == "" or economy.controller(id) != controllerId or not economy.lawful(id) or not economy.known(controllerId, id)
			return "Requires a known, lawfully controlled tax district and local administrator."
		let d = districts[i]
		let s = states[i]
		if day < s.lastDay or d.annualTax <= 0
			return "Local tax assessment or campaign date is unavailable."
		if action == "municipal-repeal"
			if s.municipalOwner != controllerId
				return "No municipal policy is enacted by this controller."
			s.municipalOwner = ""
			s.municipalReady = 0
			s.municipalThrough = 0
			return ""
		if action == "municipal"
			if s.municipalOwner != "" or not municipalEligible(i, controllerId, research, economy)
				return "Requires Archives, municipal adoption, qualified administration and sufficient urbanization; already enacted policies cannot stack."
			if not economy.pay(controllerId, id, civicBill(d.annualTax, enactmentBasisPoints), "", 0)
				return "Treasury resources are insufficient."
			s.municipalOwner = controllerId
			s.municipalReady = day + transitionDays
			s.municipalThrough = s.municipalReady
			return ""
		if action == "repeal"
			if s.policyOwner != controllerId
				return "No local policy is enacted by this controller."
			s.policyOwner = ""
			s.policyReady = 0
			s.upkeepThrough = 0
			return ""
		var cost = 0
		var good = ""
		var units = 0
		if action == "care"
			if research.rate(controllerId, "isolation_care_losses_avoided") <= 0 or not d.civicCenter or economy.administration(id) < minimumAdministration or not economy.accessible(id) or s.careOwner != ""
				return "Requires earned isolation care, a staffed accessible civic center and no commissioned service."
			// Captured completed infrastructure needs new paid operation, never research transfer.
			if s.careReady > 0 and s.careReady <= day
				cost = civicBill(d.annualTax, careUpkeepBasisPoints)
			else
				cost = civicBill(d.annualTax, careCommissionBasisPoints)
			good = d.medicalGood
			units = d.medicalUnits
		else if action == "policy"
			if research.rate(controllerId, "civic_reform_diffusion") <= 0 or not d.civicCenter or day < d.discussionFirstDay or s.policyOwner != ""
				return "Requires earned civic policy, reform discussion and a lawful civic center; policy already pending/active cannot stack."
			cost = civicBill(d.annualTax, enactmentBasisPoints)
		else if action == "survey"
			if research.rate(controllerId, "land_tax_collection_efficiency") <= 0 or s.surveyed or s.surveyReady > 0
				return "Requires earned survey research and an unsurveyed local district with no pending survey."
			cost = civicBill(d.annualTax, surveyBasisPoints)
		else if action == "response"
			if (research.rate(controllerId, "epidemic_losses_avoided") <= 0 and research.rate(controllerId, "case_records_losses_avoided") <= 0) or not outbreak(i, day) or day < s.cooldownEnd or not economy.accessible(id)
				return "Requires earned medicine, an active outbreak, medical access and expired cooldown."
			cost = civicBill(d.annualTax, responseBasisPoints)
			good = d.medicalGood
			units = d.medicalUnits
		else
			return "Use care, policy, repeal, survey or response."
		if not economy.pay(controllerId, id, cost, good, units)
			return "Treasury or existing local medical supplies are insufficient."
		if action == "care"
			s.careOwner = controllerId
			if s.careReady > 0 and s.careReady <= day
				s.careThrough = day + 365
			else
				s.careReady = day + carePreparationDays
				s.careThrough = s.careReady
		else if action == "policy"
			s.policyOwner = controllerId
			s.policyReady = day + transitionDays
			s.upkeepThrough = s.policyReady
		else if action == "survey"
			s.surveyOwner = controllerId
			s.surveyReady = day + transitionDays
		else
			s.responseOwner = controllerId
			s.responseEnd = day + responseDays
			s.cooldownEnd = s.responseEnd + cooldownDays
		return ""
	/** Authoritative local outcome boundary, shared by active and abstract replay. */
	function diffuse(int index, int basisPoints)
		let s = states[index]
		s.discussion = IMinBJ(10000, s.discussion + civicScale(districts[index].discussionPerDay, basisPoints))
	/** A paid service is requalified at each actual exposed day, never an object aura. */
	function isolationCare(int i, string owner, int day, CivicResearchEffects research, CivicEconomyPort economy) returns boolean
		let s = states[i]
		let d = districts[i]
		if s.careOwner != owner or owner == "" or day < s.careReady or not d.civicCenter or not economy.lawful(d.id) or economy.administration(d.id) < minimumAdministration or not economy.accessible(d.id) or research.rate(owner, "isolation_care_losses_avoided") <= 0
			return false
		if day >= s.careThrough
			return false
		if not economy.pay(owner, d.id, 0, d.medicalGood, careDailyMaterials)
			return false
		s.careDays++
		return true
	function maintainCaseRecords(int i, string owner, CivicResearchEffects research, CivicEconomyPort economy) returns boolean
		let d = districts[i]
		if not economy.lawful(d.id) or economy.administration(d.id) < minimumAdministration or not economy.accessible(d.id) or research.rate(owner, "case_records_losses_avoided") <= 0
			return false
		if not economy.pay(owner, d.id, recordsDailyMoney, recordsGood, recordsDailyMaterials)
			return false
		states[i].recordsDays++
		return true
	/** Replay each committed day for chunk-independent rounding and deadlines.
	 * No load callback advances this ledger. A legacy ledger anchors on its
	 * first live day rather than charging centuries of invented back taxes. */
	function advance(int day, CivicResearchEffects research, CivicEconomyPort economy)
		for i = 0 to count - 1
			let d = districts[i]
			let s = states[i]
			if s.lastDay == 0
				s.lastDay = day
			while s.lastDay < day
				s.lastDay++
				let at = s.lastDay
				let owner = economy.controller(d.id)
				let lawful = economy.lawful(d.id)
				if s.careOwner != "" and s.careOwner != owner
					if s.careReady > at - 1
						s.careReady = 0
					s.careOwner = ""
					s.careThrough = 0
					s.diseaseRemainder = 0
				// Upkeep is prepaid for the next exposed interval; the boundary day
				// starts service after exactly the authored preparation duration.
				if owner != "" and s.careOwner == owner and at - 1 >= s.careReady and at - 1 >= s.careThrough and lawful and economy.administration(d.id) >= minimumAdministration and economy.accessible(d.id) and research.rate(owner, "isolation_care_losses_avoided") > 0
					if economy.pay(owner, d.id, civicBill(d.annualTax, careUpkeepBasisPoints), "", 0)
						s.careThrough = at - 1 + 365
				if s.municipalOwner != owner
					s.municipalOwner = ""
					s.municipalReady = 0
					s.municipalThrough = 0
				if s.municipalOwner == owner and owner != "" and at >= s.municipalReady and at >= s.municipalThrough and municipalEligible(i, owner, research, economy)
					if economy.pay(owner, d.id, civicBill(d.annualTax, upkeepBasisPoints), "", 0)
						s.municipalThrough = at + 365
				// Capture keeps completed land records; opt-in policy and medical
				// authority never transfer to another controller.
				if s.policyOwner != owner
					s.policyOwner = ""
					s.policyReady = 0
					s.upkeepThrough = 0
				if s.surveyReady > 0 and not s.surveyed
					if s.surveyOwner != owner or not lawful
						s.surveyOwner = ""
						s.surveyReady = 0
					else if at >= s.surveyReady
						s.surveyed = true
					else
						let days = dispatchDays(owner, d.id, research, economy)
						if days > 0 and at >= s.surveyReady - days
							if economy.pay(owner, d.id, civicBill(d.annualTax, dispatchOperatingBasisPoints), "", 0)
								s.surveyed = true
				if s.responseOwner != owner
					s.responseOwner = ""
					s.responseEnd = 0
				if lawful and s.policyOwner == owner and owner != "" and at >= s.policyReady and d.civicCenter and at >= d.discussionFirstDay and research.rate(owner, "civic_reform_diffusion") > 0
					if at >= s.upkeepThrough
						if economy.pay(owner, d.id, civicBill(d.annualTax, upkeepBasisPoints), "", 0)
							s.upkeepThrough = at + 365
						else
							s.policyOwner = ""
							s.policyReady = 0
							s.upkeepThrough = 0
				var diffusionRate = 10000
				if s.policyOwner == owner and owner != "" and at > s.policyReady and s.upkeepThrough >= at
					diffusionRate += research.rate(owner, "civic_reform_diffusion")
				if lawful and d.civicCenter and at > d.discussionFirstDay
					diffuse(i, diffusionRate)
				// Tax is a transfer from existing economic liquidity, bounded by
				// normal taxable capacity. Survey modifies collection efficiency.
				if lawful and at mod 365 == 0
					var funded = false
					if recordsBonus(d.id, owner, research, economy) > 0
						funded = economy.pay(owner, d.id, civicBill(d.annualTax, archiveUpkeepBasisPoints), "", 0)
					// Charge records operation once, then add each source once before
					// the existing single rounding and actual liquidity withdrawal.
					let bonus = collectionBonus(i, owner, at, research, economy, funded)
					let collected = economy.collect(owner, d.id, civicTax(d.annualTax, baseTaxBasisPoints, bonus))
					s.taxesCollected += collected
				if outbreak(i, at - 1)
					let exposed = IMinBJ(d.diseaseLossPerDay, economy.diseaseAvailable(d.id))
					var rate = 0
					let response = responseActive(i, owner, at - 1) and lawful
					if response
						rate += research.rate(owner, "epidemic_losses_avoided")
					var care = false
					if exposed > 0
						care = isolationCare(i, owner, at - 1, research, economy)
						if care
							rate += research.rate(owner, "isolation_care_losses_avoided")
						if (care or response) and maintainCaseRecords(i, owner, research, economy)
							rate += research.rate(owner, "case_records_losses_avoided")
					// One additive bucket and one rounding. Keep sub-person credit;
					// zero qualifying activity never spends it or receives a benefit.
					var avoided = 0
					if rate > 0 and exposed > 0
						let scaled = exactNaturalAdd(exactNaturalMultiply(I2S(exposed), IMinBJ(10000, rate)), I2S(s.diseaseRemainder))
						avoided = exactNaturalNativeInt(exactNaturalDivide(scaled, 10000))
						s.diseaseRemainder = S2I(SubString(scaled, IMaxBJ(0, StringLength(scaled) - 4), StringLength(scaled)))
					let loss = exposed - avoided
					let actual = economy.disease(d.id, loss)
					s.diseaseLost += actual
					// The avoided counter excludes unavailable people and is only
					// informational; manpower is mutated by the port exactly once.
					if actual == loss
						s.diseaseAvoided += exposed - loss
	ondestroy
		for i = 0 to dispatchLinkCount - 1
			destroy dispatchLinks[i]
		for i = 0 to count - 1
			destroy states[i]
		FlushParentHashtable(districtIndex)
