package CivicCampaignRuntime

import ResearchEntitlements
import CivicGovernance
import CampaignTimeline
import initlater PlayableCampaignRuntime
import MilitarySettlementRuntime
import initlater PlayableTrade
import WarcraftRpgRuntime
import CommandRouter

/** Production adapter: all bills use the government's persisted treasury;
 * dressings are withdrawn from actual local commodity stock. No seed/grant. */
public class CampaignCivicEconomy implements CivicEconomyPort
	PlayableCampaignState campaign
	PlayableTradeRuntime trade
	construct(PlayableCampaignState campaign, PlayableTradeRuntime trade)
		this.campaign = campaign
		this.trade = trade
	function settlement(string id) returns SettlementRuntimeState
		let i = campaign.militarySettlements.settlementIndex(id)
		if i < 0
			return null
		return campaign.militarySettlements.settlements[i]
	override function administration(string id) returns int
		let i = campaign.militarySettlements.administratorIndex(id)
		if i < 0 or not lawful(id)
			return 0
		let office = campaign.militarySettlements.administrators[i]
		if office.jurisdiction != id or office.capacity < 1
			return 0
		return IMaxBJ(0, IMinBJ(100, office.administration))
	override function controller(string id) returns string
		let s = settlement(id)
		if s == null
			return ""
		return s.controllerId
	override function lawful(string id) returns boolean
		let s = settlement(id)
		let i = campaign.militarySettlements.administratorIndex(id)
		if s == null or i < 0
			return false
		let office = campaign.militarySettlements.administrators[i]
		return s.controllerId == s.legalOwnerId and s.occupationConflictId == "" and not s.underAttack and office.controllerId == s.controllerId and office.jurisdiction == id and office.capacity > 0
	override function known(string controllerId, string id) returns boolean
		// Governments know their own administered holdings, for player and AI.
		// Other discovery alone never authorizes a project in unknown territory.
		return controller(id) == controllerId and lawful(id)
	override function dispatchAccess(string originId, string recipientId) returns boolean
		let origin = settlement(originId)
		let recipient = settlement(recipientId)
		let officeIndex = campaign.militarySettlements.administratorIndex(recipientId)
		if origin == null or recipient == null or officeIndex < 0 or origin.regionId == recipient.regionId
			return false
		let office = campaign.militarySettlements.administrators[officeIndex]
		return origin.controllerId == recipient.controllerId and known(recipient.controllerId, originId) and known(recipient.controllerId, recipientId) and office.jurisdiction == recipientId and office.capacity > 0 and office.physicalRegionId == origin.regionId and accessible(originId) and accessible(recipientId)
	override function accessible(string id) returns boolean
		for i = 0 to trade.marketCount - 1
			let m = trade.markets[i]
			if m.id == id and not m.blockaded and not m.occupiedByHostile and m.stock > 0
				return true
		return false
	override function pay(string controllerId, string id, int money, string good, int units) returns boolean
		let p = campaign.countries.polityIndex(controllerId)
		if p < 0 or money < 0 or units < 0 or (money == 0 and units == 0) or campaign.countries.treasury[p] < money
			return false
		RuntimeMarket supplies = null
		if units > 0
			supplies = trade.findMarket(id, good)
			if supplies == null or supplies.blockaded or supplies.occupiedByHostile or supplies.stock < units
				return false
		campaign.countries.treasury[p] -= money
		if supplies != null
			supplies.stock -= units
		return true
	override function collect(string controllerId, string id, int maximum) returns int
		let p = campaign.countries.polityIndex(controllerId)
		if p < 0
			return 0
		var remaining = IMinBJ(maximum, 2147483647 - campaign.countries.treasury[p])
		let allowed = remaining
		for i = 0 to trade.marketCount - 1
			let m = trade.markets[i]
			if m.id == id and remaining > 0
				let transfer = IMinBJ(remaining, m.money)
				m.money -= transfer
				remaining -= transfer
		campaign.countries.treasury[p] += allowed - remaining
		return allowed - remaining
	override function diseaseAvailable(string id) returns int
		let s = settlement(id)
		if s == null
			return 0
		return s.manpower
	override function disease(string id, int maximum) returns int
		let s = settlement(id)
		if s == null
			return 0
		let loss = IMinBJ(s.manpower, maximum)
		s.manpower -= loss
		return loss

public class CivicCampaignRuntime implements ResearchEligibilityPort
	PlayableCampaignState campaign
	PlayableTradeRuntime trade
	CampaignCivicEconomy economy
	CivicResearchEffects research
	construct(PlayableCampaignState campaign, PlayableTradeRuntime trade, CivicResearchEffects research)
		this.campaign = campaign
		this.trade = trade
		this.research = research
		economy = new CampaignCivicEconomy(campaign, trade)
		campaign.rpg.technologies.eligibility = this
	override function eligibleResearch(string controllerId, string nodeId) returns boolean
		let ledger = campaign.militarySettlements.civic
		if nodeId != ledger.municipalNode
			return true
		for i = 0 to ledger.count - 1
			let id = ledger.districts[i].id
			if economy.controller(id) == controllerId and economy.lawful(id) and economy.administration(id) >= ledger.minimumAdministration and ledger.states[i].urbanization >= ledger.municipalMinimumUrbanization
				return true
		return false
	function advance(int day)
		campaign.militarySettlements.civic.advance(day, research, economy)
	function act(string controllerId, string action, string id) returns string
		if campaign.loading or campaign.startupLocked or campaign.transitionOpen
			return "Campaign actions are unavailable during restoration or transfer."
		advance(campaign.clock.currentDay)
		return campaign.militarySettlements.civic.action(controllerId, id, action, campaign.clock.currentDay, research, economy)
	function overview(string controllerId, string id) returns string
		let ledger = campaign.militarySettlements.civic
		let i = ledger.index(id)
		if i < 0 or not economy.known(controllerId, id)
			return "Choose a known, administered local tax district."
		let d = ledger.districts[i]
		let s = ledger.states[i]
		return "Isolation care: /civic care DISTRICT; commissioning " + I2S(civicBill(d.annualTax, ledger.careCommissionBasisPoints)) + " currency plus " + I2S(d.medicalUnits) + " " + d.medicalGood + "; preparation " + I2S(ledger.carePreparationDays) + " days; annual upkeep " + I2S(civicBill(d.annualTax, ledger.careUpkeepBasisPoints)) + ". Requires current research, civic center and qualified local staff; each exposed treatment day consumes " + I2S(ledger.careDailyMaterials) + " " + d.medicalGood + ". Ready " + I2S(s.careReady) + ", funded through " + I2S(s.careThrough) + ", treated days " + I2S(s.careDays) + "; +" + I2S(research.rate(controllerId, "isolation_care_losses_avoided")) + " bp avoided actual disease losses. Clinical records: +" + I2S(research.rate(controllerId, "case_records_losses_avoided")) + " bp only during paid isolation care or response; " + I2S(ledger.recordsDailyMoney) + " currency and " + I2S(ledger.recordsDailyMaterials) + " " + ledger.recordsGood + " per treated day, atomic payment; maintained days " + I2S(s.recordsDays) + ". Combined disease fraction " + I2S(s.diseaseRemainder) + "/10000.\nCiphered survey dispatch: up to " + I2S(ledger.dispatchDays(controllerId, id, research, economy)) + " days earlier than the normal survey deadline; requires current remote jurisdiction and an authored accessible relay; additional completion bill " + I2S(civicBill(d.annualTax, ledger.dispatchOperatingBasisPoints)) + " currency. Normal survey deadline " + I2S(s.surveyReady) + ".\nArchives: +" + I2S(civicScale(research.rate(controllerId, "archive_tax_collection_efficiency"), economy.administration(id) * 100)) + " bp collection; qualified administration minimum " + I2S(ledger.minimumAdministration) + "; annual operation bill " + I2S(civicBill(d.annualTax, ledger.archiveUpkeepBasisPoints)) + ". Municipal charter: urbanization " + I2S(s.urbanization) + "% (minimum " + I2S(ledger.municipalMinimumUrbanization) + "), Archives and adopted municipal government required. Enactment " + I2S(civicBill(d.annualTax, ledger.enactmentBasisPoints)) + ", transition " + I2S(ledger.transitionDays) + " days, annual upkeep " + I2S(civicBill(d.annualTax, ledger.upkeepBasisPoints)) + ", +" + I2S(research.rate(controllerId, "municipal_tax_collection_efficiency")) + " bp collection while operational/funded. Ready day " + I2S(s.municipalReady) + ".\nCivic administration: " + id + " (province " + d.provinceId + ")\nNormal annual tax capacity " + I2S(d.annualTax) + " currency minor units. Policy: " + I2S(civicBill(d.annualTax, ledger.enactmentBasisPoints)) + " enactment; " + I2S(ledger.transitionDays) + " days; " + I2S(civicBill(d.annualTax, ledger.upkeepBasisPoints)) + " annual upkeep paid in advance. Requires reform discussion and lawful civic institutions.\nResearch adds " + I2S(research.rate(controllerId, "civic_reform_diffusion")) + " bp to local civic reform diffusion; no automatic emancipation or diplomatic change. Progress " + I2S(s.discussion) + "/10000; policy ready day " + I2S(s.policyReady) + ".\nSurvey: " + I2S(civicBill(d.annualTax, ledger.surveyBasisPoints)) + " currency, " + I2S(ledger.transitionDays) + " days; +" + I2S(research.rate(controllerId, "land_tax_collection_efficiency")) + " bp collection efficiency, capped by local taxable capacity and actual liquidity. Survey ready day " + I2S(s.surveyReady) + "; collected " + I2S(s.taxesCollected) + ".\nMedical response: " + I2S(civicBill(d.annualTax, ledger.responseBasisPoints)) + " currency plus " + I2S(d.medicalUnits) + " " + d.medicalGood + " stock units for dressings; requires outbreak and accessible supplies. " + I2S(ledger.responseDays) + " days; " + I2S(ledger.cooldownDays) + " day cooldown after response; " + I2S(research.rate(controllerId, "epidemic_losses_avoided")) + " bp fewer disease losses; local trade throughput -" + I2S(ledger.tradePenaltyBasisPoints) + " bp. Response end " + I2S(s.responseEnd) + "; reuse day " + I2S(s.cooldownEnd) + "; disease lost " + I2S(s.diseaseLost) + ", avoided " + I2S(s.diseaseAvoided) + ".\nUse /civic <inspect|care|municipal|municipal-repeal|policy|repeal|survey|response> DISTRICT. Each district survey covers only its known local part of the province."

class CivicCommand implements CommandHandler
	CivicCampaignRuntime runtime
	CommandOutput output
	construct(CivicCampaignRuntime runtime, CommandOutput output)
		this.runtime = runtime
		this.output = output
	override function execute(player sender, string arguments)
		let cut = arguments.indexOf(" ")
		if sender != Player(0) or cut <= 0
			output.show(sender, "Use /civic <inspect|care|municipal|municipal-repeal|policy|repeal|survey|response> DISTRICT.")
			return
		let action = SubString(arguments, 0, cut)
		let id = SubString(arguments, cut + 1, StringLength(arguments))
		let controllerId = runtime.campaign.rpg.researchResources.controllerId(sender)
		if action == "inspect"
			runtime.campaign.rpg.management.open("technology")
			output.show(sender, runtime.overview(controllerId, id))
			return
		let problem = runtime.act(controllerId, action, id)
		if problem != ""
			output.show(sender, problem)
		else
			output.show(sender, "Civic action completed.\n" + runtime.overview(controllerId, id))

public function registerCivicCommands(CommandRegistry commands, CivicCampaignRuntime runtime) returns string
	return commands.register("civic", "", "civic <inspect|care|municipal|municipal-repeal|policy|repeal|survey|response> DISTRICT", "Manage local civic policies, surveys and outbreak response.", "Inspect costs and conditions before activation. Government treasury pays; medical response consumes existing local medical dressings. Same rules for player and AI governments. Policies require explicit enactment.", 2, 2, COMMAND_RELEASE, new CivicCommand(runtime, commands.output))
