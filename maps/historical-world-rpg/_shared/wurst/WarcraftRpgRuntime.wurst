public constant int RPG_LEVEL_CAP = HERO_LEVEL_CAP
public constant int RPG_DEFAULT_ACTIVE_HERO_LIMIT = 32
public constant int RPG_STATE_SCHEMA_VERSION = 7
// Equipment assignments reserve owned copies, so they share the item budget.
public constant int RPG_INVENTORY_CAPACITY = 4096
public constant string QUEST_OFFERED = "offered"
public constant string QUEST_ACTIVE = "active"
public constant string QUEST_READY = "ready_to_turn_in"
public constant string QUEST_COMPLETE = "complete"
public constant string QUEST_FAILED = "failed"
constant string RPG_MANAGEMENT_HELP = "Management pauses the campaign. Switch with /roster, /inventory [HERO], /progression HERO, /journal, or /technology. Close with /rpg-close. Other open management screens retain their pause."

function textContains(string haystack,string needle) returns boolean
	if needle == ""
		return true
	for i=0 to StringLength(haystack)-StringLength(needle)
		if SubString(haystack,i,i+StringLength(needle)) == needle
			return true
	return false

/** Reused for one snapshot pass. Scan each record's fields once, without
 * copying the remaining catalogue or reparsing the prefix for every field.
 * Twenty-one fields is the largest supported record (a v6 hero). */
class RpgSnapshotRecord
	string array[21] fields
	int schema = RPG_STATE_SCHEMA_VERSION
	int count = 0
	int nextHero = 0
	int nextQuest = 0
	int nextTreasure = 0
	function append(string value)
		if count < 21
			fields[count] = value
		count++
	function read(string candidate, int start) returns int
		count = 0
		let length = StringLength(candidate)
		var fieldStart = start
		var finish = start
		while finish < length
			let delimiter = SubString(candidate, finish, finish + 1)
			if delimiter == "|"
				break
			if delimiter == ","
				append(SubString(candidate, fieldStart, finish))
				fieldStart = finish + 1
			finish++
		append(SubString(candidate, fieldStart, finish))
		return finish + 1
	function field(int index) returns string
		if index >= count or index >= 21
			return ""
		return fields[index]
	// Captured records follow catalogue order. Reordered compatible snapshots
	// still resolve by stable ID; the cursor is only a lookup optimization.
	function resolveHero(HeroRoster roster) returns RpgHero
		let index = nextHero
		nextHero++
		if index < roster.count and roster.heroes[index].id == field(1)
			return roster.heroes[index]
		return roster.get(field(1))
	function resolveQuest(QuestJournalRuntime journal) returns RuntimeQuest
		let index = nextQuest
		nextQuest++
		if index < journal.count and journal.quests[index].id == field(1)
			return journal.quests[index]
		return journal.get(field(1))
	function resolveTreasure(TreasureRuntime treasures) returns RuntimeTreasure
		let index = nextTreasure
		nextTreasure++
		if index < treasures.count and treasures.treasures[index].id == field(1)
			return treasures.treasures[index]
		return treasures.get(field(1))

function rpgBool(string value) returns boolean
	return value == "1"

function rpgBoolText(boolean value) returns string
	if value
		return "1"
	return "0"

function rpgValidBool(string value) returns boolean
	return value == "0" or value == "1"

function rpgValidInt(string value) returns boolean
	if value == "0"
		return true
	var start = 0
	var limit = "2147483647"
	if value.startsWith("-")
		start = 1
		limit = "2147483648"
	let digits = StringLength(value) - start
	if digits < 1 or digits > 10 or SubString(value, start, start + 1) == "0"
		return false
	// Bound canonical decimal text BEFORE S2I: overflow/malformed input can
	// throw in the interpreter and wrap differently in native runtimes.
	var comparison = 0
	for i = 0 to digits - 1
		let digit = "0123456789".indexOf(SubString(value, start + i, start + i + 1))
		if digit < 0
			return false
		if digits == 10 and comparison == 0
			comparison = digit - "0123456789".indexOf(SubString(limit, i, i + 1))
	return comparison <= 0

function rpgStableText(string value) returns boolean
	return value.indexOf(",") < 0 and value.indexOf("|") < 0 and value.indexOf(";") < 0

function researchControllerId(string value) returns boolean
	// Controller identities predate typed unlocks and need not be content IDs.
	return value != "" and rpgStableText(value) and value.indexOf(":") < 0

function progressionId(string value) returns boolean
	if StringLength(value) < 1 or StringLength(value) > 64
		return false
	for i = 0 to StringLength(value) - 1
		let letter = SubString(value, i, i + 1)
		if "abcdefghijklmnopqrstuvwxyz".indexOf(letter) < 0 and (i == 0 or "0123456789_".indexOf(letter) < 0)
			return false
	return true

/** Compact rank maps use id:rank~ records. Definitions supply the permitted
 * axes; both recruitment and restoration validate before changing authority. */
function validProgressionRanks(string ranks, string allowed) returns boolean
	if StringLength(ranks) > 8192
		return false
	var start = 0
	var seen = "~"
	while start < StringLength(ranks)
		let remaining = SubString(ranks, start, StringLength(ranks))
		let finish = remaining.indexOf("~")
		let cut = remaining.indexOf(":")
		if finish < 0 or cut < 1 or cut >= finish
			return false
		let id = SubString(remaining, 0, cut)
		let rank = SubString(remaining, cut + 1, finish)
		if not progressionId(id) or not textContains(allowed, "~" + id + "~") or textContains(seen, "~" + id + "~") or not rpgValidInt(rank) or S2I(rank) < 0 or S2I(rank) > 100
			return false
		seen += id + "~"
		start += finish + 1
	return true

function progressionRank(string ranks, string id) returns int
	let text = "~" + ranks
	let start = text.indexOf("~" + id + ":")
	if start < 0 or not progressionId(id)
		return 0
	let remaining = SubString(text, start + StringLength(id) + 2, StringLength(text))
	return S2I(SubString(remaining, 0, remaining.indexOf("~")))

function improvedProgressionRank(string ranks, string id) returns string
	let start = ("~" + ranks).indexOf("~" + id + ":")
	let next = id + ":" + (progressionRank(ranks, id) + 1).toString() + "~"
	if start < 0
		return ranks + next
	let remaining = SubString(ranks, start, StringLength(ranks))
	return SubString(ranks, 0, start) + next + SubString(remaining, remaining.indexOf("~") + 1, StringLength(remaining))

function progressionLabel(string id) returns string
	var result = ""
	for i = 0 to StringLength(id) - 1
		let letter = SubString(id, i, i + 1)
		if letter == "_"
			result += " "
		else
			result += letter
	return result

function progressionSelectionsText(string selections) returns string
	var result = ""
	var separator = false
	for i = 0 to StringLength(selections) - 1
		let letter = SubString(selections, i, i + 1)
		if letter == "~"
			separator = result != ""
		else
			if separator
				result += ", "
			result += letter
			separator = false
	if result == ""
		return "None"
	return result

function progressionRanksText(string ranks) returns string
	var result = ""
	var start = 0
	while start < StringLength(ranks)
		let remaining = SubString(ranks, start, StringLength(ranks))
		let finish = remaining.indexOf("~")
		let cut = remaining.indexOf(":")
		if finish < 0 or cut < 1 or cut >= finish
			return "Unavailable"
		if result != ""
			result += ", "
		result += progressionLabel(SubString(remaining, 0, cut)) + " " + SubString(remaining, cut + 1, finish)
		start += finish + 1
	if result == ""
		return "None"
	return result

public class HeroStartingProfile
	int level
	string skills
	string masteries
	string personalTreeId
	construct(int level, string skills, string masteries, string personalTreeId)
		this.level = level
		this.skills = skills
		this.masteries = masteries
		this.personalTreeId = personalTreeId
	function valid(RpgHero hero) returns boolean
		return level >= 1 and level <= RPG_LEVEL_CAP and validProgressionRanks(skills, hero.skillIds) and validProgressionRanks(masteries, hero.masteryIds) and (personalTreeId == "" or progressionId(personalTreeId) and textContains(hero.personalTreeIds, "~" + personalTreeId + "~"))

/** Per-load duplicate index. Hash buckets retain full keys so collisions never
 * merge distinct authority, without a quadratic scan of earlier records. */
class RpgSnapshotKeys
	string array[14849] keys
	int array[14849] next
	int array[2048] buckets
	int array[4096] ownedCopies
	int array[4096] equippedCopies
	int count = 0
	function claim(string key) returns boolean
		if count >= 14849
			return false
		var bucket = StringHash(key) mod 2048
		if bucket < 0
			bucket += 2048
		var entry = buckets[bucket]
		while entry > 0
			if keys[entry - 1] == key
				return false
			entry = next[entry - 1]
		keys[count] = key
		next[count] = buckets[bucket]
		buckets[bucket] = count + 1
		count++
		return true

/** Authoritative character state.  The Warcraft handle is deliberately kept by
 * the projection, not here, so a dead/unloaded object can never erase a hero. */
public class RpgHero
	string id
	string name
	int unitTypeId
	// Definition data, regenerated by stable ID; never part of mutable saves.
	// Non-historical fixtures may use the full Gregorian range.
	int availabilityStartDay = 1
	int availabilityEndDay = 3652059
	HeroStartingProfile startingProfile = null
	string skillIds = ""
	string masteryIds = ""
	string personalTreeIds = ""
	int skillPointEveryLevels = 1
	int masteryPointEveryLevels = 5
	int choicePointEveryLevels = 10
	int level = 1
	// Residual XP; cumulative XP = heroExperienceForLevel(level) + experience.
	int experience = 0
	int skillPoints = 0
	int masteryPoints = 0
	int choicePoints = 0
	int commandExperience = 0
	int loyalty = 50
	boolean oathbound = false
	boolean recruited = false
	boolean incapacitated = false
	int recoveryDay = 0
	string assignment = "unrecruited"
	string regionId = ""
	string professionId = ""
	string personalQuestId = ""
	string signatureProgressionId = ""
	string chosenPerks = ""
	string skillRanks = ""
	string masteryRanks = ""
	construct(string id, string name, int unitTypeId)
		this.id = id
		this.name = name
		this.unitTypeId = unitTypeId
	ondestroy
		if startingProfile != null
			destroy startingProfile
	function cumulativeExperience() returns int
		return heroExperienceForLevel(level) + experience
	function canAwardExperience(int amount) returns boolean
		if amount <= 0 or not heroValidExperience(level, experience) or skillPoints < 0 or masteryPoints < 0 or choicePoints < 0
			return false
		if not heroValidCadence(skillPointEveryLevels) or not heroValidCadence(masteryPointEveryLevels) or not heroValidCadence(choicePointEveryLevels)
			return false
		if amount > HERO_EXPERIENCE_LIMIT - cumulativeExperience()
			return false
		let next = heroLevelForExperience(cumulativeExperience() + amount)
		return skillPoints <= HERO_EXPERIENCE_LIMIT - heroEarnedPoints(level, next, skillPointEveryLevels) and masteryPoints <= HERO_EXPERIENCE_LIMIT - heroEarnedPoints(level, next, masteryPointEveryLevels) and choicePoints <= HERO_EXPERIENCE_LIMIT - heroEarnedPoints(level, next, choicePointEveryLevels)
	function awardExperience(int amount) returns boolean
		if not canAwardExperience(amount)
			return false
		let total = cumulativeExperience() + amount
		let next = heroLevelForExperience(total)
		skillPoints += heroEarnedPoints(level, next, skillPointEveryLevels)
		masteryPoints += heroEarnedPoints(level, next, masteryPointEveryLevels)
		choicePoints += heroEarnedPoints(level, next, choicePointEveryLevels)
		level = next
		experience = total - heroExperienceForLevel(level)
		return true
	/** Called only at the successful first-recruitment commit. The persisted
	 * recruited flag prevents grants on replay, loading and reconstruction. */
	function initializeStartingProfile()
		if recruited or startingProfile == null
			return
		level = startingProfile.level
		// Live XP is residual, whereas the headless engine stores cumulative XP
		// at the level floor. Starting ranks do not grant unspent points.
		experience = 0
		skillPoints = 0
		masteryPoints = 0
		choicePoints = 0
		skillRanks = startingProfile.skills
		masteryRanks = startingProfile.masteries
		signatureProgressionId = startingProfile.personalTreeId
	function skillRank(string id) returns int
		return progressionRank(skillRanks, id)
	function masteryRank(string id) returns int
		return progressionRank(masteryRanks, id)
	function progressionSummary() returns string
		var progress = experience.toString() + "/" + heroNextLevelExperience(level).toString() + " | Remaining experience " + (heroNextLevelExperience(level) - experience).toString()
		if level == RPG_LEVEL_CAP
			progress = experience.toString() + " | Level cap reached | Remaining experience 0"
		return "Level " + level + " | Experience " + progress + " | Skill points " + skillPoints + " | Mastery points " + masteryPoints + " | Choice points " + choicePoints + "\nSkills: " + progressionRanksText(skillRanks) + "\nMasteries: " + progressionRanksText(masteryRanks) + "\nPersonal tree: " + progressionLabel(signatureProgressionId)
	function hasPerk(string perkId) returns boolean
		return progressionId(perkId) and textContains(chosenPerks, "~" + perkId + "~")
	function changeLoyalty(int delta)
		if oathbound and delta < 0
			return
		loyalty = IMaxBJ(0, IMinBJ(100, loyalty + delta))
	function becomeOathbound()
		oathbound = true
		loyalty = 100
	function wound(int currentDay, int recoveryDays)
		if incapacitated
			return
		incapacitated = true
		recoveryDay = currentDay + IMaxBJ(1, recoveryDays)
		assignment = "recovering"
	function advanceRecovery(int currentDay)
		if incapacitated and currentDay >= recoveryDay
			incapacitated = false
			recoveryDay = 0
			assignment = "reserve"
	function conditionSummary(int day) returns string
		if incapacitated
			return "Condition: wounded | Recovery: " + IMaxBJ(0, recoveryDay - day) + " campaign days remaining (day " + recoveryDay + ")"
		return "Condition: ready | Recovery: none"

public class HeroRoster
	// Generated scenario policy; zero means defeat handling is unconfigured.
	int recoveryDays = 0
	WarcraftRecoveryAdapter recovery = null
	string mainCharacterId = ""
	string physicalMapId = ""
	function bindRecovery(int index)
		if recovery != null
			let hero = heroes[index]
			if hero.recruited and hero.assignment == "field" and not hero.incapacitated and (hero.regionId == "" or hero.regionId == physicalMapId)
				recovery.bind("party:" + hero.id, projected[index], physicalMapId)
	function retireRecovery(string id)
		if recovery != null
			recovery.unbind("party:" + id)
	CampaignClock clock = null
	function campaignDay() returns int
		if clock == null
			return 0
		return clock.campaignDay()
	string lastRecruitmentProblem = ""
	RpgHero array[2048] heroes
	unit array[2048] projected
	int count = 0
	int activeLimit = RPG_DEFAULT_ACTIVE_HERO_LIMIT
	function indexOf(string id) returns int
		for i = 0 to count - 1
			if heroes[i].id == id
				return i
		return -1
	function register(RpgHero hero)
		if indexOf(hero.id) < 0
			heroes[count] = hero
			count++
	function get(string id) returns RpgHero
		let i = indexOf(id)
		if i >= 0
			return heroes[i]
		return null
	function recruitmentProblem(string id) returns string
		let hero = get(id)
		if hero == null
			return "That character is unavailable."
		if hero.recruited
			return "That character is already recruited."
		if clock == null or clock.advancing
			return "Campaign time is not ready for recruitment."
		if not isCharacterRecruitmentDay(clock.campaignDay(), hero.availabilityStartDay, hero.availabilityEndDay)
			return "That character is unavailable on the current campaign date."
		if hero.startingProfile != null and not hero.startingProfile.valid(hero)
			return "That character's starting progression is invalid."
		return ""
	function recruit(string id) returns boolean
		// Check the bound authoritative clock at commit, never a cached UI date.
		lastRecruitmentProblem = recruitmentProblem(id)
		if lastRecruitmentProblem != ""
			return false
		let hero = get(id)
		hero.initializeStartingProfile()
		hero.recruited = true
		hero.assignment = "reserve"
		return true
	function strategicRosterSize() returns int
		var result = 0
		for i = 0 to count - 1
			if heroes[i].recruited
				result++
		return result
	function activeCount() returns int
		var result = 0
		for i = 0 to count - 1
			if projected[i] != null and GetUnitTypeId(projected[i]) != 0
				result++
		return result
	function deploy(string id, player owner, real x, real y) returns boolean
		let i = indexOf(id)
		if i < 0 or not heroes[i].recruited or heroes[i].incapacitated or activeCount() >= activeLimit
			return false
		if projected[i] == null or GetUnitTypeId(projected[i]) == 0
			projected[i] = compatCreateUnit(owner, heroes[i].unitTypeId, x, y, 0.)
		heroes[i].assignment = "field"
		// Deployment is local; a previous remote assignment must not make the
		// newly created representation appear to belong to its old region.
		heroes[i].regionId = ""
		bindRecovery(i)
		return true
	function assignRemote(string id, string assignment, string regionId) returns boolean
		let i = indexOf(id)
		if i < 0 or not heroes[i].recruited or heroes[i].incapacitated or assignment == ""
			return false
		retireProjection(i)
		heroes[i].assignment = assignment
		heroes[i].regionId = regionId
		return true
	function retireProjection(int index)
		retireRecovery(heroes[index].id)
		let obsolete = projected[index]
		// Detach BEFORE removal can deliver a death callback.
		projected[index] = null
		if obsolete != null and GetUnitTypeId(obsolete) != 0
			compatRemoveUnit(obsolete)
	function loseRuntimeObjects()
		for i = 0 to count - 1
			retireProjection(i)
	function reconstructField(player owner, real x, real y)
		for i = 0 to count - 1
			if heroes[i].recruited and heroes[i].assignment == "field" and not heroes[i].incapacitated and activeCount() < activeLimit
				retireProjection(i)
				projected[i] = compatCreateUnit(owner, heroes[i].unitTypeId, x, y, 0.)
				bindRecovery(i)

public class PlayerInventory
	RpgItem array[4096] definitions
	int definitionCount = 0
	string array[4096] owned
	int ownedCount = 0
	string array[4096] equippedSlots
	string array[4096] equippedItems
	string array[4096] equippedHeroes
	int equippedCount = 0
	EquipmentSet array[256] sets
	int setCount = 0
	function registerItem(RpgItem itemDefinition)
		definitions[definitionCount] = itemDefinition
		definitionCount++
	function registerSet(EquipmentSet setDefinition)
		sets[setCount] = setDefinition
		setCount++
	function itemIndex(string id) returns int
		for i = 0 to definitionCount - 1
			if definitions[i].id == id
				return i
		return -1
	function getItem(string id) returns RpgItem
		let i = itemIndex(id)
		if i >= 0
			return definitions[i]
		return null
	function ownedQuantity(string id) returns int
		var result = 0
		for i = 0 to ownedCount - 1
			if owned[i] == id
				result++
		return result
	function owns(string id) returns boolean
		return ownedQuantity(id) > 0
	function equippedQuantity(string id) returns int
		var result = 0
		for i = 0 to equippedCount - 1
			if equippedItems[i] == id
				result++
		return result
	function grant(string id) returns boolean
		let value = getItem(id)
		if value == null or ownedCount >= RPG_INVENTORY_CAPACITY or value.unique and owns(id)
			return false
		owned[ownedCount] = id
		ownedCount++
		return true
	function slotIndex(string heroId, string slotId) returns int
		for i = 0 to equippedCount - 1
			if equippedHeroes[i] == heroId and equippedSlots[i] == slotId
				return i
		return -1
	function available(RpgItem value, RpgHero hero, int year, TechnologyRuntime research, string controllerId) returns boolean
		if value == null or hero == null or hero.level < value.requiredLevel or value.startYear != 0 and year < value.startYear or value.endYear != 0 and year > value.endYear
			return false
		for i = 0 to value.technologyCount - 1
			if research == null or not research.isUnlockedOfKind(controllerId, value.technologyIds[i], "technology")
				return false
		for i = 0 to value.institutionCount - 1
			if research == null or not research.isUnlockedOfKind(controllerId, value.institutionIds[i], "institution")
				return false
		return true
	function equip(string heroId, string itemId, RpgHero hero, int year, TechnologyRuntime research, string controllerId) returns boolean
		let value = getItem(itemId)
		if hero == null or hero.id != heroId or not hero.recruited or not owns(itemId) or not available(value, hero, year, research, controllerId)
			return false
		if value.slotId == ""
			return false
		var slot = slotIndex(heroId, value.slotId)
		if slot >= 0 and equippedItems[slot] == itemId
			return true
		let assigned = equippedQuantity(itemId)
		if assigned >= ownedQuantity(itemId) or value.unique and assigned > 0 or slot < 0 and equippedCount >= RPG_INVENTORY_CAPACITY
			return false
		if slot < 0
			slot = equippedCount
			equippedSlots[slot] = value.slotId
			equippedCount++
		equippedItems[slot] = itemId
		equippedHeroes[slot] = heroId
		return true
	function unequip(string heroId, string slotId) returns boolean
		let slot = slotIndex(heroId, slotId)
		if slot < 0
			return false
		for i = slot to equippedCount - 2
			equippedSlots[i] = equippedSlots[i+1]
			equippedItems[i] = equippedItems[i+1]
			equippedHeroes[i] = equippedHeroes[i+1]
		equippedCount--
		equippedSlots[equippedCount] = ""
		equippedItems[equippedCount] = ""
		equippedHeroes[equippedCount] = ""
		return true
	function compare(string heroId, string itemId) returns ItemComparison
		let value = getItem(itemId)
		if value == null
			return null
		let slot = slotIndex(heroId, value.slotId)
		RpgItem equipped = null
		if slot >= 0
			equipped = getItem(equippedItems[slot])
		return new ItemComparison(value, equipped)
	function comparison(string heroId, string itemId) returns string
		let result = compare(heroId, itemId)
		if result == null
			return "Unknown item"
		let description = result.summary()
		destroy result
		return description
	function getSet(string id) returns EquipmentSet
		for i = 0 to setCount - 1
			if sets[i].id == id
				return sets[i]
		return null
	function setPieceCount(string heroId, string setId) returns int
		return setPieceCount(heroId, getSet(setId))
	function setPieceCount(string heroId, EquipmentSet definition) returns int
		if definition == null
			return 0
		var result = 0
		for p = 0 to definition.pieceCount - 1
			var matches = 0
			for i = 0 to equippedCount - 1
				if equippedHeroes[i] == heroId and definition.pieces[p].matches(equippedItems[i], equippedSlots[i])
					matches++
			if definition.allowDuplicatePieces
				result += matches
			else if matches > 0
				result++
		return result
	function firstWearerIndex(string heroId) returns int
		for i = 0 to equippedCount - 1
			if equippedHeroes[i] == heroId
				return i
		return -1
	function resolveSet(string heroId, string setId) returns ResolvedEquipmentSet
		let definition = getSet(setId)
		if definition == null
			return null
		return definition.resolve(heroId, setPieceCount(heroId, setId))

public class RuntimeQuest
	QuestGraph graph = null
	string id
	string title
	string kind
	string regionId = ""
	string giverId = ""
	string turnInId = ""
	string precision = "hidden"
	string destinationId = ""
	string state = QUEST_OFFERED
	int objective = 0
	int objectiveTarget = 1
	int rewardExperience = 0
	int rewardCurrency = 0
	int cooldownUntil = 0
	int completions = 0
	int completionCap = 1
	construct(string id, string title, string kind)
		this.id=id
		this.title=title
		this.kind=kind

	function ready() returns boolean
		if graph != null
			return graph.terminalComplete()
		return objective >= objectiveTarget
	function canRefill(int day) returns boolean
		// A recorded legacy completion is terminal even if its old count was
		// absent/zero. Preserve that outcome without granting another reward.
		if graph != null and graph.legacyTerminal and state == QUEST_COMPLETE
			return false
		return (state == QUEST_COMPLETE or state == QUEST_FAILED) and completions < completionCap and day >= cooldownUntil
	function resetProgress()
		objective = 0
		if graph != null
			graph.reset()
	function updateGuidance()
		if graph == null
			return
		precision = "hidden"
		regionId = ""
		destinationId = ""
		if state != QUEST_ACTIVE and state != QUEST_READY
			return
		let guide = graph.guidance(state == QUEST_READY)
		// Clue-gated destinations remain hidden until a knowledge adapter exists.
		if guide != null and guide.requiredClues == ""
			precision = guide.precision
			if precision != "hidden"
				regionId = guide.regionId
				if precision == "exact"
					destinationId = guide.destinationId
	function settleProgress()
		if graph != null and graph.terminalComplete()
			state = QUEST_READY
		updateGuidance()

	ondestroy
		if graph != null
			destroy graph

public class QuestJournalRuntime
	RuntimeQuest array[2048] quests
	int count = 0
	string trackedId = ""
	int currency = 0
	QuestConditionAuthority conditions = null
	string lastDiagnostic = ""
	function register(RuntimeQuest questDefinition)
		questDefinition.updateGuidance()
		quests[count]=questDefinition
		count++
	function get(string id) returns RuntimeQuest
		for i = 0 to count - 1
			if quests[i].id == id
				return quests[i]
		return null
	function deterministicOffer(string settlementId, int epoch) returns RuntimeQuest
		if count == 0
			return null
		var start = ModuloInteger(StringLength(settlementId) * 31 + epoch, count)
		for offset = 0 to count - 1
			let candidate = quests[ModuloInteger(start + offset, count)]
			if candidate.state == QUEST_OFFERED and candidate.completions < candidate.completionCap and epoch >= candidate.cooldownUntil
				return candidate
		return null
	function accept(string id) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_OFFERED or questDefinition.completions >= questDefinition.completionCap
			return false
		if questDefinition.graph != null
			let required = new QuestIds(questDefinition.graph.prerequisiteQuestIds)
			var available = required.valid
			for i = 0 to required.count - 1
				let prerequisite = get(required.ids[i])
				if prerequisite == null or prerequisite.state != QUEST_COMPLETE
					available = false
			destroy required
			if not available
				lastDiagnostic = "Quest prerequisites are not satisfied."
				return false
			questDefinition.graph.activate()
		questDefinition.state=QUEST_ACTIVE
		questDefinition.updateGuidance()
		return true
	function progress(string id, int amount) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_ACTIVE or questDefinition.graph != null or amount <= 0
			return false
		questDefinition.objective=IMinBJ(questDefinition.objectiveTarget,questDefinition.objective+amount)
		if questDefinition.objective >= questDefinition.objectiveTarget
			questDefinition.state=QUEST_READY
		return true
	function advance(string id, string target) returns boolean
		let q = get(id)
		if q == null or q.state != QUEST_ACTIVE or q.graph == null or not q.graph.advance(target)
			return false
		q.settleProgress()
		return true
	function recordEvent(string id, string objectiveId, string receiptId) returns boolean
		let q = get(id)
		if q == null or q.state != QUEST_ACTIVE or q.graph == null or not questId(receiptId)
			return false
		let graph = q.graph
		let objective = graph.objective(objectiveId)
		if objective == null or not graph.activeObjective(objectiveId) or questHas(graph.processedReceiptIds, receiptId) or objective.binding != "domain_receipt"
			return false
		if conditions == null or not conditions.supports(objective.conditionId)
			lastDiagnostic = "Condition integration unavailable: " + objective.conditionId
			return false
		if not conditions.validates(id, graph.activeStageId, objective, receiptId)
			return false
		graph.processedReceiptIds += receiptId + "~"
		graph.completeObjective(objectiveId)
		q.settleProgress()
		lastDiagnostic = ""
		return true
	/** The caller has just revalidated physical presence. Process the stage
	 * that was active at entry only; a visit cannot cascade through a chain. */
	function visit(RuntimeQuest q, InteractionLocation target) returns boolean
		if q.state != QUEST_ACTIVE or q.graph == null or (target.kind != "settlement" and target.kind != "quest")
			return false
		let graph = q.graph
		let active = graph.activeStageId
		var changed = false
		for i = 0 to graph.objectiveCount - 1
			let objective = graph.objectives[i]
			if graph.activeStageId == active and graph.activeObjective(objective.id) and objective.binding == "physical_visit" and objective.entityRefs == "settlement:" + target.eventId + "~"
				if graph.completeObjective(objective.id)
					changed = true
		q.settleProgress()
		return changed
	function fail(string id, int day, int cooldownDays) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_ACTIVE
			return false
		questDefinition.state=QUEST_FAILED
		questDefinition.cooldownUntil=day+cooldownDays
		return true
	function turnIn(string id, RpgHero hero, int day, int cooldownDays) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_READY or not questDefinition.ready() or questDefinition.completions >= questDefinition.completionCap or hero == null or not hero.recruited or hero.incapacitated
			return false
		// Validate the entire earned-XP award before committing quest/reward state.
		if questDefinition.rewardExperience < 0 or (questDefinition.rewardExperience > 0 and not hero.canAwardExperience(questDefinition.rewardExperience))
			return false
		questDefinition.state=QUEST_COMPLETE
		questDefinition.updateGuidance()
		questDefinition.completions++
		questDefinition.cooldownUntil=day+cooldownDays
		currency+=questDefinition.rewardCurrency
		if questDefinition.rewardExperience > 0
			hero.awardExperience(questDefinition.rewardExperience)
		return true
	function refill(int day)
		for i = 0 to count - 1
			if quests[i].canRefill(day)
				quests[i].state=QUEST_OFFERED
				quests[i].resetProgress()
				quests[i].updateGuidance()
	function track(string id) returns string
		let questDefinition=get(id)
		if questDefinition == null
			return "Quest is unknown."
		if questDefinition.state != QUEST_ACTIVE and questDefinition.state != QUEST_READY
			return "Quest is unavailable."
		questDefinition.updateGuidance()
		if questDefinition.precision == "hidden"
			return "No destination is revealed yet."
		trackedId=id
		if questDefinition.graph != null and questDefinition.precision == "approximate"
			return "approximate:" + questDefinition.regionId + ":" + questDefinition.graph.guidance(questDefinition.state == QUEST_READY).searchAreas
		return questDefinition.precision + ":" + questDefinition.regionId + ":" + questDefinition.destinationId

public class RuntimeTreasure
	string id
	string regionId
	string resolvedLocationId
	int clueStage = 0
	int clueCount = 1
	boolean discovered = false
	string rewardItemId = ""
	TreasureDefinition definition = null
	TreasureResult resolution = null
	string fixedLocationId = ""
	construct(string id, string regionId, string resolvedLocationId)
		this.id=id
		this.regionId=regionId
		this.resolvedLocationId=resolvedLocationId
		fixedLocationId = resolvedLocationId
		if resolvedLocationId != ""
			resolution = new TreasureResult("fixed", resolvedLocationId)
	ondestroy
		if resolution != null
			destroy resolution
		if definition != null
			destroy definition
	function commit(TreasureResult result)
		if resolution != null
			destroy resolution
		resolution = result
		resolvedLocationId = ""
		if result != null
			resolvedLocationId = result.candidateId
			if definition != null
				regionId = definition.get(result.candidateId).regionId
	function knowledgePrecision() returns int
		if resolution == null
			return 0
		if discovered
			return 4
		if definition == null
			if clueStage >= clueCount
				return 4
			return IMinBJ(1, clueStage)
		var precision = 0
		for i = 0 to clueStage - 1
			precision = IMaxBJ(precision, definition.cluePrecisions[i])
		return precision
	function resolutionText() returns string
		if resolution == null
			return "pending,,,,,"
		return resolution.encode()
	function validResult(TreasureResult result, InteractionCatalog locations) returns boolean
		if definition == null
			return result.mode == "fixed" and result.candidateId == fixedLocationId and result.rewardId == "" and result.guardId == "" and result.hazardId == "" and result.encounterId == ""
		return result.valid(definition, locations)

function readTreasureResult(RpgSnapshotRecord record) returns TreasureResult
	let result = new TreasureResult(record.field(4), record.field(5))
	result.rewardId = record.field(6)
	result.guardId = record.field(7)
	result.hazardId = record.field(8)
	result.encounterId = record.field(9)
	return result

public class TreasureRuntime
	string campaignSeed = ""
	InteractionCatalog locations = null
	string unavailableCandidateIds = ""
	RuntimeTreasure array[512] treasures
	int count=0
	function register(RuntimeTreasure treasure)
		treasures[count]=treasure
		count++
	function get(string id) returns RuntimeTreasure
		for i=0 to count-1
			if treasures[i].id == id
				return treasures[i]
		return null
	/** Stage the entire catalogue before publishing any placement or variant.
	 * The caller supplies durable campaign authority; constructors never seed. */
	function resolveAll(string seed) returns boolean
		if not treasureSeedValid(seed) or (campaignSeed != "" and campaignSeed != seed)
			return false
		TreasureResult array[512] staged
		var occupied = ""
		var valid = true
		for i = 0 to count - 1
			let t = treasures[i]
			if t.definition != null and t.resolution != null
				let c = t.definition.get(t.resolution.candidateId)
				if not t.validResult(t.resolution, locations) or (not c.shared and treasureHas(occupied, c.id))
					valid = false
				occupied += "|" + t.resolution.candidateId + "|"
		for i = 0 to count - 1
			let t = treasures[i]
			if valid and t.definition != null and t.resolution == null
				let d = t.definition
				let c = d.choose(seed, unavailableCandidateIds, occupied, locations)
				if c == null
					valid = false
				else
					let result = new TreasureResult("seeded", c.id)
					result.rewardId = d.rewards.choose(seed, t.id + ":reward")
					result.guardId = d.guards.choose(seed, t.id + ":guard")
					result.hazardId = d.hazards.choose(seed, t.id + ":hazard")
					result.encounterId = d.encounters.choose(seed, t.id + ":encounter")
					staged[i] = result
					occupied += "|" + c.id + "|"
		for i = 0 to count - 1
			if staged[i] != null
				if valid
					treasures[i].commit(staged[i])
				else
					destroy staged[i]
		if valid
			campaignSeed = seed
		return valid
	function legacyResult(RuntimeTreasure t) returns TreasureResult
		if t.definition == null
			return new TreasureResult("fixed", t.fixedLocationId)
		return new TreasureResult("legacy", t.definition.legacyLocationId)
	function advanceClue(string id) returns boolean
		let treasure=get(id)
		if treasure == null or treasure.resolution == null or treasure.discovered or treasure.clueStage >= treasure.clueCount
			return false
		treasure.clueStage=IMinBJ(treasure.clueCount,treasure.clueStage+1)
		return true
	function discover(string id, string locationId, PlayerInventory inventory) returns boolean
		let treasure=get(id)
		if treasure == null or treasure.resolution == null or treasure.discovered or treasure.clueStage < treasure.clueCount or treasure.resolution.candidateId != locationId
			return false
		if treasure.rewardItemId != "" and not inventory.grant(treasure.rewardItemId)
			return false
		treasure.discovered=true
		return true

/** Implemented by the campaign navigation adapter, independently of RPG objects. */
public interface QuestNavigationPort
	function canShow(string questId) returns boolean
	function show(string questId, boolean track) returns string
	function reconcile()

public interface RpgProjectionPort
	/** Preserve bookkeeping for retained party objects. Begin before detaching
	 * them; roll back after the original objects have been reattached. */
	function beginPartyLoad()
	function rollbackPartyLoad()
	function commitPartyLoad()
	function beginEquipmentReconciliation()
	function replaceEquipment(EquipmentItemLayer result)
	function finishEquipmentReconciliation()
	function beginEquipmentSetReconciliation()
	function replaceEquipmentSet(ResolvedEquipmentSet result)
	function finishEquipmentSetReconciliation()
	function clearGuidanceLayer()
	function applyQuestGuidance(string questId,string precision,string regionId,string destinationId)
	function clearTreasureKnowledgeLayer()
	function applyTreasureKnowledge(string treasureId,int clueStage,boolean discovered,string regionId,string destinationId)

public class RuntimeTechnology
	string id
	string name
	string kind = "technology"
	int historicalYear
	string baseCost
	string aheadOfTimeCostMultiplier
	string additionalMultiplierPerYearAhead
	// Definitions are scenario-owned; saves contain only controller completion IDs.
	string array[512] prerequisiteIds
	int prerequisiteCount = 0
	ResearchUnlock array[64] unlocks
	int unlockCount = 0
	int expectedUnlockCount = -1
	boolean malformed = false
	construct(string id,string name,int historicalYear,int baseCost)
		this.id=id
		this.name=name
		this.historicalYear=historicalYear
		this.baseCost=I2S(baseCost)
		this.aheadOfTimeCostMultiplier="1"
		this.additionalMultiplierPerYearAhead="0"
	construct(string id,string name,int historicalYear,string baseCost,string aheadMultiplier,string annualMultiplier)
		this.id=id
		this.name=name
		this.historicalYear=historicalYear
		this.baseCost=baseCost
		this.aheadOfTimeCostMultiplier=aheadMultiplier
		this.additionalMultiplierPerYearAhead=annualMultiplier
	function addPrerequisite(string id)
		if prerequisiteCount >= 512
			malformed = true
			return
		prerequisiteIds[prerequisiteCount]=id
		prerequisiteCount++
	function addUnlock(string nodeId, string kind, string contentId)
		if unlockCount >= 64
			malformed = true
			return
		unlocks[unlockCount] = new ResearchUnlock(nodeId, kind, contentId)
		unlockCount++
	function valid() returns boolean
		if malformed or not researchStableId(id) or (kind != "technology" and kind != "institution") or unlockCount < 0 or unlockCount > 64 or prerequisiteCount < 0 or prerequisiteCount > 512
			return false
		if expectedUnlockCount >= 0 and expectedUnlockCount != unlockCount
			return false
		for i = 0 to unlockCount - 1
			let entry = unlocks[i]
			if entry == null or not entry.valid() or entry.nodeId != id
				return false
			for j = 0 to i - 1
				if unlocks[j].kind == entry.kind and unlocks[j].contentId == entry.contentId
					return false
		for i = 0 to prerequisiteCount - 1
			if not researchStableId(prerequisiteIds[i]) or prerequisiteIds[i] == id
				return false
			for j = 0 to i - 1
				if prerequisiteIds[i] == prerequisiteIds[j]
					return false
		return true

public class TechnologyRuntime
	RuntimeTechnology array[512] definitions
	int count=0
	string array[2048] unlockedKeys
	int unlockedCount=0
	TechnologyEffectPort effects
	boolean malformed = false
	// Includes old controllers until reconstruction clears their obsolete layers.
	string knownControllers = "|"
	construct(TechnologyEffectPort effects)
		this.effects=effects
	function register(RuntimeTechnology technology) returns boolean
		if technology == null or count >= 512 or not technology.valid() or get(technology.id) != null
			malformed = true
			return false
		definitions[count]=technology
		count++
		return true
	function validDefinition(RuntimeTechnology definition) returns boolean
		if malformed or definition == null or not definition.valid()
			return false
		for i = 0 to definition.prerequisiteCount - 1
			if get(definition.prerequisiteIds[i]) == null
				return false
		return true
	function rememberController(string controllerId)
		if not textContains(knownControllers, "|" + controllerId + "|")
			knownControllers += controllerId + "|"
	function get(string id) returns RuntimeTechnology
		for i=0 to count-1
			if definitions[i].id == id
				return definitions[i]
		return null
	function isUnlocked(string controllerId,string id) returns boolean
		for i=0 to unlockedCount-1
			if unlockedKeys[i] == controllerId+":"+id
				return true
		return false
	function isUnlockedOfKind(string controllerId,string id,string kind) returns boolean
		let definition=get(id)
		return definition != null and definition.kind == kind and isUnlocked(controllerId,id)
	function unlockedOfKind(string controllerId,string kind) returns string
		var result="~"
		for i=0 to count-1
			if definitions[i].kind == kind and isUnlocked(controllerId,definitions[i].id)
				result+=definitions[i].id+"~"
		return result
	function cost(string id,int year,int provincialAdoption,int institutionalSupport) returns int
		let technology=get(id)
		if not validDefinition(technology)
			return -1
		return researchGoldCost(technology.baseCost,technology.aheadOfTimeCostMultiplier,technology.additionalMultiplierPerYearAhead,technology.historicalYear,year,provincialAdoption,institutionalSupport)
	function unlock(string controllerId,string id,int year,int paid,int provincialAdoption,int institutionalSupport) returns boolean
		let technology=get(id)
		let required=cost(id,year,provincialAdoption,institutionalSupport)
		if technology == null or required<1 or not researchControllerId(controllerId) or unlockedCount>=2048 or isUnlocked(controllerId,id) or paid < required
			return false
		for i=0 to technology.prerequisiteCount-1
			if not isUnlocked(controllerId,technology.prerequisiteIds[i])
				return false
		unlockedKeys[unlockedCount]=controllerId+":"+id
		unlockedCount++
		reconstruct(controllerId)
		return true
	function entitlements(string controllerId) returns ResearchEntitlements
		let result = new ResearchEntitlements(controllerId)
		// Definition and authored unlock order, independent of completion order.
		for i = 0 to count - 1
			let definition = definitions[i]
			if isUnlocked(controllerId, definition.id)
				for j = 0 to definition.unlockCount - 1
					result.add(definition.unlocks[j])
		return result
	function bindingStatus(ResearchUnlock definition) returns string
		if effects != null and effects.bindingStatus(definition) == RESEARCH_BOUND
			return RESEARCH_BOUND
		return RESEARCH_UNBOUND
	function reconstruct(string controllerId)
		rememberController(controllerId)
		let result = entitlements(controllerId)
		if effects == null
			destroy result
		else
			effects.replaceResearchEntitlements(result)
	function reconstructAll()
		for i = 0 to unlockedCount - 1
			let key = unlockedKeys[i]
			rememberController(SubString(key, 0, key.indexOf(":")))
		var start = 1
		while start < StringLength(knownControllers)
			let remaining = SubString(knownControllers, start, StringLength(knownControllers))
			let finish = remaining.indexOf("|")
			reconstruct(SubString(remaining, 0, finish))
			start += finish + 1

/** Campaign time and native resources used by the production research command. */
public interface ResearchCommandResources
	function controllerId(player sender) returns string
	function year() returns int
	function gold(player sender) returns int
	function setGold(player sender,int amount)

public class WarcraftResearchResources implements ResearchCommandResources
	override function controllerId(player sender) returns string
		// The single-player campaign's existing persisted research identity.
		return "player"
	override function year() returns int
		return getCampaignYear()
	override function gold(player sender) returns int
		return GetPlayerState(sender,PLAYER_STATE_RESOURCE_GOLD)
	override function setGold(player sender,int amount)
		SetPlayerState(sender,PLAYER_STATE_RESOURCE_GOLD,amount)

/** A field assignment alone is insufficient: removed, dead, loaded and
 * differently owned Warcraft representations cannot perform local actions. */
public class WarcraftInteractionActors implements InteractionActors
	HeroRoster heroes
	construct(HeroRoster heroes)
		this.heroes = heroes
	override function present(int actor, player owner) returns boolean
		let target = heroes.projected[actor]
		return target != null and GetUnitTypeId(target) != 0 and GetOwningPlayer(target) == owner and GetWidgetLife(target) > 0.405 and not IsUnitType(target, UNIT_TYPE_DEAD) and not IsUnitLoaded(target) and not IsUnitHidden(target)
	override function x(int actor) returns real
		return GetUnitX(heroes.projected[actor])
	override function y(int actor) returns real
		return GetUnitY(heroes.projected[actor])
	override function movement(int actor) returns int
		return compatInteractionMovement(heroes.projected[actor])

/** One owner for authoritative RPG state. Serialization ports capture these
 * stable fields; reconstruct() recreates only transient Warcraft projections. */
public class WarcraftRpgRuntime
	ManagementScreenSession management = new ManagementScreenSession()
	HeroAllocationDefinitions allocations = new HeroAllocationDefinitions()
	HeroRoster heroes = new HeroRoster()
	PlayerInventory inventory = new PlayerInventory()
	QuestJournalRuntime journal = new QuestJournalRuntime()
	TreasureRuntime treasures = new TreasureRuntime()
	PhysicalInteractionContext interactions = new PhysicalInteractionContext()
	InteractionVisitListener visits = null
	TechnologyRuntime technologies
	ResearchCommandResources researchResources = new WarcraftResearchResources()
	RpgProjectionPort projections = null
	QuestNavigationPort navigation = null
	string lastDiagnostic = ""
	construct(TechnologyEffectPort effects)
		technologies = new TechnologyRuntime(effects)
		interactions.actors = new WarcraftInteractionActors(heroes)
	function setProjectionPort(RpgProjectionPort value)
		projections=value
	/** The strategic roster belongs to the single campaign player, independently
	 * of unit existence, assignment, or recovery. Never trust a caller's cost,
	 * level requirement, tree or native unit ownership as allocation authority. */
	function allocationOwnerProblem(player sender, string heroId) returns string
		if sender != Player(0)
			return "Only the campaign player can manage this roster."
		let hero = heroes.get(heroId)
		if hero == null
			return "Unknown character."
		if not hero.recruited
			return "That character is not in your recruited roster."
		return ""
	function allocationProblem(RpgHero hero, string kind, string id) returns string
		if not progressionId(id)
			return "Invalid allocation ID."
		if kind == "skill" or kind == "mastery"
			if allocations.rank(kind, id) == null
				return "Unknown " + kind + "."
			var ranks = hero.skillRanks
			var allowed = hero.skillIds
			var points = hero.skillPoints
			if kind == "mastery"
				ranks = hero.masteryRanks
				allowed = hero.masteryIds
				points = hero.masteryPoints
			if not textContains(allowed, "~" + id + "~") or not validProgressionRanks(ranks, allowed)
				return "Invalid rank authority."
			if progressionRank(ranks, id) >= 100
				return "Rank is capped at 100."
			if points < 1
				return "Insufficient " + kind + " points."
			if not validProgressionRanks(improvedProgressionRank(ranks, id), allowed)
				return "Rank storage is full."
			return ""
		if kind != "perk"
			return "Unknown allocation kind."
		let perk = allocations.perk(id)
		if perk == null or allocations.getAbility(perk.abilityId) == null
			return "Unknown perk or ability definition."
		if not allocations.inTree(hero.signatureProgressionId, id)
			return "Perk is outside this character's personal tree."
		if hero.hasPerk(id)
			return "Perk is already selected."
		if hero.level < perk.minimumLevel
			return "Requires level " + perk.minimumLevel + "."
		for i = 0 to allocations.perkCount - 1
			let required = allocations.perks[i].id
			if textContains(perk.prerequisites, "~" + required + "~") and not hero.hasPerk(required)
				return "Requires perk " + required + "."
		if hero.choicePoints < 1
			return "Insufficient choice points."
		return ""
	function allocate(player sender, string heroId, string kind, string id) returns string
		let ownerProblem = allocationOwnerProblem(sender, heroId)
		if ownerProblem != ""
			return ownerProblem
		let hero = heroes.get(heroId)
		let problem = allocationProblem(hero, kind, id)
		if problem != ""
			return problem
		// All validation precedes the debit and mutation. No projection callback
		// grants abilities or replays allocations during reconstruction.
		if kind == "skill"
			hero.skillRanks = improvedProgressionRank(hero.skillRanks, id)
			hero.skillPoints--
		else if kind == "mastery"
			hero.masteryRanks = improvedProgressionRank(hero.masteryRanks, id)
			hero.masteryPoints--
		else
			hero.chosenPerks += "~" + id + "~"
			hero.choicePoints--
		return ""
	function allocationSummary(string heroId) returns string
		let hero = heroes.get(heroId)
		var rows = hero.name + " [" + hero.id + "]\n" + hero.progressionSummary() + "\nSelected perks: " + progressionSelectionsText(hero.chosenPerks)
		rows += "\nOne matching point buys one rank (maximum 100); one choice point buys one perk. Respecialization is unavailable."
		for i = 0 to allocations.rankCount - 1
			let definition = allocations.ranks[i]
			var rank = hero.skillRank(definition.id)
			if definition.kind == "mastery"
				rank = hero.masteryRank(definition.id)
			var status = allocationProblem(hero, definition.kind, definition.id)
			if status == ""
				status = "Available"
			rows += "\n" + definition.kind + " " + definition.id + " (" + definition.name + "): " + rank + " | " + status
		for i = 0 to allocations.perkCount - 1
			let perk = allocations.perks[i]
			if allocations.inTree(hero.signatureProgressionId, perk.id)
				var status = allocationProblem(hero, "perk", perk.id)
				if status == ""
					status = "Available"
				rows += "\nperk " + perk.id + " | level " + perk.minimumLevel + " | prerequisites " + progressionSelectionsText(perk.prerequisites) + " | ability " + perk.abilityId + " | " + status
		rows += "\nSelected perks retain ability entitlements; ability effects are pending.\nUse /improveskill HERO SKILL, /improvemastery HERO MASTERY, or /chooseperk HERO PERK."
		return rows
	function hasSelectedAbility(string heroId, string abilityId) returns boolean
		let hero = heroes.get(heroId)
		if hero == null or not hero.recruited or allocations.getAbility(abilityId) == null
			return false
		for i = 0 to allocations.perkCount - 1
			let perk = allocations.perks[i]
			if perk.abilityId == abilityId and allocations.inTree(hero.signatureProgressionId, perk.id) and hero.hasPerk(perk.id)
				return true
		return false
	/** Establishes a deterministic playable party for a new campaign. Existing
	 * recruited characters win; otherwise the first temporally eligible scenario
	 * character becomes the main character, using the same recruitment gate. */
	function prepareNewCampaign() returns boolean
		var main = -1
		for i=0 to heroes.count-1
			if heroes.heroes[i].recruited
				main=i
		if main < 0
			for i=0 to heroes.count-1
				if main < 0 and heroes.recruit(heroes.heroes[i].id)
					main=i
		if main < 0
			return false
		heroes.mainCharacterId = heroes.heroes[main].id
		heroes.heroes[main].assignment="field"
		heroes.heroes[main].regionId=""
		return true
	function startNewCampaign(player owner, real x, real y) returns boolean
		if not prepareNewCampaign()
			return false
		reconstruct(owner,x,y,"player")
		return heroes.activeCount() > 0
	function equipItem(string heroId,string itemId,int year) returns boolean
		return equipItem(heroId,itemId,year,"player")
	function equipItem(string heroId,string itemId,int year,string controllerId) returns boolean
		let hero=heroes.get(heroId)
		if not inventory.equip(heroId,itemId,hero,year,technologies,controllerId)
			return false
		reconcile(controllerId)
		return true
	function unequipItem(string heroId,string slotId) returns boolean
		if heroes.get(heroId) == null or not inventory.unequip(heroId,slotId)
			return false
		reconcile("player")
		return true
	function research(string controllerId,string id,int year,int paid) returns boolean
		return technologies.unlock(controllerId,id,year,paid,0,0)
	function acceptQuest(string id) returns boolean
		let accepted=journal.accept(id)
		if accepted
			journal.track(id)
			reconcile("player")
		return accepted
	/** Legacy unscoped signals contain no objective identity or validated
	 * condition receipt. Keep callers compatible, but never invent evidence. */
	function worldEvent(string eventKind,string locationId,int amount) returns boolean
		return worldEventAt(eventKind,locationId,amount,0)
	function worldEventAt(string eventKind,string locationId,int amount,int day) returns boolean
		return false
	function questEvent(string id, string objectiveId, string receiptId) returns boolean
		let changed = journal.recordEvent(id, objectiveId, receiptId)
		if changed
			reconcile("player")
		return changed
	function advanceQuest(string id, string stageId) returns boolean
		let changed = journal.advance(id, stageId)
		if changed
			reconcile("player")
		return changed
	function eligibleActor(int index) returns boolean
		let hero = heroes.heroes[index]
		return hero.recruited and not hero.incapacitated and hero.assignment == "field"
	function localActor(player sender, string target) returns int
		for i = 0 to heroes.count - 1
			if eligibleActor(i) and interactions.resolve(i, sender, target) != null
				return i
		return -1
	/** Resolve again at commit; no tracked marker, previous check or saved
	 * assignment is a capability to mutate at a requested target. */
	function interact(player sender, string requested, int day) returns boolean
		let actor = localActor(sender, requested)
		if actor < 0 or not eligibleActor(actor)
			return false
		let target = interactions.resolve(actor, sender, requested)
		if target == null
			return false
		var changed = false
		if visits != null
			changed = visits.recordVisit(target)
		for i = 0 to journal.count - 1
			let q = journal.quests[i]
			let atGiver = target.matches(q.giverId)
			let atTurnIn = target.matches(q.turnInId)
			// Refill only an eligible local offer, never unrelated quests during
			// a rejected request or a repeated treasure collection.
			if atGiver and q.canRefill(day)
				q.state = QUEST_OFFERED
				q.resetProgress()
			if atGiver and q.state == QUEST_OFFERED and journal.accept(q.id)
				journal.track(q.id)
				changed = true
			else if q.state == QUEST_READY
				if atTurnIn and journal.turnIn(q.id, heroes.heroes[actor], day, 30)
					changed = true
			else if journal.visit(q, target)
				changed = true
		for i=0 to treasures.count-1
			let t=treasures.treasures[i]
			if t.resolution != null and target.kind == "region" and t.regionId == target.eventId
				if treasures.advanceClue(t.id)
					changed=true
			if t.resolution != null and t.resolution.candidateId == target.id
				if treasures.discover(t.id,target.id,inventory)
					changed=true
		if changed
			reconcile("player")
		return changed
	function turnInQuest(player sender,string id,string heroId,int day,int cooldownDays) returns boolean
		let q=journal.get(id)
		let actor = heroes.indexOf(heroId)
		if q == null or q.turnInId == "" or actor < 0 or not eligibleActor(actor)
			return false
		if interactions.resolve(actor, sender, q.turnInId) == null
			return false
		if not eligibleActor(actor)
			return false
		let target = interactions.resolve(actor, sender, q.turnInId)
		if target == null
			return false
		let result=journal.turnIn(id,heroes.get(heroId),day,cooldownDays)
		if result
			if visits != null
				visits.recordVisit(target)
			reconcile("player")
		return result
	function diagnostic() returns string
		return lastDiagnostic
	function validQuestState(string value) returns boolean
		return value == QUEST_OFFERED or value == QUEST_ACTIVE or value == QUEST_READY or value == QUEST_COMPLETE or value == QUEST_FAILED
	function validateRecord(RpgSnapshotRecord record) returns boolean
		let kind=record.field(0)
		let id=record.field(1)
		if kind == "p"
			return record.count == 2 and (id == "" or heroes.get(id) != null)
		if kind == "h"
			let hero = record.resolveHero(heroes)
			var expectedFields = 18
			if record.schema >= 4
				expectedFields = 20
			if record.schema >= 6
				expectedFields = 21
			if hero == null or record.count != expectedFields or (record.schema >= 4 and (not validProgressionRanks(record.field(18), hero.skillIds) or not validProgressionRanks(record.field(19), hero.masteryIds)))
				return false
			for index = 3 to 7
				if not rpgValidInt(record.field(index))
					return false
			// v2-v5 residual XP is rebased onto the corrected floor at the saved
			// level. Old uncapped thresholds were never larger than the new ones.
			// Preserve all allocations; absent choice balances migrate to zero.
			if not heroValidExperience(S2I(record.field(3)), S2I(record.field(4))) or S2I(record.field(5)) < 0 or S2I(record.field(6)) < 0 or S2I(record.field(7)) < 0
				return false
			if record.schema >= 6 and (not rpgValidInt(record.field(20)) or S2I(record.field(20)) < 0)
				return false
			return rpgValidBool(record.field(2)) and rpgValidInt(record.field(8)) and S2I(record.field(8)) >= 0 and S2I(record.field(8)) <= 100 and rpgValidBool(record.field(9)) and rpgValidBool(record.field(10)) and rpgValidInt(record.field(11)) and rpgStableText(record.field(12)) and rpgStableText(record.field(13)) and rpgStableText(record.field(14)) and rpgStableText(record.field(15)) and rpgStableText(record.field(16)) and rpgStableText(record.field(17))
		if kind == "i"
			return record.count == 2 and inventory.getItem(id) != null
		if kind == "e"
			return record.count == 4 and id != "" and inventory.getItem(record.field(2)) != null and id == inventory.getItem(record.field(2)).slotId and heroes.get(record.field(3)) != null
		if kind == "u"
			return record.count == 3 and researchControllerId(id) and technologies.validDefinition(technologies.get(record.field(2)))
		if kind == "q"
			let q = record.resolveQuest(journal)
			if q == null or not validQuestState(record.field(2)) or not rpgValidInt(record.field(3)) or S2I(record.field(3)) < 0 or not rpgValidInt(record.field(4)) or not rpgValidInt(record.field(5)) or S2I(record.field(5)) < 0
				return false
			if record.schema < 5
				return record.count == 6
			if record.count != 11 or not rpgValidBool(record.field(10))
				return false
			let empty = record.field(6) == "" and record.field(7) == "" and record.field(8) == "" and record.field(9) == ""
			if q.graph == null
				return empty and record.field(10) == "0"
			if S2I(record.field(3)) != 0
				return false
			let status = record.field(2)
			if record.field(10) == "1"
				return empty and (status == QUEST_COMPLETE or status == QUEST_FAILED)
			if status == QUEST_OFFERED
				return empty
			if not q.graph.validProgress(record.field(6), record.field(7), record.field(8), record.field(9))
				return false
			let stage = q.graph.stage(record.field(6))
			let terminal = stage.nextStageIds == "" and q.graph.stageComplete(stage.id, record.field(8))
			if status == QUEST_READY or status == QUEST_COMPLETE
				return terminal and (status != QUEST_COMPLETE or S2I(record.field(5)) > 0)
			return status != QUEST_ACTIVE or not terminal
		if kind == "j"
			return record.count == 3 and (id == "" or journal.get(id) != null) and rpgValidInt(record.field(2))
		if kind == "s"
			return record.schema >= 7 and record.count == 2 and (id == "" or treasureSeedValid(id))
		if kind == "t"
			let treasure = record.resolveTreasure(treasures)
			if treasure == null or not rpgValidInt(record.field(2)) or S2I(record.field(2)) < 0 or S2I(record.field(2)) > treasure.clueCount or not rpgValidBool(record.field(3))
				return false
			if record.schema < 7
				let legacy = treasures.legacyResult(treasure)
				let validLegacy = record.count == 4 and treasure.validResult(legacy, treasures.locations)
				destroy legacy
				return validLegacy
			if record.count != 10
				return false
			let result = readTreasureResult(record)
			var valid = false
			if result.mode == "pending"
				valid = treasure.definition != null and record.field(2) == "0" and record.field(3) == "0" and result.encode() == "pending,,,,,"
			else
				valid = treasure.validResult(result, treasures.locations)
			destroy result
			return valid
		return false
	function captureState() returns string
		var result="v"+RPG_STATE_SCHEMA_VERSION.toString()+"|p,"+heroes.mainCharacterId+"|s,"+treasures.campaignSeed
		for i=0 to heroes.count-1
			let h=heroes.heroes[i]
			result+="|h,"+h.id+","+rpgBoolText(h.recruited)+","+h.level.toString()+","+h.experience.toString()+","+h.skillPoints.toString()+","+h.masteryPoints.toString()+","+h.commandExperience.toString()+","+h.loyalty.toString()+","+rpgBoolText(h.oathbound)+","+rpgBoolText(h.incapacitated)+","+h.recoveryDay.toString()+","+h.assignment+","+h.regionId+","+h.professionId+","+h.personalQuestId+","+h.signatureProgressionId+","+h.chosenPerks
			result+=","+h.skillRanks+","+h.masteryRanks+","+h.choicePoints.toString()
		for i=0 to inventory.ownedCount-1
			result+="|i,"+inventory.owned[i]
		for i=0 to inventory.equippedCount-1
			result+="|e,"+inventory.equippedSlots[i]+","+inventory.equippedItems[i]+","+inventory.equippedHeroes[i]
		for i=0 to technologies.unlockedCount-1
			let key=technologies.unlockedKeys[i]
			let cut=key.indexOf(":")
			result+="|u,"+SubString(key,0,cut)+","+SubString(key,cut+1,StringLength(key))
		for i=0 to journal.count-1
			let q=journal.quests[i]
			result+="|q,"+q.id+","+q.state+","+q.objective.toString()+","+q.cooldownUntil.toString()+","+q.completions.toString()
			if q.graph == null
				result+=",,,,,0"
			else
				result+=","+q.graph.activeStageId+","+q.graph.reachedStageIds+","+q.graph.completedObjectiveIds+","+q.graph.processedReceiptIds+","+rpgBoolText(q.graph.legacyTerminal)
		result+="|j,"+journal.trackedId+","+journal.currency.toString()
		for i=0 to treasures.count-1
			let t=treasures.treasures[i]
			result+="|t,"+t.id+","+t.clueStage.toString()+","+rpgBoolText(t.discovered)+","+t.resolutionText()
		return result
	function applyRecord(RpgSnapshotRecord record)
		let kind=record.field(0)
		let id=record.field(1)
		if kind == "p"
			heroes.mainCharacterId = id
		else if kind == "h"
			let h=record.resolveHero(heroes)
			h.recruited=rpgBool(record.field(2))
			h.level=S2I(record.field(3))
			h.experience=S2I(record.field(4))
			h.skillPoints=S2I(record.field(5))
			h.masteryPoints=S2I(record.field(6))
			h.choicePoints=0
			if record.schema >= 6
				h.choicePoints=S2I(record.field(20))
			h.commandExperience=S2I(record.field(7))
			h.loyalty=S2I(record.field(8))
			h.oathbound=rpgBool(record.field(9))
			h.incapacitated=rpgBool(record.field(10))
			h.recoveryDay=S2I(record.field(11))
			h.assignment=record.field(12)
			h.regionId=record.field(13)
			h.professionId=record.field(14)
			h.personalQuestId=record.field(15)
			h.signatureProgressionId=record.field(16)
			h.chosenPerks=record.field(17)
			// v2/v3 have no rank fields. Do not replay a starting grant or
			// replace their saved level, XP, points or personal progression.
			h.skillRanks=record.field(18)
			h.masteryRanks=record.field(19)
		else if kind == "i"
			inventory.owned[inventory.ownedCount]=id
			inventory.ownedCount++
		else if kind == "e"
			inventory.equippedSlots[inventory.equippedCount]=id
			inventory.equippedItems[inventory.equippedCount]=record.field(2)
			inventory.equippedHeroes[inventory.equippedCount]=record.field(3)
			inventory.equippedCount++
		else if kind == "u"
			technologies.unlockedKeys[technologies.unlockedCount]=id+":"+record.field(2)
			technologies.unlockedCount++
		else if kind == "q"
			let q=record.resolveQuest(journal)
			q.state=record.field(2)
			q.objective=S2I(record.field(3))
			q.cooldownUntil=S2I(record.field(4))
			q.completions=S2I(record.field(5))
			if q.graph != null
				q.graph.reset()
				q.objective = 0
				if record.schema >= 5
					q.graph.activeStageId = record.field(6)
					q.graph.reachedStageIds = record.field(7)
					q.graph.completedObjectiveIds = record.field(8)
					q.graph.processedReceiptIds = record.field(9)
					q.graph.legacyTerminal = rpgBool(record.field(10))
				else if q.state == QUEST_ACTIVE or q.state == QUEST_READY
					// Legacy counters identify no objectives. Restart the authored
					// initial stage without fabricating any completion evidence.
					q.state = QUEST_ACTIVE
					q.graph.activate()
				else if q.state == QUEST_COMPLETE or q.state == QUEST_FAILED
					// Preserve terminal outcomes and rewards, with unknown history.
					q.graph.legacyTerminal = true
			q.updateGuidance()
		else if kind == "j"
			journal.trackedId=id
			journal.currency=S2I(record.field(2))
		else if kind == "s"
			treasures.campaignSeed = id
		else if kind == "t"
			let t=record.resolveTreasure(treasures)
			if record.schema < 7
				t.commit(treasures.legacyResult(t))
			else if record.field(4) == "pending"
				t.commit(null)
			else
				t.commit(readTreasureResult(record))
			t.clueStage=S2I(record.field(2))
			t.discovered=rpgBool(record.field(3))
	function restoreState(string candidate) returns boolean
		if not validateState(candidate)
			return false
		treasures.campaignSeed = "1"
		heroes.mainCharacterId = ""
		inventory.ownedCount=0
		inventory.equippedCount=0
		for i = 0 to technologies.unlockedCount - 1
			let key = technologies.unlockedKeys[i]
			technologies.rememberController(SubString(key, 0, key.indexOf(":")))
		technologies.unlockedCount=0
		if candidate == "v1"
			for i=0 to heroes.count-1
				let h=heroes.heroes[i]
				h.level=1
				h.experience=0
				h.skillPoints=0
				h.masteryPoints=0
				h.choicePoints=0
				h.commandExperience=0
				h.loyalty=50
				h.oathbound=false
				h.recruited=false
				h.incapacitated=false
				h.recoveryDay=0
				h.assignment="unrecruited"
				h.regionId=""
				h.chosenPerks=""
				h.signatureProgressionId=""
				h.skillRanks=""
				h.masteryRanks=""
			for i=0 to journal.count-1
				let q=journal.quests[i]
				q.state=QUEST_OFFERED
				q.resetProgress()
				q.updateGuidance()
				q.cooldownUntil=0
				q.completions=0
			journal.trackedId=""
			journal.currency=0
			for i=0 to treasures.count-1
				treasures.treasures[i].commit(treasures.legacyResult(treasures.treasures[i]))
				treasures.treasures[i].clueStage=0
				treasures.treasures[i].discovered=false
			lastDiagnostic=""
			return true
		let record = new RpgSnapshotRecord()
		record.schema = S2I(SubString(candidate, 1, 2))
		var start=3
		while start < StringLength(candidate)
			start=record.read(candidate,start)
			applyRecord(record)
		destroy record
		if candidate.startsWith("v2|")
			// Legacy saves had no main ID. Preserve the first deployed member in
			// catalogue order; do not select a reserve or remote representation.
			for i = 0 to heroes.count - 1
				let hero = heroes.heroes[i]
				if heroes.mainCharacterId == "" and hero.recruited and hero.assignment == "field" and not hero.incapacitated
					heroes.mainCharacterId = hero.id
			// A legacy all-wounded roster still owns its original characters.
			for i = 0 to heroes.count - 1
				if heroes.mainCharacterId == "" and heroes.heroes[i].recruited and heroes.heroes[i].incapacitated
					heroes.mainCharacterId = heroes.heroes[i].id
		lastDiagnostic=""
		return true
	function validateState(string candidate) returns boolean
		if technologies.malformed
			lastDiagnostic = "Research definitions are malformed"
			return false
		if candidate == "v1"
			var legacyOccupied = ""
			for i = 0 to treasures.count - 1
				let t = treasures.treasures[i]
				let legacy = treasures.legacyResult(t)
				var valid = t.validResult(legacy, treasures.locations)
				if t.definition != null and valid
					let c = t.definition.get(legacy.candidateId)
					valid = c.shared or not treasureHas(legacyOccupied, c.id)
					legacyOccupied += "|" + c.id + "|"
				destroy legacy
				if not valid
					lastDiagnostic = "Legacy treasure placement is unavailable or inconsistent"
					return false
			lastDiagnostic=""
			return true
		if not candidate.startsWith("v2|") and not candidate.startsWith("v3|") and not candidate.startsWith("v4|") and not candidate.startsWith("v5|") and not candidate.startsWith("v6|") and not candidate.startsWith("v7|")
			lastDiagnostic="RPG state schema is incompatible"
			return false
		let keys = new RpgSnapshotKeys()
		let record = new RpgSnapshotRecord()
		record.schema = S2I(SubString(candidate, 1, 2))
		var start=3
		var mainRecords=0
		var heroRecords=0
		var itemRecords=0
		var equipmentRecords=0
		var unlockRecords=0
		var questRecords=0
		var journalRecords=0
		var treasureRecords=0
		var seedRecords=0
		var seed = ""
		var pending = false
		var resolved = false
		var occupied = ""
		while start < StringLength(candidate)
			start=record.read(candidate,start)
			if not validateRecord(record)
				destroy record
				destroy keys
				lastDiagnostic="RPG state contains malformed or unknown authority"
				return false
			let kind=record.field(0)
			let id=record.field(1)
			var key=kind+","+id
			if kind == "u"
				key+=","+record.field(2)
			else if kind == "e"
				key+=","+record.field(3)
			// Multiple copies of ordinary items are valid inventory authority.
			// Unique items, character-slot pairs, and other records stay unique.
			if not (kind == "i" and not inventory.getItem(id).unique) and not keys.claim(key)
				destroy record
				destroy keys
				lastDiagnostic="RPG state contains duplicate authority"
				return false
			if kind == "p"
				mainRecords++
			else if kind == "h"
				heroRecords++
			else if kind == "i"
				itemRecords++
				keys.ownedCopies[inventory.itemIndex(id)]++
			else if kind == "e"
				equipmentRecords++
				keys.equippedCopies[inventory.itemIndex(record.field(2))]++
			else if kind == "u"
				unlockRecords++
			else if kind == "q"
				questRecords++
			else if kind == "j"
				journalRecords++
			else if kind == "s"
				seedRecords++
				seed = id
			else if kind == "t"
				treasureRecords++
				let t = treasures.get(id)
				if t.definition != null
					var locationId = record.field(5)
					if record.schema < 7
						locationId = t.definition.legacyLocationId
					if locationId == ""
						pending = true
					else
						resolved = true
						let c = t.definition.get(locationId)
						if not c.shared and treasureHas(occupied, locationId)
							destroy record
							destroy keys
							lastDiagnostic = "Exclusive treasure placement is duplicated"
							return false
						occupied += "|" + locationId + "|"
		destroy record
		// Check the entire candidate, independent of record order, before any
		// authority is changed. Every equipped record reserves one owned copy.
		for i=0 to inventory.definitionCount-1
			if keys.equippedCopies[i] > keys.ownedCopies[i] or inventory.definitions[i].unique and keys.equippedCopies[i] > 1
				destroy keys
				lastDiagnostic="RPG equipment exceeds owned item quantities"
				return false
		destroy keys
		if (not candidate.startsWith("v2|") and mainRecords != 1) or (candidate.startsWith("v2|") and mainRecords != 0) or heroRecords != heroes.count or questRecords != journal.count or treasureRecords != treasures.count or journalRecords != 1 or itemRecords > RPG_INVENTORY_CAPACITY or equipmentRecords > RPG_INVENTORY_CAPACITY or unlockRecords > 2048
			lastDiagnostic="RPG state is incomplete or exceeds runtime budgets"
			return false
		if candidate.startsWith("v7|") and (seedRecords != 1 or (resolved and seed == "") or (pending and seed != ""))
			lastDiagnostic = "Treasure resolution is incomplete or lacks campaign seed authority"
			return false
		lastDiagnostic=""
		return true
	function validateCampaignState(string candidate) returns boolean
		if not validateState(candidate)
			return false
		if candidate.startsWith("v7|")
			let record = new RpgSnapshotRecord()
			var start = 3
			while start < StringLength(candidate)
				start = record.read(candidate, start)
				if record.field(0) == "t" and record.field(4) == "pending"
					destroy record
					lastDiagnostic = "Campaign treasure resolution has not committed"
					return false
			destroy record
		return true
	function reconcile(string controllerId)
		technologies.rememberController(controllerId)
		technologies.reconstructAll()
		if navigation != null
			navigation.reconcile()
		if projections == null
			return
		projections.beginEquipmentReconciliation()
		projections.beginEquipmentSetReconciliation()
		for i=0 to inventory.equippedCount-1
			let equippedItem=inventory.getItem(inventory.equippedItems[i])
			let heroId=inventory.equippedHeroes[i]
			projections.replaceEquipment(new EquipmentItemLayer(heroId,inventory.equippedSlots[i],equippedItem))
			// Resolve each equipped wearer once, including inactive characters.
			// The projector retires unseen old layers after the complete pass.
			if inventory.firstWearerIndex(heroId) == i
				for j=0 to inventory.setCount-1
					let definition=inventory.sets[j]
					let count=inventory.setPieceCount(heroId,definition)
					if count > 0
						projections.replaceEquipmentSet(definition.resolve(heroId,count))
		projections.finishEquipmentReconciliation()
		projections.finishEquipmentSetReconciliation()
		projections.clearGuidanceLayer()
		// The installed navigation adapter owns the live guidance view. Retire
		// legacy descriptive quests so changing tracking cannot leave a second,
		// obsolete "Tracked" entry behind in the native quest panel.
		if navigation == null and journal.trackedId != ""
			let q=journal.get(journal.trackedId)
			if q != null and (q.state == QUEST_ACTIVE or q.state == QUEST_READY)
				q.updateGuidance()
				if q.precision != "hidden"
					projections.applyQuestGuidance(q.id,q.precision,q.regionId,q.destinationId)
		projections.clearTreasureKnowledgeLayer()
		for i=0 to treasures.count-1
			let t=treasures.treasures[i]
			var knownRegion = ""
			var destination = ""
			if t.knowledgePrecision() > 0
				knownRegion = t.regionId
				if t.knowledgePrecision() >= 4
					destination = t.resolution.candidateId
			projections.applyTreasureKnowledge(t.id,t.clueStage,t.discovered,knownRegion,destination)
	function reconstruct(player owner, real x, real y, string controllerId)
		heroes.loseRuntimeObjects()
		heroes.reconstructField(owner,x,y)
		reconcile(controllerId)
	function inventorySummary(string heroId) returns string
		let hero=heroes.get(heroId)
		if hero == null
			return "Choose a character with /inventory HERO."
		var rows="Inventory and Equipment - "+hero.name+" ("+hero.id+")\n"+hero.progressionSummary()
		rows += "\n" + hero.conditionSummary(heroes.campaignDay())
		for i=0 to inventory.ownedCount-1
			rows+="\n"+inventory.comparison(heroId,inventory.owned[i])
		for i=0 to inventory.setCount-1
			let definition=inventory.sets[i]
			let resolved=inventory.resolveSet(heroId,definition.id)
			rows+="\nSet "+definition.id+": "+resolved.pieceCount+" pieces"
			for j=0 to definition.thresholdCount-1
				let threshold=definition.thresholds[j]
				var status="unmet"
				if resolved.active(threshold.id)
					status="active"
				else if resolved.pieceCount >= threshold.pieceCount
					status="superseded"
				rows+="\n  "+threshold.id+" ("+threshold.pieceCount+" pieces): "+status+" | Effects:"
				for e=0 to threshold.effectCount-1
					rows+=" "+threshold.effectIds[e]
			destroy resolved
		return rows+"\nSet gameplay effects pending binding."

/** Player-facing fallback presentation. Frame screens can implement the same
 * controller calls; these commands ensure every system is usable in-game. */
function rosterText(WarcraftRpgRuntime runtime) returns string
	var rows="Heroes (strategic " + runtime.heroes.strategicRosterSize() + ", active " + runtime.heroes.activeCount() + "/" + runtime.heroes.activeLimit + ")"
	for i=0 to runtime.heroes.count-1
		let hero=runtime.heroes.heroes[i]
		if hero.recruited
			rows += "\n"+hero.name+" - level "+hero.level+", "+hero.assignment+", loyalty "+hero.loyalty+" | "+hero.conditionSummary(runtime.heroes.campaignDay())
	return rows

public function showRoster(player viewer, WarcraftRpgRuntime runtime)
	runtime.management.open("roster")
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,rosterText(runtime)+"\n"+RPG_MANAGEMENT_HELP)

function inventoryText(WarcraftRpgRuntime runtime, string heroId) returns string
	var selected=heroId
	if selected == ""
		for i=0 to runtime.heroes.count-1
			if selected == "" and runtime.heroes.heroes[i].recruited
				selected=runtime.heroes.heroes[i].id
	return runtime.inventorySummary(selected)

public function showInventory(player viewer, WarcraftRpgRuntime runtime, string heroId)
	runtime.management.open("inventory")
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,inventoryText(runtime,heroId)+"\n"+RPG_MANAGEMENT_HELP)

public function showInventory(player viewer, WarcraftRpgRuntime runtime)
	showInventory(viewer,runtime,"")

public function journalText(WarcraftRpgRuntime runtime) returns string
	var rows="Quest Journal"
	for i=0 to runtime.journal.count-1
		let questDefinition=runtime.journal.quests[i]
		if questDefinition.state != QUEST_OFFERED
			questDefinition.updateGuidance()
			rows += "\n"+questDefinition.title+" - "+questDefinition.state+" ["+questDefinition.precision+"]"
			if runtime.navigation != null and runtime.navigation.canShow(questDefinition.id)
				rows += "\nShow on Map: /showonmap " + questDefinition.id + " | Track: /track " + questDefinition.id
			let graph = questDefinition.graph
			if graph != null and graph.stage(graph.activeStageId) != null
				rows += "\n" + graph.stage(graph.activeStageId).title
				for j = 0 to graph.objectiveCount - 1
					let objective = graph.objectives[j]
					if graph.activeObjective(objective.id)
						rows += "\n" + objective.description
						if objective.binding == "domain_receipt" and (runtime.journal.conditions == null or not runtime.journal.conditions.supports(objective.conditionId))
							rows += " (Progress unavailable: condition integration pending.)"
				if questDefinition.state == QUEST_READY
					rows += "\nReturn to " + questDefinition.turnInId + " to turn in."
				else if graph.stageComplete(graph.activeStageId, graph.completedObjectiveIds)
					rows += "\nChoose the next stage with /queststage " + questDefinition.id + " STAGE: " + graph.stage(graph.activeStageId).nextStageIds
	return rows

public function showJournal(player viewer, WarcraftRpgRuntime runtime)
	runtime.management.open("journal")
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,journalText(runtime)+"\n"+RPG_MANAGEMENT_HELP)

function technologyText(WarcraftRpgRuntime runtime, string controllerId, int year) returns string
	var rows="Technology and Institutions"
	for i=0 to runtime.technologies.count-1
		let technology=runtime.technologies.definitions[i]
		rows += "\n"+technology.name+" - cost "+runtime.technologies.cost(technology.id,year,0,0)
		let earned = runtime.technologies.isUnlocked(controllerId,technology.id)
		if earned
			rows += " (unlocked)"
		for j = 0 to technology.unlockCount - 1
			let entry = technology.unlocks[j]
			rows += "\n  " + entry.nodeId + ": " + entry.kind + " " + entry.contentId
			if earned
				rows += " - earned"
			else
				rows += " - not earned"
			rows += " (" + runtime.technologies.bindingStatus(entry) + ")"
			var port = runtime.technologies.effects
			if port instanceof ScienceResearchEffects
				let science = port castTo ScienceResearchEffects
				for k = 0 to science.definitionCount - 1
					let binding = science.definitions[k]
					if entry.kind == binding.kind and entry.contentId == binding.contentId
						rows += "\n    +" + I2S(binding.basisPoints) + " bp " + binding.metric + "; requires supported funded work, commissioned equipment and actual inputs. Use /science inspect SITE for conditions, expenses and duration."
				port = science.upstream
			if port instanceof CivicResearchEffects
				let civic = port castTo CivicResearchEffects
				for k = 0 to civic.definitionCount - 1
					let binding = civic.definitions[k]
					if entry.kind == binding.kind and entry.contentId == binding.contentId
						rows += "\n    +" + I2S(binding.basisPoints) + " bp " + binding.metric + "; requires paid local activation. Use /civic inspect DISTRICT for conditions, currency, supplies, duration and upkeep."
				port = civic.upstream
			if port instanceof CombatResearchEffects
				let effects = port castTo CombatResearchEffects
				let binding = effects.bindings.researchBinding(entry.kind, entry.contentId)
				if binding != null
					rows += "\n    " + binding.inspection(effects.earned(controllerId, binding))
	return rows + "\nUnbound research unlocks have no gameplay effect yet."

public function showTechnology(player viewer, WarcraftRpgRuntime runtime, string controllerId, int year)
	runtime.management.open("technology")
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,technologyText(runtime,controllerId,year)+"\n"+RPG_MANAGEMENT_HELP)

class RpgScreenCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	string screen
	CommandOutput output
	construct(WarcraftRpgRuntime runtime,string screen,CommandOutput output)
		this.runtime=runtime
		this.screen=screen
		this.output=output
	override function execute(player sender,string arguments)
		if screen == "close"
			runtime.management.close()
			output.show(sender,"RPG management closed.")
			return
		runtime.management.open(screen)
		var rows = ""
		if screen == "roster"
			rows = rosterText(runtime)
		else if screen == "inventory"
			rows = inventoryText(runtime,arguments)
		else if screen == "journal"
			rows = journalText(runtime)
		else
			rows = technologyText(runtime,runtime.researchResources.controllerId(sender),runtime.researchResources.year())
		output.show(sender,rows+"\n"+RPG_MANAGEMENT_HELP)

class HeroAllocationCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	string kind
	CommandOutput output
	construct(WarcraftRpgRuntime runtime, string kind, CommandOutput output)
		this.runtime = runtime
		this.kind = kind
		this.output = output
	override function execute(player sender, string arguments)
		var heroId = arguments
		var id = ""
		let cut = arguments.indexOf(" ")
		if cut > 0
			heroId = SubString(arguments, 0, cut)
			id = SubString(arguments, cut + 1, StringLength(arguments))
		var problem = runtime.allocationOwnerProblem(sender, heroId)
		if problem == "" and kind != "inspect"
			problem = runtime.allocate(sender, heroId, kind, id)
		if problem != ""
			output.show(sender, problem)
			return
		if kind == "inspect"
			runtime.management.open("progression")
		output.show(sender, runtime.allocationSummary(heroId) + "\n" + RPG_MANAGEMENT_HELP)

class RecruitHeroCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	CommandOutput output
	construct(WarcraftRpgRuntime runtime, CommandOutput output)
		this.runtime=runtime
		this.output=output
	override function execute(player sender,string arguments)
		if runtime.heroes.recruit(arguments)
			let hero=runtime.heroes.get(arguments)
			output.show(sender,hero.name+" joined your strategic roster. Use assignments to choose who enters the active field group.")
		else
			output.show(sender,runtime.heroes.lastRecruitmentProblem)

class TrackQuestCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	CommandOutput output
	boolean track
	construct(WarcraftRpgRuntime runtime, CommandOutput output, boolean track)
		this.runtime=runtime
		this.output=output
		this.track=track
	override function execute(player sender,string arguments)
		if sender != Player(0)
			output.show(sender,"Only the campaign player can navigate quests.")
		else if runtime.navigation == null
			output.show(sender,"Quest map guidance is unavailable.")
		else
			output.show(sender,runtime.navigation.show(arguments,track))

class RpgActionCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	string action
	CommandOutput output
	construct(WarcraftRpgRuntime runtime,string action,CommandOutput output)
		this.runtime=runtime
		this.action=action
		this.output=output
	override function execute(player sender,string arguments)
		let cut=arguments.indexOf(" ")
		var first=arguments
		var second=""
		if cut > 0
			first=SubString(arguments,0,cut)
			second=SubString(arguments,cut+1,StringLength(arguments))
		var ok=false
		if action == "equip"
			let resources=runtime.researchResources
			ok=runtime.equipItem(first,second,resources.year(),resources.controllerId(sender))
		else if action == "unequip"
			ok=runtime.unequipItem(first,second)
		else if action == "research"
			let resources=runtime.researchResources
			let year=resources.year()
			let cost=runtime.technologies.cost(first,year,0,0)
			let available=resources.gold(sender)
			if cost>0 and available >= cost
				ok=runtime.research(resources.controllerId(sender),first,year,cost)
				if ok
					resources.setGold(sender,available-cost)
		else if action == "accept"
			ok=runtime.acceptQuest(first)
		else if action == "queststage"
			ok=runtime.advanceQuest(first,second)
		else if action == "turnin"
			ok=runtime.turnInQuest(sender,first,second,getCampaignDay(),30)
		else if action == "interact"
			ok=runtime.interact(sender,first,getCampaignDay())
		if ok
			output.show(sender,"Action completed.")
		else
			output.show(sender,"Requirements are not met here.")

public function registerRpgRuntimeCommands(CommandRegistry commands,WarcraftRpgRuntime runtime) returns string
	// Install the close action before any command that can acquire ownership.
	var problem=commands.register("rpg-close","","rpg-close","Close RPG management.","Closes roster, inventory/equipment, progression, journal or technology management. Other open screens and a pre-existing manual pause remain paused.",0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"close",commands.output))
	if problem != ""
		return problem
	problem=commands.register("roster","heroes,companions","roster","Open the hero roster; /rpg-close closes it.","Shows recruited heroes, active-field capacity, assignments, recovery, progression and loyalty. "+RPG_MANAGEMENT_HELP,0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"roster",commands.output))
	if problem != ""
		return problem
	problem=commands.register("inventory","equipment,items","inventory [HERO]","Open equipment; /rpg-close closes it.","Shows comparisons and set thresholds for the named wearer, or the first recruited character. "+RPG_MANAGEMENT_HELP,0,1,COMMAND_RELEASE,new RpgScreenCommand(runtime,"inventory",commands.output))
	if problem != ""
		return problem
	problem=commands.register("journal","quests","journal","Open the quest journal; /rpg-close closes it.","Shows tracked campaign, regional, personal, polity, event and local quests and their guidance. "+RPG_MANAGEMENT_HELP,0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"journal",commands.output))
	if problem != ""
		return problem
	problem=commands.register("technology","institutions","technology","Open technology; /rpg-close closes it.","Shows research costs, earned unlocks and gameplay binding status. "+RPG_MANAGEMENT_HELP,0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"technology",commands.output))
	if problem != ""
		return problem
	problem=commands.register("progression","","progression HERO","Inspect hero allocations; /rpg-close closes it.","Shows your recruited character's ranks, personal-tree perks, eligibility, selected ability entitlements and remaining points. Ability effects are pending. "+RPG_MANAGEMENT_HELP,1,1,COMMAND_RELEASE,new HeroAllocationCommand(runtime,"inspect",commands.output))
	if problem != ""
		return problem
	problem=commands.register("improveskill","","improveskill HERO SKILL","Spend one skill point for one rank.","Uses the character's own points. Rank cap: 100. Inspect IDs and balances with /progression HERO. Respecialization is unavailable.",2,2,COMMAND_RELEASE,new HeroAllocationCommand(runtime,"skill",commands.output))
	if problem != ""
		return problem
	problem=commands.register("improvemastery","","improvemastery HERO MASTERY","Spend one mastery point for one rank.","Uses the character's own points. Rank cap: 100. Inspect IDs and balances with /progression HERO. Respecialization is unavailable.",2,2,COMMAND_RELEASE,new HeroAllocationCommand(runtime,"mastery",commands.output))
	if problem != ""
		return problem
	problem=commands.register("chooseperk","","chooseperk HERO PERK","Spend one choice point for a personal-tree perk.","Requires the authored minimum level and every prerequisite perk. A perk can only be selected once. Records its ability entitlement; ability effects are pending. Respecialization is unavailable. Inspect with /progression HERO.",2,2,COMMAND_RELEASE,new HeroAllocationCommand(runtime,"perk",commands.output))
	if problem != ""
		return problem
	problem=commands.register("recruit","hire","recruit CHARACTER","Recruit an available named character.","The current campaign date must be within the character's recruitment window. Recruited companions remain yours after it closes.",1,1,COMMAND_RELEASE,new RecruitHeroCommand(runtime,commands.output))
	if problem != ""
		return problem
	problem=commands.register("track","","track QUEST","Track an active quest and open its map.","Uses the current objective or return destination and earned precision. Local markers require an exact destination on the party's loaded map. /map close closes the map.",1,1,COMMAND_RELEASE,new TrackQuestCommand(runtime,commands.output,true))
	if problem != ""
		return problem
	problem=commands.register("showonmap","","showonmap QUEST","Show an active quest on the map.","Focuses permitted exact or regional guidance without changing tracking or discovering locations. /map close closes the map. Hidden, unmet-clue and unsupported search-area guidance is unavailable.",1,1,COMMAND_RELEASE,new TrackQuestCommand(runtime,commands.output,false))
	if problem != ""
		return problem
	problem=commands.register("equip","","equip HERO ITEM","Equip an owned item.","Checks level, era, technology and institution requirements, then applies its Warcraft effect.",2,2,COMMAND_RELEASE,new RpgActionCommand(runtime,"equip",commands.output))
	if problem != ""
		return problem
	problem=commands.register("unequip","","unequip HERO SLOT","Remove a character's equipment assignment.","Frees the owned copy and recalculates that wearer's equipment and set effects.",2,2,COMMAND_RELEASE,new RpgActionCommand(runtime,"unequip",commands.output))
	if problem != ""
		return problem
	problem=commands.register("research","unlock,institution","research ID","Research a technology or establish an institution.","Pays the current research cost and earns every authored research unlock. Unbound unlocks await gameplay integration.",1,1,COMMAND_RELEASE,new RpgActionCommand(runtime,"research",commands.output))
	if problem != ""
		return problem
	problem=commands.register("accept","","accept QUEST","Accept an offered quest.","Accepts and tracks a currently available quest.",1,1,COMMAND_RELEASE,new RpgActionCommand(runtime,"accept",commands.output))
	if problem != ""
		return problem
	problem=commands.register("queststage","","queststage QUEST STAGE","Choose a quest branch.","Requires all current objectives and an authored successor stage. The journal lists available choices.",2,2,COMMAND_RELEASE,new RpgActionCommand(runtime,"queststage",commands.output))
	if problem != ""
		return problem
	problem=commands.register("turnin","","turnin QUEST HERO","Turn in a completed quest.","Requires the named field character at the authored turn-in location, then awards persistent rewards.",2,2,COMMAND_RELEASE,new RpgActionCommand(runtime,"turnin",commands.output))
	if problem != ""
		return problem
	problem=commands.register("interact","investigate,search","interact LOCATION","Interact with a nearby world location.","Requires a local field character; advances matching quests and clues and discovers eligible treasure at its actual location.",1,1,COMMAND_RELEASE,new RpgActionCommand(runtime,"interact",commands.output))
	if problem != ""
		return problem
	return ""
