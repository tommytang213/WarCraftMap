			t.experience = record.field(3)
			target.registerTradition(t)
			return true
		return false
	function dispose()
		for i = 0 to forceCount - 1
			destroy forces[i]
		for i = 0 to settlementCount - 1
			destroy settlements[i]
		for i = 0 to administratorCount - 1
			destroy administrators[i]
		for i = 0 to traditionCount - 1
			destroy traditions[i]
		for i = 0 to conflictCount - 1
			destroy conflicts[i]
		destroy this
	function parseSnapshot(string candidate) returns MilitarySettlementRuntime
		if (not candidate.startsWith("v17|") and not candidate.startsWith("v16|") and not candidate.startsWith("v15|") and not candidate.startsWith("v14|") and not candidate.startsWith("v13|") and not candidate.startsWith("v12|") and not candidate.startsWith("v11|") and not candidate.startsWith("v10|") and not candidate.startsWith("v9|") and not candidate.startsWith("v8|") and not candidate.startsWith("v7|") and not candidate.startsWith("v6|") and not candidate.startsWith("v5|") and not candidate.startsWith("v4|") and not candidate.startsWith("v3|") and not candidate.startsWith("v2|") and not candidate.startsWith("v1|")) or candidate.endsWith("|")
			return null
		let parsed = new MilitarySettlementRuntime(adapter)
		// Borrow the immutable provider while staging; it must not allocate a
		// fresh provider or touch projections for every validation/load attempt.
		destroy parsed.civic
		parsed.civic = civic.fork()
		destroy parsed.land
		parsed.land = land.fork()
		parsed.landYear = landYear
		destroy parsed.industry
		parsed.industry = industry.fork()
		destroy parsed.science
		parsed.science = science.fork()
		destroy parsed.finance
		parsed.finance = finance.fork()
		destroy parsed.naval
		parsed.naval = naval.fork()
		parsed.traditionDefinitions = traditionDefinitions
		parsed.combatBindings = combatBindings
		parsed.voyages = voyages
		parsed.legacyVoyages = not candidate.startsWith("v17|") and not candidate.startsWith("v16|") and not candidate.startsWith("v15|") and not candidate.startsWith("v14|") and not candidate.startsWith("v13|") and not candidate.startsWith("v12|") and not candidate.startsWith("v11|") and not candidate.startsWith("v10|")
		parsed.legacyCombatProfiles = parsed.legacyVoyages and not candidate.startsWith("v9|")
		parsed.legacyIntegerExperience = parsed.legacyCombatProfiles and not candidate.startsWith("v8|")
		parsed.legacyTraditions = parsed.legacyIntegerExperience and not candidate.startsWith("v7|")
		parsed.legacyOrders = parsed.legacyTraditions and not candidate.startsWith("v6|")
		parsed.legacyConflicts = candidate.startsWith("v1|")
		parsed.legacyDeadlines = candidate.startsWith("v1|") or candidate.startsWith("v2|")
		parsed.legacyRecovery = parsed.legacyDeadlines or candidate.startsWith("v3|")
		parsed.legacySettlements = parsed.legacyRecovery
		parsed.legacyMilitaryVersion4 = candidate.startsWith("v4|")
		var records = SubString(candidate, candidate.indexOf("|"), StringLength(candidate))
		if parsed.legacyConflicts
			records = initialConflicts + records
		let record = new MilitarySnapshotRecord()
		var start = 1
		while start < StringLength(records)
			start = record.read(records, start)
			if not restoreSnapshotRecord(record, parsed)
				destroy record
				parsed.dispose()
				return null
		destroy record
		if not parsed.legacyDeadlines and not parsed.hasSavedGameplayClock
			parsed.dispose()
			return null
		if definitions != null and not definitions.reconcile(parsed, parsed.legacySettlements)
			parsed.dispose()
			return null
		if traditionDefinitions != null and not traditionDefinitions.reconcile(parsed, parsed.legacyTraditions)
			parsed.dispose()
			return null
		for i = 0 to parsed.industry.count - 1
			let d = parsed.industry.sites[i]
			let s = parsed.industry.states[i]
			if (candidate.startsWith("v17|") or candidate.contains("|i,")) and not s.restored
				parsed.dispose()
				return null
			let city = parsed.settlementIndex(d.settlementId)
			if s.equipmentOwner != "" and (city < 0 or parsed.settlements[city].controllerId != s.equipmentOwner)
				parsed.dispose()
				return null
		for i = 0 to parsed.finance.count - 1
			if (candidate.startsWith("v17|") or candidate.startsWith("v16|") or candidate.contains("|q,")) and not parsed.finance.states[i].restored
				parsed.dispose()
				return null
			if (candidate.startsWith("v17|") or candidate.contains("|z,")) and not parsed.finance.states[i].freightRestored
				parsed.dispose()
				return null
			let state = parsed.finance.states[i]
			if state.freightUsed > 0 and (not state.completed or state.freightDay < state.lastDay)
				parsed.dispose()
				return null
			let city = parsed.settlementIndex(parsed.finance.projects[i].settlementId)
			if state.owner != "" and (city < 0 or not state.completed and parsed.settlements[city].controllerId != state.owner)
				parsed.dispose()
				return null
		// Independent v15 branches may lack finance or industry; v16 branches
		// may lack industry or freight counters. Absent domains migrate unfunded.
		// v17 requires every industry, finance and daily freight record.
		// Finance v14 may also lack naval records.
		for i = 0 to parsed.land.count - 1
			if (candidate.startsWith("v17|") or candidate.startsWith("v16|") or candidate.startsWith("v15|") or candidate.startsWith("v14|") or candidate.contains("|l,")) and not parsed.land.arsenals[i].restored
				parsed.dispose()
				return null
		for i = 0 to parsed.civic.count - 1
			if (candidate.startsWith("v17|") or candidate.startsWith("v16|") or candidate.startsWith("v15|") or candidate.startsWith("v14|") or candidate.startsWith("v13|") or candidate.startsWith("v12|") or candidate.startsWith("v11|") or candidate.contains("|g,")) and not parsed.civic.states[i].restored
				parsed.dispose()
				return null
		for i = 0 to parsed.science.count - 1
			if (candidate.startsWith("v17|") or candidate.startsWith("v16|") or candidate.startsWith("v15|") or candidate.startsWith("v14|") or candidate.startsWith("v13|") or candidate.startsWith("v12|") or candidate.contains("|j,")) and not parsed.science.states[i].restored
				parsed.dispose()
				return null
		for i = 0 to parsed.science.count - 1
			let site = parsed.science.sites[i]
			let state = parsed.science.states[i]
			if state.owner != "" and not site.scholarly()
				let actorIndex = parsed.forceIndex(site.forceId)
				if actorIndex < 0 or parsed.forces[actorIndex].navigation.pending() or parsed.forces[actorIndex].controllerId != state.owner or parsed.forces[actorIndex].unitTypeId != site.unitTypeId
					parsed.dispose()
					return null
		for i = 0 to parsed.forceCount - 1
			let f = parsed.forces[i]
			if (candidate.startsWith("v17|") or candidate.startsWith("v16|") or candidate.startsWith("v15|")) and f.kind == FORCE_FLEET and not f.hull.restored
				parsed.dispose()
				return null
			let p = parsed.naval.profile(f.combatProfileId, f.unitTypeId)
			if (f.hull.carronades and (p == null or not p.carronadeMount)) or (f.hull.carvel and (p == null or not p.carvelRefit))
				parsed.dispose()
				return null
		for i = 0 to parsed.naval.count - 1
			let s = parsed.naval.states[i]
			if (candidate.startsWith("v17|") or candidate.startsWith("v16|") or candidate.startsWith("v15|") or candidate.contains("|y,")) and not s.restored
				parsed.dispose()
				return null
			if s.target != ""
				let f = parsed.forces[parsed.forceIndex(s.target)]
				if f.controllerId != s.owner or f.kind != FORCE_FLEET or f.navigation.pending() or parsed.science.busy(f.id)
					parsed.dispose()
					return null
		for i = 0 to parsed.conflictCount - 1
			var attackers = 0
			var defenders = 0
			for j = 0 to parsed.conflicts[i].count - 1
				if parsed.conflicts[i].sides[j] == 1
					attackers++
				else
					defenders++
			if attackers == 0 or defenders == 0
				parsed.dispose()
				return null
		for i = 0 to parsed.settlementCount - 1
			let state = parsed.settlements[i]
			if parsed.legacyDeadlines
				// v1/v2 had no live timer. Anchor legacy absolute deadlines at the
				// latest recorded combat/wave/capture event, never at map uptime.
				parsed.gameplaySeconds = RMaxBJ(parsed.gameplaySeconds, RMaxBJ(state.lastCombatAt, RMaxBJ(state.nextWaveAt - state.reinforcementInterval, state.captureImmuneUntil - CITY_CAPTURE_IMMUNITY_SECONDS)))
			if state.capturable and parsed.forceIndex("core:" + state.id) < 0
				parsed.dispose()
				return null
			if state.occupationConflictId != "" and parsed.conflictIndex(state.occupationConflictId) < 0
				parsed.dispose()
				return null
		return parsed
	/** Parse completely into detached authority before replacing projections. */
	function validateSnapshot(string candidate) returns boolean
		return validateSnapshot(candidate, -1)
	function validateSnapshot(string candidate, int campaignDay) returns boolean
		let parsed = parseSnapshot(candidate)
		if parsed == null
			return false
		for i = 0 to parsed.industry.count - 1
			if campaignDay >= 0 and parsed.industry.states[i].lastDay > campaignDay
				parsed.dispose()
				return false
		for i = 0 to parsed.finance.count - 1
			if campaignDay >= 0 and (parsed.finance.states[i].lastDay > campaignDay or parsed.finance.states[i].freightDay > campaignDay)
				parsed.dispose()
				return false
		for i = 0 to parsed.land.count - 1
			if campaignDay >= 0 and parsed.land.arsenals[i].lastDay > campaignDay
				parsed.dispose()
				return false
		for i = 0 to parsed.forceCount - 1
			if campaignDay >= 0 and parsed.forces[i].navigation.pending() and parsed.forces[i].navigation.lastDay > campaignDay
				parsed.dispose()
				return false
		for i = 0 to parsed.science.count - 1
			if campaignDay >= 0 and parsed.science.states[i].lastDay > campaignDay
				parsed.dispose()
				return false
		for i = 0 to parsed.forceCount - 1
			if campaignDay >= 0 and parsed.forces[i].hull.lastDay > campaignDay
				parsed.dispose()
				return false
		for i = 0 to parsed.naval.count - 1
			if campaignDay >= 0 and parsed.naval.states[i].lastDay > campaignDay
				parsed.dispose()
				return false
		parsed.dispose()
		return true
	function restore(string candidate) returns boolean
		return restore(candidate, true)
	/** Rollback restores authority separately from the retained native objects. */
	function restore(string candidate, boolean project) returns boolean
		let parsed = parseSnapshot(candidate)
		if parsed == null
			return false
		// Combat observations cannot survive replacement of their target records.
		if prizeCombat != null
			prizeCombat.retire()
		suspendCallbacks()
		// A freshly loaded physical map activates itself before campaign restore.
		// Preserve that projection target while restoring the snapshot's global
		// authority; a detached/test runtime still follows the saved region.
		var restoredRegion = parsed.activeRegionId
		if project and activeRegionId != ""
			restoredRegion = activeRegionId
		if project and activeRegionId != ""
			for i = 0 to forceCount - 1
				if militaryMapMatches(forces[i].regionId, activeRegionId)
					adapter.removeRepresentation(forces[i].id)
		for i = 0 to forceCount - 1
			destroy forces[i]
		for i = 0 to settlementCount - 1
			destroy settlements[i]
		for i = 0 to administratorCount - 1
			destroy administrators[i]
		for i = 0 to traditionCount - 1
			destroy traditions[i]
		for i = 0 to conflictCount - 1
			destroy conflicts[i]
		destroy finance
		destroy naval
		naval = parsed.naval
		parsed.naval = new NavalLedger()
		destroy industry
		industry = parsed.industry
		parsed.industry = new IndustryLedger()
		destroy science
		destroy civic
		finance = parsed.finance
		parsed.finance = new FinanceLedger()
		science = parsed.science
		parsed.science = new ScienceLedger()
		civic = parsed.civic
		parsed.civic = new CivicLedger()
		destroy land
		land = parsed.land
		parsed.land = new LandArmyLedger()
		forceCount = parsed.forceCount
		for i = 0 to forceCount - 1
			forces[i] = parsed.forces[i]
		settlementCount = parsed.settlementCount
		for i = 0 to settlementCount - 1
			settlements[i] = parsed.settlements[i]
		administratorCount = parsed.administratorCount
		for i = 0 to administratorCount - 1
			administrators[i] = parsed.administrators[i]
			administratorSettlementIds[i] = parsed.administratorSettlementIds[i]
		conflictCount = parsed.conflictCount
		for i = 0 to conflictCount - 1
			conflicts[i] = parsed.conflicts[i]
		legacyConflicts = parsed.legacyConflicts
		traditionCount = parsed.traditionCount
		for i = 0 to traditionCount - 1
			traditions[i] = parsed.traditions[i]
		activeRegionId = restoredRegion
		gameplaySeconds = parsed.gameplaySeconds
		if project
			activeRegionId = ""
			reconcileSieges()
			activateRegion(restoredRegion)
		destroy parsed
		resumeCallbacks()
		return true
	function managementSummary(string subjectId) returns string
		let f = forceIndex(subjectId)
		if f >= 0
			let runtimeForce = forces[f]
			var result = "Controller: " + runtimeForce.controllerId + " | Strength: " + runtimeForce.strength.toString() + "/" + runtimeForce.maximumStrength.toString() + " | Supply: " + runtimeForce.supply.toString() + " | Region: " + runtimeForce.regionId
			let track = traditionIndex(runtimeForce.controllerId, runtimeForce.categoryId)
			if track >= 0
				result += " | Tradition XP: " + traditions[track].experience
				let layer = resolveTradition(runtimeForce)
				if layer != null
					result += layer.inspection()
					if combatBindings != null
						result += combatBindings.inspection(layer, combatProfile(runtimeForce), runtimeForce.active and runtimeForce.strength > 0)
					destroy layer
			if runtimeForce.kind == FORCE_FLEET
				result += "\nHull integrity " + I2S(runtimeForce.hull.integrity) + "/10000; paid carronade mounts " + boolText(runtimeForce.hull.carronades) + "; paid carvel refit " + boolText(runtimeForce.hull.carvel) + "; maintenance funded " + boolText(runtimeForce.hull.maintained) + ". /naval inspect PORT lists real service bills."
			if voyageSupported(runtimeForce, "")
				result += "\nNavigation: astronomical observation capable; kit installed: " + boolText(runtimeForce.navigation.equipment) + "; voyage: " + runtimeForce.navigation.routeId + "; elapsed days: " + runtimeForce.navigation.elapsedDays.toString() + "; reserved provisions: " + runtimeForce.navigation.reserved.toString() + "; fractional provision credit: " + runtimeForce.navigation.creditBasisPoints.toString() + "/10000. Research source: " + voyages.contentId + "; position-finding provision reduction: " + voyages.reductionBasisPoints.toString() + " basis points; research eligible: " + boolText(voyageEligible(runtimeForce))
			if combatBindings != null
				result += combatBindings.researchInspection(runtimeForce.controllerId, runtimeForce.categoryId, runtimeForce.active and runtimeForce.strength > 0, combatProfile(runtimeForce), true)
			return result
		let s = settlementIndex(subjectId)
		if s >= 0
			let state = settlements[s]
			var result = "Controller: " + state.controllerId + " | Garrison: " + state.garrisonStrength.toString() + "/" + state.garrisonMaximum.toString() + " | Reserves: " + state.reserves.toString() + " | Manpower: " + state.manpower.toString() + " | Supply: " + state.supply.toString()
			let a = administratorIndex(subjectId)
			if a >= 0
				let office = administrators[a]
				result += "\n" + office.title + ": " + office.name + " | Loyalty: " + office.loyalty.toString() + " | Administration: " + office.administration.toString() + " | Command: " + office.command.toString() + " | Capacity: " + office.capacity.toString() + " | Jurisdiction: " + office.jurisdiction + " | Residence: " + office.physicalRegionId
				if office.physicalRegionId != state.regionId
					result += " (absent; represented by a local deputy)"
				let warning = replacementWarning(subjectId)
				if warning != ""
					result += "\n" + warning
			return result
		return "No authoritative army, fleet, or settlement has that identifier."

public MilitarySettlementRuntime militarySettlementRuntime = new MilitarySettlementRuntime(new WarcraftMilitarySettlementAdapter())
ModalManagementScreen activeMilitaryManagementScreen = null

public class MilitaryManagementCommand implements CommandHandler
	MilitarySettlementRuntime runtime
	construct(MilitarySettlementRuntime runtime)
		this.runtime = runtime
	override function execute(player sender, string arguments)
		if activeMilitaryManagementScreen == null or not activeMilitaryManagementScreen.isOpen()
			activeMilitaryManagementScreen = openModalManagementScreen()
		runtime.adapter.showManagement(sender, "Campaign management: " + arguments, runtime.managementSummary(arguments))

public class CloseMilitaryManagementCommand implements CommandHandler
	override function execute(player sender, string arguments)
		if activeMilitaryManagementScreen != null
			activeMilitaryManagementScreen.close()
			activeMilitaryManagementScreen = null

public function registerMilitarySettlementCommands(CommandRegistry commands, MilitarySettlementRuntime runtime)
	commands.register("army", "fleet,settlement,administration", "army ID", "Open army, fleet, settlement, or administration management.", "Shows authoritative strength, supply, garrison, control, office effects, loyalty, jurisdiction, capacity, residence, and replacement warnings.", 1, 1, COMMAND_RELEASE, new MilitaryManagementCommand(runtime))
	commands.register("management-close", "", "management-close", "Close management and resume the campaign.", "Closes the current modal military/settlement screen.", 0, 0, COMMAND_RELEASE, new CloseMilitaryManagementCommand())

public function initializeMilitarySettlementRuntime(CommandRegistry commands)
	registerMilitarySettlementCommands(commands, militarySettlementRuntime)
