	int command
	int capacity
	boolean oathbound
	construct(string characterId, string name, string title, string controllerId, string physicalRegionId, string jurisdiction, int loyalty, int administration, int command, int capacity)
		this.characterId = characterId
		this.name = name
		this.title = title
		this.controllerId = controllerId
