/** Transient event/timer ownership; never serialized with campaign authority. */
public interface MilitaryRuntimeCallbacks
	function synchronize()
	function suspend()
	function resume()

/** Orders own a separate transient subscription from combat and its timer. */
public interface MilitaryOrderCallbacks
	function capture()
	function suspend()
	function resume()
	function reconstruct()
	function reconstructedForce(string id)

public interface MilitarySettlementAdapter
	/** Load checkpoints retain existing representations, including an empty
	 * startup projection. Commit/rollback are non-failing ownership transfers. */
	function beginLoad()
	function rollbackLoad()
	function commitLoad()
	function playerForController(string controllerId, boolean localDefense) returns player
	function createRepresentation(RuntimeForce runtimeForce, player owner) returns unit
	function forceIdForRepresentation(int representation) returns string
	function representationId(string stableId) returns int
	function removeRepresentation(string stableId)
	function changeRepresentationOwner(string stableId, player owner)
	function applyTradition(string stableId, int lifePermille, int milestoneAbilityId)
	/** Takes ownership of the derived layer; null removes ONLY this layer. */
	function replaceTraditionLayer(string stableId, TraditionLayer layer)
	function replaceReload(string stableId, int baseMillis, int basisPoints)
	function protectRepresentation(string stableId, boolean shouldProtect)
	function showManagement(player viewer, string heading, string body)

public class WarcraftMilitarySettlementAdapter implements MilitarySettlementAdapter
	WarcraftRecoveryAdapter recovery = null
	TraditionLayerStore traditionLayers = new TraditionLayerStore()
	private TraditionLayerStore previousTraditionLayers = null
	// Native stat boundary; headless journeys still execute this adapter's
	// creation, retirement, ownership and reconstruction operations.
	function maximumLife(unit target) returns int
		return compatGetUnitMaxLife(target)
	function setMaximumLife(unit target, int value)
		compatSetUnitMaxLife(target, value)
	string array[4096] ids
	unit array[4096] handles
	real array[4096] baseReloadSeconds
	boolean array[4096] appliedReload
	real array[4096] previousReloadSeconds
	boolean array[4096] previousAppliedReload
	int array[4096] baseMaximumLife
	int array[4096] appliedMilestoneAbility
	int count = 0
	string array[4096] previousIds
	unit array[4096] previousHandles
	int array[4096] previousBaseLife
	int array[4096] previousAbility
	int previousCount = 0
	override function beginLoad()
		previousTraditionLayers = traditionLayers
		traditionLayers = new TraditionLayerStore()
		previousCount = count
		for i = 0 to count - 1
			if recovery != null
				recovery.unbind("force:" + ids[i])
			previousIds[i] = ids[i]
			previousHandles[i] = handles[i]
			previousBaseLife[i] = baseMaximumLife[i]
			previousReloadSeconds[i] = baseReloadSeconds[i]
			previousAppliedReload[i] = appliedReload[i]
			previousAbility[i] = appliedMilestoneAbility[i]
		count = 0
	override function rollbackLoad()
		for i = 0 to count - 1
			removeRepresentation(ids[i])
		count = previousCount
		for i = 0 to count - 1
			ids[i] = previousIds[i]
			handles[i] = previousHandles[i]
			baseMaximumLife[i] = previousBaseLife[i]
			baseReloadSeconds[i] = previousReloadSeconds[i]
			appliedReload[i] = previousAppliedReload[i]
			appliedMilestoneAbility[i] = previousAbility[i]
			previousHandles[i] = null
		previousCount = 0
		destroy traditionLayers
		traditionLayers = previousTraditionLayers
		previousTraditionLayers = null
	override function commitLoad()
		for i = 0 to previousCount - 1
			if previousHandles[i] != null
				compatRemoveUnit(previousHandles[i])
			previousHandles[i] = null
		previousCount = 0
		if previousTraditionLayers != null
			destroy previousTraditionLayers
		previousTraditionLayers = null
	function indexOf(string id) returns int
		for i = 0 to count - 1
			if ids[i] == id
				return i
		return -1
	override function playerForController(string controllerId, boolean localDefense) returns player
		// Slot 0 is the local campaign controller; local defenses use dedicated AI
		// slots and therefore can never be selected, loaded or marched by the player.
		if controllerId == "player" and not localDefense
			return Player(0)
		return Player(11)
	override function createRepresentation(RuntimeForce runtimeForce, player owner) returns unit
		// Reconstruction is idempotent even if Warcraft destroyed a unit without
		// notifying the authority, or a load is repeated on the same physical map.
		removeRepresentation(runtimeForce.id)
		let made = compatCreateUnit(owner, runtimeForce.unitTypeId, runtimeForce.x, runtimeForce.y, 0.)
		var found = indexOf(runtimeForce.id)
		if found < 0
			found = count
			ids[count] = runtimeForce.id
			count++
		handles[found] = made
		baseMaximumLife[found] = maximumLife(made)
		baseReloadSeconds[found] = 0.
		appliedReload[found] = false
		appliedMilestoneAbility[found] = 0
		if recovery != null and runtimeForce.active and (runtimeForce.kind == FORCE_ARMY or runtimeForce.kind == FORCE_FLEET)
			recovery.bind("force:" + runtimeForce.id, made, runtimeForce.regionId)
		return made
	override function forceIdForRepresentation(int representation) returns string
		if representation != 0
			for i = 0 to count - 1
				if handles[i] != null and GetHandleId(handles[i]) == representation and GetUnitTypeId(handles[i]) != 0
					return ids[i]
		return ""
	override function representationId(string stableId) returns int
		let found = indexOf(stableId)
		if found >= 0 and handles[found] != null and GetUnitTypeId(handles[found]) != 0
			return GetHandleId(handles[found])
		return 0
	override function removeRepresentation(string stableId)
		traditionLayers.replace(stableId, null)
		if recovery != null
			recovery.unbind("force:" + stableId)
		let found = indexOf(stableId)
		if found >= 0 and handles[found] != null
			// Detach before native cleanup can deliver a reentrant death callback.
			let obsolete = handles[found]
			handles[found] = null
			compatRemoveUnit(obsolete)
	override function changeRepresentationOwner(string stableId, player owner)
		let found = indexOf(stableId)
		if found >= 0 and handles[found] != null
			compatSetUnitOwner(handles[found], owner, true)
			if recovery != null and owner != Player(0)
				recovery.unbind("force:" + stableId)
			else if recovery != null and recovery.service.lifecycle != null
				recovery.service.lifecycle.refresh()
	override function replaceTraditionLayer(string stableId, TraditionLayer layer)
		// Exact values remain available to typed consumers without coercion to
		// native stats. Name-only effects have no invented ability mapping.
		if representationId(stableId) == 0 and layer != null
			destroy layer
			traditionLayers.replace(stableId, null)
		else
			traditionLayers.replace(stableId, layer)
	override function replaceReload(string stableId, int baseMillis, int basisPoints)
		let found = indexOf(stableId)
		if found >= 0 and handles[found] != null
			if baseMillis > 0
				// Capture the native baseline only when this equipment uses reload.
				if not appliedReload[found]
					baseReloadSeconds[found] = compatGetAttackCooldown(handles[found])
				compatSetAttackCooldown(handles[found], I2R(landReloadMillis(baseMillis, basisPoints)) / 1000.)
				appliedReload[found] = true
			else if appliedReload[found]
				compatSetAttackCooldown(handles[found], baseReloadSeconds[found])
				appliedReload[found] = false
	override function applyTradition(string stableId, int lifePermille, int milestoneAbilityId)
		let found = indexOf(stableId)
		if found >= 0 and handles[found] != null
			// This adapter accepts bounded native stats, never authoritative XP.
			let base = I2S(IMaxBJ(0, baseMaximumLife[found]))
			let bonus = exactNaturalScaleFloor(base, lifePermille, 1000)
			setMaximumLife(handles[found], exactNaturalNativeInt(exactNaturalAdd(base, bonus)))
			if appliedMilestoneAbility[found] != 0 and appliedMilestoneAbility[found] != milestoneAbilityId
				compatRemoveUnitAbility(handles[found], appliedMilestoneAbility[found])
			if milestoneAbilityId != 0
				compatAddUnitAbility(handles[found], milestoneAbilityId)
			appliedMilestoneAbility[found] = milestoneAbilityId
	override function protectRepresentation(string stableId, boolean shouldProtect)
		let found = indexOf(stableId)
		if found >= 0 and handles[found] != null
			compatSetUnitProtection(handles[found], PROTECTION_CAPTURE, shouldProtect)
	override function showManagement(player viewer, string heading, string body)
		DisplayTimedTextToPlayer(viewer, 0., 0., 60., heading + "\n" + body + "\nUse /management-close to resume the campaign.")

public class MilitarySettlementRuntime implements LandReloadListener
	LandArmyLedger land = new LandArmyLedger()
	int landYear = 1450
	CivicLedger civic = new CivicLedger()
	FinanceLedger finance = new FinanceLedger()
	NavalLedger naval = new NavalLedger()
	NavalResearchEffects navalResearch = null
	IndustryLedger industry = new IndustryLedger()
	ScienceLedger science = new ScienceLedger()
	PrizeCombatAuthority prizeCombat = new PrizeEncounters()
	MilitarySettlementAdapter adapter
	MilitaryRuntimeCallbacks callbacks = null
	MilitaryOrderCallbacks orderCallbacks = null
	real gameplaySeconds = 0.
	boolean hasSavedGameplayClock = false
	boolean legacyDeadlines = false
	boolean legacyRecovery = false
	boolean legacyMilitaryVersion4 = false
	boolean legacyOrders = false
	boolean legacyTraditions = false
	boolean legacyCombatProfiles = false
	boolean legacyIntegerExperience = false
	WarcraftRpgRuntime rpg = null
	RuntimeForce array[4096] forces
	TraditionState array[256] traditions
	TraditionContribution array[32] contributions
	int contributionCount = 0
	MilitaryTraditionDefinitions traditionDefinitions = null
	CombatBindings combatBindings = null
	VoyageContract voyages = null
	boolean legacyVoyages = false
	boolean navigationEffectsInstalled = false
	SettlementRuntimeState array[1024] settlements
	AdministratorState array[1024] administrators
	string array[1024] administratorSettlementIds
	MilitaryConflict array[256] conflicts
	int conflictCount = 0
	string initialConflicts = ""
	SettlementDefinitions definitions = null
	boolean legacySettlements = false
	boolean legacyConflicts = false
	int forceCount = 0
	int traditionCount = 0
	int settlementCount = 0
	int administratorCount = 0
	string activeRegionId = ""
	private MilitaryRegistrationIndex registrationForces = null
	private MilitaryRegistrationIndex registrationSettlements = null
	private MilitaryRegistrationIndex registrationAdministrators = null
	construct(MilitarySettlementAdapter adapter)
		this.adapter = adapter
	ondestroy
		destroy naval
		destroy land
		destroy industry
		destroy finance
		destroy science
		destroy civic
		endRegistration()
		for i = 0 to contributionCount - 1
			destroy contributions[i]
		if prizeCombat != null
			prizeCombat.retire()
			destroy prizeCombat
	function landKit(RuntimeForce runtimeForce) returns LandProfile
		if runtimeForce.combatProfileId == ""
			return null
		let kit = land.profile(runtimeForce.combatProfileId)
		if kit == null or runtimeForce.kind != FORCE_ARMY or kit.unitTypeId != runtimeForce.unitTypeId or kit.categoryId != runtimeForce.categoryId or landYear < kit.firstYear or landYear > kit.lastYear
			return null
		if rpg == null
			return null
		for i = 0 to rpg.technologies.count - 1
			let node = rpg.technologies.definitions[i].id
			if kit.requiredResearch.contains("," + node + ",") and not rpg.technologies.isUnlocked(runtimeForce.controllerId, node)
				return null
		return kit
	function reloadRate(RuntimeForce runtimeForce) returns int
		let kit = landKit(runtimeForce)
		if not runtimeForce.active or runtimeForce.strength <= 0 or kit == null or not kit.firearm
			return 0
		return land.rate(runtimeForce.controllerId, "firearm_reload_efficiency")
	function firearmReloadMillis(RuntimeForce runtimeForce, int baseMillis) returns int
		return landReloadMillis(baseMillis, reloadRate(runtimeForce))
	override function refreshLandReload()
		for i = 0 to forceCount - 1
			reconcileLandReload(forces[i])
	override function refreshLandController(string controllerId)
		for i = 0 to forceCount - 1
			if forces[i].controllerId == controllerId
				reconcileLandReload(forces[i])
	function reconcileLandReload(RuntimeForce runtimeForce)
		let kit = landKit(runtimeForce)
		var baseline = 0
		if kit != null and kit.firearm
			baseline = kit.baseReloadMillis
		adapter.replaceReload(runtimeForce.id, baseline, reloadRate(runtimeForce))
	/** Native and abstract firing share this durable clock. The caller must
	 * establish hostility, actual weapon identity and a living recipient first. */
	function acceptLandShot(CombatHit hit, RuntimeForce runtimeForce) returns boolean
		let kit = landKit(runtimeForce)
		if kit == null or not kit.firearm or (hit.attackId != "firearm_volley" and hit.attackId != "land_firearm")
			return true
		if gameplaySeconds < runtimeForce.nextFireAt
			destroy hit.damage
			hit.damage = new ExactRational("0", "1", "1")
			hit.applied = true
			hit.modified = true
			return false
		runtimeForce.nextFireAt = gameplaySeconds + I2R(firearmReloadMillis(runtimeForce, kit.baseReloadMillis)) / 1000.
		return true
	function landCavalryAttack(RuntimeForce runtimeForce, string nativeAttack) returns boolean
		let kit = landKit(runtimeForce)
		return kit != null and kit.cavalry and nativeAttack != "" and nativeAttack == kit.primaryNativeAttack
	function landFirearmAttack(RuntimeForce runtimeForce, string nativeAttack) returns boolean
		let kit = landKit(runtimeForce)
		return kit != null and kit.firearm and nativeAttack != "" and nativeAttack == kit.primaryNativeAttack
	function setRpgRuntime(WarcraftRpgRuntime runtime)
		rpg=runtime
		if rpg != null and voyages != null and not navigationEffectsInstalled
			rpg.technologies.effects = new NavigationResearchEffects(rpg.technologies.effects, voyages.kind, voyages.contentId)
			navigationEffectsInstalled = true
		if rpg != null and combatBindings != null
			if rpg.technologies.effects instanceof CombatResearchEffects
				combatBindings.research = rpg.technologies.effects castTo CombatResearchEffects
				combatBindings.research.bindings = combatBindings
			else
				combatBindings.research = new CombatResearchEffects(combatBindings, rpg.technologies.effects)
				rpg.technologies.effects = combatBindings.research
			rpg.technologies.reconstructAll()
	/** Campaign authority also runs without installing a native-map singleton.
	 * Prefer its transactionally restored clock over another map's global clock. */
	function authorityClock() returns CampaignClock
		if rpg != null and rpg.heroes.clock != null
			return rpg.heroes.clock
		return getCampaignClock()
	function authorityDay() returns int
		let clock = authorityClock()
		if clock != null
			return clock.campaignDay()
		return 0
	/** Only register/appoint while this catalogue batch is open. Discard the
	 * indexes before gameplay, where reconstruction can replace the arrays. */
	function beginRegistration()
		endRegistration()
		registrationForces = new MilitaryRegistrationIndex()
		registrationSettlements = new MilitaryRegistrationIndex()
		registrationAdministrators = new MilitaryRegistrationIndex()
		for i = 0 to forceCount - 1
			registrationForces.add(forces[i].id, i)
		for i = 0 to settlementCount - 1
			registrationSettlements.add(settlements[i].id, i)
		for i = 0 to administratorCount - 1
			registrationAdministrators.add(administratorSettlementIds[i], i)
	function endRegistration()
		if registrationForces != null
			destroy registrationForces
			destroy registrationSettlements
			destroy registrationAdministrators
			registrationForces = null
			registrationSettlements = null
			registrationAdministrators = null
	function forceIndex(string id) returns int
		if registrationForces != null
			return registrationForces.find(id)
		for i = 0 to forceCount - 1
			if forces[i].id == id
				return i
		return -1
	function hasPrefix(string value, string prefix) returns boolean
		return StringLength(value) >= StringLength(prefix) and SubString(value, 0, StringLength(prefix)) == prefix
	function settlementIndex(string id) returns int
		if registrationSettlements != null
			return registrationSettlements.find(id)
		for i = 0 to settlementCount - 1
			if settlements[i].id == id
				return i
		return -1
	function traditionIndex(string controllerId, string categoryId) returns int
		for i = 0 to traditionCount - 1
			if traditions[i].controllerId == controllerId and traditions[i].categoryId == categoryId
				return i
		return -1
	function administratorIndex(string settlementId) returns int
		if registrationAdministrators != null
			return registrationAdministrators.find(settlementId)
		for i = 0 to administratorCount - 1
			if administratorSettlementIds[i] == settlementId
				return i
		return -1
	function registerForce(RuntimeForce runtimeForce)
		if runtimeForce != null and runtimeForce.id != "" and forceIndex(runtimeForce.id) < 0
			if registrationForces != null
				registrationForces.add(runtimeForce.id, forceCount)
			forces[forceCount] = runtimeForce
			forceCount++
	function registerTradition(TraditionState state)
		if state != null and state.controllerId != "" and state.categoryId != "" and traditionIndex(state.controllerId, state.categoryId) < 0
			traditions[traditionCount] = state
			traditionCount++
	function contributionIndex(string id) returns int
		for i = 0 to contributionCount - 1
			if contributions[i].id == id
				return i
		return -1
	function registerContribution(string id, int numerator, int denominator)
		if contributionIndex(id) < 0 and contributionCount < 32 and numerator > 0 and denominator > 0
			contributions[contributionCount] = new TraditionContribution(id, numerator, denominator)
			contributionCount++
	/** Definitions may repair presentation and seed absent legacy tracks. Earned
	 * XP is never copied from a unit, a polity allegiance, or a starting value. */
	function reconcileTradition(string controllerId, string categoryId, int startingExperience, int rate, int milestoneXp, int abilityId, boolean migrate) returns boolean
		var found = traditionIndex(controllerId, categoryId)
		if found < 0
			if not migrate or traditionCount >= 256
				return false
			let state = new TraditionState(controllerId, categoryId, rate, milestoneXp, abilityId)
			state.experience = I2S(startingExperience)
			registerTradition(state)
			found = traditionIndex(controllerId, categoryId)
		traditions[found].lifePermillePerHundredXp = rate
		traditions[found].milestoneXp = milestoneXp
		traditions[found].milestoneAbilityId = abilityId
		return true
	/** Current definitions replace derived data, never earned XP. The legacy
	 * snapshot presentation fields stay zero for typed traditions in v8. */
	function reconcileTradition(string controllerId, string categoryId, string startingExperience, TraditionDefinition definition, boolean migrate) returns boolean
		var found = traditionIndex(controllerId, categoryId)
		if found < 0
			if not migrate or traditionCount >= 256
				destroy definition
				return false
			let state = new TraditionState(controllerId, categoryId, 0, 0, 0)
			state.experience = startingExperience
			registerTradition(state)
			found = traditionIndex(controllerId, categoryId)
		let track = traditions[found]
		if track.definition != null
			destroy track.definition
		track.definition = definition
		track.lifePermillePerHundredXp = 0
		track.milestoneXp = 0
		track.milestoneAbilityId = 0
		return true
	function registerSettlement(SettlementRuntimeState state)
		if state != null and state.id != "" and settlementIndex(state.id) < 0
			if registrationSettlements != null
				registrationSettlements.add(state.id, settlementCount)
			settlements[settlementCount] = state
			settlementCount++
			if state.capturable
				registerForce(new RuntimeForce("core:" + state.id, state.controllerId, state.regionId, "siege", FORCE_CITY_CORE, state.coreTypeId, 100, state.supply, state.x, state.y))
	// Share one application body across the full catalogue and legacy migration.
	@noinline
	function configureSettlementPolicy(string id, boolean projectMilitary, boolean capturable, string governanceExceptionId)
		let found = settlementIndex(id)
		if found >= 0
			settlements[found].withPolicy(projectMilitary, capturable, governanceExceptionId)
	function voyageSupported(RuntimeForce vessel, string routeId) returns boolean
		if voyages == null or vessel.kind != FORCE_FLEET
			return false
		if voyages.supports(vessel.id, vessel.unitTypeId, routeId)
			return true
		// Newly paid hulls can use the same authored station-return circuit.
		// The immutable route still supplies geography, time and provisions.
		let profile = naval.profile(vessel.combatProfileId, vessel.unitTypeId)
		if profile == null
			return false
		for i = 0 to naval.count - 1
			let yard = naval.yards[i]
			if vessel.combatProfileId == yard.profileId and vessel.unitTypeId == yard.unitTypeId
				var route = voyages.routes
				while route != null
					if route.mapId == yard.mapId and (routeId == "" or route.id == routeId)
						return true
					route = route.next
		return false
	function voyageEligible(RuntimeForce vessel) returns boolean
		if rpg == null or not voyageSupported(vessel, vessel.navigation.routeId) or not vessel.active or vessel.strength <= 0
			return false
		let earned = rpg.technologies.entitlements(vessel.controllerId)
		let eligible = earned.has(voyages.kind, voyages.contentId)
		destroy earned
		return eligible
	/** Runs identically for represented and unloaded forces. Never advances time.
	 * Equipment/control changes must settle elapsed days before their mutation. */
	function resolveVoyages(int day)
		if voyages == null
			return
		for i = 0 to forceCount - 1
			let vessel = forces[i]
			let progress = vessel.navigation
			if progress.pending()
				let route = voyages.route(progress.routeId)
				if not voyageSupported(vessel, progress.routeId) or not vessel.active or vessel.strength <= 0 or not vessel.hull.maintained or vessel.hull.integrity <= 0 or not militaryMapMatches(vessel.regionId, route.mapId)
					vessel.supply += progress.interrupt()
				else
					vessel.supply += voyages.resolve(progress, day, voyageEligible(vessel))
				if not progress.pending()
					instantiate(vessel)
	function startVoyage(string forceId, string routeId, string controllerId, int day, boolean destinationKnown) returns boolean
		let found = forceIndex(forceId)
		if found < 0 or not destinationKnown or voyages == null
			return false
		let vessel = forces[found]
		let route = voyages.route(routeId)
		if naval.busy(forceId) or science.busy(forceId) or route == null or not voyageSupported(vessel, routeId) or vessel.controllerId != controllerId or not vessel.active or vessel.strength <= 0 or not vessel.hull.maintained or vessel.hull.integrity <= 0 or not militaryMapMatches(vessel.regionId, route.mapId)
			return false
		if orderCallbacks != null
			orderCallbacks.capture()
		let specification = voyages.ship(vessel.id)
		var stationX = 0.
		var stationY = 0.
		var station = false
		if specification != null
			stationX = specification.stationX
			stationY = specification.stationY
			station = true
		else
			for i = 0 to naval.count - 1
				let yard = naval.yards[i]
				if yard.profileId == vessel.combatProfileId and yard.unitTypeId == vessel.unitTypeId and yard.mapId == route.mapId
					stationX = yard.x
					stationY = yard.y
					station = naval.states[i].ready > 0
		if not station or (vessel.x - stationX) * (vessel.x - stationX) + (vessel.y - stationY) * (vessel.y - stationY) > 128. * 128.
			return false
		if not voyages.start(vessel.navigation, route, day, vessel.supply)
			return false
		if vessel.hull.lastDay == 0
			vessel.hull.lastDay = day
		// Retire the sampled local object; the circuit returns to this station.
		vessel.supply -= vessel.navigation.reserved
		vessel.cancelOrder()
		adapter.removeRepresentation(vessel.id)
		return true
	function interruptVoyage(string forceId, string controllerId, int day) returns boolean
		let found = forceIndex(forceId)
		if found < 0 or forces[found].controllerId != controllerId or not forces[found].navigation.pending()
			return false
		resolveVoyages(day)
		let vessel = forces[found]
		vessel.supply += vessel.navigation.interrupt()
		instantiate(vessel)
		return true
	function setNavigationEquipment(string forceId, string controllerId, boolean equipped, int day) returns boolean
		let found = forceIndex(forceId)
		if found < 0 or not voyageSupported(forces[found], "") or forces[found].controllerId != controllerId or forces[found].navigation.equipment == equipped
			return false
		if equipped and (voyages.ship(forceId) == null or not militaryMapMatches(forces[found].regionId, voyages.ship(forceId).mapId))
			return false
		resolveVoyages(day)
		forces[found].navigation.equipment = equipped
		return true
	function issueOrder(string forceId, string orderId, real targetX, real targetY) returns boolean
		var command = orderId
		let found = forceIndex(forceId)
		if found < 0 or forces[found].navigation.pending() or naval.busy(forceId) or science.busy(forceId) or not forces[found].mobileForce() or not locationNumber(targetX.toString()) or not locationNumber(targetY.toString())
			return false
		if orderId == "march" or orderId == "sail"
			command = "move"
		if command != "move" and command != "patrol" and command != "attack-move" and command != "hold" and command != "stop"
			return false
		if (orderId == "hold" or orderId == "stop") and (targetX != 0. or targetY != 0.)
			return false
		forces[found].orderId = command
		forces[found].orderX = targetX
		forces[found].orderY = targetY
		forces[found].orderTargetId = ""
		forces[found].orderControllerId = forces[found].controllerId
		return true
	function appoint(string settlementId, AdministratorState administrator) returns string
		let settlement = settlementIndex(settlementId)
		if settlement < 0 or settlements[settlement].controllerId != administrator.controllerId
			return "The candidate lacks authority in that settlement."
		let current = administratorIndex(settlementId)
		if current >= 0
			let old = administrators[current]
			if old.characterId == administrator.characterId
				return "That administrator already holds this office."
			if not old.oathbound
				old.loyalty = old.loyalty - 5
			administrators[current] = administrator
		else
			if registrationAdministrators != null
				registrationAdministrators.add(settlementId, administratorCount)
			administratorSettlementIds[administratorCount] = settlementId
			administrators[administratorCount] = administrator
			administratorCount++
		return "Administrator appointed."
	function replacementWarning(string settlementId) returns string
		let found = administratorIndex(settlementId)
		if found >= 0 and administrators[found].loyalty < 30
			return "Warning: replacement may trigger refusal, defection, mutiny, or rebellion."
		return ""
	function validConflictAtom(string value) returns boolean
		return value != "" and value.indexOf(",") < 0 and value.indexOf("|") < 0 and value.indexOf(";") < 0
	function conflictIndex(string id) returns int
		for i = 0 to conflictCount - 1
			if conflicts[i].id == id
				return i
		return -1
	function registerConflictMember(string id, string polityId, int side) returns boolean
		if not validConflictAtom(id) or not validConflictAtom(polityId) or (side != 1 and side != 2)
			return false
		var found = conflictIndex(id)
		if found < 0
			if conflictCount >= 256
				return false
			found = conflictCount
			conflicts[conflictCount] = new MilitaryConflict(id)
			conflictCount++
		let conflict = conflicts[found]
		if conflict.side(polityId) != 0
			return conflict.side(polityId) == side
		if conflict.settled or conflict.count >= 64
			return false
		conflict.polities[conflict.count] = polityId
		conflict.sides[conflict.count] = side
		conflict.count++
		return true
	function activeOpponents(string id, string first, string second) returns boolean
		let found = conflictIndex(id)
		return found >= 0 and not conflicts[found].settled and conflicts[found].opposes(first, second)
	function activeConflictBetween(string first, string second) returns string
		for i = 0 to conflictCount - 1
			if not conflicts[i].settled and conflicts[i].opposes(first, second)
				return conflicts[i].id
		return ""
	/** Compatibility entry point for callers without an authored conflict ID.
	 * Pair wars have their own stable identity and cannot overwrite named wars. */
	function setWar(string first, string second, boolean active)
		if first == "" or second == "" or first == second
			return
		var id = "legacy:" + first + ":" + second
		if conflictIndex("legacy:" + second + ":" + first) >= 0
			id = "legacy:" + second + ":" + first
		if active
			if not atWar(first, second)
				registerConflictMember(id, first, 1)
				registerConflictMember(id, second, 2)
		else
			settleConflict(id)
	function atWar(string first, string second) returns boolean
		return activeConflictBetween(first, second) != ""
	function settleConflict(string id) returns boolean
		let found = conflictIndex(id)
		if found < 0 or conflicts[found].settled
			return false
		conflicts[found].settled = true
		reconcileSieges()
		return true
	function endSettlementAttack(SettlementRuntimeState state)
		state.underAttack = false
		state.attackerId = ""
		state.nextWaveAt = 0.
		for j = 0 to forceCount - 1
			if forces[j].kind == FORCE_GARRISON and hasPrefix(forces[j].id, "garrison:" + state.id + ":")
				forces[j].active = false
				adapter.removeRepresentation(forces[j].id)
	function reconcileSieges()
		for i = 0 to settlementCount - 1
			let state = settlements[i]
			if state.underAttack and (not state.capturable or not atWar(state.attackerId, state.controllerId))
				endSettlementAttack(state)
	function conflictSnapshot() returns string
		var result = ""
		for i = 0 to conflictCount - 1
			let conflict = conflicts[i]
			result += "|c," + conflict.id + "," + boolText(conflict.settled)
			for j = 0 to conflict.count - 1
				result += "|m," + conflict.id + "," + conflict.polities[j] + "," + conflict.sides[j].toString()
		return result
	function rememberConflictDefaults()
		if initialConflicts == ""
			initialConflicts = conflictSnapshot()
	function traditionLifePermille(RuntimeForce runtimeForce) returns int
		let found = traditionIndex(runtimeForce.controllerId, runtimeForce.categoryId)
		if found < 0
			return 0
		return exactNaturalNativeInt(exactNaturalScaleFloor(traditions[found].experience, traditions[found].lifePermillePerHundredXp, 100))
	function traditionAbility(RuntimeForce runtimeForce) returns int
		let found = traditionIndex(runtimeForce.controllerId, runtimeForce.categoryId)
		if found >= 0 and exactNaturalCompare(traditions[found].experience, I2S(traditions[found].milestoneXp)) >= 0
			return traditions[found].milestoneAbilityId
		return 0
	/** Caller owns the returned layer, including for abstract/inactive forces. */
	function resolveTradition(RuntimeForce runtimeForce) returns TraditionLayer
		let found = traditionIndex(runtimeForce.controllerId, runtimeForce.categoryId)
		if found < 0 or traditions[found].definition == null
			return null
		let track = traditions[found]
		return track.definition.resolve(track.controllerId, track.categoryId, track.experience)
	function combatProfile(RuntimeForce runtimeForce) returns CombatProfile
		if combatBindings == null or runtimeForce.combatProfileId == ""
			return null
		return combatBindings.profile(runtimeForce.combatProfileId, runtimeForce.unitTypeId, runtimeForce.kind)
	/** Both native and inactive-region callers use this exact calculation. The
	 * caller supplies diplomatic identity; progression uses current controllers.
	 * A casualty callback consumes loss, never calls this boundary a second time. */
	function applyCombatHit(CombatHit hit, int sourceIndex, int targetIndex, string sourcePolity, string targetPolity, boolean weaponAttack)
		if hit.applied or combatBindings == null or sourceIndex < 0 or targetIndex < 0 or sourceIndex >= forceCount or targetIndex >= forceCount
			return
		if weaponAttack and orderCallbacks != null
			orderCallbacks.capture()
		let source = forces[sourceIndex]
		let target = forces[targetIndex]
		// A retired service recipient or unpaid fleet cannot deliver an abstract
		// hit that the installed native authority would reject.
		if not source.hull.maintained or source.hull.integrity <= 0 or target.hull.integrity <= 0 or naval.busy(source.id) or naval.busy(target.id)
			hit.applied = true
			destroy hit.damage
			hit.damage = new ExactRational("0", "1", "1")
			return
		let city = settlementForForce(target)
		var legal = source.active and target.active and not naval.busy(source.id) and not naval.busy(target.id) and source.hull.maintained and source.hull.integrity > 0 and target.hull.integrity > 0 and source.strength > 0 and target.strength > 0 and atWar(sourcePolity, targetPolity)
		legal = legal and (militaryMapMatches(source.regionId, target.regionId) or militaryMapMatches(target.regionId, source.regionId) or scenarioAuthorityMap(source.regionId) != "" and scenarioAuthorityMap(source.regionId) == scenarioAuthorityMap(target.regionId))
		if city >= 0
			legal = legal and settlements[city].controllerId == target.controllerId and gameplaySeconds >= settlements[city].captureImmuneUntil
		if legal and weaponAttack and hit.damage.numerator != "0" and not hit.damage.negative() and not acceptLandShot(hit, source)
			return
		let attackingLayer = resolveTradition(source)
		let defendingLayer = resolveTradition(target)
		CombatProfile weapon = null
		if weaponAttack
			weapon = combatProfile(source)
		let attackingKit = landKit(source)
		let defendingKit = landKit(target)
		if legal and weaponAttack and hit.attackId == "land_cavalry_melee" and attackingKit != null and attackingKit.cavalry and defendingKit != null and defendingKit.bayonet
			hit.contextualDefense = land.rate(target.controllerId, "anti_cavalry_melee_defense")
		let navalSource = navalCombatSources(source, target, weaponAttack)
		combatBindings.applyForCombatants(hit, legal, attackingLayer, weapon, defendingLayer, combatProfile(target), navalSource, null, source.controllerId, source.categoryId, target.controllerId, target.categoryId)
		destroy navalSource
		if attackingLayer != null
			destroy attackingLayer
		if defendingLayer != null
			destroy defendingLayer
	function navalCombatSources(RuntimeForce source, RuntimeForce target, boolean weaponAttack) returns CombatSources
		let result = new CombatSources()
		let profile = naval.profile(source.combatProfileId, source.unitTypeId)
		let weapon = combatProfile(source)
		if navalResearch != null and weaponAttack and weapon != null and weapon.attackId == "naval_gunfire" and profile != null and profile.carronadeMount and source.kind == FORCE_FLEET and source.hull.carronades and source.hull.maintained and source.hull.integrity > 0 and rpg != null and rpg.heroes.clock != null and rpg.heroes.clock.currentDay >= naval.mountFirstDay and not naval.busy(source.id) and (source.x - target.x) * (source.x - target.x) + (source.y - target.y) * (source.y - target.y) <= naval.closeRange * naval.closeRange
			let rate = navalResearch.rate(source.controllerId, "close_range_naval_gunfire_damage")
			result.replace("naval:mounted_close_range", "naval_gunfire", "damage", new ExactRational(I2S(rate), "1", "1"))
		return result
	function reconcileForceTradition(RuntimeForce runtimeForce)
		TraditionLayer layer = null
		if runtimeForce.active and runtimeForce.strength > 0 and militaryMapMatches(runtimeForce.regionId, activeRegionId)
			layer = resolveTradition(runtimeForce)
		adapter.replaceTraditionLayer(runtimeForce.id, layer)
		reconcileLandReload(runtimeForce)
		// Retain the generic legacy adapter for its existing consumers. Generated
		// typed definitions never write health or native abilities, including on
		// transfers to an ineligible controller/category.
		let track = traditionIndex(runtimeForce.controllerId, runtimeForce.categoryId)
		if traditionDefinitions == null and (track < 0 or traditions[track].definition == null)
			adapter.applyTradition(runtimeForce.id, traditionLifePermille(runtimeForce), traditionAbility(runtimeForce))
	function instantiate(RuntimeForce runtimeForce)
		if naval.busy(runtimeForce.id) or science.busy(runtimeForce.id) or runtimeForce.navigation.pending() or not runtimeForce.active or not militaryMapMatches(runtimeForce.regionId, activeRegionId)
			adapter.replaceTraditionLayer(runtimeForce.id, null)
			return
		let city = settlementForForce(runtimeForce)
		if city >= 0 and (not settlements[city].projectMilitary or not settlements[city].capturable)
			return
		let localDefense = runtimeForce.kind == FORCE_GARRISON or runtimeForce.kind == FORCE_CITY_CORE or runtimeForce.kind == FORCE_DEFENSE
		adapter.createRepresentation(runtimeForce, adapter.playerForController(runtimeForce.controllerId, localDefense))
		reconcileForceTradition(runtimeForce)
		if city >= 0 and (runtimeForce.kind == FORCE_CITY_CORE or runtimeForce.kind == FORCE_DEFENSE)
			adapter.protectRepresentation(runtimeForce.id, settlements[city].captureImmuneUntil > gameplaySeconds)
		if orderCallbacks != null
			orderCallbacks.reconstructedForce(runtimeForce.id)
	/** Resolve only the registered settlement's exact core or local-force prefix. */
	function settlementForForce(RuntimeForce runtimeForce) returns int
		if runtimeForce.kind != FORCE_CITY_CORE and runtimeForce.kind != FORCE_GARRISON and runtimeForce.kind != FORCE_DEFENSE
			return -1
		for i = 0 to settlementCount - 1
			let id = settlements[i].id
			if (runtimeForce.kind == FORCE_CITY_CORE and runtimeForce.id == "core:" + id) or (runtimeForce.kind == FORCE_GARRISON and hasPrefix(runtimeForce.id, "garrison:" + id + ":")) or (runtimeForce.kind == FORCE_DEFENSE and hasPrefix(runtimeForce.id, "defense:" + id + ":"))
				return i
		return -1
	function suspendCallbacks()
		if orderCallbacks != null
			orderCallbacks.suspend()
		if callbacks != null
			callbacks.suspend()
	function resumeCallbacks()
		if callbacks != null
			callbacks.resume()
		if orderCallbacks != null
			orderCallbacks.resume()
	function activateRegion(string regionId)
		if orderCallbacks != null
			orderCallbacks.capture()
		suspendCallbacks()
		if activeRegionId != ""
			for i = 0 to forceCount - 1
				if militaryMapMatches(forces[i].regionId, activeRegionId)
					adapter.removeRepresentation(forces[i].id)
		activeRegionId = regionId
		for i = 0 to forceCount - 1
			instantiate(forces[i])
		if orderCallbacks != null
			orderCallbacks.reconstruct()
		resumeCallbacks()
	function recruit(RuntimeForce runtimeForce) returns boolean
		if runtimeForce.strength <= 0 or runtimeForce.supply <= 0 or forceIndex(runtimeForce.id) >= 0
			return false
		if runtimeForce.combatProfileId != "" and combatProfile(runtimeForce) == null
			return false
		registerForce(runtimeForce)
		instantiate(runtimeForce)
		return true
	/** The roster caller supplies its existing archetype; never deduce one from
	 * controller, tradition category, rawcode, or historical nationality. */
	function recruit(RuntimeForce runtimeForce, string profileId) returns boolean
		if combatBindings == null or combatBindings.profile(profileId, runtimeForce.unitTypeId, runtimeForce.kind) == null
			return false
		let previous = runtimeForce.combatProfileId
		runtimeForce.combatProfileId = profileId
		if recruit(runtimeForce)
			return true
		runtimeForce.combatProfileId = previous
		return false
	function reinforce(string forceId, int strength, int supplyCost) returns boolean
		let found = forceIndex(forceId)
		if found < 0 or strength <= 0 or supplyCost < 0 or forces[found].supply < supplyCost
			return false
		forces[found].supply = forces[found].supply - supplyCost
		forces[found].strength = IMinBJ(forces[found].maximumStrength, forces[found].strength + strength)
		return true
	function recordLoss(string forceId, int loss)
		let found = forceIndex(forceId)
		if found < 0 or loss <= 0
			return
		forces[found].strength = IMaxBJ(0, forces[found].strength - loss)
		if forces[found].strength == 0
			forces[found].active = false
			adapter.removeRepresentation(forceId)
	/** Called only after the combat adapter resolves current participants and
	 * legal hostility. A death consumes the victim's remaining authoritative
	 * strength. Loss and earned XP commit before any native projection or RPG
	 * notification can reenter. The inactive, zero-strength force is the durable
	 * receipt; no native handle or transient callback ID is saved. */
	@noinline
	function commitCombatLoss(int victimIndex, int contributorIndex, real now) returns boolean
		let victim = forces[victimIndex]
		if not victim.active or victim.strength <= 0 or victim.kind == FORCE_CITY_CORE
			return false
		let loss = victim.strength
		var track = -1
		var experience = "0"
		let source = contributionIndex("enemy_kill")
		if contributorIndex >= 0 and source >= 0
			let contributor = forces[contributorIndex]
			track = traditionIndex(contributor.controllerId, contributor.categoryId)
			// The headless contract also requires an eligible enemy controller.
			if track >= 0 and contributor.controllerId != victim.controllerId and traditionIndex(victim.controllerId, contributor.categoryId) >= 0
				experience = contributions[source].weighted(loss)
		let city = settlementForForce(victim)
		if victim.kind == FORCE_GARRISON and city >= 0
			settlements[city].lastCombatAt = now
			settlements[city].garrisonStrength = IMaxBJ(0, settlements[city].garrisonStrength - loss)
		victim.strength = 0
		victim.active = false
		if experience != "0"
			awardTradition(traditions[track].controllerId, traditions[track].categoryId, experience)
		adapter.removeRepresentation(victim.id)
		if victim.kind == FORCE_GARRISON and city >= 0 and rpg != null
			rpg.worldEventAt("combat", settlements[city].id, loss, authorityDay())
		return true
	function transferControl(string forceId, string controllerId)
		transferControl(forceId, controllerId, authorityDay())
	function transferControl(string forceId, string controllerId, int day)
		resolveVoyages(day)
		let found = forceIndex(forceId)
		if found >= 0
			if orderCallbacks != null
				orderCallbacks.capture()
			suspendCallbacks()
			let returningFromNaval = naval.busy(forceId)
			let returningFromScience = science.busy(forceId)
			if forces[found].controllerId != controllerId
				science.controlChanged(forceId, controllerId, day)
				naval.controlChanged(forceId)
				forces[found].hull.repairCredit = 0
				forces[found].hull.weatherCredit = 0
				forces[found].cancelOrder()
			forces[found].controllerId = controllerId
			forces[found].orderControllerId = controllerId
			adapter.changeRepresentationOwner(forceId, adapter.playerForController(controllerId, not forces[found].mobileForce()))
			if (returningFromScience and not science.busy(forceId)) or (returningFromNaval and not naval.busy(forceId))
				instantiate(forces[found])
			reconcileForceTradition(forces[found])
			if orderCallbacks != null
				orderCallbacks.reconstruct()
			resumeCallbacks()
	/** Explicit category reassignment retires callbacks and replaces only derived
	 * tradition/discipline. Empty removes eligibility; unknown categories reject. */
	function changeForceCategory(string forceId, string categoryId) returns boolean
		let found = forceIndex(forceId)
		if found < 0
			return false
		var known = categoryId == ""
		for i = 0 to traditionCount - 1
			if traditions[i].categoryId == categoryId and traditions[i].definition != null
				known = true
		if not known
			return false
		suspendCallbacks()
		forces[found].categoryId = categoryId
		reconcileForceTradition(forces[found])
		resumeCallbacks()
		return true
	function awardTradition(string controllerId, string categoryId, int experience)
		if experience > 0
			awardTradition(controllerId, categoryId, I2S(experience))
	function awardTradition(string controllerId, string categoryId, string experience)
		let found = traditionIndex(controllerId, categoryId)
		if found < 0 or not exactNaturalValid(experience) or experience == "0"
			return
		traditions[found].experience = exactNaturalAdd(traditions[found].experience, experience)
		for i = 0 to forceCount - 1
			if forces[i].controllerId == controllerId and forces[i].categoryId == categoryId
				reconcileForceTradition(forces[i])
	function beginSettlementAttack(string settlementId, string attackerId, real now) returns boolean
		let found = settlementIndex(settlementId)
		if found < 0 or not settlements[found].capturable or now < settlements[found].captureImmuneUntil or not atWar(attackerId, settlements[found].controllerId)
			return false
		let state = settlements[found]
		if not state.underAttack
			state.nextWaveAt = now
		state.underAttack = true
		state.attackerId = attackerId
		state.lastCombatAt = now
		return true
	function spawnGarrisonWave(SettlementRuntimeState state, real now)
		// At most one bounded wave per wake, including after a delayed callback.
		state.nextWaveAt = now + state.reinforcementInterval
		if forceCount >= 4096
			return
		let available = IMinBJ(state.waveSize, IMinBJ(state.garrisonStrength, IMinBJ(state.reserves, IMinBJ(state.manpower, state.supply))))
		if available <= 0
			return
		state.reserves = state.reserves - available
		state.manpower = state.manpower - available
		state.supply = state.supply - available
		var waveId = "garrison:" + state.id + ":" + R2I(now).toString()
		if forceIndex(waveId) >= 0
			waveId += ":" + forceCount.toString()
		registerForce(new RuntimeForce(waveId, state.controllerId, state.regionId, "infantry", FORCE_GARRISON, state.defenderTypeId, available, available, state.x + 96., state.y))
		instantiate(forces[forceCount - 1])
	function tick(real now)
		reconcileSieges()
		for i = 0 to settlementCount - 1
			let state = settlements[i]
			if state.underAttack and now >= state.lastCombatAt + state.quietPeriod
				endSettlementAttack(state)
			else if state.underAttack and now >= state.nextWaveAt
				spawnGarrisonWave(state, now)
	function recordGarrisonLoss(string settlementId, string forceId, int loss, real now)
		let found = settlementIndex(settlementId)
		let forceSlot = forceIndex(forceId)
		if found < 0 or forceSlot < 0 or loss <= 0 or not forces[forceSlot].active or forces[forceSlot].kind != FORCE_GARRISON or settlementForForce(forces[forceSlot]) != found
			return
		let actual = IMinBJ(loss, forces[forceSlot].strength)
		settlements[found].lastCombatAt = now
		settlements[found].garrisonStrength = IMaxBJ(0, settlements[found].garrisonStrength - actual)
		recordLoss(forceId, actual)
		if rpg != null and actual > 0
			rpg.worldEventAt("combat",settlementId,actual,authorityDay())
	function replenishGarrison(string settlementId, int amount, int manpowerCost, int supplyCost) returns boolean
		let found = settlementIndex(settlementId)
		if found < 0 or settlements[found].underAttack or amount <= 0 or settlements[found].manpower < manpowerCost or settlements[found].supply < supplyCost
			return false
		let state = settlements[found]
		state.manpower = state.manpower - manpowerCost
		state.supply = state.supply - supplyCost
		state.garrisonStrength = IMinBJ(state.garrisonMaximum, state.garrisonStrength + amount)
		state.reserves = state.reserves + amount
		return true
	function capture(string settlementId, string attackerId, real now) returns boolean
		let found = settlementIndex(settlementId)
		if found < 0
			return false
		let state = settlements[found]
		if not state.capturable or now < state.captureImmuneUntil or not atWar(attackerId, state.controllerId)
			return false
		state.occupationConflictId = activeConflictBetween(attackerId, state.controllerId)
		transferSettlement(settlementId, attackerId)
		if state.controllerId == state.legalOwnerId
			state.occupationConflictId = ""
		state.captureImmuneUntil = now + CITY_CAPTURE_IMMUNITY_SECONDS
		adapter.protectRepresentation("core:" + settlementId, true)
		for i = 0 to forceCount - 1
			if hasPrefix(forces[i].id, "defense:" + settlementId + ":")
				adapter.protectRepresentation(forces[i].id, true)
		if rpg != null
			rpg.worldEventAt("settlement",settlementId,1,authorityDay())
		return true
	/** Territorial authority owns control, defenses and office reconciliation. */
	function transferSettlement(string settlementId, string controllerId)
		let state = settlements[settlementIndex(settlementId)]
		endSettlementAttack(state)
		// Cleanup all old local military representations before rebuilding the core.
		for i = 0 to forceCount - 1
			if forces[i].id == "core:" + settlementId or hasPrefix(forces[i].id, "garrison:" + settlementId + ":") or hasPrefix(forces[i].id, "defense:" + settlementId + ":")
				forces[i].active = false
				adapter.removeRepresentation(forces[i].id)
		if state.controllerId != controllerId
			// Standalone authorities may have no installed campaign clock. As
			// with science, retain each project's last committed day in that case.
			var transferDay = -1
			if authorityClock() != null
				transferDay = authorityDay()
			industry.controlChanged(settlementId, controllerId, transferDay)
			civic.controlChanged(settlementId)
			finance.controlChanged(settlementId)
			let arsenal = land.index(settlementId)
			if arsenal >= 0
				land.arsenals[arsenal].cancel()
			for i = 0 to science.count - 1
				let site = science.sites[i]
				if site.settlementId == settlementId and science.busy(site.forceId)
					// Return the retired actor before clearing local project state.
					let actorIndex = forceIndex(site.forceId)
					science.states[i].stop()
					if actorIndex >= 0
						instantiate(forces[actorIndex])
			science.controlChanged(settlementId, controllerId, -1)
			let yardIndex = naval.index(settlementId)
			var navalTarget = ""
			if yardIndex >= 0
				navalTarget = naval.states[yardIndex].target
			naval.controlChanged(settlementId)
			let targetIndex = forceIndex(navalTarget)
			if targetIndex >= 0
				instantiate(forces[targetIndex])
		state.controllerId = controllerId
		state.underAttack = false
		state.garrisonStrength = 0
		state.reserves = 0
		let coreIndex = forceIndex("core:" + settlementId)
		if coreIndex >= 0
			let core = forces[coreIndex]
			core.controllerId = controllerId
			core.active = true
			instantiate(core)
		// Pre-authored defense records retain their exact type and coordinates.
		for i = 0 to forceCount - 1
			if hasPrefix(forces[i].id, "defense:" + settlementId + ":")
				forces[i].controllerId = controllerId
				forces[i].active = true
				forces[i].strength = forces[i].maximumStrength
				instantiate(forces[i])
		let office = administratorIndex(settlementId)
		if office < 0 or administrators[office].controllerId != controllerId
			appoint(settlementId, new AdministratorState("acting:" + settlementId + ":" + controllerId, "Local Deputy", "Acting Administrator", controllerId, state.regionId, settlementId, 50, 50, 40, 1))
	function canCede(string conflictId, string settlementId, string grantor, string beneficiary) returns boolean
		let found = settlementIndex(settlementId)
		if found < 0 or not activeOpponents(conflictId, grantor, beneficiary)
			return false
		let state = settlements[found]
		return state.legalOwnerId == grantor and (state.controllerId == grantor or (state.controllerId == beneficiary and state.occupationConflictId == conflictId))
	/** Personal control does not confer title to occupied foreign territory.
	 * Voluntary sovereignty transfers require settled title and a durable core;
	 * contested land must first resolve through the ordinary conflict authority. */
	function canTransferSovereignty(string settlementId, string grantor) returns boolean
		let found = settlementIndex(settlementId)
		let core = forceIndex("core:" + settlementId)
		if found < 0 or core < 0
			return false
		let state = settlements[found]
		return state.controllerId == grantor and state.legalOwnerId == grantor and state.occupationConflictId == "" and not state.underAttack and forces[core].kind == FORCE_CITY_CORE and forces[core].controllerId == grantor and forces[core].active and forces[core].strength > 0
	/** Commit only after the caller has validated the complete transaction. */
	function transferSovereignty(string settlementId, string beneficiary)
		let state = settlements[settlementIndex(settlementId)]
		state.legalOwnerId = beneficiary
		transferSettlement(settlementId, beneficiary)
		state.occupationConflictId = ""
	function controllerInUse(string controller) returns boolean
		for i = 0 to forceCount - 1
			if forces[i].controllerId == controller
				return true
		for i = 0 to settlementCount - 1
			if settlements[i].controllerId == controller or settlements[i].legalOwnerId == controller
				return true
		for i = 0 to administratorCount - 1
			if administrators[i].controllerId == controller
				return true
		for i = 0 to traditionCount - 1
			if traditions[i].controllerId == controller
				return true
		for i = 0 to conflictCount - 1
			if conflicts[i].side(controller) != 0
				return true
		return false
	/** Legacy derived-registration repair. Never infer title, occupation or
	 * control, refill defenses, revive losses, or restart a siege from history. */
	function reconcileSettlementRegistrations(string settlementId)
		let state = settlements[settlementIndex(settlementId)]
		for i = 0 to forceCount - 1
			let localForce = forces[i]
			if localForce.id == "core:" + settlementId or hasPrefix(localForce.id, "defense:" + settlementId + ":") or (localForce.active and hasPrefix(localForce.id, "garrison:" + settlementId + ":"))
				if localForce.controllerId != state.controllerId
					localForce.controllerId = state.controllerId
					adapter.removeRepresentation(localForce.id)
					instantiate(localForce)
		let office = administratorIndex(settlementId)
		if office < 0 or administrators[office].controllerId != state.controllerId
			appoint(settlementId, new AdministratorState("acting:" + settlementId + ":" + state.controllerId, "Local Deputy", "Acting Administrator", state.controllerId, state.regionId, settlementId, 50, 50, 40, 1))
	/** Called after the complete treaty has been validated. No fallible work
	 * remains between territorial reconciliation and settling the conflict. */
	function commitPeace(string conflictId, string cededSettlementId, string beneficiary) returns boolean
		let found = conflictIndex(conflictId)
		if found < 0 or conflicts[found].settled
			return false
		if cededSettlementId != ""
			let city = settlementIndex(cededSettlementId)
			if city < 0 or not canCede(conflictId, cededSettlementId, settlements[city].legalOwnerId, beneficiary)
				return false
		for i = 0 to settlementCount - 1
			let state = settlements[i]
			if state.id == cededSettlementId
				transferSovereignty(state.id, beneficiary)
			else if state.occupationConflictId == conflictId
				transferSettlement(state.id, state.legalOwnerId)
				state.occupationConflictId = ""
		return settleConflict(conflictId)
	function releaseCaptureProtection(real now)
		for i = 0 to settlementCount - 1
			if settlements[i].captureImmuneUntil > 0. and now >= settlements[i].captureImmuneUntil
				adapter.protectRepresentation("core:" + settlements[i].id, false)
				for j = 0 to forceCount - 1
					if hasPrefix(forces[j].id, "defense:" + settlements[i].id + ":")
						adapter.protectRepresentation(forces[j].id, false)
				settlements[i].captureImmuneUntil = 0.
	function boolText(boolean value) returns string
		if value
			return "1"
		return "0"
	/** Stable, handle-free authority. Every mutable military/settlement field is
	 * included so inactive regions advance and reload exactly like active ones. */
	function snapshot() returns string
		if orderCallbacks != null
			orderCallbacks.capture()
		if callbacks != null
			callbacks.synchronize()
		var result = "v" + MILITARY_SETTLEMENT_SNAPSHOT_VERSION.toString() + "|k," + clockReal(gameplaySeconds) + "|a," + activeRegionId
		for i = 0 to forceCount - 1
			let f = forces[i]
			result += "|f," + f.id + "," + f.controllerId + "," + f.regionId + "," + f.categoryId + "," + f.kind.toString() + "," + f.unitTypeId.toString() + "," + f.strength.toString() + "," + f.maximumStrength.toString() + "," + f.supply.toString() + "," + R2S(f.x) + "," + R2S(f.y) + "," + boolText(f.active) + "," + f.orderId + "," + R2S(f.orderX) + "," + R2S(f.orderY) + "," + f.orderTargetId + "," + f.orderControllerId
			if f.kind == FORCE_FLEET
				result += "|h," + f.id + "," + f.hull.record()
			if f.nextFireAt > 0.
				result += "|h," + f.id + "," + clockReal(f.nextFireAt)
			if f.navigation.equipment or f.navigation.pending() or f.navigation.creditBasisPoints > 0
				result += "|v," + f.id + "," + f.navigation.record()
			if f.combatProfileId != ""
				result += "|p," + f.id + "," + f.combatProfileId
			// Strategic movement may reassign an unloaded force. A hint from its
			// previous physical map cannot accompany the new location authority.
			if f.recoveryMap != "" and f.recoveryMap == f.regionId and (f.kind == FORCE_ARMY or f.kind == FORCE_FLEET)
				result += "|n," + f.id + "," + f.recoveryMap + "," + f.recoveryClass.toString() + "," + f.recoveryComponent.toString() + "," + f.safeX.toString() + "," + f.safeY.toString()
		for i = 0 to settlementCount - 1
			let s = settlements[i]
			result += "|s," + s.id + "," + s.controllerId + "," + s.regionId + "," + s.coreTypeId.toString() + "," + s.defenderTypeId.toString() + "," + s.garrisonStrength.toString() + "," + s.garrisonMaximum.toString() + "," + s.reserves.toString() + "," + s.manpower.toString() + "," + s.supply.toString() + "," + s.waveSize.toString() + "," + clockReal(s.reinforcementInterval) + "," + clockReal(s.quietPeriod) + "," + clockReal(s.nextWaveAt) + "," + clockReal(s.lastCombatAt) + "," + clockReal(s.captureImmuneUntil) + "," + R2S(s.x) + "," + R2S(s.y) + "," + boolText(s.underAttack) + "," + s.legalOwnerId + "," + s.occupationConflictId + "," + s.attackerId + "," + boolText(s.projectMilitary) + "," + boolText(s.capturable) + "," + s.governanceExceptionId
		for i = 0 to administratorCount - 1
			let d = administrators[i]
			result += "|d," + administratorSettlementIds[i] + "," + d.characterId + "," + d.name + "," + d.title + "," + d.controllerId + "," + d.physicalRegionId + "," + d.jurisdiction + "," + d.loyalty.toString() + "," + d.administration.toString() + "," + d.command.toString() + "," + d.capacity.toString() + "," + boolText(d.oathbound)
		result += conflictSnapshot()
		for i = 0 to traditionCount - 1
			let t = traditions[i]
			result += "|t," + t.controllerId + "," + t.categoryId + "," + t.experience + "," + t.lifePermillePerHundredXp.toString() + "," + t.milestoneXp.toString() + "," + t.milestoneAbilityId.toString()
		for i = 0 to civic.count - 1
			let s = civic.states[i]
			result += "|g," + civic.districts[i].id + "," + s.policyOwner + "," + I2S(s.policyReady) + "," + I2S(s.upkeepThrough) + "," + s.surveyOwner + "," + I2S(s.surveyReady) + "," + boolText(s.surveyed) + "," + s.responseOwner + "," + I2S(s.responseEnd) + "," + I2S(s.cooldownEnd) + "," + I2S(s.lastDay) + "," + I2S(s.discussion) + "," + I2S(s.taxesCollected) + "," + I2S(s.diseaseLost) + "," + I2S(s.diseaseAvoided) + "," + I2S(s.tradeDay) + "," + I2S(s.tradedUnits)
		for i = 0 to land.count - 1
			let s = land.arsenals[i]
			result += "|l," + s.id + "," + s.owner + "," + I2S(s.ready) + "," + I2S(s.upkeepThrough) + "," + s.projectOwner + "," + I2S(s.work) + "," + boolText(s.officeBillPaid) + "," + I2S(s.serial) + "," + I2S(s.lastDay)
		for i = 0 to industry.count - 1
			result += "|i," + industry.sites[i].id + "," + industry.states[i].record()
		for i = 0 to finance.count - 1
			let s = finance.states[i]
			result += "|z," + finance.projects[i].id + "," + I2S(s.freightDay) + "," + I2S(s.freightUsed)
			result += "|q," + finance.projects[i].id + "," + s.owner + "," + I2S(s.work) + "," + I2S(s.lastDay) + "," + boolText(s.completed)
		for i = 0 to science.count - 1
			result += "|j," + science.sites[i].id + "," + science.states[i].record()
		for i = 0 to naval.count - 1
			result += "|y," + naval.yards[i].id + "," + naval.states[i].record()
		return result
	function deadlineReal(string value) returns real
		if legacyDeadlines
			return S2R(value)
		return readClockReal(value)
	function restoreSnapshotRecord(MilitarySnapshotRecord record, MilitarySettlementRuntime target) returns boolean
		let kind = record.field(0)
		if kind == "i"
			let i = target.industry.index(record.field(1))
			if record.count != 7 or i < 0 or target.industry.states[i].restored
				return false
			for j = 2 to 4
				if j != 3 and record.field(j) != "" and not scienceControllerText(record.field(j))
					return false
			for j = 3 to 6
				if j != 4 and (S2I(record.field(j)) < 0 or S2I(record.field(j)).toString() != record.field(j))
					return false
			let s = target.industry.states[i]
			let d = target.industry.sites[i]
			s.equipmentOwner = record.field(2)
			s.ready = S2I(record.field(3))
			s.owner = record.field(4)
			s.work = S2I(record.field(5))
			s.lastDay = S2I(record.field(6))
			s.restored = true
			if s.lastDay > 1000000 or s.ready > 1000000 or s.work >= d.workRequired * 10000 or (s.equipmentOwner == "") != (s.ready == 0)
				return false
			return (s.owner == "" and s.work == 0) or (s.owner == s.equipmentOwner and s.owner != "" and s.lastDay >= s.ready)
		if kind == "h"
			let i = target.forceIndex(record.field(1))
			// Version 13 branches used h for two distinct record shapes.
			if record.count == 3
				if i < 0 or target.forces[i].restoredFireClock
					return false
				let at = readClockReal(record.field(2))
				if at <= 0.
					return false
				target.forces[i].nextFireAt = at
				target.forces[i].restoredFireClock = true
				return true
			if record.count != 10 or i < 0 or target.forces[i].kind != FORCE_FLEET or target.forces[i].hull.restored
				return false
			for j = 2 to 9
				if S2I(record.field(j)).toString() != record.field(j) or S2I(record.field(j)) < 0
					return false
			for j = 3 to 5
				if record.field(j) != "0" and record.field(j) != "1"
					return false
			let h = target.forces[i].hull
			h.integrity = S2I(record.field(2))
			h.carronades = record.field(3) == "1"
			h.carvel = record.field(4) == "1"
			h.maintained = record.field(5) == "1"
			h.lastDay = S2I(record.field(6))
			h.repairCredit = S2I(record.field(7))
			h.weatherCredit = S2I(record.field(8))
			h.upkeepCredit = S2I(record.field(9))
			h.restored = true
			return h.integrity <= 10000 and h.lastDay <= 1000000 and h.repairCredit < 10000 and h.weatherCredit < 10000 and h.upkeepCredit < 30
		if kind == "y"
			let i = target.naval.index(record.field(1))
			if record.count != 10 or i < 0 or target.naval.states[i].restored
				return false
			for j = 2 to 9
				if j == 2 or j >= 7
					if S2I(record.field(j)).toString() != record.field(j) or S2I(record.field(j)) < 0 or S2I(record.field(j)) > 1000000
						return false
				else if record.field(j) != "" and not militaryOrderAtom(record.field(j))
					return false
			let s = target.naval.states[i]
			s.ready = S2I(record.field(2))
			s.boardOwner = record.field(3)
			s.owner = record.field(4)
			s.job = record.field(5)
			s.target = record.field(6)
			s.work = S2I(record.field(7))
			s.lastDay = S2I(record.field(8))
			s.serial = S2I(record.field(9))
			s.restored = true
			if s.ready > s.lastDay or (s.boardOwner != "" and s.ready == 0)
				return false
			if s.job == ""
				return s.owner == "" and s.target == "" and s.work == 0
			if s.owner == "" or (s.job != "dock" and s.ready == 0)
				return false
			if s.job == "dock"
				return s.ready == 0 and s.target == "" and s.work < target.naval.dockDays
			if s.job == "board"
				return s.target == "" and s.work < target.naval.boardDays
			if s.job == "build"
				return s.target == "" and s.boardOwner == s.owner and s.work <= target.naval.buildDays
			if s.target == "" or target.forceIndex(s.target) < 0
				return false
			return (s.job == "supply" and s.work == 0) or (s.job == "repair" and s.work <= 1) or (s.job == "mount" and s.work < target.naval.mountDays) or (s.job == "carvel" and s.work < target.naval.carvelDays)
		if kind == "l"
			let i = target.land.index(record.field(1))
			if record.count != 10 or i < 0 or target.land.arsenals[i].restored
				return false
			for j = 2 to 9
				if j == 2 or j == 5
					if record.field(j) != "" and not militaryOrderAtom(record.field(j))
						return false
				else if not exactNaturalValid(record.field(j)) or exactNaturalCompare(record.field(j), "2147483647") > 0
					return false
			let s = target.land.arsenals[i]
			s.restored = true
			s.owner = record.field(2)
			s.ready = S2I(record.field(3))
			s.upkeepThrough = S2I(record.field(4))
			s.projectOwner = record.field(5)
			s.work = S2I(record.field(6))
			s.officeBillPaid = record.field(7) == "1"
			s.serial = S2I(record.field(8))
			s.lastDay = S2I(record.field(9))
			return (record.field(7) == "0" or record.field(7) == "1") and (s.owner == "") == (s.ready == 0) and s.upkeepThrough >= s.ready and s.work <= target.land.constructionDays * 10000 and (s.projectOwner != "" or s.work == 0 and not s.officeBillPaid) and (s.projectOwner == "" or s.serial > 0)
		if kind == "z"
			let i = target.finance.index(record.field(1))
			if record.count != 4 or i < 0 or target.finance.states[i].freightRestored
				return false
			for j = 2 to 3
				if not exactNaturalValid(record.field(j)) or exactNaturalCompare(record.field(j), "2147483647") > 0
					return false
			let s = target.finance.states[i]
			s.freightRestored = true
			s.freightDay = S2I(record.field(2))
			s.freightUsed = S2I(record.field(3))
			return s.freightUsed == 0 or s.freightDay > 0 and target.finance.projects[i].freightCapacity > 0
		if kind == "q"
			let i = target.finance.index(record.field(1))
			if record.count != 6 or i < 0 or target.finance.states[i].restored
				return false
			if record.field(2) != "" and not scienceControllerText(record.field(2))
				return false
			for j = 3 to 4
				if not exactNaturalValid(record.field(j)) or exactNaturalCompare(record.field(j), "2147483647") > 0
					return false
			if record.field(5) != "0" and record.field(5) != "1"
				return false
			let s = target.finance.states[i]
			let d = target.finance.projects[i]
			s.restored = true
			s.owner = record.field(2)
			s.work = S2I(record.field(3))
			s.lastDay = S2I(record.field(4))
			s.completed = record.field(5) == "1"
			return s.work <= d.constructionDays and s.completed == (s.work == d.constructionDays) and (s.owner != "" or s.work == 0 and not s.completed) and (s.owner == "" or s.lastDay >= d.firstDay) and (s.owner == "" or s.work <= s.lastDay - d.firstDay)
		if kind == "j"
			let i = target.science.index(record.field(1))
			if record.count != 12 or i < 0 or target.science.states[i].restored
				return false
			for j = 2 to 11
				if j == 2 or j == 4
					if record.field(j) != "" and not scienceControllerText(record.field(j))
						return false
				else if j == 5
					if record.field(j) != "" and not researchStableId(record.field(j))
						return false
				else if S2I(record.field(j)).toString() != record.field(j) or S2I(record.field(j)) < 0
					return false
			let state = target.science.states[i]
			let site = target.science.sites[i]
			state.equipmentOwner = record.field(2)
			state.equipmentReady = S2I(record.field(3))
			state.owner = record.field(4)
			state.target = record.field(5)
			state.paid = S2I(record.field(6))
			state.lastDay = S2I(record.field(7))
			state.work = S2I(record.field(8))
			state.remainder = S2I(record.field(9))
			state.avoided = S2I(record.field(10))
			state.lost = S2I(record.field(11))
			state.restored = true
			if state.equipmentReady > 1000000 or state.lastDay > 1000000 or state.work >= site.workRequired or state.remainder >= 10000
				return false
			if state.equipmentOwner == "" and state.equipmentReady != 0
				return false
			if state.owner == ""
