				else if not exactNaturalValid(record.field(j)) or exactNaturalCompare(record.field(j), "2147483647") > 0
					return false
			if (record.field(7) != "0" and record.field(7) != "1") or S2I(record.field(12)) > 10000
				return false
			let s = target.civic.states[i]
			s.restored = true
			s.policyOwner = record.field(2)
			s.policyReady = S2I(record.field(3))
			s.upkeepThrough = S2I(record.field(4))
			s.surveyOwner = record.field(5)
			s.surveyReady = S2I(record.field(6))
			s.surveyed = record.field(7) == "1"
			s.responseOwner = record.field(8)
			s.responseEnd = S2I(record.field(9))
			s.cooldownEnd = S2I(record.field(10))
			s.lastDay = S2I(record.field(11))
			s.discussion = S2I(record.field(12))
			s.taxesCollected = S2I(record.field(13))
			s.diseaseLost = S2I(record.field(14))
			s.diseaseAvoided = S2I(record.field(15))
			s.tradeDay = S2I(record.field(16))
			s.tradedUnits = S2I(record.field(17))
			return (s.policyOwner == "") == (s.policyReady == 0) and (s.surveyOwner == "") == (s.surveyReady == 0) and (s.responseOwner == "") == (s.responseEnd == 0) and s.upkeepThrough >= s.policyReady and s.cooldownEnd >= s.responseEnd and (not s.surveyed or s.surveyReady > 0)
		if kind == "k"
			if target.legacyDeadlines or target.hasSavedGameplayClock or record.count != 2
				return false
			target.gameplaySeconds = readClockReal(record.field(1))
			target.hasSavedGameplayClock = true
			return target.gameplaySeconds >= 0.
		if kind == "a"
			target.activeRegionId = record.field(1)
			return true
		if kind == "f"
			let id = record.field(1)
			if id == "" or target.forceIndex(id) >= 0 or target.forceCount >= 4096 or (target.legacyOrders and record.count != 16) or (not target.legacyOrders and record.count != 18)
				return false
			if not locationNumber(record.field(10)) or not locationNumber(record.field(11)) or not locationNumber(record.field(14)) or not locationNumber(record.field(15))
				return false
			let f = new RuntimeForce(id, record.field(2), record.field(3), record.field(4), S2I(record.field(5)), S2I(record.field(6)), S2I(record.field(7)), S2I(record.field(9)), S2R(record.field(10)), S2R(record.field(11)))
			// Older Wurst projections accidentally read the intrinsic class typeId
			// instead of the authored rawcode. Repair known catalogue identities.
			let definition = forceIndex(id)
			if (target.legacyRecovery or target.legacyMilitaryVersion4) and f.unitTypeId < 65536 and definition >= 0
				f.unitTypeId = forces[definition].unitTypeId
			f.maximumStrength = S2I(record.field(8))
			f.active = record.field(12) == "1"
			f.orderId = record.field(13)
			f.orderX = S2R(record.field(14))
			f.orderY = S2R(record.field(15))
			if target.legacyOrders
				if f.orderId == "march" or f.orderId == "sail"
					f.orderId = "move"
				// Old arbitrary strings carried no target identity or argument
				// contract. Never infer a target that the old save did not record.
				if not f.validOrder()
					f.cancelOrder()
			else
				f.orderTargetId = record.field(16)
				f.orderControllerId = record.field(17)
			target.registerForce(f)
			return f.validOrder() and f.controllerId != "" and f.regionId != "" and f.maximumStrength >= f.strength and f.strength >= 0 and f.supply >= 0
		if kind == "v"
			let found = target.forceIndex(record.field(1))
			if target.legacyVoyages or record.count != 8 or found < 0 or target.voyages == null
				return false
			let vessel = target.forces[found]
			let progress = vessel.navigation
			if progress.saved or not target.voyageSupported(vessel, record.field(3)) or (record.field(2) != "0" and record.field(2) != "1")
				return false
			for i = 4 to 7
				if S2I(record.field(i)).toString() != record.field(i)
					return false
			progress.saved = true
			progress.equipment = record.field(2) == "1"
			progress.routeId = record.field(3)
			progress.elapsedDays = S2I(record.field(4))
			progress.lastDay = S2I(record.field(5))
			progress.reserved = S2I(record.field(6))
			progress.creditBasisPoints = S2I(record.field(7))
			return target.voyages.valid(progress) and vessel.supply <= 2147483647 - progress.reserved and (not progress.pending() or militaryMapMatches(vessel.regionId, target.voyages.route(progress.routeId).mapId))
		if kind == "p"
			let found = target.forceIndex(record.field(1))
			if record.count != 3 or found < 0 or target.combatBindings == null or target.legacyCombatProfiles
				return false
			let f = target.forces[found]
			if f.combatProfileId != "" or target.combatBindings.profile(record.field(2), f.unitTypeId, f.kind) == null
				return false
			f.combatProfileId = record.field(2)
			return true
		if kind == "n"
			let found = target.forceIndex(record.field(1))
			let kindText = record.field(3)
			let componentText = record.field(4)
			if target.legacyRecovery or found < 0 or record.count != 7 or not locationNumber(record.field(5)) or not locationNumber(record.field(6))
				return false
			let f = target.forces[found]
			if f.recoveryMap != "" or record.field(2) != f.regionId or S2I(kindText).toString() != kindText or S2I(kindText) < 0 or S2I(kindText) > 3 or S2I(componentText).toString() != componentText or S2I(componentText) <= 0 or (f.kind != FORCE_ARMY and f.kind != FORCE_FLEET)
				return false
			f.recoveryMap = record.field(2)
			f.recoveryClass = S2I(kindText)
			f.recoveryComponent = S2I(componentText)
			f.safeX = S2R(record.field(5))
			f.safeY = S2R(record.field(6))
			return true
		if kind == "s"
			let id = record.field(1)
			if id == "" or target.settlementIndex(id) >= 0 or target.settlementCount >= 1024
				return false
			let s = new SettlementRuntimeState(id, record.field(2), record.field(3), S2I(record.field(4)), S2I(record.field(5)), S2I(record.field(6)), S2I(record.field(8)), S2I(record.field(9)), S2I(record.field(10)), S2R(record.field(17)), S2R(record.field(18)))
			s.garrisonMaximum = S2I(record.field(7))
			s.waveSize = S2I(record.field(11))
			s.reinforcementInterval = target.deadlineReal(record.field(12))
			s.quietPeriod = target.deadlineReal(record.field(13))
			s.nextWaveAt = target.deadlineReal(record.field(14))
			s.lastCombatAt = target.deadlineReal(record.field(15))
			s.captureImmuneUntil = target.deadlineReal(record.field(16))
			s.underAttack = record.field(19) == "1"
			if not (s.reinforcementInterval > 0. and s.quietPeriod > 0. and s.nextWaveAt >= 0. and s.lastCombatAt >= 0. and s.captureImmuneUntil >= 0.)
				return false
			// Two branches emitted v4: recovery with 23-field settlements, and
			// settlement policy with 26. Select once and reject mixed layouts.
			if target.legacyMilitaryVersion4 and target.settlementCount == 0
				target.legacySettlements = record.count == 23
			if not target.legacyConflicts
				if (target.legacySettlements and record.count != 23) or (not target.legacySettlements and record.count != 26)
					return false
				s.legalOwnerId = record.field(20)
				s.occupationConflictId = record.field(21)
				s.attackerId = record.field(22)
				if s.legalOwnerId == ""
					return false
			if not target.legacySettlements
				if (record.field(23) != "0" and record.field(23) != "1") or (record.field(24) != "0" and record.field(24) != "1")
					return false
				s.withPolicy(record.field(23) == "1", record.field(24) == "1", record.field(25))
			target.settlements[target.settlementCount] = s
			target.settlementCount++
			return s.controllerId != "" and s.regionId != "" and s.garrisonMaximum >= s.garrisonStrength and s.garrisonStrength >= 0 and s.reserves >= 0 and s.manpower >= 0 and s.supply >= 0
		if kind == "d"
			let settlementId = record.field(1)
			if settlementId == "" or target.administratorIndex(settlementId) >= 0 or target.administratorCount >= 1024
				return false
			let d = new AdministratorState(record.field(2), record.field(3), record.field(4), record.field(5), record.field(6), record.field(7), S2I(record.field(8)), S2I(record.field(9)), S2I(record.field(10)), S2I(record.field(11)))
			d.oathbound = record.field(12) == "1"
			target.administratorSettlementIds[target.administratorCount] = settlementId
			target.administrators[target.administratorCount] = d
			target.administratorCount++
			return d.characterId != "" and target.settlementIndex(settlementId) >= 0
		if kind == "c"
			let id = record.field(1)
			let settled = record.field(2)
			if record.count != 3 or not validConflictAtom(id) or target.conflictIndex(id) >= 0 or target.conflictCount >= 256 or (settled != "0" and settled != "1")
				return false
			target.conflicts[target.conflictCount] = new MilitaryConflict(id)
			target.conflicts[target.conflictCount].settled = settled == "1"
			target.conflictCount++
			return true
		if kind == "m"
			let found = target.conflictIndex(record.field(1))
			let polity = record.field(2)
			let side = record.field(3)
			if record.count != 4 or found < 0 or not validConflictAtom(polity) or (side != "1" and side != "2")
				return false
			let conflict = target.conflicts[found]
			if conflict.side(polity) != 0 or conflict.count >= 64
				return false
			conflict.polities[conflict.count] = polity
			conflict.sides[conflict.count] = S2I(side)
			conflict.count++
			return true
		if kind == "w"
			if not target.legacyConflicts or record.field(1) == "" or record.field(2) == "" or record.field(1) == record.field(2)
				return false
			// The authored conflict already justifies this legacy pair, so it must
			// not acquire a second, immortal source of hostility during migration.
			target.setWar(record.field(1), record.field(2), true)
			return true
		if kind == "t"
			if record.count != 7 or target.traditionCount >= 256 or target.traditionIndex(record.field(1), record.field(2)) >= 0 or not militaryOrderAtom(record.field(1)) or not militaryOrderAtom(record.field(2))
				return false
			if not exactNaturalValid(record.field(3)) or (target.legacyIntegerExperience and exactNaturalCompare(record.field(3), "2147483647") > 0)
