public function militaryMapMatches(string locationId, string mapId) returns boolean
	return locationId == mapId or (mapId != "" and scenarioAuthorityMap(locationId) == mapId)

/**
 * Warcraft projection of the authoritative warfare, settlement and office state.
 * Stable records below are saveable campaign state. Unit handles live exclusively
 * in MilitarySettlementAdapter and may be discarded/rebuilt at any time.
 */
public constant int FORCE_ARMY = 1
public constant int FORCE_FLEET = 2
public constant int FORCE_GARRISON = 3
public constant int FORCE_CITY_CORE = 4
public constant int FORCE_DEFENSE = 5
public constant real CITY_CAPTURE_IMMUNITY_SECONDS = 5.
public constant int MILITARY_SETTLEMENT_SNAPSHOT_VERSION = 17

function militaryOrderAtom(string value) returns boolean
	return value != "" and value.indexOf(",") < 0 and value.indexOf("|") < 0 and value.indexOf(";") < 0 and value.indexOf("=") < 0

/** Temporary stable-ID index for bulk catalogue registration. Full keys keep
 * hash collisions distinct; positions still refer to the authority arrays. */
class MilitaryRegistrationIndex
	string array[4096] keys
	int array[4096] positions
	int array[4096] next
	int array[1024] buckets
	int count = 0
	function bucket(string key) returns int
		var result = StringHash(key) mod 1024
		if result < 0
			result += 1024
		return result
	function find(string key) returns int
		var entry = buckets[bucket(key)]
		while entry > 0
			if keys[entry - 1] == key
				return positions[entry - 1]
			entry = next[entry - 1]
		return -1
	function add(string key, int position)
		let slot = bucket(key)
		keys[count] = key
		positions[count] = position
		next[count] = buckets[slot]
		buckets[slot] = count + 1
		count++

/** One reusable cursor per parse. Read each field once and retain empty fields,
 * including the final optional conflict/attacker fields of a settlement.
 * Count excess fields too, so strict record validation still rejects them. */
class MilitarySnapshotRecord
	string array[26] fields
	int count = 0
	function append(string value)
		if count < 26
			fields[count] = value
		count++
	function read(string candidate, int start) returns int
		count = 0
		let length = StringLength(candidate)
		var fieldStart = start
		var finish = start
		while finish < length
			let delimiter = SubString(candidate, finish, finish + 1)
			if delimiter == "|"
				break
			if delimiter == ","
				append(SubString(candidate, fieldStart, finish))
				fieldStart = finish + 1
			finish++
		append(SubString(candidate, fieldStart, finish))
		return finish + 1
	function field(int index) returns string
		if index < 0 or index >= count or index >= 26
			return ""
		return fields[index]

/** Stable conflict identity survives settlement. Membership is immutable once
 * registered; a new war needs a new ID, even between the same governments. */
public class MilitaryConflict
	string id
	boolean settled = false
	string array[64] polities
	int array[64] sides
	int count = 0
	construct(string id)
		this.id = id
	function side(string polityId) returns int
		for i = 0 to count - 1
			if polities[i] == polityId
				return sides[i]
		return 0
	function opposes(string first, string second) returns boolean
		return first != second and side(first) > 0 and side(second) > 0 and side(first) != side(second)

public class RuntimeForce
	string id
	string controllerId
	string regionId
	string categoryId
	int kind
	int unitTypeId
	// Durable roster identity, not a saved bonus or an inferred weapon assignment.
	// Old forces with no metadata remain unknown and fail closed.
	NavalHull hull = new NavalHull()
	VoyageProgress navigation = new VoyageProgress()
	string combatProfileId = ""
	real nextFireAt = 0.
	boolean restoredFireClock = false
	int strength
	int maximumStrength
	int supply
	real x
	real y
	boolean active = true
	string recoveryMap = ""
	int recoveryClass = -1
	int recoveryComponent = 0
	real safeX = 0.
	real safeY = 0.
	string orderId = "hold"
	real orderX = 0.
	real orderY = 0.
	string orderTargetId = ""
	string orderControllerId
	construct(string id, string controllerId, string regionId, string categoryId, int kind, int unitTypeId, int strength, int supply, real x, real y)
		this.id = id
		this.controllerId = controllerId
		orderControllerId = controllerId
		this.regionId = regionId
		this.categoryId = categoryId
		this.kind = kind
		this.unitTypeId = unitTypeId
		this.strength = strength
		maximumStrength = strength
		this.supply = supply
		this.x = x
		this.y = y
	ondestroy
		destroy hull
		destroy navigation
	function mobileForce() returns boolean
		return kind == FORCE_ARMY or kind == FORCE_FLEET
	function cancelOrder()
		orderId = "stop"
		orderX = 0.
		orderY = 0.
		orderTargetId = ""
		orderControllerId = controllerId
	function validOrder() returns boolean
		if not militaryOrderAtom(orderControllerId) or not locationNumber(orderX.toString()) or not locationNumber(orderY.toString())
			return false
		if orderId == "attack"
			return mobileForce() and militaryOrderAtom(orderTargetId) and orderX == 0. and orderY == 0.
		if orderTargetId != ""
			return false
		if orderId == "move" or orderId == "patrol" or orderId == "attack-move"
			return mobileForce()
		return (orderId == "hold" or orderId == "stop") and orderX == 0. and orderY == 0.

public class TraditionState
	string controllerId
	string categoryId
	string experience = "0"
	TraditionDefinition definition = null
	int lifePermillePerHundredXp
	int milestoneXp
	int milestoneAbilityId
	construct(string controllerId, string categoryId, int rate, int milestoneXp, int milestoneAbilityId)
		this.controllerId = controllerId
		this.categoryId = categoryId
		lifePermillePerHundredXp = rate
		this.milestoneXp = milestoneXp
		this.milestoneAbilityId = milestoneAbilityId
	ondestroy
		if definition != null
			destroy definition

/** Immutable scenario weights. Only enemy_kill has a production outcome
 * adapter; retaining another source here does not make it awardable. */
public class TraditionContribution
	string id
	int numerator
	int denominator
	construct(string id, int numerator, int denominator)
		this.id = id
		this.numerator = numerator
		this.denominator = denominator
	/** Exact floor per contribution, including products above native precision. */
	function weighted(int amount) returns string
		if amount <= 0
			return "0"
		return exactNaturalScaleFloor(I2S(amount), numerator, denominator)

public interface MilitaryTraditionDefinitions
	function reconcile(MilitarySettlementRuntime runtime, boolean migrate) returns boolean

/** Scenario definitions reconcile presentation and seed missing legacy authority.
 * Implementations must never reset an existing mutable record. */
public interface SettlementDefinitions
	function reconcile(MilitarySettlementRuntime runtime, boolean migrate) returns boolean

public class SettlementRuntimeState
	string id
	string controllerId
	string legalOwnerId
	string occupationConflictId = ""
	string attackerId = ""
	string regionId
	int coreTypeId
	int defenderTypeId
	int garrisonStrength
	int garrisonMaximum
	int reserves
	int manpower
	int supply
	int waveSize
	real reinforcementInterval
	real quietPeriod
	real nextWaveAt
	real lastCombatAt
	real captureImmuneUntil
	real x
	real y
	boolean underAttack = false
	boolean projectMilitary = true
	boolean capturable = true
	string governanceExceptionId = ""
	construct(string id, string controllerId, string regionId, int coreTypeId, int defenderTypeId, int strength, int reserves, int manpower, int supply, real x, real y)
		this.id = id
		this.controllerId = controllerId
		legalOwnerId = controllerId
		this.regionId = regionId
		this.coreTypeId = coreTypeId
		this.defenderTypeId = defenderTypeId
		garrisonStrength = strength
		garrisonMaximum = strength
		this.reserves = reserves
		this.manpower = manpower
		this.supply = supply
		waveSize = 10
		reinforcementInterval = 10.
		quietPeriod = 20.
		this.x = x
		this.y = y

	function withPolicy(boolean projectMilitary, boolean capturable, string governanceExceptionId) returns SettlementRuntimeState
		this.projectMilitary = projectMilitary
		this.capturable = capturable
		this.governanceExceptionId = governanceExceptionId
		return this

	function withLegalOwner(string ownerId) returns SettlementRuntimeState
		legalOwnerId = ownerId
		return this

