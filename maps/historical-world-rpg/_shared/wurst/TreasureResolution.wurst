package TreasureResolution

import public TreasureRandom
import PhysicalInteraction

public function treasureHas(string ids, string id) returns boolean
	return id != "" and ids.indexOf("|" + id + "|") >= 0

public class TreasureChoices
	string array[64] ids
	int array[64] weights
	int count = 0
	function add(string id, int weight)
		ids[count] = id
		weights[count] = weight
		count++
	function accepts(string id) returns boolean
		if count == 0
			return id == ""
		for i = 0 to count - 1
			if ids[i] == id
				return true
		return false
	function choose(string seed, string namespace) returns string
		if count == 0
			return ""
		if count == 1
			return ids[0]
		var total = 0
		for i = 0 to count - 1
			total += weights[i]
		var pick = treasurePick(seed, namespace, total)
		for i = 0 to count - 1
			if pick < weights[i]
				return ids[i]
			pick -= weights[i]
		return ""

/** Stable authored restrictions plus the generated, validated physical binding.
 * Unavailable is an input to initial selection only; never move a committed
 * treasure because its region or Warcraft representation is inactive. */
public class TreasureCandidate
	string id
	string regionId
	string instanceId
	string mapId
	string terrainId
	string navigationId
	string family
	int weight = 1
	real clearance = 0.
	boolean accessible = false
	boolean shared = false
	boolean fallbackOnly = false
	boolean placementValid = false
	string inactivePolicy = ""
	real x = 0.
	real y = 0.
	construct(string id, string regionId, string instanceId, string mapId, string terrainId, string navigationId, string family)
		this.id = id
		this.regionId = regionId
		this.instanceId = instanceId
		this.mapId = mapId
		this.terrainId = terrainId
		this.navigationId = navigationId
		this.family = family
	function valid(InteractionCatalog locations) returns boolean
		if not placementValid or not accessible or clearance <= 0. or weight <= 0 or weight > 1000000 or locations == null or terrainId == "" or navigationId == "" or instanceId == ""
			return false
		if inactivePolicy != "resolve_and_defer_spawn" and inactivePolicy != "abstract_encounter"
			return false
		let target = locations.get(id)
		return target != null and target.kind == "treasure" and target.mapId == mapId and target.x == x and target.y == y and (target.movements[0] or target.movements[1] or target.movements[2] or target.movements[3])

public class TreasureDefinition
	string id
	boolean unique = false
	string anchorRegions = ""
	string families = ""
	string legacyLocationId = ""
	string fallbackId = ""
	int array[64] cluePrecisions
	TreasureCandidate array[64] candidates
	int count = 0
	TreasureChoices rewards = new TreasureChoices()
	TreasureChoices guards = new TreasureChoices()
	TreasureChoices hazards = new TreasureChoices()
	TreasureChoices encounters = new TreasureChoices()
	construct(string id)
		this.id = id
	ondestroy
		for i = 0 to count - 1
			destroy candidates[i]
		destroy rewards
		destroy guards
		destroy hazards
		destroy encounters
	function add(TreasureCandidate candidate)
		candidates[count] = candidate
		count++
	function get(string id) returns TreasureCandidate
		for i = 0 to count - 1
			if candidates[i].id == id
				return candidates[i]
		return null
	function valid(TreasureCandidate candidate, InteractionCatalog locations) returns boolean
		return candidate != null and candidate.valid(locations) and (not unique or (treasureHas(anchorRegions, candidate.regionId) and treasureHas(families, candidate.family)))
	function available(TreasureCandidate candidate, string unavailable, string occupied, InteractionCatalog locations) returns boolean
		return valid(candidate, locations) and not treasureHas(unavailable, candidate.id) and (candidate.shared or not treasureHas(occupied, candidate.id))
	function choose(string seed, string unavailable, string occupied, InteractionCatalog locations) returns TreasureCandidate
		var total = 0
		for i = 0 to count - 1
			if not candidates[i].fallbackOnly and available(candidates[i], unavailable, occupied, locations)
				total += candidates[i].weight
		if total == 0
			let fallback = get(fallbackId)
			if available(fallback, unavailable, occupied, locations)
				return fallback
			return null
		if total > 1000000
			return null
		var pick = treasurePick(seed, id + ":location", total)
		for i = 0 to count - 1
			let candidate = candidates[i]
			if not candidate.fallbackOnly and available(candidate, unavailable, occupied, locations)
				if pick < candidate.weight
					return candidate
				pick -= candidate.weight
		return null

public class TreasureResult
	string mode
	string candidateId
	string rewardId = ""
	string guardId = ""
	string hazardId = ""
	string encounterId = ""
	construct(string mode, string candidateId)
		this.mode = mode
		this.candidateId = candidateId
	function encode() returns string
		return mode + "," + candidateId + "," + rewardId + "," + guardId + "," + hazardId + "," + encounterId
	function valid(TreasureDefinition definition, InteractionCatalog locations) returns boolean
		if not definition.valid(definition.get(candidateId), locations)
			return false
		if mode == "legacy"
			return candidateId == definition.legacyLocationId and rewardId == "" and guardId == "" and hazardId == "" and encounterId == ""
		return mode == "seeded" and definition.rewards.accepts(rewardId) and definition.guards.accepts(guardId) and definition.hazards.accepts(hazardId) and definition.encounters.accepts(encounterId)
