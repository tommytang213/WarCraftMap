/** Physical identity is distinct from map tracking and remote command view.
 * Loads and transitions cannot authorize interactions while state is staged. */
public class CampaignInteractionMaps implements InteractionMaps
	PlayableCampaignState state
	construct(PlayableCampaignState state)
		this.state = state
	override function available() returns boolean
		return state.isSaveSafe() and state.identity != null and state.identity.hasOrigin()
	override function loadedMap() returns string
		return state.loadedPhysicalMap
	override function partyMap() returns string
		return state.identity.physicalMapId()

/** Stable-domain extensions participate in every campaign lifecycle without
 * making their Warcraft projections part of the save authority. */
public interface CampaignRuntimeExtension
	function newCampaign(string settlementId)
	/** Validation must not mutate live authority or invoke live callbacks. */
	function validate(string authorityDocument) returns boolean
	function beginLoad()
	function reconstruct(string authorityDocument) returns boolean
	/** Rollback uses a known-good checkpoint, independent of fallible reconstruction. */
	function rollbackLoad()
	function commitLoad()
	function capture() returns string

public constant real CAMPAIGN_AUTOSAVE_SECONDS = 300.
/** These values mirror the release-save manifest and are checked by the release gate. */
public constant int CAMPAIGN_SAVE_SCHEMA_CURRENT = 8
public constant int CAMPAIGN_SAVE_SCHEMA_OLDEST = 1
ReligionRuntime religionMigrationRuntime = null
public PiracyRuntime piracyMigrationRuntime = null

public function lastAuthorityValue(string document, string key) returns string
	let marker = ";" + key + "="
	var found = -1
	var search = 0
	while search < StringLength(document)
		let relative = SubString(document, search, StringLength(document)).indexOf(marker)
		if relative < 0
			search = StringLength(document)
		else
			found = search + relative + StringLength(marker)
			search = found
	if found < 0
		return ""
	let tail = SubString(document, found, StringLength(document))
	// Trade's supported encoding uses semicolons inside kind:id store IDs.
	// A domain boundary is ;key=, not an arbitrary semicolon in its value.
	var separator = tail.indexOf(";")
	while separator >= 0
		var cursor = separator + 1
		while cursor < StringLength(tail) and cursor <= separator + 32
			let character = SubString(tail, cursor, cursor + 1)
			if character == "="
				return SubString(tail, 0, separator)
			if character == ";" or character == "," or character == ":" or character == "|" or character == "~"
				break
			cursor++
		let following = SubString(tail, separator + 1, StringLength(tail)).indexOf(";")
		if following < 0
			return tail
		separator += following + 1
	return tail

function playerAuthorityValue(string document, string key) returns string
	let players = lastAuthorityValue(document, "players")
	let marker = key + ":"
	let position = players.indexOf(marker)
	if position < 0
		return ""
	let tail = SubString(players, position + StringLength(marker), StringLength(players))
	let finish = tail.indexOf(",")
	if finish < 0
		return tail
	return SubString(tail, 0, finish)

function withoutCountryAuthority(string document) returns string
	let cut = document.indexOf(";diplomacy=")
	if cut < 0
		return document
	return SubString(document, 0, cut)

/** Replaces the location tuple instead of accumulating stale transition keys
 * over repeated multi-hop travel. Other authoritative domains are untouched. */
function withoutTravelAuthority(string document) returns string
	let first = document.indexOf(";")
	if first < 0
		return document
	var result = SubString(document, 0, first)
	var remaining = SubString(document, first + 1, StringLength(document))
	while remaining != ""
		let separator = remaining.indexOf(";")
		var field = remaining
		if separator >= 0
			field = SubString(remaining, 0, separator)
			remaining = SubString(remaining, separator + 1, StringLength(remaining))
		else
			remaining = ""
		if not field.startsWith("map=") and not field.startsWith("region=") and not field.startsWith("boundary=") and not field.startsWith("position=") and not field.startsWith("transition=") and not field.startsWith("arrival=")
			result += ";" + field
	return result

/** Replace one field without leaving stale authority behind. */
public function replaceCampaignField(string document, string key, string value) returns string
	let marker = ";" + key + "="
	let fieldStart = document.indexOf(marker)
	if fieldStart < 0
		return document + marker + value
	let tail = SubString(document, fieldStart + StringLength(marker), StringLength(document))
	let finish = tail.indexOf(";")
	if finish < 0
		return SubString(document, 0, fieldStart) + marker + value
	return SubString(document, 0, fieldStart) + marker + value + SubString(tail, finish, StringLength(tail))

function withoutPartyLocations(string document) returns string
	let marker = ";partyLocations="
	let start = document.indexOf(marker)
	if start < 0
		return document
	let tail = SubString(document, start + StringLength(marker), StringLength(document))
	let finish = tail.indexOf(";")
	if finish < 0
		return SubString(document, 0, start)
	return SubString(document, 0, start) + SubString(tail, finish, StringLength(tail))

public interface CampaignPartyProjection
	/** Retain the previous objects until commit. Rollback must not respawn them
	 * through the projection operation that just reported failure. */
	function beginLoad(WarcraftRpgRuntime rpg)
	function rollbackLoad(WarcraftRpgRuntime rpg)
	function commitLoad(WarcraftRpgRuntime rpg)
	function present(WarcraftRpgRuntime rpg, int index) returns boolean
	function x(WarcraftRpgRuntime rpg, int index) returns real
	function y(WarcraftRpgRuntime rpg, int index) returns real
	function project(WarcraftRpgRuntime rpg, PartyLocationSet locations) returns boolean
	function clear(WarcraftRpgRuntime rpg)

public class WarcraftBoundaryPathing implements BoundaryPathing
	override function pathable(real x, real y, int movement) returns boolean
		let walkable = not compatIsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY)
		let floatable = not compatIsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY)
		if movement == 0
			return walkable
		if movement == 1
			return floatable
		return movement == 3 or (movement == 2 and (walkable or floatable))

public class WarcraftCampaignPartyProjection implements CampaignPartyProjection
	unit array[2048] previous
	override function beginLoad(WarcraftRpgRuntime rpg)
		// Keep old units (including position, orders and life) until commit.
		for i = 0 to rpg.heroes.count - 1
			previous[i] = rpg.heroes.projected[i]
			rpg.heroes.projected[i] = null
	override function rollbackLoad(WarcraftRpgRuntime rpg)
		rpg.heroes.loseRuntimeObjects()
		// Restore shared technology/guidance layers with the old units detached.
		// Their equipment was never changed; clearing/reapplying it could clamp
		// current life while temporarily reducing maximum life.
		rpg.reconcile("player")
		for i = 0 to rpg.heroes.count - 1
			rpg.heroes.projected[i] = previous[i]
			previous[i] = null
	override function commitLoad(WarcraftRpgRuntime rpg)
		for i = 0 to rpg.heroes.count - 1
			if previous[i] != null
				compatRemoveUnit(previous[i])
			previous[i] = null
	override function present(WarcraftRpgRuntime rpg, int index) returns boolean
		let target = rpg.heroes.projected[index]
		return target != null and GetUnitTypeId(target) != 0
	override function x(WarcraftRpgRuntime rpg, int index) returns real
		return GetUnitX(rpg.heroes.projected[index])
	override function y(WarcraftRpgRuntime rpg, int index) returns real
		return GetUnitY(rpg.heroes.projected[index])
	override function project(WarcraftRpgRuntime rpg, PartyLocationSet locations) returns boolean
		rpg.heroes.loseRuntimeObjects()
		for i = 0 to locations.count - 1
			let value = locations.entries[i]
			let index = rpg.heroes.indexOf(value.id)
			let target = compatCreateUnit(Player(0), rpg.heroes.heroes[index].unitTypeId, value.x, value.y, 0.)
			rpg.heroes.projected[index] = target
			if not present(rpg, index)
				return false
			// CreateUnit can nudge colliding spawns. These coordinates have already
			// passed topology/native validation, so restore the recorded point.
			compatSetUnitCoordinates(target, value.x, value.y)
		rpg.reconcile("player")
		return locations.count > 0 and rpg.heroes.activeCount() == locations.count
	override function clear(WarcraftRpgRuntime rpg)
		rpg.heroes.loseRuntimeObjects()

/**
 * The compact runtime authority uses stable IDs only. Domain payloads are supplied by the
 * gameplay systems (quests, settlements, inventory, fleets, orders and discovery); Warcraft
 * handles and UI state never enter this document.
 */
public class PlayableCampaignState implements CampaignStatePort
	string authority = "v2;map=world-map;region=" + scenarioRegionId(0) + ";boundary=;position=0.5;world=;players=;quests=;discovery=;orders=;trade=;diplomacy=v1;rewards=v1;rpg=v1;militarySettlements=v1;religion=v1;piracy=v1"
	string staged = ""
	boolean startupLocked = false
	boolean loading = false
	CampaignLoadCheckpoint checkpoint = null
	CampaignPartyProjection party = null
	PartyNavigation partyNavigation = null
	string committedLocations = "v1"
	PlayerCampaignIdentity identity = null
	string loadedPhysicalMap = ""
	OriginCatalog origins = null
	BoundaryCorrespondence array[64] boundaries
	int boundaryCount = 0
	boolean boundaryConfigurationComplete = false
	BoundaryPathing arrivalPathing = new WarcraftBoundaryPathing()
	boolean transitionOpen = false
	string lastDiagnostic = ""
	WarcraftRegionalAdapter regional
	CampaignClock clock
	CampaignAutosaveScheduler autosaves = null
	CampaignRuntimeExtension extension = null
	PlayableCountryInteractionRuntime countries = null
	WarcraftRpgRuntime rpg = null
	MilitarySettlementRuntime militarySettlements = null
	ReligionRuntime religion = null
	PiracyRuntime piracy = null
	construct(WarcraftRegionalAdapter regional, CampaignClock clock)
		this.regional = regional
		this.clock = clock
	function addBoundary(BoundaryCorrespondence value)
		boundaries[boundaryCount] = value
		boundaryCount++
	function boundary(string id) returns BoundaryCorrespondence
		for i = 0 to boundaryCount - 1
			if boundaries[i].id == id
				return boundaries[i]
		return null
	function resolveTransfer(string candidate) returns BoundaryCorrespondence
		let route = boundary(lastAuthorityValue(candidate, "boundary"))
		let position = parseBoundaryPosition(lastAuthorityValue(candidate, "position"))
		if route == null or not route.valid() or route.destinationMapId != lastAuthorityValue(candidate, "map") or route.destinationRegionId != lastAuthorityValue(candidate, "region") or (loadedPhysicalMap != "" and route.destinationMapId != loadedPhysicalMap) or not validBoundaryPosition(position)
			lastDiagnostic = "invalid saved boundary, destination map or correspondence"
			return null
		// Older supported saves need only boundary/position. Where redundant
		// travel fields exist, they must agree. Position is ALREADY transformed.
		let transition = lastAuthorityValue(candidate, "transition")
		let arrival = lastAuthorityValue(candidate, "arrival")
		if (transition != "" and transition != route.id) or (arrival != "" and parseBoundaryPosition(arrival) != position)
			lastDiagnostic = "inconsistent saved boundary correspondence"
			return null
		// The current party projection reconstructs land heroes. A sea-only
		// edge cannot silently disembark them at a distant settlement.
		if arrivalPathing == null or not route.destination.resolve(position, 0, arrivalPathing)
			lastDiagnostic = "no connected party arrival within boundary tolerance"
			return null
		return route
	function replaceAuthority(string value)
		authority = value
	function setExtension(CampaignRuntimeExtension value)
		extension = value
	function setCountryRuntime(PlayableCountryInteractionRuntime runtime)
		countries = runtime
		countries.setMilitaryAuthority(militarySettlements)
	function setRpgRuntime(WarcraftRpgRuntime runtime)
		rpg = runtime
		// The same clock is restored transactionally by campaign save/load.
		rpg.heroes.clock = clock
	function setMilitarySettlementRuntime(MilitarySettlementRuntime runtime)
		militarySettlements = runtime
		if countries != null
			countries.setMilitaryAuthority(runtime)
	function setReligionRuntime(ReligionRuntime runtime)
		religion = runtime
	function setPiracyRuntime(PiracyRuntime runtime)
		piracy = runtime
	function authorityDocument() returns string
		return authority
	function beginTransition()
		transitionOpen = true
	function finishTransition()
		transitionOpen = false
	function cancelTransition()
		transitionOpen = false
	override function isSaveSafe() returns boolean
		return not transitionOpen and not startupLocked and not loading and not clock.advancing
	override function captureAuthoritativeState() returns string
		return captureDomains(authority, true)
	function captureStagedAuthoritativeState() returns string
		return captureDomains(staged, false)
	function captureDomains(string document, boolean includeIdentity) returns string
		if clock.advancing
			return ""
		// Emit this domain in a canonical position even when activation retained
		// it before the lazily captured country/RPG domains.
		var result = withoutPartyLocations(document)
		if includeIdentity and identity != null and identity.hasOrigin()
			result = replaceCampaignField(result, "players", "origin:" + identity.originId() + ",allegiance:" + identity.allegianceId() + ",settlement:" + identity.settlementId())
		if countries != null
			result = withoutCountryAuthority(result) + ";diplomacy=" + countries.captureState() + ";rewards=" + countries.captureState()
		if rpg != null
			result += ";rpg=" + rpg.captureState()
		if militarySettlements != null
			result += ";militarySettlements=" + militarySettlements.snapshot()
		if religion != null
			result += ";religion=" + religion.captureState()
		if piracy != null
			result += ";piracy=" + piracy.captureAuthority()
		if extension != null
			result += ";trade=" + extension.capture()
		var locations = "v1"
		// A source map cannot sample coordinates for the destination checkpoint.
		if pendingPartyArrival(lastAuthorityValue(document, "partyLocations")) and lastAuthorityValue(document, "map") != loadedPhysicalMap
			locations = lastAuthorityValue(document, "partyLocations")
		else if party != null and rpg != null
			locations = capturePartyLocations(document)
			if locations == ""
				return ""
		result = replaceCampaignField(result, "partyLocations", locations)
		var schedulerState = lastAuthorityValue(document, "autosave")
		if includeIdentity and autosaves != null
			schedulerState = autosaves.captureState()
		else if schedulerState == ""
			schedulerState = autosaveMetadata(1, CAMPAIGN_AUTOSAVE_SECONDS)
		result = replaceCampaignField(result, "autosave", schedulerState)
		return replaceCampaignField(result, "clock", clock.captureState())
	function localHero(RpgHero hero, string regionId) returns boolean
		return fieldHeroAt(hero, loadedPhysicalMap, regionId)
	function fieldHeroAt(RpgHero hero, string mapId, string regionId) returns boolean
		return hero.recruited and hero.assignment == "field" and not hero.incapacitated and (hero.regionId == "" or hero.regionId == mapId or hero.regionId == regionId)
	function capturePartyLocations(string document) returns string
		let previous = parsePartyLocations(committedLocations)
		let captured = new PartyLocationSet()
		var valid = previous != null and partyNavigation != null and arrivalPathing != null
		for i = 0 to rpg.heroes.count - 1
			let hero = rpg.heroes.heroes[i]
			if localHero(hero, lastAuthorityValue(document, "region"))
				PartyLocation old = null
				if previous != null
					old = previous.get(hero.id)
				if party.present(rpg, i) and partyNavigation != null and arrivalPathing != null
					let x = party.x(rpg, i)
					let y = party.y(rpg, i)
					let component = partyNavigation.componentAt(x, y)
					var safeX = x
					var safeY = y
					if not arrivalPathing.pathable(x, y, 0)
						if old == null or old.mapId != loadedPhysicalMap or old.component != component
							valid = false
						else
							safeX = old.safeX
							safeY = old.safeY
					let value = new PartyLocation(hero.id, loadedPhysicalMap, x, y, component, safeX, safeY)
					valid = partyNavigation.accepts(value) and valid
					captured.add(value)
				else if old != null
					// Representation loss cannot erase the last committed location.
					captured.add(new PartyLocation(old.id, old.mapId, old.x, old.y, old.component, old.safeX, old.safeY))
		var result = ""
		if valid and captured.count > 0 and captured.count <= rpg.heroes.activeLimit
			result = captured.encode()
			committedLocations = result
		else
			lastDiagnostic = "local party positions could not be captured safely"
		if previous != null
			destroy previous
		destroy captured
		return result
	override function validateAuthoritativeState(string candidate) returns boolean
		if loading
			lastDiagnostic = "campaign reconstruction is already in progress"
			return false
		staged = ""
		if lastAuthorityValue(candidate, "boundary") == "" and (lastAuthorityValue(candidate, "transition") != "" or lastAuthorityValue(candidate, "arrival") != "")
			lastDiagnostic = "saved transfer is missing its boundary"
			return false
		let locations = lastAuthorityValue(candidate, "partyLocations")
		if party != null and locations == "arrival"
			lastDiagnostic = "pending arrival is missing its traveling party"
			return false
		if pendingPartyArrival(locations) and lastAuthorityValue(candidate, "boundary") == ""
			lastDiagnostic = "pending arrival has no boundary"
			return false
		if (pendingPartyArrival(locations) or locations == "legacy") and lastAuthorityValue(candidate, "boundary") != "" and resolveTransfer(candidate) == null
			return false
		if locations != "arrival" and locations != "legacy"
			var encoded = locations
			if pendingPartyArrival(locations)
				encoded = "v1" + SubString(locations, 7, StringLength(locations))
			let parsed = parsePartyLocations(encoded)
			if parsed == null
				lastDiagnostic = "invalid party location records"
				return false
			var valid = true
			for i = 0 to parsed.count - 1
				let value = parsed.entries[i]
				if rpg == null or rpg.heroes.get(value.id) == null
					valid = false
				else if pendingPartyArrival(locations)
					if value.mapId != boundary(lastAuthorityValue(candidate, "boundary")).sourceMapId
						valid = false
				else if partyNavigation == null or not partyNavigation.accepts(value) or value.mapId != loadedPhysicalMap
					valid = false
			destroy parsed
			if not valid
				lastDiagnostic = "saved party location has unknown identity, map or navigation component"
				return false
		if not clock.validateState(lastAuthorityValue(candidate, "clock"))
			lastDiagnostic = clock.diagnostic()
			return false
		if not validCampaignAutosave(candidate)
			lastDiagnostic = "invalid autosave scheduler authority"
			return false
		if loadedPhysicalMap != "" and (lastAuthorityValue(candidate, "map") != loadedPhysicalMap or playerAuthorityValue(candidate, "origin") == "")
			lastDiagnostic = "checkpoint does not belong to the loaded physical map or has no player identity"
			return false
		if origins != null and origins.find(playerAuthorityValue(candidate, "origin")) == null
			lastDiagnostic = "checkpoint player origin is not an authored campaign origin"
			return false
		if (not candidate.startsWith("v2;") and not candidate.startsWith("v1;")) or candidate.indexOf(";map=") < 0 or candidate.indexOf(";region=") < 0 or candidate.indexOf(";world=") < 0 or candidate.indexOf(";players=") < 0 or candidate.indexOf(";quests=") < 0 or candidate.indexOf(";discovery=") < 0 or candidate.indexOf(";orders=") < 0 or candidate.indexOf(";diplomacy=") < 0 or candidate.indexOf(";rewards=") < 0 or candidate.indexOf(";trade=") < 0 or (rpg != null and candidate.indexOf(";rpg=") < 0)
			lastDiagnostic = "missing or incompatible authoritative campaign domains"
			return false
		if rpg != null and not rpg.validateState(lastAuthorityValue(candidate,"rpg"))
			lastDiagnostic=rpg.diagnostic()
			return false
		if militarySettlements != null and candidate.indexOf(";militarySettlements=") < 0
			lastDiagnostic = "missing military/settlement authority"
			return false
		if religion != null and candidate.indexOf(";religion=") < 0
			lastDiagnostic = "missing religion authority"
			return false
		if piracy != null and candidate.indexOf(";piracy=") < 0
			lastDiagnostic = "missing piracy authority"
			return false
		if militarySettlements != null and not militarySettlements.validateSnapshot(lastAuthorityValue(candidate, "militarySettlements"))
			lastDiagnostic = "military/settlement authority is invalid"
			return false
		if piracy != null and not piracy.validateAuthority(lastAuthorityValue(candidate,"piracy"))
			lastDiagnostic=piracy.lastDiagnostic
			return false
		if religion != null and not religion.validateState(lastAuthorityValue(candidate, "religion"))
			lastDiagnostic = religion.lastDiagnostic
			return false
		var foundedPolity = ""
		if piracy != null and piracy.stagedRestore != null and piracy.stagedRestore.polity != null
			foundedPolity = piracy.stagedRestore.polity.id
			if piracy.polityAuthority == null or not piracy.polityAuthority.validateReconciliation(piracy.stagedRestore.polity, lastAuthorityValue(candidate, "militarySettlements"))
				lastDiagnostic = "ordinary campaign authorities rejected staged pirate-polity reconciliation"
				return false
		if countries != null
			var warfare = militarySettlements
			if warfare != null
				warfare = militarySettlements.parseSnapshot(lastAuthorityValue(candidate, "militarySettlements"))
			let valid = countries.validateState(lastAuthorityValue(candidate, "diplomacy"), warfare, foundedPolity) and countries.validateState(lastAuthorityValue(candidate, "rewards"), warfare, foundedPolity)
			if warfare != null
				warfare.dispose()
			if not valid
				lastDiagnostic = countries.diagnostic()
				return false
		if extension != null and not extension.validate(lastAuthorityValue(candidate, "trade"))
			lastDiagnostic = "trade authority is invalid"
			return false
		staged = candidate
		lastDiagnostic = ""
		return true
	override function reconstructRuntime(string candidate) returns boolean
		if loading
			lastDiagnostic = "campaign reconstruction is already in progress"
			return false
		// Direct reconstruction consumers get the same validation/rollback boundary.
		if staged != candidate and not validateAuthoritativeState(candidate)
			return false
		loading = true
		checkpoint = new CampaignLoadCheckpoint(this)
		if militarySettlements != null
			militarySettlements.suspendCallbacks()
		if party != null and rpg != null
			if rpg.projections != null
				rpg.projections.beginPartyLoad()
			party.beginLoad(rpg)
		if extension != null
			extension.beginLoad()
		if militarySettlements != null
			militarySettlements.adapter.beginLoad()
		if not applyRuntime(candidate)
			rollbackRuntime()
			return false
		// Keep old authority and native objects until the caller commits. Startup
		// retains this checkpoint through its recoverable handoff writes.
		return true
	override function rollbackRuntime()
		if checkpoint == null
			return
		let failure = lastDiagnostic
		let restored = checkpoint.restore(this)
		if extension != null
			extension.rollbackLoad()
		if militarySettlements != null
			militarySettlements.adapter.rollbackLoad()
		if party != null and rpg != null
			party.rollbackLoad(rpg)
			if rpg.projections != null
				rpg.projections.rollbackPartyLoad()
		else if rpg != null
			rpg.reconcile("player")
		staged = ""
		loading = not restored
		lastDiagnostic = failure
		if not restored
			lastDiagnostic += "; campaign rollback failed; saving remains locked"
		destroy checkpoint
		checkpoint = null
		if restored and militarySettlements != null
			militarySettlements.resumeCallbacks()
	function applyRuntime(string candidate) returns boolean
		// Date-sensitive reconstruction must see the checkpoint's time, including
		// on manual loads after this map's clock has already advanced.
		if not clock.restoreState(lastAuthorityValue(candidate, "clock"))
			lastDiagnostic = clock.diagnostic()
			return false
		// Stable representation definitions already contain the authoritative coordinates.
		// Missing Warcraft objects are recreated; unrelated regions remain abstract.
		if rpg != null and not rpg.restoreState(lastAuthorityValue(candidate,"rpg"))
			lastDiagnostic=rpg.diagnostic()
			return false
		if militarySettlements != null and not militarySettlements.restore(lastAuthorityValue(candidate, "militarySettlements"))
			lastDiagnostic = "military/settlement reconstruction failed"
			return false
		if religion != null and not religion.restoreState(lastAuthorityValue(candidate, "religion"))
			lastDiagnostic = religion.lastDiagnostic
			return false
		if piracy != null and not piracy.restoreAuthority(lastAuthorityValue(candidate,"piracy"))
			lastDiagnostic=piracy.lastDiagnostic
			return false
		// Founded polities must exist before their saved treasury, standing and
		// diplomacy are restored; reconciliation must not overwrite those values.
		if countries != null and not countries.restoreState(lastAuthorityValue(candidate, "diplomacy"))
			lastDiagnostic = countries.diagnostic()
			return false
		if extension != null and not extension.reconstruct(lastAuthorityValue(candidate, "trade"))
			lastDiagnostic = "trade runtime reconstruction failed"
			return false
		if party != null and lastAuthorityValue(candidate, "rpg") == "v1" and not rpg.prepareNewCampaign()
			lastDiagnostic = "legacy player could not be reconstructed"
			return false
		if party != null and not projectParty(candidate)
			if lastDiagnostic == ""
				lastDiagnostic = "local player representation could not be created"
			return false
		return true
	function projectParty(string candidate) returns boolean
		if rpg == null or militarySettlements == null or party == null
			return false
		let saved = lastAuthorityValue(candidate, "partyLocations")
		var locations = parsePartyLocations(saved)
		if saved == "" or saved == "legacy" or pendingPartyArrival(saved)
			// Only a new campaign, migrated coordinate-less save or pending
			// transfer may use an anchor. Ordinary movement never replays it.
			var x = 0.
			var y = 0.
			var sourceMapId = ""
			if lastAuthorityValue(candidate, "boundary") != ""
				let route = resolveTransfer(candidate)
				if route == null
					return false
				x = route.destination.x
				y = route.destination.y
				sourceMapId = route.sourceMapId
			else
				OriginDefinition origin = null
				if origins != null
					origin = origins.find(playerAuthorityValue(candidate, "origin"))
				if origin != null and origin.physicalMapId == loadedPhysicalMap and origin.settlementId == playerAuthorityValue(candidate, "settlement")
					x = origin.x
					y = origin.y
				else
					let found = militarySettlements.settlementIndex(playerAuthorityValue(candidate, "settlement"))
					if found < 0 or militarySettlements.settlements[found].regionId != loadedPhysicalMap
						return false
					x = militarySettlements.settlements[found].x
					y = militarySettlements.settlements[found].y
			if partyNavigation == null
				return false
			locations = new PartyLocationSet()
			PartyLocationSet travelers = null
			if saved.startsWith("arrival|")
				travelers = parsePartyLocations("v1" + SubString(saved, 7, StringLength(saved)))
				if travelers == null
					destroy locations
					return false
				// Check the restored source assignments before rebinding travelers.
				// An arrival record cannot enroll an abstract remote field member.
				for i = 0 to travelers.count - 1
					let value = travelers.entries[i]
					let hero = rpg.heroes.get(value.id)
					if value.mapId != sourceMapId or hero == null or not fieldHeroAt(hero, sourceMapId, scenarioLogicalRegion(sourceMapId))
						lastDiagnostic = "pending arrival contains a nonlocal traveler"
						destroy travelers
						destroy locations
						return false
			for i = 0 to rpg.heroes.count - 1
				let hero = rpg.heroes.heroes[i]
				// Coordinate-less saves used reconstructField: every eligible field
				// member (up to capacity) was local, regardless of the authored home
				// region left in its RPG row. Preserve that deterministic legacy
				// membership; governor/reserve/recovering assignments stay abstract.
				if saved == "legacy" and hero.recruited and hero.assignment == "field" and not hero.incapacitated and locations.count < rpg.heroes.activeLimit
					hero.regionId = ""
				if travelers != null and travelers.get(hero.id) != null and hero.regionId != ""
					hero.regionId = loadedPhysicalMap
				if localHero(hero, lastAuthorityValue(candidate, "region")) and locations.count < rpg.heroes.activeLimit
					if travelers == null or travelers.get(hero.id) != null
						locations.add(new PartyLocation(hero.id, loadedPhysicalMap, x, y, partyNavigation.componentAt(x, y), x, y))
			if travelers != null
				let travelersValid = travelers.count == locations.count
				destroy travelers
				if not travelersValid
					destroy locations
					return false
		if locations == null
			return false
		var valid = locations.count > 0 and locations.count <= rpg.heroes.activeLimit and partyNavigation != null
		for i = 0 to locations.count - 1
			let value = locations.entries[i]
			let hero = rpg.heroes.get(value.id)
			if hero == null or not localHero(hero, lastAuthorityValue(candidate, "region")) or partyNavigation == null or not partyNavigation.resolve(value, arrivalPathing)
				valid = false
		if valid
			valid = party.project(rpg, locations)
		if valid
			committedLocations = locations.encode()
		else
			lastDiagnostic = "local party location or reconstruction is unavailable"
		destroy locations
		return valid
	override function activateAuthoritativeState(string candidate)
		if checkpoint == null or staged != candidate
			return
		if extension != null
			extension.commitLoad()
		if party != null and rpg != null
			party.commitLoad(rpg)
			if rpg.projections != null
				rpg.projections.commitPartyLoad()
		if militarySettlements != null
			militarySettlements.adapter.commitLoad()
		destroy checkpoint
		checkpoint = null
		regional.recoverActiveRegion()
		if countries != null
			authority = withoutCountryAuthority(staged)
		else
			authority = staged
		if party != null
			authority = replaceCampaignField(authority, "partyLocations", committedLocations)
		// No fallible reconstruction remains. Rejected or staged loads never
		// mutate scheduler authority or disturb its pending request/timer.
		if autosaves != null
			autosaves.restoreState(lastAuthorityValue(staged, "autosave"))
		staged = ""
		clock.reconstructTimer()
		// UI ownership is transient. Only a committed load retires the old RPG
		// view; rejected/staged loads retain its token and close command.
		if rpg != null
			rpg.management.close()
		loading = false
		if militarySettlements != null
			militarySettlements.resumeCallbacks()
	override function diagnostic() returns string
		return lastDiagnostic

/** Internal rollback checkpoint, never a persisted save format. Callback-owned
 * mutations are restored directly; rollback never reruns polity callbacks. */
class CampaignLoadCheckpoint
	string clockState
	string rpgState = ""
	string militaryState = ""
	string religionState = ""
	string countryState = ""
	int polityCount = 0
	int nextOffer = 1
	PiracySnapshot piracyState = null
	PlayerCampaignIdentity identityState = null
	string partyLocations
	construct(PlayableCampaignState state)
		partyLocations = state.committedLocations
		clockState = state.clock.captureState()
		if state.rpg != null
			rpgState = state.rpg.captureState()
		if state.militarySettlements != null
			militaryState = state.militarySettlements.snapshot()
		if state.religion != null
			religionState = state.religion.captureState()
		if state.countries != null
			countryState = state.countries.captureState()
			polityCount = state.countries.polityCount
			nextOffer = state.countries.nextOffer
		if state.piracy != null
			piracyState = new PiracySnapshot(state.piracy)
		if state.identity != null
			let i = state.identity
			identityState = new PlayerCampaignIdentity()
			identityState.restore(i.originId(), i.allegianceId(), i.physicalMapId(), i.regionalInstanceId(), i.settlementId())
	function restore(PlayableCampaignState state) returns boolean
		state.committedLocations = partyLocations
		// Restore time before date-sensitive domain effects, retaining the timer.
		var restored = state.clock.restoreState(clockState)
		// Do not short-circuit: every domain must roll back even if one reports failure.
		if state.rpg != null
			restored = state.rpg.restoreState(rpgState) and restored
		if state.militarySettlements != null
			restored = state.militarySettlements.restore(militaryState, false) and restored
		if state.religion != null
			restored = state.religion.restoreState(religionState) and restored
		if state.piracy != null
			piracyState.applyTo(state.piracy)
			state.piracy.stagedRestore = null
		if state.countries != null
			// A candidate may have registered a new ordinary pirate polity.
			state.countries.polityCount = polityCount
			restored = state.countries.restoreState(countryState) and restored
			state.countries.nextOffer = nextOffer
		if state.identity != null
			let i = identityState
			state.identity.restore(i.originId(), i.allegianceId(), i.physicalMapId(), i.regionalInstanceId(), i.settlementId())
		return restored
	ondestroy
		if piracyState != null
			destroy piracyState
		if identityState != null
			destroy identityState

function runtimeChecksum(string value) returns int
	var result = 5381
	for i = 0 to StringLength(value) - 1
		result = ModuloInteger(result * 33 + StringHash(SubString(value, i, i + 1)), 2147483000)
	return result

/** Test fixtures use the same envelope constructor as production encoding. */
public function campaignSaveEnvelope(int schema, string slotId, int slotKind, int slotIndex, string createdAt, string authoritativeState) returns string
	let body = "schema=" + schema.toString() + "|slot=" + slotId + "|kind=" + slotKind.toString() + "|index=" + slotIndex.toString() + "|created=" + createdAt + "|state=" + authoritativeState
	return "integrity=" + runtimeChecksum(body).toString() + "|" + body

function validCampaignAutosave(string document) returns boolean
	let marker = ";autosave="
	let first = document.indexOf(marker)
	return first >= 0 and SubString(document, first + StringLength(marker), StringLength(document)).indexOf(marker) < 0 and validAutosaveMetadata(lastAuthorityValue(document, "autosave"))

/** Versioned envelope with slot binding and integrity metadata. Failed loads return no candidate. */
public class PlayableCampaignCodec implements CampaignSaveCodec
	string lastDiagnostic = ""
	CampaignClock clock
	string initialClock
	string initialMilitary = ""
	string initialReligion = ""
	string initialPiracy = ""
	construct(CampaignClock clock)
		this.clock = clock
		initialClock = clock.initialState()
	function validateClock(string document) returns boolean
		let marker = ";clock="
		let first = document.indexOf(marker)
		if first < 0 or SubString(document, first + StringLength(marker), StringLength(document)).indexOf(marker) >= 0 or not clock.validateState(lastAuthorityValue(document, "clock"))
			lastDiagnostic = "save has missing, duplicate or invalid campaign clock authority"
			return false
		return true
	function validateLocations(string document) returns boolean
		let marker = ";partyLocations="
		let first = document.indexOf(marker)
		if first < 0 or SubString(document, first + StringLength(marker), StringLength(document)).indexOf(marker) >= 0
			lastDiagnostic = "save has missing or duplicate party location authority"
			return false
		let value = lastAuthorityValue(document, "partyLocations")
		if value == "legacy" or value == "arrival"
			return true
		var encoded = value
		if pendingPartyArrival(value)
			encoded = "v1" + SubString(value, 7, StringLength(value))
		let parsed = parsePartyLocations(encoded)
		if parsed == null
			lastDiagnostic = "save has invalid party location authority"
			return false
		destroy parsed
		return true
	function configureMigrationDefaults(MilitarySettlementRuntime military, ReligionRuntime religion, PiracyRuntime piracy)
		initialMilitary = military.snapshot()
		initialReligion = religion.captureState()
		initialPiracy = piracy.migrationAuthority()
	override function encode(string slotId, int slotKind, int slotIndex, string createdAt, string authoritativeState) returns string
		if not validCampaignAutosave(authoritativeState)
			lastDiagnostic = "save has missing, duplicate or invalid autosave scheduler authority"
			return ""
		if not validateClock(authoritativeState) or not validateLocations(authoritativeState)
			return ""
		return campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT, slotId, slotKind, slotIndex, createdAt, authoritativeState)
	override function decodeMigrateAndValidate(string payload, string expectedSlotId) returns string
		let marker = "|schema="
		let cut = payload.indexOf(marker)
		if not payload.startsWith("integrity=") or cut < 0
			lastDiagnostic = "save envelope is malformed"
			return ""
		let expected = campaignSlotNumber(SubString(payload, 10, cut))
		let body = SubString(payload, cut + 1, StringLength(payload))
		if expected.toString() != SubString(payload, 10, cut) or runtimeChecksum(body) != expected
			lastDiagnostic = "save integrity check failed"
			return ""
		let schemaCut = body.indexOf("|slot=")
		if not body.startsWith("schema=") or schemaCut < 0
			lastDiagnostic = "save envelope is malformed"
			return ""
		let sourceSchema = campaignSlotNumber(SubString(body, 7, schemaCut))
		let slotPrefix = "schema=" + sourceSchema.toString() + "|slot=" + expectedSlotId + "|"
		if sourceSchema < CAMPAIGN_SAVE_SCHEMA_OLDEST or sourceSchema > CAMPAIGN_SAVE_SCHEMA_CURRENT or body.indexOf(slotPrefix) != 0
			lastDiagnostic = "save schema or slot is incompatible"
			return ""
		let stateMarker = "|state="
		let stateCut = body.indexOf(stateMarker)
		if stateCut < 0
			lastDiagnostic = "save has no authoritative state"
			return ""
		// Bind all slot metadata, not only its text ID. Startup's private bound
		// checkpoint has always used the session kind and index zero.
		let metadata = SubString(body, StringLength(slotPrefix), stateCut)
		let indexCut = metadata.indexOf("|index=")
		let createdCut = metadata.indexOf("|created=")
		if not metadata.startsWith("kind=") or indexCut < 6 or createdCut <= indexCut + 7
			lastDiagnostic = "save slot metadata is malformed"
			return ""
		let kindText = SubString(metadata, 5, indexCut)
		let indexText = SubString(metadata, indexCut + 7, createdCut)
		let kind = campaignSlotNumber(kindText)
		let index = campaignSlotNumber(indexText)
		let created = SubString(metadata, createdCut + 9, StringLength(metadata))
		let publicSlot = expectedSlotId.startsWith("manual_") or expectedSlotId.startsWith("autosave_") or expectedSlotId == "session_start" or expectedSlotId == "major_milestone"
		if kind.toString() != kindText or index.toString() != indexText or created.indexOf("|") >= 0 or (publicSlot and campaignSlotId(kind, index) != expectedSlotId) or (expectedSlotId.startsWith(HANDOFF_CHECKPOINT) and (kind != SAVE_SLOT_SESSION_START or index != 0))
			lastDiagnostic = "save slot metadata is incompatible"
			return ""
		var decoded = SubString(body, stateCut + StringLength(stateMarker), StringLength(body))
		// Each probe is additive and guarded, making repeated in-memory migration idempotent.
		// Schema 2 introduced diplomacy and contribution rewards.
		if sourceSchema < 2 and decoded.indexOf(";diplomacy=") < 0
			decoded += ";diplomacy=v1"
		if sourceSchema < 2 and decoded.indexOf(";rewards=") < 0
			decoded += ";rewards=v1"
		if decoded.startsWith("v0;") or decoded.startsWith("v1;")
			decoded = "v2;" + SubString(decoded,3,StringLength(decoded))
		// Schema 3 introduced RPG character and inventory authority.
		if sourceSchema < 3 and decoded.indexOf(";rpg=") < 0
			decoded += ";rpg=v1"
		// Schema 4 introduced military/settlement and religion authority.
		if sourceSchema < 4 and decoded.indexOf(";militarySettlements=") < 0
			if initialMilitary != ""
				decoded += ";militarySettlements=" + initialMilitary
			else
				decoded += ";militarySettlements=" + militarySettlementRuntime.snapshot()
		if sourceSchema < 4 and decoded.indexOf(";religion=") < 0
			if initialReligion != ""
				decoded += ";religion=" + initialReligion
			else if religionMigrationRuntime != null
				decoded += ";religion=" + religionMigrationRuntime.captureState()
		// Schema 5 introduced piracy. Migration uses a pristine configured authority.
		if sourceSchema < 5 and decoded.indexOf(";piracy=") < 0
			if initialPiracy != ""
				decoded += ";piracy=" + initialPiracy
			else if piracyMigrationRuntime != null
				decoded += ";piracy=" + piracyMigrationRuntime.migrationAuthority()
		// Schema 6 persists the live clock. Earlier formats discarded time, so
		// restore the configured initial day, zero fraction/cursor and speed 1.
		// Preserve any explicitly carried clock record, validating it below.
		if sourceSchema < 6 and decoded.indexOf(";clock=") < 0
			decoded += ";clock=" + initialClock
		// Schema 7 separates current coordinates from unconsumed arrival intent.
		// Older saves cannot recover discarded movement: use their old anchor
		// exactly once, then capture stable member positions after reconstruction.
		if sourceSchema < 7 and decoded.indexOf(";partyLocations=") < 0
			decoded += ";partyLocations=legacy"
		// Schema 8 carries the live rotation/delay. Omitted historical state
		// deterministically starts at slot 1/full configured interval, never at
		// the current running scheduler. Explicit v0 uses last-completed slot.
		if sourceSchema < 8 and decoded.indexOf(";autosave=") < 0
			decoded += ";autosave=" + autosaveMetadata(1, CAMPAIGN_AUTOSAVE_SECONDS)
		// All supported schemas carry identity, travel, quests, discovery, orders and trade.
		if decoded.indexOf(";world=") < 0 or decoded.indexOf(";players=") < 0 or decoded.indexOf(";map=") < 0 or decoded.indexOf(";region=") < 0 or decoded.indexOf(";quests=") < 0 or decoded.indexOf(";discovery=") < 0 or decoded.indexOf(";orders=") < 0 or decoded.indexOf(";trade=") < 0 or decoded.indexOf(";diplomacy=") < 0 or decoded.indexOf(";rewards=") < 0 or decoded.indexOf(";rpg=") < 0 or decoded.indexOf(";militarySettlements=") < 0 or decoded.indexOf(";religion=") < 0 or decoded.indexOf(";piracy=") < 0
			lastDiagnostic = "save is missing authority required by its schema"
			return ""
		if not validateClock(decoded) or not validateLocations(decoded)
			return ""
		if not validCampaignAutosave(decoded)
			lastDiagnostic = "save has missing, duplicate or invalid autosave scheduler authority"
			return ""
		let schedulerState = lastAuthorityValue(decoded, "autosave")
		decoded = replaceCampaignField(decoded, "autosave", autosaveMetadata(autosaveMetadataSlot(schedulerState), autosaveMetadataRemaining(schedulerState)))
		lastDiagnostic = ""
		return decoded
	override function diagnostic() returns string
		return lastDiagnostic

public class BoundaryCorrespondence
	string id
	string sourceMapId
	string destinationMapId
	string destinationPath
	string destinationRegionId
	boolean reverse
	real scale
	real offset
	BoundaryEndpoint source = null
	BoundaryEndpoint destination = null
	construct(string id, string sourceMapId, string destinationMapId, string destinationPath, string destinationRegionId, boolean reverse, real scale, real offset)
		this.id = id
		this.sourceMapId = sourceMapId
		this.destinationMapId = destinationMapId
		this.destinationPath = destinationPath
		this.destinationRegionId = destinationRegionId
		this.reverse = reverse
		this.scale = scale
		this.offset = offset
	function valid() returns boolean
		return id != "" and source != null and destination != null and source.valid() and destination.valid() and source.mapId == sourceMapId and destination.mapId == destinationMapId and sourceMapId != destinationMapId and destinationPath != "" and scale > 0. and scale - scale == 0. and offset - offset == 0.
	function destinationPosition(real normalized) returns real
		var value = normalized
		if reverse
			value = 1. - value
		value = value * scale + offset
		return value

/** Commit-first transition coordinator. Loading is the sole irreversible step. */
public class CampaignTravelRuntime
	PlayableCampaignState state
	CampaignSaveManager saves
	CampaignAutosaveScheduler autosaves
	PhysicalMapLoader loader
	string currentMapId
	string currentRegionId
	string lastDiagnostic = ""
	construct(PlayableCampaignState state, CampaignSaveManager saves, CampaignAutosaveScheduler autosaves, PhysicalMapLoader loader, string mapId, string regionId)
		this.state = state
		this.saves = saves
		this.autosaves = autosaves
		this.loader = loader
		currentMapId = mapId
		currentRegionId = regionId
	function physicalMapId() returns string
		return currentMapId
	function physicalRegionId() returns string
		return currentRegionId
	function startAt(string mapId, string regionId)
		currentMapId = mapId
		currentRegionId = regionId
	function transition(BoundaryCorrespondence boundary, real normalized, string createdAt) returns boolean
		if not state.isSaveSafe()
			lastDiagnostic = "travel deferred: authoritative state is transitional"
			return false
		if boundary == null or state.boundary(boundary.id) != boundary or not boundary.valid() or boundary.sourceMapId != currentMapId or not validBoundaryPosition(normalized)
			lastDiagnostic = "transition is not adjacent to the active physical map"
			return false
		let previous = state.authorityDocument()
		let arrival = boundary.destinationPosition(normalized)
		// Preflight the generated destination before replacing authority or
		// committing. Native pathing is rechecked after that map is loaded.
		if not boundary.destination.resolve(arrival, 0, null)
			lastDiagnostic = "no connected party arrival within boundary tolerance"
			return false
		var transferLocations = "arrival"
		if state.party != null and state.rpg != null
			let captured = state.capturePartyLocations(previous)
			if captured == ""
				lastDiagnostic = state.lastDiagnostic
				return false
			transferLocations += SubString(captured, 2, StringLength(captured))
		state.beginTransition()
		state.replaceAuthority(replaceCampaignField(withoutTravelAuthority(previous), "partyLocations", transferLocations) + ";map=" + boundary.destinationMapId + ";region=" + boundary.destinationRegionId + ";boundary=" + boundary.id + ";position=" + arrival.toString() + ";transition=" + boundary.id + ";arrival=" + arrival.toString())
		state.finishTransition()
		if not saves.save(SAVE_SLOT_MAJOR_MILESTONE, 0, createdAt)
			state.replaceAuthority(previous)
			state.cancelTransition()
			lastDiagnostic = saves.diagnostic()
			return false
		currentMapId = boundary.destinationMapId
		currentRegionId = boundary.destinationRegionId
		if saves.hasDeferredSave()
			saves.retryDeferred()
		loader.load(boundary.destinationPath)
		lastDiagnostic = ""
		return true
	function diagnostic() returns string
		return lastDiagnostic

/** Map-local edge triggers are projections of scenario-owned correspondence
 * records. They contain no campaign authority and are rebuilt on every map. */
public class PhysicalBoundaryRegistry
	CampaignTravelRuntime travel
	PlayableRegionAccess access
	BoundaryCorrespondence array[64] boundaries
	trigger array[64] listeners
	boolean array[64] discoveryRequired
	int count = 0
	boolean transitioning = false
	construct(CampaignTravelRuntime travel, PlayableRegionAccess access)
		this.travel = travel
		this.access = access
	function add(string id, boolean requiresDiscovery)
		let route = travel.state.boundary(id)
		if route == null or not route.valid() or route.sourceMapId != travel.physicalMapId()
			return
		boundaries[count] = route
		discoveryRequired[count] = requiresDiscovery
		count++
	function normalizedPosition(int index, unit entering) returns real
		return boundaries[index].source.localPosition(GetUnitX(entering), GetUnitY(entering))
	function entered()
		if transitioning
			return
		let entering = compatEnteringUnit()
		if entering == null or GetOwningPlayer(entering) != Player(0)
			return
		let fired = GetTriggeringTrigger()
		for i = 0 to count - 1
			if listeners[i] == fired
				if discoveryRequired[i] and not access.regionIsKnown(Player(0), boundaries[i].destinationRegionId)
					print("This route has not been discovered.")
					return
				let position = normalizedPosition(i, entering)
				transitioning = true
				if not travel.transition(boundaries[i], position, I2S(R2I(TimerGetElapsed(bj_gameStartedTimer))))
					transitioning = false
					print(travel.diagnostic())
				return
	function install()
		installPhysicalBoundaryRegistry(this)
		for i = 0 to count - 1
			let endpoint = boundaries[i].source
			let start = endpoint.along(0.)
			let finish = endpoint.along(1.)
			var area = GetPlayableMapRect()
			if endpoint.edge == "west"
				area = Rect(endpoint.minX, start, endpoint.minX + BOUNDARY_TRIGGER_DEPTH, finish)
			else if endpoint.edge == "east"
				area = Rect(endpoint.maxX - BOUNDARY_TRIGGER_DEPTH, start, endpoint.maxX, finish)
			else if endpoint.edge == "south"
				area = Rect(start, endpoint.minY, finish, endpoint.minY + BOUNDARY_TRIGGER_DEPTH)
			else
				area = Rect(start, endpoint.maxY - BOUNDARY_TRIGGER_DEPTH, finish, endpoint.maxY)
			listeners[i] = CreateTrigger()
			TriggerRegisterEnterRectSimple(listeners[i], area)
			TriggerAddAction(listeners[i], function physicalBoundaryEntered)

PhysicalBoundaryRegistry installedPhysicalBoundaries = null

function installPhysicalBoundaryRegistry(PhysicalBoundaryRegistry registry)
	installedPhysicalBoundaries = registry

function physicalBoundaryEntered()
	if installedPhysicalBoundaries != null
		installedPhysicalBoundaries.entered()

/** New, independent persisted contract. Absence preserves the legacy startup
 * path. The selected envelope is copied verbatim; its source slot is read-only.
 * Consumed requests retain a reconstruction basis across an acknowledgement /
 * activation interruption. A later origin selection or travel milestone fences
 * that basis out, so ordinary travel never replays an older recovery. */
public constant string CAMPAIGN_RECOVERY_REQUEST = "recovery_request"

public class CampaignRecoveryRequest
	int sequence
	string status
	string scenario
	string slotId
	string mapId
	int startToken
	int milestoneToken
	string payload
	construct(int sequence, string status, string scenario, string slotId, string mapId, int startToken, int milestoneToken, string payload)
		this.sequence = sequence
		this.status = status
		this.scenario = scenario
		this.slotId = slotId
		this.mapId = mapId
		this.startToken = startToken
		this.milestoneToken = milestoneToken
		this.payload = payload
	function encode() returns string
		let body = "v1|" + sequence.toString() + "|" + status + "|" + scenario + "|" + slotId + "|" + mapId + "|" + startToken.toString() + "|" + milestoneToken.toString() + "|" + payload
		return runtimeChecksum(body).toString() + "|" + body

public function decodeCampaignRecoveryRequest(string encoded) returns CampaignRecoveryRequest
	let cut = encoded.indexOf("|")
	if cut < 1
		return null
	let body = SubString(encoded, cut + 1, StringLength(encoded))
	if runtimeChecksum(body).toString() != SubString(encoded, 0, cut)
		return null
	string array[8] fields
	var start = 0
	for field = 0 to 7
		let remaining = SubString(body, start, StringLength(body))
		let finish = remaining.indexOf("|")
		if finish < 1
			return null
		fields[field] = SubString(remaining, 0, finish)
		start += finish + 1
	if fields[0] != "v1" or campaignSlotNumber(fields[1]) == 0 or (fields[2] != "pending" and fields[2] != "consumed") or campaignSlotNumber(fields[6]).toString() != fields[6] or campaignSlotNumber(fields[7]).toString() != fields[7] or start >= StringLength(body)
		return null
	return new CampaignRecoveryRequest(campaignSlotNumber(fields[1]), fields[2], fields[3], fields[4], fields[5], campaignSlotNumber(fields[6]), campaignSlotNumber(fields[7]), SubString(body, start, StringLength(body)))

/** Production command boundary shared with recording tests. */
public class SaveCommand implements CommandHandler
	PlayableCampaignServices campaign
	CommandOutput output
	boolean loading
	construct(PlayableCampaignServices campaign, CommandOutput output, boolean loading)
		this.campaign = campaign
		this.output = output
		this.loading = loading
	override function execute(player sender, string arguments)
		var ok = false
		if loading
			if arguments == "retry"
				ok = campaign.retryRecovery()
			else
				let selected = new CampaignSlotSelection(arguments)
				ok = campaign.loadSelectedSlot(selected.kind, selected.index)
				destroy selected
		else
			let slot = campaignSlotNumber(arguments)
			if slot == 0
				output.show(sender, "Invalid manual slot. Use a positive whole slot number without leading zeros.")
				return
			ok = campaign.saves.save(SAVE_SLOT_MANUAL, slot, I2S(R2I(TimerGetElapsed(bj_gameStartedTimer))))
			campaign.lastDiagnostic = campaign.saves.diagnostic()
		if ok
			output.show(sender, "Campaign save operation completed.")
		else
			output.show(sender, campaign.diagnostic())

public class SaveSlotsCommand implements CommandHandler
	PlayableCampaignServices campaign
	CommandOutput output
	construct(PlayableCampaignServices campaign, CommandOutput output)
		this.campaign = campaign
		this.output = output
	function showSlot(player sender, int kind, int index)
		let slot = campaignSlotId(kind, index)
		if not campaign.saves.storage.contains(slot)
			return
		let candidate = campaign.saves.codec.decodeMigrateAndValidate(campaign.saves.storage.read(slot), slot)
		if candidate == "" or not campaign.validateRecoveryDestination(candidate)
			output.show(sender, slot + ": unavailable (damaged, incompatible or destination unavailable)")
		else
			output.show(sender, slot + ": " + lastAuthorityValue(candidate, "map"))
	override function execute(player sender, string arguments)
		if not campaign.registered
			output.show(sender, "Campaign registration is incomplete.")
			return
		if arguments == "" or arguments == "autosave"
			output.show(sender, "Existing autosaves (load with /load autosave N):")
			for i = 1 to CAMPAIGN_AUTOSAVE_SLOT_COUNT
				showSlot(sender, SAVE_SLOT_AUTOSAVE, i)
		if arguments == "" or arguments == "session_start" or arguments == "major_milestone"
			output.show(sender, "Existing checkpoints (load with /load session_start or /load major_milestone):")
			if arguments != "major_milestone"
				showSlot(sender, SAVE_SLOT_SESSION_START, 0)
			if arguments != "session_start"
				showSlot(sender, SAVE_SLOT_MAJOR_MILESTONE, 0)
		if arguments == "" or arguments == "manual" or arguments.startsWith("manual ")
			var first = 1
			if arguments.startsWith("manual ")
				first = campaignSlotNumber(SubString(arguments, 7, StringLength(arguments)))
			if first == 0
				output.show(sender, "Invalid first manual slot. Use /saves manual <first-slot>.")
				return
			output.show(sender, "Existing manual saves in up to 10 slots starting at " + first.toString() + " (load with /load N):")
			for offset = 0 to 9
				if first <= 2147483647 - offset
					showSlot(sender, SAVE_SLOT_MANUAL, first + offset)
		else if arguments != "autosave" and arguments != "session_start" and arguments != "major_milestone"
			output.show(sender, "Invalid slots request. Use /saves [manual [first-slot]|autosave|session_start|major_milestone].")

public function registerCampaignSaveCommands(CommandRegistry commands, PlayableCampaignServices campaign)
	commands.register("save", "", "save <slot>", "Save the campaign.", "Write a manual slot. Slot numbers are positive whole decimals without leading zeros.", 1, 1, COMMAND_RELEASE, new SaveCommand(campaign, commands.output, false))
	commands.register("load", "", "load <slot|manual N|autosave N|session_start|major_milestone|retry>", "Restore a saved campaign on its recorded map.", "Use /saves to identify existing slots. Autosaves are 1 through 15. /load N is the manual shorthand. /load retry resumes a durable recovery after interrupted startup. Rejected loads preserve the active campaign and source saves.", 1, 2, COMMAND_RELEASE, new SaveCommand(campaign, commands.output, true))
	commands.register("saves", "", "saves [manual [first-slot]|autosave|session_start|major_milestone]", "Identify existing campaign saves.", "List saved map IDs for all 15 autosaves, both checkpoints and a window of 10 manual slots. The default manual window starts at 1; /saves manual N starts at N. Missing slots are omitted. Listing never writes saves.", 0, 2, COMMAND_RELEASE, new SaveSlotsCommand(campaign, commands.output))

/** Knowledge and command rights are explicit runtime facts, never inferred from object presence. */
public class PlayableRegionAccess implements RegionAccessPolicy
	string array[64] ids
	boolean array[64] known
	boolean array[64] authorized
	int count = 0
	function add(string id, boolean isKnown, boolean mayCommand)
		ids[count] = id
		known[count] = isKnown
		authorized[count] = mayCommand
		count++
	function find(string id) returns int
		for i = 0 to count - 1
			if ids[i] == id
				return i
		return -1
	function revealAndAuthorize(string id)
		let i = find(id)
		if i >= 0
			known[i] = true
			authorized[i] = true
	override function regionExists(string regionId) returns boolean
		return find(regionId) >= 0
	override function regionIsKnown(player whichPlayer, string regionId) returns boolean
		let i = find(regionId)
		return i >= 0 and known[i]
	override function mayCommandRegion(player whichPlayer, string regionId) returns boolean
		let i = find(regionId)
		return i >= 0 and authorized[i]

public class PlayableRegionCommandRuntime implements RegionCommandRuntime
	WarcraftRegionalAdapter regional
	string previousRegion = ""
	string lastDiagnostic = ""
	construct(WarcraftRegionalAdapter regional)
		this.regional = regional
	override function snapshotRuntime() returns string
		return previousRegion
	override function restoreRuntime(string snapshot)
		if snapshot != ""
			regional.activateRegion(snapshot)
	override function retireCommandRegion(string regionId)
		previousRegion = regionId
		regional.retireRegion(regionId)
	override function reconstructCommandRegion(player whichPlayer, string regionId) returns boolean
		regional.reconstructRegion(regionId)
		return true
	override function focusCommandRegion(player whichPlayer, string regionId)
		// Each representation retains authoritative coordinates; activating it cannot move the party.
		regional.activateRegion(regionId)
	override function diagnostic() returns string
		return lastDiagnostic

public class WarcraftMapPresentation implements MapPresentationRuntime
	CommandOutput output
	string knownRegions = scenarioRegionId(0)
	string knownLocations = ""
	string knownSearchAreas = ""
	string knownBreadcrumbs = ""
	construct(CommandOutput output)
		this.output = output
	function setKnowledge(string regions, string locations, string searchAreas, string breadcrumbs)
		knownRegions = regions
		knownLocations = locations
		knownSearchAreas = searchAreas
		knownBreadcrumbs = breadcrumbs
	override function showWorldMap(string physicalRegionId, string commandRegionId)
		output.show(Player(0), "World map\nKnown regions: " + knownRegions + "\nKnown routes: " + knownBreadcrumbs + "\nPhysical: " + physicalRegionId + "  Command: " + commandRegionId)
	override function showRegionalMap(string regionId, string physicalRegionId, string commandRegionId)
		output.show(Player(0), "Regional map: " + regionId + "\nKnown locations: " + knownLocations + "\nKnown search areas: " + knownSearchAreas + "\nRoute: " + knownBreadcrumbs)
	override function focusExact(string locationId)
		output.show(Player(0), "Exact known location: " + locationId)
	override function focusSearchArea(string searchAreaId)
		output.show(Player(0), "Known search area: " + searchAreaId)
	override function hideMap()
		skip

public class CampaignMapCommand implements CommandHandler
	MapDiscoveryScreenController maps
	construct(MapDiscoveryScreenController maps)
		this.maps = maps
	override function execute(player sender, string arguments)
		if arguments == "close"
			maps.close()
		else if arguments == "world"
			maps.openWorldMap()
		else
			maps.openRegionalMap(arguments)

public function registerCampaignMapCommand(CommandRegistry commands, MapDiscoveryScreenController maps)
	commands.register("map", "worldmap", "map <world|region-id|close>", "Open a discovered campaign map.", "Show legitimately known geography, locations, search areas, and route breadcrumbs without moving the physical character.", 1, 1, COMMAND_RELEASE, new CampaignMapCommand(maps))

public class PlayableCampaignServices implements CampaignLoadObserver
	PlayerCampaignIdentity identity
	PlayableCampaignState state
	CampaignSaveManager saves
	CampaignAutosaveScheduler autosaves
	CampaignTravelRuntime travel
	PlayableRegionAccess regionAccess
	RegionSelector regionSelector
	MapDiscoveryScreenController maps
	WarcraftMapPresentation mapPresentation
	CampaignRuntimeExtension extension = null
	PlayableCountryInteractionRuntime countries
	CountryDiplomacyController countryScreen
	CampaignHandoff handoff
	OriginCatalog origins = new OriginCatalog()
	string physicalMapId
	boolean registered = false
	boolean started = false
	string lastDiagnostic = ""
	string initialRpg = ""
	string initialCountries = ""
	construct(WarcraftRegionalAdapter regional, CampaignClock clock, string physicalMapId, ReligionRuntime religion, CampaignSaveStorage storage, CampaignHandoff handoff, PhysicalMapLoader loader, CampaignPartyProjection party)
		this.physicalMapId = physicalMapId
		this.handoff = handoff
		identity = new PlayerCampaignIdentity()
		state = new PlayableCampaignState(regional, clock)
		state.startupLocked = true
		state.loadedPhysicalMap = physicalMapId
		state.party = party
		state.identity = identity
		state.origins = origins
		countries = new PlayableCountryInteractionRuntime(identity)
		countryScreen = new CountryDiplomacyController(countries, new WarcraftCountryDiplomacyPresentation())
		state.setCountryRuntime(countries)
		state.setReligionRuntime(religion)
		saves = new CampaignSaveManager(storage, new PlayableCampaignCodec(clock), state)
		autosaves = new CampaignAutosaveScheduler(saves, CAMPAIGN_AUTOSAVE_SECONDS)
		state.autosaves = autosaves
		let logicalRegion = scenarioLogicalRegion(physicalMapId)
		travel = new CampaignTravelRuntime(state, saves, autosaves, loader, physicalMapId, logicalRegion)
		regionAccess = new PlayableRegionAccess()
		for i = 0 to scenarioRegionCount() - 1
			let regionId = scenarioRegionId(i)
			let known = scenarioRegionInitiallyKnown(regionId)
			regionAccess.add(regionId, known, known)
		regionAccess.revealAndAuthorize(logicalRegion)
		regionSelector = new RegionSelector(regionAccess, new PlayableRegionCommandRuntime(regional), logicalRegion)
		mapPresentation = new WarcraftMapPresentation(new WarcraftOutput())
		mapPresentation.setKnowledge(logicalRegion, "", "", "")
		maps = new MapDiscoveryScreenController(getManagementScreenPauseController(), mapPresentation, logicalRegion, logicalRegion)
		saves.setLoadObserver(this)
	function registerExtension(CampaignRuntimeExtension value)
		extension = value
		state.setExtension(value)
	function registerPiracyRuntime(PiracyRuntime value)
		state.setPiracyRuntime(value)
	function finishRegistration() returns boolean
		registered = state.rpg != null and state.rpg.projections != null and state.militarySettlements != null and state.religion != null and state.piracy != null and extension != null and countries.peaceAuthority != null and state.piracy.polityAuthority != null and state.piracy.actionAuthority != null and origins.count > 0
		// A generated single-map campaign legitimately has no transfer routes.
		// Require completed configuration, not a nonempty boundary catalogue.
		registered = registered and state.boundaryConfigurationComplete
		if registered
			(saves.codec castTo PlayableCampaignCodec).configureMigrationDefaults(state.militarySettlements, state.religion, state.piracy)
		return registered
	function diagnostic() returns string
		return lastDiagnostic
	/** Envelopes 1-8 predate an explicit scenario field. Their scenario binding
	 * is the scenario-specific cache plus authored origin/world and map/region
	 * identities. Keep these bytes supported; the new request also names the
	 * campaign explicitly. Destination terrain/native validation stays local. */
	function validateRecoveryDestination(string candidate) returns boolean
		let mapId = lastAuthorityValue(candidate, "map")
		let origin = origins.find(playerAuthorityValue(candidate, "origin"))
		if scenarioPhysicalMapPath(mapId) == "" or lastAuthorityValue(candidate, "region") != scenarioLogicalRegion(mapId)
			lastDiagnostic = "The saved physical map is unavailable or does not match its region."
			return false
		if origin == null or lastAuthorityValue(candidate, "world") != "instance:" + origin.regionalInstanceId
			lastDiagnostic = "The save does not match this campaign's authored origin and world."
			return false
		lastDiagnostic = ""
		return true
	function recoveryStartToken() returns int
		return runtimeChecksum(handoff.storage.read(HANDOFF_REQUEST) + "|" + handoff.storage.read("origin") + "|" + handoff.storage.read("map") + "|" + handoff.storage.read("instance") + "|" + handoff.storage.read("settlement"))
	function recoveryApplies(CampaignRecoveryRequest request) returns boolean
		return request.startToken == recoveryStartToken() and request.milestoneToken == runtimeChecksum(saves.storage.read("major_milestone"))
	function recoveryCandidate(CampaignRecoveryRequest request) returns string
		if request.scenario != SCENARIO_CAMPAIGN_ID or request.slotId.startsWith(HANDOFF_CHECKPOINT)
			lastDiagnostic = "The recovery request belongs to a different campaign."
			return ""
		let candidate = saves.codec.decodeMigrateAndValidate(request.payload, request.slotId)
		if candidate == ""
			lastDiagnostic = "Recovery save rejected: " + saves.codec.diagnostic()
			return ""
		if not validateRecoveryDestination(candidate)
			return ""
		if request.mapId != lastAuthorityValue(candidate, "map")
			lastDiagnostic = "The recovery request and saved destination disagree."
			return ""
		return candidate
	function loadSelectedSlot(int kind, int index) returns boolean
		let slot = campaignSlotId(kind, index)
		if slot == ""
			lastDiagnostic = "Invalid save slot. Use /load N, /load manual N, /load autosave 1..15, /load session_start or /load major_milestone."
			return false
		if not registered or saves.loading or state.loading or state.transitionOpen or (started and not state.isSaveSafe())
			lastDiagnostic = "Campaign state is transitional. Use /load retry for an interrupted recovery."
			return false
		if not saves.storage.contains(slot)
			lastDiagnostic = "The selected campaign save slot is missing."
			return false
		let payload = saves.storage.read(slot)
		let candidate = saves.codec.decodeMigrateAndValidate(payload, slot)
		if candidate == ""
			lastDiagnostic = "Campaign save rejected: " + saves.codec.diagnostic()
			return false
		if not validateRecoveryDestination(candidate)
			return false
		let mapId = lastAuthorityValue(candidate, "map")
		if started and mapId == physicalMapId
			let loaded = saves.load(kind, index)
			lastDiagnostic = saves.diagnostic()
			return loaded
		var sequence = 1
		let previous = decodeCampaignRecoveryRequest(handoff.storage.read(CAMPAIGN_RECOVERY_REQUEST))
		if previous != null
			if previous.sequence == 2147483647
				sequence = 0
			else
				sequence = previous.sequence + 1
			destroy previous
		if sequence <= 0
			lastDiagnostic = "The recovery request sequence is exhausted."
			return false
		let request = new CampaignRecoveryRequest(sequence, "pending", SCENARIO_CAMPAIGN_ID, slot, mapId, recoveryStartToken(), runtimeChecksum(saves.storage.read("major_milestone")), payload)
		let committed = handoff.storage.writeTransactional(CAMPAIGN_RECOVERY_REQUEST, request.encode())
		destroy request
		if not committed
			lastDiagnostic = "The recovery request could not be committed; the active campaign and source saves are unchanged."
			return false
		launchRecovery(mapId)
		return true
	function launchRecovery(string mapId)
		// No authority/identity/travel mutation. Freeze the source after the
		// durable write so its timers cannot replace a recovery checkpoint.
		state.startupLocked = true
		state.clock.detachTimer()
		lastDiagnostic = ""
		travel.loader.load(scenarioPhysicalMapPath(mapId))
	function retryRecovery() returns boolean
		if not registered or saves.loading or state.loading or state.transitionOpen
			lastDiagnostic = "Campaign registration or reconstruction is incomplete."
			return false
		let request = decodeCampaignRecoveryRequest(handoff.storage.read(CAMPAIGN_RECOVERY_REQUEST))
		if request == null
			lastDiagnostic = "No valid durable recovery request is available."
			return false
		let valid = recoveryApplies(request) and recoveryCandidate(request) != ""
		let mapId = request.mapId
		let alreadyActive = started and state.isSaveSafe() and request.status == "consumed"
		destroy request
		if not valid
			lastDiagnostic = "The recovery request is incompatible or superseded by a later campaign start or milestone."
			return false
		if alreadyActive
			lastDiagnostic = ""
			return true
		launchRecovery(mapId)
		return true
	function restoreRecovery(CampaignRecoveryRequest request) returns boolean
		let candidate = recoveryCandidate(request)
		if candidate == "" or request.mapId != physicalMapId
			return rejectRestoration("The recovery request is invalid for this physical map. " + lastDiagnostic)
		if not saves.stageCandidate(candidate)
			return rejectRestoration(saves.diagnostic())
		if request.status == "pending"
			request.status = "consumed"
			if not handoff.storage.writeTransactional(CAMPAIGN_RECOVERY_REQUEST, request.encode())
				saves.abortLoad()
				return rejectRestoration("Recovery acknowledgement was interrupted; /load retry retains the selected checkpoint.")
		// All fallible work precedes publication. Consumed records can reconstruct
		// after a process interruption here, without regranting any starting state.
		saves.commitLoad(true)
		return true
	function rejectRestoration(string reason) returns boolean
		state.startupLocked = true
		lastDiagnostic = reason
		return false
	function rejectStartup(string reason) returns boolean
		if saves.loading
			saves.abortLoad()
			return rejectRestoration(reason)
		state.startupLocked = true
		state.clock.detachTimer()
		autosaves.detachTimer()
		lastDiagnostic = reason
		if state.party != null and state.rpg != null
			state.party.clear(state.rpg)
		if state.militarySettlements != null
			let military = state.militarySettlements
			military.suspendCallbacks()
			for i = 0 to military.forceCount - 1
				if military.forces[i].regionId == military.activeRegionId
					military.adapter.removeRepresentation(military.forces[i].id)
		state.regional.retireRegion(state.regional.activeRegionId)
		return false
	function loadStartupPayload(string payload, CampaignStartRequest request) returns boolean
		let candidate = saves.codec.decodeMigrateAndValidate(payload, request.checkpointSlot())
		if candidate != "" and (playerAuthorityValue(candidate, "origin") != request.origin or lastAuthorityValue(candidate, "world") != "instance:" + request.instanceId or playerAuthorityValue(candidate, "settlement") != request.settlementId)
			return rejectRestoration("The startup checkpoint does not match its request.")
		if candidate == "" or not saves.stageCandidate(candidate)
			return rejectRestoration("Campaign startup checkpoint rejected: " + saves.codec.diagnostic() + " " + saves.diagnostic())
		return true
	function startNewCampaign(CampaignStartRequest request) returns boolean
		// Restore registered defaults on a retry, never register them over saved mutations.
		if not state.clock.restoreState(state.clock.initialState())
			return rejectStartup(state.clock.diagnostic())
		if initialRpg == ""
			initialRpg = state.rpg.captureState()
			initialCountries = countries.captureState()
		if not state.rpg.restoreState(initialRpg) or not countries.restoreState(initialCountries)
			return rejectStartup("Campaign defaults could not be restored.")
		identity.restore(request.origin, request.origin, request.mapId, request.instanceId, request.settlementId)
		extension.newCampaign(request.settlementId)
		countries.discover(request.origin)
		state.replaceAuthority("v2;map=" + request.mapId + ";region=" + scenarioLogicalRegion(request.mapId) + ";boundary=;position=0.5;world=instance:" + request.instanceId + ";players=origin:" + request.origin + ",allegiance:" + request.origin + ",settlement:" + request.settlementId + ";quests=;discovery=" + request.settlementId + ";orders=;trade=")
		if not state.rpg.prepareNewCampaign() or not state.projectParty(state.authorityDocument())
			return rejectStartup("The starting player representation could not be initialized.")
		let candidate = state.captureAuthoritativeState()
		if not state.validateAuthoritativeState(candidate)
			return rejectStartup(state.diagnostic())
		let payload = saves.codec.encode(request.checkpointSlot(), SAVE_SLOT_SESSION_START, 0, "campaign-start", candidate)
		if payload == "" or not handoff.storage.writeTransactional(request.checkpointSlot(), payload)
			return rejectStartup("The new campaign checkpoint could not be committed.")
		return true
	/** The only regional entry point. Registrations and ports must be complete;
	 * no clocks, autosaves or commands are enabled until this returns true. */
	function startup() returns boolean
		if started
			return true
		if not registered
			return rejectStartup("Campaign registration is incomplete.")
		let recovery = decodeCampaignRecoveryRequest(handoff.storage.read(CAMPAIGN_RECOVERY_REQUEST))
		if handoff.storage.contains(CAMPAIGN_RECOVERY_REQUEST) and recovery == null
			return rejectRestoration("The durable recovery request is damaged or unsupported. Select an existing save with /load.")
		if recovery != null
			if recoveryApplies(recovery)
				let restored = restoreRecovery(recovery)
				destroy recovery
				if not restored
					return false
				return finishStartup()
			// Explicit recovery can also replace an interrupted *new campaign*
			// startup. Its still-pending origin request must stay superseded after
			// subsequent travel changes the milestone, until a NEW origin request.
			let recoveredStart = recovery.scenario == SCENARIO_CAMPAIGN_ID and recovery.status == "consumed" and recovery.startToken == recoveryStartToken()
			destroy recovery
			if recoveredStart
				if not saves.load(SAVE_SLOT_MAJOR_MILESTONE, 0)
					return rejectRestoration(saves.diagnostic())
				return finishStartup()
		if not restoreOrdinaryStartup()
			return false
		return finishStartup()
	function restoreOrdinaryStartup() returns boolean
		let request = handoff.readRequest()
		if handoff.hasRequest() and (request == null or not request.valid(origins))
			return rejectStartup("The campaign start request is missing fields or does not match the authored origins.")
		if request != null and request.status == "pending"
			if request.mapId != physicalMapId
				return rejectStartup("The campaign start request targets a different physical map.")
			// Each sequence owns its checkpoint; corrupt records are never mistaken
			// for an unrelated old save and silently overwritten.
			if handoff.storage.contains(request.checkpointSlot())
				if not loadStartupPayload(handoff.storage.read(request.checkpointSlot()), request)
					return false
			else if not startNewCampaign(request)
				return false
			// Initialization and its recoverable checkpoint succeeded. Publish the
			// campaign through the existing codec before acknowledging consumption.
			var candidate = state.captureAuthoritativeState()
			if saves.loading
				candidate = state.captureStagedAuthoritativeState()
			let session = saves.codec.encode("session_start", SAVE_SLOT_SESSION_START, 0, "campaign-start", candidate)
			if not saves.storage.writeTransactional("session_start", session)
				return rejectStartup("The session checkpoint could not be committed; the start request is recoverable.")
			let milestone = saves.codec.encode("major_milestone", SAVE_SLOT_MAJOR_MILESTONE, 0, "campaign-start", candidate)
			if not saves.storage.writeTransactional("major_milestone", milestone)
				return rejectStartup("The campaign milestone could not be committed; the start request is recoverable.")
			if not handoff.acknowledge(request)
				return rejectStartup("Campaign acknowledgement was interrupted; the start checkpoint is recoverable.")
			if saves.loading
				saves.commitLoad(true)
			else
				saves.publishLoad()
		else
			if not saves.load(SAVE_SLOT_MAJOR_MILESTONE, 0)
				return rejectRestoration(saves.diagnostic())
		return true
	function finishStartup() returns boolean
		started = true
		state.rpg.management.close()
		state.startupLocked = false
		lastDiagnostic = ""
		return true
	function sessionStart(string createdAt)
		saves.save(SAVE_SLOT_SESSION_START, 0, createdAt)
	function majorMilestone(string createdAt)
		saves.save(SAVE_SLOT_MAJOR_MILESTONE, 0, createdAt)
	function enableClockTimer(CampaignTimerAdapter adapter, real interval) returns boolean
		if not started
			return false
		state.clock.attachTimer(adapter, interval)
		return true
	function enableAutosaveTimer(CampaignAutosaveTimerAdapter adapter, ManagementScreenPauseController pauses) returns boolean
		if not started
			return false
		autosaves.bindManagementPause(pauses)
		autosaves.attachTimer(adapter)
		return true
	override function afterCampaignLoad()
		let document = state.authorityDocument()
		let loadedMap = lastAuthorityValue(document, "map")
		let loadedRegion = lastAuthorityValue(document, "region")
		let loadedOrigin = playerAuthorityValue(document, "origin")
		var loadedAllegiance = playerAuthorityValue(document, "allegiance")
		let loadedSettlement = playerAuthorityValue(document, "settlement")
		var instance = lastAuthorityValue(document, "world")
		if instance.startsWith("instance:")
			instance = SubString(instance, 9, StringLength(instance))
		if loadedAllegiance == ""
			loadedAllegiance = loadedOrigin
		identity.restore(loadedOrigin, loadedAllegiance, loadedMap, instance, loadedSettlement)
		travel.startAt(loadedMap, loadedRegion)
		regionAccess.revealAndAuthorize(loadedRegion)
		regionSelector.setPhysicalRegionId(loadedRegion)
		mapPresentation.setKnowledge(loadedRegion, loadedSettlement, "", "")
		maps.setPhysicalRegion(loadedRegion)
		maps.setCommandRegion(loadedRegion)

public PlayableCampaignServices campaignServices = null

public function initializePlayableCampaignRuntime(CommandRegistry commands, string physicalMapId, CampaignClock clock, ReligionRuntime religion, PiracyRuntime piracy) returns PlayableCampaignServices
	religionMigrationRuntime = religion
	piracyMigrationRuntime = piracy
	// Both namespaces must share the same cache handle: saving an independently
	// opened handle must not replace records committed through the other one.
	let cache = compatInitGameCache(CAMPAIGN_CACHE_FILE)
	campaignServices = new PlayableCampaignServices(regionalRuntime, clock, physicalMapId, religion, new WarcraftCampaignSaveStorage(cache, "campaign"), new CampaignHandoff(new WarcraftCampaignSaveStorage(cache, "bootstrap"), new WarcraftPhysicalMapLoader()), new WarcraftPhysicalMapLoader(), new WarcraftCampaignPartyProjection())
	registerCampaignSaveCommands(commands, campaignServices)
	registerRegionCommand(commands, campaignServices.regionSelector, new WarcraftOutput())
	registerCampaignMapCommand(commands, campaignServices.maps)
	registerGovernmentRewards(commands, campaignServices.countryScreen)
	return campaignServices

public function enableCampaignAutosaves()
	if campaignServices == null or not campaignServices.started or campaignServices.autosaves.timerAdapter != null
		return
	campaignServices.enableAutosaveTimer(new WarcraftAutosaveTimerAdapter(), getManagementScreenPauseController())
