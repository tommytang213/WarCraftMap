package CampaignAutosaveScheduler
import CampaignSaveManager

public constant int AUTOSAVE_SCHEDULER_METADATA_VERSION = 1

public class CampaignAutosaveScheduler
	CampaignSaveManager manager
	real interval
	real remaining
	int nextSlot = 1
	boolean saveInProgress = false
	boolean pendingRequest = false
	boolean configurationValid = false
	string intendedCreatedAt = ""
	string lastDiagnostic = ""

	construct(CampaignSaveManager saveManager, real configuredInterval)
		manager = saveManager
		if configuredInterval <= 0.
			interval = 1.
			remaining = 1.
			lastDiagnostic = "autosave interval must be positive"
		else
			interval = configuredInterval
			remaining = configuredInterval
			configurationValid = true

	function isConfigurationValid() returns boolean
		return configurationValid

	function nextSlotIndex() returns int
		return nextSlot

	function secondsUntilDue() returns real
		return remaining

	function diagnostic() returns string
		return lastDiagnostic

	function advance(real elapsed, string createdAt) returns boolean
		if not configurationValid
			lastDiagnostic = "autosave interval must be positive"
			return false
		if elapsed < 0.
			lastDiagnostic = "autosave clock cannot move backwards"
			return false
		remaining = remaining - elapsed
		if remaining > 0. and not pendingRequest and intendedCreatedAt == ""
			return false
		return request(createdAt)

	function request(string createdAt) returns boolean
		if saveInProgress
			pendingRequest = true
			lastDiagnostic = "autosave request coalesced while save is in progress"
			return false
		saveInProgress = true
		if intendedCreatedAt == ""
			intendedCreatedAt = createdAt
		let succeeded = manager.save(SAVE_SLOT_AUTOSAVE, nextSlot, intendedCreatedAt)
		saveInProgress = false
		if not succeeded
			lastDiagnostic = manager.diagnostic()
			return false
		nextSlot++
		if nextSlot > CAMPAIGN_AUTOSAVE_SLOT_COUNT
			nextSlot = 1
		remaining = interval
		pendingRequest = false
		intendedCreatedAt = ""
		lastDiagnostic = ""
		return true

	function restore(int metadataVersion, int slotValue, real savedRemaining) returns boolean
		var restoredSlot = slotValue
		if metadataVersion == 0
			if slotValue < 0 or slotValue > CAMPAIGN_AUTOSAVE_SLOT_COUNT
				lastDiagnostic = "invalid migrated autosave slot metadata"
				return false
			restoredSlot = slotValue + 1
			if restoredSlot > CAMPAIGN_AUTOSAVE_SLOT_COUNT
				restoredSlot = 1
		else if metadataVersion != AUTOSAVE_SCHEDULER_METADATA_VERSION
			lastDiagnostic = "unsupported autosave scheduler metadata version"
			return false
		if restoredSlot < 1 or restoredSlot > CAMPAIGN_AUTOSAVE_SLOT_COUNT or savedRemaining < 0.
			lastDiagnostic = "invalid autosave scheduler metadata"
			return false
		nextSlot = restoredSlot
		remaining = savedRemaining
		saveInProgress = false
		pendingRequest = false
		intendedCreatedAt = ""
		lastDiagnostic = ""
		return true
