package CampaignTimeline

import ManagementScreenPauseController

/** Consumers in technology, economy, diplomacy, quests, and events implement this port. */
public interface CampaignTimelineListener
	function onCampaignEvent(string eventId, string scheduleId, int occurrence, int campaignDay)

/** Warcraft timers wake the clock but never own authoritative campaign time. */
public interface CampaignTimerAdapter
	function start(CampaignClock clock, real interval)
	function stop()

// R2S rounds to three decimal places. Encode non-negative finite reals as
// binary significand digits and a power of two, preserving fractional ticks
// exactly in both the interpreter and Lua without native formatting precision.
public function clockReal(real input) returns string
	var value = input
	if value == 0.
		return "0"
	var exponent = 0
	while value >= 2.
		value /= 2.
		exponent++
	while value < 1.
		value *= 2.
		exponent--
	var digits = ""
	while value > 0.
		let digit = value.toInt()
		digits += digit.toString()
		value = (value - digit) * 2.
	return exponent.toString() + ":" + digits

public function readClockReal(string encoded) returns real
	if encoded == "0"
		return 0.
	let colon = encoded.indexOf(":")
	if colon <= 0
		return -1.
	let exponentText = SubString(encoded, 0, colon)
	var exponent = S2I(exponentText)
	let digits = SubString(encoded, colon + 1, StringLength(encoded))
	if exponent.toString() != exponentText or exponent < -1074 or exponent > 1023 or StringLength(digits) > 53 or not digits.startsWith("1")
		return -1.
	var value = 0.
	var weight = 1.
	for i = 0 to StringLength(digits) - 1
		let digit = SubString(digits, i, i + 1)
		if digit != "0" and digit != "1"
			return -1.
		if digit == "1"
			value += weight
		weight /= 2.
	while exponent > 0
		value *= 2.
		exponent--
	while exponent < 0
		value /= 2.
		exponent++
	if not (value > 0.) or value - value != 0.
		return -1.
	if clockReal(value) != encoded
		return -1.
	return value

function clockField(string record, int index) returns string
	var tail = record
	for i = 0 to index - 1
		let cut = tail.indexOf("|")
		if cut < 0
			return ""
		tail = SubString(tail, cut + 1, StringLength(tail))
	let finish = tail.indexOf("|")
	if finish >= 0
		return SubString(tail, 0, finish)
	return tail

public class CampaignEra
	string id
	int firstDay
	int lastDay
	construct(string stableId, int first, int last)
		id = stableId
		firstDay = first
		lastDay = last

public class ScheduledCampaignEvent
	string scheduleId
	string eventId
	int day
	int occurrence
	construct(string schedule, string eventIdValue, int atDay, int number)
		scheduleId = schedule
		eventId = eventIdValue
		day = atDay
		occurrence = number

/** Scenario-neutral authoritative clock. Dates use Gregorian ordinal days. */
public class CampaignClock implements CampaignPauseListener
	int startDay
	int endDay
	int initialDay
	int currentDay
	real fractionalDays = 0.
	real daysPerSecond
	real speed = 1.
	boolean paused = false
	ManagementScreenPauseController managementPause = null
	boolean advancing = false
	string lastDiagnostic = ""
	CampaignEra array[64] eras
	int eraCount = 0
	ScheduledCampaignEvent array[4096] occurrences
	int occurrenceCount = 0
	int nextOccurrence = 0
	CampaignTimelineListener array[32] listeners
	int listenerCount = 0
	CampaignTimerAdapter timerAdapter = null
	real timerInterval = 0.
	int scheduleFingerprint

	construct(int first, int last, int initial, real configuredDaysPerSecond)
		startDay = first
		endDay = last
		currentDay = initial
		initialDay = initial
		daysPerSecond = configuredDaysPerSecond
		scheduleFingerprint = StringHash(first.toString() + "|" + last.toString() + "|" + initial.toString() + "|" + clockReal(configuredDaysPerSecond))

	function addEra(string id, int first, int last)
		eras[eraCount] = new CampaignEra(id, first, last)
		eraCount++

	/** Generated scenario occurrences are already in canonical deterministic order. */
	function addOccurrence(string scheduleId, string eventId, int day, int occurrence)
		occurrences[occurrenceCount] = new ScheduledCampaignEvent(scheduleId, eventId, day, occurrence)
		occurrenceCount++
		scheduleFingerprint = StringHash(scheduleFingerprint.toString() + "|" + scheduleId + "|" + eventId + "|" + day.toString() + "|" + occurrence.toString())

	function subscribe(CampaignTimelineListener listener)
		listeners[listenerCount] = listener
		listenerCount++

	function campaignDay() returns int
		return currentDay

	function campaignYear() returns int
		var remaining = currentDay
		var year = 1
		while remaining > daysInYear(year)
			remaining = remaining - daysInYear(year)
			year++
		return year

	function campaignMonth() returns int
		let year = campaignYear()
		var remaining = currentDay - ordinalAtYearStart(year)
		var month = 1
		while remaining > daysInMonth(year, month)
			remaining = remaining - daysInMonth(year, month)
			month++
		return month

	function campaignMonthDay() returns int
		let year = campaignYear()
		var remaining = currentDay - ordinalAtYearStart(year)
		var month = 1
		while remaining > daysInMonth(year, month)
			remaining = remaining - daysInMonth(year, month)
			month++
		return remaining

	function campaignEra() returns string
		for i = 0 to eraCount - 1
			if currentDay >= eras[i].firstDay and currentDay <= eras[i].lastDay
				return eras[i].id
		return ""

	function isPaused() returns boolean
		return paused

	function setPaused(boolean value)
		paused = value

	/** Subscribe once, including an already-open modal or manual pause. */
	function bindManagementPause(ManagementScreenPauseController pauses)
		if managementPause != null
			managementPause.unsubscribe(this)
		managementPause = pauses
		if pauses != null
			pauses.subscribe(this)
			setPaused(pauses.isCampaignPaused())
	override function onCampaignPause(boolean value)
		setPaused(value)

	function setSpeed(real value) returns boolean
		if not (value > 0.) or value - value != 0.
			lastDiagnostic = "campaign speed must be positive"
			return false
		speed = value
		lastDiagnostic = ""
		return true

	function diagnostic() returns string
		return lastDiagnostic

	function advanceElapsed(real elapsed) returns boolean
		if advancing
			lastDiagnostic = "campaign clock advancement is already in progress"
			return false
		if not (elapsed >= 0.) or elapsed - elapsed != 0.
			lastDiagnostic = "elapsed seconds must be non-negative"
			return false
		if paused or currentDay == endDay
			return true
		let total = fractionalDays + elapsed * daysPerSecond * speed
		if total - total != 0.
			lastDiagnostic = "elapsed campaign time must be finite"
			return false
		// Clamp before converting to an integer: large jumps must not overflow.
		if total >= endDay - currentDay
			fractionalDays = 0.
			return advanceTo(endDay)
		let wholeDays = total.toInt()
		fractionalDays = total - wholeDays
		if wholeDays <= 0
			return true
		return advanceTo(currentDay + wholeDays)

	function advanceTo(int target) returns boolean
		if advancing
			lastDiagnostic = "campaign clock advancement is already in progress"
			return false
		if target < currentDay or target > endDay
			lastDiagnostic = "target campaign day is outside the current scenario range"
			return false
		if paused
			return true
		advancing = true
		while nextOccurrence < occurrenceCount and occurrences[nextOccurrence].day <= target
			let scheduled = occurrences[nextOccurrence]
			nextOccurrence++
			for i = 0 to listenerCount - 1
				listeners[i].onCampaignEvent(scheduled.eventId, scheduled.scheduleId, scheduled.occurrence, scheduled.day)
		currentDay = target
		if currentDay == endDay
			fractionalDays = 0.
		advancing = false
		lastDiagnostic = ""
		return true

	/** Stable clock domain; timers, listeners and UI pause ownership are transient. */
	function captureState() returns string
		if advancing
			return ""
		return "2|" + currentDay.toString() + "|" + nextOccurrence.toString() + "|" + clockReal(fractionalDays) + "|" + clockReal(speed) + "|" + scheduleFingerprint.toString()

	/** Schemas 1-5 omitted time. Never derive defaults from the running clock. */
	function initialState() returns string
		return "2|" + initialDay.toString() + "|0|0|0:1|" + scheduleFingerprint.toString()

	function validateState(int stateVersion, int savedDay, int savedNextOccurrence, real savedFraction, real savedSpeed) returns boolean
		if advancing or stateVersion != 2 or savedDay < startDay or savedDay > endDay or savedNextOccurrence < 0 or savedNextOccurrence > occurrenceCount or not (savedFraction >= 0. and savedFraction < 1.) or not (savedSpeed > 0.) or savedSpeed - savedSpeed != 0. or (savedDay == endDay and savedFraction != 0.)
			lastDiagnostic = "invalid campaign timeline save state"
			return false
		// A pristine initial clock can still have its initial-day events pending.
		// Every completed advancement consumes ALL occurrences through that day,
		// including simultaneous occurrences; a checkpoint cannot split that batch.
		let pristine = savedDay == initialDay and savedNextOccurrence == 0
		for i = 0 to occurrenceCount - 1
			if (i < savedNextOccurrence and occurrences[i].day > savedDay) or (i >= savedNextOccurrence and (occurrences[i].day < savedDay or (occurrences[i].day == savedDay and not pristine)))
				lastDiagnostic = "campaign timeline cursor is inconsistent with its schedule"
				return false
		lastDiagnostic = ""
		return true

	function validateState(string record) returns boolean
		let day = clockField(record, 1)
		let cursor = clockField(record, 2)
		let fraction = readClockReal(clockField(record, 3))
		let multiplier = readClockReal(clockField(record, 4))
		if clockField(record, 0) != "2" or S2I(day).toString() != day or S2I(cursor).toString() != cursor or not validateState(2, S2I(day), S2I(cursor), fraction, multiplier)
			lastDiagnostic = "invalid campaign timeline save state"
			return false
		let canonical = "2|" + day + "|" + cursor + "|" + clockReal(fraction) + "|" + clockReal(multiplier) + "|" + scheduleFingerprint.toString()
		if record != canonical
			lastDiagnostic = "campaign timeline record does not match its generated schedule"
			return false
		return true

	function restoreState(string record) returns boolean
		if not validateState(record)
			return false
		return restoreState(2, S2I(clockField(record, 1)), S2I(clockField(record, 2)), readClockReal(clockField(record, 3)), readClockReal(clockField(record, 4)))

	function restoreState(int stateVersion, int savedDay, int savedNextOccurrence, real savedFraction, real savedSpeed) returns boolean
		if not validateState(stateVersion, savedDay, savedNextOccurrence, savedFraction, savedSpeed)
			return false
		// All validation precedes mutation.
		currentDay = savedDay
		nextOccurrence = savedNextOccurrence
		fractionalDays = savedFraction
		speed = savedSpeed
		lastDiagnostic = ""
		return true

	function attachTimer(CampaignTimerAdapter adapter, real interval)
		if timerAdapter != null
			timerAdapter.stop()
		timerAdapter = adapter
		timerInterval = interval
		adapter.start(this, interval)

	function reconstructTimer()
		if timerAdapter != null
			attachTimer(timerAdapter, timerInterval)

	function detachTimer()
		if timerAdapter != null
			timerAdapter.stop()
			timerAdapter = null

CampaignClock warcraftTimerClock = null
real warcraftTimerInterval = 0.
WarcraftCampaignTimerAdapter activeWarcraftTimer = null

function campaignTimerWake()
	if warcraftTimerClock != null
		warcraftTimerClock.advanceElapsed(warcraftTimerInterval)

public class WarcraftCampaignTimerAdapter implements CampaignTimerAdapter
	timer wakeTimer = null
	override function start(CampaignClock target, real seconds)
		stop()
		if activeWarcraftTimer != null
			activeWarcraftTimer.stop()
		activeWarcraftTimer = this
		warcraftTimerClock = target
		warcraftTimerInterval = seconds
		wakeTimer = CreateTimer()
		TimerStart(wakeTimer, warcraftTimerInterval, true, function campaignTimerWake)
	override function stop()
		if wakeTimer != null
			PauseTimer(wakeTimer)
			DestroyTimer(wakeTimer)
			wakeTimer = null
		if activeWarcraftTimer == this
			activeWarcraftTimer = null
			warcraftTimerClock = null

CampaignClock campaignClock = null

function leapYear(int year) returns boolean
	return year mod 4 == 0 and (year mod 100 != 0 or year mod 400 == 0)

function daysInYear(int year) returns int
	if leapYear(year)
		return 366
	return 365

function daysInMonth(int year, int month) returns int
	if month == 2
		if leapYear(year)
			return 29
		return 28
	if month == 4 or month == 6 or month == 9 or month == 11
		return 30
	return 31

function ordinalAtYearStart(int year) returns int
	let previous = year - 1
	return previous * 365 + previous div 4 - previous div 100 + previous div 400

public function installCampaignClock(CampaignClock value)
	installCampaignClock(value, getManagementScreenPauseController())

public function installCampaignClock(CampaignClock value, ManagementScreenPauseController pauses)
	if campaignClock != null and campaignClock != value
		campaignClock.detachTimer()
		campaignClock.bindManagementPause(null)
	campaignClock = value
	if value != null
		value.bindManagementPause(pauses)

public function getCampaignClock() returns CampaignClock
	return campaignClock

public function getCampaignDay() returns int
	return campaignClock.campaignDay()

public function getCampaignYear() returns int
	return campaignClock.campaignYear()

public function getCampaignMonth() returns int
	return campaignClock.campaignMonth()

public function getCampaignMonthDay() returns int
	return campaignClock.campaignMonthDay()

public function getCampaignEra() returns string
	return campaignClock.campaignEra()

public function advanceCampaignTo(int target) returns boolean
	return campaignClock.advanceTo(target)

public function setCampaignTimePaused(boolean paused)
	setCampaignManuallyPaused(paused)
