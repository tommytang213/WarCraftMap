package QuestRewards

import QuestStages
import initlater WarcraftRpgRuntime

/** Scenario definitions only; delivery is persisted by existing quest completion
 * and controller research IDs, never by native projection handles. */
public class QuestRewardOutcome
	string id
	string operation
	string targetId
	string requiredStages
	construct(string id, string operation, string targetId, string requiredStages)
		this.id = id
		this.operation = operation
		this.targetId = targetId
		this.requiredStages = requiredStages
	function eligible(string reached) returns boolean
		let required = new QuestIds(requiredStages)
		var result = required.valid
		for i = 0 to required.count - 1
			if not questHas(reached, required.ids[i])
				result = false
		destroy required
		return result

/** Bounded, all-or-nothing batch for research-bearing authored quests only.
 * Unsupported eligible siblings block the whole turn-in, including generic XP.
 * Python complete_research grants a known target directly, without payment or
 * implicit prerequisites. This live port scopes that grant to campaign player.
 * The caller preflights ordinary quest/XP/currency gates before prepare, performs
 * no callbacks before commitPrepared, and reconciles effects after all state. */
public class QuestRewardBatch
	string questId
	TechnologyRuntime technologies
	QuestRewardOutcome array[32] outcomes
	int count = 0
	boolean malformed = false
	private RuntimeQuest prepared = null
	private string array[32] grants
	private int grantCount = 0
	private string committedResearch = ""
	construct(string questId, TechnologyRuntime technologies)
		this.questId = questId
		this.technologies = technologies
	/** Transfers ownership, including rejection when the bounded batch is full. */
	function add(QuestRewardOutcome outcome)
		if count >= 32
			destroy outcome
			malformed = true
			return
		outcomes[count] = outcome
		count++
	ondestroy
		for i = 0 to count - 1
			destroy outcomes[i]
	function consumeCommittedResearch() returns string
		let result = committedResearch
		committedResearch = ""
		return result
	function problem(RuntimeQuest definition) returns string
		if malformed or count == 0 or definition == null or definition.id != questId or definition.graph == null or technologies == null
			return "Authored rewards blocked: invalid reward batch."
		if technologies.unlockedCount < 0 or technologies.unlockedCount > 2048
			return "Authored rewards blocked: research completion capacity exceeded."
		var targets = ""
		var needed = 0
		for i = 0 to count - 1
			let outcome = outcomes[i]
			let required = new QuestIds(outcome.requiredStages)
			var valid = required.valid
			for j = 0 to required.count - 1
				if definition.graph.stage(required.ids[j]) == null
					valid = false
			destroy required
			if not valid
				return "Authored rewards blocked: invalid reached-stage qualification."
			if outcome.eligible(definition.graph.reachedStageIds)
				if outcome.operation != "quest_technology_complete_research"
					return "Authored rewards blocked: unsupported outcome " + outcome.id + " (" + outcome.operation + ")."
				if not technologies.validDefinition(technologies.get(outcome.targetId))
					return "Authored rewards blocked: unknown or invalid research " + outcome.targetId + "."
				if not technologies.isUnlocked("player", outcome.targetId) and not questHas(targets, outcome.targetId)
					targets += outcome.targetId + "~"
					needed++
		if needed > 2048 - technologies.unlockedCount
			return "Authored rewards blocked: research completion capacity exceeded."
		return ""
	function prepare(RuntimeQuest definition) returns string
		prepared = null
		grantCount = 0
		committedResearch = ""
		if definition == null or definition.state != QUEST_READY or not definition.ready()
			return "Authored rewards blocked: quest is not ready."
		let issue = problem(definition)
		if issue != ""
			return issue
		var targets = ""
		for i = 0 to count - 1
			let outcome = outcomes[i]
			if outcome.eligible(definition.graph.reachedStageIds) and not technologies.isUnlocked("player", outcome.targetId) and not questHas(targets, outcome.targetId)
				grants[grantCount] = outcome.targetId
				grantCount++
				targets += outcome.targetId + "~"
		prepared = definition
		return ""
	function commitPrepared(RuntimeQuest definition)
		if prepared != definition or definition.state != QUEST_COMPLETE
			return
		// All targets/capacity were checked before the quest transaction. No
		// payment, prerequisite unlock, eligibility callback or projection here.
		for i = 0 to grantCount - 1
			technologies.unlockedKeys[technologies.unlockedCount] = "player:" + grants[i]
			technologies.unlockedCount++
			committedResearch += grants[i] + "~"
		prepared = null
		grantCount = 0
