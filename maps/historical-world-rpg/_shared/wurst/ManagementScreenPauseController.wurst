package ManagementScreenPauseController

/** Boundary that applies the complete campaign pause in the WC3 runtime. */
public interface CampaignPauseRuntime
	function setCampaignPaused(boolean paused)

/** Clock adapters sample fractional elapsed time at the pause boundary. */
public interface CampaignPauseListener
	function onCampaignPause(boolean paused)

/** An idempotent ownership token for one open modal management screen. */
public class ModalManagementScreen
	ManagementScreenPauseController owner
	boolean open = true

	construct(ManagementScreenPauseController owner)
		this.owner = owner

	function close()
		if open
			open = false
			owner.releaseModalManagementScreen()

	function isOpen() returns boolean
		return open

/** Transient UI session: switching views retains one shared pause token.
 * This state is never serialized with campaign authority. */
public class ManagementScreenSession
	ManagementScreenPauseController pauses
	ModalManagementScreen modal = null
	string view = ""
	construct()
		pauses = getManagementScreenPauseController()
	construct(ManagementScreenPauseController pauses)
		this.pauses = pauses
	function open(string view)
		if modal == null
			modal = pauses.openModalManagementScreen()
		this.view = view
	function close()
		if modal != null
			modal.close()
			destroy modal
			modal = null
		view = ""

/**
 * Scenario-neutral campaign pause coordinator for the runtime/UI layer.
 *
 * All campaign/manual pause controls must use this controller so its state
 * remains authoritative; UI code must not call PauseGame directly.
 */
public class ManagementScreenPauseController
	CampaignPauseRuntime runtime
	int modalOwnerCount = 0
	boolean campaignPaused = false
	boolean pausedBeforeFirstModal = false
	CampaignPauseListener array[32] listeners
	int listenerCount = 0

	construct(CampaignPauseRuntime runtime, boolean initiallyPaused)
		this.runtime = runtime
		campaignPaused = initiallyPaused

	/** Open modal management UI and retain this token until that UI closes. */
	function openModalManagementScreen() returns ModalManagementScreen
		if modalOwnerCount == 0
			pausedBeforeFirstModal = campaignPaused
			applyPauseState(true)
		modalOwnerCount++
		return new ModalManagementScreen(this)

	/** Passive HUD panels, tooltips, toasts, and small overlays never pause. */
	function openPassiveUi()
		skip

	/** Route player/manual pause controls through this method. */
	function setManuallyPaused(boolean paused)
		if modalOwnerCount == 0
			applyPauseState(paused)

	function isCampaignPaused() returns boolean
		return campaignPaused
	function isManuallyPaused() returns boolean
		if modalOwnerCount > 0
			return pausedBeforeFirstModal
		return campaignPaused
	/** Restore the durable player choice without closing another UI's token. */
	function restoreManualPause(boolean paused)
		if modalOwnerCount > 0
			pausedBeforeFirstModal = paused
		else
			applyPauseState(paused)
	function subscribe(CampaignPauseListener listener)
		for i = 0 to listenerCount - 1
			if listeners[i] == listener
				return
		listeners[listenerCount] = listener
		listenerCount++
	function unsubscribe(CampaignPauseListener listener)
		for i = 0 to listenerCount - 1
			if listeners[i] == listener
				listenerCount--
				listeners[i] = listeners[listenerCount]
				listeners[listenerCount] = null
				return

	function getModalOwnerCount() returns int
		return modalOwnerCount

	function releaseModalManagementScreen()
		if modalOwnerCount <= 0
			return
		modalOwnerCount--
		if modalOwnerCount == 0
			applyPauseState(pausedBeforeFirstModal)

	function applyPauseState(boolean paused)
		if campaignPaused != paused
			for i = 0 to listenerCount - 1
				listeners[i].onCampaignPause(paused)
			campaignPaused = paused
			runtime.setCampaignPaused(paused)

class WC3CampaignPauseRuntime implements CampaignPauseRuntime
	override function setCampaignPaused(boolean paused)
		PauseGame(paused)

let campaignManagementPause = new ManagementScreenPauseController(new WC3CampaignPauseRuntime(), false)

/** Explicit bootstrap hook for the runtime pause service. */
public function initializeManagementScreenPauseController()
	skip

/** Runtime entry point for modal inventory, technology, economy, and peers. */
public function openModalManagementScreen() returns ModalManagementScreen
	return campaignManagementPause.openModalManagementScreen()

/** Runtime entry point for passive/non-modal UI; never pauses the campaign. */
public function openPassiveCampaignUi()
	campaignManagementPause.openPassiveUi()

/** Runtime entry point for player/manual pause controls. */
public function setCampaignManuallyPaused(boolean paused)
	campaignManagementPause.setManuallyPaused(paused)

public function isCampaignPaused() returns boolean
	return campaignManagementPause.isCampaignPaused()

/** Shared owner-aware controller for playable modal services. */
public function getManagementScreenPauseController() returns ManagementScreenPauseController
	return campaignManagementPause
