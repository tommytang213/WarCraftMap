package CombatEffects

import ExactNatural
import ExactRational
import MilitaryTraditionLayer
import ResearchEntitlements

/** Scenario-authored predicates are compiled from validated weapon, role,
 * ability, movement and ship metadata. Proxy rawcodes alone prove nothing. */
public class CombatProfile
	string id
	int unitTypeId
	int kind
	string categoryId
	string attackId
	string nativeAttack
	CombatProfile next = null
	construct(string id, int unitTypeId, int kind, string categoryId, string attackId, string nativeAttack)
		this.id = id
		this.unitTypeId = unitTypeId
		this.kind = kind
		this.categoryId = categoryId
		this.attackId = attackId
		this.nativeAttack = nativeAttack

class CombatAttribute
	string id
	string categoryId
	string attackId
	string stat
	CombatAttribute next = null
	construct(string id, string categoryId, string attackId, string stat)
		this.id = id
		this.categoryId = categoryId
		this.attackId = attackId
		this.stat = stat

class ResearchCombatWeapon
	string profileId
	ResearchCombatWeapon next = null
	construct(string profileId)
		this.profileId = profileId

public class ResearchCombatBinding
	string sourceId
	string kind
	string contentId
	string categoryId
	string basisPoints
	string description
	string attackId = ""
	ResearchCombatWeapon weapons = null
	ResearchCombatBinding next = null
	construct(string sourceId, string kind, string contentId, string categoryId, string basisPoints, string description)
		this.sourceId = sourceId
		this.kind = kind
		this.contentId = contentId
		this.categoryId = categoryId
		this.basisPoints = basisPoints
		this.description = description
	function qualifies(CombatProfile profile, string attackId) returns boolean
		if profile == null or this.attackId == "" or this.attackId != attackId or profile.attackId != attackId or profile.categoryId != categoryId
			return false
		var entry = weapons
		while entry != null
			if entry.profileId == profile.id
				return true
			entry = entry.next
		return false
	ondestroy
		while weapons != null
			let obsolete = weapons
			weapons = weapons.next
			destroy obsolete
	function inspection(boolean active) returns string
		var status = "inactive"
		if active
			status = "active"
		if attackId != ""
			return sourceId + ": +" + basisPoints + " basis points " + attackId + " damage [bound; " + status + "]; eligible: controller-owned qualified " + categoryId + " weapons (represented or abstract). " + description
		return sourceId + ": +" + basisPoints + " basis points defensive discipline [bound; " + status + "]; eligible: controller-owned " + categoryId + " forces (represented or abstract). " + description

/** Retains every entitlement and forwards an independent copy to existing
 * consumers. Only generated, typed combat bindings claim a new consumer. */
public class CombatResearchEffects extends UnboundResearchEffects
	CombatBindings bindings
	TechnologyEffectPort other
	construct(CombatBindings bindings, TechnologyEffectPort other)
		this.bindings = bindings
		this.other = other
	override function bindingStatus(ResearchUnlock definition) returns string
		if bindings != null and bindings.researchBinding(definition.kind, definition.contentId) != null
			return RESEARCH_BOUND
		if other != null
			return other.bindingStatus(definition)
		return RESEARCH_UNBOUND
	override function replaceResearchEntitlements(ResearchEntitlements result)
		if other != null
			let copy = new ResearchEntitlements(result.controllerId)
			var entry = result.first
			while entry != null
				copy.add(entry)
				entry = entry.next
			other.replaceResearchEntitlements(copy)
		super.replaceResearchEntitlements(result)
	function earned(string controllerId, ResearchCombatBinding binding) returns boolean
		let layer = get(controllerId)
		return layer != null and layer.has(binding.kind, binding.contentId)

public class CombatEffect
	string id
	string sourceId
	string categoryId
	string description
	CombatSources contributions = new CombatSources()
	CombatEffect next = null
	construct(string id, string sourceId, string categoryId, string description)
		this.id = id
		this.sourceId = sourceId
		this.categoryId = categoryId
		this.description = description
	ondestroy
		destroy contributions

class CombatSource
	string id
	string attackId
	string stat
	ExactRational value
	CombatSource next = null
	construct(string id, string attackId, string stat, ExactRational value)
		this.id = id
		this.attackId = attackId
		this.stat = stat
		this.value = value
	ondestroy
		destroy value

/** A named source contributes once per typed stat. Research/equipment can own
 * separate stores; milestone replacement never removes their contributions. */
public class CombatSources
	private CombatSource entries = null
	/** Takes ownership of value. Reconciliation replaces rather than adds. */
	function replace(string id, string attackId, string stat, ExactRational value)
		var entry = entries
		while entry != null
			if entry.id == id and entry.attackId == attackId and entry.stat == stat
				destroy entry.value
				entry.value = value
				return
			entry = entry.next
		let added = new CombatSource(id, attackId, stat, value)
		added.next = entries
		entries = added
	function appendRating(ExactRational total, string attackId, string stat, CombatBindings bindings)
		var entry = entries
		while entry != null
			if entry.attackId == attackId and entry.stat == stat and (bindings == null or not bindings.reservedSource(entry.id))
				total.add(entry.value)
			entry = entry.next
	function inspection() returns string
		var result = ""
		var entry = entries
		while entry != null
			result += " | " + entry.attackId + " " + entry.stat + ": +" + entry.value.display() + " basis points"
			entry = entry.next
		return result
	ondestroy
		while entries != null
			let obsolete = entries
			entries = entries.next
			destroy obsolete

/** A single transient delivery receipt. Duplicate tactical/abstract deliveries
 * return its committed result; death callbacks consume loss without re-scaling.
 * Receipts never cross a callback generation, map rebuild, or load transaction. */
public class CombatHit
	string attackId
	ExactRational damage
	boolean applied = false
	boolean modified = false
	construct(string attackId, ExactRational baseDamage)
		this.attackId = attackId
		damage = baseDamage
	ondestroy
		destroy damage

public class CombatBindings
	private CombatProfile profiles = null
	private CombatEffect effects = null
	private CombatAttribute attributes = null
	private ResearchCombatBinding researchBindings = null
	CombatResearchEffects research = null
	function profile(string id, int unitTypeId, int kind) returns CombatProfile
		var entry = profiles
		while entry != null
			if entry.id == id and entry.unitTypeId == unitTypeId and entry.kind == kind
				return entry
			entry = entry.next
		return null
	function addProfile(string id, int unitTypeId, int kind, string categoryId, string attackId, string nativeAttack)
		let entry = new CombatProfile(id, unitTypeId, kind, categoryId, attackId, nativeAttack)
		entry.next = profiles
		profiles = entry
	function addAttribute(string id, string categoryId, string attackId, string stat)
		let entry = new CombatAttribute(id, categoryId, attackId, stat)
		entry.next = attributes
		attributes = entry
	function addResearch(string sourceId, string kind, string contentId, string recipientKind, string categoryId, string stat, string basisPoints, string description)
		// Unsupported recipient/stat metadata can never activate a binding.
		if recipientKind != "force_category" or stat != "discipline" or not defensiveCategory(categoryId) or not exactNaturalValid(basisPoints)
			return
		let entry = new ResearchCombatBinding(sourceId, kind, contentId, categoryId, basisPoints, description)
		entry.next = researchBindings
		researchBindings = entry
	/** Qualified attack research is separate from defensive category research.
	 * Profile IDs below are compiled from authoritative weapon metadata. */
	function addResearchAttack(string sourceId, string kind, string contentId, string categoryId, string attackId, string basisPoints, string description)
		if attackId == "" or not exactNaturalValid(basisPoints)
			return
		let entry = new ResearchCombatBinding(sourceId, kind, contentId, categoryId, basisPoints, description)
		entry.attackId = attackId
		entry.next = researchBindings
		researchBindings = entry
	function addResearchWeapon(string sourceId, string profileId)
		var entry = researchBindings
		while entry != null
			if entry.sourceId == sourceId and entry.attackId != ""
				let weapon = new ResearchCombatWeapon(profileId)
				weapon.next = entry.weapons
				entry.weapons = weapon
				return
			entry = entry.next
	function researchBinding(string kind, string contentId) returns ResearchCombatBinding
		var entry = researchBindings
		while entry != null
			if entry.kind == kind and entry.contentId == contentId
				return entry
			entry = entry.next
		return null
	function addEffect(string id, string sourceId, string categoryId, string description) returns CombatEffect
		let entry = new CombatEffect(id, sourceId, categoryId, description)
		entry.next = effects
		effects = entry
		return entry
	function binding(string id) returns CombatEffect
		var entry = effects
		while entry != null
			if entry.id == id
				return entry
			entry = entry.next
		return null
	function milestoneSource(string id) returns boolean
		var entry = effects
		while entry != null
			if entry.sourceId == id
				return true
			entry = entry.next
		return false
	function reservedSource(string id) returns boolean
		if milestoneSource(id)
			return true
		var entry = researchBindings
		while entry != null
			if entry.sourceId == id
				return true
			entry = entry.next
		return false
	function defensiveCategory(string categoryId) returns boolean
		var entry = attributes
		while entry != null
			if entry.categoryId == categoryId and entry.stat == "discipline"
				return true
			entry = entry.next
		return false
	function discipline(TraditionLayer layer, string controllerId, string categoryId) returns ExactRational
		let result = new ExactRational("0", "1", "1")
		if not defensiveCategory(categoryId)
			return result
		var attribute = attributes
		while attribute != null
			if attribute.stat == "discipline" and attribute.categoryId == categoryId and layer != null and layer.controllerId == controllerId and layer.categoryId == categoryId
				let value = layer.modifier(attribute.id)
				if value != null
					result.add(value)
			attribute = attribute.next
		var entry = researchBindings
		while entry != null
			if entry.attackId == "" and entry.categoryId == categoryId and research != null and research.earned(controllerId, entry)
				let value = new ExactRational(entry.basisPoints, "1", "1")
				result.add(value)
				destroy value
			entry = entry.next
		return result
	function compatible(TraditionLayer layer, CombatProfile profile, string attackId) returns boolean
		return layer != null and profile != null and attackId != "" and profile.attackId == attackId and layer.categoryId == profile.categoryId
	function knownEffects(TraditionLayer layer) returns boolean
		if layer == null
			return true
		var reached = layer.reached
		while reached != null
			if this.binding(reached.effectId) == null
				return false
			reached = reached.next
		return true
	function rating(TraditionLayer layer, CombatProfile profile, string attackId, string stat) returns ExactRational
		let result = new ExactRational("0", "1", "1")
		if not compatible(layer, profile, attackId)
			return result
		if stat == "damage"
			var attribute = attributes
			while attribute != null
				if attribute.stat == stat and attribute.attackId == attackId and attribute.categoryId == layer.categoryId
					let value = layer.modifier(attribute.id)
					if value != null
						result.add(value)
				attribute = attribute.next
		var reached = layer.reached
		while reached != null
			if (reached castTo ReachedTraditionMilestone).active
				let binding = this.binding(reached.effectId)
				if binding != null and binding.categoryId == layer.categoryId
					binding.contributions.appendRating(result, attackId, stat, null)
			reached = reached.next
		return result
	function researchDamage(string controllerId, string categoryId, CombatProfile profile, string attackId) returns ExactRational
		let result = new ExactRational("0", "1", "1")
		var entry = researchBindings
		while entry != null
			if entry.categoryId == categoryId and entry.qualifies(profile, attackId) and research != null and research.earned(controllerId, entry)
				let value = new ExactRational(entry.basisPoints, "1", "1")
				result.add(value)
				destroy value
			entry = entry.next
		return result
	/** The sole rating-to-damage boundary, used by native and abstract combat.
	 * Input legality and actual weapon validation precede any contribution. */
	function apply(CombatHit hit, boolean legalAttack, TraditionLayer attacker, CombatProfile source, TraditionLayer defender, CombatProfile target, CombatSources attackSources, CombatSources defenseSources)
		var controllerId = ""
		var categoryId = ""
		if defender != null
			controllerId = defender.controllerId
			categoryId = defender.categoryId
		applyForRecipient(hit, legalAttack, attacker, source, defender, target, attackSources, defenseSources, controllerId, categoryId)
	function applyForRecipient(CombatHit hit, boolean legalAttack, TraditionLayer attacker, CombatProfile source, TraditionLayer defender, CombatProfile target, CombatSources attackSources, CombatSources defenseSources, string controllerId, string categoryId)
		var sourceController = ""
		var sourceCategory = ""
		if attacker != null
			sourceController = attacker.controllerId
			sourceCategory = attacker.categoryId
		applyForCombatants(hit, legalAttack, attacker, source, defender, target, attackSources, defenseSources, sourceController, sourceCategory, controllerId, categoryId)
	/** Research ownership is authoritative even without a tradition track. */
	function applyForCombatants(CombatHit hit, boolean legalAttack, TraditionLayer attacker, CombatProfile source, TraditionLayer defender, CombatProfile target, CombatSources attackSources, CombatSources defenseSources, string sourceController, string sourceCategory, string controllerId, string categoryId)
		if hit.applied
			return
		hit.applied = true
		if not legalAttack or hit.damage.negative() or hit.damage.numerator == "0" or not knownEffects(attacker) or not knownEffects(defender)
			return
		let weapon = source != null and hit.attackId != "" and source.attackId == hit.attackId
		var attack = new ExactRational("0", "1", "1")
		let resistance = discipline(defender, controllerId, categoryId)
		if weapon
			destroy attack
			attack = rating(attacker, source, hit.attackId, "damage")
			let researchRating = researchDamage(sourceController, sourceCategory, source, hit.attackId)
			attack.add(researchRating)
			destroy researchRating
			let weaponResistance = rating(defender, target, hit.attackId, "resistance")
			resistance.add(weaponResistance)
			destroy weaponResistance
			if attackSources != null
				attackSources.appendRating(attack, hit.attackId, "damage", this)
			if defenseSources != null
				defenseSources.appendRating(resistance, hit.attackId, "resistance", this)
		if defenseSources != null and defensiveCategory(categoryId)
			defenseSources.appendRating(resistance, "", "discipline", this)
		resistance.nonnegative()
		hit.modified = attack.numerator != "0" or resistance.numerator != "0"
		let baseline = new ExactRational("10000", "1", "1")
		attack.add(baseline)
		attack.nonnegative()
		resistance.add(baseline)
		hit.damage.multiply(attack)
		hit.damage.dividePositive(resistance)
		destroy baseline
		destroy attack
		destroy resistance
	function inspection(TraditionLayer layer, CombatProfile profile, boolean alive) returns string
		var result = ""
		var reached = layer.reached
		while reached != null
			let binding = this.binding(reached.effectId)
			if binding == null
				result += " | " + reached.effectId + ": unbound (release blocker)"
			else
				result += " | " + binding.id + " [" + binding.sourceId + "]: " + binding.description
				if not (reached castTo ReachedTraditionMilestone).active
					result += " [replaced]"
				else if not alive or profile == null or profile.attackId == "" or profile.categoryId != layer.categoryId
					result += " [inactive: no eligible weapon/force]"
				else
					result += " [active on " + profile.attackId + "]"
				result += binding.contributions.inspection()
			reached = reached.next
		var attribute = layer.modifiers
		while attribute != null
			var bound = false
			var consumer = attributes
			while consumer != null
				if consumer.id == attribute.attributeId and consumer.stat != ""
					bound = true
				consumer = consumer.next
			if not bound
				result += " | " + attribute.attributeId + ": consumer pending"
			else
				result += " | " + attribute.attributeId + ": bound"
			attribute = attribute.next
		return result
	function researchInspection(string controllerId, string categoryId, boolean alive) returns string
		return researchInspection(controllerId, categoryId, alive, null, false)
	function researchInspection(string controllerId, string categoryId, boolean alive, CombatProfile profile, boolean checkWeapon) returns string
		var result = ""
		var entry = researchBindings
		while entry != null
			let earned = research != null and research.earned(controllerId, entry)
			if entry.categoryId == categoryId or earned
				result += " | " + entry.inspection(alive and earned and entry.categoryId == categoryId and (not checkWeapon or entry.attackId == "" or entry.qualifies(profile, entry.attackId)))
				if not earned
					result += " [research not completed]"
				else if entry.categoryId != categoryId
					result += " [ineligible category]"
				else if checkWeapon and entry.attackId != "" and not entry.qualifies(profile, entry.attackId)
					result += " [incompatible weapon]"
				else if not alive
					result += " [inactive force]"
			entry = entry.next
		return result
	ondestroy
		while researchBindings != null
			let obsolete = researchBindings
			researchBindings = researchBindings.next
			destroy obsolete
		while profiles != null
			let obsolete = profiles
			profiles = profiles.next
			destroy obsolete
		while effects != null
			let obsolete = effects
			effects = effects.next
			destroy obsolete
		while attributes != null
			let obsolete = attributes
			attributes = attributes.next
			destroy obsolete
