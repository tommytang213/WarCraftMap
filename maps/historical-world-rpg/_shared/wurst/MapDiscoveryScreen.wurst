package MapDiscoveryScreen

import ManagementScreenPauseController

public constant string MAP_CONTEXT_CLOSED = "closed"
public constant string MAP_CONTEXT_WORLD = "world"
public constant string MAP_CONTEXT_REGIONAL = "regional"

/** Presentation boundary. Authorized render data is prepared by map knowledge. */
public interface MapPresentationRuntime
	function showWorldMap(string physicalRegionId, string commandRegionId)
	function showRegionalMap(string regionId, string physicalRegionId, string commandRegionId)
	function focusExact(string locationId)
	function focusSearchArea(string searchAreaId)
	function hideMap()

/**
 * Modal map view state. Focus changes are informational and deliberately have
 * no unit, camera-transition, pathing, or regional-activation dependency.
 */
public class MapDiscoveryScreenController
	ManagementScreenPauseController pauses
	MapPresentationRuntime presentation
	ModalManagementScreen modal = null
	string context = MAP_CONTEXT_CLOSED
	string physicalRegionId
	string commandRegionId
	string focusedRegionId = ""

	construct(ManagementScreenPauseController pauses, MapPresentationRuntime presentation, string physicalRegionId, string commandRegionId)
		this.pauses = pauses
		this.presentation = presentation
		this.physicalRegionId = physicalRegionId
		this.commandRegionId = commandRegionId

	function acquireModal()
		if modal == null
			modal = pauses.openModalManagementScreen()

	function openWorldMap()
		acquireModal()
		context = MAP_CONTEXT_WORLD
		focusedRegionId = ""
		presentation.showWorldMap(physicalRegionId, commandRegionId)

	function openRegionalMap(string regionId)
		acquireModal()
		context = MAP_CONTEXT_REGIONAL
		focusedRegionId = regionId
		presentation.showRegionalMap(regionId, physicalRegionId, commandRegionId)

	function focusKnownLocation(string regionId, string locationId)
		openRegionalMap(regionId)
		presentation.focusExact(locationId)

	function focusKnownSearchArea(string regionId, string searchAreaId)
		openRegionalMap(regionId)
		presentation.focusSearchArea(searchAreaId)

	function setCommandRegion(string regionId)
		commandRegionId = regionId

	function setPhysicalRegion(string regionId)
		physicalRegionId = regionId

	function close()
		if modal != null
			presentation.hideMap()
			modal.close()
			modal = null
		context = MAP_CONTEXT_CLOSED
		focusedRegionId = ""

	function getContext() returns string
		return context

	function getPhysicalRegionId() returns string
		return physicalRegionId

	function getCommandRegionId() returns string
		return commandRegionId

	function getFocusedRegionId() returns string
		return focusedRegionId
