public function compatSetUnitProtection(unit target, int source, boolean shouldProtect)
	compatUnitProtection().set(target, source, shouldProtect)
public class WarcraftUnitProtectionNatives implements UnitProtectionNatives
	override function exists(unit target) returns boolean
		return target != null and GetUnitTypeId(target) != 0
	override function isInvulnerable(unit target) returns boolean
		return BlzIsUnitInvulnerable(target)
	override function setInvulnerable(unit target, boolean value)
		SetUnitInvulnerable(target, value)
RuntimeProtection unitProtection = null
public function compatUnitProtection() returns RuntimeProtection
	if unitProtection == null
		unitProtection = new RuntimeProtection(new WarcraftUnitProtectionNatives())
	return unitProtection

/** Recordable native context: normalization below is shared by retail and the
 * installed-adapter fixtures. Producers are deliberately separate recipients. */
public interface GodModeNatives
	function enumerateUnits()
	function nextUnit() returns unit
	function ownerIndex(unit target) returns int
	function registerEnter(trigger listener)
	function registerPlayerEvent(trigger listener, player owner, playerunitevent eventType)
	function registerSweep(trigger listener)
	function retire(trigger listener)
	function eventListener() returns trigger
	function eventId() returns eventid
	function triggerUnit() returns unit
	function enteringUnit() returns unit
	function summonedUnit() returns unit
	function trainedUnit() returns unit
	function constructedUnit() returns unit

public class WarcraftGodModeNatives implements GodModeNatives
	group enumerated = CreateGroup()
	region world = null
	override function enumerateUnits()
		if enumerated == null
			enumerated = CreateGroup()
		GroupClear(enumerated)
		let bounds = GetWorldBounds()
		GroupEnumUnitsInRect(enumerated, bounds, null)
		RemoveRect(bounds)
	override function nextUnit() returns unit
		let target = FirstOfGroup(enumerated)
		if target != null
			GroupRemoveUnit(enumerated, target)
		return target
	override function ownerIndex(unit target) returns int
		return GetPlayerId(GetOwningPlayer(target))
	override function registerEnter(trigger listener)
		world = CreateRegion()
		let bounds = GetWorldBounds()
		RegionAddRect(world, bounds)
		RemoveRect(bounds)
		TriggerRegisterEnterRegion(listener, world, null)
	override function registerPlayerEvent(trigger listener, player owner, playerunitevent eventType)
		TriggerRegisterPlayerUnitEvent(listener, owner, eventType, null)
	override function registerSweep(trigger listener)
		TriggerRegisterTimerEvent(listener, 1., true)
	override function retire(trigger listener)
		DestroyTrigger(listener)
		if world != null
			RemoveRegion(world)
			world = null
		DestroyGroup(enumerated)
		enumerated = null
	override function eventListener() returns trigger
		return GetTriggeringTrigger()
	override function eventId() returns eventid
		return GetTriggerEventId()
	override function triggerUnit() returns unit
		return GetTriggerUnit()
	override function enteringUnit() returns unit
		return GetEnteringUnit()
	override function summonedUnit() returns unit
		return GetSummonedUnit()
	override function trainedUnit() returns unit
		return GetTrainedUnit()
	override function constructedUnit() returns unit
		return GetConstructedStructure()

public function compatGodModeEventEntity(GodModeNatives natives) returns unit
	let kind = natives.eventId()
	if kind == EVENT_GAME_ENTER_REGION
		return natives.enteringUnit()
	if kind == EVENT_PLAYER_UNIT_SUMMON
		return natives.summonedUnit()
	if kind == EVENT_PLAYER_UNIT_TRAIN_FINISH
		return natives.trainedUnit()
	if kind == EVENT_PLAYER_UNIT_CONSTRUCT_FINISH
		return natives.constructedUnit()
	if kind == EVENT_PLAYER_UNIT_CHANGE_OWNER
		return natives.triggerUnit()
	return null
public function compatEnteringUnit() returns unit
	return GetEnteringUnit()
public function compatAddUnitAbility(unit target, int abilityId)
	UnitAddAbility(target, abilityId)
public function compatRemoveUnitAbility(unit target, int abilityId)
	UnitRemoveAbility(target, abilityId)
public function compatGetUnitCollisionSize(unit target) returns real
	return BlzGetUnitCollisionSize(target)

// Pre-damage validation must run before lethal damage and the death event.
public function compatRegisterCombatEvents(trigger damage, trigger death)
	for i = 0 to bj_MAX_PLAYER_SLOTS - 1
		TriggerRegisterPlayerUnitEvent(damage, Player(i), EVENT_PLAYER_UNIT_DAMAGING, null)
		TriggerRegisterPlayerUnitEvent(death, Player(i), EVENT_PLAYER_UNIT_DEATH, null)
public function compatCancelCombatDamage()
	BlzSetEventDamage(0.)

// Development benchmark operations. Keeping these natives here makes the
// benchmark compile against the pinned patch without creating a second
// version-specific boundary.
public function compatBenchmarkCreateUnit(player owner, int unitType, real x, real y) returns unit
	return CreateUnit(owner, unitType, x, y, 0.)
public function compatBenchmarkRemoveUnit(unit target)
	RemoveUnit(target)
public function compatBenchmarkCreateEffect(string modelPath, real x, real y) returns effect
	return AddSpecialEffect(modelPath, x, y)
public function compatBenchmarkDestroyEffect(effect target)
	DestroyEffect(target)
public function compatBenchmarkIssuePointOrder(unit target, string order, real x, real y) returns boolean
	return IssuePointOrder(target, order, x, y)
public function compatBenchmarkIsTerrainPathable(real x, real y, pathingtype kind) returns boolean
	return IsTerrainPathable(x, y, kind)
public function compatBenchmarkClockMilliseconds() returns real
	return TimerGetElapsed(bj_gameStartedTimer) * 1000.
