/** Physical-map handoff. Campaign authority is committed to game cache before this is called. */
@noinline
public function compatLoadPhysicalMap(string mapPath)
	// SetNextLevelBJ only assigns BJ state; EndGame does not consume it.
	// The optimizer drops that unused assignment. Pass the committed campaign
	// destination directly to the native that both selects and loads the map.
	ChangeLevel(mapPath, true)

