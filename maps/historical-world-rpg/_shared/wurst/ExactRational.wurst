package ExactRational
import ExactNatural

/** Exact decimal arithmetic for derived values. Neither signed coefficients nor
 * denominators pass through a whole-value native integer or real conversion. */
function subtractNatural(string first, string second) returns string
	var b = StringLength(second) - 1
	var borrow = 0
	var result = ""
	for a = StringLength(first) - 1 downto 0
		var digit = S2I(SubString(first, a, a + 1)) - borrow
		if b >= 0
			digit -= S2I(SubString(second, b, b + 1))
		borrow = 0
		if digit < 0
			digit += 10
			borrow = 1
		result = I2S(digit) + result
		b--
	var start = 0
	while start < StringLength(result) - 1 and SubString(result, start, start + 1) == "0"
		start++
	return SubString(result, start, StringLength(result))

public function exactNaturalProduct(string first, string second) returns string
	var result = "0"
	for i = 0 to StringLength(second) - 1
		if result != "0"
			result += "0"
		result = exactNaturalAdd(result, exactNaturalMultiply(first, S2I(SubString(second, i, i + 1))))
	return result

/** Long division, with at most nine subtractions per digit. Caller supplies a
 * positive canonical divisor. All temporary values are expandable strings. */
class NaturalDivision
	string quotient = ""
	string remainder = "0"
	construct(string value, string divisor)
		for i = 0 to StringLength(value) - 1
			let digit = SubString(value, i, i + 1)
			if remainder == "0"
				remainder = digit
			else
				remainder += digit
			var q = 0
			while exactNaturalCompare(remainder, divisor) >= 0
				remainder = subtractNatural(remainder, divisor)
				q++
			if quotient != "" or q > 0
				quotient += I2S(q)
		if quotient == ""
			quotient = "0"

function naturalGcd(string first, string second) returns string
	var a = first
	var b = second
	while b != "0"
		let division = new NaturalDivision(a, b)
		a = b
		b = division.remainder
		destroy division
	return a

/** A bounded denominator permits a bounded remainder, never a bounded XP.
 * Avoid string division in the common small-coefficient reconstruction path. */
function boundedRemainder(string value, int divisor) returns int
	var remainder = 0
	for i = 0 to StringLength(value) - 1
		let digit = S2I(SubString(value, i, i + 1))
		if divisor <= 214748364
			remainder = (remainder * 10 + digit) mod divisor
		else
			var next = digit mod divisor
			for j = 1 to 10
				if next >= divisor - remainder
					next -= divisor - remainder
				else
					next += remainder
			remainder = next
	return remainder

/** Reduced signed numerator / positive denominator. The value is authority for
 * a derived layer; future native consumers must report their own limitations. */
public class ExactRational
	string numerator
	string denominator
	construct(string experience, string coefficientNumerator, string coefficientDenominator)
		numerator = "0"
		denominator = "1"
		if experience != "0" and coefficientNumerator != "0"
			let negative = coefficientNumerator.startsWith("-")
			var magnitude = coefficientNumerator
			if negative
				magnitude = SubString(magnitude, 1, StringLength(magnitude))
			var product = experience
			if magnitude != "1"
				product = exactNaturalProduct(experience, magnitude)
			if exactNaturalCompare(coefficientDenominator, "2147483647") <= 0
				let bounded = S2I(coefficientDenominator)
				var divisor = bounded
				var remainder = boundedRemainder(product, bounded)
				while remainder != 0
					let previous = divisor
					divisor = remainder
					remainder = previous mod remainder
				numerator = product
				if divisor != 1
					numerator = exactNaturalDivide(product, divisor)
				denominator = I2S(bounded div divisor)
			else
				let divisor = naturalGcd(product, coefficientDenominator)
				let top = new NaturalDivision(product, divisor)
				let bottom = new NaturalDivision(coefficientDenominator, divisor)
				numerator = top.quotient
				denominator = bottom.quotient
				destroy top
				destroy bottom
			if negative
				numerator = "-" + numerator
	function display() returns string
		if denominator == "1"
			return numerator
		return numerator + "/" + denominator
	function copy() returns ExactRational
		return new ExactRational("1", numerator, denominator)
	function negative() returns boolean
		return numerator.startsWith("-")
	function magnitude() returns string
		if negative()
			return SubString(numerator, 1, StringLength(numerator))
		return numerator
	function assign(string top, string bottom)
		let reduced = new ExactRational("1", top, bottom)
		numerator = reduced.numerator
		denominator = reduced.denominator
		destroy reduced
	/** Mutating arithmetic owns no operand. No whole-value real/int conversion. */
	function add(ExactRational other)
		let left = exactNaturalProduct(magnitude(), other.denominator)
		let right = exactNaturalProduct(other.magnitude(), denominator)
		var top = "0"
		if negative() == other.negative()
			top = exactNaturalAdd(left, right)
			if negative() and top != "0"
				top = "-" + top
		else if exactNaturalCompare(left, right) >= 0
			top = subtractNatural(left, right)
			if negative() and top != "0"
				top = "-" + top
		else
			top = subtractNatural(right, left)
			if other.negative() and top != "0"
				top = "-" + top
		assign(top, exactNaturalProduct(denominator, other.denominator))
	function multiply(ExactRational other)
		var top = exactNaturalProduct(magnitude(), other.magnitude())
		if negative() != other.negative() and top != "0"
			top = "-" + top
		assign(top, exactNaturalProduct(denominator, other.denominator))
	function dividePositive(ExactRational other)
		if other.negative() or other.numerator == "0"
			return
		var top = exactNaturalProduct(magnitude(), other.denominator)
		if negative() and top != "0"
			top = "-" + top
		assign(top, exactNaturalProduct(denominator, other.numerator))
	function nonnegative()
		if negative()
			numerator = "0"
			denominator = "1"
	function floorNatural() returns string
		if negative()
			return "0"
		let division = new NaturalDivision(numerator, denominator)
		let result = division.quotient
		destroy division
		return result
	/** Native damage boundary only. Eight leading digits retain native real
	 * precision; scaling avoids overflow even for thousand-digit XP. The native
	 * projection saturates at a finite 1e30, never the exact combat/XP authority. */
	function nativeDamage() returns real
		if negative() or numerator == "0"
			return 0.
		let topDigits = IMinBJ(8, StringLength(numerator))
		let bottomDigits = IMinBJ(8, StringLength(denominator))
		var result = S2R(SubString(numerator, 0, topDigits)) / S2R(SubString(denominator, 0, bottomDigits))
		var exponent = StringLength(numerator) - topDigits - StringLength(denominator) + bottomDigits
		while exponent > 0
			if result >= 100000000000000000000000000000.
				return 1000000000000000000000000000000.
			result *= 10.
			exponent--
		while exponent < 0 and result > 0.
			result /= 10.
			exponent++
		return result

/** Native damage enters at nine decimal places. This is a damage boundary,
 * never a conversion of saved XP or a derived coefficient. */
public function exactNativeDamage(real amount) returns ExactRational
	let text = R2SW(RMaxBJ(0., amount), 0, 9)
	var digits = ""
	var denominator = "1"
	var fractional = false
	for i = 0 to StringLength(text) - 1
		let digit = SubString(text, i, i + 1)
		if digit == "."
			fractional = true
		else if digit != " "
			if digits != "" or digit != "0"
				digits += digit
			if fractional
				denominator += "0"
	if digits == ""
		digits = "0"
	return new ExactRational(digits, "1", denominator)
