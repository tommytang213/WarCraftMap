package HeroProgressionVectorsTests
import HeroProgression
import WarcraftRpgRuntime

// Generated by test_live_hero_progression.py --write-vectors. Literal floors
// and costs are independently checked against the headless progression engine.
function checkHeroThreshold(int level, int floor, int cost, int previousCost)
	heroExperienceForLevel(level).assertEquals(floor)
	heroNextLevelExperience(level).assertEquals(cost)
	heroLevelForExperience(floor).assertEquals(level)
	let hero = new RpgHero("vector", "Vector", 'Hpal')
	if level > 1
		hero.awardExperience(floor - 1).assertTrue()
		hero.level.assertEquals(level - 1)
		hero.experience.assertEquals(previousCost - 1)
		hero.awardExperience(1).assertTrue()
	hero.level.assertEquals(level)
	hero.experience.assertEquals(0)
	hero.cumulativeExperience().assertEquals(floor)
	hero.skillPoints.assertEquals(level - 1)
	hero.masteryPoints.assertEquals(level div 5)
	hero.choicePoints.assertEquals(level div 10)
	if level < 300
		hero.awardExperience(cost - 1).assertTrue()
		hero.level.assertEquals(level)
		hero.experience.assertEquals(cost - 1)
		hero.awardExperience(1).assertTrue()
		hero.level.assertEquals(level + 1)
		hero.experience.assertEquals(0)
		hero.skillPoints.assertEquals(level)
		hero.masteryPoints.assertEquals((level + 1) div 5)
		hero.choicePoints.assertEquals((level + 1) div 10)
	else
		hero.awardExperience(300).assertTrue()
		hero.level.assertEquals(300)
		hero.experience.assertEquals(300)
		hero.skillPoints.assertEquals(299)
		hero.masteryPoints.assertEquals(60)
		hero.choicePoints.assertEquals(30)
	destroy hero

