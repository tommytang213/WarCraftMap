package PlayableTradeTests
import PlayableTrade

class Presentation implements TradePresentation
	string market=""
	string result=""
	override function showMarket(player p,string marketId,string rows)
		market=marketId+"|"+rows
	override function showTradeResult(player p,string message)
		result=message

@test function playerCanInspectBuyCarryMoveAndSellCargo()
	let progress=new MerchantProgress()
	let controller=new PlayableTradeController(progress)
	let ui=new Presentation()
	let calicut=new RuntimeMarket("calicut","Pepper",100,10000,10,8)
	let london=new RuntimeMarket("london","Pepper",5,10000,30,25)
	let ship=new TradeStore("ship_hold",12,1000)
	let warehouse=new TradeStore("london_warehouse",50,0)
	inspectMarket(null,calicut,ui)
	ui.market.assertEquals("calicut|Pepper: 100 available; buy 10; sell 8; steady")
	buyCargo(null,"buy_1",calicut,ship,10,controller,ui)
	ui.result.assertEquals("Bought 10 Pepper.")
	ship.cargo.assertEquals(10)
	controller.moveCargo("unload",ship,warehouse,4).assertEquals("Cargo moved.")
	controller.moveCargo("reload",warehouse,ship,4).assertEquals("Cargo moved.")
	sellCargo(null,"sell_1",london,ship,10,2000,controller,ui)
	// Commit quote: 30 base * 1000 stock pressure / 1000 = 30;
	// sell spread floors 30 * 920 / 1000 to 27. Cost 100, proceeds 270.
	ui.result.assertEquals("Sold 10 Pepper; realized P/L 170.")
	ship.cargo.assertEquals(0)
	ship.money.assertEquals(1170)
	progress.realizedProfit.assertEquals(170)
	progress.standing.assertEquals(340)
	progress.warehouseAccess().assertEquals(true)

@test function runtimeRejectsCapacityAndDuplicateTransactions()
	let controller=new PlayableTradeController(new MerchantProgress())
	let market=new RuntimeMarket("port","Grain",100,1000,2,1)
	let ship=new TradeStore("ship",3,100)
	controller.buy("large",market,ship,4).assertEquals("Cargo capacity is insufficient.")
	controller.buy("once",market,ship,2).assertEquals("Bought 2 Grain.")
	controller.buy("once",market,ship,1).assertEquals("Transaction already processed.")
	ship.cargo.assertEquals(2)

@test function repeatedRouteStandingDiminishes()
	let progress=new MerchantProgress()
	let controller=new PlayableTradeController(progress)
	let source=new RuntimeMarket("source","Silk",100,10000,10,8)
	let sink=new RuntimeMarket("sink","Silk",1,10000,30,25)
	let ship=new TradeStore("ship",20,1000)
	controller.buy("b1",source,ship,2)
	controller.sell("s1",sink,ship,2,1000)
	let first=progress.standing
	controller.buy("b2",source,ship,2)
	controller.sell("s2",sink,ship,2,1000)
	let second=progress.standing-first
	(first>second).assertEquals(true)

@test function staleDisplayRestrictionsAndFailuresRollbackAtomically()
	let controller=new PlayableTradeController(new MerchantProgress())
	let market=new RuntimeMarket("port","Grain",5,100,10,8)
	let ship=new TradeStore("ship",2,15)
	let displayed=market.buyUnitPrice
	// Change authority after displaying 10; editing a cached quote is not a
	// price change. Shortage 200 permille produces a commit price of 12.
	market.shortagePermille=200
	controller.buy("repriced",market,ship,1).assertEquals("Bought 1 Grain.")
	(displayed<market.buyUnitPrice).assertEquals(true)
	market.buyUnitPrice.assertEquals(12)
	ship.money.assertEquals(3)
	let stock=market.stock
	let money=ship.money
	controller.buy("no-money",market,ship,1).assertEquals("Funds are insufficient.")
	market.stock.assertEquals(stock)
	ship.money.assertEquals(money)
	market.buyUnitPrice.assertEquals(12)
	market.previousUnitPrice.assertEquals(displayed)
	controller.seen("no-money").assertFalse()
	market.blockaded=true
	controller.sell("blocked",market,ship,1,1000).assertEquals("Market access is restricted.")
	ship.cargo.assertEquals(1)
	market.blockaded=false
	market.occupiedByHostile=true
	controller.buy("occupied",market,ship,1).assertEquals("Market access is restricted.")
	market.occupiedByHostile=false
	market.discovered=false
	controller.buy("hidden",market,ship,1).assertEquals("Commodity is not discovered.")

@test function tradeAuthoritySurvivesRuntimeReconstruction()
	let original=new PlayableTradeRuntime()
	original.registerMarket(new RuntimeMarket("calicut","grain",320,20000,8,7))
	original.registerMarket(new RuntimeMarket("london","grain",24,12000,18,16))
	original.registerStore(new TradeStore("cargo:test_ship",30,1000))
	original.newCampaign("calicut")
	original.controller.buy("persist-buy",original.market,original.hold,3)
	original.selectMarket("london","grain")
	original.market.shortagePermille=300
	original.market.productionPermille=775
	original.market.consumptionPermille=1425
	original.controller.sell("persist-sell",original.market,original.hold,1,2000)
	let saved=original.capture()
	let resumed=new PlayableTradeRuntime()
	resumed.registerMarket(new RuntimeMarket("calicut","grain",320,20000,8,7))
	resumed.registerMarket(new RuntimeMarket("london","grain",24,12000,18,16))
	resumed.registerStore(new TradeStore("warehouse:london",200,0))
	resumed.registerStore(new TradeStore("cargo:test_ship",30,1000))
	resumed.reconstruct(saved).assertEquals(true)
	resumed.hold.id.assertEquals("cargo:test_ship")
	resumed.hold.cargo.assertEquals(original.hold.cargo)
	resumed.controller.carriedCost.assertEquals(original.controller.carriedCost)
	resumed.progress.realizedProfit.assertEquals(original.progress.realizedProfit)
	resumed.progress.standing.assertEquals(original.progress.standing)
	resumed.controller.sell("persist-sell",resumed.market,resumed.hold,1,2000).assertEquals("Transaction already processed.")
	resumed.market.shortagePermille.assertEquals(300)
	resumed.market.productionPermille.assertEquals(775)
	resumed.market.consumptionPermille.assertEquals(1425)
	// Source cost: 3 * 8 = 24. London disruption: 300 + (1425-775)/2
	// = 625; buy floors 18*1625/1000 to 29; sell floors 29*.92 to 26.
	resumed.progress.realizedProfit.assertEquals(18)
	resumed.progress.standing.assertEquals(36)
	resumed.hold.money.assertEquals(1002)
	resumed.controller.carriedCost.assertEquals(16)
	// An additional configured warehouse stays empty; selecting the saved hold
	// must not apply its summary cargo to whichever store was selected before.
	resumed.stores[0].cargo.assertEquals(0)
	resumed.stores[0].money.assertEquals(0)
	let resumedState=resumed.capture()
	resumed.reconstruct(saved).assertTrue()
	resumed.capture().assertEquals(resumedState)

@test function rejectionPreservesPricesHistoryCostBasisAndRetryIdentity()
	let runtime=new PlayableTradeRuntime()
	runtime.registerMarket(new RuntimeMarket("port","grain",10,100,10,9))
	runtime.registerStore(new TradeStore("cargo:ship",3,50))
	runtime.newCampaign("port")
	runtime.controller.buy("buy",runtime.market,runtime.hold,2).assertEquals("Bought 2 grain.")
	// Cached buy 10; current stock pressure 10/8 and shortage 200 => buy 15.
	runtime.market.shortagePermille=200
	let before=runtime.capture()
	runtime.controller.buy("retry",runtime.market,runtime.hold,2).assertEquals("Cargo capacity is insufficient.")
	runtime.capture().assertEquals(before)
	runtime.controller.buy("retry",runtime.market,runtime.hold,1).assertEquals("Bought 1 grain.")
	runtime.hold.money.assertEquals(15)
	runtime.market.money=0
	let poorMarket=runtime.capture()
	runtime.controller.sell("sale",runtime.market,runtime.hold,1,1000).assertEquals("Market funds are insufficient.")
	runtime.capture().assertEquals(poorMarket)
	runtime.controller.seen("sale").assertFalse()
	runtime.market.money=100
	runtime.controller.sell("sale",runtime.market,runtime.hold,1,1000)
	let sold=runtime.capture()
	runtime.controller.sell("sale",runtime.market,runtime.hold,1,1000).assertEquals("Transaction already processed.")
	runtime.capture().assertEquals(sold)
	// A same-market resale and uncosted cargo cannot grant ordinary standing.
	runtime.progress.standing.assertEquals(0)
	let uncosted=new PlayableTradeController(new MerchantProgress())
	uncosted.sell("uncosted",runtime.market,runtime.hold,1,1000)
	uncosted.progress.standing.assertEquals(0)
