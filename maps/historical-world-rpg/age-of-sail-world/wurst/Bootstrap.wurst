constant int SAVE_SCHEMA_VERSION = 2

// ScenarioData is localized by the campaign packager. PHYSICAL_MAP_ID is the
// sole runtime identity of this particular packaged map.
NewCampaignOriginController bootstrapOriginSelection = null

function openBootstrapOriginSelection()
	DestroyTimer(GetExpiredTimer())
	if bootstrapOriginSelection != null
		PauseGame(true)
		bootstrapOriginSelection.showPage(1)

/** Applies the replaceable technology layer to live Warcraft dependants.  The
 * strategic technology state remains authoritative and rebuilds this layer. */
class WarcraftTechnologyEffects implements TechnologyEffectPort
	string array[4096] keys
	int array[4096] magnitudes
	int count=0
	int appliedFood=0
	override function applyTechnology(string controllerId,string effectId,int magnitude)
		keys[count]=controllerId+":"+effectId
		magnitudes[count]=magnitude
		count++
		if controllerId == "player"
			SetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP,GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP)+magnitude)
			appliedFood+=magnitude
	override function clearTechnologyLayer(string controllerId)
		if controllerId == "player" and appliedFood > 0
			SetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP,IMaxBJ(0,GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP)-appliedFood))
			appliedFood=0
		for i=0 to count-1
			if SubString(keys[i],0,StringLength(controllerId)+1) == controllerId+":"
				keys[i]=""

class WarcraftRpgProjections implements RpgProjectionPort
	HeroRoster heroes
	int array[2048] baseLife
	quest array[1024] guidance
	int guidanceCount=0
	quest array[512] knowledge
	int knowledgeCount=0
	construct(HeroRoster heroes)
		this.heroes=heroes
	override function clearEquipmentLayer()
		for i=0 to heroes.count-1
			if heroes.projected[i] != null and GetUnitTypeId(heroes.projected[i]) != 0 and baseLife[i] > 0
				compatSetUnitMaxLife(heroes.projected[i],baseLife[i])
	override function applyEquipment(string heroId,string itemId,int power)
		let found=heroes.indexOf(heroId)
		if found >= 0 and heroes.projected[found] != null and GetUnitTypeId(heroes.projected[found]) != 0
			if baseLife[found] == 0
				baseLife[found]=compatGetUnitMaxLife(heroes.projected[found])
			compatSetUnitMaxLife(heroes.projected[found],compatGetUnitMaxLife(heroes.projected[found])+IMaxBJ(0,power))
	override function applyEquipmentSet(string setId,int power)
		for i=0 to heroes.count-1
			if heroes.projected[i] != null and GetUnitTypeId(heroes.projected[i]) != 0
				if baseLife[i] == 0
					baseLife[i]=compatGetUnitMaxLife(heroes.projected[i])
				compatSetUnitMaxLife(heroes.projected[i],compatGetUnitMaxLife(heroes.projected[i])+IMaxBJ(0,power))
	override function clearGuidanceLayer()
		for i=0 to guidanceCount-1
			DestroyQuest(guidance[i])
		guidanceCount=0
	override function applyQuestGuidance(string questId,string precision,string regionId,string destinationId)
		let marker=CreateQuest()
		QuestSetTitle(marker,"Tracked: "+questId)
		QuestSetDescription(marker,precision+" guidance: "+regionId+" / "+destinationId)
		QuestSetRequired(marker,true)
		QuestSetEnabled(marker,true)
		guidance[guidanceCount]=marker
		guidanceCount++
	override function clearTreasureKnowledgeLayer()
		for i=0 to knowledgeCount-1
			DestroyQuest(knowledge[i])
		knowledgeCount=0
	override function applyTreasureKnowledge(string treasureId,int clueStage,boolean discovered)
		if clueStage > 0 or discovered
			let marker=CreateQuest()
			QuestSetTitle(marker,"Treasure: "+treasureId)
			QuestSetDescription(marker,"Clue stage "+clueStage.toString())
			QuestSetCompleted(marker,discovered)
			QuestSetEnabled(marker,true)
			knowledge[knowledgeCount]=marker
			knowledgeCount++

public WarcraftRpgRuntime rpgRuntime = new WarcraftRpgRuntime(new WarcraftTechnologyEffects())
public PiracyRuntime piracyRuntime

/** Replaceable projection only; authoritative totals remain in ReligionRuntime. */
class WarcraftReligionEffects implements ReligionModifierPort
	string array[64] keys
	int array[64] amounts
	int count=0
	override function clearReligionModifiers(string characterId)
		count=0
	override function applyReligionModifier(string characterId,string attributeId,int basisPoints)
		keys[count]=characterId+":"+attributeId
		amounts[count]=basisPoints
		count++

public ReligionRuntime religionRuntime = new ReligionRuntime(new WarcraftReligionEffects())


function initializeRegionalCampaign()
	requireWC3Compatibility()
	initializeManagementScreenPauseController()
	let clock = configureCampaignTimeline()
	installCampaignClock(clock)
	configureRecoveryScenario(recoveryService)
	let commands = createCommandRegistry(false)
	piracyRuntime = createGeneratedPiracyRuntime()
	let campaign = initializePlayableCampaignRuntime(commands, PHYSICAL_MAP_ID, religionRuntime, piracyRuntime)
	campaign.registerPiracyRuntime(piracyRuntime)
	registerCampaignDomains(campaign, rpgRuntime, militarySettlementRuntime, new WarcraftRpgProjections(rpgRuntime.heroes))
	if PHYSICAL_MAP_ID == "bootstrap_runtime_validation"
		bootstrapOriginSelection = new NewCampaignOriginController(8, new WarcraftOriginPresentation(), campaign.identity)
		bootstrapOriginSelection.setObserver(new CampaignHandoff(new WarcraftCampaignSaveStorage(CAMPAIGN_CACHE_FILE, "bootstrap"), new WarcraftPhysicalMapLoader()))
		configureGeneratedOrigins(bootstrapOriginSelection)
		registerOriginSelection(commands, bootstrapOriginSelection)
	else if not campaign.startup()
		print("Campaign startup stopped: " + campaign.diagnostic() + " Existing recovery saves have been retained.")
		return
	if campaign.started
		militarySettlementRuntime.activateRegion(PHYSICAL_MAP_ID)
		let physicalBoundaries = new PhysicalBoundaryRegistry(campaign.travel, campaign.regionAccess)
		configureGeneratedPhysicalBoundaries(physicalBoundaries)
		physicalBoundaries.install()
		clock.attachTimer(new WarcraftCampaignTimerAdapter(), 1.)
		enableCampaignAutosaves()
	registerPiracy(commands,piracyRuntime)
	registerPlayableTrade(commands, campaign)
	initializeMilitarySettlementRuntime(commands)
	registerUnstuckCommand(commands, recoveryService)
	registerRpgRuntimeCommands(commands,rpgRuntime)
	registerReligion(commands,religionRuntime)
	installPlayerGodMode(commands, campaign.saves)
	installCommandRegistry(commands)
	if PHYSICAL_MAP_ID == "bootstrap_runtime_validation"
		// Frame/UI and PauseGame calls are unsafe during module initialization on
		// some Warcraft builds. A zero-delay timer runs after map initialization.
		TimerStart(CreateTimer(), 0., false, function openBootstrapOriginSelection)
	if SCENARIO_SCHEMA_VERSION <= 0
		print("Scenario data failed to load.")
	print("Age of Sail: The World - development bootstrap loaded.")

init
	initializeRegionalCampaign()
