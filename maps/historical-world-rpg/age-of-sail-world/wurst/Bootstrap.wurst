package Bootstrap
import WC3Compatibility
import CommandRouter
import ScenarioData
import ManagementScreenPauseController
import UnstuckRecovery
import WarcraftRecoveryRuntime
import PlayerGodMode
import CampaignTimeline
import WarcraftRegionalRuntime
import WarcraftRpgRuntime
import MilitarySettlementRuntime
import PlayableCampaignRuntime
import CountryDiplomacyScreen
import PlayableCountryInteractions
import ReligionRuntime

constant string MAP_INTERNAL_ID = "age-of-sail-world"
constant int SAVE_SCHEMA_VERSION = 2

/** Applies the replaceable technology layer to live Warcraft dependants.  The
 * strategic technology state remains authoritative and rebuilds this layer. */
class WarcraftTechnologyEffects implements TechnologyEffectPort
	string array[4096] keys
	int array[4096] magnitudes
	int count=0
	override function applyTechnology(string controllerId,string effectId,int magnitude)
		keys[count]=controllerId+":"+effectId
		magnitudes[count]=magnitude
		count++
	override function clearTechnologyLayer(string controllerId)
		for i=0 to count-1
			if SubString(keys[i],0,StringLength(controllerId)+1) == controllerId+":"
				keys[i]=""

public WarcraftRpgRuntime rpgRuntime = new WarcraftRpgRuntime(new WarcraftTechnologyEffects())

/** Replaceable projection only; authoritative totals remain in ReligionRuntime. */
class WarcraftReligionEffects implements ReligionModifierPort
	string array[64] keys
	int array[64] amounts
	int count=0
	override function clearReligionModifiers(string characterId)
		count=0
	override function applyReligionModifier(string characterId,string attributeId,int basisPoints)
		keys[count]=characterId+":"+attributeId
		amounts[count]=basisPoints
		count++

public ReligionRuntime religionRuntime = new ReligionRuntime(new WarcraftReligionEffects())

init
	requireWC3Compatibility()
	initializeManagementScreenPauseController()
	let clock = configureCampaignTimeline()
	installCampaignClock(clock)
	clock.attachTimer(new WarcraftCampaignTimerAdapter(), 1.)
	configureRecoveryScenario(recoveryService)
	let commands = createCommandRegistry(false)
	configureGeneratedReligion(religionRuntime)
	let campaign = initializePlayableCampaignRuntime(commands, MAP_INTERNAL_ID, religionRuntime)
	configureGeneratedCountryInteractions(campaign.countries)
	configureMilitarySettlementScenario(militarySettlementRuntime)
	campaign.state.setMilitarySettlementRuntime(militarySettlementRuntime)
	initializeMilitarySettlementRuntime(commands)
	let originSelection = new NewCampaignOriginController(8, new WarcraftOriginPresentation(), campaign.identity)
	originSelection.setObserver(campaign)
	configureGeneratedOrigins(originSelection)
	configureGeneratedRpg(rpgRuntime)
	registerOriginSelection(commands, originSelection)
	registerUnstuckCommand(commands, recoveryService)
	registerRpgRuntimeCommands(commands,rpgRuntime)
	registerReligion(commands,religionRuntime)
	installPlayerGodMode(commands, campaign.saves)
	installCommandRegistry(commands)
	if MAP_INTERNAL_ID == "bootstrap_runtime_validation"
		PauseGame(true)
		originSelection.showPage(1)
	if SCENARIO_SCHEMA_VERSION <= 0
		print("Scenario data failed to load.")
	if getScenarioRuntimeData() == ""
		print("Scenario runtime data is empty.")
	print("Age of Sail: The World - development bootstrap loaded.")
