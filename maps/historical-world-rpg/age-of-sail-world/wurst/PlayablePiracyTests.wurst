package PlayablePiracyTests
import PlayablePiracy
import PiracyCommandTests

class OrdinarySystems implements PiratePolityAuthority
	boolean accept=true
	string founded=""
	string recognized=""
	override function foundIndependentPolity(PiratePolityState polity) returns boolean
		if accept
			founded=polity.id+":"+polity.capitalSettlementId+":"+polity.governmentFormId
		return accept
	override function validateReconciliation(PiratePolityState polity, string militarySnapshot) returns boolean
		return polity.capitalSettlementId!=""
	override function reconcileFoundedPolity(PiratePolityState polity) returns boolean
		return foundIndependentPolity(polity)
	override function setRecognition(string polityId,string countryId,string status)
		recognized=polityId+":"+countryId+":"+status

function rules() returns PiracyRules
	return new PiracyRules(30,20,5000,3,150)

@test function havenAndIndependentPolityUseOrdinaryCampaignAuthorities()
	let runtime=new PiracyRuntime(rules())
	runtime.registerHaven("caribbean_free_haven",2,"fence,repair,refit,recruit,contract")
	runtime.registerGovernmentForm("free_republic","First Captain")
	(runtime.useHaven("caribbean_free_haven","repair",1).indexOf("unavailable")>=0).assertTrue()
	runtime.state.notoriety=20
	runtime.state.piracyWealthMinor=6000
	runtime.state.prizesTaken=3
	runtime.useHaven("caribbean_free_haven","repair",2).assertEquals("Haven service used: repair.")
	runtime.state.havenStanding[0].assertEquals(1)
	let ordinary=new OrdinarySystems()
	runtime.setPolityAuthority(ordinary)
	runtime.foundPolity("free_tortuga","free_republic","Free Tortuga","First Captain","tortuga","tortuga,nassau").assertEquals("Independent polity founded and handed to ordinary campaign systems.")
	ordinary.founded.assertEquals("free_tortuga:tortuga:free_republic")
	runtime.setRecognition("england","recognized").assertTrue()
	ordinary.recognized.assertEquals("free_tortuga:england:recognized")
	runtime.state.outlaw.assertFalse()

@test function insufficientFoundingAndRejectedOrdinaryHandoffRollBack()
	let runtime=new PiracyRuntime(rules())
	runtime.registerGovernmentForm("free_republic","Captain")
	runtime.foundPolity("free_port","free_republic","Free Port","Captain","port","port").assertEquals("Pirate polity founding conditions are not met.")
	runtime.state.notoriety=20
	runtime.state.piracyWealthMinor=5000
	runtime.state.prizesTaken=3
	let ordinary=new OrdinarySystems()
	ordinary.accept=false
	runtime.setPolityAuthority(ordinary)
	(runtime.foundPolity("free_port","free_republic","Free Port","Captain","port","port").indexOf("no state changed")>=0).assertTrue()
	runtime.state.polityId.assertEquals("")

@test function saveLoadReconstructsVesselsPressureTerritoryGovernmentDiplomacyAndRecognition()
	let f=new PrizeFixture()
	let runtime=f.piracy
	runtime.registerGovernmentForm("pirate_confederacy","Admiral")
	f.combat.encounters[0].targetKind="military_ship"
	f.preview("captured_vessel_1","-","capture")
	f.confirm()
	runtime.state.notoriety=20
	runtime.state.piracyWealthMinor=6000
	runtime.state.prizesTaken=3
	let ordinary=new OrdinarySystems()
	runtime.setPolityAuthority(ordinary)
	runtime.foundPolity("free_nassau","pirate_confederacy","Nassau","Admiral","nassau","nassau")
	runtime.setRecognition("england","tolerated")
	let saved=runtime.snapshot()
	let resumed=new PiracyRuntime(rules())
	resumed.restore(saved)
	resumed.actionSeen("captured_vessel_1").assertTrue()
	resumed.regionalPressure[0].assertEquals(4)
	resumed.polity.capitalSettlementId.assertEquals("nassau")
	resumed.polity.governmentFormId.assertEquals("pirate_confederacy")
	(resumed.polity.recognition.indexOf("england,tolerated~")>=0).assertTrue()
	resumed.state.polityId.assertEquals("free_nassau")
