package TradePricingVectorsTests
import PlayableTrade

// Generated by tests/test_trade_pricing.py --write-vectors. Python checks every
// literal against trade.quote and an independent rational per-edge oracle.
function checkQuote(int stock,int target,int basePrice,int quantity,int units,int elasticity,int spread,int floor,int ceiling,int shortage,int eventModifier,int technology,int production,int consumption,int blockade,int occupation,int buy,int sell)
	let market=new RuntimeMarket("vector","cargo",stock,1000000,basePrice,basePrice)
	market.targetStock=target
	market.pricing.quantityUnitsPerDisplayUnit=units
	market.pricing.elasticityPermille=elasticity
	market.pricing.spreadPermille=spread
	market.pricing.priceFloorPermille=floor
	market.pricing.priceCeilingPermille=ceiling
	market.shortagePermille=shortage
	market.eventPermille=eventModifier
	market.technologyPermille=technology
	market.productionPermille=production
	market.consumptionPermille=consumption
	market.blockaded=blockade==1
	market.occupiedByHostile=occupation==1
	market.quoteAmount(quantity,true).assertEquals(buy)
	market.quoteAmount(quantity,false).assertEquals(sell)
	destroy market.pricing
	destroy market

@test function liveQuoteContractBatch0()
	checkQuote(100,100,10,1,1,1000,0,350,4000,0,0,0,1000,1000,0,0,10,10)
	checkQuote(100,100,10,1,1,1000,80,350,4000,0,0,0,1000,1000,0,0,10,9)
	checkQuote(100,100,10,1,1,1000,125,350,4000,0,0,0,1000,1000,0,0,11,8)
	checkQuote(100,100,10,2,1,1000,0,350,4000,0,0,0,1000,1000,0,0,20,20)
	checkQuote(100,100,10,2,1,1000,80,350,4000,0,0,0,1000,1000,0,0,20,18)
	checkQuote(100,100,10,2,1,1000,125,350,4000,0,0,0,1000,1000,0,0,22,16)
	checkQuote(100,100,10,75,1,1000,0,350,4000,0,0,0,1000,1000,0,0,1030,480)
	checkQuote(100,100,10,75,1,1000,80,350,4000,0,0,0,1000,1000,0,0,1080,405)

