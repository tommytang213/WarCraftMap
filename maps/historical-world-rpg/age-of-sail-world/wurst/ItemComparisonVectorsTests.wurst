package ItemComparisonVectorsTests

import WarcraftRpgRuntime
import ScenarioData

// Generated from player_items.compare by tests/test_item_definitions.py --write-vectors.
@test function itemComparisonsMatchHeadlessContract()
	let runtime = new WarcraftRpgRuntime(null)
	configureGeneratedRpg(runtime)
	let comparison0 = new ItemComparison(runtime.inventory.getItem("afghan_pulwar"), null)
	comparison0.statCount.assertEquals(2)
	comparison0.delta("meleePower").assertEquals(40)
	comparison0.candidate.statValue("meleePower").assertEquals(40)
	comparison0.delta("mountedPower").assertEquals(12)
	comparison0.candidate.statValue("mountedPower").assertEquals(12)
	comparison0.candidate.effectCount.assertEquals(0)
	comparison0.candidate.conditionalCount.assertEquals(0)
	destroy comparison0
	let comparison1 = new ItemComparison(runtime.inventory.getItem("afghan_pulwar"), runtime.inventory.getItem("afghan_pulwar"))
	comparison1.statCount.assertEquals(2)
	comparison1.delta("meleePower").assertEquals(0)
	comparison1.candidate.statValue("meleePower").assertEquals(40)
	comparison1.delta("mountedPower").assertEquals(0)
	comparison1.candidate.statValue("mountedPower").assertEquals(12)
	comparison1.candidate.effectCount.assertEquals(0)
	comparison1.candidate.conditionalCount.assertEquals(0)
	destroy comparison1
	let comparison2 = new ItemComparison(runtime.inventory.getItem("afghan_pulwar"), runtime.inventory.getItem("dahomey_flintlock"))
	comparison2.statCount.assertEquals(4)
	comparison2.delta("meleePower").assertEquals(40)
	comparison2.candidate.statValue("meleePower").assertEquals(40)
	comparison2.delta("mobility").assertEquals(-4)
	comparison2.candidate.statValue("mobility").assertEquals(0)
	comparison2.delta("mountedPower").assertEquals(12)
	comparison2.candidate.statValue("mountedPower").assertEquals(12)
	comparison2.delta("rangedPower").assertEquals(-57)
	comparison2.candidate.statValue("rangedPower").assertEquals(0)
	comparison2.candidate.effectCount.assertEquals(0)
	comparison2.candidate.conditionalCount.assertEquals(0)
	destroy comparison2
	let comparison3 = new ItemComparison(runtime.inventory.getItem("dahomey_flintlock"), runtime.inventory.getItem("afghan_pulwar"))
	comparison3.statCount.assertEquals(4)
	comparison3.delta("meleePower").assertEquals(-40)
	comparison3.candidate.statValue("meleePower").assertEquals(0)
	comparison3.delta("mobility").assertEquals(4)
	comparison3.candidate.statValue("mobility").assertEquals(4)
	comparison3.delta("mountedPower").assertEquals(-12)
	comparison3.candidate.statValue("mountedPower").assertEquals(0)
	comparison3.delta("rangedPower").assertEquals(57)
	comparison3.candidate.statValue("rangedPower").assertEquals(57)
	comparison3.candidate.effectCount.assertEquals(0)
	comparison3.candidate.conditionalCount.assertEquals(0)
	destroy comparison3
	let comparison4 = new ItemComparison(runtime.inventory.getItem("afghan_pulwar"), runtime.inventory.getItem("ahmad_ibn_ibrahim_campaign_shotel"))
	comparison4.statCount.assertEquals(3)
	comparison4.delta("meleePower").assertEquals(-12)
	comparison4.candidate.statValue("meleePower").assertEquals(40)
	comparison4.delta("morale").assertEquals(-15)
	comparison4.candidate.statValue("morale").assertEquals(0)
	comparison4.delta("mountedPower").assertEquals(12)
	comparison4.candidate.statValue("mountedPower").assertEquals(12)
	comparison4.candidate.effectCount.assertEquals(0)
	comparison4.candidate.conditionalCount.assertEquals(0)
	destroy comparison4
	let comparison5 = new ItemComparison(runtime.inventory.getItem("ahmad_ibn_ibrahim_campaign_shotel"), runtime.inventory.getItem("afghan_pulwar"))
	comparison5.statCount.assertEquals(3)
	comparison5.delta("meleePower").assertEquals(12)
	comparison5.candidate.statValue("meleePower").assertEquals(52)
	comparison5.delta("morale").assertEquals(15)
	comparison5.candidate.statValue("morale").assertEquals(15)
	comparison5.delta("mountedPower").assertEquals(-12)
	comparison5.candidate.statValue("mountedPower").assertEquals(0)
	comparison5.candidate.effectCount.assertEquals(1)
	comparison5.candidate.conditionalCount.assertEquals(0)
	destroy comparison5
	let comparison6 = new ItemComparison(runtime.inventory.getItem("naval_hanger"), null)
	comparison6.statCount.assertEquals(2)
	comparison6.delta("boarding").assertEquals(12)
	comparison6.candidate.statValue("boarding").assertEquals(12)
	comparison6.delta("meleePower").assertEquals(18)
	comparison6.candidate.statValue("meleePower").assertEquals(18)
	comparison6.candidate.effectCount.assertEquals(1)
	comparison6.candidate.conditionalCount.assertEquals(1)
	comparison6.candidate.conditionalEffects[0].id.assertEquals("boarding_edge")
	comparison6.candidate.conditionalEffects[0].condition.assertEquals("aboard_ship")
	destroy comparison6
