package CountryDiplomacyScreenTests

import CountryDiplomacyScreen
import CommandRouter
import PlayableCountryInteractions
import Wurstunit

class RecordingDiplomacyPresentation implements CountryDiplomacyPresentation
	string last = ""
	override function showCountry(string polityId, string summary, string interactions)
		last = "country:" + polityId
	override function showPeace(string offerId, string terms, string explanation)
		last = "offer:" + offerId
	override function showResult(string message)
		last = message

class FakeDiplomacyAuthority implements CountryDiplomacyAuthority
	boolean changed = false
	override function isKnown(string polityId) returns boolean
		return polityId == "france"
	override function countrySummary(string polityId) returns string
		return "At war; known ruler; Kent occupied"
	override function availableInteractions(string polityId) returns string
		return "serve, rewards, access, negotiate"
	override function activeConflictWith(string polityId) returns string
		return "channel_war"
	override function validateOffer(string conflictId, string recipientPolityId, string terms) returns string
		if terms == "return_kent"
			return ""
		return "Those terms are impossible."
	override function createOffer(string conflictId, string recipientPolityId, string terms) returns string
		return "player_offer_1"
	override function respondToOffer(string offerId, boolean accept, boolean confirmed) returns string
		if accept and confirmed
			changed = true
			return "Peace concluded; Kent returned."
		return "Confirmation required."
	override function requestGovernmentReward(string polityId, string rewardId) returns string
		if polityId == "france" and rewardId == "commission" and changed
			return "Reward granted: commission."
		return "Reward rejected: requirements are not met."

@test function playerCanOpenOfferRespondAndObserveWorldChange()
	let authority = new FakeDiplomacyAuthority()
	let presentation = new RecordingDiplomacyPresentation()
	let controller = new CountryDiplomacyController(authority, presentation)
	controller.openFromMapContext("france").assertTrue()
	presentation.last.assertEquals("country:france")
	controller.propose("france", "return_kent").assertTrue()
	presentation.last.assertEquals("offer:player_offer_1")
	controller.respond("player_offer_1", true, true).assertTrue()
	authority.changed.assertTrue()
	presentation.last.assertEquals("Peace concluded; Kent returned.")
	controller.requestReward("france", "commission").assertTrue()
	presentation.last.assertEquals("Reward granted: commission.")

@test function undiscoveredAndInvalidOffersStayClosed()
	let authority = new FakeDiplomacyAuthority()
	let presentation = new RecordingDiplomacyPresentation()
	let controller = new CountryDiplomacyController(authority, presentation)
	controller.openFromRuler("castile").assertFalse()
	controller.propose("france", "impossible").assertFalse()
	presentation.last.assertEquals("Those terms are impossible.")
	controller.requestReward("castile", "commission").assertFalse()
	presentation.last.assertEquals("You cannot request a reward from an undiscovered government.")

@test function governmentRewardsValidateAndPersistWithoutDuplicateMutation()
	let identity = new PlayerCampaignIdentity()
	identity.startCampaign("england", "europe_west", "europe", "london").assertTrue()
	let runtime = new PlayableCountryInteractionRuntime(identity)
	runtime.registerPolity("england", 100)
	runtime.registerPolity("france", 10)
	runtime.registerRewardProfile(new GovernmentRewardProfile("england", "commission", "office", 20, 5, 30, false))
	runtime.registerRewardProfile(new GovernmentRewardProfile("france", "pension", "money", 10, 0, 20, true))
	runtime.discover("england").assertTrue()
	runtime.setStanding("england", 5, 5)
	runtime.recordContribution("england", 10).assertTrue()
	runtime.requestGovernmentReward("england", "commission").assertEquals("Reward granted: commission (office).")
	let grantedState = runtime.captureState()
	runtime.requestGovernmentReward("england", "commission").assertEquals("Reward rejected: reward was already granted.")
	runtime.captureState().assertEquals(grantedState)
	runtime.discover("france").assertTrue()
	runtime.setStanding("france", 10, 0)
	let beforeRejected = runtime.captureState()
	runtime.requestGovernmentReward("france", "pension").assertEquals("Reward rejected: government resources are insufficient.")
	runtime.captureState().assertEquals(beforeRejected)

@test function pendingOffersAndRewardHistorySurviveReconstruction()
	let identity = new PlayerCampaignIdentity()
	identity.startCampaign("england", "europe_west", "europe", "london")
	let runtime = new PlayableCountryInteractionRuntime(identity)
	runtime.registerPolity("england", 100)
	runtime.registerPolity("france", 100)
	runtime.registerRewardProfile(new GovernmentRewardProfile("england", "commission", "office", 1, 0, 0, false))
	runtime.discover("england")
	runtime.discover("france")
	runtime.setActiveConflict("france", "channel_war")
	runtime.createOffer("channel_war", "france", "ceasefire").assertEquals("player_offer_1")
	runtime.recordContribution("england", 1)
	runtime.requestGovernmentReward("england", "commission")
	let saved = runtime.captureState()
	let restored = new PlayableCountryInteractionRuntime(identity)
	restored.registerPolity("england", 100)
	restored.registerPolity("france", 100)
	restored.registerRewardProfile(new GovernmentRewardProfile("england", "commission", "office", 1, 0, 0, false))
	restored.restoreState(saved).assertTrue()
	restored.isKnown("france").assertTrue()
	restored.requestGovernmentReward("england", "commission").assertEquals("Reward rejected: reward was already granted.")
	restored.activeConflictWith("france").assertEquals("channel_war")
	restored.captureState().assertEquals(saved)
	restored.restoreState(saved).assertTrue()
	restored.captureState().assertEquals(saved)
	restored.createOffer("channel_war", "france", "ceasefire").assertEquals("player_offer_2")
	restored.respondToOffer("player_offer_1", false, false).assertEquals("Peace offer rejected.")
	restored.respondToOffer("player_offer_2", true, true).assertEquals("Peace concluded under the negotiated terms.")
	restored.activeConflictWith("france").assertEquals("")
	// Existing registries must replace their post-save conflicts and offers too.
	restored.setActiveConflict("england", "later_war")
	restored.restoreState(saved).assertTrue()
	restored.captureState().assertEquals(saved)
	restored.activeConflictWith("england").assertEquals("")
	restored.createOffer("channel_war", "france", "ceasefire").assertEquals("player_offer_2")

function rejectsCountryState(PlayableCountryInteractionRuntime runtime, string candidate)
	let before = runtime.captureState()
	let sequence = runtime.nextOffer
	runtime.restoreState(candidate).assertFalse()
	runtime.captureState().assertEquals(before)
	runtime.nextOffer.assertEquals(sequence)

@test function lateInvalidCountryRecordsPreserveActiveAuthority()
	let identity = new PlayerCampaignIdentity()
	identity.startCampaign("england", "europe_west", "europe", "london")
	let runtime = new PlayableCountryInteractionRuntime(identity)
	runtime.registerPolityResources("england", 80, 9)
	runtime.registerPolity("france", 100)
	runtime.registerRewardProfile(new GovernmentRewardProfile("england", "commission", "office", 1, 0, 5, false))
	runtime.discover("england")
	runtime.discover("france")
	runtime.recordContribution("england", 1)
	runtime.requestGovernmentReward("england", "commission")
	runtime.setActiveConflict("france", "war")
	runtime.createOffer("war", "france", "ceasefire")
	let candidate = "v1|p,england,0,0,0,0,1,0|p,france,1,0,0,0,2,0|c,france,other_war|o,player_offer_12,france,0,ceasefire"
	rejectsCountryState(runtime, candidate + "|c,unknown,war")
	rejectsCountryState(runtime, candidate + "|o,player_offer_12,france,0,ceasefire")
	rejectsCountryState(runtime, candidate + "|g,england,missing")
	rejectsCountryState(runtime, candidate + "|c,france,duplicate")
	rejectsCountryState(runtime, candidate + "|o,player_offer_13,france,9,ceasefire")
	rejectsCountryState(runtime, "v1|p,england,1,0,0,0,invalid,0")
	rejectsCountryState(runtime, "v10|p,england,1,0,0,0,1,0")
	rejectsCountryState(runtime, candidate + "|")
	var tooMany = "v1|p,france,1,0,0,0,2,0"
	for i = 1 to 129
		tooMany += "|o,player_offer_" + i.toString() + ",france,0,ceasefire"
	rejectsCountryState(runtime, tooMany)
	runtime.createOffer("war", "france", "ceasefire").assertEquals("player_offer_2")

@test function legacyCountryResourcesAndSparseOfferSequenceRemainCompatible()
	let runtime = new PlayableCountryInteractionRuntime(new PlayerCampaignIdentity())
	runtime.registerPolityResources("france", 100, 9)
	// Before live resources, v1 polity rows had no material-stock column.
	let legacy = "v1|p,france,1,-2,3,4,50|c,france,war|o,player_offer_12,france,1,ceasefire|o,player_offer_2,france,0,ceasefire"
	runtime.restoreState(legacy).assertTrue()
	runtime.restoreState(legacy).assertTrue()
	runtime.materialStock[0].assertEquals(9)
	runtime.treasury[0].assertEquals(50)
	runtime.createOffer("war", "france", "ceasefire").assertEquals("player_offer_13")
