package PlayableCampaignRuntimeTests

import CampaignHandoff
import CampaignSaveManager
import CampaignAutosaveScheduler
import PlayableCampaignRuntime
import CampaignTimeline
import WarcraftRegionalRuntime
import RemoteRegionManagement
import PlayablePiracy
import ManagementScreenPauseController

class RecordingRegionPause implements CampaignPauseRuntime
	boolean paused = false
	int changes = 0
	override function setCampaignPaused(boolean paused)
		this.paused = paused
		changes++

class PersistencePolityAuthority implements PiratePolityAuthority
	int reconciliations=0
	string recognition=""
	override function foundIndependentPolity(PiratePolityState polity) returns boolean
		return reconcileFoundedPolity(polity)
	override function reconcileFoundedPolity(PiratePolityState polity) returns boolean
		reconciliations++
		return polity.capitalSettlementId!=""
	override function setRecognition(string polityId,string countryId,string status)
		recognition=polityId+":"+countryId+":"+status

function persistencePiracy() returns PiracyRuntime
	let result=new PiracyRuntime(new PiracyRules(30,20,5000,3,150))
	result.registerHaven("nassau_haven",2,"repair,fence")
	result.registerGovernmentForm("free_republic","First Captain")
	return result

function persistencePrize(string id,string target,int tick) returns PrizeProposal
	return new PrizeProposal(id,target,"merchant_ship","spain","caribbean","marque_1","capture","sugar",4,2000,2,"ransom",tick,true)

class MemoryStorage implements CampaignSaveStorage
	string array[64] keys
	string array[64] values
	int count = 0
	boolean failNext = false
	string lastDiagnostic = ""
	function find(string key) returns int
		for i = 0 to count - 1
			if keys[i] == key
				return i
		return -1
	override function contains(string key) returns boolean
		return find(key) >= 0
	override function read(string key) returns string
		let i = find(key)
		if i >= 0
			return values[i]
		return ""
	override function writeTransactional(string key, string payload) returns boolean
		if failNext
			failNext = false
			lastDiagnostic = "interrupted fixture commit"
			return false
		let i = find(key)
		if i >= 0
			values[i] = payload
		else
			keys[count] = key
			values[count] = payload
			count++
		return true
	override function diagnostic() returns string
		return lastDiagnostic

class FakeLoader implements PhysicalMapLoader
	string loaded = ""
	override function load(string packagePath)
		loaded = packagePath

class FakeRegionRuntime implements RegionCommandRuntime
	string active = "europe"
	string snapshot = ""
	override function snapshotRuntime() returns string
		return active
	override function restoreRuntime(string value)
		active = value
	override function retireCommandRegion(string regionId)
		snapshot = regionId
	override function reconstructCommandRegion(player whichPlayer, string regionId) returns boolean
		active = regionId
		return true
	override function focusCommandRegion(player whichPlayer, string regionId)
		active = regionId
	override function diagnostic() returns string
		return ""

@test function playableAutosaveLoadAndIntegrityAreRuntimeWired()
	let storage = new MemoryStorage()
	let regional = new WarcraftRegionalAdapter()
	let state = new PlayableCampaignState(regional, new CampaignClock(1, 100, 1, 1.))
	let manager = new CampaignSaveManager(storage, new PlayableCampaignCodec(state.clock), state)
	let scheduler = new CampaignAutosaveScheduler(manager, 10.)
	state.replaceAuthority("v1;map=west;region=europe;world=w;players=p;quests=q1_open;discovery=lisbon;orders=fleet_sail;trade=;diplomacy=v1;rewards=v1;rpg=v1;militarySettlements=v1;religion=v1;piracy=v1")
	scheduler.advance(10., "day-1").assertTrue()
	state.replaceAuthority("v1;map=east;region=europe;world=w;players=p;quests=q1_done;discovery=lisbon;orders=fleet_hold;trade=;diplomacy=v1;rewards=v1;rpg=v1;militarySettlements=v1;religion=v1;piracy=v1")
	manager.load(SAVE_SLOT_AUTOSAVE, 1).assertTrue()
	(state.authorityDocument().indexOf("q1_open") >= 0).assertTrue()
	let before = state.authorityDocument()
	storage.values[storage.find("autosave_01")] = storage.read("autosave_01") + "tampered"
	manager.load(SAVE_SLOT_AUTOSAVE, 1).assertFalse()
	state.authorityDocument().assertEquals(before)

@test function piracyCrossMapAuthorityUsesCampaignCodecAndStorageBoundary()
	let storage=new MemoryStorage()
	let original=persistencePiracy()
	original.issueCommission("marque_1","england","spain",100,250).assertTrue()
	original.commitPrize(persistencePrize("prize_1","ship_1",10))
	original.state.notoriety=20
	original.state.piracyWealthMinor=6000
	original.state.prizesTaken=3
	original.useHaven("nassau_haven","repair",11)
	let ordinary=new PersistencePolityAuthority()
	original.setPolityAuthority(ordinary)
	original.foundPolity("free_nassau","free_republic","Free Nassau","First Captain","nassau","nassau")
	original.setRecognition("england","recognized")
	let source=new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	source.setPiracyRuntime(original)
	source.replaceAuthority("v2;map=west;region=europe;world=w;players=p;quests=;discovery=;orders=;trade=;diplomacy=v1;rewards=v1;rpg=v1;militarySettlements=v1;religion=v1")
	let writer=new CampaignSaveManager(storage,new PlayableCampaignCodec(source.clock),source)
	writer.save(SAVE_SLOT_MAJOR_MILESTONE,0,"before-travel").assertTrue()
	let resumed=persistencePiracy()
	let resumedOrdinary=new PersistencePolityAuthority()
	resumed.setPolityAuthority(resumedOrdinary)
	let destination=new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	destination.setPiracyRuntime(resumed)
	let reader=new CampaignSaveManager(storage,new PlayableCampaignCodec(destination.clock),destination)
	reader.load(SAVE_SLOT_MAJOR_MILESTONE,0).assertTrue()
	resumed.actionSeen("prize_1").assertTrue()
	resumed.state.havenStanding[0].assertEquals(1)
	resumed.regionalPressure[0].assertEquals(2)
	resumed.polity.id.assertEquals("free_nassau")
	resumedOrdinary.reconciliations.assertEquals(1)
	// Loading the same commit reconciles projections but never reapplies prizes.
	reader.load(SAVE_SLOT_MAJOR_MILESTONE,0).assertTrue()
	resumed.processedCount.assertEquals(1)
	resumed.state.bountyMinor.assertEquals(0)
	resumed.state.prizesTaken.assertEquals(3)
	resumedOrdinary.reconciliations.assertEquals(2)

@test function malformedDuplicatePiracyRecordsRejectAtomically()
	let runtime=persistencePiracy()
	runtime.issueCommission("marque_1","england","spain",100,250)
	runtime.commitPrize(persistencePrize("prize_1","ship_1",10))
	let before=runtime.captureAuthority()
	let actionMarker="|actions="
	let actionStart=before.indexOf(actionMarker)+StringLength(actionMarker)
	let duplicate=SubString(before,0,actionStart)+"prize_1,ship_1,merchant_ship,spain,caribbean,marque_1,capture,sugar,1,1,0,release,10~"+SubString(before,actionStart,StringLength(before))
	runtime.validateAuthority(duplicate).assertFalse()
	runtime.captureAuthority().assertEquals(before)

@test function prePiracyCampaignSaveMigratesToConfiguredEmptyAuthority()
	let migration=persistencePiracy()
	migration.state.notoriety=99
	piracyMigrationRuntime=migration
	let codec=new PlayableCampaignCodec(new CampaignClock(1, 100, 1, 1.))
	let legacyState="v2;map=west;region=europe;world=w;players=p;quests=;discovery=;orders=;trade=;diplomacy=v1;rewards=v1;rpg=v1;militarySettlements=v1;religion=v1"
	let payload=campaignSaveEnvelope(4,"manual_01",SAVE_SLOT_MANUAL,1,"legacy",legacyState)
	let migrated=codec.decodeMigrateAndValidate(payload,"manual_01")
	(migrated.indexOf(";piracy=v1|")>=0).assertTrue()
	(migrated.indexOf("|notoriety=0|")>=0).assertTrue()

@test function everyAdvertisedLiveSchemaDecodesAndResavesAsCurrent()
	piracyMigrationRuntime=persistencePiracy()
	for schema=CAMPAIGN_SAVE_SCHEMA_OLDEST to CAMPAIGN_SAVE_SCHEMA_CURRENT
		var fixtureState="v2;map=west;region=europe;world=instance:i;players=origin:portugal,allegiance:portugal,settlement:lisbon;quests=q;discovery=lisbon;orders=o;trade=t;religion=v1"
		if schema>=2
			fixtureState+=";diplomacy=v1;rewards=v1"
		if schema>=3
			fixtureState+=";rpg=v1"
		if schema>=4
			fixtureState+=";militarySettlements=v1"
		if schema>=5
			fixtureState+=";piracy="+piracyMigrationRuntime.migrationAuthority()
		if schema>=6
			fixtureState+=";clock="+(new CampaignClock(1, 100, 1, 1.)).initialState()
		let storage=new MemoryStorage()
		let state=new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
		let codec=new PlayableCampaignCodec(state.clock)
		let manager=new CampaignSaveManager(storage,codec,state)
		let fixture=campaignSaveEnvelope(schema,"manual_01",SAVE_SLOT_MANUAL,1,"fixture",fixtureState)
		storage.writeTransactional("manual_01",fixture).assertTrue()
		state.clock.advanceElapsed(30.75).assertTrue()
		state.clock.setSpeed(3.).assertTrue()
		manager.load(SAVE_SLOT_MANUAL,1).assertTrue()
		state.clock.captureState().assertEquals(state.clock.initialState())
		storage.read("manual_01").assertEquals(fixture)
		manager.save(SAVE_SLOT_MANUAL,1,"resaved").assertTrue()
		(storage.read("manual_01").indexOf("|schema=6|slot=manual_01|")>=0).assertTrue()
		(codec.decodeMigrateAndValidate(storage.read("manual_01"),"manual_01")!="").assertTrue()
		let resaved = storage.read("manual_01")
		manager.load(SAVE_SLOT_MANUAL,1).assertTrue()
		manager.save(SAVE_SLOT_MANUAL,1,"resaved").assertTrue()
		storage.read("manual_01").assertEquals(resaved)

@test function currentLiveSchemaCannotSilentlyInventMissingDomains()
	let codec=new PlayableCampaignCodec(new CampaignClock(1, 100, 1, 1.))
	let incomplete="v2;map=west;region=europe;world=w;players=p;quests=;discovery=;orders=;trade="
	let fixture=campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT,"manual_01",SAVE_SLOT_MANUAL,1,"fixture",incomplete)
	codec.decodeMigrateAndValidate(fixture,"manual_01").assertEquals("")
	codec.diagnostic().assertEquals("save is missing authority required by its schema")

@test function transitionCommitsBeforeLoadAndPreservesNormalizedBoundaryPosition()
	let storage = new MemoryStorage()
	let state = new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	let manager = new CampaignSaveManager(storage, new PlayableCampaignCodec(state.clock), state)
	let loader = new FakeLoader()
	let travel = new CampaignTravelRuntime(state, manager, new CampaignAutosaveScheduler(manager, 10.), loader, "west", "europe")
	let edge = new BoundaryCorrespondence("west_east", "west", "east", "Maps/East.w3x", "europe", true, 1., 0.)
	travel.transition(edge, .25, "day-2").assertTrue()
	travel.physicalMapId().assertEquals("east")
	loader.loaded.assertEquals("Maps/East.w3x")
	(state.authorityDocument().indexOf("arrival=") >= 0).assertTrue()
	storage.contains("major_milestone").assertTrue()

@test function interruptedTransitionKeepsPhysicalRuntimeAndAuthority()
	let storage = new MemoryStorage()
	let state = new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	let manager = new CampaignSaveManager(storage, new PlayableCampaignCodec(state.clock), state)
	let loader = new FakeLoader()
	let travel = new CampaignTravelRuntime(state, manager, new CampaignAutosaveScheduler(manager, 10.), loader, "west", "europe")
	let edge = new BoundaryCorrespondence("west_east", "west", "east", "Maps/East.w3x", "europe", false, 1., 0.)
	let before = state.authorityDocument()
	storage.failNext = true
	travel.transition(edge, .4, "day-3").assertFalse()
	state.authorityDocument().assertEquals(before)
	travel.physicalMapId().assertEquals("west")
	loader.loaded.assertEquals("")

@test function changedCityAndQuestSurviveMapRevisit()
	let storage = new MemoryStorage()
	let state = new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	let manager = new CampaignSaveManager(storage, new PlayableCampaignCodec(state.clock), state)
	let travel = new CampaignTravelRuntime(state, manager, new CampaignAutosaveScheduler(manager, 10.), new FakeLoader(), "west", "europe")
	let east = new BoundaryCorrespondence("west_east", "west", "east", "Maps/East.w3x", "europe", false, 1., 0.)
	let west = new BoundaryCorrespondence("east_west", "east", "west", "Maps/West.w3x", "europe", false, 1., 0.)
	state.replaceAuthority("v1;map=west;region=europe;world=w;players=p;quests=delivery_started;discovery=lisbon;orders=;trade=;diplomacy=v1;rewards=v1;rpg=v1;militarySettlements=v1;religion=v1;piracy=v1;city_lisbon_owner=portugal")
	travel.transition(east, .4, "day-4").assertTrue()
	state.replaceAuthority(state.authorityDocument() + ";quests=delivery_complete;city_lisbon_owner=castile")
	travel.transition(west, .4, "day-5").assertTrue()
	(state.authorityDocument().indexOf("delivery_complete") >= 0).assertTrue()
	(state.authorityDocument().indexOf("city_lisbon_owner=castile") >= 0).assertTrue()
	(state.authorityDocument().indexOf(";map=east") < 0).assertTrue()

@test function invalidPhysicalBoundaryNeverLoadsMap()
	let storage = new MemoryStorage()
	let state = new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	let manager = new CampaignSaveManager(storage, new PlayableCampaignCodec(state.clock), state)
	let loader = new FakeLoader()
	let travel = new CampaignTravelRuntime(state, manager, new CampaignAutosaveScheduler(manager, 10.), loader, "west", "europe")
	let wrongSource = new BoundaryCorrespondence("east_west", "east", "west", "Maps/West.w3x", "europe", false, 1., 0.)
	travel.transition(wrongSource, .5, "day-6").assertFalse()
	loader.loaded.assertEquals("")
	storage.contains("major_milestone").assertFalse()

@test function remoteAccessDoesNotRevealUnknownOrMovePhysicalRegion()
	let access = new PlayableRegionAccess()
	access.add("europe", true, true)
	access.add("africa", true, true)
	access.add("pacific", false, true)
	access.regionExists("africa").assertTrue()
	access.regionIsKnown(Player(0), "africa").assertTrue()
	access.mayCommandRegion(Player(0), "africa").assertTrue()
	access.regionIsKnown(Player(0), "pacific").assertFalse()
	let runtime = new FakeRegionRuntime()
	let pause = new RecordingRegionPause()
	let pauses = new ManagementScreenPauseController(pause, false)
	let selector = new RegionSelector(access, runtime, "europe", pauses)
	selector.select(Player(0), "pacific").assertFalse()
	pause.changes.assertEquals(0)
	selector.select(Player(0), "africa").assertTrue()
	pause.paused.assertTrue()
	pauses.getModalOwnerCount().assertEquals(1)
	selector.getPhysicalRegionId().assertEquals("europe")
	selector.getCommandRegionId().assertEquals("africa")
	selector.returnToPhysicalRegion(Player(0)).assertTrue()
	selector.getPhysicalRegionId().assertEquals("europe")
	runtime.active.assertEquals("europe")
	pause.paused.assertFalse()
	pause.changes.assertEquals(2)
	pauses.getModalOwnerCount().assertEquals(0)
