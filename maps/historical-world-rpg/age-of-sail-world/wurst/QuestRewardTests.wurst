	overflow.base.rpg.technologies.unlockedCount.assertEquals(0)

@test function fullResearchCapacityRejectsWithoutPartialCompletion()
	let f = new RewardFixture()
	f.ready("left")
	// Capacity-only negative fixture; no claim that duplicate keys form a save.
	for i = 0 to 2047
		f.base.rpg.technologies.unlockedKeys[i] = "other:standardized_charts"
	f.base.rpg.technologies.unlockedCount = 2048
	f.reject()
	f.base.rpg.journal.lastDiagnostic.contains("capacity exceeded").assertTrue()
	f.definition.state.assertEquals(QUEST_READY)

/** Only arrange already-earned objective state. No mock condition is used as
 * evidence that a currently unsupported story action has been implemented. */
function historicallyReady(RuntimeQuest definition)
	definition.graph.activate()
	var current = definition.graph.stage(definition.graph.activeStageId)
	for depth = 0 to 15
		let objectives = new QuestIds(current.objectiveIds)
		for i = 0 to objectives.count - 1
			definition.graph.completeObjective(objectives.ids[i]).assertTrue()
		destroy objectives
		if current.nextStageIds == ""
			definition.settleProgress()
			definition.state.assertEquals(QUEST_READY)
			return
		// Completing a stage automatically follows its sole successor. Only
		// choose explicitly when the authored graph is still at a fork.
		if definition.graph.activeStageId == current.id
			let next = new QuestIds(current.nextStageIds)
			definition.graph.advance(next.ids[0]).assertTrue()
			destroy next
		current = definition.graph.stage(definition.graph.activeStageId)

@test function bothGeneratedResearchBearingQuestsBlockTheirWholeUnsupportedBatches()
	let stars = new QuestTradeFixture()
	historicallyReady(stars.questDefinition)
	let before = stars.rpg.captureState()
	rewardCommand(stars.commands, stars.clock, Player(0), "/turnin india_stars_and_pepper trader")
	stars.rpg.captureState().assertEquals(before)
	stars.rpg.journal.lastDiagnostic.contains("calicut_credit").assertTrue()
	journalText(stars.rpg).contains("Authored rewards blocked:").assertTrue()
	stars.rpg.technologies.isUnlocked("player", "standardized_charts").assertFalse()
	let clocks = new RewardClockRestoration()
	let accounts = new AuthoredFixture()
	registerRpgRuntimeCommands(accounts.commands, accounts.rpg).assertEquals("")
	accounts.rpg.journal.quests[0] = accounts.accounts
	historicallyReady(accounts.accounts)
	let saved = accounts.rpg.captureState()
	rewardCommand(accounts.commands, accounts.state.clock, Player(0), "/turnin ocean_of_accounts hero")
	accounts.rpg.captureState().assertEquals(saved)
	accounts.rpg.journal.lastDiagnostic.contains("world_ledger_credit").assertTrue()
	journalText(accounts.rpg).contains("Authored rewards blocked:").assertTrue()
	accounts.rpg.technologies.isUnlocked("player", "standardized_charts").assertFalse()
	clocks.restore()

@test function unrelatedGeneratedQuestKeepsItsExistingGenericRewardPath()
	let clocks = new RewardClockRestoration()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	(f.compact.authoredRewards == null).assertTrue()
	historicallyReady(f.compact)
	f.move(f.compact.turnInId)
	rewardCommand(f.commands, f.state.clock, Player(0), "/turnin europe_printed_compact hero")
	f.compact.state.assertEquals(QUEST_COMPLETE)
	f.rpg.journal.currency.assertEquals(37)
	clocks.restore()

@test function completedOldSaveNeverRetroactivelyGrantsNewResearchRewards()
	let f = new RewardFixture()
	f.ready("left")
	f.definition.state = QUEST_COMPLETE
	f.definition.completions = 1
	let saved = f.base.rpg.captureState()
	let restored = new RewardFixture()
	restored.base.rpg.restoreState(saved).assertTrue()
	restored.base.rpg.technologies.unlockedCount.assertEquals(0)
	restored.base.rpg.captureState().assertEquals(saved)
	restored.reject()
	restored.base.rpg.technologies.unlockedCount.assertEquals(0)

