@test function earnedPlayerResearchUpdatesMatchingActiveObjectiveWithoutAnotherReward()
	let f = new RewardFixture()
	let observer = new RuntimeQuest("research_observer", "Research observer", "test")
	observer.graph = new QuestGraph("observe", "")
	observer.graph.addStage(new QuestStage("observe", "Observe", "charts_observed~", ""))
	observer.graph.addObjective(new QuestObjective("charts_observed", "Own charts", "quest_technology_satisfied", "technology:standardized_charts~", "research_unlocked"))
	f.base.rpg.journal.register(observer)
	f.command("/accept research_observer")
	observer.state.assertEquals(QUEST_ACTIVE)
	f.ready("left")
	f.turnIn()
	observer.state.assertEquals(QUEST_READY)
	observer.completions.assertEquals(0)
	f.base.rpg.journal.currency.assertEquals(7)
	f.base.rpg.technologies.unlockedCount.assertEquals(1)

@test function physicalTurnInUsesSameOwnerPresenceGrantAndObserverSynchronization()
	let f = new RewardFixture()
	let observer = new RuntimeQuest("research_observer", "Research observer", "test")
	observer.graph = new QuestGraph("observe", "")
	observer.graph.addStage(new QuestStage("observe", "Observe", "charts_observed~", ""))
	observer.graph.addObjective(new QuestObjective("charts_observed", "Own charts", "quest_technology_satisfied", "technology:standardized_charts~", "research_unlocked"))
	f.base.rpg.journal.register(observer)
	f.command("/accept research_observer")
	f.ready("left")
	let saved = f.base.rpg.captureState()
	rewardCommand(f.base.commands, f.base.clock, Player(1), "/interact calicut")
	f.base.rpg.captureState().assertEquals(saved)
	f.base.ports.output.contains("Only the campaign player").assertTrue()
	rewardCommand(f.base.commands, f.base.clock, null, "/interact calicut")
	f.base.rpg.captureState().assertEquals(saved)
	f.base.actors.invalidateAt = f.base.actors.reads + 3
	f.command("/interact calicut")
	f.base.rpg.captureState().assertEquals(saved)
	f.base.ports.output.contains("no longer present").assertTrue()
	f.base.actors.invalidateAt = 0
	f.command("/interact calicut")
	f.definition.state.assertEquals(QUEST_COMPLETE)
	observer.state.assertEquals(QUEST_READY)
	observer.completions.assertEquals(0)
	f.base.rpg.journal.currency.assertEquals(7)
	f.base.rpg.technologies.unlockedCount.assertEquals(1)
	f.resources.reads.assertEquals(0)
	f.resources.writes.assertEquals(0)

@test function physicalBlockedRewardFeedbackDoesNotHideLegitimateOtherVisitProgress()
	let f = new RewardFixture()
	f.definition.authoredRewards.add(new QuestRewardOutcome("undefined_credit", "quest_economy_adjust_treasury", "", ""))
	f.ready("left")
	let visitor = new RuntimeQuest("other_visit", "Other visit", "test")
	visitor.graph = new QuestGraph("visit", "")
	visitor.graph.addStage(new QuestStage("visit", "Visit", "visit_here~", ""))
	visitor.graph.addObjective(new QuestObjective("visit_here", "Visit here", "quest_travel_satisfied", "settlement:calicut~", "physical_visit"))
	f.base.rpg.journal.register(visitor)
	f.command("/accept other_visit")
	let xp = f.base.rpg.heroes.heroes[0].cumulativeExperience()
	f.command("/interact calicut")
	f.definition.state.assertEquals(QUEST_READY)
	f.definition.completions.assertEquals(0)
	f.base.rpg.technologies.unlockedCount.assertEquals(0)
	f.base.rpg.journal.currency.assertEquals(0)
	f.base.rpg.heroes.heroes[0].cumulativeExperience().assertEquals(xp)
	visitor.state.assertEquals(QUEST_READY)
	f.base.ports.output.contains("Other interaction progress was recorded.").assertTrue()
	f.base.ports.output.contains("undefined_credit").assertTrue()
	f.base.ports.output.contains("Authored rewards blocked:").assertTrue()
	f.base.ports.output.contains("Action completed.").assertFalse()

