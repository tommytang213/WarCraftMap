import CampaignSaveManager
import PlayableCampaignRuntime

class RewardClockRestoration
	CampaignClock previous = getCampaignClock()
	ManagementScreenPauseController pauses = null
	construct()
		if previous != null
			pauses = previous.managementPause
	function restore()
		installCampaignClock(previous, pauses)

class RewardEffects extends UnboundResearchEffects
	int calls = 0
	override function replaceResearchEntitlements(ResearchEntitlements result)
		calls++
		super.replaceResearchEntitlements(result)

function rewardCommand(CommandRegistry commands, CampaignClock clock, player sender, string text)
	let previous = getCampaignClock()
	ManagementScreenPauseController pauses = null
	if previous != null
		pauses = previous.managementPause
	installCampaignClock(clock, null)
	commands.dispatch(sender, text).assertTrue()
	installCampaignClock(previous, pauses)

/** Explicitly synthetic supported-only story, using generated technology,
 * local actors, real registered commands and the real reward transaction. */
class RewardFixture
	QuestTradeFixture base = new QuestTradeFixture()
	RuntimeQuest definition = new RuntimeQuest("synthetic_research_reward", "Synthetic research reward", "test")
	ResearchResources resources = new ResearchResources()
	RewardEffects effects = new RewardEffects()
	construct()
		definition.giverId = "calicut"
		definition.turnInId = "calicut"
		definition.graph = new QuestGraph("start", "")
		definition.graph.addStage(new QuestStage("start", "Start", "visit~", "left~right~"))
		definition.graph.addStage(new QuestStage("left", "Left", "left_visit~", ""))
		definition.graph.addStage(new QuestStage("right", "Right", "right_visit~", ""))
		definition.graph.addObjective(new QuestObjective("visit", "Visit", "quest_travel_satisfied", "settlement:calicut~", "physical_visit"))
		definition.graph.addObjective(new QuestObjective("left_visit", "Visit left", "quest_travel_satisfied", "settlement:calicut~", "physical_visit"))
		definition.graph.addObjective(new QuestObjective("right_visit", "Visit right", "quest_travel_satisfied", "settlement:calicut~", "physical_visit"))
		definition.rewardExperience = 100
		definition.rewardCurrency = 7
		definition.authoredRewards = new QuestRewardBatch(definition.id, base.rpg.technologies)
		definition.authoredRewards.add(new QuestRewardOutcome("charts", "quest_technology_complete_research", "standardized_charts", ""))
		base.rpg.journal.count = 0
		base.rpg.journal.register(definition)
		resources.controller = "other"
		base.rpg.researchResources = resources
		base.rpg.technologies.effects = effects
	function command(string text)
		rewardCommand(base.commands, base.clock, Player(0), text)
	function ready(string side)
		command("/accept synthetic_research_reward")
		command("/interact calicut")
		command("/queststage synthetic_research_reward " + side)
		command("/interact calicut")
		definition.state.assertEquals(QUEST_READY)
	function turnIn()
		command("/turnin synthetic_research_reward trader")
	function reject()
		let saved = base.rpg.captureState()
		let money = base.trade.capture()
		let calls = effects.calls
		turnIn()
		base.rpg.captureState().assertEquals(saved)
		base.trade.capture().assertEquals(money)
		effects.calls.assertEquals(calls)
		resources.reads.assertEquals(0)
		resources.writes.assertEquals(0)
	function document(string rpgState) returns string
		return "v2;autosave=1|1|8:1001011;partyLocations=v1;map=middle_east_india;region=middle_east_india;world=instance:india;players=origin:vijayanagara_empire,allegiance:vijayanagara_empire,settlement:calicut;quests=;discovery=v1|r,middle_east_india|s,calicut;orders=;trade=" + base.trade.capture() + ";diplomacy=v1;rewards=v1;rpg=" + rpgState + ";militarySettlements=v1;religion=v1;piracy=v1;clock=" + base.clock.captureState()

@test function earnedResearchRewardGrantsOnlyTargetToPlayerWithoutPaymentOrPrerequisites()
	let f = new RewardFixture()
	f.ready("left")
	let money = f.base.trade.capture()
	f.base.rpg.technologies.isUnlocked("player", "standardized_charts").assertFalse()
	f.base.rpg.technologies.isUnlocked("player", "celestial_navigation").assertFalse()
	f.base.rpg.technologies.isUnlocked("player", "movable_type_printing").assertFalse()
	f.turnIn()
	f.base.ports.output.assertEquals("Action completed.")
	f.definition.state.assertEquals(QUEST_COMPLETE)
	f.definition.completions.assertEquals(1)
	f.base.rpg.journal.currency.assertEquals(7)
	f.base.rpg.heroes.heroes[0].cumulativeExperience().assertEquals(100)
	f.base.rpg.technologies.isUnlocked("player", "standardized_charts").assertTrue()
	f.base.rpg.technologies.isUnlocked("other", "standardized_charts").assertFalse()
	f.base.rpg.technologies.isUnlocked("player", "celestial_navigation").assertFalse()
	f.base.rpg.technologies.isUnlocked("player", "movable_type_printing").assertFalse()
	f.effects.get("player").has("modifier", "fleet_navigation_efficiency").assertTrue()
	f.base.trade.capture().assertEquals(money)
	f.resources.balance.assertEquals(100000)
	f.resources.reads.assertEquals(0)
	f.resources.writes.assertEquals(0)
	f.reject()
	let saved = f.base.rpg.captureState()
	let codec = new PlayableCampaignCodec(f.base.clock)
	let payload = codec.encode("manual_01", SAVE_SLOT_MANUAL, 1, "earned reward", f.document(saved))
	let decoded = codec.decodeMigrateAndValidate(payload, "manual_01")
	lastAuthorityValue(decoded, "rpg").assertEquals(saved)
	let restored = new RewardFixture()
	restored.base.rpg.restoreState(lastAuthorityValue(decoded, "rpg")).assertTrue()
	restored.base.rpg.captureState().assertEquals(saved)
	restored.base.rpg.technologies.unlockedCount.assertEquals(1)
	// The campaign loader reconciles projection layers after restoring authority.
	restored.base.rpg.reconcile("player")
	restored.base.rpg.captureState().assertEquals(saved)
	restored.effects.get("player").has("modifier", "fleet_navigation_efficiency").assertTrue()
	restored.reject()

@test function researchRewardWaitsForReadyOwnerAndFreshLocalTurnIn()
	let f = new RewardFixture()
	f.reject()
	f.command("/accept synthetic_research_reward")
	f.reject()
	f.command("/interact calicut")
	f.command("/queststage synthetic_research_reward left")
	f.command("/interact calicut")
	let saved = f.base.rpg.captureState()
	let calls = f.effects.calls
	rewardCommand(f.base.commands, f.base.clock, Player(1), "/turnin synthetic_research_reward trader")
	rewardCommand(f.base.commands, f.base.clock, null, "/turnin synthetic_research_reward trader")
	f.base.rpg.captureState().assertEquals(saved)
	f.effects.calls.assertEquals(calls)
	f.base.actors.actorX = 99999.
	f.reject()
	f.base.actors.moveTo(f.base.rpg.interactions.get("calicut"))
	f.base.actors.invalidateAt = f.base.actors.reads + 2
	f.reject()
	f.base.actors.invalidateAt = 0
	f.turnIn()
	f.definition.state.assertEquals(QUEST_COMPLETE)

@test function reachedStageSubsetExcludesUnchosenUnsupportedRewardButBlocksChosenSibling()
	let left = new RewardFixture()
	left.definition.authoredRewards.outcomes[0].requiredStages = "start~left~"
	left.definition.authoredRewards.add(new QuestRewardOutcome("undefined_credit", "quest_economy_adjust_treasury", "", "right~"))
	left.ready("left")
	left.turnIn()
	left.definition.state.assertEquals(QUEST_COMPLETE)
	let right = new RewardFixture()
	right.definition.authoredRewards.outcomes[0].requiredStages = "start~left~"
	right.definition.authoredRewards.add(new QuestRewardOutcome("undefined_credit", "quest_economy_adjust_treasury", "", "right~"))
	right.ready("right")
	right.reject()
	right.base.rpg.journal.lastDiagnostic.contains("undefined_credit").assertTrue()
	right.base.rpg.technologies.unlockedCount.assertEquals(0)

