package TreasureResolutionTests

import WarcraftRpgRuntime
import TreasureResolution
import ScenarioData
import CampaignStartupTests
import CampaignSaveManager
import PlayableCampaignRuntime
import RpgInteractionTests
import CommandRouter
import public FrameworkPorts

public function treasureFixture(int index) returns WarcraftRpgRuntime
	let rpg = new WarcraftRpgRuntime(null)
	configureGeneratedTreasures(rpg.treasures)
	configureGeneratedInteractions(rpg.interactions)
	rpg.treasures.locations = rpg.interactions.catalog
	let selected = rpg.treasures.treasures[index]
	for i = 0 to rpg.treasures.count - 1
		if i != index
			destroy rpg.treasures.treasures[i]
	rpg.treasures.treasures[0] = selected
	rpg.treasures.count = 1
	return rpg

public function treasureVector(int index, string seed, string expected)
	let rpg = treasureFixture(index)
	rpg.treasures.campaignSeed.assertEquals("")
	rpg.treasures.resolveAll(seed).assertTrue()
	let t = rpg.treasures.treasures[0]
	t.resolution.encode().assertEquals(expected)
	rpg.treasures.unavailableCandidateIds = "|" + t.resolvedLocationId + "|"
	rpg.treasures.resolveAll(seed).assertTrue()
	t.resolution.encode().assertEquals(expected)
	let saved = rpg.captureState()
	let fresh = treasureFixture(index)
	fresh.restoreState(saved).assertTrue()
	fresh.captureState().assertEquals(saved)
	fresh.treasures.campaignSeed.assertEquals(seed)
	fresh.treasures.resolveAll(seed).assertTrue()
	fresh.captureState().assertEquals(saved)

@test
function namespacedShaMatchesTwoBlockAndUnsignedHeadlessVectors()
	treasurePick("1", "treasure_order_of_christ_archive:location", 5).assertEquals(0)
	treasurePick("4", "treasure_order_of_christ_archive:location", 5).assertEquals(4)
	treasurePick("2147483647", "treasure_abcdefghijklmnopqrstuvwxyz_abcdefghijklmnopqrstuvwxyz:reward", 999983).assertEquals(348598)

@test
function treasureUnavailableAndInvalidAnchorFailAtomically()
	let rpg = treasureFixture(0)
	let t = rpg.treasures.treasures[0]
	let before = rpg.captureState()
	rpg.treasures.unavailableCandidateIds = "|cand_templar_tomar||cand_templar_almourol|"
	rpg.treasures.resolveAll("1").assertFalse()
	rpg.captureState().assertEquals(before)
	rpg.treasures.unavailableCandidateIds = ""
	t.definition.anchorRegions = "|unrelated|"
	rpg.treasures.resolveAll("1").assertFalse()
	rpg.captureState().assertEquals(before)
	t.definition.anchorRegions = "|europe|"
	t.definition.candidates[0].placementValid = false
	t.definition.candidates[1].placementValid = false
	rpg.treasures.resolveAll("1").assertFalse()
	rpg.captureState().assertEquals(before)

@test
function treasureExclusiveFallbackCannotBypassOccupationOrAvailability()
	let rpg = treasureFixture(0)
	let first = rpg.treasures.treasures[0]
	let second = new RuntimeTreasure("second", "", "")
	second.definition = first.definition
	rpg.treasures.register(second)
	rpg.treasures.unavailableCandidateIds = "|cand_templar_almourol|"
	first.definition.fallbackId = "cand_templar_tomar"
	let before = rpg.captureState()
	rpg.treasures.resolveAll("1").assertFalse()
	rpg.captureState().assertEquals(before)
	first.definition.candidates[0].shared = true
	rpg.treasures.resolveAll("1").assertTrue()
	first.resolvedLocationId.assertEquals(second.resolvedLocationId)

@test
function treasureLegacyMigrationPreservesKnowledgeCollectionAndUnknownRewards()
	let rpg = treasureFixture(0)
	let legacy = "v6|p,|j,,0|t,treasure_order_of_christ_archive,4,1"
	rpg.restoreState(legacy).assertTrue()
	let t = rpg.treasures.treasures[0]
	t.resolution.encode().assertEquals("legacy,cand_templar_tomar,,,,")
	t.discovered.assertTrue()
	t.clueStage.assertEquals(4)
	rpg.inventory.ownedCount.assertEquals(0)
	rpg.treasures.campaignSeed.assertEquals("1")
	let saved = rpg.captureState()
	let fresh = treasureFixture(0)
	fresh.restoreState(saved).assertTrue()
	fresh.captureState().assertEquals(saved)
	fresh.treasures.resolveAll("1").assertTrue()
	fresh.treasures.discover(t.id,t.resolvedLocationId,fresh.inventory).assertFalse()
	fresh.inventory.ownedCount.assertEquals(0)
	rpg.restoreState("v6|p,|j,,0|t,treasure_order_of_christ_archive,2,0").assertTrue()
	rpg.treasures.treasures[0].clueStage.assertEquals(2)
	rpg.treasures.treasures[0].resolvedLocationId.assertEquals("cand_templar_tomar")

@test
function treasureMalformedRecordsAndMigrationRejectWithoutMutatingAuthority()
	let rpg = treasureFixture(0)
	rpg.treasures.resolveAll("4").assertTrue()
	let before = rpg.captureState()
	rpg.restoreState("v7|p,|s,4|j,,0|t,treasure_order_of_christ_archive,0,0,seeded,missing,relic_and_coin,local_watch,unstable_ruins,careful_recovery").assertFalse()
	rpg.restoreState("v7|p,|s,4|j,,0|t,treasure_order_of_christ_archive,0,0,seeded,cand_templar_tomar,missing,local_watch,unstable_ruins,careful_recovery").assertFalse()
	rpg.restoreState("v7|p,|s,|j,,0|t,treasure_order_of_christ_archive,0,0,seeded,cand_templar_tomar,relic_and_coin,local_watch,unstable_ruins,careful_recovery").assertFalse()
	rpg.captureState().assertEquals(before)
	rpg.treasures.treasures[0].definition.legacyLocationId = "missing"
	rpg.restoreState("v6|p,|j,,0|t,treasure_order_of_christ_archive,1,0").assertFalse()
	rpg.captureState().assertEquals(before)

@test
function treasureStartupCheckpointFailureKeepsSeedAcrossFreshServices()
	let cache = new StartupStorage()
	let saves = new StartupStorage()
	let first = new StartupFixture(cache, saves, "europe_west")
	first.choose("england")
	first.register()
	cache.failKey = first.handoff.readRequest().checkpointSlot()
	first.campaign.startup().assertFalse()
	let seed = first.campaign.state.rpg.treasures.campaignSeed
	let resolved = first.campaign.state.rpg.treasures.treasures[0].resolution.encode()
	cache.failKey = ""
	let retry = new StartupFixture(cache, saves, "europe_west")
	retry.register()
	retry.campaign.startup().assertTrue()
	retry.campaign.state.rpg.treasures.campaignSeed.assertEquals(seed)
	retry.campaign.state.rpg.treasures.treasures[0].resolution.encode().assertEquals(resolved)
	retry.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "treasure").assertTrue()
	let source = saves.read("manual_01")
	(source != "").assertTrue()
	let fresh = new StartupFixture(cache, saves, "europe_west")
	fresh.register()
	let beforeFailure = fresh.campaign.state.rpg.captureState()
	fresh.ports.failProjection = true
	fresh.campaign.startup().assertFalse()
	fresh.campaign.state.rpg.captureState().assertEquals(beforeFailure)
	saves.read("manual_01").assertEquals(source)
	fresh.ports.failProjection = false
	fresh.campaign.startup().assertTrue()
	fresh.campaign.state.rpg.treasures.campaignSeed.assertEquals(seed)
	fresh.campaign.state.rpg.treasures.treasures[0].resolution.encode().assertEquals(resolved)

class TreasureKnowledgePorts extends StartupPorts
	string knownRegion = ""
	string knownDestination = ""
	override function applyTreasureKnowledge(string treasureId, int clueStage, boolean discovered, string regionId, string destinationId)
		knownRegion = regionId
		knownDestination = destinationId

@test
function treasureProjectionUsesCommittedCandidateOnlyAtEarnedPrecision()
	let rpg = treasureFixture(0)
	let ports = new TreasureKnowledgePorts()
	rpg.setProjectionPort(ports)
	rpg.treasures.resolveAll("4").assertTrue()
	rpg.reconcile("player")
	ports.knownRegion.assertEquals("")
	ports.knownDestination.assertEquals("")
	let t = rpg.treasures.treasures[0]
	for i = 1 to 3
		rpg.treasures.advanceClue(t.id).assertTrue()
		rpg.reconcile("player")
		ports.knownRegion.assertEquals("europe")
		ports.knownDestination.assertEquals("")
	rpg.treasures.advanceClue(t.id).assertTrue()
	rpg.reconcile("player")
	ports.knownDestination.assertEquals("cand_templar_almourol")

@test
function treasureValidFallbackAndNavigationRejectionMatchAuthoredRules()
	let rpg = treasureFixture(0)
	let t = rpg.treasures.treasures[0]
	t.definition.fallbackId = "cand_templar_almourol"
	t.definition.candidates[1].fallbackOnly = true
	rpg.treasures.unavailableCandidateIds = "|cand_templar_tomar|"
	let before = rpg.captureState()
	t.definition.candidates[1].mapId = "wrong_map"
	rpg.treasures.resolveAll("1").assertFalse()
	rpg.captureState().assertEquals(before)
	t.definition.candidates[1].mapId = "europe_west"
	rpg.treasures.resolveAll("1").assertTrue()
	t.resolution.candidateId.assertEquals("cand_templar_almourol")
	let resolved = rpg.captureState()
	rpg.treasures.resolveAll("4").assertFalse()
	rpg.captureState().assertEquals(resolved)

@test
function pendingTreasureAuthorityCannotBeSavedAsACampaign()
	let rpg = treasureFixture(0)
	let pending = rpg.captureState()
	rpg.validateState(pending).assertTrue()
	rpg.validateCampaignState(pending).assertFalse()
	rpg.restoreState(pending).assertTrue()
	rpg.treasures.resolveAll("1").assertTrue()
	rpg.validateCampaignState(rpg.captureState()).assertTrue()

@test
function exhaustingRegionOnlyCluesNeverRevealsAnExactCandidate()
	let rpg = treasureFixture(0)
	let ports = new TreasureKnowledgePorts()
	rpg.setProjectionPort(ports)
	rpg.treasures.resolveAll("4").assertTrue()
	let t = rpg.treasures.treasures[0]
	for i = 0 to t.clueCount - 1
		t.definition.cluePrecisions[i] = 1
		rpg.treasures.advanceClue(t.id).assertTrue()
	rpg.reconcile("player")
	ports.knownRegion.assertEquals("europe")
	ports.knownDestination.assertEquals("")
