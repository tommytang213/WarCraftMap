package WarcraftRpgRuntime

import WC3Compatibility
import ManagementScreenPauseController
import CommandRouter

public constant int RPG_LEVEL_CAP = 300
public constant int RPG_DEFAULT_ACTIVE_HERO_LIMIT = 32
public constant int RPG_STATE_SCHEMA_VERSION = 2
public constant string QUEST_OFFERED = "offered"
public constant string QUEST_ACTIVE = "active"
public constant string QUEST_READY = "ready_to_turn_in"
public constant string QUEST_COMPLETE = "complete"
public constant string QUEST_FAILED = "failed"

function textContains(string haystack,string needle) returns boolean
	if needle == ""
		return true
	for i=0 to StringLength(haystack)-StringLength(needle)
		if SubString(haystack,i,i+StringLength(needle)) == needle
			return true
	return false

function rpgField(string record, int wanted) returns string
	var start = 0
	var field = 0
	for i = 0 to StringLength(record)
		if i == StringLength(record) or SubString(record,i,i+1) == ","
			if field == wanted
				return SubString(record,start,i)
			field++
			start=i+1
	return ""

function rpgFieldCount(string record) returns int
	if record == ""
		return 0
	var result=1
	for i=0 to StringLength(record)-1
		if SubString(record,i,i+1) == ","
			result++
	return result

function rpgBool(string value) returns boolean
	return value == "1"

function rpgBoolText(boolean value) returns string
	if value
		return "1"
	return "0"

function rpgValidBool(string value) returns boolean
	return value == "0" or value == "1"

function rpgValidInt(string value) returns boolean
	if value == "0"
		return true
	if value == "" or value.startsWith("0") or value == "-0"
		return false
	return S2I(value).toString() == value

function rpgStableText(string value) returns boolean
	return value.indexOf(",") < 0 and value.indexOf("|") < 0 and value.indexOf(";") < 0

/** Authoritative character state.  The Warcraft handle is deliberately kept by
 * the projection, not here, so a dead/unloaded object can never erase a hero. */
public class RpgHero
	string id
	string name
	int unitTypeId
	int level = 1
	int experience = 0
	int skillPoints = 0
	int masteryPoints = 0
	int commandExperience = 0
	int loyalty = 50
	boolean oathbound = false
	boolean recruited = false
	boolean incapacitated = false
	int recoveryDay = 0
	string assignment = "unrecruited"
	string regionId = ""
	string professionId = ""
	string personalQuestId = ""
	string signatureProgressionId = ""
	string chosenPerks = ""
	construct(string id, string name, int unitTypeId)
		this.id = id
		this.name = name
		this.unitTypeId = unitTypeId
	function awardExperience(int amount)
		if amount <= 0
			return
		experience += amount
		while level < RPG_LEVEL_CAP and experience >= level * 100
			experience -= level * 100
			level++
			skillPoints++
			if level % 5 == 0
				masteryPoints++
	function applyLaterEraStart(int campaignYear,int careerStartYear)
		if campaignYear > careerStartYear
			level=IMinBJ(RPG_LEVEL_CAP,1+(campaignYear-careerStartYear) div 2)
			skillPoints=level-1
			masteryPoints=level div 5
	function choosePerk(string perkId,int requiredLevel) returns boolean
		if perkId == "" or not rpgStableText(perkId) or perkId.indexOf("~") >= 0 or level < requiredLevel or textContains(chosenPerks,"~"+perkId+"~")
			return false
		chosenPerks += "~"+perkId+"~"
		return true
	function changeLoyalty(int delta)
		if oathbound and delta < 0
			return
		loyalty = IMaxBJ(0, IMinBJ(100, loyalty + delta))
	function becomeOathbound()
		oathbound = true
		loyalty = 100
	function wound(int currentDay, int recoveryDays)
		incapacitated = true
		recoveryDay = currentDay + IMaxBJ(1, recoveryDays)
		assignment = "recovering"
	function advanceRecovery(int currentDay)
		if incapacitated and currentDay >= recoveryDay
			incapacitated = false
			assignment = "reserve"

public class HeroRoster
	RpgHero array[2048] heroes
	unit array[2048] projected
	int count = 0
	int activeLimit = RPG_DEFAULT_ACTIVE_HERO_LIMIT
	function indexOf(string id) returns int
		for i = 0 to count - 1
			if heroes[i].id == id
				return i
		return -1
	function register(RpgHero hero)
		if indexOf(hero.id) < 0
			heroes[count] = hero
			count++
	function get(string id) returns RpgHero
		let i = indexOf(id)
		if i >= 0
			return heroes[i]
		return null
	function recruit(string id) returns boolean
		let hero = get(id)
		if hero == null or hero.recruited
			return false
		hero.recruited = true
		hero.assignment = "reserve"
		return true
	function strategicRosterSize() returns int
		var result = 0
		for i = 0 to count - 1
			if heroes[i].recruited
				result++
		return result
	function activeCount() returns int
		var result = 0
		for i = 0 to count - 1
			if projected[i] != null and GetUnitTypeId(projected[i]) != 0
				result++
		return result
	function deploy(string id, player owner, real x, real y) returns boolean
		let i = indexOf(id)
		if i < 0 or not heroes[i].recruited or heroes[i].incapacitated or activeCount() >= activeLimit
			return false
		if projected[i] == null or GetUnitTypeId(projected[i]) == 0
			projected[i] = compatCreateUnit(owner, heroes[i].unitTypeId, x, y, 0.)
		heroes[i].assignment = "field"
		return true
	function assignRemote(string id, string assignment, string regionId) returns boolean
		let i = indexOf(id)
		if i < 0 or not heroes[i].recruited or heroes[i].incapacitated or assignment == ""
			return false
		if projected[i] != null
			compatRemoveUnit(projected[i])
			projected[i] = null
		heroes[i].assignment = assignment
		heroes[i].regionId = regionId
		return true
	function loseRuntimeObjects()
		for i = 0 to count - 1
			if projected[i] != null and GetUnitTypeId(projected[i]) != 0
				compatRemoveUnit(projected[i])
			projected[i] = null
	function reconstructField(player owner, real x, real y)
		for i = 0 to count - 1
			if heroes[i].recruited and heroes[i].assignment == "field" and not heroes[i].incapacitated and activeCount() < activeLimit
				projected[i] = compatCreateUnit(owner, heroes[i].unitTypeId, x, y, 0.)

public class RpgItem
	string id
	string name
	string slotId
	string rarity
	string setId
	int itemLevel
	int power
	int requiredLevel
	int startYear
	int endYear
	string technologyId
	string institutionId
	string source
	boolean unique
	construct(string id, string name, string slotId, string rarity, int itemLevel, int power)
		this.id=id
		this.name=name
		this.slotId=slotId
		this.rarity=rarity
		this.itemLevel=itemLevel
		this.power=power

public class EquipmentSet
	string id
	int partialPieces
	int partialPower
	int fullPieces
	int fullPower
	construct(string id, int partialPieces, int partialPower, int fullPieces, int fullPower)
		this.id=id
		this.partialPieces=partialPieces
		this.partialPower=partialPower
		this.fullPieces=fullPieces
		this.fullPower=fullPower

public class PlayerInventory
	RpgItem array[4096] definitions
	int definitionCount = 0
	string array[4096] owned
	int ownedCount = 0
	string array[32] equippedSlots
	string array[32] equippedItems
	string array[32] equippedHeroes
	int equippedCount = 0
	EquipmentSet array[256] sets
	int setCount = 0
	function registerItem(RpgItem itemDefinition)
		definitions[definitionCount] = itemDefinition
		definitionCount++
	function registerSet(EquipmentSet setDefinition)
		sets[setCount] = setDefinition
		setCount++
	function getItem(string id) returns RpgItem
		for i = 0 to definitionCount - 1
			if definitions[i].id == id
				return definitions[i]
		return null
	function owns(string id) returns boolean
		for i = 0 to ownedCount - 1
			if owned[i] == id
				return true
		return false
	function grant(string id) returns boolean
		let value = getItem(id)
		if value == null or value.unique and owns(id)
			return false
		owned[ownedCount] = id
		ownedCount++
		return true
	function slotIndex(string slotId) returns int
		for i = 0 to equippedCount - 1
			if equippedSlots[i] == slotId
				return i
		return -1
	function available(RpgItem value, RpgHero hero, int year, string technologies, string institutions) returns boolean
		return value != null and hero != null and hero.level >= value.requiredLevel and (value.startYear == 0 or year >= value.startYear) and (value.endYear == 0 or year <= value.endYear) and (value.technologyId == "" or textContains(technologies,value.technologyId)) and (value.institutionId == "" or textContains(institutions,value.institutionId))
	function equip(string heroId, string itemId, RpgHero hero, int year, string technologies, string institutions) returns boolean
		let value = getItem(itemId)
		if not owns(itemId) or not available(value, hero, year, technologies, institutions)
			return false
		var slot = slotIndex(value.slotId)
		if slot < 0
			slot = equippedCount
			equippedSlots[slot] = value.slotId
			equippedCount++
		equippedItems[slot] = itemId
		equippedHeroes[slot] = heroId
		return true
	function comparison(string itemId) returns string
		let value = getItem(itemId)
		if value == null
			return "Unknown item"
		let slot = slotIndex(value.slotId)
		var delta = value.power
		if slot >= 0 and getItem(equippedItems[slot]) != null
			delta -= getItem(equippedItems[slot]).power
		var color = "|cffaaaaaa"
		if delta > 0
			color = "|cff00ff00+"
		else if delta < 0
			color = "|cffff4040"
		return value.name + " | Item level " + value.itemLevel + " | " + value.rarity + " | " + color + delta + " power|r | Set: " + value.setId
	function setPieceCount(string setId) returns int
		var result = 0
		for i = 0 to equippedCount - 1
			let value = getItem(equippedItems[i])
			if value != null and value.setId == setId
				result++
		return result
	function setBonusPower() returns int
		var result = 0
		for i = 0 to setCount - 1
			let pieces = setPieceCount(sets[i].id)
			if pieces >= sets[i].partialPieces
				result += sets[i].partialPower
			if pieces >= sets[i].fullPieces
				result += sets[i].fullPower
		return result

public class RuntimeQuest
	string id
	string title
	string kind
	string regionId
	string giverId
	string turnInId
	string precision
	string destinationId
	string state = QUEST_OFFERED
	int objective = 0
	int objectiveTarget = 1
	int rewardExperience = 0
	int rewardCurrency = 0
	int cooldownUntil = 0
	int completions = 0
	int completionCap = 1
	construct(string id, string title, string kind)
		this.id=id
		this.title=title
		this.kind=kind

public class QuestJournalRuntime
	RuntimeQuest array[2048] quests
	int count = 0
	string trackedId = ""
	int currency = 0
	function register(RuntimeQuest questDefinition)
		quests[count]=questDefinition
		count++
	function get(string id) returns RuntimeQuest
		for i = 0 to count - 1
			if quests[i].id == id
				return quests[i]
		return null
	function deterministicOffer(string settlementId, int epoch) returns RuntimeQuest
		if count == 0
			return null
		var start = ModuloInteger(StringLength(settlementId) * 31 + epoch, count)
		for offset = 0 to count - 1
			let candidate = quests[ModuloInteger(start + offset, count)]
			if candidate.state == QUEST_OFFERED and candidate.completions < candidate.completionCap and epoch >= candidate.cooldownUntil
				return candidate
		return null
	function accept(string id) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_OFFERED
			return false
		questDefinition.state=QUEST_ACTIVE
		return true
	function progress(string id, int amount) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_ACTIVE or amount <= 0
			return false
		questDefinition.objective=IMinBJ(questDefinition.objectiveTarget,questDefinition.objective+amount)
		if questDefinition.objective >= questDefinition.objectiveTarget
			questDefinition.state=QUEST_READY
		return true
	function fail(string id, int day, int cooldownDays) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_ACTIVE
			return false
		questDefinition.state=QUEST_FAILED
		questDefinition.cooldownUntil=day+cooldownDays
		return true
	function turnIn(string id, RpgHero hero, int day, int cooldownDays) returns boolean
		let questDefinition=get(id)
		if questDefinition == null or questDefinition.state != QUEST_READY
			return false
		questDefinition.state=QUEST_COMPLETE
		questDefinition.completions++
		questDefinition.cooldownUntil=day+cooldownDays
		currency+=questDefinition.rewardCurrency
		if hero != null
			hero.awardExperience(questDefinition.rewardExperience)
		return true
	function refill(int day)
		for i = 0 to count - 1
			if (quests[i].state == QUEST_COMPLETE or quests[i].state == QUEST_FAILED) and quests[i].completions < quests[i].completionCap and day >= quests[i].cooldownUntil
				quests[i].state=QUEST_OFFERED
				quests[i].objective=0
	function track(string id) returns string
		let questDefinition=get(id)
		if questDefinition == null
			return "Quest is unknown."
		trackedId=id
		if questDefinition.precision == "hidden"
			return "No destination is revealed yet."
		return questDefinition.precision + ":" + questDefinition.regionId + ":" + questDefinition.destinationId

public class RuntimeTreasure
	string id
	string regionId
	string resolvedLocationId
	int clueStage = 0
	int clueCount = 1
	boolean discovered = false
	string rewardItemId = ""
	construct(string id, string regionId, string resolvedLocationId)
		this.id=id
		this.regionId=regionId
		this.resolvedLocationId=resolvedLocationId

public class TreasureRuntime
	RuntimeTreasure array[512] treasures
	int count=0
	function register(RuntimeTreasure treasure)
		treasures[count]=treasure
		count++
	function get(string id) returns RuntimeTreasure
		for i=0 to count-1
			if treasures[i].id == id
				return treasures[i]
		return null
	function advanceClue(string id) returns boolean
		let treasure=get(id)
		if treasure == null or treasure.discovered
			return false
		treasure.clueStage=IMinBJ(treasure.clueCount,treasure.clueStage+1)
		return true
	function discover(string id, string locationId, PlayerInventory inventory) returns boolean
		let treasure=get(id)
		if treasure == null or treasure.discovered or treasure.clueStage < treasure.clueCount or treasure.resolvedLocationId != locationId
			return false
		treasure.discovered=true
		if treasure.rewardItemId != ""
			inventory.grant(treasure.rewardItemId)
		return true

public interface TechnologyEffectPort
	function applyTechnology(string controllerId, string effectId, int magnitude)
	function clearTechnologyLayer(string controllerId)

public interface RpgProjectionPort
	function clearEquipmentLayer()
	function applyEquipment(string heroId,string itemId,int power)
	function applyEquipmentSet(string setId,int power)
	function clearGuidanceLayer()
	function applyQuestGuidance(string questId,string precision,string regionId,string destinationId)
	function clearTreasureKnowledgeLayer()
	function applyTreasureKnowledge(string treasureId,int clueStage,boolean discovered)

public class RuntimeTechnology
	string id
	string name
	string kind = "technology"
	int historicalYear
	int baseCost
	string prerequisiteId
	string effectId
	int effectMagnitude
	construct(string id,string name,int historicalYear,int baseCost)
		this.id=id
		this.name=name
		this.historicalYear=historicalYear
		this.baseCost=baseCost

public class TechnologyRuntime
	RuntimeTechnology array[512] definitions
	int count=0
	string array[2048] unlockedKeys
	int unlockedCount=0
	TechnologyEffectPort effects
	construct(TechnologyEffectPort effects)
		this.effects=effects
	function register(RuntimeTechnology technology)
		definitions[count]=technology
		count++
	function get(string id) returns RuntimeTechnology
		for i=0 to count-1
			if definitions[i].id == id
				return definitions[i]
		return null
	function isUnlocked(string controllerId,string id) returns boolean
		for i=0 to unlockedCount-1
			if unlockedKeys[i] == controllerId+":"+id
				return true
		return false
	function cost(string id,int year,int provincialAdoption,int institutionalSupport) returns int
		let technology=get(id)
		if technology == null
			return 0
		var ahead=IMaxBJ(0,technology.historicalYear-year)
		return IMaxBJ(1,technology.baseCost+ahead*technology.baseCost div 20-provincialAdoption-institutionalSupport)
	function unlock(string controllerId,string id,int year,int paid,int provincialAdoption,int institutionalSupport) returns boolean
		let technology=get(id)
		if technology == null or isUnlocked(controllerId,id) or paid < cost(id,year,provincialAdoption,institutionalSupport) or technology.prerequisiteId != "" and not isUnlocked(controllerId,technology.prerequisiteId)
			return false
		unlockedKeys[unlockedCount]=controllerId+":"+id
		unlockedCount++
		if effects != null
			effects.applyTechnology(controllerId,technology.effectId,technology.effectMagnitude)
		return true
	function reconstruct(string controllerId)
		if effects == null
			return
		effects.clearTechnologyLayer(controllerId)
		for i=0 to count-1
			if isUnlocked(controllerId,definitions[i].id)
				effects.applyTechnology(controllerId,definitions[i].effectId,definitions[i].effectMagnitude)

/** One owner for authoritative RPG state. Serialization ports capture these
 * stable fields; reconstruct() recreates only transient Warcraft projections. */
public class WarcraftRpgRuntime
	HeroRoster heroes = new HeroRoster()
	PlayerInventory inventory = new PlayerInventory()
	QuestJournalRuntime journal = new QuestJournalRuntime()
	TreasureRuntime treasures = new TreasureRuntime()
	TechnologyRuntime technologies
	RpgProjectionPort projections = null
	string lastDiagnostic = ""
	construct(TechnologyEffectPort effects)
		technologies = new TechnologyRuntime(effects)
	function setProjectionPort(RpgProjectionPort value)
		projections=value
	function diagnostic() returns string
		return lastDiagnostic
	function validQuestState(string value) returns boolean
		return value == QUEST_OFFERED or value == QUEST_ACTIVE or value == QUEST_READY or value == QUEST_COMPLETE or value == QUEST_FAILED
	function duplicateRecord(string candidate,string kind,string id) returns boolean
		var found=0
		var start=3
		while start < StringLength(candidate)
			var finish=SubString(candidate,start,StringLength(candidate)).indexOf("|")
			if finish < 0
				finish=StringLength(candidate)-start
			let record=SubString(candidate,start,start+finish)
			if rpgField(record,0) == kind and rpgField(record,1) == id
				found++
			start+=finish+1
		return found > 1
	function duplicateUnlock(string candidate,string controllerId,string technologyId) returns boolean
		var found=0
		var start=3
		while start < StringLength(candidate)
			var finish=SubString(candidate,start,StringLength(candidate)).indexOf("|")
			if finish < 0
				finish=StringLength(candidate)-start
			let record=SubString(candidate,start,start+finish)
			if rpgField(record,0) == "u" and rpgField(record,1) == controllerId and rpgField(record,2) == technologyId
				found++
			start+=finish+1
		return found > 1
	function hasRecord(string candidate,string kind,string id) returns boolean
		var start=3
		while start < StringLength(candidate)
			var finish=SubString(candidate,start,StringLength(candidate)).indexOf("|")
			if finish < 0
				finish=StringLength(candidate)-start
			let record=SubString(candidate,start,start+finish)
			if rpgField(record,0) == kind and rpgField(record,1) == id
				return true
			start+=finish+1
		return false
	function validateRecord(string candidate,string record) returns boolean
		let kind=rpgField(record,0)
		let id=rpgField(record,1)
		if kind == "h"
			return rpgFieldCount(record) == 18 and heroes.get(id) != null and not duplicateRecord(candidate,kind,id) and rpgValidBool(rpgField(record,2)) and rpgValidInt(rpgField(record,3)) and S2I(rpgField(record,3)) >= 1 and S2I(rpgField(record,3)) <= RPG_LEVEL_CAP and rpgValidInt(rpgField(record,4)) and rpgValidInt(rpgField(record,5)) and rpgValidInt(rpgField(record,6)) and rpgValidInt(rpgField(record,7)) and rpgValidInt(rpgField(record,8)) and S2I(rpgField(record,8)) >= 0 and S2I(rpgField(record,8)) <= 100 and rpgValidBool(rpgField(record,9)) and rpgValidBool(rpgField(record,10)) and rpgValidInt(rpgField(record,11)) and rpgStableText(rpgField(record,12)) and rpgStableText(rpgField(record,13)) and rpgStableText(rpgField(record,14)) and rpgStableText(rpgField(record,15)) and rpgStableText(rpgField(record,16)) and rpgStableText(rpgField(record,17))
		if kind == "i"
			return rpgFieldCount(record) == 2 and inventory.getItem(id) != null and not duplicateRecord(candidate,kind,id)
		if kind == "e"
			return rpgFieldCount(record) == 4 and inventory.getItem(rpgField(record,2)) != null and id == inventory.getItem(rpgField(record,2)).slotId and hasRecord(candidate,"i",rpgField(record,2)) and heroes.get(rpgField(record,3)) != null and not duplicateRecord(candidate,kind,id)
		if kind == "u"
			return rpgFieldCount(record) == 3 and id != "" and technologies.get(rpgField(record,2)) != null and not duplicateUnlock(candidate,id,rpgField(record,2))
		if kind == "q"
			return rpgFieldCount(record) == 6 and journal.get(id) != null and not duplicateRecord(candidate,kind,id) and validQuestState(rpgField(record,2)) and rpgValidInt(rpgField(record,3)) and rpgValidInt(rpgField(record,4)) and rpgValidInt(rpgField(record,5))
		if kind == "j"
			return rpgFieldCount(record) == 3 and (id == "" or journal.get(id) != null) and rpgValidInt(rpgField(record,2))
		if kind == "t"
			return rpgFieldCount(record) == 4 and treasures.get(id) != null and not duplicateRecord(candidate,kind,id) and rpgValidInt(rpgField(record,2)) and S2I(rpgField(record,2)) >= 0 and S2I(rpgField(record,2)) <= treasures.get(id).clueCount and rpgValidBool(rpgField(record,3))
		return false
	function captureState() returns string
		var result="v"+RPG_STATE_SCHEMA_VERSION.toString()
		for i=0 to heroes.count-1
			let h=heroes.heroes[i]
			result+="|h,"+h.id+","+rpgBoolText(h.recruited)+","+h.level.toString()+","+h.experience.toString()+","+h.skillPoints.toString()+","+h.masteryPoints.toString()+","+h.commandExperience.toString()+","+h.loyalty.toString()+","+rpgBoolText(h.oathbound)+","+rpgBoolText(h.incapacitated)+","+h.recoveryDay.toString()+","+h.assignment+","+h.regionId+","+h.professionId+","+h.personalQuestId+","+h.signatureProgressionId+","+h.chosenPerks
		for i=0 to inventory.ownedCount-1
			result+="|i,"+inventory.owned[i]
		for i=0 to inventory.equippedCount-1
			result+="|e,"+inventory.equippedSlots[i]+","+inventory.equippedItems[i]+","+inventory.equippedHeroes[i]
		for i=0 to technologies.unlockedCount-1
			let key=technologies.unlockedKeys[i]
			let cut=key.indexOf(":")
			result+="|u,"+SubString(key,0,cut)+","+SubString(key,cut+1,StringLength(key))
		for i=0 to journal.count-1
			let q=journal.quests[i]
			result+="|q,"+q.id+","+q.state+","+q.objective.toString()+","+q.cooldownUntil.toString()+","+q.completions.toString()
		result+="|j,"+journal.trackedId+","+journal.currency.toString()
		for i=0 to treasures.count-1
			let t=treasures.treasures[i]
			result+="|t,"+t.id+","+t.clueStage.toString()+","+rpgBoolText(t.discovered)
		return result
	function applyRecord(string record)
		let kind=rpgField(record,0)
		let id=rpgField(record,1)
		if kind == "h"
			let h=heroes.get(id)
			h.recruited=rpgBool(rpgField(record,2))
			h.level=S2I(rpgField(record,3))
			h.experience=S2I(rpgField(record,4))
			h.skillPoints=S2I(rpgField(record,5))
			h.masteryPoints=S2I(rpgField(record,6))
			h.commandExperience=S2I(rpgField(record,7))
			h.loyalty=S2I(rpgField(record,8))
			h.oathbound=rpgBool(rpgField(record,9))
			h.incapacitated=rpgBool(rpgField(record,10))
			h.recoveryDay=S2I(rpgField(record,11))
			h.assignment=rpgField(record,12)
			h.regionId=rpgField(record,13)
			h.professionId=rpgField(record,14)
			h.personalQuestId=rpgField(record,15)
			h.signatureProgressionId=rpgField(record,16)
			h.chosenPerks=rpgField(record,17)
		else if kind == "i"
			inventory.owned[inventory.ownedCount]=id
			inventory.ownedCount++
		else if kind == "e"
			inventory.equippedSlots[inventory.equippedCount]=id
			inventory.equippedItems[inventory.equippedCount]=rpgField(record,2)
			inventory.equippedHeroes[inventory.equippedCount]=rpgField(record,3)
			inventory.equippedCount++
		else if kind == "u"
			technologies.unlockedKeys[technologies.unlockedCount]=id+":"+rpgField(record,2)
			technologies.unlockedCount++
		else if kind == "q"
			let q=journal.get(id)
			q.state=rpgField(record,2)
			q.objective=S2I(rpgField(record,3))
			q.cooldownUntil=S2I(rpgField(record,4))
			q.completions=S2I(rpgField(record,5))
		else if kind == "j"
			journal.trackedId=id
			journal.currency=S2I(rpgField(record,2))
		else if kind == "t"
			let t=treasures.get(id)
			t.clueStage=S2I(rpgField(record,2))
			t.discovered=rpgBool(rpgField(record,3))
	function restoreState(string candidate) returns boolean
		if not validateState(candidate)
			return false
		inventory.ownedCount=0
		inventory.equippedCount=0
		technologies.unlockedCount=0
		if candidate == "v1"
			for i=0 to heroes.count-1
				let h=heroes.heroes[i]
				h.level=1
				h.experience=0
				h.skillPoints=0
				h.masteryPoints=0
				h.commandExperience=0
				h.loyalty=50
				h.oathbound=false
				h.recruited=false
				h.incapacitated=false
				h.recoveryDay=0
				h.assignment="unrecruited"
				h.regionId=""
				h.chosenPerks=""
			for i=0 to journal.count-1
				let q=journal.quests[i]
				q.state=QUEST_OFFERED
				q.objective=0
				q.cooldownUntil=0
				q.completions=0
			journal.trackedId=""
			journal.currency=0
			for i=0 to treasures.count-1
				treasures.treasures[i].clueStage=0
				treasures.treasures[i].discovered=false
			lastDiagnostic=""
			return true
		var start=3
		while start < StringLength(candidate)
			var finish=SubString(candidate,start,StringLength(candidate)).indexOf("|")
			if finish < 0
				finish=StringLength(candidate)-start
			applyRecord(SubString(candidate,start,start+finish))
			start+=finish+1
		lastDiagnostic=""
		return true
	function validateState(string candidate) returns boolean
		if candidate == "v1"
			lastDiagnostic=""
			return true
		if not candidate.startsWith("v2|")
			lastDiagnostic="RPG state schema is incompatible"
			return false
		var start=3
		var heroRecords=0
		var itemRecords=0
		var equipmentRecords=0
		var unlockRecords=0
		var questRecords=0
		var journalRecords=0
		var treasureRecords=0
		while start < StringLength(candidate)
			var finish=SubString(candidate,start,StringLength(candidate)).indexOf("|")
			if finish < 0
				finish=StringLength(candidate)-start
			let record=SubString(candidate,start,start+finish)
			if not validateRecord(candidate,record)
				lastDiagnostic="RPG state contains malformed or unknown authority"
				return false
			let kind=rpgField(record,0)
			if kind == "h"
				heroRecords++
			else if kind == "i"
				itemRecords++
			else if kind == "e"
				equipmentRecords++
			else if kind == "u"
				unlockRecords++
			else if kind == "q"
				questRecords++
			else if kind == "j"
				journalRecords++
			else if kind == "t"
				treasureRecords++
			start+=finish+1
		if heroRecords != heroes.count or questRecords != journal.count or treasureRecords != treasures.count or journalRecords != 1 or itemRecords > 4096 or equipmentRecords > 32 or unlockRecords > 2048
			lastDiagnostic="RPG state is incomplete or exceeds runtime budgets"
			return false
		lastDiagnostic=""
		return true
	function reconcile(string controllerId)
		technologies.reconstruct(controllerId)
		if projections == null
			return
		projections.clearEquipmentLayer()
		for i=0 to inventory.equippedCount-1
			let equippedItem=inventory.getItem(inventory.equippedItems[i])
			projections.applyEquipment(inventory.equippedHeroes[i],equippedItem.id,equippedItem.power)
		for i=0 to inventory.setCount-1
			let setDefinition=inventory.sets[i]
			let pieces=inventory.setPieceCount(setDefinition.id)
			if pieces >= setDefinition.partialPieces
				projections.applyEquipmentSet(setDefinition.id,setDefinition.partialPower)
			if pieces >= setDefinition.fullPieces
				projections.applyEquipmentSet(setDefinition.id,setDefinition.fullPower)
		projections.clearGuidanceLayer()
		if journal.trackedId != ""
			let q=journal.get(journal.trackedId)
			projections.applyQuestGuidance(q.id,q.precision,q.regionId,q.destinationId)
		projections.clearTreasureKnowledgeLayer()
		for i=0 to treasures.count-1
			let t=treasures.treasures[i]
			projections.applyTreasureKnowledge(t.id,t.clueStage,t.discovered)
	function reconstruct(player owner, real x, real y, string controllerId)
		heroes.loseRuntimeObjects()
		heroes.reconstructField(owner,x,y)
		reconcile(controllerId)

/** Player-facing fallback presentation. Frame screens can implement the same
 * controller calls; these commands ensure every system is usable in-game. */
public function showRoster(player viewer, WarcraftRpgRuntime runtime)
	var rows="Heroes (strategic " + runtime.heroes.strategicRosterSize() + ", active " + runtime.heroes.activeCount() + "/" + runtime.heroes.activeLimit + ")"
	for i=0 to runtime.heroes.count-1
		let hero=runtime.heroes.heroes[i]
		if hero.recruited
			rows += "\n"+hero.name+" - level "+hero.level+", "+hero.assignment+", loyalty "+hero.loyalty
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,rows)

public function showInventory(player viewer, WarcraftRpgRuntime runtime)
	var rows="Inventory and Equipment"
	for i=0 to runtime.inventory.ownedCount-1
		rows += "\n"+runtime.inventory.comparison(runtime.inventory.owned[i])
	rows += "\nActive set bonus: +"+runtime.inventory.setBonusPower()+" power"
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,rows)

public function showJournal(player viewer, WarcraftRpgRuntime runtime)
	var rows="Quest Journal"
	for i=0 to runtime.journal.count-1
		let questDefinition=runtime.journal.quests[i]
		if questDefinition.state != QUEST_OFFERED
			rows += "\n"+questDefinition.title+" - "+questDefinition.state+" ["+questDefinition.precision+"]"
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,rows)

public function showTechnology(player viewer, WarcraftRpgRuntime runtime, string controllerId, int year)
	var rows="Technology and Institutions"
	for i=0 to runtime.technologies.count-1
		let technology=runtime.technologies.definitions[i]
		rows += "\n"+technology.name+" - cost "+runtime.technologies.cost(technology.id,year,0,0)
		if runtime.technologies.isUnlocked(controllerId,technology.id)
			rows += " (unlocked)"
	DisplayTimedTextToPlayer(viewer,0.,0.,30.,rows)

class RpgScreenCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	string screen
	construct(WarcraftRpgRuntime runtime,string screen)
		this.runtime=runtime
		this.screen=screen
	override function execute(player sender,string arguments)
		if screen == "roster"
			showRoster(sender,runtime)
		else if screen == "inventory"
			showInventory(sender,runtime)
		else if screen == "journal"
			showJournal(sender,runtime)
		else
			showTechnology(sender,runtime,"player",1450)

class RecruitHeroCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	construct(WarcraftRpgRuntime runtime)
		this.runtime=runtime
	override function execute(player sender,string arguments)
		if runtime.heroes.recruit(arguments)
			let hero=runtime.heroes.get(arguments)
			DisplayTimedTextToPlayer(sender,0.,0.,15.,hero.name+" joined your strategic roster. Use assignments to choose who enters the active field group.")
		else
			DisplayTimedTextToPlayer(sender,0.,0.,15.,"That character is unavailable or already recruited.")

class TrackQuestCommand implements CommandHandler
	WarcraftRpgRuntime runtime
	construct(WarcraftRpgRuntime runtime)
		this.runtime=runtime
	override function execute(player sender,string arguments)
		DisplayTimedTextToPlayer(sender,0.,0.,20.,runtime.journal.track(arguments))

public function registerRpgRuntimeCommands(CommandRegistry commands,WarcraftRpgRuntime runtime)
	commands.register("roster","heroes,companions","roster","Open the hero roster.","Shows recruited heroes, active-field capacity, assignments, recovery, progression and loyalty.",0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"roster"))
	commands.register("inventory","equipment,items","inventory","Open inventory and equipment.","Shows item level, rarity, requirements, comparisons and set bonuses.",0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"inventory"))
	commands.register("journal","quests","journal","Open the custom quest journal.","Shows tracked campaign, regional, personal, polity, event and local quests and their guidance.",0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"journal"))
	commands.register("technology","research,institutions","technology","Open technology and institutions.","Shows research costs, ahead-of-time difficulty, institutional support and unlocked effects.",0,0,COMMAND_RELEASE,new RpgScreenCommand(runtime,"technology"))
	commands.register("recruit","hire","recruit CHARACTER","Recruit an available named character.","Adds the character to the unlimited strategic roster; active-field capacity remains separate.",1,1,COMMAND_RELEASE,new RecruitHeroCommand(runtime))
	commands.register("track","showonmap","track QUEST","Track a quest or show its guidance.","Reveals only the exact, approximate, regional or hidden guidance earned by the campaign state.",1,1,COMMAND_RELEASE,new TrackQuestCommand(runtime))
