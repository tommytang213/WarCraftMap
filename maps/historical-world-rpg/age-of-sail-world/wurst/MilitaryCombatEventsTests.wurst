	f.close()
	traditionReceiptFor("REQ-0158.01", "success")

/** Receipts are checked against the Python military_tradition integer oracle.
 * Each vector enters the installed callback, including zero-floor casualties. */
function exactCombatVector(CombatFixture f, string controller, string category, int amount, int numerator, int denominator, string earned, string total)
	var contributor = "player_army"
	var kind = FORCE_ARMY
	if category == "sailing_naval"
		contributor = "player_fleet"
		kind = FORCE_FLEET
	var enemy = "france"
	if controller == "france"
		enemy = "england"
	f.runtime.transferControl(contributor, controller)
	let prior = traditionXp(f, controller, category)
	let weight = f.runtime.contributions[f.runtime.contributionIndex("enemy_kill")]
	weight.numerator = numerator
	weight.denominator = denominator
	weight.weighted(amount).assertEquals(earned)
	let id = "oracle_" + I2S(f.runtime.forceCount)
	let victim = new RuntimeForce(id, enemy, "europe_west", category, kind, 'hfoo', amount, 0, 0., 0.)
	f.runtime.registerForce(victim)
	f.runtime.instantiate(victim)
	let obsolete = f.token(id)
	f.natives.death(obsolete, f.token(contributor))
	victim.strength.assertEquals(0)
	victim.active.assertFalse()
	traditionXp(f, controller, category).assertEquals(total)
	f.natives.death(obsolete, f.token(contributor))
	traditionXp(f, controller, category).assertEquals(total)
	print("EXACT_TRADITION_ORACLE {\"controller\":\"" + controller + "\",\"category\":\"" + category + "\",\"amount\":" + I2S(amount) + ",\"numerator\":" + I2S(numerator) + ",\"denominator\":" + I2S(denominator) + ",\"earned\":\"" + earned + "\",\"before\":\"" + prior + "\",\"after\":\"" + traditionXp(f, controller, category) + "\"}")

@test function largeWeightedCallbacksMatchIntegerOracleAcrossControllersAndCategories()
	let f = traditionCombatFixture()
	for i = 0 to f.runtime.traditionCount - 1
		let track = f.runtime.traditions[i]
		if track.categoryId == "land_formation"
			track.experience = "9007199254740991"
		else
			track.experience = "999999999999999999999999999999999999999999999999999999999999"
	exactCombatVector(f, "player", "land_formation", 1, 1, 1, "1", "9007199254740992")
	exactCombatVector(f, "player", "land_formation", 1, 1, 1, "1", "9007199254740993")
	exactCombatVector(f, "player", "land_formation", 2147483647, 2147483647, 1, "4611686014132420609", "4620693213387161602")
	exactCombatVector(f, "france", "land_formation", 2000000000, 5, 2, "5000000000", "9007204254740991")
	exactCombatVector(f, "player", "sailing_naval", 2147483647, 2147483646, 2147483647, "2147483646", "1000000000000000000000000000000000000000000000000002147483645")
	exactCombatVector(f, "france", "sailing_naval", 2147483647, 2147483647, 2147483646, "2147483648", "1000000000000000000000000000000000000000000000000002147483647")
	exactCombatVector(f, "france", "land_formation", 13, 3, 4, "9", "9007204254741000")
	exactCombatVector(f, "france", "sailing_naval", 1, 1, 2147483647, "0", "1000000000000000000000000000000000000000000000000002147483647")
	exactCombatVector(f, "player", "sailing_naval", 2147483647, 2147483647, 2147483647, "2147483647", "1000000000000000000000000000000000000000000000000004294967292")
	traditionXp(f, "england", "land_formation").assertEquals("9007199254740991")
	let saved = f.runtime.snapshot()
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "large-exact").assertTrue()
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.runtime.snapshot().assertEquals(saved)
	f.close()

@test function malformedExactExperienceIsRejectedByCampaignLoadBeforeMutation()
	let f = traditionCombatFixture()
	(installMilitaryCombatEvents(f.startup.campaign, f.natives, f.pause) == f.events).assertTrue()
	f.runtime.awardTradition("player", "land_formation", "9007199254740993")
	// Establish a real consumed loss in the authority being preserved.
	f.natives.death(f.token("enemy"), f.token("player_army"))
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 2, "valid-before-malformed").assertTrue()
	let validSave = f.startup.saves.read("manual_02")
	let before = f.startup.campaign.state.captureAuthoritativeState()
	let retained = f.token("player_army")
	let serial = f.representations.nextToken
	let track = "|t,player,land_formation,9007199254741033,0,1000,0"
	before.contains(track).assertTrue()
	string array[15] bad
	bad[0] = ""
	bad[1] = "-1"
	bad[2] = "+1"
	bad[3] = "00"
	bad[4] = "01"
	bad[5] = "1.0"
	bad[6] = "1e9"
	bad[7] = "0x10"
	bad[8] = "NaN"
	bad[9] = "Infinity"
	bad[10] = " 1"
	bad[11] = "1 "
	bad[12] = "2147483648oops"
	bad[13] = "999999999999999999999999999999999999999999x"
	bad[14] = "1,2"
	for i = 0 to 14
		let candidate = before.replace(track, "|t,player,land_formation," + bad[i] + ",0,1000,0")
		let encoded = campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT, "manual_01", SAVE_SLOT_MANUAL, 1, "bad-number", candidate)
		f.startup.saves.writeTransactional("manual_01", encoded).assertTrue()
		f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
		f.startup.campaign.state.captureAuthoritativeState().assertEquals(before)
		f.token("player_army").assertEquals(retained)
		f.representations.nextToken.assertEquals(serial)
		f.startup.saves.read("manual_01").assertEquals(encoded)
		f.startup.saves.read("manual_02").assertEquals(validSave)
	f.close()
	traditionReceiptFor("REQ-0158.01", "failure")

@test function nativeTraditionProjectionLimitsCannotEraseExperienceOrRejectLoss()
	let objects = new TraditionNativeRepresentations()
	let runtime = new MilitarySettlementRuntime(objects)
	// A generic adapter fixture exercises the legacy native stat projection.
	// Generated scenario rates remain zero; no pending coefficient is enabled.
	runtime.registerTradition(new TraditionState("player", "land", 2147483647, 100, 'Adef'))
	runtime.registerTradition(new TraditionState("enemy", "land", 0, 100, 0))
	runtime.registerContribution("enemy_kill", 1, 1)
	runtime.awardTradition("player", "land", "99999999999999999999999999999999999999")
	runtime.registerForce(new RuntimeForce("killer", "player", "map", "land", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
	runtime.registerForce(new RuntimeForce("victim", "enemy", "map", "land", FORCE_ARMY, 'hfoo', 1, 20, 0., 0.))
	runtime.activateRegion("map")
	runtime.commitCombatLoss(1, 0, 0.).assertTrue()
	runtime.traditions[0].experience.assertEquals("100000000000000000000000000000000000000")
	runtime.traditionAbility(runtime.forces[0]).assertEquals('Adef')
	(objects.lastLife > 0).assertTrue()
	let saved = runtime.snapshot()
	runtime.restore(saved).assertTrue()
	runtime.snapshot().assertEquals(saved)
	runtime.commitCombatLoss(1, 0, 0.).assertFalse()

@test function everyLegacyMilitaryIntegerVersionMigratesThroughFreshCampaignCodec()
	let source = traditionCombatFixture()
	let document = source.startup.campaign.state.captureAuthoritativeState()
	let originalMilitary = source.runtime.snapshot()
	source.close()
	let f = traditionCombatFixture()
	for schema = 1 to 7
		var military = "v" + I2S(schema)
		if schema >= 3
			military += "|k,0"
		military += "|a,europe_west"
		var playerOrder = ""
		var enemyOrder = ""
		if schema >= 6
			playerOrder = ",,player"
			enemyOrder = ",,france"
		military += "|f,survivor,player,europe_west,land_formation,1," + I2S('hfoo') + ",40,40,20,0.0,0.0,1,move,12.0,34.0" + playerOrder
		military += "|f,consumed,france,europe_west,land_formation,1," + I2S('hfoo') + ",0,40,20,0.0,0.0,0,hold,0.0,0.0" + enemyOrder
		military += "|f,fresh,france,europe_west,land_formation,1," + I2S('hfoo') + ",1,1,20,0.0,0.0,1,hold,0.0,0.0" + enemyOrder
		if schema == 1
			military += "|w,england,france"
		else
			military += "|c,legacy_war,0|m,legacy_war,england,1|m,legacy_war,france,2"
		military += "|t,player,land_formation,2147483647,0,1000,0"
		military += "|t,england,land_formation,73,0,1000,0|t,france,land_formation,9,0,1000,0"
		military += "|t,england,sailing_naval,0,0,1200,0|t,france,sailing_naval,0,0,1200,0"
		if schema == 7
			military += "|t,player,sailing_naval,0,0,1200,0"
		let candidate = document.replace(originalMilitary, military)
		let encoded = campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT, "manual_01", SAVE_SLOT_MANUAL, 1, "legacy", candidate)
		f.startup.saves.writeTransactional("manual_01", encoded).assertTrue()
		f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		traditionXp(f, "player", "land_formation").assertEquals("2147483647")
		traditionXp(f, "england", "land_formation").assertEquals("73")
		traditionXp(f, "france", "land_formation").assertEquals("9")
		traditionXp(f, "player", "sailing_naval").assertEquals("0")
		let survivor = f.runtime.forces[f.runtime.forceIndex("survivor")]
		survivor.controllerId.assertEquals("player")
		survivor.orderId.assertEquals("move")
		survivor.orderControllerId.assertEquals("player")
		survivor.orderX.assertEquals(12.)
		survivor.orderY.assertEquals(34.)
		f.runtime.forces[f.runtime.forceIndex("consumed")].active.assertFalse()
		f.token("consumed").assertEquals(0)
		let victim = f.token("fresh")
		f.natives.death(victim, f.token("survivor"))
		traditionXp(f, "player", "land_formation").assertEquals("2147483648")
		let saved = f.runtime.snapshot()
		saved.startsWith("v8|").assertTrue()
		f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 2, "migrated").assertTrue()
		f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertTrue()
		f.natives.death(victim, f.token("survivor"))
		f.runtime.snapshot().assertEquals(saved)
		f.startup.saves.read("manual_01").assertEquals(encoded)
		// A legacy integer record never legitimately contained this number.
		let bad = candidate.replace(",2147483647,0,1000,0", ",2147483648,0,1000,0")
		let invalid = campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT, "manual_01", SAVE_SLOT_MANUAL, 1, "invalid-legacy", bad)
		f.startup.saves.writeTransactional("manual_01", invalid).assertTrue()
		f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
		f.runtime.snapshot().assertEquals(saved)
		f.startup.saves.read("manual_01").assertEquals(invalid)
	f.close()
