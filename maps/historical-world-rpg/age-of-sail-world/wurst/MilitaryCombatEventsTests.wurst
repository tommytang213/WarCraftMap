/** Native representations are opaque, non-reusable tokens. The production
 * adapter exposes current GetHandleId values at the same boundary. */
class CombatRepresentations extends RecordingMilitaryAdapter
	string array[128] ids
	int array[128] tokens
	int array[128] retained
	boolean array[128] protection
	int count = 0
	int nextToken = 100
	MilitaryCombatEvents cleanupEvents = null
	int cleanupKiller = 0
	string observeRetirement = ""
	string retiredAuthority = ""
	function index(string id) returns int
		for i = 0 to count - 1
			if ids[i] == id
				return i
		return -1
	override function createRepresentation(RuntimeForce runtimeForce, player owner) returns unit
		removeRepresentation(runtimeForce.id)
		var found = index(runtimeForce.id)
		if found < 0
			found = count
			ids[count] = runtimeForce.id
			count++
		nextToken++
		tokens[found] = nextToken
		protection[found] = false
		return null
	override function forceIdForRepresentation(int representation) returns string
		if representation != 0
			for i = 0 to count - 1
				if tokens[i] == representation
					return ids[i]
		return ""
	override function representationId(string id) returns int
		let found = index(id)
		if found < 0
			return 0
		return tokens[found]
	override function removeRepresentation(string id)
		let found = index(id)
		if found >= 0
			if id == observeRetirement and cleanupEvents != null
				retiredAuthority = cleanupEvents.runtime.snapshot()
			let obsolete = tokens[found]
			tokens[found] = 0
			if cleanupEvents != null and obsolete != 0
				cleanupEvents.onDeath(cleanupEvents.generation, obsolete, cleanupKiller)
	override function protectRepresentation(string id, boolean value)
		let found = index(id)
		if found >= 0
			protection[found] = value
	function isProtected(string id) returns boolean
		return protection[index(id)]
	override function beginLoad()
		for i = 0 to count - 1
			retained[i] = tokens[i]
			tokens[i] = 0
	override function rollbackLoad()
		for i = 0 to count - 1
			removeRepresentation(ids[i])
			tokens[i] = retained[i]
			retained[i] = 0
	override function commitLoad()
		for i = 0 to count - 1
			if cleanupEvents != null and retained[i] != 0
				cleanupEvents.onDeath(cleanupEvents.generation, retained[i], cleanupKiller)
			retained[i] = 0

class RecordingCombatNatives implements MilitaryCombatNatives
	MilitaryCombatEvents events
	int epoch = 0
	int serial = 0
	int installs = 0
	int uninstalls = 0
	int wakes = 0
	boolean listening = false
	boolean armed = false
	real elapsed = 0.
	real delay = 0.
	int heroToken = 9000
	int heroIndex = -1
	override function install(MilitaryCombatEvents events, int generation)
		this.events = events
		epoch = generation
		installs++
		listening = true
	override function uninstall()
		listening = false
		uninstalls++
	override function armTimer(real seconds, int serial)
		(seconds >= 0. and seconds <= 1.).assertTrue()
		this.serial = serial
		delay = seconds
		elapsed = 0.
		armed = true
	override function stopTimer()
		armed = false
	override function timerElapsed() returns real
		return elapsed
	override function heroRepresentationId(int index) returns int
		if index == heroIndex
			return heroToken
		return 0
	function damage(int target, int source) returns int
		listening.assertTrue()
		return events.onDamage(epoch, target, source, 25.)
	function death(int target, int killer)
		listening.assertTrue()
		events.onDeath(epoch, target, killer)
	function advance(real seconds)
		var remaining = seconds
		var callbacks = 0
		while armed and elapsed + remaining >= delay
			remaining -= delay - elapsed
			elapsed = delay
			wakes++
			callbacks++
			(callbacks < 1000).assertTrue()
			events.onTimer(serial)
		if armed
			elapsed += remaining

class RecordingCombatPause implements CampaignPauseRuntime
	boolean paused = false
	override function setCampaignPaused(boolean value)
		paused = value

class CombatFixture
	ManagementScreenPauseController pause = new ManagementScreenPauseController(new RecordingCombatPause(), false)
	StartupFixture startup = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	CombatRepresentations representations = new CombatRepresentations()
	RecordingCombatNatives natives = new RecordingCombatNatives()
	MilitarySettlementRuntime runtime
	MilitaryCombatEvents events
	string city
	construct()
		// Execute generated registration, selector handoff and successful regional
		// startup before installing the exact production combat registration.
		(installMilitaryCombatEvents(startup.campaign, natives, pause) == null).assertTrue()
		startup.start("england")
		let heroes = startup.campaign.state.rpg.heroes
		for i = 0 to heroes.count - 1
			if heroes.heroes[i].recruited and heroes.heroes[i].assignment == "field"
				natives.heroIndex = i
		runtime = startup.campaign.state.militarySettlements
		installCampaignClock(startup.clock)
		runtime.adapter = representations
		city = startup.selector.find("england").settlementId
		// Retain only the selected settlement's authority in this bounded journey.
		let selected = runtime.settlements[runtime.settlementIndex(city)]
		runtime.settlements[0] = selected
		runtime.settlementCount = 1
		let core = runtime.forces[runtime.forceIndex("core:" + city)]
		runtime.forces[0] = core
		runtime.forceCount = 1
		runtime.administratorCount = 0
		runtime.registerForce(new RuntimeForce("defense:" + city + ":gate", "england", "europe_west", "siege", FORCE_DEFENSE, 'hgtw', 100, 0, 64., 0.))
		runtime.registerForce(new RuntimeForce("enemy", "france", "europe_west", "infantry", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
		runtime.registerForce(new RuntimeForce("ally", "portugal", "europe_west", "infantry", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
		runtime.registerForce(new RuntimeForce("player_army", "player", "europe_west", "infantry", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
		runtime.registerConflictMember("combat_war", "england", 1).assertTrue()
		runtime.registerConflictMember("combat_war", "portugal", 1).assertTrue()
		runtime.registerConflictMember("combat_war", "france", 2).assertTrue()
		selected.garrisonStrength = 30
		selected.garrisonMaximum = 30
		selected.reserves = 20
		selected.manpower = 50
		selected.supply = 50
		runtime.activateRegion("europe_west")
		events = installMilitaryCombatEvents(startup.campaign, natives, pause)
		(events != null).assertTrue()
		representations.cleanupEvents = events
		representations.cleanupKiller = representations.representationId("enemy")
	function token(string id) returns int
		return representations.representationId(id)
	function core() returns int
		return token("core:" + city)
	function captureViaNatives()
		natives.damage(core(), token("enemy")).assertEquals(1)
		natives.death(core(), token("enemy"))
		runtime.settlements[0].controllerId.assertEquals("france")
	function close()
		events.stop()

@test function productionCombatRegistrationCapturesOnceAndKeepsPeaceAuthority()
	let f = new CombatFixture()
	let registered = new MilitaryCommandFixture(f.runtime, f.representations)
	(installMilitaryCombatEvents(f.startup.campaign, new RecordingCombatNatives()) == f.events).assertTrue()
	f.natives.installs.assertEquals(1)
	let obsolete = f.core()
	f.captureViaNatives()
	let after = f.runtime.snapshot()
	f.natives.death(obsolete, f.token("enemy"))
	f.runtime.snapshot().assertEquals(after)
	f.runtime.settlements[0].legalOwnerId.assertEquals("england")
	f.runtime.settlements[0].occupationConflictId.assertEquals("combat_war")
	f.runtime.forces[f.runtime.forceIndex("defense:" + f.city + ":gate")].controllerId.assertEquals("france")
	f.representations.isProtected("core:" + f.city).assertTrue()
	f.representations.isProtected("defense:" + f.city + ":gate").assertTrue()
	registered.show("/settlement " + f.city)
	f.representations.management.contains("Controller: france").assertTrue()
	f.representations.management.contains("Acting Administrator: Local Deputy").assertTrue()
	let peace = new CampaignCountryPeaceAuthority(f.runtime)
	peace.commitPeace("combat_war", "ceasefire").assertTrue()
	f.runtime.settlements[0].controllerId.assertEquals("england")
	registered.show("/settlement " + f.city)
	f.representations.management.contains("Controller: england").assertTrue()
	f.natives.damage(f.core(), f.token("enemy")).assertEquals(-1)
	f.natives.advance(6.)
	f.runtime.settlements[0].underAttack.assertFalse()
	registered.close()
	f.close()

@test function peacefulAlliedUnknownAndObsoleteCombatCannotChangeAuthority()
	let f = new CombatFixture()
	let reserves = f.runtime.settlements[0].reserves
	f.natives.damage(f.core(), f.token("ally")).assertEquals(-1)
	f.natives.damage(f.core(), 777).assertEquals(-1)
	f.natives.death(f.core(), f.token("ally"))
	f.runtime.settlements[0].controllerId.assertEquals("england")
	f.runtime.settlements[0].reserves.assertEquals(reserves)
	let oldCore = f.core()
	let oldEnemy = f.token("enemy")
	let oldEpoch = f.natives.epoch
	let oldTimer = f.natives.serial
	f.runtime.activateRegion("europe_west")
	let state = f.runtime.snapshot()
	f.events.onDeath(oldEpoch, f.core(), f.token("enemy"))
	f.events.onTimer(oldTimer)
	f.natives.death(oldCore, f.token("enemy"))
	f.natives.damage(f.core(), oldEnemy).assertEquals(-1)
	f.runtime.snapshot().assertEquals(state)
	f.runtime.settleConflict("combat_war").assertTrue()
	f.natives.damage(f.core(), f.token("enemy")).assertEquals(-1)
	f.natives.death(f.core(), f.token("enemy"))
	f.runtime.settlements[0].controllerId.assertEquals("england")
	f.close()

@test function attackerAllegianceUsesCampaignIdentityForForcesAndHeroes()
	let f = new CombatFixture()
	f.natives.damage(f.core(), f.token("player_army")).assertEquals(-1)
	f.startup.campaign.identity.changeAllegiance("france")
	f.natives.damage(f.core(), f.token("player_army")).assertEquals(1)
	f.natives.damage(f.core(), f.natives.heroToken).assertEquals(1)
	f.natives.death(f.core(), f.natives.heroToken)
	f.runtime.settlements[0].controllerId.assertEquals("france")
	f.close()

@test function exactFractionalCaptureDeadlineSurvivesNestedPausesAndLiveSaveLoad()
	let f = new CombatFixture()
	// Capture between timer ticks, not on the housekeeping timer's phase.
	f.natives.advance(0.125)
	f.captureViaNatives()
	f.runtime.settlements[0].captureImmuneUntil.assertEquals(5.125)
	f.natives.advance(1.375)
	let modal = f.pause.openModalManagementScreen()
	let nested = f.pause.openModalManagementScreen()
	f.natives.advance(100.)
	f.runtime.gameplaySeconds.assertEquals(1.5)
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "combat-deadline").assertTrue()
	let oldCore = f.core()
	let epoch = f.natives.epoch
	let oldWake = f.natives.serial
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.events.onDeath(epoch, oldCore, f.token("enemy"))
	f.events.onTimer(oldWake)
	f.runtime.gameplaySeconds.assertEquals(1.5)
	f.runtime.settlements[0].captureImmuneUntil.assertEquals(5.125)
	f.representations.isProtected("core:" + f.city).assertTrue()
	modal.close()
	f.natives.advance(20.)
	f.runtime.gameplaySeconds.assertEquals(1.5)
	nested.close()
	f.natives.advance(3.624)
	f.representations.isProtected("core:" + f.city).assertTrue()
	f.natives.advance(0.001)
	f.runtime.gameplaySeconds.assertEquals(5.125)
	f.representations.isProtected("core:" + f.city).assertFalse()
	f.representations.isProtected("defense:" + f.city + ":gate").assertFalse()
	f.runtime.settlements[0].captureImmuneUntil.assertEquals(0.)
	f.close()

@test function combatWavesRemainBoundedAndCasualtiesAndQuietDeadlinesSurviveResume()
	let f = new CombatFixture()
	f.natives.damage(f.core(), f.token("enemy")).assertEquals(1)
	f.natives.advance(0.)
	f.runtime.settlements[0].reserves.assertEquals(10)
	let wave = "garrison:" + f.city + ":0"
	let victim = f.token(wave)
	f.natives.death(victim, f.token("enemy"))
	f.natives.death(victim, f.token("enemy"))
	f.runtime.settlements[0].garrisonStrength.assertEquals(20)
	for i = 0 to 8
		f.natives.advance(1.)
		f.natives.damage(f.core(), f.token("enemy")).assertEquals(1)
	f.runtime.settlements[0].reserves.assertEquals(10)
	f.runtime.settlements[0].nextWaveAt.assertEquals(10.)
	let saved = f.runtime.snapshot()
	f.runtime.restore(saved).assertTrue()
	f.natives.advance(0.999)
	f.runtime.settlements[0].reserves.assertEquals(10)
	f.natives.advance(0.001)
	f.runtime.settlements[0].reserves.assertEquals(0)
	f.runtime.settlements[0].supply.assertEquals(30)
	f.natives.advance(18.999)
	f.runtime.settlements[0].underAttack.assertTrue()
	f.natives.advance(0.001)
	f.runtime.settlements[0].underAttack.assertFalse()
	f.runtime.settlements[0].garrisonStrength.assertEquals(20)
	f.runtime.settlements[0].manpower.assertEquals(30)
	f.token("garrison:" + f.city + ":10").assertEquals(0)
	f.close()

@test function militaryClockVersionMigrationAndMalformedSnapshotsAreAtomic()
	let f = new CombatFixture()
	f.natives.advance(0.125)
	f.captureViaNatives()
	f.natives.advance(0.0625)
	let saved = f.runtime.snapshot()
	saved.startsWith("v8|k,").assertTrue()
	f.runtime.restore(saved).assertTrue()
	f.runtime.snapshot().assertEquals(saved)
	f.runtime.restore(saved + "|k,0").assertFalse()
	f.runtime.restore("v6" + SubString(saved, saved.indexOf("|a,"), StringLength(saved))).assertFalse()
	f.runtime.snapshot().assertEquals(saved)
	// Legacy formats had no production timer. Migration anchors the old
	// deadlines to their last recorded event and retains v2 conflict authority.
	let legacy = "v2|a,europe_west|f,core:legacy,england,europe_west,siege,4," + I2S('htow') + ",100,100,50,0.000,0.000,1,hold,0.000,0.000|s,legacy,england,europe_west," + I2S('htow') + "," + I2S('hfoo') + ",30,30,20,50,50,10,10.000,20.000,40.000,32.000,35.000,0.000,0.000,1,england,,france|c,war,0|m,war,england,1|m,war,france,2"
	f.runtime.restore(legacy).assertTrue()
	f.runtime.gameplaySeconds.assertEquals(32.)
	f.runtime.settlements[0].captureImmuneUntil.assertEquals(35.)
	f.natives.advance(2.999)
	f.representations.isProtected("core:legacy").assertTrue()
	f.natives.advance(0.001)
	f.representations.isProtected("core:legacy").assertFalse()
	f.close()

@test function failedCombatLoadRestoresRemainingTimeAndRetiresObsoleteCallbacks()
	let f = new CombatFixture()
	f.captureViaNatives()
	f.natives.advance(1.25)
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "before-failure").assertTrue()
	f.natives.advance(1.5)
	let current = f.runtime.snapshot()
	let oldCore = f.core()
	let oldEpoch = f.natives.epoch
	let oldTimer = f.natives.serial
	f.startup.ports.failProjection = true
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.startup.ports.failProjection = false
	f.runtime.snapshot().assertEquals(current)
	f.core().assertEquals(oldCore)
	f.events.onDeath(oldEpoch, oldCore, f.token("enemy"))
	f.events.onTimer(oldTimer)
	f.runtime.snapshot().assertEquals(current)
	f.natives.advance(2.249)
	f.representations.isProtected("core:" + f.city).assertTrue()
	f.natives.advance(0.001)
	f.representations.isProtected("core:" + f.city).assertFalse()
	f.close()

@test function freshPhysicalRuntimeKeepsFractionalProtectionAndManualPause()
	let first = new CombatFixture()
	first.natives.advance(0.125)
	first.captureViaNatives()
	first.natives.advance(2.0625)
	let saved = first.runtime.snapshot()
	first.close()
	let restored = new CombatFixture()
	restored.runtime.restore(saved).assertTrue()
	restored.runtime.gameplaySeconds.assertEquals(2.1875)
	restored.pause.setManuallyPaused(true)
	let modal = restored.pause.openModalManagementScreen()
	modal.close()
	restored.natives.advance(50.)
	restored.runtime.gameplaySeconds.assertEquals(2.1875)
	restored.pause.setManuallyPaused(false)
	restored.natives.advance(2.937)
	restored.representations.isProtected("core:" + restored.city).assertTrue()
	restored.natives.advance(0.0005)
	restored.runtime.gameplaySeconds.assertEquals(5.125)
	restored.representations.isProtected("core:" + restored.city).assertFalse()
	restored.close()

@test function delayedTimerDoesNotCatchUpWavesOrSpendAtTheQuietDeadline()
	// This deadline test needs one initialized siege. The journeys above cover
	// generated registration and startup; repeating the world catalogue here can
	// exhaust the interpreter's per-test budget before any timer is exercised.
	let representations = new CombatRepresentations()
	let runtime = new MilitarySettlementRuntime(representations)
	runtime.registerSettlement(new SettlementRuntimeState("city", "england", "europe_west", 'htow', 'hfoo', 30, 20, 50, 50, 0., 0.))
	runtime.registerForce(new RuntimeForce("enemy", "france", "europe_west", "infantry", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
	runtime.registerConflictMember("combat_war", "england", 1).assertTrue()
	runtime.registerConflictMember("combat_war", "france", 2).assertTrue()
	runtime.activateRegion("europe_west")
	let natives = new RecordingCombatNatives()
	let pause = new ManagementScreenPauseController(new RecordingCombatPause(), false)
	let events = new MilitaryCombatEvents(runtime, new PlayerCampaignIdentity(), pause, natives)
	events.install()
	representations.cleanupEvents = events
	representations.cleanupKiller = representations.representationId("enemy")
	natives.damage(representations.representationId("core:city"), representations.representationId("enemy")).assertEquals(1)
	// A delayed callback must do bounded work, not replay elapsed wave slots.
	natives.elapsed = 19.
	events.onTimer(natives.serial)
	runtime.gameplaySeconds.assertEquals(19.)
	runtime.settlements[0].reserves.assertEquals(10)
	natives.advance(1.)
	runtime.gameplaySeconds.assertEquals(20.)
	runtime.settlements[0].underAttack.assertFalse()
	runtime.settlements[0].reserves.assertEquals(10)
	events.stop()

function traditionCombatFixture() returns CombatFixture
	let f = new CombatFixture()
	// Production startup has registered the authored sources and all six tracks.
	f.runtime.traditionCount.assertEquals(6)
	f.runtime.contributionCount.assertEquals(3)
	f.runtime.forces[f.runtime.forceIndex("player_army")].categoryId = "land_formation"
	f.runtime.forces[f.runtime.forceIndex("enemy")].categoryId = "land_formation"
	f.runtime.registerForce(new RuntimeForce("player_fleet", "player", "europe_west", "sailing_naval", FORCE_FLEET, 'hdes', 40, 20, 0., 0.))
	f.runtime.registerForce(new RuntimeForce("enemy_fleet", "france", "europe_west", "sailing_naval", FORCE_FLEET, 'hdes', 13, 20, 0., 0.))
	f.runtime.registerForce(new RuntimeForce("english_army", "england", "europe_west", "land_formation", FORCE_ARMY, 'hfoo', 17, 20, 0., 0.))
	f.runtime.registerForce(new RuntimeForce("abstract_army", "player", "europe_central_east", "land_formation", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
	f.runtime.activateRegion("europe_west")
	return f

function traditionXp(CombatFixture f, string controller, string category) returns string
	return f.runtime.traditions[f.runtime.traditionIndex(controller, category)].experience

@test function combatOnMappedTerrainPreservesCaptureAndEarnedTradition()
	let f = traditionCombatFixture()
	// Authored locations can name a subregion while command activation names
	// its physical chapter. Both combat participants and holdings use that map.
	f.runtime.settlements[0].regionId = "europe_atlantic_isles"
	for i = 0 to f.runtime.forceCount - 1
		if f.runtime.forces[i].regionId == "europe_west"
			f.runtime.forces[i].regionId = "europe_atlantic_isles"
	f.runtime.activateRegion("europe_west")
	(f.core() != 0).assertTrue()
	f.token("abstract_army").assertEquals(0)
	f.captureViaNatives()
	let victim = f.token("enemy")
	f.representations.tradition = -1
	f.natives.damage(victim, f.token("player_army")).assertEquals(1)
	f.natives.death(victim, f.token("player_army"))
	traditionXp(f, "player", "land_formation").assertEquals("40")
	// Reconcile the surviving local projection without reviving the casualty
	// or projecting forces from the other physical map in the same region.
	f.representations.tradition.assertEquals(0)
	f.token("enemy").assertEquals(0)
	f.token("abstract_army").assertEquals(0)
	let committed = f.runtime.snapshot()
	f.natives.death(victim, f.token("player_army"))
	f.runtime.snapshot().assertEquals(committed)
	f.close()

function traditionReceiptFor(string requirement, string caseName)
	print("TRACEABILITY {\"requirement\":\"" + requirement + "\",\"case\":\"" + caseName + "\",\"entryPoint\":\"combat-earned-tradition\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"outcome\",\"persistence\",\"transition\"]}")

function traditionReceipt(string caseName)
	traditionReceiptFor("REQ-0154.01", caseName)
	traditionReceiptFor("REQ-0164.01", caseName)
	traditionReceiptFor("ROAD-0052.01", caseName)

@test function installedCombatEarnsIndependentPlayerAndAiLandAndNavalTradition()
	let f = traditionCombatFixture()
	(installMilitaryCombatEvents(f.startup.campaign, f.natives, f.pause) == f.events).assertTrue()
	f.representations.observeRetirement = "enemy"
	f.natives.damage(f.token("enemy"), f.token("player_army")).assertEquals(1)
	f.natives.death(f.token("enemy"), f.token("player_army"))
	traditionXp(f, "player", "land_formation").assertEquals("40")
	f.runtime.forces[f.runtime.forceIndex("enemy")].strength.assertEquals(0)
	f.runtime.forces[f.runtime.forceIndex("enemy")].active.assertFalse()
	// A synchronous native cleanup callback sees loss AND earned XP committed.
	f.representations.retiredAuthority.assertEquals(f.runtime.snapshot())
	f.natives.death(f.token("enemy_fleet"), f.token("player_fleet"))
	traditionXp(f, "player", "sailing_naval").assertEquals("13")
	traditionXp(f, "england", "land_formation").assertEquals("0")
	traditionXp(f, "france", "land_formation").assertEquals("0")
	// Transfer changes future attribution, never the previous controller's XP.
	f.runtime.transferControl("player_army", "france")
	f.natives.death(f.token("english_army"), f.token("player_army"))
	traditionXp(f, "france", "land_formation").assertEquals("17")
	traditionXp(f, "player", "land_formation").assertEquals("40")
	traditionXp(f, "france", "sailing_naval").assertEquals("0")
	f.runtime.transferControl("player_fleet", "france")
	f.runtime.registerForce(new RuntimeForce("english_fleet", "england", "europe_west", "sailing_naval", FORCE_FLEET, 'hdes', 19, 20, 0., 0.))
	f.runtime.instantiate(f.runtime.forces[f.runtime.forceIndex("english_fleet")])
	f.natives.death(f.token("english_fleet"), f.token("player_fleet"))
	traditionXp(f, "france", "sailing_naval").assertEquals("19")
	traditionXp(f, "player", "sailing_naval").assertEquals("13")
	f.startup.campaign.identity.changeAllegiance("portugal")
	traditionXp(f, "player", "land_formation").assertEquals("40")
	f.runtime.activateRegion("europe_central_east")
	(f.token("abstract_army") != 0).assertTrue()
	traditionXp(f, "player", "land_formation").assertEquals("40")
	f.runtime.activateRegion("europe_west")
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "earned-tradition").assertTrue()
	let saved = f.runtime.snapshot()
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.runtime.snapshot().assertEquals(saved)
	f.close()
	traditionReceipt("success")

@test function weightedNativeKillsUseCommittedStrengthAndFloorEachContribution()
	let f = traditionCombatFixture()
	let weight = f.runtime.contributions[f.runtime.contributionIndex("enemy_kill")]
	weight.numerator = 3
	weight.denominator = 4
	// Prior casualties cannot be awarded a second time by the final death.
	f.runtime.recordLoss("enemy", 27)
	f.natives.death(f.token("enemy"), f.token("player_army"))
	traditionXp(f, "player", "land_formation").assertEquals("9")
	f.natives.death(f.token("enemy_fleet"), f.token("player_fleet"))
	traditionXp(f, "player", "sailing_naval").assertEquals("9")
	print("TRADITION_ORACLE {\"amount\":13,\"numerator\":3,\"denominator\":4,\"earned\":" + traditionXp(f, "player", "land_formation") + "}")
	f.runtime.registerForce(new RuntimeForce("tiny", "france", "europe_west", "land_formation", FORCE_ARMY, 'hfoo', 1, 20, 0., 0.))
	f.runtime.instantiate(f.runtime.forces[f.runtime.forceIndex("tiny")])
	f.natives.death(f.token("tiny"), f.token("player_army"))
	traditionXp(f, "player", "land_formation").assertEquals("9")
	f.runtime.forces[f.runtime.forceIndex("tiny")].active.assertFalse()
	// Authored assist/objective weights remain available but have no dispatcher.
	f.runtime.contributions[f.runtime.contributionIndex("combat_assist")].denominator.assertEquals(2)
	f.runtime.contributions[f.runtime.contributionIndex("battle_objective")].numerator.assertEquals(3)
	weight.weighted(2000000000).assertEquals("1500000000")
	weight.numerator = 5
	weight.denominator = 2
	weight.weighted(13).assertEquals("32")
	weight.weighted(2000000000).assertEquals("5000000000")
	f.close()

@test function rejectedCombatAndMissingContributionContextCannotEarnTradition()
	let f = traditionCombatFixture()
	f.runtime.awardTradition("player", "land_formation", "9007199254740993")
	(installMilitaryCombatEvents(f.startup.campaign, f.natives, f.pause) == f.events).assertTrue()
	let before = f.runtime.snapshot()
	f.natives.damage(f.token("enemy"), 0).assertEquals(-1)
	f.natives.death(f.token("enemy"), 0)
	f.runtime.snapshot().assertEquals(before)
	f.natives.death(f.token("enemy"), 999999)
	f.runtime.snapshot().assertEquals(before)
	f.natives.death(f.token("player_army"), f.token("english_army"))
	f.runtime.snapshot().assertEquals(before)
	f.pause.setManuallyPaused(true)
	f.natives.death(f.token("enemy"), f.token("player_army"))
	f.pause.setManuallyPaused(false)
	f.runtime.snapshot().assertEquals(before)
	// A legal hero kill commits casualties but has no authored military category.
	f.natives.death(f.token("enemy"), f.natives.heroToken)
	traditionXp(f, "player", "land_formation").assertEquals("9007199254740993")
	f.runtime.forces[f.runtime.forceIndex("enemy")].active.assertFalse()
	// An ineligible enemy controller also has no headless contribution contract.
	f.runtime.setWar("england", "portugal", true)
	f.natives.death(f.token("ally"), f.token("player_army"))
	traditionXp(f, "player", "land_formation").assertEquals("9007199254740993")
	// Capturing a core has no committed troop loss and no objective adapter.
	f.runtime.transferControl("player_army", "france")
	f.natives.death(f.core(), f.token("player_army"))
	traditionXp(f, "france", "land_formation").assertEquals("0")
	let protectedState = f.runtime.snapshot()
	f.natives.death(f.core(), f.token("english_army"))
	f.runtime.snapshot().assertEquals(protectedState)
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "rejected-tradition").assertTrue()
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	traditionXp(f, "player", "land_formation").assertEquals("9007199254740993")
	f.close()
	traditionReceipt("failure")

@test function duplicateStaleAndRetiredDeathsCannotReplayEarnedTradition()
	let f = traditionCombatFixture()
	f.runtime.awardTradition("player", "land_formation", "9007199254740993")
	(installMilitaryCombatEvents(f.startup.campaign, f.natives, f.pause) == f.events).assertTrue()
	let victim = f.token("enemy")
	let killer = f.token("player_army")
	let epoch = f.natives.epoch
	f.natives.death(victim, killer)
	let after = f.runtime.snapshot()
	f.natives.death(victim, killer)
	f.runtime.snapshot().assertEquals(after)
	f.runtime.activateRegion("europe_west")
	f.natives.death(victim, f.token("player_army"))
	f.natives.death(f.token("enemy_fleet"), killer)
	f.events.onDeath(epoch, f.token("enemy_fleet"), f.token("player_fleet"))
	f.runtime.snapshot().assertEquals(after)
	f.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "consumed-death").assertTrue()
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.natives.death(victim, f.token("player_army"))
	f.runtime.snapshot().assertEquals(after)
	// A still-current killer changes controller between damage and death.
	f.natives.damage(f.token("enemy_fleet"), f.token("player_fleet")).assertEquals(1)
	f.runtime.transferControl("player_fleet", "france")
	let transferred = f.runtime.snapshot()
	f.natives.death(f.token("enemy_fleet"), f.token("player_fleet"))
	f.runtime.snapshot().assertEquals(transferred)
	traditionXp(f, "player", "sailing_naval").assertEquals("0")
	f.runtime.transferControl("player_fleet", "england")
	f.natives.death(f.token("enemy_fleet"), f.token("player_fleet"))
	traditionXp(f, "england", "sailing_naval").assertEquals("13")
	traditionXp(f, "player", "sailing_naval").assertEquals("0")
	f.close()
	traditionReceipt("stale")
	traditionReceiptFor("REQ-0158.01", "stale")

@test function earnedTraditionAndConsumedLossesSurviveFreshCampaignAndFailedRestore()
	let first = traditionCombatFixture()
	first.runtime.awardTradition("player", "land_formation", "99999999999999999999999999999999999999")
	first.runtime.awardTradition("player", "sailing_naval", "9007199254740992")
	(installMilitaryCombatEvents(first.startup.campaign, first.natives, first.pause) == first.events).assertTrue()
	first.natives.death(first.token("enemy"), first.token("player_army"))
	first.startup.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "earned").assertTrue()
	let encoded = first.startup.saves.read("manual_01")
	let saved = first.runtime.snapshot()
	first.close()
	let f = traditionCombatFixture()
	let obsoleteVictim = f.token("enemy")
	f.startup.saves.writeTransactional("manual_01", encoded).assertTrue()
	for attempt = 1 to 2
		f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		f.natives.death(obsoleteVictim, f.token("player_army"))
		f.runtime.snapshot().assertEquals(saved)
		f.token("enemy").assertEquals(0)
	f.natives.death(f.token("enemy_fleet"), f.token("player_fleet"))
	let current = f.runtime.snapshot()
	let retainedKiller = f.token("player_fleet")
	let epoch = f.natives.epoch
	f.startup.ports.failProjection = true
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.startup.ports.failProjection = false
	f.startup.saves.read("manual_01").assertEquals(encoded)
	f.startup.ports.failAfterFirstMember = true
	f.startup.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.startup.ports.failAfterFirstMember = false
	f.startup.saves.read("manual_01").assertEquals(encoded)
	f.runtime.snapshot().assertEquals(current)
	f.token("player_fleet").assertEquals(retainedKiller)
	f.events.onDeath(epoch, f.token("player_army"), retainedKiller)
	f.runtime.snapshot().assertEquals(current)
	traditionXp(f, "player", "land_formation").assertEquals("100000000000000000000000000000000000039")
	traditionXp(f, "player", "sailing_naval").assertEquals("9007199254741005")
	f.runtime.activateRegion("europe_central_east")
	f.runtime.restore(current).assertTrue()
	f.runtime.activeRegionId.assertEquals("europe_central_east")
	traditionXp(f, "player", "land_formation").assertEquals("100000000000000000000000000000000000039")
	f.runtime.activateRegion("europe_west")
	f.runtime.snapshot().assertEquals(current)
	f.close()
	traditionReceipt("replay")
	traditionReceiptFor("REQ-0158.01", "replay")

@test function traditionMigrationPreservesEarnedTracksAndRejectsPartialCurrentSaves()
	let f = traditionCombatFixture()
	f.natives.death(f.token("enemy"), f.token("player_army"))
	let saved = f.runtime.snapshot()
	let playerLand = "|t,player,land_formation,40,0,1000,0"
	let playerSea = "|t,player,sailing_naval,0,0,1200,0"
	(saved.contains(playerLand) and saved.contains(playerSea)).assertTrue()
	string array[6] malformed
	malformed[0] = saved.replace(playerLand, "")
	malformed[1] = saved + playerLand
	malformed[2] = saved.replace(playerLand, "|t,player,land_formation,40oops,0,1000,0")
	malformed[3] = saved.replace(playerLand, "|t,player,land_formation,-1,0,1000,0")
	malformed[4] = saved.replace(playerLand, "|t,unknown,land_formation,40,0,1000,0")
	malformed[5] = saved.replace(playerLand, "|t,player,land_formation,040,0,1000,0")
	for i = 0 to 5
		f.runtime.restore(malformed[i]).assertFalse()
		f.runtime.snapshot().assertEquals(saved)
	// v6 retains force orders and XP; absent player tracks begin at authored XP.
	let legacy = ("v6" + SubString(saved, 2, StringLength(saved))).replace(playerLand, "").replace(playerSea, "").replace("|t,england,land_formation,0,", "|t,england,land_formation,73,")
	f.runtime.restore(legacy).assertTrue()
	traditionXp(f, "england", "land_formation").assertEquals("73")
	traditionXp(f, "player", "land_formation").assertEquals("0")
	f.runtime.forces[f.runtime.forceIndex("enemy")].active.assertFalse()
	f.runtime.contributions[f.runtime.contributionIndex("enemy_kill")].numerator.assertEquals(1)
	configureGeneratedMilitaryTraditions(f.runtime, true).assertTrue()
	traditionXp(f, "england", "land_formation").assertEquals("73")
	let migrated = f.runtime.snapshot()
	f.runtime.restore(migrated).assertTrue()
	f.runtime.snapshot().assertEquals(migrated)
	f.close()

