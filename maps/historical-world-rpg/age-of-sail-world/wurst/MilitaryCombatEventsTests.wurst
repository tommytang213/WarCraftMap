class TraditionNativeRepresentations extends WarcraftMilitarySettlementAdapter
	int lastLife = 0
	override function maximumLife(unit target) returns int
		return 100
	override function setMaximumLife(unit target, int value)
		lastLife = value

@test function earnedTraditionReconcilesRealLocalObjectsWithoutRevivingDeadAuthority()
	let objects = new TraditionNativeRepresentations()
	let runtime = new MilitarySettlementRuntime(objects)
	configureGeneratedMilitaryTraditions(runtime, true).assertTrue()
	runtime.registerForce(new RuntimeForce("first", "england", "map", "land_formation", FORCE_ARMY, 'hfoo', 40, 20, 0., 0.))
	runtime.registerForce(new RuntimeForce("second", "france", "map", "land_formation", FORCE_ARMY, 'hfoo', 13, 20, 0., 0.))
	runtime.setWar("england", "france", true)
	runtime.activateRegion("map")
	let natives = new RecordingCombatNatives()
	let events = new MilitaryCombatEvents(runtime, new PlayerCampaignIdentity(), new ManagementScreenPauseController(new RecordingCombatPause(), false), natives)
	events.install()
	let obsolete = objects.representationId("second")
	natives.death(obsolete, objects.representationId("first"))
	runtime.traditions[runtime.traditionIndex("england", "land_formation")].experience.assertEquals("13")
	objects.representationId("second").assertEquals(0)
	// The pending authored coefficient adapters do not grant invented HP.
	objects.lastLife.assertEquals(100)
	let saved = runtime.snapshot()
	runtime.restore(saved).assertTrue()
	natives.death(obsolete, objects.representationId("first"))
	runtime.snapshot().assertEquals(saved)
	runtime.forces[runtime.forceIndex("second")].active.assertFalse()
	objects.representationId("second").assertEquals(0)
	events.stop()

function traditionLandCrossing(BoundaryCorrespondence boundary) returns real
	for i = 0 to 100
		let position = i / 100.
		if boundary.destination.resolve(boundary.destinationPosition(position), 0, null)
			return position
	return -1.

@test function combatEarnedTraditionTravelsInTheProductionCampaignCheckpoint()
	let f = traditionCombatFixture()
	f.runtime.awardTradition("player", "land_formation", "9007199254740993")
	f.runtime.awardTradition("player", "sailing_naval", "2147483647")
	f.natives.death(f.token("enemy"), f.token("player_army"))
	f.natives.death(f.token("enemy_fleet"), f.token("player_fleet"))
	let boundary = f.startup.campaign.state.boundary("europe_west_to_europe_central_east")
	let departed = f.startup.campaign.travel.transition(boundary, traditionLandCrossing(boundary), "earned-travel")
	if not departed
		print("Earned travel: " + f.startup.campaign.travel.diagnostic())
	departed.assertTrue()
	let destination = new StartupFixture(f.startup.cache, f.startup.saves, "europe_central_east")
	destination.register()
	let arrived = destination.campaign.startup()
	if not arrived
		print("Earned arrival: " + destination.campaign.diagnostic())
	arrived.assertTrue()
	let military = destination.campaign.state.militarySettlements
	military.activeRegionId.assertEquals("europe_central_east")
	military.traditions[military.traditionIndex("player", "land_formation")].experience.assertEquals("9007199254741033")
	military.traditions[military.traditionIndex("player", "sailing_naval")].experience.assertEquals("2147483660")
	military.forces[military.forceIndex("enemy")].active.assertFalse()
	military.forces[military.forceIndex("enemy_fleet")].strength.assertEquals(0)
	destination.ports.selectorIdentity = destination.campaign.identity
	let returnBoundary = destination.campaign.state.boundary("europe_central_east_to_europe_west")
	let returning = destination.campaign.travel.transition(returnBoundary, traditionLandCrossing(returnBoundary), "earned-return")
	if not returning
		print("Earned return: " + destination.campaign.travel.diagnostic())
	returning.assertTrue()
	let revisited = new StartupFixture(f.startup.cache, f.startup.saves, "europe_west")
	revisited.register()
	let returned = revisited.campaign.startup()
	if not returned
		print("Earned return arrival: " + revisited.campaign.diagnostic())
	returned.assertTrue()
	let restored = revisited.campaign.state.militarySettlements
	restored.traditions[restored.traditionIndex("player", "land_formation")].experience.assertEquals("9007199254741033")
	restored.traditions[restored.traditionIndex("player", "sailing_naval")].experience.assertEquals("2147483660")
	restored.forces[restored.forceIndex("enemy")].active.assertFalse()
	restored.forces[restored.forceIndex("enemy_fleet")].active.assertFalse()
	f.close()

@test function installedCombatCrossesIntegerBoundaryAndCommitsOnce()
	let f = traditionCombatFixture()
	(installMilitaryCombatEvents(f.startup.campaign, f.natives, f.pause) == f.events).assertTrue()
	f.runtime.awardTradition("player", "land_formation", "2147483647")
