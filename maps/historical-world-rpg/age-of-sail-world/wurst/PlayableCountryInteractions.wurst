package PlayableCountryInteractions

import CommandRouter
import CountryDiplomacyScreen
import MilitarySettlementRuntime

/** Campaign-owned conflict/territory commit port.  UI records never apply a
 * treaty directly to Warcraft objects. */
public interface CountryPeaceAuthority
	function commitPeace(string conflictId, string terms) returns boolean

/**
 * Stable, handle-free authority behind the country interaction screen.  Scenario
 * generation supplies polity-specific profiles; this object owns only campaign
 * facts and can therefore be captured and reconstructed on every physical map.
 */
public class GovernmentRewardProfile
	string polityId
	string rewardId
	string kind
	int contributionRequired
	int reputationRequired
	int treasuryCost
	boolean foreignService
	construct(string polityId, string rewardId, string kind, int contributionRequired, int reputationRequired, int treasuryCost, boolean foreignService)
		this.polityId = polityId
		this.rewardId = rewardId
		this.kind = kind
		this.contributionRequired = contributionRequired
		this.reputationRequired = reputationRequired
		this.treasuryCost = treasuryCost
		this.foreignService = foreignService

public class PlayableCountryInteractionRuntime implements CountryDiplomacyAuthority
	PlayerCampaignIdentity identity
	CountryPeaceAuthority peaceAuthority = null
	MilitarySettlementRuntime military = null
	string array[512] polityIds
	boolean array[512] known
	// Used only by an isolated restoration candidate, never persisted.
	boolean array[512] restoredPolities
	int array[512] reputation
	int array[512] favor
	int array[512] contribution
	int array[512] treasury
	int array[512] materialStock
	int polityCount = 0
	GovernmentRewardProfile array[1024] profiles
	boolean array[1024] granted
	int profileCount = 0
	// v1 migration input only. Active conflict authority lives in military.
	boolean legacyState = false
	string array[128] conflictPolities
	string array[128] conflictIds
	int conflictCount = 0
	string array[128] offerIds
	string array[128] offerPolities
	string array[128] offerConflicts
	string array[128] offerInitiators
	string array[128] offerTerms
	int array[128] offerStatus
	int offerCount = 0
	int nextOffer = 1
	string lastDiagnostic = ""
	construct(PlayerCampaignIdentity identity)
		this.identity = identity
	function setMilitaryAuthority(MilitarySettlementRuntime authority)
		military = authority
	function setPeaceAuthority(CountryPeaceAuthority authority)
		peaceAuthority = authority
	function polityIndex(string polityId) returns int
		for i = 0 to polityCount - 1
			if polityIds[i] == polityId
				return i
		return -1
	function profileIndex(string polityId, string rewardId) returns int
		for i = 0 to profileCount - 1
			if profiles[i].polityId == polityId and profiles[i].rewardId == rewardId
				return i
		return -1
	function offerIndex(string offerId) returns int
		for i = 0 to offerCount - 1
			if offerIds[i] == offerId
				return i
		return -1
	function registerPolity(string polityId, int availableTreasury)
		registerPolityResources(polityId, availableTreasury, 0)
	function registerPolityResources(string polityId, int availableTreasury, int availableMaterialStock)
		if polityId != "" and polityIndex(polityId) < 0
			polityIds[polityCount] = polityId
			// A rolled-back founding may have used this registry slot before.
			known[polityCount] = false
			reputation[polityCount] = 0
			favor[polityCount] = 0
			contribution[polityCount] = 0
			restoredPolities[polityCount] = false
			treasury[polityCount] = availableTreasury
			materialStock[polityCount] = availableMaterialStock
			polityCount++
	/** Reconciliation entry point for economy/event projections. */
	function reconcileResources(string polityId, int availableTreasury, int availableMaterialStock)
		let i = polityIndex(polityId)
		if i >= 0
			treasury[i] = availableTreasury
			materialStock[i] = availableMaterialStock
	function registerRewardProfile(GovernmentRewardProfile profile)
		if profile != null and polityIndex(profile.polityId) >= 0 and profileIndex(profile.polityId, profile.rewardId) < 0
			profiles[profileCount] = profile
			profileCount++
	function discover(string polityId) returns boolean
		let i = polityIndex(polityId)
		if i < 0
			return false
		known[i] = true
		return true
	function setStanding(string polityId, int newReputation, int newFavor)
		let i = polityIndex(polityId)
		if i >= 0
			reputation[i] = newReputation
			favor[i] = newFavor
	function recordContribution(string polityId, int magnitude) returns boolean
		let i = polityIndex(polityId)
		if i < 0 or magnitude <= 0
			return false
		contribution[i] += magnitude
		return true
	override function isKnown(string polityId) returns boolean
		let i = polityIndex(polityId)
		return i >= 0 and known[i]
	override function countrySummary(string polityId) returns string
		let i = polityIndex(polityId)
		if i < 0 or not known[i]
			return ""
		return "Allegiance: " + identity.allegianceId() + "; reputation " + reputation[i].toString() + "; favor " + favor[i].toString() + "; contribution " + contribution[i].toString()
	override function availableInteractions(string polityId) returns string
		if not isKnown(polityId)
			return ""
		return "serve, request_reward, request_access, negotiate"
	override function activeConflictWith(string polityId) returns string
		if not isKnown(polityId)
			return ""
		if military == null
			return ""
		return military.activeConflictBetween(identity.allegianceId(), polityId)
	override function validateOffer(string conflictId, string recipientPolityId, string terms) returns string
		if not isKnown(recipientPolityId)
			return "You cannot negotiate with an undiscovered government."
		if military == null or not military.activeOpponents(conflictId, identity.allegianceId(), recipientPolityId)
			return "There is no active war to settle."
		if terms == "" or terms.indexOf("impossible") >= 0 or terms.indexOf("|") >= 0 or terms.indexOf(",") >= 0 or terms.indexOf(";") >= 0
			return "Those terms are impossible."
		return ""
	override function createOffer(string conflictId, string recipientPolityId, string terms) returns string
		if offerCount >= 128 or nextOffer >= 2147483647 or validateOffer(conflictId, recipientPolityId, terms) != ""
			return ""
		let id = "player_offer_" + nextOffer.toString()
		nextOffer++
		offerIds[offerCount] = id
		offerPolities[offerCount] = recipientPolityId
		offerConflicts[offerCount] = conflictId
		offerInitiators[offerCount] = identity.allegianceId()
		offerTerms[offerCount] = terms
		offerStatus[offerCount] = 0
		offerCount++
		return id
	override function respondToOffer(string offerId, boolean accept, boolean confirmed) returns string
		let i = offerIndex(offerId)
		if i < 0 or offerStatus[i] != 0
			return "Offer is not pending."
		if accept and not confirmed
			return "Confirmation required."
		if accept and (identity.allegianceId() != offerInitiators[i] or validateOffer(offerConflicts[i], offerPolities[i], offerTerms[i]) != "")
			return "The conflict state no longer permits this treaty."
		if accept and (peaceAuthority == null or not peaceAuthority.commitPeace(offerConflicts[i], offerTerms[i]))
			return "The conflict or territorial authority rejected these terms."
		// The adapter commits the shared conflict and territorial authority first.
		if accept
			offerStatus[i] = 1
			return "Peace concluded under the negotiated terms."
		offerStatus[i] = 2
		return "Peace offer rejected."
	override function requestGovernmentReward(string polityId, string rewardId) returns string
		let p = polityIndex(polityId)
		let r = profileIndex(polityId, rewardId)
		if p < 0 or not known[p]
			return "Reward rejected: country is not discovered."
		if r < 0
			return "Reward rejected: that government has no such reward profile."
		let profile = profiles[r]
		if granted[r]
			return "Reward rejected: reward was already granted."
		if identity.originId() == ""
			return "Reward rejected: immutable origin is unavailable."
		if identity.allegianceId() != polityId and not profile.foreignService
			return "Reward rejected: current allegiance is ineligible."
		if contribution[p] + reputation[p] + favor[p] < profile.contributionRequired or reputation[p] < profile.reputationRequired
			return "Reward rejected: contribution or standing is insufficient."
		if treasury[p] < profile.treasuryCost
			return "Reward rejected: government resources are insufficient."
		// Resource debit and history marker form the single authoritative commit.
		treasury[p] -= profile.treasuryCost
		granted[r] = true
		return "Reward granted: " + rewardId + " (" + profile.kind + ")."
	function captureState() returns string
		var result = "v2"
		for i = 0 to polityCount - 1
			var knownValue = "0"
			if known[i]
				knownValue = "1"
			result += "|p," + polityIds[i] + "," + knownValue + "," + reputation[i].toString() + "," + favor[i].toString() + "," + contribution[i].toString() + "," + treasury[i].toString() + "," + materialStock[i].toString()
		for i = 0 to profileCount - 1
			if granted[i]
				result += "|g," + profiles[i].polityId + "," + profiles[i].rewardId
		for i = 0 to offerCount - 1
			result += "|o," + offerIds[i] + "," + offerPolities[i] + "," + offerStatus[i].toString() + "," + offerTerms[i] + "," + offerConflicts[i] + "," + offerInitiators[i]
		return result
	function recordField(string record, int wanted) returns string
		var start = 0
		var field = 0
		for i = 0 to StringLength(record)
			if i == StringLength(record) or SubString(record, i, i + 1) == ","
				if field == wanted
					return SubString(record, start, i)
				field++
				start = i + 1
		return ""
	function recordFieldCount(string record) returns int
		var count = 1
		for i = 0 to StringLength(record) - 1
			if SubString(record, i, i + 1) == ","
				count++
		return count
	function validInteger(string value) returns boolean
		return value != "" and S2I(value).toString() == value
	/** Applies only to the disposable candidate, including duplicate/capacity checks. */
	function restoreRecord(string record) returns boolean
		let kind = recordField(record, 0)
		let fields = recordFieldCount(record)
		if kind == "p"
			let p = polityIndex(recordField(record, 1))
			if p < 0 or restoredPolities[p] or (fields != 7 and fields != 8) or (recordField(record, 2) != "0" and recordField(record, 2) != "1")
				return false
			for column = 3 to fields - 1
				if not validInteger(recordField(record, column))
					return false
			restoredPolities[p] = true
			known[p] = recordField(record, 2) == "1"
			reputation[p] = S2I(recordField(record, 3))
			favor[p] = S2I(recordField(record, 4))
			contribution[p] = S2I(recordField(record, 5))
			treasury[p] = S2I(recordField(record, 6))
			// v1 records from before live resources omit material stock.
			if recordField(record, 7) != ""
				materialStock[p] = S2I(recordField(record, 7))
			return true
		if kind == "c"
			let p = recordField(record, 1)
			if not legacyState or fields != 3 or polityIndex(p) < 0 or conflictCount >= 128
				return false
			for i = 0 to conflictCount - 1
				if conflictPolities[i] == p
					return false
			conflictPolities[conflictCount] = p
			conflictIds[conflictCount] = recordField(record, 2)
			conflictCount++
			return true
		if kind == "g"
			let r = profileIndex(recordField(record, 1), recordField(record, 2))
			if fields != 3 or r < 0 or granted[r]
				return false
			granted[r] = true
			return true
		if kind == "o"
			let id = recordField(record, 1)
			let status = recordField(record, 3)
			if (legacyState and fields != 5) or (not legacyState and fields != 7) or offerCount >= 128 or id == "" or offerIndex(id) >= 0 or polityIndex(recordField(record, 2)) < 0 or not validInteger(status) or S2I(status) < 0 or S2I(status) > 3 or recordField(record, 4) == ""
				return false
			// v1 retains every offer. Recover its next sequence without changing
			// the save format; unrelated stable IDs do not consume player IDs.
			if id.startsWith("player_offer_")
				let suffix = SubString(id, 13, StringLength(id))
				if not validInteger(suffix) or S2I(suffix) < 1 or S2I(suffix) >= 2147483647
					return false
				nextOffer = IMaxBJ(nextOffer, S2I(suffix) + 1)
			offerIds[offerCount] = id
			offerPolities[offerCount] = recordField(record, 2)
			offerStatus[offerCount] = S2I(recordField(record, 3))
			offerTerms[offerCount] = recordField(record, 4)
			offerConflicts[offerCount] = recordField(record, 5)
			offerInitiators[offerCount] = recordField(record, 6)
			// The old format never stored an offer's original conflict/initiator.
			// Retire those offers rather than guessing and settling a newer war.
			if legacyState
				offerStatus[offerCount] = 3
			else if offerStatus[offerCount] != 3 and (offerConflicts[offerCount] == "" or polityIndex(offerInitiators[offerCount]) < 0 or offerInitiators[offerCount] == offerPolities[offerCount])
				return false
			offerCount++
			return true
		return false
	function copyDefinitions() returns PlayableCountryInteractionRuntime
		let copy = new PlayableCountryInteractionRuntime(identity)
		for i = 0 to polityCount - 1
			copy.registerPolityResources(polityIds[i], treasury[i], materialStock[i])
		for i = 0 to profileCount - 1
			copy.registerRewardProfile(profiles[i])
		return copy
	/** Validate against detached country and conflict registries, including a
	 * polity introduced by the candidate's piracy authority. No live callbacks. */
	function validateState(string candidate, MilitarySettlementRuntime warfare, string foundedPolity) returns boolean
		let detached = copyDefinitions()
		if foundedPolity != "" and detached.polityIndex(foundedPolity) < 0
			if detached.polityCount >= 512
				destroy detached
				lastDiagnostic = "country registry is full"
				return false
			detached.registerPolity(foundedPolity, 0)
		let valid = detached.validateState(candidate, warfare)
		lastDiagnostic = detached.diagnostic()
		destroy detached
		return valid
	function parseState(string candidate) returns PlayableCountryInteractionRuntime
		if (candidate != "v1" and not candidate.startsWith("v1|") and candidate != "v2" and not candidate.startsWith("v2|")) or candidate.endsWith("|")
			return null
		let staged = copyDefinitions()
		staged.legacyState = candidate == "v1" or candidate.startsWith("v1|")
		var start = 3
		while start < StringLength(candidate)
			var finish = SubString(candidate, start, StringLength(candidate)).indexOf("|")
			if finish < 0
				finish = StringLength(candidate) - start
			if not staged.restoreRecord(SubString(candidate, start, start + finish))
				destroy staged
				return null
			start += finish + 1
		return staged
	function validateState(string candidate, MilitarySettlementRuntime warfare) returns boolean
		let staged = parseState(candidate)
		if staged == null
			lastDiagnostic = "country interaction state contains an invalid record"
			return false
		var valid = true
		for i = 0 to staged.offerCount - 1
			if staged.offerStatus[i] != 3
				if warfare == null
					valid = false
				else
					let found = warfare.conflictIndex(staged.offerConflicts[i])
					if found < 0 or not warfare.conflicts[found].opposes(staged.offerInitiators[i], staged.offerPolities[i])
						valid = false
		destroy staged
		lastDiagnostic = ""
		if not valid
			lastDiagnostic = "country interaction state contains an invalid conflict binding"
		return valid
	function migrateLegacyConflicts(PlayableCountryInteractionRuntime staged)
		if military == null or not staged.legacyState
			return
		// v1 stored one last conflict per country. Rebuild sides from authored
		// definitions; an absent ID in a populated v1 ledger stays settled. Empty
		// pre-diplomacy ledgers use defaults. Unattributed pair wars remain separate.
		if staged.conflictCount > 0
			for i = 0 to military.conflictCount - 1
				let conflict = military.conflicts[i]
				if not conflict.id.startsWith("legacy:")
					var active = false
					for j = 0 to staged.conflictCount - 1
						if staged.conflictIds[j] == conflict.id
							active = true
					conflict.settled = not active
		military.legacyConflicts = false
		military.reconcileSieges()
	/** Restore scalar authority only after detached validation. */
	function restoreState(string candidate) returns boolean
		if not validateState(candidate, military)
			lastDiagnostic = "country interaction state contains an invalid record or conflict binding"
			return false
		let staged = parseState(candidate)
		migrateLegacyConflicts(staged)
		for i = 0 to polityCount - 1
			known[i] = staged.known[i]
			reputation[i] = staged.reputation[i]
			favor[i] = staged.favor[i]
			contribution[i] = staged.contribution[i]
			treasury[i] = staged.treasury[i]
			materialStock[i] = staged.materialStock[i]
		for i = 0 to profileCount - 1
			granted[i] = staged.granted[i]
		offerCount = staged.offerCount
		for i = 0 to offerCount - 1
			offerIds[i] = staged.offerIds[i]
			offerPolities[i] = staged.offerPolities[i]
			offerConflicts[i] = staged.offerConflicts[i]
			offerInitiators[i] = staged.offerInitiators[i]
			offerTerms[i] = staged.offerTerms[i]
			offerStatus[i] = staged.offerStatus[i]
		nextOffer = staged.nextOffer
		destroy staged
		lastDiagnostic = ""
		return true
	function diagnostic() returns string
		return lastDiagnostic

public function registerGovernmentRewards(CommandRegistry commands, CountryDiplomacyController controller)
	// Rewards share the country interaction boundary and registration transaction.
	registerCountryDiplomacyCommands(commands, controller)
