package WC3Compatibility

import ErrorHandling

// Stable reusable boundary for Warcraft III patch-specific natives.
public constant string WC3_COMPAT_PATCH_FAMILY = "v3.0"
public constant string WC3_COMPAT_SCRIPT_BACKEND = "LUA"
public constant boolean WC3_HAS_MODERN_INVENTORY = true
public constant boolean WC3_HAS_NATIVE_SAVE_MANAGEMENT = true
public constant boolean WC3_HAS_FRAME_UI = true
public constant boolean WC3_HAS_PATHING_QUERIES = true
public constant boolean WC3_HAS_MODERN_UNIT_FIELDS = true

/** Abort initialization rather than silently degrading required behavior. */
public function requireWC3Compatibility()
	if not WC3_HAS_MODERN_INVENTORY or not WC3_HAS_NATIVE_SAVE_MANAGEMENT or not WC3_HAS_FRAME_UI or not WC3_HAS_PATHING_QUERIES or not WC3_HAS_MODERN_UNIT_FIELDS
		error("WC3Compatibility: required Warcraft III " + WC3_COMPAT_PATCH_FAMILY + " / " + WC3_COMPAT_SCRIPT_BACKEND + " capabilities are unavailable")

// Modern inventory/equipment.
public function compatGetEquippedItem() returns item
	return GetEquippedItem()
public function compatGetUnequippedItem() returns item
	return GetUnequippedItem()
public function compatGetItemEquipmentType(item value) returns equipmentType
	return GetItemEquipmentType(value)
public function compatGetItemTag(item value) returns itemTag
	return GetItemTag(value)
public function compatIsItemEquipped(item value) returns boolean
	return IsItemEquipped(value)
public function compatIsItemInBag(item value) returns boolean
	return IsItemInBag(value)
public function compatEquipItem(unit holder, item value) returns boolean
	return UnitEquipItem(holder, value)
public function compatUnequipItem(unit holder, item value)
	UnitUnequipItem(holder, value)
public function compatUnequipItemFromSlot(unit holder, loadoutslot slot) returns item
	return UnitUnequipItemFromSlot(holder, slot)
public function compatExtendedInventorySize(unit holder) returns int
	return UnitExtendedInventorySize(holder)
public function compatItemInBagSlot(unit holder, int slot) returns item
	return UnitItemInBagSlot(holder, slot)
public function compatItemInEquipmentSlot(unit holder, loadoutslot slot) returns item
	return UnitItemInEquipmentSlot(holder, slot)
public function compatHasItemBagged(unit holder, item value) returns boolean
	return UnitHasItemBagged(holder, value)
public function compatHasItemEquipped(unit holder, item value) returns boolean
	return UnitHasItemEquipped(holder, value)
public function compatHasLoadoutSlotEmpty(unit holder, loadoutslot slot) returns boolean
	return UnitHasLoadoutSlotEmpty(holder, slot)
public function compatHasAnyItemEquipped(unit holder) returns boolean
	return UnitHasAnyItemEquiped(holder)
public function compatHasEquipmentType(unit holder, equipmentType value) returns boolean
	return UnitHasItemEquipmentOfType(holder, value)
public function compatCanEquipItemOfType(unit holder, equipmentType value) returns boolean
	return UnitCanEquipItemOfEquipmentType(holder, value)

// Native saves; campaign serialization remains engine-owned.
public function compatInitGameCache(string name) returns gamecache
	return InitGameCache(name)
public function compatHaveStoredString(gamecache cache, string mission, string key) returns boolean
	return HaveStoredString(cache, mission, key)
public function compatGetStoredString(gamecache cache, string mission, string key) returns string
	return GetStoredString(cache, mission, key)
public function compatStoreString(gamecache cache, string mission, string key, string value)
	StoreString(cache, mission, key, value)
public function compatFlushStoredString(gamecache cache, string mission, string key)
	FlushStoredString(cache, mission, key)
public function compatSaveGameCache(gamecache cache) returns boolean
	return SaveGameCache(cache)
public function compatSaveGame(string name)
	SaveGame(name)
public function compatLoadGame(string name, boolean scoreScreen)
	LoadGame(name, scoreScreen)
public function compatSaveGameExists(string name) returns boolean
	return SaveGameExists(name)
public function compatCopySaveGame(string source, string destination) returns boolean
	return CopySaveGame(source, destination)
public function compatRenameSaveDirectory(string source, string destination) returns boolean
	return RenameSaveDirectory(source, destination)
public function compatRemoveSaveDirectory(string name) returns boolean
	return RemoveSaveDirectory(name)
public function compatSaveCheckpoint(string name, boolean showWindow)
	SaveGameCheckpoint(name, showWindow)
/** Physical-map handoff. Campaign authority is committed to game cache before this is called. */
public function compatLoadPhysicalMap(string mapPath)
	// The pinned Wurst standard library exposes the campaign transition through
	// this wrapper. Release acceptance inspects the compiled Lua and requires the
	// wrapper's SetNextLevel side effect to survive optimization before EndGame.
	SetNextLevelBJ(mapPath)
	EndGame(true)

// Native-save regression lifecycle. These adapters are intentionally generic;
// the fixture and developer runner own the test protocol.
public function compatCreateOwnedTimer() returns timer
	return CreateTimer()
public function compatDestroyOwnedTimer(timer value)
	DestroyTimer(value)
public function compatCreateOwnedEffect(string modelPath, real x, real y) returns effect
	return AddSpecialEffect(modelPath, x, y)
public function compatDestroyOwnedEffect(effect value)
	DestroyEffect(value)
public function compatDestroyOwnedFrame(framehandle value)
	BlzDestroyFrame(value)
public function compatCreateOwnedSound(string path) returns sound
	return CreateSound(path, true, false, false, 10, 10, "DefaultEAXON")
public function compatStopOwnedSound(sound value)
	StopSound(value, true, false)
public function compatGameUiFrame() returns framehandle
	return BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0)

// Frame UI.
public function compatCreateFrame(string frameType, string name, framehandle owner, string inherits, int context) returns framehandle
	return BlzCreateFrameByType(frameType, name, owner, inherits, context)
public function compatSetFrameVisible(framehandle frame, boolean visible)
	BlzFrameSetVisible(frame, visible)
public function compatSetFrameEnabled(framehandle frame, boolean enabled)
	BlzFrameSetEnable(frame, enabled)

// Pathing, positioning, and modern unit fields.
public function compatIsTerrainPathable(real x, real y, pathingtype kind) returns boolean
	return IsTerrainPathable(x, y, kind)
public function compatSetUnitPosition(unit target, real x, real y)
	SetUnitPosition(target, x, y)
public function compatSetUnitCoordinates(unit target, real x, real y)
	SetUnitX(target, x)
	SetUnitY(target, y)
public function compatTeleportUnit(unit target, real x, real y)
	SetUnitPosition(target, x, y)
public function compatCreateUnit(player owner, int typeId, real x, real y, real facing) returns unit
	return CreateUnit(owner, typeId, x, y, facing)
public function compatRemoveUnit(unit target)
	RemoveUnit(target)
public function compatPanCamera(player owner, real x, real y, real duration)
	PanCameraToTimedForPlayer(owner, x, y, duration)
public function compatGetUnitMaxLife(unit target) returns int
	return BlzGetUnitMaxHP(target)
public function compatSetUnitMaxLife(unit target, int life)
	BlzSetUnitMaxHP(target, life)
public function compatSetUnitOwner(unit target, player owner, boolean changeColor)
	SetUnitOwner(target, owner, changeColor)
public function compatSetUnitInvulnerable(unit target, boolean shouldProtect)
	SetUnitInvulnerable(target, shouldProtect)
public function compatAddUnitAbility(unit target, int abilityId)
	UnitAddAbility(target, abilityId)
public function compatRemoveUnitAbility(unit target, int abilityId)
	UnitRemoveAbility(target, abilityId)
public function compatGetUnitCollisionSize(unit target) returns real
	return BlzGetUnitCollisionSize(target)

// Development benchmark operations. Keeping these natives here makes the
// benchmark compile against the pinned patch without creating a second
// version-specific boundary.
public function compatBenchmarkCreateUnit(player owner, int unitType, real x, real y) returns unit
	return CreateUnit(owner, unitType, x, y, 0.)
public function compatBenchmarkRemoveUnit(unit target)
	RemoveUnit(target)
public function compatBenchmarkCreateEffect(string modelPath, real x, real y) returns effect
	return AddSpecialEffect(modelPath, x, y)
public function compatBenchmarkDestroyEffect(effect target)
	DestroyEffect(target)
public function compatBenchmarkIssuePointOrder(unit target, string order, real x, real y) returns boolean
	return IssuePointOrder(target, order, x, y)
public function compatBenchmarkIsTerrainPathable(real x, real y, pathingtype kind) returns boolean
	return IsTerrainPathable(x, y, kind)
public function compatBenchmarkClockMilliseconds() returns real
	return TimerGetElapsed(bj_gameStartedTimer) * 1000.
