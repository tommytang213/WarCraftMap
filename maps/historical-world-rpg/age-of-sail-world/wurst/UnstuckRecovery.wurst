package UnstuckRecovery

import CommandRouter
import ErrorHandling

public constant int MOVE_LAND = 0
public constant int MOVE_NAVAL = 1
public constant int MOVE_AMPHIBIOUS = 2
public constant int MOVE_FLYING = 3

/** Scenario-neutral runtime boundary; tests use a recording implementation. */
public interface RecoveryRuntime
	function selectedCount(player owner) returns int
	function selectedStableId(player owner, int index) returns string
	function activeCount(player owner) returns int
	function activeStableId(player owner, int index) returns string
	function mainCharacterStableId(player owner) returns string
	function isPresent(string stableId) returns boolean
	function isPlayerControlled(string stableId, player owner) returns boolean
	function currentRegion(string stableId) returns string
	function relevantRegion(player owner) returns string
	function verifyDestination(string stableId, int movementClass, real x, real y) returns boolean
	function move(string stableId, real x, real y)
	function feedback(player owner, string message)

public class RecoveryZone
	string id
	boolean array[4] movement
	string array[32] links
	int linkCount = 0
	construct(string zoneId)
		id = zoneId
	function supports(int kind) returns boolean
		return kind >= 0 and kind < 4 and movement[kind]
	function addMovement(int kind)
		if kind >= 0 and kind < 4
			movement[kind] = true
	function connect(int kind, string destination)
		links[linkCount] = kind.toString() + ":" + destination
		linkCount++

public class RecoveryPoint
	string id
	string zoneId
	real x
	real y
	boolean verified
	boolean anchor
	boolean array[4] movement
	construct(string pointId, string zone, real px, real py, boolean isVerified, boolean isAnchor)
		id = pointId
		zoneId = zone
		x = px
		y = py
		verified = isVerified
		anchor = isAnchor
	function addMovement(int kind)
		if kind >= 0 and kind < 4
			movement[kind] = true

public class RecoveryEntity
	string stableId
	int movementClass
	string zoneId
	boolean eligibleMobile
	boolean physicallyActive
	boolean dummyOrSystem
	boolean abstractStrategic
	boolean important
	boolean hasLastSafe = false
	string lastSafeZone = ""
	real lastSafeX = 0.
	real lastSafeY = 0.
	construct(string id, int kind, string zone, boolean mobile, boolean active, boolean systemObject, boolean abstractEntity, boolean trackSafe)
		stableId = id
		movementClass = kind
		zoneId = zone
		eligibleMobile = mobile
		physicallyActive = active
		dummyOrSystem = systemObject
		abstractStrategic = abstractEntity
		important = trackSafe
	function canRecover() returns boolean
		return eligibleMobile and physicallyActive and not dummyOrSystem and not abstractStrategic

public class RecoveryResult
	int recovered = 0
	int skipped = 0
	int failed = 0

public class UnstuckRecoveryService
	RecoveryRuntime runtime
	RecoveryZone array[128] zones
	int zoneCount = 0
	RecoveryPoint array[256] points
	int pointCount = 0
	RecoveryEntity array[256] entities
	int entityCount = 0
	construct(RecoveryRuntime adapter)
		runtime = adapter
	function addZone(RecoveryZone value)
		zones[zoneCount] = value
		zoneCount++
	function addPoint(RecoveryPoint value)
		points[pointCount] = value
		pointCount++
	function addEntity(RecoveryEntity value)
		entities[entityCount] = value
		entityCount++
	function entity(string id) returns RecoveryEntity
		for i = 0 to entityCount - 1
			if entities[i].stableId == id
				return entities[i]
		return null
	function zone(string id) returns RecoveryZone
		for i = 0 to zoneCount - 1
			if zones[i].id == id
				return zones[i]
		return null
	function reachable(string origin, string destination, int kind) returns boolean
		string array[128] pending
		string array[128] visited
		var pendingCount = 1
		var visitedCount = 0
		pending[0] = origin
		while pendingCount > 0
			pendingCount--
			let current = pending[pendingCount]
			if current == destination
				let found = zone(current)
				return found != null and found.supports(kind)
			var seen = false
			for i = 0 to visitedCount - 1
				if visited[i] == current
					seen = true
			if not seen
				visited[visitedCount] = current
				visitedCount++
				let currentZone = zone(current)
				if currentZone != null and currentZone.supports(kind)
					for i = 0 to currentZone.linkCount - 1
						let prefix = kind.toString() + ":"
						let link = currentZone.links[i]
						if SubString(link, 0, StringLength(prefix)) == prefix
							let next = SubString(link, StringLength(prefix), StringLength(link))
							let nextZone = zone(next)
							if nextZone != null and nextZone.supports(kind) and pendingCount < 128
								pending[pendingCount] = next
								pendingCount++
		return false
	function destinationValid(RecoveryEntity e, RecoveryPoint point) returns boolean
		return point != null and point.verified and point.movement[e.movementClass] and reachable(e.zoneId, point.zoneId, e.movementClass) and runtime.verifyDestination(e.stableId, e.movementClass, point.x, point.y)
	function recoverEntity(string id) returns boolean
		let e = entity(id)
		if e == null or not e.canRecover() or not runtime.isPresent(id)
			return false
		// Ordinary points are registered nearest-first by the runtime.
		for i = 0 to pointCount - 1
			let point = points[i]
			if not point.anchor and destinationValid(e, point)
				runtime.move(id, point.x, point.y)
				e.zoneId = point.zoneId
				return true
		if e.hasLastSafe and reachable(e.zoneId, e.lastSafeZone, e.movementClass) and runtime.verifyDestination(id, e.movementClass, e.lastSafeX, e.lastSafeY)
			runtime.move(id, e.lastSafeX, e.lastSafeY)
			e.zoneId = e.lastSafeZone
			return true
		for i = 0 to pointCount - 1
			let point = points[i]
			if point.anchor and destinationValid(e, point)
				runtime.move(id, point.x, point.y)
				e.zoneId = point.zoneId
				return true
		return false
	function recoverOne(RecoveryResult result, player owner, string id)
		let e = entity(id)
		if e == null or not e.canRecover() or not runtime.isPresent(id) or not runtime.isPlayerControlled(id, owner)
			result.skipped++
		else if recoverEntity(id)
			result.recovered++
		else
			result.failed++
	function recoverSelection(player owner) returns RecoveryResult
		let result = new RecoveryResult()
		let count = runtime.selectedCount(owner)
		if count == 0
			let main = runtime.mainCharacterStableId(owner)
			if main == ""
				result.failed++
			else
				recoverOne(result, owner, main)
		else
			for i = 0 to count - 1
				recoverOne(result, owner, runtime.selectedStableId(owner, i))
		return result
	function recoverAll(player owner) returns RecoveryResult
		let result = new RecoveryResult()
		let relevant = runtime.relevantRegion(owner)
		for i = 0 to runtime.activeCount(owner) - 1
			let id = runtime.activeStableId(owner, i)
			let e = entity(id)
			if e != null and e.canRecover() and runtime.currentRegion(id) == relevant
				recoverOne(result, owner, id)
		return result
	function updateLastSafe(string id, string safeZone, real x, real y) returns boolean
		let e = entity(id)
		if e == null or not e.important or not e.canRecover() or not reachable(e.zoneId, safeZone, e.movementClass)
			return false
		if runtime.isPresent(id) and not runtime.verifyDestination(id, e.movementClass, x, y)
			return false
		e.hasLastSafe = true
		e.lastSafeZone = safeZone
		e.lastSafeX = x
		e.lastSafeY = y
		return true
	function clearInvalidLastSafe()
		for i = 0 to entityCount - 1
			let e = entities[i]
			if e.hasLastSafe and (not runtime.isPresent(e.stableId) or not reachable(e.zoneId, e.lastSafeZone, e.movementClass) or not runtime.verifyDestination(e.stableId, e.movementClass, e.lastSafeX, e.lastSafeY))
				e.hasLastSafe = false
	function exportLastSafe(string id) returns string
		let e = entity(id)
		if e == null or not e.hasLastSafe
			return ""
		return e.stableId + "|" + e.lastSafeZone + "|" + e.lastSafeX.toString() + "|" + e.lastSafeY.toString()
	function importLastSafe(string id, string safeZone, real x, real y) returns boolean
		// The versioned save codec parses fields; import always revalidates them.
		return updateLastSafe(id, safeZone, x, y)
	function setPointVerified(string id, boolean verified) returns boolean
		for i = 0 to pointCount - 1
			if points[i].id == id
				points[i].verified = verified
				return true
		return false

public class UnstuckCommand implements CommandHandler
	UnstuckRecoveryService service
	construct(UnstuckRecoveryService recovery)
		service = recovery
	override function execute(player sender, string arguments)
		RecoveryResult result
		if arguments == ""
			result = service.recoverSelection(sender)
		else if StringCase(arguments, false) == "all"
			result = service.recoverAll(sender)
		else
			service.runtime.feedback(sender, "Invalid arguments. Usage: /unstuck [all]")
			return
		if result.recovered > 0
			service.runtime.feedback(sender, "Recovered " + result.recovered.toString() + " unit(s); skipped " + result.skipped.toString() + "; no safe destination for " + result.failed.toString() + ".")
		else if result.skipped > 0
			service.runtime.feedback(sender, "Selected objects are not eligible for recovery; nothing was moved.")
		else
			service.runtime.feedback(sender, "No verified connected safe destination was found; nothing was moved.")

public function registerUnstuckCommand(CommandRegistry registry, UnstuckRecoveryService service)
	let problem = registry.register("unstuck", "", "unstuck [all]", "Recover stuck mobile units.", "Recover selected eligible mobile units, or your main character when nothing is selected. Use 'all' for active units in the current region.", 0, 1, COMMAND_RELEASE, new UnstuckCommand(service))
	if problem != ""
		error(problem)
