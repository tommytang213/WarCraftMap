	active.military.science.states[2].work.assertEquals(0)

@test function chemicalFailedCampaignLoadRollsBackWorkFractionInputsAndEarnedSource()
	let f = new LoadFixture()
	let effects = new ScienceResearchEffects(f.rpg.technologies.effects)
	f.rpg.technologies.effects = effects
	// Read the actual typed source from generated scenario definitions.
	let definitions = new ScienceLedger()
	configureGeneratedScience(definitions, effects)
	let site = definitions.sites[2]
	site.id = "study"
	site.settlementId = "port"
	site.good = "grain"
	site.firstDay = 0
	site.prerequisite = "chemical_classification"
	site.dailyWork = 1
	site.equipmentDays = 1
	site.observationTargets = "|study_target|"
	f.military.science.register(site)
	f.military.appoint("port", new AdministratorState("clerk", "Clerk", "Scholar", "england", "europe_west", "port", 40, 50, 40, 1))
	let technology = new RuntimeTechnology("chemical_classification", "Classification", 1, 1)
	technology.addUnlock("chemical_classification", "modifier", "progression_chemical_classification")
	f.rpg.technologies.register(technology).assertTrue()
	f.rpg.research("england", "chemical_classification", 1, 1).assertTrue()
	f.rpg.technologies.register(new RuntimeTechnology("study_target", "Study", 1, 1)).assertTrue()
	let runtime = new ScienceCampaignRuntime(f.campaign.state, f.extension.trade, effects)
	f.campaign.state.scienceRuntime = runtime
	runtime.act("england", "equip", "study", "").assertEquals("")
	let day = f.clock.currentDay
	f.clock.advanceTo(day + 1).assertTrue()
	runtime.act("england", "start", "study", "study_target").assertEquals("")
	f.clock.advanceTo(day + 2).assertTrue()
	f.military.science.states[0].work.assertEquals(1)
	f.military.science.states[0].remainder.assertEquals(400)
	let savedClock = f.clock.captureState()
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "chemical").assertTrue()
	f.clock.advanceTo(day + 3).assertTrue()
	let before = f.military.snapshot()
	let stocks = f.extension.trade.capture()
	let treasury = f.campaign.countries.treasury[0]
	f.recordingTimer.expected = f.clock.captureState()
	f.extension.fail = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.military.snapshot().assertEquals(before)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	effects.rate("england", "repeatable_observation_efficiency").assertEquals(400)
	f.extension.fail = false
	f.recordingTimer.expected = savedClock
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.military.science.states[0].work.assertEquals(1)
	f.military.science.states[0].remainder.assertEquals(400)
	f.clock.advanceTo(day + 3).assertTrue()
	f.military.snapshot().assertEquals(before)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)

// Commission only the Channel instruments. No Botanical or Calculus entitlement
// or action is present in either arm of the Barometric comparison.
function barometricSetup(ScienceFixture f, boolean earned)
	if earned
		let gold = f.resources.balance
		f.unlock("barometric_measurement")
		f.resources.balance.assertEquals(gold - f.rpg.technologies.cost("barometric_measurement", 1778, 0, 0))
	f.action("equip", 0, "")
	f.campaign.countries.treasury[0].assertEquals(99880)
	f.trade.markets[0].stock.assertEquals(998)
	f.advance(7)
	f.action("start", 0, "")
	f.campaign.countries.treasury[0].assertEquals(99879)

@test function barometricOnlyRegisteredVoyageCommitsExactStormLossAgainstMatchedControl()
	let treatment = new ScienceFixture(false, true)
	let control = new ScienceFixture(false, true)
	barometricSetup(treatment, true)
	barometricSetup(control, false)
	treatment.effects.rate("player", "storm_attrition_reduction").assertEquals(1000)
	control.effects.rate("player", "storm_attrition_reduction").assertEquals(0)
	treatment.effects.rate("player", "unknown_route_attrition_reduction").assertEquals(0)
	treatment.effects.rate("player", "research_generation_efficiency").assertEquals(0)
	let ship = treatment.military.forces[treatment.military.forceIndex("english_patrol_ship")]
	let other = control.military.forces[control.military.forceIndex("english_patrol_ship")]
	let hull = ship.hull.integrity
	let navigation = ship.navigation.record()
	treatment.advance(17)
	control.advance(17)
	let measured = treatment.military.science.states[0]
	let baseline = control.military.science.states[0]
	baseline.lost.assertEquals(40)
	measured.lost.assertEquals(36)
	measured.avoided.assertEquals(4)
	baseline.avoided.assertEquals(0)
	(1000 - other.supply - baseline.lost).assertEquals(20)
	(1000 - ship.supply - measured.lost).assertEquals(20)
	other.supply.assertEquals(940)
	ship.supply.assertEquals(944)
	ship.strength.assertEquals(10)
	ship.hull.integrity.assertEquals(hull)
	ship.navigation.record().assertEquals(navigation)
	treatment.campaign.countries.treasury[0].assertEquals(99869) // 120 + 1 + ten daily bills.
	control.campaign.countries.treasury[0].assertEquals(99869)
	treatment.trade.markets[0].stock.assertEquals(988) // two equipment + ten daily inputs.
	control.trade.markets[0].stock.assertEquals(988)
	treatment.campaign.knowledge.snapshot().assertEquals(control.campaign.knowledge.snapshot())
	let saved = treatment.military.snapshot()
	treatment.advance(17)
	treatment.runtime.advance(treatment.day + 17)
	treatment.rpg.technologies.reconstructAll()
	treatment.rpg.technologies.reconstructAll()
	treatment.military.snapshot().assertEquals(saved)
	treatment.campaign.countries.treasury[0].assertEquals(99869)
	treatment.trade.markets[0].stock.assertEquals(988)

