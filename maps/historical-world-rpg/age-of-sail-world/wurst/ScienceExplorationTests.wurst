@test function barometricFractionsResumeReconstructAndCaptureWithPlayerAiParity()
	let human = new ScienceFixture(false, true)
	let ai = new ScienceFixture(true, false)
	barometricSetup(human, true)
	barometricSetup(ai, true)
	for i = 0 to 1
		var f = human
		if i == 1
			f = ai
		let d = f.military.science.sites[0]
		d.hazardLoss = 3
		d.weatherDays = d.weatherPeriod
	human.advance(10)
	ai.advance(10)
	human.military.science.states[0].remainder.assertEquals(9000)
	human.military.science.states[0].lost.assertEquals(9)
	let saved = human.military.snapshot()
	let research = human.rpg.captureState()
	human.military.restore(saved).assertTrue()
	human.rpg.restoreState(research).assertTrue()
	human.rpg.technologies.reconstructAll()
	human.rpg.technologies.reconstructAll()
	human.military.restore(saved + "|j,unknown,,,,,,,,,,").assertFalse()
	human.military.snapshot().assertEquals(saved)
	human.advance(11)
	ai.advance(11)
	human.military.science.states[0].remainder.assertEquals(2000)
	human.military.science.states[0].lost.assertEquals(11)
	human.military.science.states[0].avoided.assertEquals(1)
	let ship = human.military.forces[human.military.forceIndex("english_patrol_ship")]
	ship.supply.assertEquals(981)
	ship.supply.assertEquals(ai.military.forces[ai.military.forceIndex("english_patrol_ship")].supply)
	human.campaign.countries.treasury[0].assertEquals(ai.campaign.countries.treasury[0])
	human.trade.markets[0].stock.assertEquals(ai.trade.markets[0].stock)
	human.campaign.knowledge.snapshot().assertEquals(ai.campaign.knowledge.snapshot())
	human.military.transferControl(ship.id, "ai", human.day + 11)
	human.military.science.states[0].owner.assertEquals("")
	human.military.science.states[0].equipmentOwner.assertEquals("ai")
	human.military.science.states[0].remainder.assertEquals(0)
	human.effects.rate("ai", "storm_attrition_reduction").assertEquals(0)
	human.advance(17)
	ship.supply.assertEquals(981)

