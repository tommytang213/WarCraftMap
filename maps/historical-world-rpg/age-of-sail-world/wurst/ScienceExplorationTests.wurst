// Isolated paid overland circuit: only Botanical research differs between arms.
function botanicalSetup(ScienceFixture f, boolean earned)
	if earned
		let gold = f.resources.balance
		f.unlock("botanical_collecting")
		f.resources.balance.assertEquals(gold - f.rpg.technologies.cost("botanical_collecting", 1778, 0, 0))
	f.action("equip", 1, "")
	f.campaign.countries.treasury[0].assertEquals(99880)
	f.trade.markets[0].stock.assertEquals(998)
	f.advance(7)
	f.action("start", 1, "")
	f.campaign.countries.treasury[0].assertEquals(99879)

