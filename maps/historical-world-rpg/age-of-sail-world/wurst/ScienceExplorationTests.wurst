	actor.supply.assertEquals(ai.military.forces[ai.military.forceIndex("english_guard_formation")].supply)
	human.campaign.countries.treasury[0].assertEquals(ai.campaign.countries.treasury[0])
	human.trade.markets[0].stock.assertEquals(ai.trade.markets[0].stock)
	human.campaign.knowledge.snapshot().assertEquals(ai.campaign.knowledge.snapshot())
	human.advance(13)
	human.military.science.states[1].remainder.assertEquals(2000)
	human.military.transferControl(actor.id, "ai", human.day + 13)
	human.military.science.states[1].owner.assertEquals("")
	human.military.science.states[1].equipmentOwner.assertEquals("ai")
	human.military.science.states[1].remainder.assertEquals(0)
	human.effects.rate("ai", "unknown_route_attrition_reduction").assertEquals(0)
	human.advance(17)
	actor.supply.assertEquals(977)

@test function botanicalNamedSourcesDeduplicateAndUnrelatedResearchCannotReduceSurveyLoss()
	let treatment = new ScienceFixture(false, false)
	let unrelated = new ScienceFixture(false, true)
	unrelated.unlock("barometric_measurement")
	unrelated.unlock("calculus_methods")
	unrelated.rpg.restoreState(unrelated.rpg.captureState() + "|u,player,electrical_experimentation|u,player,scholastic_natural_philosophy").assertTrue()
	unrelated.rpg.technologies.reconstructAll()
	unrelated.unlock("chemical_classification")
	botanicalSetup(treatment, true)
	botanicalSetup(unrelated, false)
	let duplicate = new RuntimeTechnology("duplicate_botanical", "Duplicate botanical source", 1450, 1)
	duplicate.addUnlock("duplicate_botanical", "modifier", "progression_botanical_collecting")
	treatment.rpg.technologies.register(duplicate).assertTrue()
	treatment.unlock("duplicate_botanical")
	let gold = treatment.resources.balance
	treatment.commands.dispatch(Player(0), "/research botanical_collecting").assertTrue()
	treatment.resources.output.assertEquals("Requirements are not met here.")
	treatment.resources.balance.assertEquals(gold)
	treatment.rpg.technologies.reconstructAll()
	treatment.rpg.technologies.reconstructAll()
	treatment.effects.rate("player", "unknown_route_attrition_reduction").assertEquals(1000)
	treatment.effects.rate("ai", "unknown_route_attrition_reduction").assertEquals(0)
	unrelated.effects.rate("player", "unknown_route_attrition_reduction").assertEquals(0)
	treatment.advance(17)
	unrelated.advance(17)
	treatment.military.science.states[1].lost.assertEquals(18)
	unrelated.military.science.states[1].lost.assertEquals(20)
	treatment.military.forces[treatment.military.forceIndex("english_guard_formation")].supply.assertEquals(962)
	unrelated.military.forces[unrelated.military.forceIndex("english_guard_formation")].supply.assertEquals(960)
	treatment.campaign.countries.treasury[0].assertEquals(unrelated.campaign.countries.treasury[0])
	treatment.trade.markets[0].stock.assertEquals(unrelated.trade.markets[0].stock)

@test function botanicalFailedCampaignLoadRollsBackSupplyFractionBillsAndResearch()
	let f = new LoadFixture()
	let effects = new ScienceResearchEffects(f.rpg.technologies.effects)
	f.rpg.technologies.effects = effects
	let definitions = new ScienceLedger()
	configureGeneratedScience(definitions, effects)
	let d = definitions.sites[1]
	d.id = "survey"
	d.settlementId = "port"
	d.forceId = "army"
	d.good = "grain"
	d.firstDay = 0
	d.prerequisite = "botanical_collecting"
	d.equipmentDays = 1
	d.unitTypeId = 'hfoo'
	d.stationX = 40.
	d.stationY = 50.
	d.hazardLoss = 2
	d.weatherDays = d.weatherPeriod
	f.military.science.register(d)
	f.military.appoint("port", new AdministratorState("clerk", "Clerk", "Observer", "england", "europe_west", "port", 40, 50, 40, 1))
	f.military.registerForce(new RuntimeForce("army", "england", "europe_west", "", FORCE_ARMY, 'hfoo', 10, 1000, 40., 50.))
	let technology = new RuntimeTechnology("botanical_collecting", "Botanical collecting", 1, 1)
	technology.addUnlock("botanical_collecting", "modifier", "progression_botanical_collecting")
	f.rpg.technologies.register(technology).assertTrue()
	f.rpg.research("england", "botanical_collecting", 1, 1).assertTrue()
	let runtime = new ScienceCampaignRuntime(f.campaign.state, f.extension.trade, effects)
	f.campaign.state.scienceRuntime = runtime
	runtime.act("england", "equip", d.id, "").assertEquals("")
	let day = f.clock.currentDay
	f.clock.advanceTo(day + 1).assertTrue()
	runtime.act("england", "start", d.id, "").assertEquals("")
	f.clock.advanceTo(day + 2).assertTrue()
	f.military.science.states[0].remainder.assertEquals(2000)
	let savedClock = f.clock.captureState()
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "botanical").assertTrue()
	f.clock.advanceTo(day + 3).assertTrue()
	let before = f.military.snapshot()
	let stocks = f.extension.trade.capture()
	let treasury = f.campaign.countries.treasury[0]
	let knowledge = f.campaign.state.knowledge.snapshot()
	f.rpg.restoreState(f.rpg.captureState().replace("|u,england,botanical_collecting", "")).assertTrue()
	f.rpg.technologies.reconstructAll()
	let research = f.rpg.captureState()
	effects.rate("england", "unknown_route_attrition_reduction").assertEquals(0)
	f.recordingTimer.expected = f.clock.captureState()
	f.extension.fail = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.military.snapshot().assertEquals(before)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	f.rpg.captureState().assertEquals(research)
	f.campaign.state.knowledge.snapshot().assertEquals(knowledge)
	effects.rate("england", "unknown_route_attrition_reduction").assertEquals(0)
	f.extension.fail = false
	f.recordingTimer.expected = savedClock
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	effects.rate("england", "unknown_route_attrition_reduction").assertEquals(1000)
	f.military.science.states[0].remainder.assertEquals(2000)
	f.clock.advanceTo(day + 3).assertTrue()
	f.military.snapshot().assertEquals(before)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	f.campaign.state.knowledge.snapshot().assertEquals(knowledge)
