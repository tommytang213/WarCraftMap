package PlayableTrade
import CommandRouter
import PlayableCampaignRuntime

/** Warcraft runtime boundary for the authoritative campaign trade state.
 * Handles and frames never own stock: adapters rebuild this model from stable
 * save IDs and commit the returned state through the campaign-save manager. */
public class TradeStore
	string id
	int capacity
	int cargo=0
	int money=0
	string goodId=""
	construct(string storeId,int capacityUnits,int currencyMinor)
		id=storeId
		capacity=capacityUnits
		money=currencyMinor
	function freeCapacity() returns int
		return capacity-cargo

public class RuntimeMarket
	string id
	string goodName
	int stock
	int money
	int buyUnitPrice
	int sellUnitPrice
	int previousUnitPrice
	int baseUnitPrice
	int targetStock
	boolean discovered=true
	boolean blockaded=false
	boolean occupiedByHostile=false
	int productionPermille=1000
	int consumptionPermille=1000
	int shortagePermille=0
	int eventPermille=0
	int technologyPermille=0
	construct(string marketId,string displayedGood,int initialStock,int currencyMinor,int buyPrice,int sellPrice)
		id=marketId
		goodName=displayedGood
		stock=initialStock
		money=currencyMinor
		buyUnitPrice=buyPrice
		sellUnitPrice=sellPrice
		previousUnitPrice=buyPrice
		baseUnitPrice=buyPrice
		targetStock=IMaxBJ(1,initialStock)
	function trend() returns string
		if buyUnitPrice>previousUnitPrice
			return "rising"
		if buyUnitPrice<previousUnitPrice
			return "falling"
		return "steady"
	function inspect() returns string
		if not discovered
			return "No discovered commodities."
		if blockaded or occupiedByHostile
			return "Market access is restricted."
		return goodName+": "+stock.toString()+" available; buy "+buyUnitPrice.toString()+"; sell "+sellUnitPrice.toString()+"; "+trend()
	function currentBuyUnitPrice() returns int
		// Integer-only version of the authoritative headless pressure model. Quotes
		// are recomputed at commit time, so cached UI text cannot be exploited.
		let disruption=shortagePermille+eventPermille+(consumptionPermille-productionPermille) div 2
		var access=1000
		if blockaded
			access+=500
		if occupiedByHostile
			access+=400
		let stockPressure=targetStock*1000 div IMaxBJ(targetStock div 4,stock)
		let price=IMaxBJ(1,baseUnitPrice*stockPressure*(1000+disruption) div 1000000)
		return IMaxBJ(1,price*access*(1000-technologyPermille) div 1000000)
	function currentSellUnitPrice() returns int
		return IMaxBJ(1,currentBuyUnitPrice()*920 div 1000)
	function reprice()
		previousUnitPrice=buyUnitPrice
		buyUnitPrice=currentBuyUnitPrice()
		sellUnitPrice=currentSellUnitPrice()

public class MerchantProgress
	int standing=0
	int realizedProfit=0
	int completedRouteCount=0
	function warehouseAccess() returns boolean
		return standing>=100
	function marketIntelligence() returns boolean
		return standing>=500

public class PlayableTradeController
	MerchantProgress progress
	string array[4096] processed
	int processedCount=0
	int carriedCost=0
	int carriedQuantity=0
	string carriedOrigin=""
	construct(MerchantProgress p)
		progress=p
	function seen(string transactionId) returns boolean
		for i=0 to processedCount-1
			if processed[i]==transactionId
				return true
		return false
	function mark(string transactionId)
		processed[processedCount]=transactionId
		processedCount++
	function buy(string transactionId,RuntimeMarket market,TradeStore destination,int quantity) returns string
		if seen(transactionId)
			return "Transaction already processed."
		if quantity<=0
			return "Quantity must be positive."
		if not market.discovered
			return "Commodity is not discovered."
		if market.blockaded or market.occupiedByHostile
			return "Market access is restricted."
		let charge=market.currentBuyUnitPrice()*quantity
		if market.stock<quantity
			return "Market stock is insufficient."
		if destination.money<charge
			return "Funds are insufficient."
		if destination.freeCapacity()<quantity
			return "Cargo capacity is insufficient."
		if destination.cargo>0 and destination.goodId!=market.goodName
			return "Cargo store contains another commodity."
		market.reprice()
		market.stock-=quantity
		market.money+=charge
		destination.cargo+=quantity
		destination.goodId=market.goodName
		destination.money-=charge
		carriedCost+=charge
		carriedQuantity+=quantity
		carriedOrigin=market.id
		mark(transactionId)
		return "Bought "+quantity.toString()+" "+market.goodName+"."
	function sell(string transactionId,RuntimeMarket market,TradeStore source,int quantity,int difficultyPermille) returns string
		if seen(transactionId)
			return "Transaction already processed."
		if quantity<=0 or source.cargo<quantity
			return "Cargo is insufficient."
		if source.goodId!=market.goodName
			return "Cargo commodity does not match this market."
		if not market.discovered
			return "Commodity is not discovered."
		if market.blockaded or market.occupiedByHostile
			return "Market access is restricted."
		let proceeds=market.currentSellUnitPrice()*quantity
		if market.money<proceeds
			return "Market funds are insufficient."
		market.reprice()
		var cost=0
		if carriedQuantity>=quantity
			cost=carriedCost*quantity div carriedQuantity
			carriedCost-=cost
			carriedQuantity-=quantity
		market.stock+=quantity
		market.money-=proceeds
		source.cargo-=quantity
		if source.cargo==0
			source.goodId=""
		source.money+=proceeds
		let profit=proceeds-cost
		progress.realizedProfit+=profit
		if cost>0 and profit>0 and carriedOrigin!="" and carriedOrigin!=market.id
			let divisor=1000+progress.completedRouteCount*500
			progress.standing+=profit*difficultyPermille div divisor
			progress.completedRouteCount++
		mark(transactionId)
		return "Sold "+quantity.toString()+" "+market.goodName+"; realized P/L "+profit.toString()+"."
	function moveCargo(string transactionId,TradeStore source,TradeStore destination,int quantity) returns string
		if seen(transactionId)
			return "Transaction already processed."
		if quantity<=0 or source.cargo<quantity
			return "Cargo is insufficient."
		if destination.freeCapacity()<quantity
			return "Cargo capacity is insufficient."
		if destination.cargo>0 and destination.goodId!=source.goodId
			return "Cargo store contains another commodity."
		source.cargo-=quantity
		destination.cargo+=quantity
		destination.goodId=source.goodId
		if source.cargo==0
			source.goodId=""
		mark(transactionId)
		return "Cargo moved."

public interface TradePresentation
	function showMarket(player viewer,string marketId,string rows)
	function showTradeResult(player viewer,string message)

public class WarcraftTradePresentation implements TradePresentation
	override function showMarket(player viewer,string marketId,string rows)
		DisplayTimedTextToPlayer(viewer,0.,0.,15.,"Market: "+marketId+"\n"+rows)
	override function showTradeResult(player viewer,string message)
		DisplayTimedTextToPlayer(viewer,0.,0.,10.,message)

/** Adapter entry points used by settlement interaction frames and integration tests. */
public function inspectMarket(player viewer,RuntimeMarket market,TradePresentation presentation)
	presentation.showMarket(viewer,market.id,market.inspect())
public function buyCargo(player viewer,string transactionId,RuntimeMarket market,TradeStore store,int quantity,PlayableTradeController controller,TradePresentation presentation)
	presentation.showTradeResult(viewer,controller.buy(transactionId,market,store,quantity))
public function sellCargo(player viewer,string transactionId,RuntimeMarket market,TradeStore store,int quantity,int difficultyPermille,PlayableTradeController controller,TradePresentation presentation)
	presentation.showTradeResult(viewer,controller.sell(transactionId,market,store,quantity,difficultyPermille))

function tradeField(string document,int wanted) returns string
	var start=0
	var field=0
	for i=0 to StringLength(document)
		if i==StringLength(document) or SubString(document,i,i+1)==":"
			if field==wanted
				return SubString(document,start,i)
			field++
			start=i+1
	return ""

function compactField(string document,int wanted) returns string
	var start=0
	var field=0
	for i=0 to StringLength(document)
		if i==StringLength(document) or SubString(document,i,i+1)==","
			if field==wanted
				return SubString(document,start,i)
			field++
			start=i+1
	return ""

/** Store IDs use a kind:id form. Keep that colon out of the legacy
 * colon-delimited campaign extension document. Authored IDs are restricted to
 * identifier characters, so semicolon is an unambiguous on-save substitute. */
function tradeSafeId(string value) returns string
	var result=""
	for i=0 to StringLength(value)-1
		let character=SubString(value,i,i+1)
		if character==":"
			result+=";"
		else
			result+=character
	return result

/** Authoritative stable-ID trade domain. Frames and command text only project it. */
function tradeFieldCount(string document,string separator) returns int
	var count=1
	for i=0 to StringLength(document)-1
		if SubString(document,i,i+1)==separator
			count++
	return count

function tradeInteger(string value) returns boolean
	return value!="" and S2I(value).toString()==value

public class PlayableTradeRuntime implements CampaignRuntimeExtension
	MerchantProgress progress = new MerchantProgress()
	PlayableTradeController controller = new PlayableTradeController(progress)
	RuntimeMarket market = new RuntimeMarket("unconfigured","",0,0,1,1)
	TradeStore hold = new TradeStore("player_ship_hold",30,1000)
	RuntimeMarket array[8192] markets
	TradeStore array[1024] stores
	int marketCount=0
	int storeCount=0
	string settlementId = "starting_settlement"
	int nextTransaction = 1
	string rollbackState = ""
	RuntimeMarket rollbackMarket = null
	TradeStore rollbackHold = null
	string rollbackMarketId = ""
	override function beginLoad()
		rollbackState=capture()
		rollbackMarket=market
		rollbackMarketId=market.id
		rollbackHold=hold
	override function rollbackLoad()
		market=rollbackMarket
		hold=rollbackHold
		applyState(rollbackState)
		market=rollbackMarket
		market.id=rollbackMarketId
		hold=rollbackHold
		commitLoad()
	override function commitLoad()
		rollbackState=""
		rollbackMarket=null
		rollbackHold=null
	function registerMarket(RuntimeMarket value)
		markets[marketCount]=value
		marketCount++
		if value.id==settlementId and market.id==settlementId
			market=value
	function registerMarketProfile(string marketId,string goodId,int stock,int liquidity,int basePrice,int production,int consumption,int shortage)
		let value=new RuntimeMarket(marketId,goodId,stock,liquidity,basePrice,IMaxBJ(1,basePrice*920 div 1000))
		value.productionPermille=production
		value.consumptionPermille=consumption
		value.shortagePermille=shortage
		registerMarket(value)
	function registerStore(TradeStore value)
		stores[storeCount]=value
		storeCount++
		if hold.id=="player_ship_hold" or value.id==hold.id
			hold=value
	function selectMarket(string marketId,string goodId) returns boolean
		for i=0 to marketCount-1
			if markets[i].id==marketId and markets[i].goodName==goodId
				settlementId=marketId
				market=markets[i]
				return true
		return false
	function applyMarketModifiers(string marketId,int shortage,boolean blockade,boolean occupation,int eventModifier,int technologyModifier,int production,int consumption)
		for i=0 to marketCount-1
			if markets[i].id==marketId
				markets[i].shortagePermille=shortage
				markets[i].blockaded=blockade
				markets[i].occupiedByHostile=occupation
				markets[i].eventPermille=eventModifier
				markets[i].technologyPermille=technologyModifier
				markets[i].productionPermille=production
				markets[i].consumptionPermille=consumption
				markets[i].reprice()
	function advanceEconomy()
		for i=0 to marketCount-1
			let delta=markets[i].targetStock*(markets[i].productionPermille-markets[i].consumptionPermille) div 10000
			markets[i].stock=IMaxBJ(0,markets[i].stock+delta)
			markets[i].reprice()
	override function newCampaign(string startingSettlementId)
		progress = new MerchantProgress()
		controller = new PlayableTradeController(progress)
		settlementId = startingSettlementId
		var selected=false
		for i=0 to marketCount-1
			if markets[i].id==startingSettlementId and not selected
				market=markets[i]
				selected=true
		if not selected and marketCount==0
			// Test/reusable scenarios may omit generated economy data. Release
			// packaging rejects this condition for Age of Sail.
			market=new RuntimeMarket(startingSettlementId,"Test cargo",100,10000,10,8)
		var selectedStore=false
		for i=0 to storeCount-1
			if stores[i].id.indexOf(startingSettlementId)>=0 and not selectedStore
				hold=stores[i]
				selectedStore=true
		if not selectedStore and storeCount>0
			hold=stores[0]
		nextTransaction = 1
	override function capture() returns string
		var history=""
		for i=0 to controller.processedCount-1
			if i>0
				history+=","
			history+=controller.processed[i]
		var marketState=""
		for i=0 to marketCount-1
			if i>0
				marketState+="~"
			var blockade="0"
			var occupation="0"
			if markets[i].blockaded
				blockade="1"
			if markets[i].occupiedByHostile
				occupation="1"
			marketState+=markets[i].id+","+markets[i].goodName+","+markets[i].stock.toString()+","+markets[i].money.toString()+","+markets[i].buyUnitPrice.toString()+","+markets[i].sellUnitPrice.toString()+","+markets[i].shortagePermille.toString()+","+markets[i].eventPermille.toString()+","+markets[i].technologyPermille.toString()+","+blockade+","+occupation+","+markets[i].productionPermille.toString()+","+markets[i].consumptionPermille.toString()+","+markets[i].previousUnitPrice.toString()
		var storeState=""
		for i=0 to storeCount-1
			if i>0
				storeState+="~"
			storeState+=tradeSafeId(stores[i].id)+","+stores[i].cargo.toString()+","+stores[i].money.toString()+","+stores[i].capacity.toString()+","+stores[i].goodId
		return settlementId+":"+market.stock.toString()+":"+market.money.toString()+":"+market.buyUnitPrice.toString()+":"+market.sellUnitPrice.toString()+":"+market.previousUnitPrice.toString()+":"+hold.cargo.toString()+":"+hold.money.toString()+":"+controller.carriedCost.toString()+":"+controller.carriedQuantity.toString()+":"+controller.carriedOrigin+":"+progress.standing.toString()+":"+progress.realizedProfit.toString()+":"+progress.completedRouteCount.toString()+":"+nextTransaction.toString()+":"+history+":"+marketState+":"+tradeSafeId(hold.id)+":"+hold.capacity.toString()+":"+storeState
	/** Accept the original summary plus the additive market/store encodings.
	 * Parse every record and reference before any stock, resource or view changes. */
	override function validate(string document) returns boolean
		if document==""
			return true
		let fields=tradeFieldCount(document,":")
		if (fields!=16 and fields!=17 and fields!=19 and fields!=20) or tradeField(document,0)==""
			return false
		for i=1 to 14
			if i!=10
				let value=tradeField(document,i)
				if not tradeInteger(value) or (i!=12 and S2I(value)<0)
					return false
		if S2I(tradeField(document,3))<1 or S2I(tradeField(document,4))<1 or S2I(tradeField(document,14))<1
			return false
		let history=tradeField(document,15)
		if history!="" and (tradeFieldCount(history,",")>4096 or history.startsWith(",") or history.endsWith(",") or history.indexOf(",,")>=0)
			return false
		boolean array[8192] seenMarkets
		let states=tradeField(document,16)
		var start=0
		while start<StringLength(states)
			var finish=SubString(states,start,StringLength(states)).indexOf("~")
			if finish<0
				finish=StringLength(states)-start
			let row=SubString(states,start,start+finish)
			let columns=tradeFieldCount(row,",")
			if columns!=11 and columns!=14
				return false
			var found=-1
			for i=0 to marketCount-1
				if markets[i].id==compactField(row,0) and markets[i].goodName==compactField(row,1)
					found=i
			if found<0 or seenMarkets[found]
				return false
			seenMarkets[found]=true
			for i=2 to columns-1
				let value=compactField(row,i)
				if not tradeInteger(value) or (i!=6 and i!=7 and i!=8 and S2I(value)<0)
					return false
			if S2I(compactField(row,4))<1 or S2I(compactField(row,5))<1 or S2I(compactField(row,9))>1 or S2I(compactField(row,10))>1
				return false
			start+=finish+1
		let savedHold=tradeField(document,17)
		if savedHold!=""
			var found=tradeSafeId(hold.id)==savedHold
			for i=0 to storeCount-1
				found=found or tradeSafeId(stores[i].id)==savedHold
			if not found or not tradeInteger(tradeField(document,18)) or S2I(tradeField(document,18))<S2I(tradeField(document,6))
				return false
		boolean array[1024] seenStores
		let storesState=tradeField(document,19)
		start=0
		while start<StringLength(storesState)
			var finish=SubString(storesState,start,StringLength(storesState)).indexOf("~")
			if finish<0
				finish=StringLength(storesState)-start
			let row=SubString(storesState,start,start+finish)
			if tradeFieldCount(row,",")!=5
				return false
			var found=-1
			for i=0 to storeCount-1
				if tradeSafeId(stores[i].id)==compactField(row,0)
					found=i
			if found<0 or seenStores[found]
				return false
			seenStores[found]=true
			for i=1 to 3
				if not tradeInteger(compactField(row,i)) or S2I(compactField(row,i))<0
					return false
			if S2I(compactField(row,1))>S2I(compactField(row,3))
				return false
			start+=finish+1
		return true
	override function reconstruct(string document) returns boolean
		if not validate(document)
			return false
		return applyState(document)
	function applyState(string document) returns boolean
		if document==""
			return true
		let restoredSettlement=tradeField(document,0)
		if restoredSettlement==""
			return false
		// Resolve stable projections before applying legacy summary fields. The
		// current view may point at a different market/store after reconstruction.
		var foundMarket=false
		for i=0 to marketCount-1
			if markets[i].id==restoredSettlement
				market=markets[i]
				foundMarket=true
		// Legacy summary-only saves and settlements without a configured market
		// use an isolated fallback, never rename an unrelated live market.
		if not foundMarket
			market=new RuntimeMarket(restoredSettlement,"",0,0,1,1)
		let savedHoldId=tradeField(document,17)
		if savedHoldId!=""
			for i=0 to storeCount-1
				if tradeSafeId(stores[i].id)==savedHoldId
					hold=stores[i]
		settlementId=restoredSettlement
		market.id=restoredSettlement
		market.stock=S2I(tradeField(document,1))
		market.money=S2I(tradeField(document,2))
		market.buyUnitPrice=S2I(tradeField(document,3))
		market.sellUnitPrice=S2I(tradeField(document,4))
		market.previousUnitPrice=S2I(tradeField(document,5))
		hold.cargo=S2I(tradeField(document,6))
		hold.money=S2I(tradeField(document,7))
		controller.carriedCost=S2I(tradeField(document,8))
		controller.carriedQuantity=S2I(tradeField(document,9))
		controller.carriedOrigin=tradeField(document,10)
		progress.standing=S2I(tradeField(document,11))
		progress.realizedProfit=S2I(tradeField(document,12))
		progress.completedRouteCount=S2I(tradeField(document,13))
		nextTransaction=S2I(tradeField(document,14))
		controller.processedCount=0
		let history=tradeField(document,15)
		var start=0
		for i=0 to StringLength(history)
			if i==StringLength(history) or SubString(history,i,i+1)==","
				if i>start
					controller.processed[controller.processedCount]=SubString(history,start,i)
					controller.processedCount++
				start=i+1
		let states=tradeField(document,16)
		var recordStart=0
		for i=0 to StringLength(states)
			if i==StringLength(states) or SubString(states,i,i+1)=="~"
				let record=SubString(states,recordStart,i)
				for j=0 to marketCount-1
					if markets[j].id==compactField(record,0) and markets[j].goodName==compactField(record,1)
						markets[j].stock=S2I(compactField(record,2))
						markets[j].money=S2I(compactField(record,3))
						markets[j].buyUnitPrice=S2I(compactField(record,4))
						markets[j].sellUnitPrice=S2I(compactField(record,5))
						markets[j].shortagePermille=S2I(compactField(record,6))
						markets[j].eventPermille=S2I(compactField(record,7))
						markets[j].technologyPermille=S2I(compactField(record,8))
						markets[j].blockaded=compactField(record,9)=="1"
						markets[j].occupiedByHostile=compactField(record,10)=="1"
						// Fields 11-13 were added after the first live-trade save
						// format. Empty values retain generated defaults.
						if compactField(record,11)!=""
							markets[j].productionPermille=S2I(compactField(record,11))
						if compactField(record,12)!=""
							markets[j].consumptionPermille=S2I(compactField(record,12))
						if compactField(record,13)!=""
							markets[j].previousUnitPrice=S2I(compactField(record,13))
				recordStart=i+1
		if savedHoldId!=""
			hold.capacity=S2I(tradeField(document,18))
		let savedStores=tradeField(document,19)
		recordStart=0
		for i=0 to StringLength(savedStores)
			if i==StringLength(savedStores) or SubString(savedStores,i,i+1)=="~"
				let record=SubString(savedStores,recordStart,i)
				for j=0 to storeCount-1
					if tradeSafeId(stores[j].id)==compactField(record,0)
						stores[j].cargo=S2I(compactField(record,1))
						stores[j].money=S2I(compactField(record,2))
						stores[j].capacity=S2I(compactField(record,3))
						stores[j].goodId=compactField(record,4)
				recordStart=i+1
		for i=0 to marketCount-1
			if markets[i].id==restoredSettlement
				market=markets[i]
				return true
		return true
	function transactionId(string side) returns string
		let result="runtime-"+side+"-"+nextTransaction.toString()
		nextTransaction++
		return result

public class TradeCommand implements CommandHandler
	PlayableTradeRuntime runtime
	TradePresentation presentation
	construct(PlayableTradeRuntime runtime,TradePresentation presentation)
		this.runtime=runtime
		this.presentation=presentation
	override function execute(player sender,string arguments)
		let cut=arguments.indexOf(" ")
		var action=arguments
		var quantity=0
		if cut>=0
			action=SubString(arguments,0,cut)
			quantity=S2I(SubString(arguments,cut+1,StringLength(arguments)))
		if action=="inspect" or action=="open"
			inspectMarket(sender,runtime.market,presentation)
		else if action=="buy"
			buyCargo(sender,runtime.transactionId("buy"),runtime.market,runtime.hold,quantity,runtime.controller,presentation)
		else if action=="sell"
			sellCargo(sender,runtime.transactionId("sell"),runtime.market,runtime.hold,quantity,1000,runtime.controller,presentation)
		else
			presentation.showTradeResult(sender,"Use /trade inspect, /trade buy QUANTITY, or /trade sell QUANTITY.")

public PlayableTradeRuntime playableTradeRuntime = null

/** Registers the reachable settlement market for new games, resumed maps and loads. */
public function registerPlayableTrade(CommandRegistry commands,PlayableCampaignServices campaign) returns PlayableTradeRuntime
	playableTradeRuntime = campaign.extension castTo PlayableTradeRuntime
	commands.register("trade","market","trade <inspect|buy QUANTITY|sell QUANTITY>","Open the current settlement commodity market.","Inspect current authoritative quotes and atomically buy or sell cargo in an eligible ship hold.",1,2,COMMAND_RELEASE,new TradeCommand(playableTradeRuntime,new WarcraftTradePresentation()))
	return playableTradeRuntime
