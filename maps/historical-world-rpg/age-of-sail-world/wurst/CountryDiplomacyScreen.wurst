package CountryDiplomacyScreen

import CommandRouter

/** Warcraft projection of authoritative player diplomacy. No handles are saved. */
public interface CountryDiplomacyPresentation
	function showCountry(string polityId, string summary, string interactions)
	function showPeace(string offerId, string terms, string explanation)
	function showResult(string message)

public interface CountryDiplomacyAuthority
	function isKnown(string polityId) returns boolean
	function countrySummary(string polityId) returns string
	function availableInteractions(string polityId) returns string
	function activeConflictWith(string polityId) returns string
	function validateOffer(string conflictId, string recipientPolityId, string terms) returns string
	function createOffer(string conflictId, string recipientPolityId, string terms) returns string
	function respondToOffer(string offerId, boolean accept, boolean confirmed) returns string
	function requestGovernmentReward(string polityId, string rewardId) returns string

public class WarcraftCountryDiplomacyPresentation implements CountryDiplomacyPresentation
	override function showCountry(string polityId, string summary, string interactions)
		DisplayTimedTextToPlayer(Player(0), 0., 0., 30., "Country: " + polityId + "\n" + summary + "\nAvailable: " + interactions + "\nUse /peace POLITY TERMS to negotiate.")
	override function showPeace(string offerId, string terms, string explanation)
		DisplayTimedTextToPlayer(Player(0), 0., 0., 30., "Peace offer " + offerId + "\n" + terms + "\n" + explanation)
	override function showResult(string message)
		DisplayTimedTextToPlayer(Player(0), 0., 0., 15., message)

public class CountryDiplomacyController
	CountryDiplomacyAuthority authority
	CountryDiplomacyPresentation presentation
	construct(CountryDiplomacyAuthority authority, CountryDiplomacyPresentation presentation)
		this.authority = authority
		this.presentation = presentation
	function openFromKnownCountry(string polityId) returns boolean
		if polityId == "" or not authority.isKnown(polityId)
			presentation.showResult("You have not discovered enough about that country.")
			return false
		presentation.showCountry(polityId, authority.countrySummary(polityId), authority.availableInteractions(polityId))
		return true
	function openFromRuler(string polityId) returns boolean
		return openFromKnownCountry(polityId)
	function openFromMapContext(string polityId) returns boolean
		return openFromKnownCountry(polityId)
	function openFromQuest(string polityId) returns boolean
		return openFromKnownCountry(polityId)
	function propose(string recipientPolityId, string terms) returns boolean
		if not authority.isKnown(recipientPolityId)
			presentation.showResult("You cannot negotiate with an undiscovered government.")
			return false
		let conflictId = authority.activeConflictWith(recipientPolityId)
		if conflictId == ""
			presentation.showResult("There is no active war to settle.")
			return false
		let problem = authority.validateOffer(conflictId, recipientPolityId, terms)
		if problem != ""
			presentation.showResult(problem)
			return false
		let offerId = authority.createOffer(conflictId, recipientPolityId, terms)
		presentation.showPeace(offerId, terms, "The other government will answer from the present campaign state.")
		return true
	function respond(string offerId, boolean accept, boolean confirmed) returns boolean
		let result = authority.respondToOffer(offerId, accept, confirmed)
		presentation.showResult(result)
		return result != ""
	function requestReward(string polityId, string rewardId) returns boolean
		if polityId == "" or not authority.isKnown(polityId)
			presentation.showResult("You cannot request a reward from an undiscovered government.")
			return false
		let result = authority.requestGovernmentReward(polityId, rewardId)
		presentation.showResult(result)
		return result.startsWith("Reward granted:")

function splitDiplomacyArgument(string arguments) returns int
	for i = 0 to StringLength(arguments) - 1
		if SubString(arguments, i, i + 1) == " "
			return i
	return -1

public class CountryCommandHandler implements CommandHandler
	CountryDiplomacyController controller
	construct(CountryDiplomacyController controller)
		this.controller = controller
	override function execute(player sender, string arguments)
		controller.openFromKnownCountry(arguments)

public class PeaceCommandHandler implements CommandHandler
	CountryDiplomacyController controller
	construct(CountryDiplomacyController controller)
		this.controller = controller
	override function execute(player sender, string arguments)
		let cut = splitDiplomacyArgument(arguments)
		if cut < 0
			controller.propose(arguments, "")
		else
			controller.propose(SubString(arguments, 0, cut), SubString(arguments, cut + 1, StringLength(arguments)))

public class GovernmentRewardCommandHandler implements CommandHandler
	CountryDiplomacyController controller
	construct(CountryDiplomacyController controller)
		this.controller = controller
	override function execute(player sender, string arguments)
		let cut = splitDiplomacyArgument(arguments)
		if cut < 0
			controller.requestReward(arguments, "")
		else
			controller.requestReward(SubString(arguments, 0, cut), SubString(arguments, cut + 1, StringLength(arguments)))

public function registerCountryDiplomacyCommands(CommandRegistry commands, CountryDiplomacyController controller)
	commands.register("country", "polity,diplomacy", "country POLITY", "Open a known country's interaction screen.", "Shows discovered relations, allegiance, history, standing, government, wars, partners, occupations, and available interactions.", 1, 1, COMMAND_RELEASE, new CountryCommandHandler(controller))
	commands.register("peace", "negotiate", "peace POLITY TERMS", "Propose explicit peace terms.", "Opens validated negotiations with a known wartime government. Irreversible terms require confirmation.", 2, 99, COMMAND_RELEASE, new PeaceCommandHandler(controller))
	commands.register("reward", "government-reward", "reward POLITY REWARD", "Request an earned government reward.", "Validates origin, current allegiance, standing, contribution history, the polity reward profile, and current polity resources before one atomic grant.", 2, 2, COMMAND_RELEASE, new GovernmentRewardCommandHandler(controller))
