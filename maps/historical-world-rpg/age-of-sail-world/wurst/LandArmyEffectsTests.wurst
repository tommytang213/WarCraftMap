@test function landUnfundedRenewalAndCapturedWorkCannotCreateFreeArtillery()
	let f = new LandFixture()
	f.runtime.act("player", "commission", "district", "").contains("technology").assertTrue()
	f.allResearch()
	f.action("policy")
	f.advance(90)
	f.action("commission")
	let balance = f.campaign.countries.treasury[0]
	let stock = f.trade.findMarket("district", "arms").stock
	f.runtime.act("player", "commission", "district", "").contains("free production queue").assertTrue()
	f.campaign.countries.treasury[0].assertEquals(balance)
	f.trade.findMarket("district", "arms").stock.assertEquals(stock)
	f.advance(100)
	f.military.setWar("player", "ai", true)
	f.military.capture("district", "ai", 0.).assertTrue()
	f.arsenal().work.assertEquals(0)
	f.arsenal().projectOwner.assertEquals("")
	f.advance(200)
	f.military.forceIndex("artillery:district:1").assertEquals(-1)
	let renewal = new LandFixture()
	renewal.allResearch()
	renewal.action("policy")
	renewal.advance(450)
	renewal.action("commission")
	renewal.campaign.countries.treasury[0] = 0
	renewal.advance(455)
	renewal.arsenal().owner.assertEquals("")
	renewal.runtime.officeActive(renewal.arsenal(), renewal.day + 455).assertFalse()
	renewal.campaign.countries.treasury[0].assertEquals(0)
	renewal.arsenal().work.assertEquals(54000) // Five already funded intervals.
	renewal.advance(456)
	renewal.arsenal().work.assertEquals(64000) // Unpaid renewal adds only normal work.
	landReloadMillis(1, 500).assertEquals(1)
	landReloadMillis(2147483647, 500).assertEquals(2045222520)

@test function combinedLandAndScienceRecordsRoundTripAndMigrateMainVersion12()
	let f = new LandFixture()
	f.allResearch()
	f.action("policy")
	f.advance(90)
	f.action("commission")
	let musket = f.add("musket", "european_musket_battalion", "player")
	musket.nextFireAt = 1.285
	f.military.science.register(new ScienceSite("study", "district", "", "research_generation_efficiency", "printing", "cloth", 0, 10, 1, 7, 1, 1, 9000, 100, 0, 0, 5, 2))
	let science = f.military.science.states[0]
	science.equipmentOwner = "player"
	science.equipmentReady = f.day
	science.owner = "player"
	science.target = "printing"
	science.paid = 100
	science.lastDay = f.day + 90
	science.work = 123
	science.remainder = 17
	let scienceState = science.record()
	let scienceRecord = "|j,study," + scienceState
	let fireRecord = "|h,musket," + clockReal(1.285)
	let saved = f.military.snapshot()
	saved.startsWith("v20|").assertTrue()
	saved.contains(fireRecord).assertTrue()
	saved.contains(scienceRecord).assertTrue()
	f.military.restore(saved, false).assertTrue()
	f.military.snapshot().assertEquals(saved)
	f.military.restore(saved + fireRecord, false).assertFalse()
	f.military.restore(saved + scienceRecord, false).assertFalse()
	f.military.restore(saved.replace(scienceRecord, ""), false).assertFalse()
	f.military.snapshot().assertEquals(saved)
	// Main's v12 has science records, but no arsenal or firearm deadlines.
	var legacy = "v12" + SubString(saved, saved.indexOf("|"), saved.indexOf("|l,")) + scienceRecord
	legacy = legacy.replace(fireRecord, "")
	f.military.restore(legacy, false).assertTrue()
	f.military.science.states[0].record().assertEquals(scienceState)
	f.arsenal().owner.assertEquals("")
	f.arsenal().projectOwner.assertEquals("")
	f.military.forces[f.military.forceIndex("musket")].nextFireAt.assertEquals(0.)
	f.military.restore(legacy.replace(scienceRecord, ""), false).assertFalse()
	f.military.restore(saved, false).assertTrue()
	f.military.transferSettlement("district", "ai")
	f.arsenal().owner.assertEquals("")
	f.arsenal().projectOwner.assertEquals("")
	f.military.science.states[0].owner.assertEquals("")
	f.military.science.states[0].equipmentOwner.assertEquals("ai")

// Execute the shipping adapter; replace only the two unsupported native calls.
class LandCooldownAdapter extends WarcraftMilitarySettlementAdapter
	int lastLife = 0
	real cooldown = 1.35
	int writes = 0
	override function maximumLife(unit target) returns int
		return 100
	override function setMaximumLife(unit target, int value)
		lastLife = value
	override function attackCooldown(unit target) returns real
		return 1.35
	override function setAttackCooldown(unit target, real seconds)
		cooldown = seconds
		writes++

@test function landReloadMatchedControlUsesAbstractDeadlinesAndNativeCooldown()
	let f = new LandFixture()
	f.prerequisites()
	let cooldownPort = new LandCooldownAdapter()
	f.military.adapter = cooldownPort
	let musket = f.add("musket", "european_musket_battalion", "player")
	let target = f.add("target", "field_artillery_battery", "ai")
	f.military.activateRegion("europe")
	f.military.setWar("player", "ai", true)
	cooldownPort.cooldown.assertEquals(1.35)
	let control = new CombatHit("firearm_volley", new ExactRational("100", "1", "1"))
	f.military.applyCombatHit(control, f.military.forceIndex("musket"), f.military.forceIndex("target"), "player", "ai", true)
	control.damage.display().assertEquals("100")
	musket.nextFireAt.assertEquals(1.35)
	f.unlock("arquebus_volley_drill")
	cooldownPort.cooldown.assertEquals(1.285)
	f.military.firearmReloadMillis(musket, 2100).assertEquals(2000)
	for repeat = 1 to 3
		f.rpg.reconcile("player")
		cooldownPort.cooldown.assertEquals(1.285)
	// A source replacement removes just the reload contribution.
	f.research.replaceResearchEntitlements(new ResearchEntitlements("player"))
	cooldownPort.cooldown.assertEquals(1.35)
	f.rpg.reconcile("player")
	cooldownPort.cooldown.assertEquals(1.285)
	f.military.gameplaySeconds = 1.35
	let drilled = new CombatHit("firearm_volley", new ExactRational("100", "1", "1"))
	f.military.applyCombatHit(drilled, f.military.forceIndex("musket"), f.military.forceIndex("target"), "player", "ai", true)
	drilled.damage.display().assertEquals("100") // Drill is frequency, not volley damage.
	musket.nextFireAt.assertEquals(2.635)
	f.military.applyCombatHit(drilled, f.military.forceIndex("musket"), f.military.forceIndex("target"), "player", "ai", true)
	musket.nextFireAt.assertEquals(2.635)
	let saved = f.military.snapshot()
	f.military.restore(saved, false).assertTrue()
	cooldownPort.cooldown.assertEquals(1.285)
	let restored = f.military.forces[f.military.forceIndex("musket")]
	restored.nextFireAt.assertEquals(2.635)
	// Wrong equipment restores the native baseline, even with research retained.
	restored.combatProfileId = "sabre_cavalry"
	f.military.refreshLandReload()
	cooldownPort.cooldown.assertEquals(1.35)
	f.military.firearmReloadMillis(restored, 2100).assertEquals(2100)
	restored.combatProfileId = "european_musket_battalion"
	f.military.refreshLandReload()
	cooldownPort.cooldown.assertEquals(1.285)
	configureGeneratedMilitaryTraditions(f.military, true).assertTrue()
	f.military.awardTradition("player", "land_formation", "9007199254740993")
	let before = f.military.resolveTradition(restored)
	f.rpg.reconcile("player")
	f.military.awardTradition("player", "land_formation", "1")
	let after = f.military.resolveTradition(restored)
	before.modifier("attack_basis_points").display().assertEquals("9007199254740993/10")
	after.modifier("attack_basis_points").display().assertEquals("4503599627370497/5")
	cooldownPort.cooldown.assertEquals(1.285)
	destroy before
	destroy after

@test function landOfficeMatchedControlRequiresEnactmentSurchargeAndRealWork()
	let funded = new LandFixture()
	let control = new LandFixture()
	funded.allResearch()
	control.allResearch()
	// Research alone never enacts policy or pays for procurement.
	funded.runtime.officeActive(funded.arsenal(), funded.day).assertFalse()
	funded.action("policy")
	funded.advance(90)
	control.advance(90)
	funded.action("commission")
	control.action("commission")
	funded.campaign.countries.treasury[0].assertEquals(9562)
	control.campaign.countries.treasury[0].assertEquals(9720)
	funded.trade.findMarket("district", "arms").stock.assertEquals(970)
	control.trade.findMarket("district", "arms").stock.assertEquals(970)
	funded.military.settlements[0].manpower.assertEquals(970)
	control.military.settlements[0].manpower.assertEquals(970)
	funded.military.settlements[0].supply.assertEquals(970)
	control.military.settlements[0].supply.assertEquals(970)
	funded.advance(173)
	control.advance(173)
	funded.arsenal().work.assertEquals(896400) // 83 * (10000 + 800).
	control.arsenal().work.assertEquals(830000)
	funded.advance(174)
	control.advance(174)
	(funded.military.forceIndex("artillery:district:1") >= 0).assertTrue()
	control.military.forceIndex("artillery:district:1").assertEquals(-1)
	control.advance(180)
	(control.military.forceIndex("artillery:district:1") >= 0).assertTrue()
	// Repeated clock delivery does not create another battery or charge again.
	let balance = funded.campaign.countries.treasury[0]
	funded.runtime.advance(funded.day + 174)
	funded.military.forceCount.assertEquals(2)
	funded.campaign.countries.treasury[0].assertEquals(balance)

@test function landTrainMatchedControlDelivers77Versus75From100ActualStock()
	let trained = new LandFixture()
	let control = new LandFixture()
	trained.prerequisites()
	control.prerequisites()
	trained.unlock("artillery_train")
	let guns = trained.add("guns", "field_artillery_battery", "player")
	let ordinary = control.add("guns", "field_artillery_battery", "player")
	trained.commands.dispatch(Player(0), "/land supply district guns").assertTrue()
	control.commands.dispatch(Player(0), "/land supply district guns").assertTrue()
	trained.resources.output.startsWith("Land army action completed.").assertTrue()
	control.resources.output.startsWith("Land army action completed.").assertTrue()
	guns.supply.assertEquals(177)
	ordinary.supply.assertEquals(175)
	trained.trade.findMarket("district", "arms").stock.assertEquals(900)
	control.trade.findMarket("district", "arms").stock.assertEquals(900)
	// Every further delivery withdraws a complete shipment; depleted stock rejects.
	trained.trade.findMarket("district", "arms").stock = 99
	trained.runtime.act("player", "supply", "district", "guns").contains("Insufficient").assertTrue()
	guns.supply.assertEquals(177)
	trained.trade.findMarket("district", "arms").stock.assertEquals(99)
	trained.trade.findMarket("district", "arms").stock = 100
	trained.trade.findMarket("district", "arms").occupiedByHostile = true
	trained.runtime.act("player", "supply", "district", "guns").contains("accessible").assertTrue()
	guns.supply.assertEquals(177)

/** Fresh receipts exercise the production rating boundary, with no native unit
 * dependency. The same force records are used while represented and abstract. */
function bayonetDamage(LandFixture f, string attacker, string target, string attackId, boolean weapon) returns string
	let hit = new CombatHit(attackId, new ExactRational("108", "1", "1"))
	let source = f.military.forces[f.military.forceIndex(attacker)]
	let recipient = f.military.forces[f.military.forceIndex(target)]
	f.military.applyCombatHit(hit, f.military.forceIndex(attacker), f.military.forceIndex(target), source.controllerId, recipient.controllerId, weapon)
	let result = hit.damage.display()
	f.military.applyCombatHit(hit, f.military.forceIndex(attacker), f.military.forceIndex(target), source.controllerId, recipient.controllerId, weapon)
	hit.damage.display().assertEquals(result)
	destroy hit
	return result

@test function landBayonetMatchedControlRequiresResearchEquipmentAndHostileCavalry()
	let f = new LandFixture()
	f.prerequisites()
	let foot = f.add("foot", "european_late_line_infantry", "player")
	f.add("horse", "sabre_cavalry", "ai")
	f.military.setWar("player", "ai", true)
	f.military.activateRegion("europe")
	f.military.landKit(foot).bayonet.assertTrue()
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	let before = f.military.snapshot()
	let balance = f.resources.balance
	f.unlock("bayonet_system")
	f.resources.balance.assertEquals(balance - 288)
	f.military.snapshot().assertEquals(before) // Research grants no force or kit.
	f.research.rate("player", "anti_cavalry_melee_defense").assertEquals(800)
	for repeat = 1 to 3
		f.rpg.technologies.reconstructAll()
		f.military.instantiate(foot)
		bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")
	f.military.activateRegion("africa")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")
	f.research.replaceResearchEntitlements(new ResearchEntitlements("player"))
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	f.rpg.reconcile("player")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")
	f.military.setWar("player", "ai", false)
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")

@test function landBayonetRejectsIneligibleRosterWeaponsEraAndControllers()
	let f = new LandFixture()
	f.prerequisites()
	f.unlock("bayonet_system")
	let foot = f.add("foot", "european_late_line_infantry", "player")
	let horse = f.add("horse", "sabre_cavalry", "ai")
	f.add("musket", "european_musket_battalion", "player")
	f.military.setWar("player", "ai", true)
	bayonetDamage(f, "horse", "musket", "land_cavalry_melee", true).assertEquals("108")
	string array[6] attacks
	attacks[0] = "melee" // Swords.
	attacks[1] = "bow"
	attacks[2] = "firearm_volley"
	attacks[3] = "land_firearm"
	attacks[4] = "siege"
	attacks[5] = "spell"
	for i = 0 to 5
		bayonetDamage(f, "horse", "foot", attacks[i], true).assertEquals("108")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", false).assertEquals("108")
	horse.combatProfileId = "european_musket_battalion"
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	horse.combatProfileId = "sabre_cavalry"
	foot.combatProfileId = "unknown_socket_bayonet"
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	foot.combatProfileId = "european_late_line_infantry"
	foot.unitTypeId = 'hkni'
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	foot.unitTypeId = f.military.land.profile(foot.combatProfileId).unitTypeId
	foot.categoryId = "siege"
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	foot.categoryId = "land_formation"
	foot.kind = FORCE_FLEET
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	foot.kind = FORCE_ARMY
	f.military.landYear = 1729
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	f.military.landYear = 1821
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	f.military.landYear = 1778
	let earned = f.rpg.captureState()
	f.rpg.restoreState(earned.replace("|u,player,linear_tactics", "")).assertTrue()
	f.rpg.reconcile("player")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	f.rpg.restoreState(earned).assertTrue()
	f.rpg.reconcile("player")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")
	// AI receives the identical contribution only after its own legal research.
	f.military.transferControl("foot", "ai")
	f.military.transferControl("horse", "player")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	f.resources.owner = "ai"
	f.prerequisites()
	f.unlock("bayonet_system")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")

@test function landBayonetReconstructionMigrationAndNamedSourcesRemainIndependent()
	let f = new LandFixture()
	f.prerequisites()
	f.unlock("bayonet_system")
	f.add("foot", "european_late_line_infantry", "player")
	f.add("horse", "sabre_cavalry", "ai")
	f.military.setWar("player", "ai", true)
	let duplicate = new RuntimeTechnology("duplicate_bayonet", "Duplicate source", 1450, 1)
	duplicate.addUnlock("duplicate_bayonet", "modifier", "progression_bayonet_system")
	f.rpg.technologies.register(duplicate).assertTrue()
	f.rpg.technologies.unlock("player", "duplicate_bayonet", 1778, 1, 0, 0).assertTrue()
	for repeat = 1 to 3
		f.rpg.technologies.reconstructAll()
		f.research.rate("player", "anti_cavalry_melee_defense").assertEquals(800)
		bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")
	let saved = f.military.snapshot()
	f.military.restore(saved, false).assertTrue()
	f.military.snapshot().assertEquals(saved)
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("100")
	// V8 predates equipment identity. Migration must not infer it from rawcodes.
	let legacy = saved.replace("v20|", "v8|").replace("|p,foot,european_late_line_infantry", "").replace("|p,horse,sabre_cavalry", "")
	f.military.restore(legacy, false).assertTrue()
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("108")
	f.military.restore(saved, false).assertTrue()
	configureGeneratedMilitaryTraditions(f.military, true).assertTrue()
	f.military.awardTradition("player", "land_formation", "3000")
	bayonetDamage(f, "horse", "foot", "land_cavalry_melee", true).assertEquals("7200/73") // 800 + 150 defense.
	let layer = f.military.resolveTradition(f.military.forces[f.military.forceIndex("foot")])
	let equipment = new CombatSources()
	equipment.replace("equipment:fixture", "", "discipline", new ExactRational("200", "1", "1"))
	equipment.replace("equipment:fixture", "", "discipline", new ExactRational("200", "1", "1"))
	let hit = new CombatHit("land_cavalry_melee", new ExactRational("108", "1", "1"))
	hit.contextualDefense = f.research.rate("player", "anti_cavalry_melee_defense")
	f.military.combatBindings.apply(hit, true, null, null, layer, null, null, equipment)
	hit.damage.display().assertEquals("21600/223") // One division by 10000 + 800 + 150 + 200.
	f.military.combatBindings.apply(hit, true, null, null, layer, null, null, equipment)
	hit.damage.display().assertEquals("21600/223")
	f.military.awardTradition("player", "land_formation", "9007199254740993")
	f.rpg.reconcile("player")
	f.military.traditions[f.military.traditionIndex("player", "land_formation")].experience.assertEquals("9007199254743993")
	destroy hit
	destroy equipment
	destroy layer
