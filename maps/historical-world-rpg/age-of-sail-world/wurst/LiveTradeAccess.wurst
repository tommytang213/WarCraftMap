package LiveTradeAccess

import initlater PlayableTrade
import PlayableCampaignRuntime
import WarcraftRpgRuntime
import MilitarySettlementRuntime
import PhysicalInteraction
import WC3Compatibility

/** Observe a vessel through the existing military projection registry. Stable
 * force control remains authoritative; a Warcraft owner alone grants nothing. */
public class WarcraftTradeCargoActors implements InteractionActors
	MilitarySettlementRuntime military
	construct(MilitarySettlementRuntime military)
		this.military=military
	function vessel(int actor) returns unit
		if not (military.adapter instanceof WarcraftMilitarySettlementAdapter)
			return null
		let adapter=military.adapter castTo WarcraftMilitarySettlementAdapter
		let found=adapter.indexOf(military.forces[actor].id)
		if found<0
			return null
		return adapter.handles[found]
	override function present(int actor,player owner) returns boolean
		let target=vessel(actor)
		return target!=null and GetUnitTypeId(target)!=0 and GetOwningPlayer(target)==owner and GetWidgetLife(target)>0.405 and not IsUnitType(target,UNIT_TYPE_DEAD) and not IsUnitLoaded(target) and not IsUnitHidden(target)
	override function x(int actor) returns real
		return GetUnitX(vessel(actor))
	override function y(int actor) returns real
		return GetUnitY(vessel(actor))
	override function movement(int actor) returns int
		return compatInteractionMovement(vessel(actor))

/** No remote trade authority is currently implemented. Origin, allegiance,
 * command-region selection and a saved view are never store ownership. */
public class LiveTradeAccess
	PlayableCampaignState state
	InteractionActors cargoActors=null
	construct(PlayableCampaignState state)
		this.state=state
	function settlement(string id) returns SettlementRuntimeState
		if state.militarySettlements==null
			return null
		let index=state.militarySettlements.settlementIndex(id)
		if index<0
			return null
		return state.militarySettlements.settlements[index]
	function control(string id) returns string
		let city=settlement(id)
		if city==null
			return ""
		return city.controllerId+","+city.legalOwnerId+","+city.occupationConflictId+","+city.regionId
	function marketPermitted(RuntimeMarket market) returns boolean
		if market==null or not market.discovered or market.blockaded or market.occupiedByHostile or state.identity==null or not state.identity.hasOrigin()
			return false
		let city=settlement(market.id)
		if city==null or state.rpg==null
			return false
		let point=state.rpg.interactions.get(market.id)
		// Military region labels may describe an administrative instance. Physical
		// chapter placement comes from the materialized interaction catalogue.
		return point!=null and point.kind=="settlement" and not state.militarySettlements.atWar(state.identity.allegianceId(),city.controllerId)
	function marketActor(player sender,RuntimeMarket market) returns int
		if sender!=Player(0) or state.rpg==null or not marketPermitted(market)
			return -1
		return state.rpg.localActor(sender,market.id)
	function commitActor(player sender,RuntimeMarket market,int actor) returns boolean
		return sender==Player(0) and state.rpg!=null and actor>=0 and actor<state.rpg.heroes.count and state.rpg.eligibleActor(actor) and state.rpg.interactions.resolve(actor,sender,market.id)!=null and marketPermitted(market)
	/** Listings use the same boundaries without resolving every catalogue point
	 * through another linear catalogue scan. These observations authorize no commit. */
	function localPoint(player sender,InteractionLocation point) returns boolean
		if sender!=Player(0) or state.rpg==null
			return false
		let context=state.rpg.interactions
		if context.maps==null or context.actors==null or not context.maps.available() or point.mapId!=context.maps.loadedMap() or point.mapId!=context.maps.partyMap()
			return false
		for i=0 to state.rpg.heroes.count-1
			if state.rpg.eligibleActor(i) and context.actors.present(i,sender) and point.contains(context.actors.x(i),context.actors.y(i),context.actors.movement(i))
				return true
		return false
	function storeControl(TradeStore store) returns string
		if store.accessKind=="personal" and store.accessId=="player"
			return "player"
		if store.accessKind=="warehouse"
			return control(store.accessId)
		if store.accessKind=="ship" and state.militarySettlements!=null
			let index=state.militarySettlements.forceIndex(store.accessId)
			if index>=0
				let vesselState=state.militarySettlements.forces[index]
				return vesselState.controllerId+","+vesselState.regionId
		return ""
	function storePermitted(player sender,TradeStore store,string marketId,MerchantProgress progress) returns boolean
		if store==null or state.rpg==null
			return false
		if store.accessKind=="personal"
			return store.accessId=="player"
		if store.accessKind=="warehouse"
			let city=settlement(store.accessId)
			return city!=null and city.id==marketId and ((city.controllerId=="player" and city.legalOwnerId=="player") or (store.warehouseService and progress.warehouseAccess()))
		if store.accessKind!="ship" or state.militarySettlements==null or cargoActors==null
			return false
		let index=state.militarySettlements.forceIndex(store.accessId)
		let point=state.rpg.interactions.get(marketId)
		if index<0 or point==null
			return false
		let vesselState=state.militarySettlements.forces[index]
		if vesselState.kind!=FORCE_FLEET or vesselState.controllerId!="player" or not vesselState.active or vesselState.strength<=0 or vesselState.regionId!=point.mapId or not cargoActors.present(index,sender)
			return false
		// The party interacts ashore while a living owned vessel is alongside.
		// A strategic order or the vessel's saved spawn coordinate is not presence.
		let dx=cargoActors.x(index)-point.x
		let dy=cargoActors.y(index)-point.y
		return dx*dx+dy*dy<=INTERACTION_RANGE*INTERACTION_RANGE
