@test function agriculturalSaveMigrationFailedLoadAndCaptureRetainDurableSources()
	let f=new AgricultureFixture()
	f.allResearch()
	f.allActions()
	f.advance(45)
	let pending=f.trade.capture()
	let pendingClock=f.clock.captureState()
	f.trade.validate(pending).assertTrue()
	f.trade.beginLoad()
	f.advance(365)
	f.trade.rollbackLoad()
	f.clock.restoreState(pendingClock).assertTrue()
	f.trade.capture().assertEquals(pending)
	let checkpoint=f.trade.capture()
	f.trade.reconstruct(checkpoint+"~p,player,missing,enclosure,1,1,1").assertFalse()
	f.trade.capture().assertEquals(checkpoint)
	f.advance(90)
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1200)
	f.city.controllerId="other"
	f.city.legalOwnerId="other"
	f.military.administrators[0].controllerId="other"
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1000)
	f.research.runtime.technologies.unlock("other","agrarian_improvement",1800,100000,0,0).assertFalse()
	// An AI controller uses the same prerequisites, treasury and action rules.
	f.state.identity.changeAllegiance("other").assertTrue()
	let previous=f.research.runtime.captureState()
	f.research.runtime.restoreState(previous+"|u,other,selective_breeding|u,other,scientific_societies").assertTrue()
	f.research.commands.dispatch(Player(0),"/research agrarian_improvement").assertTrue()
	f.research.output.last.assertEquals("Action completed.")
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1200)
	let money=f.state.countries.treasury[1]
	f.farm.enact("other",f.local.id,"granary").assertEquals("Already commissioned or enacted here.")
	f.state.countries.treasury[1].assertEquals(money)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	f.farm.enact("other",f.local.id,"land_tenure_reform").assertEquals("Action completed.")
	// Legacy trade v4 carries no agricultural projects and never grants assets.
	let saved=f.trade.capture()
	let cut=StringLength(saved)-StringLength(AgricultureSnapshot.capture(f.farm))-1
	let legacy="v4:"+SubString(saved,3,cut)
	f.trade.reconstruct(legacy).assertTrue()
	f.local.granaryDue.assertEquals(0)
	f.farm.policyCount.assertEquals(0)
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1000)

@test function agriculturalAbstractReplayMatchesActiveDaysAndDuplicatesNeverStack()
	let active=new AgricultureFixture()
	let inactive=new AgricultureFixture()
	active.allResearch()
	inactive.allResearch()
	active.allActions()
	inactive.allActions()
	active.military.activateRegion("test_map")
	inactive.military.activateRegion("another_map")
	let layers=active.farm.get("player")
	layers.add(new ResearchUnlock("agrarian_improvement","policy","land_tenure_reform"))
	layers.add(new ResearchUnlock("agrarian_improvement","policy","land_tenure_reform"))
	for day=1 to 800
		active.advance(day)
	inactive.advance(800)
	active.trade.capture().assertEquals(inactive.trade.capture())
	active.state.countries.treasury[0].assertEquals(inactive.state.countries.treasury[0])
	active.state.countries.materialStock[0].assertEquals(inactive.state.countries.materialStock[0])
	let saved=active.trade.capture()
	active.trade.reconstruct(saved).assertTrue()
	active.research.runtime.technologies.reconstructAll()
	active.research.runtime.technologies.reconstructAll()
	active.trade.capture().assertEquals(saved)

@test function unsupportedFarmsProduceNoKnowledgeOrExtraOutputAndUnpaidUpkeepSuspends()
	let f=new AgricultureFixture()
	f.allResearch()
	f.allActions()
	f.equipment.stock=0
	f.advance(365)
	f.staple.stock.assertEquals(910) // 100 ordinary spoilage minus 10% granary relief
	f.local.knowledge.assertEquals(0)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	f.equipment.stock=100
	f.state.countries.treasury[0]=0
	f.advance(455)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	let before=f.state.countries.treasury[0]
	f.advance(455)
	f.state.countries.treasury[0].assertEquals(before)

@test function granaryConstructionConsumesDeliveredMaterialsAndTheirCostBasis()
	let f=new AgricultureFixture()
	f.trade.registerMarket(new RuntimeMarket("supply_port",f.trade.constructionGoodId,100,1000,10,8))
	f.trade.controller.provenance.add(f.construction.id,f.trade.constructionGoodId,100,1000,"supply_port")
	f.unlock("agrarian_improvement")
	f.action("granary",true)
	f.trade.controller.provenance.quantityIn(f.construction.id,f.trade.constructionGoodId).assertEquals(90)
	f.trade.controller.provenance.costIn(f.construction.id,f.trade.constructionGoodId).assertEquals(900)
	f.trade.validate(f.trade.capture()).assertTrue()

@test function agriculturalLateCampaignLoadRollbackRestoresPaidProjectsResourcesAndClock()
	let f=new LoadFixture()
	let trade=f.extension.trade
	let farm=trade.agriculture
	// Neutral scenario exercising the exact same extension and campaign load
	// transaction. Authored agriculture magnitudes/eras execute above.
	farm.addEffect(new AgricultureEffect("printing","building","printing_house","staple_storage_capacity",2000,1000,0,0,1000,0,90,10,1))
	farm.addEffect(new AgricultureEffect("printing","policy","crop_rotation","crop_output_efficiency",500,200,200,0,100,50,90,0,1))
	f.rpg.technologies.get("printing").addUnlock("printing","policy","crop_rotation")
	f.rpg.restoreState(f.rpg.captureState()+"|u,england,printing").assertTrue()
	trade.stapleId="grain"
	trade.farmEquipmentId="farm_equipment"
	trade.constructionGoodId="construction_stock"
	trade.registerMarket(new RuntimeMarket("port","farm_equipment",100,1000,10,8))
	let construction=new TradeStore("local_construction",1000,0).withAccess("warehouse","port",true)
	construction.contents.set("construction_stock",100)
	trade.registerStore(construction)
	f.military.appoint("port",new AdministratorState("steward","Steward","Steward","england","europe_west","port",100,50,50,5)).assertEquals("Administrator appointed.")
	farm.addSite(new AgricultureSite("port","rural_fixture",1000,1000,10,40000,1000,1,true,true,true))
	farm.authority=new CampaignAgricultureAuthority(f.campaign.state,trade,trade.stapleId,trade.farmEquipmentId,trade.constructionGoodId)
	farm.reset(f.clock.campaignDay(),1)
	trade.access=new LiveTradeAccess(f.campaign.state)
	f.campaign.state.agriculture=farm
	f.rpg.technologies.effects=farm
	f.rpg.technologies.reconstructAll()
	farm.enact("england","port","printing_house").assertEquals("Action completed.")
	farm.enact("england","port","crop_rotation").assertEquals("Action completed.")
	let candidate=f.campaign.state.captureAuthoritativeState()
	f.clock.advanceTo(60).assertTrue()
	let saved=trade.capture()
	let money=f.campaign.countries.treasury[0]
	let materials=construction.quantity("construction_stock")
	f.ports.failParty=true
	f.rejectAndVerify(candidate)
	trade.capture().assertEquals(saved)
	f.campaign.countries.treasury[0].assertEquals(money)
	construction.quantity("construction_stock").assertEquals(materials)
	f.ports.failParty=false
	f.recordingTimer.expected=lastAuthorityValue(candidate,"clock")
	// Loading and reconstructing repeatedly never charges the pending bills again.
	f.campaign.saves.load(SAVE_SLOT_MANUAL,1).assertTrue()
	f.campaign.countries.treasury[0].assertEquals(money)
	construction.quantity("construction_stock").assertEquals(materials)
	let restored=trade.capture()
	f.campaign.saves.load(SAVE_SLOT_MANUAL,1).assertTrue()
	trade.capture().assertEquals(restored)

@test function allFourAgriculturalOptionsHaveIdenticalControllerRulesAndOutcomes()
	let human=new AgricultureFixture()
	let ai=new AgricultureFixture()
	ai.state.identity.changeAllegiance("other").assertTrue()
	ai.city.controllerId="other"
	ai.city.legalOwnerId="other"
	ai.military.administrators[0].controllerId="other"
	human.allResearch()
	ai.allResearch()
	human.allActions()
	ai.allActions()
	human.advance(365)
	ai.advance(365)
	human.staple.stock.assertEquals(ai.staple.stock)
	human.staple.money.assertEquals(ai.staple.money)
	human.equipment.stock.assertEquals(ai.equipment.stock)
	human.construction.quantity(human.trade.constructionGoodId).assertEquals(ai.construction.quantity(ai.trade.constructionGoodId))
	human.local.knowledge.assertEquals(ai.local.knowledge)
	human.state.countries.treasury[0].assertEquals(ai.state.countries.treasury[1])
	for i=0 to ai.farm.effectCount-1
		ai.action(ai.farm.effects[i].contentId,false)

@test function researchAloneNeverStartsOrganizationsAndLastToolSupportsTheSameHarvestTax()
	let unactivated=new AgricultureFixture()
	unactivated.allResearch()
	unactivated.advance(365)
	unactivated.local.knowledge.assertEquals(0)
	unactivated.farm.policyCount.assertEquals(0)
	unactivated.local.granaryDue.assertEquals(0)
	let active=new AgricultureFixture()
	active.allResearch()
	active.allActions()
	active.equipment.stock=1
	active.advance(365)
	active.equipment.stock.assertEquals(0)
	active.staple.money.assertEquals(89800) // last tool supports this year's tax transaction

// Each control completes the same paid research. Only the elected action or
// the explicitly disabled contribution differs; assertions use real markets.
@test function agriculturalGranaryCapacityBeatsMatchedControlAfterPaidNinetyDays()
	let treated=new AgricultureFixture()
	let control=new AgricultureFixture()
	treated.unlock("agrarian_improvement")
	control.unlock("agrarian_improvement")
	let money=treated.state.countries.treasury[0]
	treated.action("granary",true)
	treated.state.countries.treasury[0].assertEquals(money-1000)
	treated.construction.quantity(treated.trade.constructionGoodId).assertEquals(90)
	treated.advance(89)
	treated.staple.storageCapacity.assertEquals(1000)
	treated.advance(90)
	control.advance(90)
	treated.staple.storageCapacity.assertEquals(1200)
	control.staple.storageCapacity.assertEquals(1000)
	// Isolate capacity from spoilage; both grow 400 from 100 actual seed.
	treated.local.spoilageBp=0
	control.local.spoilageBp=0
	treated.advance(365)
	control.advance(365)
	treated.staple.stock.assertEquals(1200)
	control.staple.stock.assertEquals(1000)
	treated.equipment.stock.assertEquals(99)
	control.equipment.stock.assertEquals(99)
	treated.action("granary",false)

@test function agriculturalGranarySpoilageBeatsMatchedControlWithoutFarming()
	let treated=new AgricultureFixture()
	let control=new AgricultureFixture()
	treated.unlock("agrarian_improvement")
	control.unlock("agrarian_improvement")
	treated.action("granary",true)
	treated.local.arable=false
	control.local.arable=false
	treated.advance(365)
	control.advance(365)
	// Actual 100 grain loss less 1000 bp = 90; no harvest or free food.
	treated.staple.stock.assertEquals(910)
	control.staple.stock.assertEquals(900)
	treated.equipment.stock.assertEquals(100)
	treated.local.knowledge.assertEquals(0)

@test function agriculturalTenureHarvestAndTaxBeatMatchedElectedControl()
	let treated=new AgricultureFixture()
	let control=new AgricultureFixture()
	treated.prepareHarvest()
	control.prepareHarvest()
	treated.unlock("agrarian_improvement")
	control.unlock("agrarian_improvement")
	treated.action("land_tenure_reform",true)
	treated.advance(89)
	treated.farm.rate(treated.local,"crop_output_efficiency",treated.farm.currentDay).assertEquals(0)
	treated.advance(90)
	treated.farm.rate(treated.local,"crop_output_efficiency",treated.farm.currentDay).assertEquals(500)
	treated.farm.rate(treated.local,"rural_tax_efficiency",treated.farm.currentDay).assertEquals(200)
	treated.advance(365)
	control.advance(365)
	// 100 seed -> 400 versus 420, after the same 90 stored-grain loss.
	treated.staple.stock.assertEquals(1230)
	control.staple.stock.assertEquals(1210)
	treated.staple.money.assertEquals(89800)
	control.staple.money.assertEquals(90000)
	treated.equipment.stock.assertEquals(99)
	control.farm.policyCount.assertEquals(0)

@test function agriculturalEnclosureHarvestSeparatesEfficiencyFromTwoYearUnrest()
	let treated=new AgricultureFixture()
	let control=new AgricultureFixture()
	treated.prepareHarvest()
	control.prepareHarvest()
	treated.unlock("agricultural_mechanization")
	control.unlock("agricultural_mechanization")
	treated.action("enclosure",true)
	treated.advance(90)
	treated.farm.rate(treated.local,"crop_output_efficiency",treated.farm.currentDay).assertEquals(800)
	treated.farm.unrest(treated.local,657072+729).assertEquals(500)
	treated.farm.unrest(treated.local,657072+730).assertEquals(0)
	treated.advance(365)
	control.advance(365)
	// 400 + 32 efficiency - 20 transitional unrest = 412 real output.
	treated.staple.stock.assertEquals(1222)
	control.staple.stock.assertEquals(1210)
	treated.staple.money.assertEquals(control.staple.money)
	treated.advance(730)
	control.advance(730)
	// Second harvest has all 432 output; no unrest deduction after two years.
	treated.staple.stock.assertEquals(1442)
	control.staple.stock.assertEquals(1399)

@test function agriculturalSocietiesSeparateDiffusionAndConditionalFarmOutput()
	let treated=new AgricultureFixture()
	let control=new AgricultureFixture()
	let outputControl=new AgricultureFixture()
	let unelected=new AgricultureFixture()
	treated.prepareHarvest()
	control.prepareHarvest()
	unelected.prepareHarvest()
	outputControl.prepareHarvest()
	treated.local.seedLimit=32
	control.local.seedLimit=32
	unelected.local.seedLimit=32
	outputControl.local.seedLimit=32
	treated.unlock("agricultural_societies")
	control.unlock("agricultural_societies")
	unelected.unlock("agricultural_societies")
	outputControl.unlock("agricultural_societies")
	treated.action("progression_agricultural_societies",true)
	control.action("progression_agricultural_societies",true)
	// Counterfactual organizations disable one rounded contribution at a time.
	// A positive 1-bp diffusion retains supported practice but rounds to zero.
	outputControl.action("progression_agricultural_societies",true)
	control.farm.getEffect("progression_agricultural_societies").bonus=1
	outputControl.farm.getEffect("progression_agricultural_societies").secondary=0
	treated.advance(365)
	control.advance(365)
	unelected.advance(365)
	outputControl.advance(365)
	treated.farm.rate(treated.local,"agricultural_knowledge_diffusion",treated.farm.currentDay).assertEquals(600)
	treated.farm.rate(treated.local,"crop_output_efficiency",treated.farm.currentDay).assertEquals(200)
	treated.local.knowledge.assertEquals(33) // 32 practice + floor(32*600/10000)
	control.local.knowledge.assertEquals(32)
	unelected.local.knowledge.assertEquals(0)
	treated.staple.stock.assertEquals(1002) // 128 base + floor(128*200/10000)
	control.staple.stock.assertEquals(1002)
	outputControl.staple.stock.assertEquals(1000)
	outputControl.local.knowledge.assertEquals(33)
	unelected.staple.stock.assertEquals(1000)
	let discounted=treated.research.runtime.technologies.costFor("player","seed_drill",1800,0,0)
	control.research.runtime.technologies.costFor("player","seed_drill",1800,0,0).assertEquals(discounted+1)
	treated.state.countries.treasury[0].assertEquals(control.state.countries.treasury[0])
	treated.local.network=false
	treated.advance(730)
	treated.local.knowledge.assertEquals(33)
	treated.farm.rate(treated.local,"crop_output_efficiency",treated.farm.currentDay).assertEquals(0)

@test function agriculturalWrongKindsMissingSeedLaborAndTaxLiquidityNeverCreateBenefits()
	let f=new AgricultureFixture()
	f.allResearch()
	let wrong=new ResearchEntitlements("player")
	for i=0 to f.farm.effectCount-1
		let e=f.farm.effects[i]
		wrong.add(new ResearchUnlock(e.nodeId,"modifier",e.contentId))
	f.farm.replaceResearchEntitlements(wrong)
	for i=0 to f.farm.effectCount-1
		f.action(f.farm.effects[i].contentId,false)
	f.research.runtime.technologies.reconstructAll()
	f.allActions()
	f.staple.stock=0
	f.advance(365)
	f.staple.stock.assertEquals(0)
	f.equipment.stock.assertEquals(100)
	f.local.knowledge.assertEquals(0)
	f.staple.stock=1000
	// Keep upkeep funded, but make genuine farm labor unaffordable.
	f.local.laborCost=1000000
	f.staple.money=3
	let money=f.state.countries.treasury[0]
	f.advance(730)
	f.equipment.stock.assertEquals(100)
	f.local.knowledge.assertEquals(0)
	f.staple.money.assertEquals(0)
	f.state.countries.treasury[0].assertEquals(money-150+3)
	f.local.normalTax=0
	f.action("granary",false)

@test function agriculturalProductionRegistrationConnectsResearchClockAndMarkets()
	let f=new StartupFixture(new StartupStorage(),new StartupStorage(),"europe_west")
	f.register()
	let farm=f.trade.agriculture
	let rpg=f.campaign.state.rpg
	(farm.authority!=null and f.campaign.state.agriculture==farm).assertTrue()
	(rpg.technologies.adoption==farm).assertTrue()
	farm.effectCount.assertEquals(4)
	rpg.restoreState(rpg.captureState()+"|u,england,agrarian_improvement|u,england,agricultural_mechanization|u,england,agricultural_societies").assertTrue()
	rpg.technologies.reconstructAll()
	for i=0 to farm.effectCount-1
		let e=farm.effects[i]
		rpg.technologies.bindingStatus(new ResearchUnlock(e.nodeId,e.kind,e.contentId)).assertEquals(RESEARCH_BOUND)
		farm.get("england").has(e.kind,e.contentId).assertTrue()
	farm.policyCount.assertEquals(0)
	for i=0 to farm.siteCount-1
		farm.sites[i].granaryDue.assertEquals(0)
	f.campaign.state.startupLocked=false
	f.clock.advanceTo(f.clock.campaignDay()+1).assertTrue()
	farm.currentDay.assertEquals(f.clock.campaignDay())
	f.trade.refreshAgriculture()
