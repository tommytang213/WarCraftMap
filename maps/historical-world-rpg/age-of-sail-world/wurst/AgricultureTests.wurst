class AgricultureOutput implements TradePresentation
	string last=""
	override function showMarket(player recipient, string id, string rows)
		last=rows
	override function showTradeResult(player recipient, string message)
		last=message

/** Runs generated typed effects through the production treasury/market/military
 * bridge; only the native military object adapter and UI are recordings. */
class AgricultureFixture
	ResearchFixture research=new ResearchFixture()
	PlayableTradeRuntime trade=new PlayableTradeRuntime()
	MilitarySettlementRuntime military=new MilitarySettlementRuntime(new RecordingMilitaryAdapter())
	CampaignClock clock=new CampaignClock(657072,660000,657072,1.) // 1800-01-01
	PlayableCampaignState state=new PlayableCampaignState(null,clock)
	AgricultureOutput output=new AgricultureOutput()
	AgricultureRuntime farm
	AgricultureSite local
	SettlementRuntimeState city
	RuntimeMarket staple
	RuntimeMarket equipment
	TradeStore construction
	construct()
		configureGeneratedAgriculture(trade)
		farm=trade.agriculture
		local=new AgricultureSite("farm_fixture","rural_fixture",10000,1000,100,40000,1000,20,true,true,true)
		farm.addSite(local)
		staple=new RuntimeMarket(local.id,trade.stapleId,1000,100000,10,8)
		equipment=new RuntimeMarket(local.id,trade.farmEquipmentId,100,1000,10,8)
		trade.registerPersonalStore()
		trade.markets[0]=staple
		trade.markets[1]=equipment
		trade.marketCount=2
		trade.market=staple
		trade.settlementId=local.id
		construction=new TradeStore("local_materials",1000,0).withAccess("warehouse",local.id,true)
		construction.contents.set(trade.constructionGoodId,100)
		trade.storeCount=2
		trade.stores[0]=trade.hold
		trade.stores[1]=construction
		trade.marketSelected=false
		// Set an exact deterministic production quantity and genuine tax base.
		local.normalTax=10000
		local.baseCapacity=1000
		local.seedLimit=100
		local.yieldBp=40000
		local.spoilageBp=1000
		local.laborCost=20
		local.tenureTransition=true
		staple.stock=1000
		staple.money=100000
		equipment.stock=100
		city=new SettlementRuntimeState(local.id,"player","test_map",'htow','hfoo',10,20,30,100,0.,0.)
		military.registerSettlement(city)
		military.appoint(local.id,new AdministratorState("farm_officer","Steward","Steward","player","test_map",local.id,100,50,50,5)).assertEquals("Administrator appointed.")
		state.identity=new PlayerCampaignIdentity()
		state.identity.startCampaign("player","test_map","test_region",local.id).assertTrue()
		state.countries=new PlayableCountryInteractionRuntime(state.identity)
		state.countries.registerPolityResources("player",100000,100)
		state.countries.registerPolityResources("other",100000,100)
		state.countries.registerRewardProfile(new GovernmentRewardProfile("player","commission","office",0,0,1,false))
		state.countries.registerRewardProfile(new GovernmentRewardProfile("other","commission","office",0,0,1,false))
		state.countries.granted[0]=true
		state.countries.granted[1]=true
		state.setMilitarySettlementRuntime(military)
		state.setRpgRuntime(research.runtime)
		state.agriculture=farm
		trade.access=new LiveTradeAccess(state)
		farm.authority=new CampaignAgricultureAuthority(state,trade,trade.stapleId,trade.farmEquipmentId,trade.constructionGoodId)
		farm.reset(clock.campaignDay(),1800)
		research.runtime.technologies.effects=farm
		research.runtime.technologies.adoption=farm
		research.runtime.researchResources=new CampaignResearchResources(state)
		registerAgricultureCommands(research.commands,trade,output).assertEquals("")
	function seedPrerequisites(string nodeId)
		let node=research.runtime.technologies.get(nodeId)
		let owner=research.runtime.researchResources.controllerId(Player(0))
		var completions=""
		for i=0 to node.prerequisiteCount-1
			if not research.runtime.technologies.isUnlocked(owner,node.prerequisiteIds[i])
				completions+="|u,"+owner+","+node.prerequisiteIds[i]
		let before=research.runtime.captureState()
		research.runtime.restoreState(before+completions).assertTrue()
		research.runtime.technologies.reconstructAll()
	function unlock(string nodeId)
		seedPrerequisites(nodeId)
		let owner=research.runtime.researchResources.controllerId(Player(0))
		let index=state.countries.polityIndex(owner)
		let before=state.countries.treasury[index]
		let cost=research.runtime.technologies.costFor(owner,nodeId,1800,0,0)
		research.commands.dispatch(Player(0),"/research "+nodeId).assertTrue()
		research.output.last.assertEquals("Action completed.")
		state.countries.treasury[index].assertEquals(before-cost)
	function action(string contentId, boolean success)
		let before=trade.capture()
		let owner=research.runtime.researchResources.controllerId(Player(0))
		let index=state.countries.polityIndex(owner)
		let money=state.countries.treasury[index]
		let materials=construction.quantity(trade.constructionGoodId)
		research.commands.dispatch(Player(0),"/agriculture "+local.id+" "+contentId).assertTrue()
		if success
			output.last.assertEquals("Action completed.")
		else
			(output.last!="Action completed.").assertTrue()
			trade.capture().assertEquals(before)
			state.countries.treasury[index].assertEquals(money)
			construction.quantity(trade.constructionGoodId).assertEquals(materials)
	function allResearch()
		unlock("agrarian_improvement")
		unlock("agricultural_mechanization")
		unlock("agricultural_societies")
	function allActions()
		action("granary",true)
		action("land_tenure_reform",true)
		action("enclosure",true)
		action("progression_agricultural_societies",true)
	function advance(int days)
		clock.advanceTo(657072+days).assertTrue()
		trade.refreshAgriculture()

@test function registeredAgriculturalResearchAndActionsDebitOnceAndRespectPrerequisites()
	let f=new AgricultureFixture()
	for i=0 to f.farm.effectCount-1
		let e=f.farm.effects[i]
		f.action(e.contentId,false)
		let node=f.research.runtime.technologies.get(e.nodeId)
		f.research.commands.dispatch(Player(0),"/research "+node.id).assertTrue()
		f.research.output.last.assertEquals("Requirements are not met here.")
	f.allResearch()
	let treasury=f.state.countries.treasury[0]
	f.allActions()
	f.state.countries.treasury[0].assertEquals(treasury-1300)
	f.construction.quantity(f.trade.constructionGoodId).assertEquals(90)
	for i=0 to f.farm.effectCount-1
		let e=f.farm.effects[i]
		f.action(e.contentId,false)
		f.farm.bindingStatus(new ResearchUnlock(e.nodeId,e.kind,e.contentId)).assertEquals(RESEARCH_BOUND)
		f.farm.bindingStatus(new ResearchUnlock(e.nodeId,"modifier",e.contentId)).assertEquals(RESEARCH_UNBOUND)
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1000)
	f.advance(89)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	f.advance(90)
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1200)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(1500)
	f.farm.rate(f.local,"rural_tax_efficiency",f.farm.currentDay).assertEquals(200)
	f.farm.rate(f.local,"agricultural_knowledge_diffusion",f.farm.currentDay).assertEquals(600)
	f.state.countries.treasury[0].assertEquals(treasury-1450)
	f.farm.unrest(f.local,657072+90).assertEquals(500)
	f.farm.unrest(f.local,657072+730).assertEquals(0)

@test function agriculturalAnnualConsumerUsesExactInputsSpoilageTaxAndEarnedDiffusion()
	let f=new AgricultureFixture()
	f.allResearch()
	f.allActions()
	f.local.baseCapacity=2000
	f.local.seedLimit=32
	f.advance(365)
	// 32 seed -> 128 base + floor(128*1500/10000) - floor(128*500/10000) = 141;
	// remaining 968 loses 96 - floor(96*1000/10000) = 87. Total 1022.
	f.staple.stock.assertEquals(1022)
	f.equipment.stock.assertEquals(99)
	f.staple.money.assertEquals(89800)
	f.local.knowledge.assertEquals(33) // 32 + floor(32*600/10000), no free completion
	f.research.runtime.technologies.costFor("player","seed_drill",1800,0,0).assertEquals(IMaxBJ(1,f.research.runtime.technologies.cost("seed_drill",1800,0,0)-33))
	let current=f.trade.capture()
	f.research.runtime.technologies.reconstructAll()
	f.research.runtime.technologies.reconstructAll()
	f.advance(365)
	f.trade.capture().assertEquals(current)
	agricultureScale(2147483647,2000).assertEquals(429496729)

