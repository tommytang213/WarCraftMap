@test function agriculturalSaveMigrationFailedLoadAndCaptureRetainDurableSources()
	let f=new AgricultureFixture()
	f.allResearch()
	f.allActions()
	f.advance(45)
	let pending=f.trade.capture()
	let pendingClock=f.clock.captureState()
	f.trade.validate(pending).assertTrue()
	f.trade.beginLoad()
	f.advance(365)
	f.trade.rollbackLoad()
	f.clock.restoreState(pendingClock).assertTrue()
	f.trade.capture().assertEquals(pending)
	let checkpoint=f.trade.capture()
	f.trade.reconstruct(checkpoint+"~p,player,missing,enclosure,1,1,1").assertFalse()
	f.trade.capture().assertEquals(checkpoint)
	f.advance(90)
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1200)
	f.city.controllerId="other"
	f.city.legalOwnerId="other"
	f.military.administrators[0].controllerId="other"
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1000)
	f.research.runtime.technologies.unlock("other","agrarian_improvement",1800,100000,0,0).assertFalse()
	// An AI controller uses the same prerequisites, treasury and action rules.
	f.state.identity.changeAllegiance("other").assertTrue()
	let previous=f.research.runtime.captureState()
	f.research.runtime.restoreState(previous+"|u,other,selective_breeding|u,other,scientific_societies").assertTrue()
	f.research.commands.dispatch(Player(0),"/research agrarian_improvement").assertTrue()
	f.research.output.last.assertEquals("Action completed.")
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1200)
	let money=f.state.countries.treasury[1]
	f.farm.enact("other",f.local.id,"granary").assertEquals("Already commissioned or enacted here.")
	f.state.countries.treasury[1].assertEquals(money)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	f.farm.enact("other",f.local.id,"land_tenure_reform").assertEquals("Action completed.")
	// Legacy trade v4 carries no agricultural projects and never grants assets.
	let saved=f.trade.capture()
	let cut=StringLength(saved)-StringLength(AgricultureSnapshot.capture(f.farm))-1
	let legacy="v4:"+SubString(saved,3,cut)
	f.trade.reconstruct(legacy).assertTrue()
	f.local.granaryDue.assertEquals(0)
	f.farm.policyCount.assertEquals(0)
	f.farm.capacity(f.local,f.farm.currentDay).assertEquals(1000)

@test function agriculturalAbstractReplayMatchesActiveDaysAndDuplicatesNeverStack()
	let active=new AgricultureFixture()
	let inactive=new AgricultureFixture()
	active.allResearch()
	inactive.allResearch()
	active.allActions()
	inactive.allActions()
	active.military.activateRegion("test_map")
	inactive.military.activateRegion("another_map")
	let layers=active.farm.get("player")
	layers.add(new ResearchUnlock("agrarian_improvement","policy","land_tenure_reform"))
	layers.add(new ResearchUnlock("agrarian_improvement","policy","land_tenure_reform"))
	for day=1 to 800
		active.advance(day)
	inactive.advance(800)
	active.trade.capture().assertEquals(inactive.trade.capture())
	active.state.countries.treasury[0].assertEquals(inactive.state.countries.treasury[0])
	active.state.countries.materialStock[0].assertEquals(inactive.state.countries.materialStock[0])
	let saved=active.trade.capture()
	active.trade.reconstruct(saved).assertTrue()
	active.research.runtime.technologies.reconstructAll()
	active.research.runtime.technologies.reconstructAll()
	active.trade.capture().assertEquals(saved)

@test function unsupportedFarmsProduceNoKnowledgeOrExtraOutputAndUnpaidUpkeepSuspends()
	let f=new AgricultureFixture()
	f.allResearch()
	f.allActions()
	f.equipment.stock=0
	f.advance(365)
	f.staple.stock.assertEquals(910) // 100 ordinary spoilage minus 10% granary relief
	f.local.knowledge.assertEquals(0)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	f.equipment.stock=100
	f.state.countries.treasury[0]=0
	f.advance(455)
	f.farm.rate(f.local,"crop_output_efficiency",f.farm.currentDay).assertEquals(0)
	let before=f.state.countries.treasury[0]
	f.advance(455)
	f.state.countries.treasury[0].assertEquals(before)

@test function granaryConstructionConsumesDeliveredMaterialsAndTheirCostBasis()
	let f=new AgricultureFixture()
	f.trade.registerMarket(new RuntimeMarket("supply_port",f.trade.constructionGoodId,100,1000,10,8))
	f.trade.controller.provenance.add(f.construction.id,f.trade.constructionGoodId,100,1000,"supply_port")
	f.unlock("agrarian_improvement")
	f.action("granary",true)
	f.trade.controller.provenance.quantityIn(f.construction.id,f.trade.constructionGoodId).assertEquals(90)
	f.trade.controller.provenance.costIn(f.construction.id,f.trade.constructionGoodId).assertEquals(900)
	f.trade.validate(f.trade.capture()).assertTrue()

@test function agriculturalLateCampaignLoadRollbackRestoresPaidProjectsResourcesAndClock()
	let f=new LoadFixture()
	let trade=f.extension.trade
	let farm=trade.agriculture
	// Neutral scenario exercising the exact same extension and campaign load
	// transaction. Authored agriculture magnitudes/eras execute above.
	farm.addEffect(new AgricultureEffect("printing","building","printing_house","staple_storage_capacity",2000,1000,0,0,1000,0,90,10,1))
	farm.addEffect(new AgricultureEffect("printing","policy","crop_rotation","crop_output_efficiency",500,200,200,0,100,50,90,0,1))
	f.rpg.technologies.get("printing").addUnlock("printing","policy","crop_rotation")
	f.rpg.restoreState(f.rpg.captureState()+"|u,england,printing").assertTrue()
	trade.stapleId="grain"
	trade.farmEquipmentId="farm_equipment"
	trade.constructionGoodId="construction_stock"
	trade.registerMarket(new RuntimeMarket("port","farm_equipment",100,1000,10,8))
	let construction=new TradeStore("local_construction",1000,0).withAccess("warehouse","port",true)
	construction.contents.set("construction_stock",100)
	trade.registerStore(construction)
	f.military.appoint("port",new AdministratorState("steward","Steward","Steward","england","europe_west","port",100,50,50,5)).assertEquals("Administrator appointed.")
	farm.addSite(new AgricultureSite("port","rural_fixture",1000,1000,10,40000,1000,1,true,true,true))
	farm.authority=new CampaignAgricultureAuthority(f.campaign.state,trade,trade.stapleId,trade.farmEquipmentId,trade.constructionGoodId)
	farm.reset(f.clock.campaignDay(),1)
	trade.access=new LiveTradeAccess(f.campaign.state)
	f.campaign.state.agriculture=farm
	f.rpg.technologies.effects=farm
	f.rpg.technologies.reconstructAll()
	farm.enact("england","port","printing_house").assertEquals("Action completed.")
	farm.enact("england","port","crop_rotation").assertEquals("Action completed.")
	let candidate=f.campaign.state.captureAuthoritativeState()
	f.clock.advanceTo(60).assertTrue()
	let saved=trade.capture()
	let money=f.campaign.countries.treasury[0]
	let materials=construction.quantity("construction_stock")
	f.ports.failParty=true
	f.rejectAndVerify(candidate)
	trade.capture().assertEquals(saved)
	f.campaign.countries.treasury[0].assertEquals(money)
	construction.quantity("construction_stock").assertEquals(materials)
	f.ports.failParty=false
	f.recordingTimer.expected=lastAuthorityValue(candidate,"clock")
	// Loading and reconstructing repeatedly never charges the pending bills again.
	f.campaign.saves.load(SAVE_SLOT_MANUAL,1).assertTrue()
	f.campaign.countries.treasury[0].assertEquals(money)
	construction.quantity("construction_stock").assertEquals(materials)
	let restored=trade.capture()
	f.campaign.saves.load(SAVE_SLOT_MANUAL,1).assertTrue()
	trade.capture().assertEquals(restored)

@test function allFourAgriculturalOptionsHaveIdenticalControllerRulesAndOutcomes()
	let human=new AgricultureFixture()
	let ai=new AgricultureFixture()
	ai.state.identity.changeAllegiance("other").assertTrue()
	ai.city.controllerId="other"
	ai.city.legalOwnerId="other"
	ai.military.administrators[0].controllerId="other"
	human.allResearch()
	ai.allResearch()
	human.allActions()
	ai.allActions()
	human.advance(365)
	ai.advance(365)
	human.staple.stock.assertEquals(ai.staple.stock)
	human.staple.money.assertEquals(ai.staple.money)
	human.equipment.stock.assertEquals(ai.equipment.stock)
	human.construction.quantity(human.trade.constructionGoodId).assertEquals(ai.construction.quantity(ai.trade.constructionGoodId))
	human.local.knowledge.assertEquals(ai.local.knowledge)
	human.state.countries.treasury[0].assertEquals(ai.state.countries.treasury[1])
	for i=0 to ai.farm.effectCount-1
		ai.action(ai.farm.effects[i].contentId,false)

@test function researchAloneNeverStartsOrganizationsAndLastToolSupportsTheSameHarvestTax()
	let unactivated=new AgricultureFixture()
	unactivated.allResearch()
	unactivated.advance(365)
	unactivated.local.knowledge.assertEquals(0)
	unactivated.farm.policyCount.assertEquals(0)
	unactivated.local.granaryDue.assertEquals(0)
	let active=new AgricultureFixture()
	active.allResearch()
	active.allActions()
	active.equipment.stock=1
	active.advance(365)
	active.equipment.stock.assertEquals(0)
	active.staple.money.assertEquals(89800) // last tool supports this year's tax transaction
