package ResearchRuntimeTests

import WarcraftRpgRuntime
import CommandRouter
import CampaignSaveManager
import PlayableCampaignRuntime
import CampaignTimeline
import ScenarioData
import ManagementScreenPauseController
import ManagementCommandTests

class ResearchOutput implements CommandOutput
	string last=""
	override function show(player recipient,string message)
		last=message

class ResearchResources implements ResearchCommandResources
	string controller="player"
	int balance=100000
	int writes=0
	boolean useLiveClock=false
	WarcraftResearchResources live=new WarcraftResearchResources()
	override function controllerId(player sender) returns string
		return controller
	override function year() returns int
		if useLiveClock
			return live.year()
		return 1450
	override function gold(player sender) returns int
		return balance
	override function setGold(player sender,int amount)
		balance=amount
		writes++

class ResearchEffects extends UnboundResearchEffects
	int calls=0
	int playerPower=0 // Recording counts, never a gameplay magnitude.
	int otherPower=0
	int unrelatedModifier=47
	int oneTimeGrants=0
	string lastController=""
	string boundContent=""
	override function bindingStatus(ResearchUnlock definition) returns string
		if definition.contentId == boundContent
			return RESEARCH_BOUND
		return RESEARCH_UNBOUND
	override function replaceResearchEntitlements(ResearchEntitlements result)
		calls++
		lastController=result.controllerId
		if result.controllerId == "player"
			playerPower=result.count
		else
			otherPower=result.count
		super.replaceResearchEntitlements(result)

class ResearchFixture
	ResearchEffects effects=new ResearchEffects()
	ResearchResources resources=new ResearchResources()
	ResearchOutput output=new ResearchOutput()
	WarcraftRpgRuntime runtime
	CommandRegistry commands
	string initial
	construct()
		let generated=new WarcraftRpgRuntime(effects)
		configureGeneratedRpg(generated)
		runtime=new WarcraftRpgRuntime(effects)
		runtime.management.pauses = new ManagementScreenPauseController(new RecordingManagementPorts(), false)
		// Keep every production-generated research definition. Other RPG domains
		// are covered by WarcraftRpgRuntimeTests; rehashing their large payload in
		// every codec fixture needlessly exhausts the interpreter's per-test limit.
		runtime.technologies=generated.technologies
		runtime.researchResources=resources
		commands=new CommandRegistry(false,6,new CommandText(),output)
		registerRpgRuntimeCommands(commands,runtime).assertEquals("")
		initial=runtime.captureState()
	function completions(string records)
		// Existing completion records are independent of the newly repaired gates.
		runtime.restoreState(initial+records).assertTrue()
		runtime.reconcile("player")
		runtime.reconcile("other")
	function reject(string command)
		let before=runtime.captureState()
		let funds=resources.balance
		let writes=resources.writes
		let calls=effects.calls
		let playerPower=effects.playerPower
		let otherPower=effects.otherPower
		commands.dispatch(null,command).assertTrue()
		output.last.assertEquals("Requirements are not met here.")
		runtime.captureState().assertEquals(before)
		resources.balance.assertEquals(funds)
		resources.writes.assertEquals(writes)
		effects.calls.assertEquals(calls)
		effects.playerPower.assertEquals(playerPower)
		effects.otherPower.assertEquals(otherPower)
	function succeed(string command,string id)
		let technology=runtime.technologies.get(id)
		let cost=runtime.technologies.cost(id,resources.year(),0,0)
		let funds=resources.balance
		let writes=resources.writes
		let calls=effects.calls
		let unlocks=runtime.technologies.unlockedCount
		let playerPower=effects.playerPower
		let otherPower=effects.otherPower
		commands.dispatch(null,command).assertTrue()
		output.last.assertEquals("Action completed.")
		resources.balance.assertEquals(funds-cost)
		resources.writes.assertEquals(writes+1)
		runtime.technologies.unlockedCount.assertEquals(unlocks+1)
		runtime.technologies.isUnlocked(resources.controller,id).assertTrue()
		effects.calls.assertEquals(calls+1)
		effects.lastController.assertEquals(resources.controller)
		let earned=runtime.technologies.entitlements(resources.controller)
		effects.get(resources.controller).identities().assertEquals(earned.identities())
		destroy earned
		if resources.controller == "player"
			effects.playerPower.assertEquals(playerPower+technology.unlockCount)
			effects.otherPower.assertEquals(otherPower)
		else
			effects.otherPower.assertEquals(otherPower+technology.unlockCount)
			effects.playerPower.assertEquals(playerPower)
		reject(command)

@test function productionResearchRegistrationKeepsScreensReadOnlyAndActionReachable()
	let fixture=new ResearchFixture()
	let before=fixture.runtime.captureState()
	fixture.commands.dispatch(null,"/technology").assertTrue()
	fixture.output.last.startsWith("Technology and Institutions").assertTrue()
	let screen=fixture.output.last
	fixture.commands.dispatch(null,"/institutions").assertTrue()
	fixture.output.last.assertEquals(screen)
	fixture.commands.dispatch(null,"/heroes").assertTrue()
	fixture.output.last.startsWith("Heroes (strategic ").assertTrue()
	fixture.commands.dispatch(null,"/items").assertTrue()
	fixture.output.last.startsWith("Choose a character with /inventory HERO.\n").assertTrue()
	fixture.commands.dispatch(null,"/quests").assertTrue()
	fixture.output.last.startsWith("Quest Journal").assertTrue()
	fixture.commands.dispatch(null,"/research").assertFalse()
	fixture.output.last.assertEquals("Invalid arguments. Usage: /research ID")
	fixture.commands.dispatch(null,"/technology flintlock_drill").assertFalse()
	fixture.runtime.captureState().assertEquals(before)
	fixture.resources.writes.assertEquals(0)
	fixture.effects.calls.assertEquals(0)
	// A rejected action still proves that the production action handler ran.
	fixture.reject("/research flintlock_drill")
	fixture.commands.dispatch(null,"/rpg-close").assertTrue()
	fixture.runtime.management.pauses.getModalOwnerCount().assertEquals(0)

function assertRegistrationConflict(string alias)
	let commands=new CommandRegistry(false,6,new CommandText(),new ResearchOutput())
	commands.register("collision",alias,"collision","Fixture.","Fixture.",0,0,COMMAND_RELEASE,null).assertEquals("")
	registerRpgRuntimeCommands(commands,new WarcraftRpgRuntime(null)).assertEquals("Ambiguous command registration: '"+alias+"' is already registered.")

@test function productionRpgRegistrationReportsNameAndAliasConflicts()
	assertRegistrationConflict("roster")
	assertRegistrationConflict("institutions")
	assertRegistrationConflict("unequip")
	assertRegistrationConflict("research")
	assertRegistrationConflict("unlock")
	assertRegistrationConflict("institution")
	assertRegistrationConflict("search")

function exerciseGeneratedPrerequisites(string id,string first,string second,string action)
	let fixture=new ResearchFixture()
	let technology=fixture.runtime.technologies.get(id)
	technology.prerequisiteCount.assertEquals(2)
	technology.prerequisiteIds[0].assertEquals(first)
	technology.prerequisiteIds[1].assertEquals(second)
	fixture.reject(action+id)
	fixture.completions("|u,player,"+first)
	fixture.reject(action+id)
	fixture.completions("|u,player,"+second)
	fixture.reject(action+id)
	fixture.completions("|u,other,"+first+"|u,other,"+second)
	fixture.reject(action+id)
	fixture.completions("|u,player,"+first+"|u,other,"+second)
	fixture.reject(action+id)
	fixture.completions("|u,player,"+first+"|u,player,"+second)
	let cost=fixture.runtime.technologies.cost(id,fixture.resources.year(),0,0)
	fixture.runtime.research("player",id,fixture.resources.year(),cost-1).assertFalse()
	fixture.resources.balance=cost-1
	fixture.reject(action+id)
	fixture.resources.balance=cost
	fixture.succeed(action+id,id)
	fixture.resources.balance.assertEquals(0)
	// Other controllers may commit with their own prerequisites and pay once.
	fixture.completions("|u,other,"+first+"|u,other,"+second)
	fixture.resources.controller="other"
	fixture.resources.balance=100000
	fixture.succeed("/unlock "+id,id)
	fixture.runtime.technologies.isUnlocked("player",id).assertFalse()

@test function generatedFlintlockRequiresBothCrossBranchPrerequisitesAtCommit()
	exerciseGeneratedPrerequisites("flintlock_drill","trace_italienne","military_fiscal_state","/research ")

@test function generatedInstitutionRequiresBothTechnologyAndInstitutionPrerequisites()
	exerciseGeneratedPrerequisites("scientific_societies","experimental_method","movable_type_printing","/institution ")

@test function unknownResearchIsAtomicAndAllPrerequisitesBeyondTwoAreRequired()
	let fixture=new ResearchFixture()
	fixture.reject("/research unknown_research")
	let technology=new RuntimeTechnology("fixture_three","Three prerequisites",1450,10)
	technology.addPrerequisite("trace_italienne")
	technology.addPrerequisite("military_fiscal_state")
	technology.addPrerequisite("movable_type_printing")
	fixture.runtime.technologies.register(technology)
	fixture.completions("|u,player,trace_italienne|u,player,military_fiscal_state")
	fixture.reject("/research fixture_three")
	fixture.completions("|u,player,trace_italienne|u,player,military_fiscal_state|u,player,movable_type_printing")
	fixture.succeed("/research fixture_three","fixture_three")

function codecRestore(ResearchFixture fixture,string records,int schema)
	let clock=new CampaignClock(1, 100, 1, 1.)
	let prefix="v2;autosave=1|1|8:1001011;partyLocations=v1;commandContext=v1,world-map,0,|europe|;clock="+clock.initialState()+";map=world-map;region=europe;world=;players=;quests=;discovery=;orders=;trade=;diplomacy=v1;rewards=v1;militarySettlements=v1;religion=v1;piracy=v1;rpg="
	let document=prefix+records
	let codec=new PlayableCampaignCodec(clock)
	var payload=""
	if schema == CAMPAIGN_SAVE_SCHEMA_CURRENT
		payload=codec.encode("manual-1",SAVE_SLOT_MANUAL,1,"now",document)
	else
		payload=campaignSaveEnvelope(schema,"manual-1",SAVE_SLOT_MANUAL,1,"now",document)
	let decoded=codec.decodeMigrateAndValidate(payload,"manual-1")
	decoded.assertEquals(document)
	fixture.runtime.restoreState(SubString(decoded,StringLength(prefix),StringLength(decoded))).assertTrue()
	fixture.runtime.reconcile("player")
	fixture.runtime.reconcile("other")
	fixture.runtime.captureState().assertEquals(records)

@test function generatedResearchSaveCodecPreservesCompletionsAndResumedEligibility()
	let fixture=new ResearchFixture()
	fixture.completions("|u,player,trace_italienne|u,other,military_fiscal_state")
	fixture.reject("/research flintlock_drill")
	let pending=fixture.runtime.captureState()
	codecRestore(fixture,pending,CAMPAIGN_SAVE_SCHEMA_CURRENT)
	fixture.reject("/research flintlock_drill")
	fixture.completions("|u,player,trace_italienne|u,player,military_fiscal_state")
	let eligible=fixture.runtime.captureState()
	fixture.succeed("/research flintlock_drill","flintlock_drill")
	let completed=fixture.runtime.captureState()
	let balance=fixture.resources.balance
	let projected=fixture.effects.playerPower
	let resumed=new ResearchFixture()
	codecRestore(resumed,eligible,CAMPAIGN_SAVE_SCHEMA_CURRENT)
	resumed.succeed("/research flintlock_drill","flintlock_drill")
	resumed.runtime.captureState().assertEquals(completed)
	resumed.resources.balance.assertEquals(balance)
	resumed.effects.playerPower.assertEquals(projected)
	for schema=CAMPAIGN_SAVE_SCHEMA_OLDEST to CAMPAIGN_SAVE_SCHEMA_CURRENT
		codecRestore(resumed,completed,schema)
		resumed.effects.playerPower.assertEquals(projected)
		resumed.reject("/research flintlock_drill")
		resumed.resources.balance.assertEquals(balance)
	// Saves made under the truncated gate keep their previously earned completion.
	fixture.completions("|u,player,flintlock_drill|u,other,scientific_societies")
	codecRestore(resumed,fixture.runtime.captureState(),CAMPAIGN_SAVE_SCHEMA_CURRENT)
	resumed.effects.playerPower.assertEquals(1)
	resumed.effects.otherPower.assertEquals(1)
	resumed.reject("/research flintlock_drill")
	resumed.resources.controller="other"
	resumed.reject("/institution scientific_societies")

function researchClock() returns CampaignClock
	// Gregorian ordinals: 1450-01-01 through 1471-01-01.
	let clock=new CampaignClock(529237,536907,529237,1.)
	installCampaignClock(clock,null)
	return clock

function restoreHistoricalResearch(ResearchFixture fixture,CampaignClock clock,string state,string clockState)
	let prefix="v2;autosave=1|1|8:1001011;partyLocations=v1;commandContext=v1,world-map,0,|europe|;clock="+clockState+";map=world-map;region=europe;world=;players=;quests=;discovery=;orders=;trade=;diplomacy=v1;rewards=v1;militarySettlements=v1;religion=v1;piracy=v1;rpg="
	let codec=new PlayableCampaignCodec(clock)
	let encoded=codec.encode("manual-1",SAVE_SLOT_MANUAL,1,"now",prefix+state)
	codec.decodeMigrateAndValidate(encoded,"manual-1").assertEquals(prefix+state)
	clock.restoreState(clockState).assertTrue()
	fixture.runtime.restoreState(state).assertTrue()
	fixture.runtime.reconcile("player")
	fixture.runtime.captureState().assertEquals(state)

function historicalResearchReceipt(string caseName)
	for i=0 to 2
		var requirement="REQ-0037.01"
		if i==1
			requirement="REQ-0038.01"
		else if i==2
			requirement="ROAD-0045.01"
		print("TRACEABILITY {\"requirement\":\""+requirement+"\",\"case\":\""+caseName+"\",\"entryPoint\":\"live-historical-research\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"persistence\",\"transition\",\"outcome\"]}")

@test function historicalResearchCommandChargesAuthoredCurrentCostExactlyOnce()
	let previous=getCampaignClock()
	let clock=researchClock()
	let f=new ResearchFixture()
	f.resources.useLiveClock=true
	f.commands=new CommandRegistry(false,6,new CommandText(),f.output)
	registerRpgRuntimeCommands(f.commands,f.runtime).assertEquals("")
	f.resources.balance=864
	f.commands.dispatch(null,"/research pike_and_shot").assertTrue()
	f.output.last.assertEquals("Action completed.")
	f.resources.balance.assertEquals(0)
	f.resources.writes.assertEquals(1)
	f.effects.calls.assertEquals(1)
	f.runtime.technologies.isUnlocked("player","pike_and_shot").assertTrue()
	restoreHistoricalResearch(f,clock,f.runtime.captureState(),clock.captureState())
	f.reject("/research pike_and_shot")
	installCampaignClock(previous)
	historicalResearchReceipt("success")

@test function historicalResearchCommandRejectsInvalidCostsAndPreservesAllGates()
	let previous=getCampaignClock()
	let clock=researchClock()
	let f=new ResearchFixture()
	f.resources.useLiveClock=true
	f.commands=new CommandRegistry(false,6,new CommandText(),f.output)
	registerRpgRuntimeCommands(f.commands,f.runtime).assertEquals("")
	f.resources.balance=863
	let before=f.runtime.captureState()
	f.commands.dispatch(null,"/research pike_and_shot").assertTrue()
	f.output.last.assertEquals("Requirements are not met here.")
	f.runtime.captureState().assertEquals(before)
	f.resources.writes.assertEquals(0)
	f.effects.calls.assertEquals(0)
	f.reject("/research pike_and_shot")
	f.resources.balance=2147483647
	let pike=f.runtime.technologies.get("pike_and_shot")
	pike.baseCost="2147483647"
	f.reject("/research pike_and_shot")
	pike.baseCost="NaN"
	f.reject("/research pike_and_shot")
	pike.baseCost="90"
	pike.additionalMultiplierPerYearAhead="-1"
	f.reject("/research pike_and_shot")
	pike.additionalMultiplierPerYearAhead="0.08"
	f.completions("|u,player,trace_italienne|u,other,military_fiscal_state")
	f.reject("/research flintlock_drill")
	f.reject("/institution scientific_societies")
	restoreHistoricalResearch(f,clock,f.runtime.captureState(),clock.captureState())
	f.reject("/research flintlock_drill")
	f.resources.writes.assertEquals(0)
	installCampaignClock(previous)
	historicalResearchReceipt("failure")

@test function historicalResearchCommandRepricesAfterClockAndDefinitionChanges()
	let previous=getCampaignClock()
	let clock=researchClock()
	let f=new ResearchFixture()
	f.resources.useLiveClock=true
	f.commands=new CommandRegistry(false,6,new CommandText(),f.output)
	registerRpgRuntimeCommands(f.commands,f.runtime).assertEquals("")
	clock.advanceTo(536177).assertTrue()
	f.runtime.technologies.cost("pike_and_shot",f.resources.year(),0,0).assertEquals(728)
	f.resources.balance=90
	f.reject("/research pike_and_shot")
	clock.advanceTo(536542).assertTrue()
	f.resources.year().assertEquals(1470)
	let pike=f.runtime.technologies.get("pike_and_shot")
	pike.baseCost="90.0000005"
	f.reject("/research pike_and_shot")
	f.resources.balance=91
	f.commands.dispatch(null,"/unlock pike_and_shot").assertTrue()
	f.output.last.assertEquals("Action completed.")
	f.resources.balance.assertEquals(0)
	f.resources.writes.assertEquals(1)
	restoreHistoricalResearch(f,clock,f.runtime.captureState(),clock.captureState())
	f.resources.year().assertEquals(1470)
	f.reject("/research pike_and_shot")
	installCampaignClock(previous)
	historicalResearchReceipt("stale")

@test function historicalResearchCommandResumesAtSavedDateAndRetainsLegacyCompletions()
	let previous=getCampaignClock()
	let clock=researchClock()
	let f=new ResearchFixture()
	f.resources.useLiveClock=true
	f.commands=new CommandRegistry(false,6,new CommandText(),f.output)
	registerRpgRuntimeCommands(f.commands,f.runtime).assertEquals("")
	let pending=f.runtime.captureState()
	let savedDate=clock.captureState()
	f.resources.balance=1000
	f.commands.dispatch(null,"/research pike_and_shot").assertTrue()
	f.resources.balance.assertEquals(136)
	let completed=f.runtime.captureState()
	clock.advanceTo(536907).assertTrue()
	restoreHistoricalResearch(f,clock,pending,savedDate)
	f.resources.year().assertEquals(1450)
	f.resources.balance=1000
	f.succeed("/research pike_and_shot","pike_and_shot")
	f.resources.balance.assertEquals(136)
	f.runtime.captureState().assertEquals(completed)
	for schema=CAMPAIGN_SAVE_SCHEMA_OLDEST to CAMPAIGN_SAVE_SCHEMA_CURRENT
		codecRestore(f,completed,schema)
		f.reject("/institution pike_and_shot")
	f.resources.writes.assertEquals(2)
	f.effects.playerPower.assertEquals(1)
	installCampaignClock(previous)
	historicalResearchReceipt("replay")

function entitlementReceipt(string caseName)
	print("TRACEABILITY {\"requirement\":\"ROAD-0045.01\",\"case\":\""+caseName+"\",\"entryPoint\":\"live-typed-research-entitlements\",\"scope\":\"definitions_and_entitlement_delivery\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"persistence\",\"transition\",\"outcome\"]}")

@test function generatedMassArmyResearchDeliversAllTypedEntitlementsToItsController()
	let f=new ResearchFixture()
	f.completions("|u,player,mobile_field_artillery|u,player,statistical_administration|u,player,standing_army_system")
	f.runtime.technologies.cost("mass_army_logistics",1450,0,0).assertEquals(13884)
	f.resources.balance=13884
	f.succeed("/research mass_army_logistics","mass_army_logistics")
	f.resources.balance.assertEquals(0)
	let layer=f.effects.get("player")
	layer.has("policy","mass_conscription").assertTrue()
	layer.has("unit","common_wagon_train").assertTrue()
	layer.has("modifier","supply_efficiency").assertTrue()
	(layer.identities().indexOf("player|mass_army_logistics|policy|mass_conscription;player|mass_army_logistics|unit|common_wagon_train;player|mass_army_logistics|modifier|supply_efficiency;")>=0).assertTrue()
	f.effects.get("other").count.assertEquals(0)
	f.commands.dispatch(null,"/technology").assertTrue()
	(f.output.last.indexOf("mass_army_logistics: unit common_wagon_train - earned (unbound)")>=0).assertTrue()
	f.resources.controller="other"
	f.commands.dispatch(null,"/technology").assertTrue()
	(f.output.last.indexOf("mass_army_logistics: unit common_wagon_train - not earned (unbound)")>=0).assertTrue()
	f.effects.unrelatedModifier.assertEquals(47)
	f.effects.oneTimeGrants.assertEquals(0)
	entitlementReceipt("success")

@test function malformedTypedResearchDefinitionsRejectBeforeChargesAndCompletion()
	let f=new ResearchFixture()
	let node=f.runtime.technologies.get("pike_and_shot")
	let entry=node.unlocks[0]
	let kind=entry.kind
	let content=entry.contentId
	entry.kind="food"
	f.reject("/research pike_and_shot")
	entry.kind=kind
	// StringHash is case-insensitive; cached valid IDs must not admit a variant.
	entry.contentId="Army_Discipline"
	f.reject("/research pike_and_shot")
	entry.contentId=""
	f.reject("/research pike_and_shot")
	entry.contentId=content
	entry.nodeId="another_node"
	f.reject("/research pike_and_shot")
	entry.nodeId=node.id
	node.unlockCount=0
	f.reject("/research pike_and_shot")
	node.unlockCount=1
	node.addUnlock(node.id,kind,content)
	node.expectedUnlockCount=2
	f.reject("/research pike_and_shot")
	node.unlockCount=1
	node.expectedUnlockCount=1
	node.addPrerequisite("unknown_definition")
	f.reject("/research pike_and_shot")
	node.prerequisiteCount=0
	// Definitions were repaired; a valid action still completes once.
	f.succeed("/research pike_and_shot","pike_and_shot")
	entitlementReceipt("failure")

@test function institutionsPreserveSharedContentProvenanceAndAllFiveUnlockKinds()
	let f=new ResearchFixture()
	f.completions("|u,player,military_fiscal_state|u,player,galleon_design|u,player,dockyard_logistics|u,player,trace_italienne|u,player,cadastral_survey")
	f.runtime.technologies.cost("naval_administration",1450,0,0).assertEquals(5520)
	f.succeed("/institution naval_administration","naval_administration")
	f.succeed("/research siege_engineering_corps","siege_engineering_corps")
	f.succeed("/institution movable_type_printing","movable_type_printing")
	let layer=f.effects.get("player")
	layer.has("ability","siege_engineering").assertTrue()
	layer.has("unit","common_sapper_corps").assertTrue()
	layer.has("policy","permanent_naval_board").assertTrue()
	layer.has("building","printing_house").assertTrue()
	(layer.identities().indexOf("player|dockyard_logistics|building|dry_dock;")>=0).assertTrue()
	(layer.identities().indexOf("player|naval_administration|building|dry_dock;")>=0).assertTrue()
	f.effects.boundContent="printing_house"
	f.commands.dispatch(null,"/institutions").assertTrue()
	(f.output.last.indexOf("movable_type_printing: building printing_house - earned (bound)")>=0).assertTrue()
	(f.output.last.indexOf("siege_engineering_corps: ability siege_engineering - earned (unbound)")>=0).assertTrue()
	let before=layer.identities()
	f.resources.controller="other"
	f.succeed("/research movable_type_printing","movable_type_printing")
	f.effects.get("player").identities().assertEquals(before)
	f.effects.get("other").identities().assertEquals("other|movable_type_printing|building|printing_house;")
	entitlementReceipt("stale")

@test function typedResearchReconstructsSupportedSavesWithoutGrantsOrStaleLayers()
	let f=new ResearchFixture()
	// Historical completion records remain authoritative without retroactive gates.
	f.completions("|u,player,mass_army_logistics|u,other,naval_administration")
	let saved=f.runtime.captureState()
	let playerLayer=f.effects.get("player").identities()
	let otherLayer=f.effects.get("other").identities()
	for schema=CAMPAIGN_SAVE_SCHEMA_OLDEST to CAMPAIGN_SAVE_SCHEMA_CURRENT
		codecRestore(f,saved,schema)
		f.effects.get("player").identities().assertEquals(playerLayer)
		f.effects.get("other").identities().assertEquals(otherLayer)
		var layer=f.effects.layers
		var layerCount=0
		while layer != null
			layerCount++
			layer=layer.next
		layerCount.assertEquals(2)
		f.effects.unrelatedModifier.assertEquals(47)
		f.effects.oneTimeGrants.assertEquals(0)
		f.reject("/research mass_army_logistics")
	let before=f.runtime.captureState()
	let calls=f.effects.calls
	f.runtime.restoreState(saved+"|u,other,missing_node").assertFalse()
	f.runtime.restoreState(saved+"|u,player,mass_army_logistics").assertFalse()
	f.runtime.captureState().assertEquals(before)
	f.effects.calls.assertEquals(calls)
	f.effects.get("player").identities().assertEquals(playerLayer)
	f.effects.get("other").identities().assertEquals(otherLayer)
	// One reconciliation clears obsolete controllers as well as replacing the current one.
	f.runtime.restoreState(f.initial).assertTrue()
	f.runtime.reconcile("player")
	f.effects.get("player").count.assertEquals(0)
	f.effects.get("other").count.assertEquals(0)
	f.effects.unrelatedModifier.assertEquals(47)
	f.effects.oneTimeGrants.assertEquals(0)
	entitlementReceipt("replay")

@test function typedIdentitySeparatesKindsEvenWhenContentIdsAreShared()
	let f=new ResearchFixture()
	let node=new RuntimeTechnology("typed_fixture","Typed fixture",1450,10)
	node.addUnlock(node.id,"unit","shared_content")
	node.addUnlock(node.id,"building","shared_content")
	node.addUnlock(node.id,"ability","shared_content")
	node.addUnlock(node.id,"policy","shared_content")
	node.addUnlock(node.id,"modifier","shared_content")
	f.runtime.technologies.register(node).assertTrue()
	f.succeed("/research typed_fixture","typed_fixture")
	f.effects.get("player").count.assertEquals(5)
	f.effects.get("player").identities().assertEquals("player|typed_fixture|unit|shared_content;player|typed_fixture|building|shared_content;player|typed_fixture|ability|shared_content;player|typed_fixture|policy|shared_content;player|typed_fixture|modifier|shared_content;")

@test function productionUnboundResearchNeverChangesWarcraftFoodCapacity()
	let f=new ResearchFixture()
	let production=new UnboundResearchEffects()
	f.runtime.technologies.effects=production
	let previous=GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP)
	SetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP,80)
	f.completions("|u,player,mobile_field_artillery|u,player,statistical_administration|u,player,standing_army_system")
	f.commands.dispatch(null,"/research mass_army_logistics").assertTrue()
	f.output.last.assertEquals("Action completed.")
	f.resources.balance.assertEquals(100000-13884)
	production.get("player").has("policy","mass_conscription").assertTrue()
	GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP).assertEquals(80)
	// A separately applied resource change survives repeated reconstruction.
	SetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP,95)
	let saved=f.runtime.captureState()
	for repeat=1 to 3
		f.runtime.restoreState(saved).assertTrue()
		f.runtime.reconcile("player")
		GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP).assertEquals(95)
		production.bindingStatus(f.runtime.technologies.get("mass_army_logistics").unlocks[0]).assertEquals(RESEARCH_UNBOUND)
	f.runtime.restoreState(f.initial).assertTrue()
	f.runtime.reconcile("player")
	production.get("player").count.assertEquals(0)
	GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP).assertEquals(95)
	SetPlayerState(Player(0),PLAYER_STATE_RESOURCE_FOOD_CAP,previous)
