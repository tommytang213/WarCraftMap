@test function allocationParity_cap()
	let f = new AllocationFixture(99, "navigation:99~", "sea_command:99~", "martial_signature")
	f.earn(250000)
	f.action("/chooseperk hero civic_veteran", false)
	f.check(1, 1, 1, 99, 99, false, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(1, 1, 1, 99, 99, false, false)
	f.action("/chooseperk hero martial_initiate", true)
	f.check(1, 1, 0, 99, 99, true, false)
	f.action("/chooseperk hero martial_initiate", false)
	f.check(1, 1, 0, 99, 99, true, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(1, 1, 0, 99, 99, true, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(1, 1, 0, 99, 99, true, false)
	f.action("/improveskill hero navigation", true)
	f.check(0, 1, 0, 100, 99, true, false)
	f.action("/improveskill hero navigation", false)
	f.check(0, 1, 0, 100, 99, true, false)
	f.action("/improvemastery hero sea_command", true)
	f.check(0, 0, 0, 100, 100, true, false)
	f.action("/improvemastery hero sea_command", false)
	f.check(0, 0, 0, 100, 100, true, false)
	f.action("/improveskill hero unknown", false)
	f.check(0, 0, 0, 100, 100, true, false)
	f.action("/improvemastery hero unknown", false)
	f.check(0, 0, 0, 100, 100, true, false)
	f.action("/chooseperk hero unknown", false)
	f.check(0, 0, 0, 100, 100, true, false)

@test function allocationParity_civic()
	let f = new AllocationFixture(1, "navigation:0~", "sea_command:0~", "civic_signature")
	f.earn(236350)
	f.action("/chooseperk hero martial_initiate", false)
	f.check(29, 6, 3, 0, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(false)
	f.hero.hasPerk("civic_veteran").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(false)
	f.action("/chooseperk hero civic_veteran", false)
	f.check(29, 6, 3, 0, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(false)
	f.hero.hasPerk("civic_veteran").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(false)
	f.action("/chooseperk hero civic_initiate", true)
	f.check(29, 6, 2, 0, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(false)
	f.action("/chooseperk hero civic_initiate", false)
	f.check(29, 6, 2, 0, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(false)
	f.action("/chooseperk hero civic_veteran", true)
	f.check(29, 6, 1, 0, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/chooseperk hero civic_veteran", false)
	f.check(29, 6, 1, 0, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/improveskill hero navigation", true)
	f.check(28, 6, 1, 1, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/improveskill hero navigation", true)
	f.check(27, 6, 1, 2, 0, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/improvemastery hero sea_command", true)
	f.check(27, 5, 1, 2, 1, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/improvemastery hero sea_command", true)
	f.check(27, 4, 1, 2, 2, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/improveskill hero unknown", false)
	f.check(27, 4, 1, 2, 2, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/improvemastery hero unknown", false)
	f.check(27, 4, 1, 2, 2, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)
	f.action("/chooseperk hero unknown", false)
	f.check(27, 4, 1, 2, 2, false, false)
	f.hero.hasPerk("civic_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "governors_council").assertEquals(true)
	f.hero.hasPerk("civic_veteran").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "trusted_intercessor").assertEquals(true)

@test function allocationParity_discovery()
	let f = new AllocationFixture(1, "navigation:0~", "sea_command:0~", "discovery_signature")
	f.earn(236350)
	f.action("/chooseperk hero martial_initiate", false)
	f.check(29, 6, 3, 0, 0, false, false)
	f.hero.hasPerk("discovery_initiate").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "far_horizon").assertEquals(false)
	f.hero.hasPerk("discovery_veteran").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "practical_genius").assertEquals(false)
	f.action("/chooseperk hero discovery_veteran", false)
	f.check(29, 6, 3, 0, 0, false, false)
	f.hero.hasPerk("discovery_initiate").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "far_horizon").assertEquals(false)
	f.hero.hasPerk("discovery_veteran").assertEquals(false)
	f.rpg.hasSelectedAbility("hero", "practical_genius").assertEquals(false)
	f.action("/chooseperk hero discovery_initiate", true)
	f.check(29, 6, 2, 0, 0, false, false)
	f.hero.hasPerk("discovery_initiate").assertEquals(true)
	f.rpg.hasSelectedAbility("hero", "far_horizon").assertEquals(true)
