package HeroAllocationVectorsTests
import HeroAllocationTests
import WarcraftRpgRuntime

// Generated by test_hero_allocations.py --write-vectors using the independent
// Python authority. Each action dispatches production commands after a valid
// registered quest reward; rejected actions compare complete live RPG state.

@test function allocationParity_chain()
	let f = new AllocationFixture(1, "navigation:0~", "sea_command:0~", "martial_signature")
	f.earn(236350)
	f.action("/chooseperk hero civic_veteran", false)
	f.check(29, 6, 3, 0, 0, false, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(29, 6, 3, 0, 0, false, false)
	f.action("/chooseperk hero martial_initiate", true)
	f.check(29, 6, 2, 0, 0, true, false)
	f.action("/chooseperk hero martial_initiate", false)
	f.check(29, 6, 2, 0, 0, true, false)
	f.action("/chooseperk hero martial_veteran", true)
	f.check(29, 6, 1, 0, 0, true, true)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(29, 6, 1, 0, 0, true, true)
	f.action("/improveskill hero navigation", true)
	f.check(28, 6, 1, 1, 0, true, true)
	f.action("/improveskill hero navigation", true)
	f.check(27, 6, 1, 2, 0, true, true)
	f.action("/improvemastery hero sea_command", true)
	f.check(27, 5, 1, 2, 1, true, true)
	f.action("/improvemastery hero sea_command", true)
	f.check(27, 4, 1, 2, 2, true, true)
	f.action("/improveskill hero unknown", false)
	f.check(27, 4, 1, 2, 2, true, true)
	f.action("/improvemastery hero unknown", false)
	f.check(27, 4, 1, 2, 2, true, true)
	f.action("/chooseperk hero unknown", false)
	f.check(27, 4, 1, 2, 2, true, true)

@test function allocationParity_level()
	let f = new AllocationFixture(1, "navigation:0~", "sea_command:0~", "martial_signature")
	f.earn(7100)
	f.action("/chooseperk hero civic_veteran", false)
	f.check(8, 1, 0, 0, 0, false, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(8, 1, 0, 0, 0, false, false)
	f.action("/chooseperk hero martial_initiate", false)
	f.check(8, 1, 0, 0, 0, false, false)
	f.action("/chooseperk hero martial_initiate", false)
	f.check(8, 1, 0, 0, 0, false, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(8, 1, 0, 0, 0, false, false)
	f.action("/chooseperk hero martial_veteran", false)
	f.check(8, 1, 0, 0, 0, false, false)
	f.action("/improveskill hero navigation", true)
	f.check(7, 1, 0, 1, 0, false, false)
	f.action("/improveskill hero navigation", true)
	f.check(6, 1, 0, 2, 0, false, false)
	f.action("/improvemastery hero sea_command", true)
	f.check(6, 0, 0, 2, 1, false, false)
	f.action("/improvemastery hero sea_command", false)
	f.check(6, 0, 0, 2, 1, false, false)
	f.action("/improveskill hero unknown", false)
	f.check(6, 0, 0, 2, 1, false, false)
	f.action("/improvemastery hero unknown", false)
	f.check(6, 0, 0, 2, 1, false, false)
	f.action("/chooseperk hero unknown", false)
	f.check(6, 0, 0, 2, 1, false, false)

@test function allocationParity_zero()
