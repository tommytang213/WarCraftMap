	f.rpg.journal.count = 2
	f.command("/accept ocean_of_accounts", false)
	f.compact.state = QUEST_COMPLETE
	f.compact.graph.legacyTerminal = true
	f.compact.completions = 1
	f.command("/accept ocean_of_accounts", false)
	f.rpg.journal.count = 3
	f.command("/accept ocean_of_accounts", false)
	f.archive.state = QUEST_COMPLETE
	f.archive.graph.legacyTerminal = true
	f.archive.completions = 1
	f.command("/accept ocean_of_accounts", true)
	f.accounts.graph.completedObjectiveIds.assertEquals("")

@test function authoredSettlementReturnRequiresActualTargetAndSeparateTurnIn()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.rpg.journal.quests[0] = f.salvage
	f.command("/accept licensed_salvage", true)
	// Initial licensing work is a domain condition, never a visit to its port.
	f.command("/interact lisbon", false)
	f.salvage.graph.completedObjectiveIds.assertEquals("")
	f.conditions.questId = f.salvage.id
	f.conditions.stageId = "take_contract"
	f.conditions.objectiveId = "record_contract"
	f.conditions.conditionId = "quest_institution_satisfied"
	f.conditions.refs = "institution:naval_administration~"
	f.conditions.receipt = "license_one"
	f.rpg.questEvent(f.salvage.id, "record_contract", "license_one").assertTrue()
	f.conditions.stageId = "recover_cargo"
	f.conditions.objectiveId = "search_known_waters"
	f.conditions.conditionId = "quest_discovery_satisfied"
	f.conditions.refs = "navigation_zone:iberian_atlantic~"
	// Even a correctly scoped receipt cannot be consumed twice at a new stage.
	f.rpg.questEvent(f.salvage.id, "search_known_waters", "license_one").assertFalse()
	f.conditions.receipt = "recovery_one"
	f.rpg.questEvent(f.salvage.id, "search_known_waters", "recovery_one").assertTrue()
	f.move("london")
	f.command("/interact london", false)
	f.command("/turnin licensed_salvage hero", false)
	f.move("lisbon")
	f.command("/interact quest_location_lisbon", true)
	f.salvage.state.assertEquals(QUEST_READY)
	f.salvage.completions.assertEquals(0)
	f.command("/turnin licensed_salvage hero", true)
	f.command("/turnin licensed_salvage hero", false)

