@test function questCandidateRejectsForgedPathsObjectivesAndPrematureReadinessAtomically()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.reachFork()
	let before = f.rpg.captureState()
	let prefix = "v5|p,hero|h,hero,1,1,0,0,0,0,50,0,0,0,field,,,,,,,|q,europe_printed_compact,"
	f.rpg.restoreState(prefix + "ready_to_turn_in,0,0,0,carry_compact,carry_compact~,reach_london~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,return_compact,carry_compact~return_compact~,reach_london~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,negotiate,carry_compact~negotiate~,reach_london~preserve_copy~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,negotiate,carry_compact~negotiate~,win_recognition~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,negotiate,carry_compact~negotiate~,reach_london~,same~same~,0|j,,0").assertFalse()
	f.rpg.captureState().assertEquals(before)

@test function legacyQuestCountersMigrateWithoutInventedEvidenceOrRepeatedRewards()
	for schema = 2 to 4
		let f = new AuthoredFixture()
		registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
		var prefix = "v" + schema.toString()
		if schema >= 3
			prefix += "|p,hero"
		prefix += "|h,hero,1,2,7,1,0,0,50,0,0,0,field,,,,,"
		if schema >= 4
			prefix += ",,"
		let active = prefix + "|q,europe_printed_compact,ready_to_turn_in,1,90,0|j,europe_printed_compact,37"
		let codec = new PlayableCampaignCodec(f.state.clock)
		let authority = f.state.captureAuthoritativeState() + ";rpg=" + active
		let decoded = codec.decodeMigrateAndValidate(codec.encode("manual_01", SAVE_SLOT_MANUAL, 1, "legacy", authority), "manual_01")
		f.state.reconstructRuntime(decoded).assertTrue()
		f.state.activateAuthoritativeState(decoded)
		f.compact.state.assertEquals(QUEST_ACTIVE)
		f.compact.graph.activeStageId.assertEquals("carry_compact")
		f.compact.graph.completedObjectiveIds.assertEquals("")
		f.rpg.journal.currency.assertEquals(37)
		f.command("/turnin europe_printed_compact hero", false)
		f.roundTrip()
		f.rpg.restoreState(prefix + "|q,europe_printed_compact,complete,1,90,1|j,europe_printed_compact,37").assertTrue()
		f.compact.graph.legacyTerminal.assertTrue()
		f.compact.graph.reachedStageIds.assertEquals("")
		f.compact.graph.completedObjectiveIds.assertEquals("")
		f.roundTrip()
		f.command("/turnin europe_printed_compact hero", false)
		f.rpg.journal.currency.assertEquals(37)
		f.rpg.heroes.get("hero").experience.assertEquals(7)
		f.rpg.restoreState(prefix + "|q,europe_printed_compact,complete,1,0,0|j,europe_printed_compact,37").assertTrue()
		f.command("/interact lisbon", false)
		f.rpg.journal.refill(100)
		f.compact.state.assertEquals(QUEST_COMPLETE)
		f.compact.completions.assertEquals(0)
		f.rpg.journal.currency.assertEquals(37)
		f.roundTrip()
		f.rpg.restoreState(prefix + "|q,europe_printed_compact,failed,1,90,0|j,,37").assertTrue()
		f.compact.state.assertEquals(QUEST_FAILED)
		f.compact.graph.legacyTerminal.assertTrue()
		f.roundTrip()

function loadBranch(LoadFixture fixture, string branch)
	let authored = new AuthoredFixture()
	registerRpgRuntimeCommands(authored.commands, authored.rpg).assertEquals("")
	let q = authored.compact
	fixture.rpg.journal.quests[0] = q
	fixture.rpg.journal.trackedId = q.id
	fixture.rpg.journal.accept(q.id).assertTrue()
	q.graph.completeObjective("reach_london").assertTrue()
	fixture.rpg.journal.advance(q.id, branch).assertTrue()
	fixture.rpg.reconcile("player")

@test function failedCampaignLoadRollsBackQuestBranchAndRewardsWithoutReplayingProgress()
	let source = new LoadFixture()
	loadBranch(source, "negotiate")
	let other = new LoadFixture()
	loadBranch(other, "secure_archive")
	other.rpg.journal.currency = 77
	let candidate = other.campaign.state.captureAuthoritativeState()
	source.ports.failParty = true
	source.rejectAndVerify(candidate)
	source.rpg.journal.quests[0].graph.activeStageId.assertEquals("negotiate")
	source.rpg.journal.quests[0].graph.completedObjectiveIds.assertEquals("reach_london~")
	source.ports.failParty = false
	for i = 1 to 2
		source.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		source.rpg.journal.quests[0].graph.activeStageId.assertEquals("secure_archive")
		source.rpg.journal.quests[0].graph.completedObjectiveIds.assertEquals("reach_london~")
		source.rpg.journal.currency.assertEquals(77)
		source.rpg.journal.quests[0].completions.assertEquals(0)

function growthReceipt(string caseName)
	print("TRACEABILITY {\"requirement\":\"REQ-0091.01\",\"case\":\"" + caseName + "\",\"entryPoint\":\"live-earned-hero-growth\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"outcome\",\"persistence\",\"transition\"]}")

@test function registeredQuestGrowthUsesConvexExperienceAndEarnsCapPointsOnce()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	f.compact.rewardExperience = 300
	f.readyForGrowth()
	f.command("/turnin europe_printed_compact hero", true)
	assertBalances(hero, 2, 200, 1, 0, 0)
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)
	assertBalances(hero, 2, 200, 1, 0, 0)
	let cap = new AuthoredFixture()
	registerRpgRuntimeCommands(cap.commands, cap.rpg).assertEquals("")
	cap.compact.rewardExperience = 226126225
	cap.readyForGrowth()
	cap.command("/turnin europe_printed_compact hero", true)
	assertBalances(cap.rpg.heroes.get("hero"), 300, 0, 299, 60, 30)
	cap.roundTrip()
	cap.command("/turnin europe_printed_compact hero", false)
	assertBalances(cap.rpg.heroes.get("hero"), 300, 0, 299, 60, 30)
	growthReceipt("success")

@test function invalidRegisteredQuestGrowthLeavesQuestCurrencyAndProgressionIntact()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	f.readyForGrowth()
	hero.awardExperience(2147483647).assertTrue()
	f.command("/turnin europe_printed_compact hero", false)
	assertBalances(hero, 300, 1921357422, 299, 60, 30)
	f.compact.rewardExperience = -1
	f.command("/turnin europe_printed_compact hero", false)
	f.compact.completions.assertEquals(0)
	f.rpg.journal.currency.assertEquals(0)
	f.roundTrip()
	assertBalances(hero, 300, 1921357422, 299, 60, 30)
	// A legitimate zero-XP quest still commits its other existing reward.
	f.compact.rewardExperience = 0
	f.command("/turnin europe_printed_compact hero", true)
	assertBalances(hero, 300, 1921357422, 299, 60, 30)
	f.rpg.journal.currency.assertEquals(37)
	growthReceipt("failure")

@test function registeredGrowthResumesReadyQuestAndRejectsRemoteStaleTurnin()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	hero.level = 299
	hero.experience = heroNextLevelExperience(299) - 100
	f.readyForGrowth()
	f.roundTrip()
	f.move("london")
	f.command("/turnin europe_printed_compact hero", false)
	f.move("lisbon")
	f.command("/turnin europe_printed_compact hero", true)
	assertBalances(hero, 300, 0, 1, 1, 1)
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)
	assertBalances(hero, 300, 0, 1, 1, 1)
	growthReceipt("stale")

@test function registeredGrowthBelongsToSelectedCharacterAcrossRepeatedReconstruction()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	let companion = new RpgHero("companion", "Companion", 'Hpal')
	companion.recruited = true
	companion.assignment = "field"
	companion.level = 9
	companion.experience = 2400
	f.rpg.heroes.register(companion)
	f.readyForGrowth()
	f.command("/turnin europe_printed_compact companion", false)
	f.actors.selected = 1
	f.command("/turnin europe_printed_compact companion", true)
	assertBalances(companion, 10, 0, 1, 1, 1)
	assertBalances(hero, 1, 0, 0, 0, 0)
	let saved = f.rpg.captureState()
	for attempt = 1 to 3
		f.rpg.restoreState(saved).assertTrue()
		// Abstract the companion so reconstruction needs no native unit.
		companion.assignment = "reserve"
		f.rpg.reconstruct(null, 0., 0., "player")
		companion.assignment = "field"
		f.command("/turnin europe_printed_compact companion", false)
		f.rpg.captureState().assertEquals(saved)
	assertBalances(companion, 10, 0, 1, 1, 1)
	assertBalances(hero, 1, 0, 0, 0, 0)
	growthReceipt("replay")

@test function questCurrencyTurnInRejectsOverflowAndPreservesStateAcrossSave()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.readyForGrowth()
	f.rpg.journal.currency = 2147483630
	f.compact.rewardCurrency = 37
	f.command("/turnin europe_printed_compact hero", false)
	f.compact.state.assertEquals(QUEST_READY)
	f.compact.completions.assertEquals(0)
	f.rpg.journal.currency.assertEquals(2147483630)
	f.roundTrip()
	// Exact signed 32-bit ceiling is legal and survives the real save codec.
	f.compact.rewardCurrency = 17
	f.command("/turnin europe_printed_compact hero", true)
	f.rpg.journal.currency.assertEquals(2147483647)
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)
	f.rpg.journal.currency.assertEquals(2147483647)

@test function questCurrencyRejectsNegativeRewardsButRetainsHistoricalNegativeBalances()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.readyForGrowth()
	// Old journal records permit negative values: loading them must not be broken.
	f.rpg.journal.currency = -10
	f.compact.rewardCurrency = -1
	f.command("/turnin europe_printed_compact hero", false)
	f.compact.state.assertEquals(QUEST_READY)
	f.rpg.journal.currency.assertEquals(-10)
	f.roundTrip()
	f.compact.rewardCurrency = 17
	f.command("/turnin europe_printed_compact hero", true)
	f.rpg.journal.currency.assertEquals(7)
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)
	f.rpg.journal.currency.assertEquals(7)

@test function legacyQuestCounterDoesNotWrapWhenAwardExceedsRemainingProgress()
	let journal = new QuestJournalRuntime()
	let q = new RuntimeQuest("counter_progress_overflow", "Counter progress overflow", "simple")
	q.objectiveTarget = 10
	journal.register(q)
	journal.accept(q.id).assertTrue()
	journal.progress(q.id, 3).assertTrue()
	q.objective.assertEquals(3)
	journal.progress(q.id, 2147483647).assertTrue()
	q.objective.assertEquals(10)
	q.state.assertEquals(QUEST_READY)
	journal.progress(q.id, 1).assertFalse()
	q.objective.assertEquals(10)

@test function legacyQuestCounterClampsAtMaxIntAndKeepsHistoricalNegativeProgress()
	let journal = new QuestJournalRuntime()
	let q = new RuntimeQuest("counter_near_limit", "Near limit", "simple")
	q.objectiveTarget = 2147483647
	journal.register(q)
	journal.accept(q.id).assertTrue()
	journal.progress(q.id, 2147483646).assertTrue()
	q.objective.assertEquals(2147483646)
	journal.progress(q.id, 5).assertTrue()
	q.objective.assertEquals(2147483647)
	q.state.assertEquals(QUEST_READY)
	let historical = new RuntimeQuest("counter_historical", "Historical counter", "simple")
	historical.objectiveTarget = 10
	journal.register(historical)
	journal.accept(historical.id).assertTrue()
	historical.objective = -5
	journal.progress(historical.id, 6).assertTrue()
	historical.objective.assertEquals(1)
	journal.progress(historical.id, 0).assertFalse()
	historical.objective.assertEquals(1)
	journal.progress(historical.id, 9).assertTrue()
	historical.objective.assertEquals(10)
	historical.state.assertEquals(QUEST_READY)

@test function verifiedPlayerResearchCompletesOnlyItsExplicitQuestObjective()
	let rpg = new WarcraftRpgRuntime(null)
	let technology = new RuntimeTechnology("celestial_navigation", "Celestial navigation", 1450, 1)
	rpg.technologies.register(technology).assertTrue()
	let authoredQuest = new RuntimeQuest("research_proof", "Research proof", "regional")
	authoredQuest.graph = new QuestGraph("research", "")
	authoredQuest.graph.addStage(new QuestStage("research", "Prove navigation", "navigation~", ""))
	authoredQuest.graph.addObjective(new QuestObjective("navigation", "Complete celestial navigation", "quest_technology_satisfied", "technology:celestial_navigation~", "research_unlocked"))
	rpg.journal.register(authoredQuest)
	let pending = new RuntimeQuest("unbound_research", "Unbound research", "regional")
	pending.graph = new QuestGraph("research", "")
	pending.graph.addStage(new QuestStage("research", "No false proof", "navigation~", ""))
	pending.graph.addObjective(new QuestObjective("navigation", "Still needs a receipt", "quest_technology_satisfied", "technology:celestial_navigation~", "domain_receipt"))
	rpg.journal.register(pending)
	rpg.acceptQuest(authoredQuest.id).assertTrue()
	rpg.acceptQuest(pending.id).assertTrue()
	rpg.research("foreign_controller", "celestial_navigation", 1450, 1).assertTrue()
	authoredQuest.state.assertEquals(QUEST_ACTIVE)
	rpg.research("player", "celestial_navigation", 1450, 1).assertTrue()
	authoredQuest.state.assertEquals(QUEST_READY)
	pending.state.assertEquals(QUEST_ACTIVE)
	rpg.research("player", "celestial_navigation", 1450, 1).assertFalse()
	authoredQuest.graph.completedObjectiveIds.assertEquals("navigation~")
	pending.graph.completedObjectiveIds.assertEquals("")

@test function alreadyUnlockedPlayerResearchIsValidatedAtQuestAcceptance()
	let rpg = new WarcraftRpgRuntime(null)
	let technology = new RuntimeTechnology("celestial_navigation", "Celestial navigation", 1450, 1)
	rpg.technologies.register(technology).assertTrue()
	rpg.research("player", "celestial_navigation", 1450, 1).assertTrue()
	let authoredQuest = new RuntimeQuest("existing_research", "Existing research", "regional")
	authoredQuest.graph = new QuestGraph("study", "")
	authoredQuest.graph.addStage(new QuestStage("study", "Study", "navigation~", ""))
	authoredQuest.graph.addObjective(new QuestObjective("navigation", "Verify existing research", "quest_technology_satisfied", "technology:celestial_navigation~", "research_unlocked"))
	rpg.journal.register(authoredQuest)
	rpg.acceptQuest(authoredQuest.id).assertTrue()
	authoredQuest.state.assertEquals(QUEST_READY)
	authoredQuest.graph.completedObjectiveIds.assertEquals("navigation~")

@test function failedQuestCooldownRejectsOverflowAndInvalidDateWithoutMutation()
	let journal = new QuestJournalRuntime()
	let q = new RuntimeQuest("failed_cooldown", "Failed cooldown", "local")
	q.completionCap = 3
	journal.register(q)
	journal.accept(q.id).assertTrue()
	journal.fail(q.id, 2147483646, 10).assertFalse()
	journal.fail(q.id, 100, -1).assertFalse()
	journal.fail(q.id, -1, 10).assertFalse()
	q.state.assertEquals(QUEST_ACTIVE)
	q.cooldownUntil.assertEquals(0)
	journal.fail(q.id, 100, 30).assertTrue()
	q.state.assertEquals(QUEST_FAILED)
	q.cooldownUntil.assertEquals(130)
	journal.refill(129)
	q.state.assertEquals(QUEST_FAILED)
	journal.refill(130)
	q.state.assertEquals(QUEST_OFFERED)

@test function completedQuestCooldownCannotWrapAndGrantAnEarlyRepeat()
	let journal = new QuestJournalRuntime()
	let q = new RuntimeQuest("completed_cooldown", "Completed cooldown", "local")
	q.completionCap = 3
	q.rewardCurrency = 10
	journal.register(q)
	let hero = new RpgHero("cooldown_hero", "Cooldown hero", 'Hpal')
	hero.recruited = true
	journal.accept(q.id).assertTrue()
	journal.progress(q.id, 1).assertTrue()
	q.state.assertEquals(QUEST_READY)
	journal.turnIn(q.id, hero, 2147483646, 10).assertFalse()
	journal.turnIn(q.id, hero, 100, -1).assertFalse()
	journal.turnIn(q.id, hero, -1, 10).assertFalse()
	q.state.assertEquals(QUEST_READY)
	q.completions.assertEquals(0)
	journal.currency.assertEquals(0)
	journal.turnIn(q.id, hero, 100, 30).assertTrue()
	q.state.assertEquals(QUEST_COMPLETE)
	q.cooldownUntil.assertEquals(130)
	q.completions.assertEquals(1)
	journal.currency.assertEquals(10)
	journal.refill(129)
	q.state.assertEquals(QUEST_COMPLETE)
	journal.refill(130)
	q.state.assertEquals(QUEST_OFFERED)


/** Existing research is authority, not a repeat purchase or a forged receipt. */
function preparePreownedResearch(AuthoredFixture f, string firstBinding, string firstCondition, string firstRefs)
	let technology = new RuntimeTechnology("preowned_navigation", "Preowned navigation", 1450, 1)
	f.rpg.technologies.register(technology).assertTrue()
	f.rpg.research("player", "preowned_navigation", 1450, 1).assertTrue()
	destroy f.compact.graph
	f.compact.graph = new QuestGraph("first", "")
	f.compact.graph.addStage(new QuestStage("first", "First action", "first_objective~", "research~"))
	f.compact.graph.addStage(new QuestStage("research", "Verify research", "navigation~", ""))
	f.compact.graph.addObjective(new QuestObjective("first_objective", "First action", firstCondition, firstRefs, firstBinding))
	f.compact.graph.addObjective(new QuestObjective("navigation", "Verify earned navigation", "quest_technology_satisfied", "technology:preowned_navigation~", "research_unlocked"))

@test function validatedReceiptAdvancementRecognizesPreviouslyEarnedResearch()
	let f = new AuthoredFixture()
	preparePreownedResearch(f, "domain_receipt", "quest_diplomacy_satisfied", "settlement:lisbon~")
	f.rpg.acceptQuest(f.compact.id).assertTrue()
	f.receipt("first", "first_objective", "quest_diplomacy_satisfied", "settlement:lisbon~", "consultation")
	f.rpg.questEvent(f.compact.id, "first_objective", "forged").assertFalse()
	f.compact.graph.completedObjectiveIds.assertEquals("")
	f.rpg.questEvent(f.compact.id, "first_objective", "consultation").assertTrue()
	f.compact.state.assertEquals(QUEST_READY)
	f.compact.graph.completedObjectiveIds.assertEquals("first_objective~navigation~")
	let after = f.rpg.captureState()
	f.rpg.questEvent(f.compact.id, "first_objective", "consultation").assertFalse()
	f.rpg.research("player", "preowned_navigation", 1450, 1).assertFalse()
	f.rpg.captureState().assertEquals(after)

@test function physicalVisitAdvancementRecognizesPreviouslyEarnedResearch()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	preparePreownedResearch(f, "physical_visit", "quest_travel_satisfied", "settlement:london~")
	f.rpg.acceptQuest(f.compact.id).assertTrue()
	f.command("/interact quest_location_london", false)
	f.compact.graph.completedObjectiveIds.assertEquals("")
	f.move("london")
	f.command("/interact quest_location_london", true)
	f.compact.state.assertEquals(QUEST_READY)
	f.compact.graph.completedObjectiveIds.assertEquals("first_objective~navigation~")

@test function physicalAcceptanceRecognizesPreviouslyEarnedResearchWithoutTurnIn()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	preparePreownedResearch(f, "research_unlocked", "quest_technology_satisfied", "technology:preowned_navigation~")
	destroy f.compact.graph
	f.compact.graph = new QuestGraph("research", "")
	f.compact.graph.addStage(new QuestStage("research", "Verify research", "navigation~", ""))
	f.compact.graph.addObjective(new QuestObjective("navigation", "Verify earned navigation", "quest_technology_satisfied", "technology:preowned_navigation~", "research_unlocked"))
	f.command("/interact lisbon", true)
	f.compact.graph.activeStageId.assertEquals("research")
	f.compact.graph.completedObjectiveIds.assertEquals("navigation~")
	f.compact.state.assertEquals(QUEST_READY)
	f.rpg.journal.currency.assertEquals(0)

@test function receiptResearchSyncDoesNotAdvanceOtherQuestsOrCascadeStages()
	let f = new AuthoredFixture()
	preparePreownedResearch(f, "domain_receipt", "quest_diplomacy_satisfied", "settlement:lisbon~")
	let unrelated = new RuntimeQuest("unrelated_research", "Unrelated research", "regional")
	unrelated.graph = new QuestGraph("study", "")
	unrelated.graph.addStage(new QuestStage("study", "Study", "navigation~", ""))
	unrelated.graph.addObjective(new QuestObjective("navigation", "Research", "quest_technology_satisfied", "technology:preowned_navigation~", "research_unlocked"))
	f.rpg.journal.register(unrelated)
	// Model an active stage awaiting its own authorized action, not a new unlock.
	f.rpg.journal.accept(unrelated.id).assertTrue()
	f.compact.graph.stages[1].nextStageIds = "later~"
	f.compact.graph.addStage(new QuestStage("later", "Later research", "later_navigation~", ""))
	f.compact.graph.addObjective(new QuestObjective("later_navigation", "Later research", "quest_technology_satisfied", "technology:preowned_navigation~", "research_unlocked"))
	f.rpg.acceptQuest(f.compact.id).assertTrue()
	f.receipt("first", "first_objective", "quest_diplomacy_satisfied", "settlement:lisbon~", "scoped_consultation")
	f.rpg.questEvent(f.compact.id, "first_objective", "scoped_consultation").assertTrue()
	f.compact.graph.activeStageId.assertEquals("later")
	f.compact.graph.completedObjectiveIds.assertEquals("first_objective~navigation~")
	f.compact.state.assertEquals(QUEST_ACTIVE)
	unrelated.graph.completedObjectiveIds.assertEquals("")
	unrelated.state.assertEquals(QUEST_ACTIVE)
	let after = f.rpg.captureState()
	f.rpg.questEvent(f.compact.id, "first_objective", "scoped_consultation").assertFalse()
	f.rpg.captureState().assertEquals(after)

class ResearchKnowledgeOnlyVisit implements InteractionVisitListener
	override function recordVisit(InteractionLocation target) returns boolean
		return true

@test function knowledgeOnlyInteractionCannotSynchronizeAnUnrelatedResearchQuest()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	preparePreownedResearch(f, "research_unlocked", "quest_technology_satisfied", "technology:preowned_navigation~")
	f.rpg.journal.accept(f.compact.id).assertTrue()
	f.rpg.visits = new ResearchKnowledgeOnlyVisit()
	f.move("london")
	f.command("/interact quest_location_london", true)
	f.compact.graph.completedObjectiveIds.assertEquals("")
	f.compact.graph.activeStageId.assertEquals("first")
	f.compact.state.assertEquals(QUEST_ACTIVE)

/** Synthetic consecutive research stages exercise the generic continuation command. */
function prepareQuestCheck(AuthoredFixture f, boolean owned)
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let technology = new RuntimeTechnology("check_navigation", "Check navigation", 1450, 1)
	f.rpg.technologies.register(technology).assertTrue()
	if owned
		f.rpg.research("player", "check_navigation", 1450, 1).assertTrue()
	destroy f.compact.graph
	f.compact.graph = new QuestGraph("first", "")
	f.compact.graph.addStage(new QuestStage("first", "First", "first_check~", "second~"))
	f.compact.graph.addStage(new QuestStage("second", "Second", "second_check~", "third~"))
	f.compact.graph.addStage(new QuestStage("third", "Third", "third_check~", ""))
	f.compact.graph.addObjective(new QuestObjective("first_check", "First", "quest_technology_satisfied", "technology:check_navigation~", "research_unlocked"))
	f.compact.graph.addObjective(new QuestObjective("second_check", "Second", "quest_technology_satisfied", "technology:check_navigation~", "research_unlocked"))
	f.compact.graph.addObjective(new QuestObjective("third_check", "Third", "quest_technology_satisfied", "technology:check_navigation~", "research_unlocked"))
	f.rpg.journal.accept(f.compact.id).assertTrue()

@test function explicitQuestCheckAdvancesOneStageAndLeavesOtherQuestsUnchanged()
	let f = new AuthoredFixture()
	prepareQuestCheck(f, true)
	let other = new RuntimeQuest("other_check", "Other", "regional")
	other.graph = new QuestGraph("study", "")
	other.graph.addStage(new QuestStage("study", "Study", "check~", ""))
	other.graph.addObjective(new QuestObjective("check", "Check", "quest_technology_satisfied", "technology:check_navigation~", "research_unlocked"))
	f.rpg.journal.register(other)
	f.rpg.journal.accept(other.id).assertTrue()
	let before = f.rpg.captureState()
	journalText(f.rpg).contains("/questcheck " + f.compact.id).assertTrue()
	f.rpg.captureState().assertEquals(before)
	f.command("/questcheck " + f.compact.id, true)
	f.compact.graph.completedObjectiveIds.assertEquals("first_check~")
	f.compact.graph.activeStageId.assertEquals("second")
	f.command("/questcheck " + f.compact.id, true)
	f.compact.graph.completedObjectiveIds.assertEquals("first_check~second_check~")
	f.compact.graph.activeStageId.assertEquals("third")
	f.command("/questcheck " + f.compact.id, true)
	f.compact.state.assertEquals(QUEST_READY)
	f.compact.completions.assertEquals(0)
	f.rpg.journal.currency.assertEquals(0)
	other.graph.completedObjectiveIds.assertEquals("")
	other.state.assertEquals(QUEST_ACTIVE)
	f.command("/questcheck " + f.compact.id, false)

@test function explicitQuestCheckRejectsForeignNullUnownedAndUnknownWithoutMutation()
	let f = new AuthoredFixture()
	prepareQuestCheck(f, true)
	let before = f.rpg.captureState()
	f.commands.dispatch(Player(1), "/questcheck " + f.compact.id).assertTrue()
	f.rpg.captureState().assertEquals(before)
	f.commands.dispatch(null, "/questcheck " + f.compact.id).assertTrue()
	f.rpg.captureState().assertEquals(before)
	f.command("/questcheck absent_quest", false)
	let unowned = new AuthoredFixture()
	prepareQuestCheck(unowned, false)
	unowned.command("/questcheck " + unowned.compact.id, false)

@test function explicitQuestCheckContinuesAfterCurrentCodecRestore()
	let f = new AuthoredFixture()
	prepareQuestCheck(f, true)
	f.command("/questcheck " + f.compact.id, true)
	let saved = f.rpg.captureState()
	let restored = new AuthoredFixture()
	prepareQuestCheck(restored, false)
	restored.rpg.restoreState(saved).assertTrue()
	restored.rpg.reconcile("player")
	restored.compact.graph.activeStageId.assertEquals("second")
	restored.command("/questcheck " + restored.compact.id, true)
	restored.compact.graph.completedObjectiveIds.assertEquals("first_check~second_check~")
	restored.command("/questcheck " + restored.compact.id, true)
	restored.compact.state.assertEquals(QUEST_READY)
	restored.compact.completions.assertEquals(0)
