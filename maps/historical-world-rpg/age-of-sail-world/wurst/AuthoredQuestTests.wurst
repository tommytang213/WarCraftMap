/** Recording domain receipt boundary: it supplies no stage mutation. Tests
 * dispatch ordinary commands and use production validation, graph and codec. */
class RecordedQuestConditions implements QuestConditionAuthority
	string questId = ""
	string stageId = ""
	string objectiveId = ""
	string conditionId = ""
	string refs = ""
	string receipt = ""
	boolean available = true
	override function supports(string conditionId) returns boolean
		return available and (conditionId == "quest_diplomacy_satisfied" or conditionId == "quest_institution_satisfied" or conditionId == "quest_discovery_satisfied")
	override function validates(string questId, string stageId, QuestObjective objective, string receiptId) returns boolean
		return questId == this.questId and stageId == this.stageId and objective.id == objectiveId and objective.conditionId == conditionId and objective.entityRefs == refs and receipt == receiptId

class QuestActors implements InteractionActors
	int selected = 0
	real px = 0.
	real py = 0.
	override function present(int actor, player owner) returns boolean
		return actor == selected
	override function x(int actor) returns real
		return px
	override function y(int actor) returns real
		return py
	override function movement(int actor) returns int
		return 0

class QuestOutput implements CommandOutput
	string last = ""
	override function show(player sender, string message)
		last = message

class AuthoredFixture
	WarcraftRpgRuntime rpg = new WarcraftRpgRuntime(null)
	RuntimeQuest compact
	RuntimeQuest accounts
	RuntimeQuest archive
	RuntimeQuest salvage
	QuestActors actors = new QuestActors()
	QuestOutput output = new QuestOutput()
	RecordedQuestConditions conditions = new RecordedQuestConditions()
	CommandRegistry commands = new CommandRegistry(false, 8, new CommandText(), output)
	PlayableCampaignState state
	construct()
		configureGeneratedRpg(rpg)
		configureGeneratedInteractions(rpg.interactions)
		compact = rpg.journal.get("europe_printed_compact")
		accounts = rpg.journal.get("ocean_of_accounts")
		archive = rpg.journal.get("africa_niger_manuscripts")
		salvage = rpg.journal.get("licensed_salvage")
		for i = 0 to rpg.journal.count - 1
			let q = rpg.journal.quests[i]
			if q != compact and q != accounts and q != archive and q != salvage
				destroy q
		rpg.journal.quests[0] = compact
		rpg.journal.quests[1] = accounts
		rpg.journal.quests[2] = archive
		rpg.journal.quests[3] = salvage
		rpg.journal.count = 1
		rpg.treasures.count = 0
		rpg.heroes.count = 0
		let hero = new RpgHero("hero", "Traveler", 'Hpal')
		hero.recruited = true
		hero.assignment = "field"
		rpg.heroes.register(hero)
		rpg.heroes.mainCharacterId = "hero"
		compact.rewardCurrency = 37
		rpg.journal.conditions = conditions
		rpg.interactions.actors = actors
		state = new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1450, 1820, 1450, 1.))
		installCampaignClock(state.clock)
		state.identity = new PlayerCampaignIdentity()
		state.identity.startCampaign("portugal", "europe_west", "europe_iberia_western_med", "lisbon").assertTrue()
		state.loadedPhysicalMap = "europe_west"
		state.authority = replaceCampaignField(state.authority, "map", "europe_west")
		state.setRpgRuntime(rpg)
		rpg.interactions.maps = new CampaignInteractionMaps(state)
		move("lisbon")
	function move(string id)
		let target = rpg.interactions.get(id)
		actors.px = target.x
		actors.py = target.y
	function command(string text, boolean accepted)
		let before = rpg.captureState()
		commands.dispatch(null, text).assertTrue()
		if accepted
			output.last.assertEquals("Action completed.")
		else
			output.last.assertEquals("Requirements are not met here.")
			rpg.captureState().assertEquals(before)
	function receipt(string stageId, string objectiveId, string conditionId, string refs, string receiptId)
		conditions.questId = compact.id
		conditions.stageId = stageId
		conditions.objectiveId = objectiveId
		conditions.conditionId = conditionId
		conditions.refs = refs
		conditions.receipt = receiptId
	function reachFork()
		command("/accept europe_printed_compact", true)
		command("/interact lisbon", false)
		command("/turnin europe_printed_compact hero", false)
		command("/queststage europe_printed_compact negotiate", false)
		move("london")
		command("/interact quest_location_london", true)
		compact.graph.activeStageId.assertEquals("carry_compact")
		compact.graph.completedObjectiveIds.assertEquals("reach_london~")
		command("/interact london", false)
		command("/queststage europe_printed_compact return_compact", false)
	function readyForGrowth()
		reachFork()
		command("/queststage europe_printed_compact secure_archive", true)
		receipt("secure_archive", "preserve_copy", "quest_institution_satisfied", "institution:movable_type_printing~", "growth_receipt")
		rpg.questEvent(compact.id, "preserve_copy", "growth_receipt").assertTrue()
		command("/turnin europe_printed_compact hero", false)
		move("lisbon")
		command("/interact lisbon", true)
		compact.state.assertEquals(QUEST_READY)
	function returnAndTurnIn()
		compact.state.assertEquals(QUEST_ACTIVE)
		compact.graph.activeStageId.assertEquals("return_compact")
		compact.destinationId.assertEquals("quest_location_lisbon")
		command("/turnin europe_printed_compact hero", false)
		command("/interact london", false)
		move("lisbon")
		command("/interact lisbon", true)
		compact.state.assertEquals(QUEST_READY)
		rpg.journal.currency.assertEquals(0)
		command("/turnin europe_printed_compact hero", true)
		compact.state.assertEquals(QUEST_COMPLETE)
		compact.precision.assertEquals("hidden")
		compact.destinationId.assertEquals("")
		rpg.journal.currency.assertEquals(37)
		command("/turnin europe_printed_compact hero", false)
		command("/interact lisbon", false)
		rpg.heroes.get("hero").level.assertEquals(2)
	function roundTrip()
		let expected = rpg.captureState()
		let codec = new PlayableCampaignCodec(state.clock)
		let encoded = codec.encode("manual_01", SAVE_SLOT_MANUAL, 1, "quest", state.captureAuthoritativeState())
		let decoded = codec.decodeMigrateAndValidate(encoded, "manual_01")
		(decoded != "").assertTrue()
		let destination = new AuthoredFixture()
		registerRpgRuntimeCommands(destination.commands, destination.rpg).assertEquals("")
		for i = 1 to 2
			destination.state.reconstructRuntime(decoded).assertTrue()
			destination.state.activateAuthoritativeState(decoded)
			destination.rpg.reconcile("player")
			destination.rpg.captureState().assertEquals(expected)
		rpg.restoreState(destination.rpg.captureState()).assertTrue()

@test function printedCompactLisbonAloneCannotCompleteAndUnscopedEventsCannotProveObjectives()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.command("/interact lisbon", true)
	f.compact.graph.activeStageId.assertEquals("carry_compact")
	f.compact.graph.completedObjectiveIds.assertEquals("")
	f.compact.destinationId.assertEquals("quest_location_london")
	for i = 1 to 3
		f.command("/interact quest_location_lisbon", false)
		f.command("/turnin europe_printed_compact hero", false)
		f.rpg.worldEventAt("combat", "london", 100, 0).assertFalse()
		f.rpg.worldEventAt("settlement", "lisbon", 1, 0).assertFalse()
		f.rpg.journal.progress(f.compact.id, 999).assertFalse()
	f.compact.graph.completedObjectiveIds.assertEquals("")
	f.rpg.journal.currency.assertEquals(0)
	f.roundTrip()

@test function printedCompactNegotiationBranchRequiresMatchingReceiptAndPhysicalReturn()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.reachFork()
	f.receipt("negotiate", "win_recognition", "quest_diplomacy_satisfied", "polity:england~", "recognition_one")
	f.rpg.questEvent(f.compact.id, "win_recognition", "recognition_one").assertFalse()
	f.command("/queststage europe_printed_compact negotiate", true)
	f.compact.precision.assertEquals("hidden")
	f.compact.destinationId.assertEquals("")
	f.command("/interact london", false)
	f.conditions.refs = "polity:portugal~"
	f.rpg.questEvent(f.compact.id, "win_recognition", "recognition_one").assertFalse()
	f.conditions.refs = "polity:england~"
	f.conditions.conditionId = "quest_institution_satisfied"
	f.rpg.questEvent(f.compact.id, "win_recognition", "recognition_one").assertFalse()
	f.conditions.conditionId = "quest_diplomacy_satisfied"
	f.rpg.questEvent(f.compact.id, "preserve_copy", "recognition_one").assertFalse()
	f.rpg.questEvent(f.compact.id, "win_recognition", "unknown_receipt").assertFalse()
	f.conditions.available = false
	f.rpg.questEvent(f.compact.id, "win_recognition", "recognition_one").assertFalse()
	(f.rpg.journal.lastDiagnostic.indexOf("integration unavailable") >= 0).assertTrue()
	(journalText(f.rpg).indexOf("condition integration pending") >= 0).assertTrue()
	f.conditions.available = true
	f.roundTrip()
	f.rpg.questEvent(f.compact.id, "win_recognition", "recognition_one").assertTrue()
	f.rpg.questEvent(f.compact.id, "win_recognition", "recognition_one").assertFalse()
	questHas(f.compact.graph.completedObjectiveIds, "preserve_copy").assertFalse()
	f.roundTrip()
	f.returnAndTurnIn()
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)

@test function printedCompactArchiveBranchRetainsChoiceAndRejectsOtherBranchAfterRestore()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.reachFork()
	f.command("/queststage europe_printed_compact secure_archive", true)
	f.command("/queststage europe_printed_compact negotiate", false)
	f.roundTrip()
	f.receipt("secure_archive", "preserve_copy", "quest_institution_satisfied", "institution:movable_type_printing~", "archive_one")
	f.rpg.questEvent(f.compact.id, "win_recognition", "archive_one").assertFalse()
	f.rpg.questEvent(f.compact.id, "preserve_copy", "archive_one").assertTrue()
	f.compact.graph.reachedStageIds.assertEquals("carry_compact~secure_archive~return_compact~")
	f.roundTrip()
	f.rpg.questEvent(f.compact.id, "preserve_copy", "archive_one").assertFalse()
	f.returnAndTurnIn()
	questHas(f.compact.graph.completedObjectiveIds, "win_recognition").assertFalse()

@test function authoredAcceptanceRejectsUnavailableAndMissingPrerequisites()
