@test function questCandidateRejectsForgedPathsObjectivesAndPrematureReadinessAtomically()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.reachFork()
	let before = f.rpg.captureState()
	let prefix = "v5|p,hero|h,hero,1,1,0,0,0,0,50,0,0,0,field,,,,,,,|q,europe_printed_compact,"
	f.rpg.restoreState(prefix + "ready_to_turn_in,0,0,0,carry_compact,carry_compact~,reach_london~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,return_compact,carry_compact~return_compact~,reach_london~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,negotiate,carry_compact~negotiate~,reach_london~preserve_copy~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,negotiate,carry_compact~negotiate~,win_recognition~,,0|j,,0").assertFalse()
	f.rpg.restoreState(prefix + "active,0,0,0,negotiate,carry_compact~negotiate~,reach_london~,same~same~,0|j,,0").assertFalse()
	f.rpg.captureState().assertEquals(before)

@test function legacyQuestCountersMigrateWithoutInventedEvidenceOrRepeatedRewards()
	for schema = 2 to 4
		let f = new AuthoredFixture()
		registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
		var prefix = "v" + schema.toString()
		if schema >= 3
			prefix += "|p,hero"
		prefix += "|h,hero,1,2,7,1,0,0,50,0,0,0,field,,,,,"
		if schema >= 4
			prefix += ",,"
		let active = prefix + "|q,europe_printed_compact,ready_to_turn_in,1,90,0|j,europe_printed_compact,37"
		let codec = new PlayableCampaignCodec(f.state.clock)
		let authority = f.state.captureAuthoritativeState() + ";rpg=" + active
		let decoded = codec.decodeMigrateAndValidate(codec.encode("manual_01", SAVE_SLOT_MANUAL, 1, "legacy", authority), "manual_01")
		f.state.reconstructRuntime(decoded).assertTrue()
		f.state.activateAuthoritativeState(decoded)
		f.compact.state.assertEquals(QUEST_ACTIVE)
		f.compact.graph.activeStageId.assertEquals("carry_compact")
		f.compact.graph.completedObjectiveIds.assertEquals("")
		f.rpg.journal.currency.assertEquals(37)
		f.command("/turnin europe_printed_compact hero", false)
		f.roundTrip()
		f.rpg.restoreState(prefix + "|q,europe_printed_compact,complete,1,90,1|j,europe_printed_compact,37").assertTrue()
		f.compact.graph.legacyTerminal.assertTrue()
		f.compact.graph.reachedStageIds.assertEquals("")
		f.compact.graph.completedObjectiveIds.assertEquals("")
		f.roundTrip()
		f.command("/turnin europe_printed_compact hero", false)
		f.rpg.journal.currency.assertEquals(37)
		f.rpg.heroes.get("hero").experience.assertEquals(7)
		f.rpg.restoreState(prefix + "|q,europe_printed_compact,complete,1,0,0|j,europe_printed_compact,37").assertTrue()
		f.command("/interact lisbon", false)
		f.rpg.journal.refill(100)
		f.compact.state.assertEquals(QUEST_COMPLETE)
		f.compact.completions.assertEquals(0)
		f.rpg.journal.currency.assertEquals(37)
		f.roundTrip()
		f.rpg.restoreState(prefix + "|q,europe_printed_compact,failed,1,90,0|j,,37").assertTrue()
		f.compact.state.assertEquals(QUEST_FAILED)
		f.compact.graph.legacyTerminal.assertTrue()
		f.roundTrip()

function loadBranch(LoadFixture fixture, string branch)
	let authored = new AuthoredFixture()
	registerRpgRuntimeCommands(authored.commands, authored.rpg).assertEquals("")
	let q = authored.compact
	fixture.rpg.journal.quests[0] = q
	fixture.rpg.journal.trackedId = q.id
	fixture.rpg.journal.accept(q.id).assertTrue()
	q.graph.completeObjective("reach_london").assertTrue()
	fixture.rpg.journal.advance(q.id, branch).assertTrue()
	fixture.rpg.reconcile("player")

@test function failedCampaignLoadRollsBackQuestBranchAndRewardsWithoutReplayingProgress()
	let source = new LoadFixture()
	loadBranch(source, "negotiate")
	let other = new LoadFixture()
	loadBranch(other, "secure_archive")
	other.rpg.journal.currency = 77
	let candidate = other.campaign.state.captureAuthoritativeState()
	source.ports.failParty = true
	source.rejectAndVerify(candidate)
	source.rpg.journal.quests[0].graph.activeStageId.assertEquals("negotiate")
	source.rpg.journal.quests[0].graph.completedObjectiveIds.assertEquals("reach_london~")
	source.ports.failParty = false
	for i = 1 to 2
		source.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		source.rpg.journal.quests[0].graph.activeStageId.assertEquals("secure_archive")
		source.rpg.journal.quests[0].graph.completedObjectiveIds.assertEquals("reach_london~")
		source.rpg.journal.currency.assertEquals(77)
		source.rpg.journal.quests[0].completions.assertEquals(0)

function growthReceipt(string caseName)
	print("TRACEABILITY {\"requirement\":\"REQ-0091.01\",\"case\":\"" + caseName + "\",\"entryPoint\":\"live-earned-hero-growth\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"outcome\",\"persistence\",\"transition\"]}")

@test function registeredQuestGrowthUsesConvexExperienceAndEarnsCapPointsOnce()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	f.compact.rewardExperience = 300
	f.readyForGrowth()
	f.command("/turnin europe_printed_compact hero", true)
	assertBalances(hero, 2, 200, 1, 0, 0)
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)
	assertBalances(hero, 2, 200, 1, 0, 0)
	let cap = new AuthoredFixture()
	registerRpgRuntimeCommands(cap.commands, cap.rpg).assertEquals("")
	cap.compact.rewardExperience = 226126225
	cap.readyForGrowth()
	cap.command("/turnin europe_printed_compact hero", true)
	assertBalances(cap.rpg.heroes.get("hero"), 300, 0, 299, 60, 30)
	cap.roundTrip()
	cap.command("/turnin europe_printed_compact hero", false)
	assertBalances(cap.rpg.heroes.get("hero"), 300, 0, 299, 60, 30)
	growthReceipt("success")

@test function invalidRegisteredQuestGrowthLeavesQuestCurrencyAndProgressionIntact()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	f.readyForGrowth()
	hero.awardExperience(2147483647).assertTrue()
	f.command("/turnin europe_printed_compact hero", false)
	assertBalances(hero, 300, 1921357422, 299, 60, 30)
	f.compact.rewardExperience = -1
	f.command("/turnin europe_printed_compact hero", false)
	f.compact.completions.assertEquals(0)
	f.rpg.journal.currency.assertEquals(0)
	f.roundTrip()
	assertBalances(hero, 300, 1921357422, 299, 60, 30)
	// A legitimate zero-XP quest still commits its other existing reward.
	f.compact.rewardExperience = 0
	f.command("/turnin europe_printed_compact hero", true)
	assertBalances(hero, 300, 1921357422, 299, 60, 30)
	f.rpg.journal.currency.assertEquals(37)
	growthReceipt("failure")

@test function registeredGrowthResumesReadyQuestAndRejectsRemoteStaleTurnin()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	hero.level = 299
	hero.experience = heroNextLevelExperience(299) - 100
	f.readyForGrowth()
	f.roundTrip()
	f.move("london")
	f.command("/turnin europe_printed_compact hero", false)
	f.move("lisbon")
	f.command("/turnin europe_printed_compact hero", true)
	assertBalances(hero, 300, 0, 1, 1, 1)
	f.roundTrip()
	f.command("/turnin europe_printed_compact hero", false)
	assertBalances(hero, 300, 0, 1, 1, 1)
	growthReceipt("stale")

@test function registeredGrowthBelongsToSelectedCharacterAcrossRepeatedReconstruction()
	let f = new AuthoredFixture()
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	let hero = f.rpg.heroes.get("hero")
	let companion = new RpgHero("companion", "Companion", 'Hpal')
	companion.recruited = true
	companion.assignment = "field"
	companion.level = 9
	companion.experience = 2400
	f.rpg.heroes.register(companion)
	f.readyForGrowth()
	f.command("/turnin europe_printed_compact companion", false)
	f.actors.selected = 1
	f.command("/turnin europe_printed_compact companion", true)
	assertBalances(companion, 10, 0, 1, 1, 1)
	assertBalances(hero, 1, 0, 0, 0, 0)
	let saved = f.rpg.captureState()
	for attempt = 1 to 3
		f.rpg.restoreState(saved).assertTrue()
		// Abstract the companion so reconstruction needs no native unit.
		companion.assignment = "reserve"
		f.rpg.reconstruct(null, 0., 0., "player")
		companion.assignment = "field"
		f.command("/turnin europe_printed_compact companion", false)
		f.rpg.captureState().assertEquals(saved)
	assertBalances(companion, 10, 0, 1, 1, 1)
	assertBalances(hero, 1, 0, 0, 0, 0)
	growthReceipt("replay")
