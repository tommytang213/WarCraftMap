package HeroStartingProfileTests

import WarcraftRpgRuntime
import HeroProgression
import RecruitmentWindowTests
import CampaignLoadTransactionTests
import CampaignTimeline
import CampaignSaveManager
import ManagementScreenPauseController
import ManagementCommandTests
import CommandRouter
import ScenarioData
import Wurstunit

function startingFixture(string id) returns RecruitmentFixture
	let generated = new WarcraftRpgRuntime(null)
	configureGeneratedRpg(generated)
	let f = new RecruitmentFixture(configureCampaignTimeline(), generated.heroes.get(id))
	f.commands = new CommandRegistry(false, 6, new CommandText(), f.ports)
	f.rpg.management.pauses = new ManagementScreenPauseController(new RecordingManagementPorts(), false)
	return f

function startingReceipt(string caseName)
	print("TRACEABILITY {\"requirement\":\"REQ-0093.01\",\"case\":\"" + caseName + "\",\"entryPoint\":\"hero-first-recruitment\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"outcome\",\"persistence\",\"transition\"]}")

function assertStart(RecruitmentFixture f, string id, int level, string skills, string masteries, string tree)
	f.hero.level.assertEquals(1)
	f.hero.skillRanks.assertEquals("")
	f.clock.advanceTo(f.hero.availabilityStartDay).assertTrue()
	f.recruit()
	f.hero.level.assertEquals(level)
	f.hero.experience.assertEquals(0)
	f.hero.skillPoints.assertEquals(0)
	f.hero.masteryPoints.assertEquals(0)
	f.hero.choicePoints.assertEquals(0)
	f.hero.skillRanks.assertEquals(skills)
	f.hero.masteryRanks.assertEquals(masteries)
	f.hero.signatureProgressionId.assertEquals(tree)
	f.commands.dispatch(null, "/inventory " + id).assertTrue()
	f.ports.last.contains("Skills: ").assertTrue()
	f.ports.last.contains("Masteries: ").assertTrue()
	f.ports.last.contains("Personal tree: ").assertTrue()
	f.ports.last.contains("~").assertFalse()
	if id == "leonardo_da_vinci"
		f.ports.last.contains("engineering 57").assertTrue()
		f.ports.last.contains("learned arts 36").assertTrue()
		f.ports.last.contains("discovery signature").assertTrue()
	f.commands.dispatch(null, "/rpg-close").assertTrue()
	// An existing level-gated consumer sees the new authority immediately.
	let equipment = f.rpg.inventory.getItem("token")
	equipment.requiredLevel = level
	f.commands.dispatch(null, "/equip " + id + " token").assertTrue()
	f.rpg.inventory.equippedCount.assertEquals(1)
	f.hero.awardExperience(heroNextLevelExperience(level) - 1).assertTrue()
	f.hero.level.assertEquals(level)
	f.hero.skillPoints.assertEquals(0)
	f.hero.awardExperience(1)
	f.hero.level.assertEquals(level + 1)
	f.hero.experience.assertEquals(0)
	f.hero.skillPoints.assertEquals(1)
	f.hero.masteryPoints.assertEquals((level + 1) div 5 - level div 5)
	f.hero.choicePoints.assertEquals((level + 1) div 10 - level div 10)
	f.hero.skillRanks.assertEquals(skills)
	f.hero.masteryRanks.assertEquals(masteries)
	f.reject("/hire " + id, "That character is already recruited.")
	let progressed = f.rpg.captureState()
	f.saves.save(SAVE_SLOT_MANUAL, 1, "first-recruitment").assertTrue()
	f.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.rpg.reconstruct(null, 0., 0., "player")
	f.rpg.captureState().assertEquals(progressed)

@test function registeredRecruitmentAppliesComposedEarlyAndLateRoleProfiles()
	// Python checks these vectors against HeroProgressionRuntime._initial_state.
	var f = startingFixture("hang_tuah")
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	assertStart(f, "hang_tuah", 66, "command:58~diplomacy:58~navigation:58~", "land_warfare:37~sea_command:37~statecraft:37~", "martial_signature")
	f = startingFixture("leonardo_da_vinci")
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	assertStart(f, "leonardo_da_vinci", 64, "diplomacy:57~engineering:57~scholarship:57~", "learned_arts:36~statecraft:36~", "discovery_signature")
	f = startingFixture("horatio_nelson")
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	assertStart(f, "horatio_nelson", 115, "command:82~navigation:82~", "land_warfare:53~sea_command:53~", "martial_signature")
	startingReceipt("success")

@test function invalidStartingProfilesAndDatesRejectWithoutProgressionMutation()
	let f = startingFixture("leonardo_da_vinci")
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.reject("/recruit leonardo_da_vinci", "That character is unavailable on the current campaign date.")
	f.clock.advanceTo(f.hero.availabilityStartDay).assertTrue()
	let profile = f.hero.startingProfile
	profile.level = 301
	f.reject("/recruit leonardo_da_vinci", "That character's starting progression is invalid.")
	profile.level = 64
	profile.skills = "engineering:101~"
	f.reject("/recruit leonardo_da_vinci", "That character's starting progression is invalid.")
	profile.skills = "engineering:57~engineering:1~"
	f.reject("/hire leonardo_da_vinci", "That character's starting progression is invalid.")
	profile.skills = "unknown:1~"
	f.reject("/hire leonardo_da_vinci", "That character's starting progression is invalid.")
	profile.skills = "engineering:57~"
	profile.masteries = "learned_arts:-1~"
	f.reject("/hire leonardo_da_vinci", "That character's starting progression is invalid.")
	profile.masteries = "learned_arts:36~"
	profile.personalTreeId = "unknown_tree"
	f.reject("/hire leonardo_da_vinci", "That character's starting progression is invalid.")
	f.hero.skillRank("engineering").assertEquals(0)
	f.hero.masteryRank("learned_arts").assertEquals(0)
	startingReceipt("failure")

@test function profileStateSurvivesExpiryLoadTravelAuthorityAndRepeatedReconstruction()
	let f = startingFixture("horatio_nelson")
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.clock.advanceTo(f.hero.availabilityStartDay).assertTrue()
	f.recruit()
	f.hero.awardExperience(heroNextLevelExperience(115) + 7).assertTrue()
	f.hero.skillRanks = "command:83~navigation:84~"
	f.hero.masteryRanks = "land_warfare:54~sea_command:55~"
	f.hero.skillPoints = 9
	f.hero.masteryPoints = 4
	f.hero.signatureProgressionId = "retained_signature"
	f.hero.chosenPerks = "~earned_perk~" // Pre-allocation legacy entitlement fixture.
	f.rpg.heroes.assignRemote(f.hero.id, "fleet_command", "remote_region").assertTrue()
	f.clock.advanceTo(f.hero.availabilityEndDay + 1).assertTrue()
	f.reject("/hire horatio_nelson", "That character is already recruited.")
	f.saves.save(SAVE_SLOT_MANUAL, 1, "progressed-profile").assertTrue()
	let expected = f.rpg.captureState()
	let destination = startingFixture("horatio_nelson")
	registerRpgRuntimeCommands(destination.commands, destination.rpg).assertEquals("")
	destination.storage.payload = f.storage.payload
	for attempt = 1 to 3
		destination.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		destination.rpg.reconstruct(null, 0., 0., "player")
		destination.rpg.captureState().assertEquals(expected)
		destination.hero.skillRank("navigation").assertEquals(84)
		destination.hero.masteryRank("sea_command").assertEquals(55)
		destination.hero.level.assertEquals(116)
		destination.hero.experience.assertEquals(7)
		destination.reject("/recruit horatio_nelson", "That character is already recruited.")
	startingReceipt("stale")

@test function legacyProfilesMigrateWithoutStartingGrantsAndUnrecruitedStillInitialize()
	for schema = 2 to 3
		let f = startingFixture("leonardo_da_vinci")
		registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
		f.clock.advanceTo(f.hero.availabilityStartDay).assertTrue()
		var prefix = "v2"
		if schema == 3
			prefix = "v3|p,"
		let legacy = prefix + "|h,leonardo_da_vinci,1,42,73,9,4,777,100,1,0,0,adviser,remote,scholar,quest,signature,~perk~|i,token|j,,321"
		f.rpg.restoreState(legacy).assertTrue()
		f.hero.level.assertEquals(42)
		f.hero.experience.assertEquals(73)
		f.hero.skillPoints.assertEquals(9)
		f.hero.masteryPoints.assertEquals(4)
		f.hero.signatureProgressionId.assertEquals("signature")
		f.hero.skillRanks.assertEquals("")
		f.hero.masteryRanks.assertEquals("")
		f.reject("/hire leonardo_da_vinci", "That character is already recruited.")
		let migrated = f.rpg.captureState()
		f.rpg.restoreState(migrated).assertTrue()
		f.rpg.reconstruct(null, 0., 0., "player")
		f.rpg.captureState().assertEquals(migrated)
		f.rpg.restoreState(prefix + "|h,leonardo_da_vinci,0,1,0,0,0,0,50,0,0,0,unrecruited,,,,,|i,token|j,,321").assertTrue()
		f.saves.save(SAVE_SLOT_MANUAL, 1, "legacy-unrecruited").assertTrue()
		f.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		f.recruit()
		f.hero.level.assertEquals(64)
		f.hero.skillRank("engineering").assertEquals(57)
		f.hero.masteryRank("learned_arts").assertEquals(36)
	// Empty v1 domain remains eligible for the ordinary first-recruitment path.
	let empty = startingFixture("hang_tuah")
	registerRpgRuntimeCommands(empty.commands, empty.rpg).assertEquals("")
	empty.rpg.restoreState("v1").assertTrue()
	empty.recruit()
	empty.hero.level.assertEquals(66)

function rejectRanks(RecruitmentFixture f, string skills, string masteries)
	let before = f.state.captureAuthoritativeState()
	let record = "v4|p,|h,leonardo_da_vinci,1,42,73,9,4,777,100,1,0,0,adviser,remote,scholar,quest,signature,~perk~,"
	f.rpg.restoreState(record + skills + "," + masteries + "|i,token|j,,321").assertFalse()
	f.state.captureAuthoritativeState().assertEquals(before)

@test function malformedRankSnapshotsAndFailedRestorationAreAtomic()
	let f = startingFixture("leonardo_da_vinci")
	registerRpgRuntimeCommands(f.commands, f.rpg).assertEquals("")
	f.clock.advanceTo(f.hero.availabilityStartDay).assertTrue()
	f.recruit()
	rejectRanks(f, "engineering:101~", "")
	rejectRanks(f, "engineering:-1~", "")
	rejectRanks(f, "engineering:01~", "")
	rejectRanks(f, "engineering:1", "")
	rejectRanks(f, "engineering:1~engineering:2~", "")
	rejectRanks(f, "unregistered:1~", "")
	rejectRanks(f, "engineering:1~~", "")
	rejectRanks(f, "", "learned_arts:101~")
	rejectRanks(f, "", "unknown:1~")
	// Exercise the campaign load transaction after RPG authority was replaced.
	let load = new LoadFixture()
	let hero = load.rpg.heroes.get("hero")
	hero.skillIds = "~engineering~"
	hero.masteryIds = "~learned_arts~"
	hero.skillRanks = "engineering:91~"
	hero.masteryRanks = "learned_arts:72~"
	hero.signatureProgressionId = "earned_tree"
	hero.experience = 73
	hero.skillPoints = 9
	hero.masteryPoints = 4
	let before = load.rpg.captureState()
	let candidate = load.candidate()
	load.ports.failParty = true
	load.rejectAndVerify(candidate)
	load.rpg.captureState().assertEquals(before)
	load.ports.failParty = false
	load.recordingTimer.expected = load.candidateClock
	load.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	hero.level.assertEquals(25)
	hero.skillRanks.assertEquals("")
	hero.masteryRanks.assertEquals("")
	startingReceipt("replay")
