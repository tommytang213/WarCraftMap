package ItemDefinitionTests

import WarcraftRpgRuntime
import WarcraftRpgProjections
import EquipmentSetTests
import CharacterEquipmentTests
import ScenarioData

@test function registeredPulwarEquipmentRetainsStatsWithoutGrantingMaximumLife()
	let f = new SetParityFixture()
	configureGeneratedRpg(f.rpg)
	f.addHero("wearer")
	f.addHero("other")
	let wearerIndex = f.rpg.heroes.indexOf("wearer")
	let otherIndex = f.rpg.heroes.indexOf("other")
	let inventory = f.rpg.inventory
	let pulwar = inventory.getItem("afghan_pulwar")
	pulwar.statCount.assertEquals(2)
	pulwar.statValue("meleePower").assertEquals(40)
	pulwar.statValue("mountedPower").assertEquals(12)
	pulwar.itemLevel.assertEquals(86)
	pulwar.rarity.assertEquals("rare")
	pulwar.rarityRank.assertEquals(3)
	pulwar.provenanceKind.assertEquals("regional")
	pulwar.identityId.assertEquals("afghan_pulwar")
	(pulwar.requirements.indexOf("middle_east_india") >= 0).assertTrue()
	inventory.grant(pulwar.id).assertTrue()
	inventory.grant(pulwar.id).assertTrue()
	let alternative = new RpgItem("fixture_alternative", "Alternative", "primary", "common", 100)
	alternative.addStat("meleePower", 35)
	alternative.addStat("guard", 9)
	alternative.addEffect("unbound_passive")
	alternative.addConditionalEffect("boarding_edge", "aboard_ship", "{\"condition\":\"aboard_ship\",\"id\":\"boarding_edge\"}")
	inventory.registerItem(alternative)
	inventory.grant(alternative.id).assertTrue()
	f.action("/equip wearer afghan_pulwar")
	f.action("/equip other afghan_pulwar")
	f.projections.itemLayer("wearer", "primary").definition.statValue("meleePower").assertEquals(40)
	f.projections.itemLayer("other", "primary").definition.statValue("mountedPower").assertEquals(12)
	f.projections.itemLayer("wearer", "primary").bindingStatus().assertEquals(ITEM_BINDINGS_PENDING)
	f.natives.life[wearerIndex].assertEquals(100)
	f.natives.life[otherIndex].assertEquals(100)
	f.inspect("wearer", "meleePower: 40 (|cffaaaaaa0|r)")
	f.inspect("wearer", "meleePower: 35 (|cffff4040-5|r)")
	f.inspect("wearer", "mountedPower: 0 (|cffff4040-12|r)")
	f.inspect("wearer", "guard: 9 (|cff00ff00+9|r)")
	f.inspect("wearer", "Conditional effect: boarding_edge | Condition: aboard_ship (unavailable)")
	f.inspect("wearer", "Effect: unbound_passive (unavailable)")
	f.inspect("wearer", "Regions: middle_east_india")
	f.inspect("wearer", "Item stat and effect gameplay bonuses unavailable.")
	f.action("/equip wearer fixture_alternative")
	f.projections.itemLayer("wearer", "primary").definition.effectIds[0].assertEquals("unbound_passive")
	f.projections.itemLayer("wearer", "primary").definition.conditionalEffects[0].condition.assertEquals("aboard_ship")
	f.projections.itemLayer("other", "primary").definition.id.assertEquals(pulwar.id)
	f.inspect("wearer", "meleePower: 40 (|cff00ff00+5|r)")
	f.inspect("other", "meleePower: 40 (|cffaaaaaa0|r)")
	let before = f.rpg.captureState()
	let layer = f.projections.itemLayer("other", "primary")
	f.commands.dispatch(null, "/equip other fixture_alternative").assertTrue()
	f.output.last.assertEquals("Requirements are not met here.")
	f.rpg.captureState().assertEquals(before)
	(f.projections.itemLayer("other", "primary") == layer).assertTrue()
	// Stable IDs continue to receive typed definitions without native objects.
	f.rpg.heroes.assignRemote("wearer", "governor", "remote").assertTrue()
	f.natives.identities[wearerIndex] = 0
	f.natives.life[otherIndex] += 77
	for repeat = 1 to 3
		f.rpg.reconcile("player")
		f.projections.itemLayer("wearer", "primary").definition.id.assertEquals(alternative.id)
		f.projections.itemLayer("other", "primary").definition.id.assertEquals(pulwar.id)
		f.natives.life[otherIndex].assertEquals(177)
	f.natives.represent(wearerIndex, 9000, 700)
	f.rpg.reconcile("player")
	f.natives.life[wearerIndex].assertEquals(700)
	f.action("/unequip wearer primary")
	(f.projections.itemLayer("wearer", "primary") == null).assertTrue()
	f.projections.itemLayer("other", "primary").definition.id.assertEquals(pulwar.id)
	f.inspect("wearer", "meleePower: 40 (|cff00ff00+40|r)")
	inventory.ownedQuantity(pulwar.id).assertEquals(2)
	inventory.ownedQuantity(alternative.id).assertEquals(1)
	f.natives.totalWrites.assertEquals(0)

@test function typedItemReplacementAndPartyRollbackPreserveOtherEquipmentAndSets()
	let f = new EquipmentFixture()
	f.equip("alpha", "coat")
	f.equip("alpha", "hat")
	f.equip("beta", "coat")
	let coat = f.rpg.inventory.getItem("coat")
	let hat = f.rpg.inventory.getItem("hat")
	let beta = f.projections.itemLayer("beta", "chest")
	let head = f.projections.itemLayer("alpha", "head")
	f.projections.replaceEquipment(new EquipmentItemLayer("alpha", "chest", null))
	(f.projections.itemLayer("alpha", "chest") == null).assertTrue()
	(f.projections.itemLayer("beta", "chest") == beta).assertTrue()
	(f.projections.itemLayer("alpha", "head") == head).assertTrue()
	f.projections.setEffectIdentities("alpha", "uniform").assertEquals("alpha|uniform|pieces_2|guard;")
	f.rpg.reconcile("player")
	let original = f.projections.itemLayer("alpha", "chest")
	for repeat = 1 to 3
		f.rpg.reconcile("player")
		(f.projections.itemLayer("alpha", "chest") == original).assertTrue()
	for attempt = 1 to 2
		f.projections.beginPartyLoad()
		f.projections.replaceEquipment(new EquipmentItemLayer("alpha", "chest", hat))
		f.projections.rollbackPartyLoad()
		(f.projections.itemLayer("alpha", "chest") == original).assertTrue()
		f.projections.itemLayer("alpha", "chest").definition.id.assertEquals(coat.id)
		f.projections.itemLayer("beta", "chest").definition.id.assertEquals(coat.id)
		f.projections.setEffectIdentities("alpha", "uniform").assertEquals("alpha|uniform|pieces_2|guard;")
	f.projections.beginPartyLoad()
	f.projections.replaceEquipment(new EquipmentItemLayer("alpha", "chest", hat))
	f.projections.commitPartyLoad()
	f.projections.itemLayer("alpha", "chest").definition.id.assertEquals(hat.id)
	(f.projections.itemLayer("beta", "chest") == null).assertTrue()
	f.rpg.reconcile("player")
	f.projections.itemLayer("alpha", "chest").definition.id.assertEquals(coat.id)
	f.natives.totalWrites.assertEquals(0)

@test function metadataOnlyDefinitionChangesReplaceOnlyTheirDeliveredLayer()
	let f = new EquipmentFixture()
	f.equip("alpha", "coat")
	f.equip("beta", "hat")
	let previous = f.projections.itemLayer("alpha", "chest")
	let other = f.projections.itemLayer("beta", "head")
	let definition = new RpgItem("coat", "coat", "chest", "rare", 10).addStat("defense", 5)
	definition.provenance = "{\"kind\":\"regional\",\"source\":\"archive\"}"
	definition.requirements = "{\"regionIds\":[\"region\"]}"
	definition.addConditionalEffect("guard", "aboard_ship", "{\"id\":\"guard\",\"condition\":\"aboard_ship\",\"weather\":\"storm\"}")
	f.projections.replaceEquipment(new EquipmentItemLayer("alpha", "chest", definition))
	let updated = f.projections.itemLayer("alpha", "chest")
	(updated != previous).assertTrue()
	(updated.definitionFingerprint.indexOf("archive") >= 0).assertTrue()
	(updated.definitionFingerprint.indexOf("storm") >= 0).assertTrue()
	updated.definition.conditionalEffects[0].descriptor.assertEquals(definition.conditionalEffects[0].descriptor)
	(f.projections.itemLayer("beta", "head") == other).assertTrue()
	f.projections.replaceEquipment(new EquipmentItemLayer("alpha", "chest", definition))
	(f.projections.itemLayer("alpha", "chest") == updated).assertTrue()
	f.natives.totalWrites.assertEquals(0)

@test function currentAndEverySupportedLegacyLoadoutRebuildItemDefinitions()
	let f = new EquipmentFixture()
	let heroes = "|h,alpha,1,20,0,0,0,0,50,0,0,0,reserve,,,,,|h,beta,1,20,0,0,0,0,50,0,0,0,reserve,,,,,|h,gamma,0,1,0,0,0,0,50,0,0,0,unrecruited,,,,,"
	let gear = "|i,coat|i,coat|i,hat|e,chest,coat,alpha|e,chest,coat,beta|e,head,hat,alpha|j,,0"
	for schema = 2 to 7
		var candidate = "v" + schema + "|p," + heroes + gear
		if schema == 2
			candidate = "v2" + heroes + gear
		if schema >= 4
			candidate = candidate.replace(",,,,,|", ",,,,,,,|")
		if schema >= 6
			candidate = candidate.replace(",,,,,,,|", ",,,,,,,,0|")
		if schema == 7
			candidate += "|s,1"
		f.rpg.restoreState(candidate).assertTrue()
		let saved = f.rpg.captureState()
		(saved.indexOf("defense") < 0).assertTrue()
		for repeat = 1 to 2
			f.rpg.restoreState(saved).assertTrue()
			f.rpg.reconcile("player")
			f.rpg.captureState().assertEquals(saved)
			f.rpg.inventory.ownedQuantity("coat").assertEquals(2)
			f.projections.itemLayer("alpha", "chest").definition.statValue("defense").assertEquals(5)
			f.projections.itemLayer("beta", "chest").definition.statValue("defense").assertEquals(5)
			f.projections.itemLayer("alpha", "head").definition.statValue("defense").assertEquals(4)
	f.rpg.restoreState("v1").assertTrue()
	f.rpg.reconcile("player")
	(f.projections.itemLayer("alpha", "chest") == null).assertTrue()
	f.rpg.inventory.ownedCount.assertEquals(0)
	f.natives.totalWrites.assertEquals(0)
