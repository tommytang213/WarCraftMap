package MixedCargoVectorsTests
import MixedCargoTests

// Generated by tests/test_mixed_cargo.py --write-vectors. Every expected balance,
// market stock, currency and remaining acquisition cost comes from economy/trade.

@test function registeredMixedCargoOracleOrder0()
	let f=mixedTradeFixture()
	f.actors.moveTo(f.rpg.interactions.get("lisbon"))
	f.vessels.moveTo(f.rpg.interactions.get("lisbon"))
	f.dispatch("/trade select lisbon grain")
	f.dispatch("/trade store player_ship_hold")
	f.dispatch("/trade buy 3")
	mixedCargoVectorState(f).assertEquals("3,0,970,30,0;0,0,1000,0,0;0,0,0,0,0;97,100,20030;100,100,20000;")
	f.actors.moveTo(f.rpg.interactions.get("lisbon"))
	f.vessels.moveTo(f.rpg.interactions.get("lisbon"))
	f.dispatch("/trade select lisbon tools")
	f.dispatch("/trade store player_ship_hold")
	f.dispatch("/trade buy 2")
	mixedCargoVectorState(f).assertEquals("3,2,906,30,64;0,0,1000,0,0;0,0,0,0,0;97,98,20094;100,100,20000;")
	f.dispatch("/trade move player_ship_hold warehouse:lisbon grain 2")
	f.ports.output.assertEquals("Cargo moved.")
	mixedCargoVectorState(f).assertEquals("1,2,906,10,64;2,0,1000,20,0;0,0,0,0,0;97,98,20094;100,100,20000;")
	f.dispatch("/trade move player_ship_hold warehouse:lisbon tools 1")
	f.ports.output.assertEquals("Cargo moved.")
	mixedCargoVectorState(f).assertEquals("1,1,906,10,32;2,1,1000,20,32;0,0,0,0,0;97,98,20094;100,100,20000;")
	f.dispatch("/trade move warehouse:lisbon cargo:english_patrol_ship grain 1")
	f.ports.output.assertEquals("Cargo moved.")
	mixedCargoVectorState(f).assertEquals("1,1,906,10,32;1,1,1000,10,32;1,0,0,10,0;97,98,20094;100,100,20000;")
	f.dispatch("/trade move player_ship_hold cargo:english_patrol_ship tools 1")
	f.ports.output.assertEquals("Cargo moved.")
	mixedCargoVectorState(f).assertEquals("1,0,906,10,0;1,1,1000,10,32;1,1,0,10,32;97,98,20094;100,100,20000;")
	f.actors.moveTo(f.rpg.interactions.get("lisbon"))
	f.vessels.moveTo(f.rpg.interactions.get("lisbon"))
	f.dispatch("/trade select lisbon tools")
	f.dispatch("/trade store warehouse:lisbon")
	f.dispatch("/trade sell 1")
	mixedCargoVectorState(f).assertEquals("1,0,906,10,0;1,0,1027,10,0;1,1,0,10,32;97,99,20067;100,100,20000;")
	f.actors.moveTo(f.rpg.interactions.get("london"))
	f.vessels.moveTo(f.rpg.interactions.get("london"))
	f.dispatch("/trade select london grain")
	f.dispatch("/trade store player_ship_hold")
	f.dispatch("/trade sell 1")
	mixedCargoVectorState(f).assertEquals("0,0,933,0,0;1,0,1027,10,0;1,1,0,10,32;97,99,20067;101,100,19973;")
	f.actors.moveTo(f.rpg.interactions.get("london"))
	f.vessels.moveTo(f.rpg.interactions.get("london"))
	f.dispatch("/trade select london grain")
	f.dispatch("/trade store cargo:english_patrol_ship")
	f.dispatch("/trade sell 1")
	mixedCargoVectorState(f).assertEquals("0,0,933,0,0;1,0,1027,10,0;0,1,27,0,32;97,99,20067;102,100,19946;")
	f.actors.moveTo(f.rpg.interactions.get("lisbon"))
	f.vessels.moveTo(f.rpg.interactions.get("lisbon"))
	f.dispatch("/trade select lisbon grain")
	f.dispatch("/trade store warehouse:lisbon")
	f.dispatch("/trade sell 1")
	mixedCargoVectorState(f).assertEquals("0,0,933,0,0;0,0,1036,0,0;0,1,27,0,32;98,99,20058;102,100,19946;")
	f.actors.moveTo(f.rpg.interactions.get("london"))
	f.vessels.moveTo(f.rpg.interactions.get("london"))
	f.dispatch("/trade select london tools")
	f.dispatch("/trade store cargo:english_patrol_ship")
	f.dispatch("/trade sell 1")
	mixedCargoVectorState(f).assertEquals("0,0,933,0,0;0,0,1036,0,0;0,0,109,0,0;98,99,20058;102,101,19864;")
	f.trade.controller.provenance.count.assertEquals(0)
	f.trade.controller.processedCount.assertEquals(11)
	f.trade.nextTransaction.assertEquals(12)

