package WarcraftRegionalRuntimeTests

import WarcraftRegionalRuntime

/** These tests use a handle spy so they exercise production routing without
 * relying on Warcraft natives in the Wurst interpreter. Native unit creation
 * and visible regional gameplay remain separate client acceptance gates. */
class RecordingRegionalAdapter extends WarcraftRegionalAdapter
	boolean live = true
	int retireCalls = 0
	int moveCalls = 0
	int materializeCalls = 0
	string materializedRegion = ""
	int materializedType = 0
	player materializedOwner = null
	real lastMoveX = 0.
	real lastMoveY = 0.
	string retiredFrom = ""
	int retiredType = 0
	override function hasLiveHandle(int index) returns boolean
		return live
	override function retireHandle(int index)
		retireCalls++
		retiredFrom = definitions[index].regionId
		retiredType = definitions[index].unitRawcode
		live = false
	override function moveHandle(int index, real x, real y)
		moveCalls++
		lastMoveX = x
		lastMoveY = y
	override function materializeHandle(int index)
		materializeCalls++
		materializedRegion = definitions[index].regionId
		materializedType = definitions[index].unitRawcode
		materializedOwner = definitions[index].owner
		live = true

@test function relocatedUnitRetiresOldRegionalHandleBeforeChangingIdentity()
	let regional = new RecordingRegionalAdapter()
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 10., 20., 0.))
	regional.relocate("hero", "europe_west", 11., 21.)
	regional.moveCalls.assertEquals(1)
	regional.retireCalls.assertEquals(0)
	regional.relocate("hero", "africa", 40., 50.)
	regional.retireCalls.assertEquals(1)
	regional.retiredFrom.assertEquals("europe_west")
	regional.retiredType.assertEquals('hfoo')
	regional.moveCalls.assertEquals(1)
	regional.definitions[0].regionId.assertEquals("africa")
	regional.definitions[0].x.assertEquals(40.)
	regional.definitions[0].y.assertEquals(50.)
	regional.relocate("hero", "africa", 45., 55.)
	regional.retireCalls.assertEquals(1)
	regional.moveCalls.assertEquals(1)

@test function replacingProjectionWithChangedRegionTypeOrOwnerRetiresOldHandle()
	let regional = new RecordingRegionalAdapter()
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hfoo', Player(0), 0., 0., 0.))
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hfoo', Player(0), 5., 0., 0.))
	regional.retireCalls.assertEquals(0)
	regional.count.assertEquals(1)
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hrif', Player(0), 5., 0., 0.))
	regional.retireCalls.assertEquals(1)
	regional.retiredType.assertEquals('hfoo')
	regional.live = true
	regional.register(new RegionalRepresentation("guard", "africa", 'hrif', Player(0), 5., 0., 0.))
	regional.retireCalls.assertEquals(2)
	regional.retiredFrom.assertEquals("europe_west")
	regional.live = true
	regional.register(new RegionalRepresentation("guard", "africa", 'hrif', Player(1), 5., 0., 0.))
	regional.retireCalls.assertEquals(3)
	regional.retiredFrom.assertEquals("africa")
	regional.count.assertEquals(1)

@test function unknownRelocationNeverCreatesOrMovesRepresentation()
	let regional = new RecordingRegionalAdapter()
	regional.relocate("not_registered", "africa", 1., 2.)
	regional.retireCalls.assertEquals(0)
	regional.moveCalls.assertEquals(0)
	regional.count.assertEquals(0)

@test function sameIdentityRegistrationUpdatesLiveUnitPositionWithoutRetiringIt()
	let regional = new RecordingRegionalAdapter()
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 10., 20., 0.))
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 10., 20., 0.))
	regional.moveCalls.assertEquals(0)
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 15., 25., 0.))
	regional.count.assertEquals(1)
	regional.moveCalls.assertEquals(1)
	regional.retireCalls.assertEquals(0)
	regional.lastMoveX.assertEquals(15.)
	regional.lastMoveY.assertEquals(25.)
	regional.definitions[0].x.assertEquals(15.)
	regional.definitions[0].y.assertEquals(25.)
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 15., 25., 0.))
	regional.moveCalls.assertEquals(1)

@test function dormantSameIdentityRegistrationPreservesDestinationForReconstruction()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 10., 20., 0.))
	regional.register(new RegionalRepresentation("hero", "europe_west", 'hfoo', Player(0), 15., 25., 0.))
	regional.moveCalls.assertEquals(0)
	regional.retireCalls.assertEquals(0)
	regional.definitions[0].x.assertEquals(15.)
	regional.definitions[0].y.assertEquals(25.)

/** An active live unit must reappear immediately when its type/owner changes;
 * transfer to an inactive physical region or edits of dormant projections must not spawn it. */
@test function activeIdentityReplacementMaterializesOnlyCurrentRegion()
	let regional = new RecordingRegionalAdapter()
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hfoo', Player(0), 10., 20., 0.))
	regional.activeRegionId = "europe_west"
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hrif', Player(0), 10., 20., 0.))
	regional.retireCalls.assertEquals(1)
	regional.materializeCalls.assertEquals(1)
	regional.materializedRegion.assertEquals("europe_west")
	regional.materializedType.assertEquals('hrif')
	(regional.materializedOwner == Player(0)).assertTrue()
	regional.live.assertTrue()
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hrif', Player(1), 15., 25., 0.))
	regional.retireCalls.assertEquals(2)
	regional.materializeCalls.assertEquals(2)
	(regional.materializedOwner == Player(1)).assertTrue()
	regional.live.assertTrue()
	regional.register(new RegionalRepresentation("guard", "africa", 'hrif', Player(1), 20., 30., 0.))
	regional.retireCalls.assertEquals(3)
	regional.materializeCalls.assertEquals(2)
	regional.live.assertFalse()
	regional.count.assertEquals(1)

@test function dormantIdentityReplacementDoesNotSpawnCurrentRegionUnit()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hfoo', Player(0), 10., 20., 0.))
	regional.activeRegionId = "europe_west"
	regional.register(new RegionalRepresentation("guard", "europe_west", 'hrif', Player(0), 10., 20., 0.))
	regional.materializeCalls.assertEquals(0)
	regional.live.assertFalse()
	regional.definitions[0].unitRawcode.assertEquals('hrif')

/** Arrivals on the current physical map materialize immediately. Moving out
 * retires the handle; movement into an inactive map remains dormant. */
@test function incomingRelocationMaterializesOnActivePhysicalRegion()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.register(new RegionalRepresentation("ship", "africa", 'hfoo', Player(0), 10., 20., 0.))
	regional.activeRegionId = "europe_west"
	regional.relocate("ship", "europe_west", 30., 40.)
	regional.materializeCalls.assertEquals(1)
	regional.materializedRegion.assertEquals("europe_west")
	regional.retiredFrom.assertEquals("africa")
	regional.moveCalls.assertEquals(0)
	regional.live.assertTrue()
	regional.definitions[0].x.assertEquals(30.)
	regional.definitions[0].y.assertEquals(40.)
	regional.relocate("ship", "europe_west", 35., 45.)
	regional.materializeCalls.assertEquals(1)
	regional.moveCalls.assertEquals(1)
	regional.lastMoveX.assertEquals(35.)
	regional.lastMoveY.assertEquals(45.)
	regional.relocate("ship", "asia", 50., 60.)
	regional.materializeCalls.assertEquals(1)
	regional.live.assertFalse()
	regional.count.assertEquals(1)

@test function inactiveDestinationRelocationRemainsDormant()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.register(new RegionalRepresentation("scout", "africa", 'hfoo', Player(0), 10., 20., 0.))
	regional.activeRegionId = "europe_west"
	regional.relocate("scout", "asia", 30., 40.)
	regional.materializeCalls.assertEquals(0)
	regional.moveCalls.assertEquals(0)
	regional.definitions[0].regionId.assertEquals("asia")
	regional.definitions[0].x.assertEquals(30.)
	regional.definitions[0].y.assertEquals(40.)

/** A freshly registered unit is not part of an earlier reconstruction pass.
 * It must materialize immediately only when its physical map is active. */
@test function newRegistrationOnActivePhysicalRegionMaterializesImmediately()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.activeRegionId = "europe_west"
	regional.register(new RegionalRepresentation("new_recruit", "europe_west", 'hfoo', Player(0), 31., 41., 0.))
	regional.count.assertEquals(1)
	regional.materializeCalls.assertEquals(1)
	regional.materializedRegion.assertEquals("europe_west")
	regional.materializedType.assertEquals('hfoo')
	(regional.materializedOwner == Player(0)).assertTrue()
	regional.live.assertTrue()
	regional.register(new RegionalRepresentation("new_recruit", "europe_west", 'hfoo', Player(0), 31., 41., 0.))
	regional.materializeCalls.assertEquals(1)
	regional.count.assertEquals(1)

@test function newRegistrationBeforeActivationOrOnAnotherMapStaysDormant()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.register(new RegionalRepresentation("pre_start", "europe_west", 'hfoo', Player(0), 1., 2., 0.))
	regional.materializeCalls.assertEquals(0)
	regional.activeRegionId = "europe_west"
	regional.register(new RegionalRepresentation("off_map", "africa", 'hfoo', Player(0), 3., 4., 0.))
	regional.materializeCalls.assertEquals(0)
	regional.moveCalls.assertEquals(0)
	regional.count.assertEquals(2)
	regional.definitions[1].regionId.assertEquals("africa")

/** Re-registering a dormant cross-map unit is another arrival path. It must
 * materialize on the loaded map even when there was no old handle to retire. */
@test function registeringDormantUnitIntoActiveRegionMaterializesImmediately()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.activeRegionId = "europe_west"
	regional.register(new RegionalRepresentation("patrol", "africa", 'hfoo', Player(0), 10., 20., 0.))
	regional.materializeCalls.assertEquals(0)
	regional.register(new RegionalRepresentation("patrol", "europe_west", 'hrif', Player(1), 30., 40., 0.))
	regional.materializeCalls.assertEquals(1)
	regional.materializedRegion.assertEquals("europe_west")
	regional.materializedType.assertEquals('hrif')
	(regional.materializedOwner == Player(1)).assertTrue()
	regional.retiredFrom.assertEquals("africa")
	regional.definitions[0].x.assertEquals(30.)
	regional.definitions[0].y.assertEquals(40.)
	regional.count.assertEquals(1)
	regional.register(new RegionalRepresentation("patrol", "europe_west", 'hrif', Player(1), 30., 40., 0.))
	regional.materializeCalls.assertEquals(1)

@test function registeringDormantUnitIntoInactiveRegionDoesNotMaterialize()
	let regional = new RecordingRegionalAdapter()
	regional.live = false
	regional.activeRegionId = "europe_west"
	regional.register(new RegionalRepresentation("ship", "africa", 'hfoo', Player(0), 10., 20., 0.))
	regional.register(new RegionalRepresentation("ship", "asia", 'hrif', Player(0), 30., 40., 0.))
	regional.count.assertEquals(1)
	regional.materializeCalls.assertEquals(0)
	regional.moveCalls.assertEquals(0)
	regional.definitions[0].regionId.assertEquals("asia")
