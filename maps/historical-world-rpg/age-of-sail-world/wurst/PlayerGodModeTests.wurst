package PlayerGodModeTests
import PlayerGodMode
import CommandRouter

class FakeRuntime implements GodModeRuntime
	int array[16] owners
	boolean array[16] invulnerable
	boolean array[16] present
	int writes
	function add(int entity, int owner, boolean initiallyInvulnerable)
		present[entity] = true
		owners[entity] = owner
		invulnerable[entity] = initiallyInvulnerable
		unrelated[entity] = initiallyInvulnerable
	boolean array[16] protection
	boolean array[16] unrelated
	int cursor
	override function refresh()
		cursor = 0
	override function nextEntity() returns int
		cursor++
		while cursor <= 12
			if present[cursor]
				return cursor
			cursor++
		return 0
	override function ownerOf(int entity) returns int
		return owners[entity]
	override function ownsProtection(int entity) returns boolean
		return protection[entity]
	override function setProtection(int entity, boolean value)
		protection[entity] = value
		let wanted = value or unrelated[entity]
		if invulnerable[entity] != wanted
			invulnerable[entity] = wanted
			writes++

class Output implements CommandOutput
	string last
	override function show(player recipient, string message)
		last = message

@test function toggleExplicitFormsAndEntityCategories()
	let runtime = new FakeRuntime()
	// hero, ordinary unit, summon, ship, and structure are all opaque runtime entities.
	for entity = 1 to 5
		runtime.add(entity, 0, false)
	let controller = new PlayerGodModeController(runtime)
	let output = new Output()
	let command = new GodModeCommand(controller, output)
	command.execute(Player(0), "")
	output.last.assertEquals("Player-wide god mode is ON.")
	for entity = 1 to 5
		runtime.invulnerable[entity].assertTrue()
	let writes = runtime.writes
	command.execute(Player(0), "on")
	runtime.writes.assertEquals(writes)
	command.execute(Player(0), "off")
	output.last.assertEquals("Player-wide god mode is OFF.")
	command.execute(Player(0), "off")
	controller.isEnabled(0).assertFalse()

@test function inheritanceTransfersAndOwnedProtection()
	let runtime = new FakeRuntime()
	runtime.add(1, 0, true) // unrelated invulnerability
	runtime.add(2, 0, false)
	let controller = new PlayerGodModeController(runtime)
	controller.setEnabled(0, true)
	controller.ownsProtection(1).assertTrue()
	controller.ownsProtection(2).assertTrue()
	runtime.add(3, 0, false)
	controller.entityBecameControlled(3)
	runtime.invulnerable[3].assertTrue()
	runtime.owners[3] = 1
	controller.entityChangedOwner(3)
	runtime.invulnerable[3].assertFalse()
	controller.setEnabled(0, false)
	runtime.invulnerable[1].assertTrue()
	runtime.invulnerable[2].assertFalse()

@test function campaignLoadResetsSessionOnlyMode()
	let runtime = new FakeRuntime()
	runtime.add(1, 0, false)
	let controller = new PlayerGodModeController(runtime)
	controller.setEnabled(0, true)
	controller.afterCampaignLoad()
	controller.isEnabled(0).assertFalse()
	runtime.invulnerable[1].assertFalse()

@test function helpRegistrationAndFeedback()
	let runtime = new FakeRuntime()
	let output = new Output()
	let registry = new CommandRegistry(false, 6, new CommandText(), output)
	registry.register("help", "commands", "help [page|command]", "Show help.", "Help details.", 0, 1, COMMAND_RELEASE, null)
	registry.register("god", "", "god [on|off]", "Toggle player-wide god mode.", "God mode details.", 0, 1, COMMAND_RELEASE, new GodModeCommand(new PlayerGodModeController(runtime), output))
	registry.dispatch(Player(0), "/help god")
	output.last.assertEquals("Usage: /god [on|off]\nGod mode details.")
	registry.dispatch(Player(0), "/god on")
	output.last.assertEquals("Player-wide god mode is ON.")
