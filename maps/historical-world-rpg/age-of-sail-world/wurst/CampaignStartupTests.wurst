	destination.saves.read("major_milestone").assertEquals(saved)
	destination.ports.arrivalAvailable = true
	destination.campaign.startup().assertTrue()
	destination.ports.x.assertEquals(-7232.)
	destination.ports.y.assertEquals(2490.88)

@test function malformedSavedBoundaryTupleNeverReconstructsOrOverwrites()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_middle_east_india"), .37, "fixed-time").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	destination.register()
	let valid = destination.campaign.saves.codec.decodeMigrateAndValidate(source.saves.read("major_milestone"), "major_milestone")
	string array[8] invalid
	invalid[0] = replaceCampaignField(valid, "boundary", "unknown_route")
	invalid[1] = replaceCampaignField(valid, "boundary", "middle_east_india_to_africa")
	invalid[2] = replaceCampaignField(valid, "position", "nan")
	invalid[3] = replaceCampaignField(valid, "position", "1.1")
	invalid[4] = replaceCampaignField(valid, "position", "0.37junk")
	invalid[5] = replaceCampaignField(valid, "position", "-0.1")
	invalid[6] = replaceCampaignField(valid, "arrival", "0.5")
	invalid[7] = replaceCampaignField(valid, "region", "europe")
	for i = 0 to 7
		let payload = campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT, "major_milestone", SAVE_SLOT_MAJOR_MILESTONE, 0, "fixed-time", invalid[i])
		source.saves.writeTransactional("major_milestone", payload)
		destination.campaign.startup().assertFalse()
		destination.ports.spawns.assertEquals(0)
		destination.saves.read("major_milestone").assertEquals(payload)

@test function generatedTravelFailureNeverCommitsOrLoadsAndCanRetry()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	let before = source.campaign.state.authorityDocument()
	let saved = source.saves.read("major_milestone")
	let route = source.campaign.state.boundary("africa_to_middle_east_india")
	source.campaign.travel.transition(route, 2., "invalid").assertFalse()
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_europe_west"), .37, "unavailable").assertFalse()
	source.campaign.travel.transition(source.campaign.state.boundary("middle_east_india_to_africa"), .75, "wrong-map").assertFalse()
	source.saves.failKey = "major_milestone"
	source.campaign.travel.transition(route, .37, "failed-save").assertFalse()
	source.campaign.state.authorityDocument().assertEquals(before)
	source.saves.read("major_milestone").assertEquals(saved)
	source.ports.loads.assertEquals(1)
	source.campaign.travel.physicalMapId().assertEquals("africa")
	source.campaign.state.isSaveSafe().assertTrue()
	source.campaign.travel.transition(route, .37, "retry").assertTrue()
	source.ports.loads.assertEquals(2)

@test function supportedTransferSchemasResolveExistingBoundaryPositionWithoutNewFields()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_middle_east_india"), .37, "fixed-time").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	destination.register()
	let valid = destination.campaign.saves.codec.decodeMigrateAndValidate(source.saves.read("major_milestone"), "major_milestone")
	for schema = CAMPAIGN_SAVE_SCHEMA_OLDEST to CAMPAIGN_SAVE_SCHEMA_CURRENT
		let payload = campaignSaveEnvelope(schema, "major_milestone", SAVE_SLOT_MAJOR_MILESTONE, 0, "legacy", valid)
		source.saves.writeTransactional("major_milestone", payload)
		destination.campaign.saves.load(SAVE_SLOT_MAJOR_MILESTONE, 0).assertTrue()
		destination.ports.x.assertEquals(-7232.)
		destination.ports.y.assertEquals(2490.88)
		destination.saves.read("major_milestone").assertEquals(payload)
