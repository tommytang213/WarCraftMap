@test function legacyTransferSchemasThreeAndFourResolveGeneratedBoundary()
	transferSchemasResolveExistingBoundaryPosition(3, 4)

@test function transferSchemasFiveThroughEightResolveGeneratedBoundary()
	transferSchemasResolveExistingBoundaryPosition(5, CAMPAIGN_SAVE_SCHEMA_CURRENT)

/** Move through the recording native boundary, then let production capture read
 * the observations. Search only generated connected land, away from the spawn. */
function moveRecordedMember(StartupFixture f, int member, int direction)
	let nav = f.campaign.state.partyNavigation
	let x = f.ports.memberX[member]
	let y = f.ports.memberY[member]
	let component = nav.componentAt(x, y)
	for distanceStep = 4 to 16
		for axis = 0 to 3
			var px = x
			var py = y
			if axis == 0
				px += distanceStep * 64. * direction
			else if axis == 1
				py += distanceStep * 64. * direction
			else if axis == 2
				px -= distanceStep * 64. * direction
			else
				py -= distanceStep * 64. * direction
			if component > 0 and nav.componentAt(px, py) == component
				f.ports.memberX[member] = px
				f.ports.memberY[member] = py
				return
	false.assertTrue()

function deployRecordedCompanion(StartupFixture f)
	let hero = f.campaign.state.rpg.heroes.heroes[0]
	hero.recruited = true
	hero.assignment = "field"
	hero.regionId = ""
	f.ports.represented[0] = true
	f.ports.memberX[0] = f.ports.memberX[1]
	f.ports.memberY[0] = f.ports.memberY[1]

@test function currentPartyCoordinatesSurviveManualAutosaveAndRecoveryLoads()
	let f = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	f.start("england")
	deployRecordedCompanion(f)
	moveRecordedMember(f, 0, 1)
	moveRecordedMember(f, 1, -1)
	let x0 = f.ports.memberX[0]
	let y0 = f.ports.memberY[0]
	let x1 = f.ports.memberX[1]
	let y1 = f.ports.memberY[1]
	(x0 != x1 or y0 != y1).assertTrue()
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "moved").assertTrue()
	f.campaign.autosaves.advance(CAMPAIGN_AUTOSAVE_SECONDS, "moved").assertTrue()
	f.campaign.saves.save(SAVE_SLOT_SESSION_START, 0, "moved").assertTrue()
	f.campaign.saves.save(SAVE_SLOT_MAJOR_MILESTONE, 0, "moved").assertTrue()
	int array[4] kinds
	kinds[0] = SAVE_SLOT_MANUAL
	kinds[1] = SAVE_SLOT_AUTOSAVE
	kinds[2] = SAVE_SLOT_SESSION_START
	kinds[3] = SAVE_SLOT_MAJOR_MILESTONE
	for repeat = 0 to 1
		for i = 0 to 3
			moveRecordedMember(f, 0, 1)
			moveRecordedMember(f, 1, -1)
			var index = 0
			if i < 2
				index = 1
			f.campaign.saves.load(kinds[i], index).assertTrue()
			(RAbsBJ(f.ports.memberX[0] - x0) < .01).assertTrue()
			(RAbsBJ(f.ports.memberY[0] - y0) < .01).assertTrue()
			(RAbsBJ(f.ports.memberX[1] - x1) < .01).assertTrue()
			(RAbsBJ(f.ports.memberY[1] - y1) < .01).assertTrue()
			f.ports.activePlayers.assertEquals(2)

@test function ordinaryDestinationMovementDoesNotReplayTransferArrival()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	deployRecordedCompanion(source)
	// Explicitly local assignments must travel, while remote assignments do not.
	source.campaign.state.rpg.heroes.heroes[1].regionId = "africa"
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_middle_east_india"), .37, "travel").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	destination.register()
	destination.campaign.startup().assertTrue()
	destination.ports.x.assertEquals(-7232.)
	destination.ports.y.assertEquals(2490.88)
	destination.campaign.state.rpg.heroes.heroes[1].regionId.assertEquals("middle_east_india")
	moveRecordedMember(destination, 0, 1)
	moveRecordedMember(destination, 1, -1)
	let x = destination.ports.memberX[0]
	let y = destination.ports.memberY[0]
	destination.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "after-movement").assertTrue()
	// Exhausting arrival pathing later must not prevent ordinary location loads.
	let route = destination.campaign.state.boundary("africa_to_middle_east_india")
	route.destination.count = 0
	destination.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	(RAbsBJ(destination.ports.memberX[0] - x) < .01).assertTrue()
	(RAbsBJ(destination.ports.memberY[0] - y) < .01).assertTrue()
	destination.ports.activePlayers.assertEquals(2)

@test function lostRepresentationsRetainCommittedPositionsAndRemoteCompanionsStayAbstract()
	let f = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	f.start("england")
	deployRecordedCompanion(f)
	moveRecordedMember(f, 0, 1)
	moveRecordedMember(f, 1, -1)
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "before-loss").assertTrue()
	let x = f.ports.memberX[1]
	let y = f.ports.memberY[1]
	f.ports.represented[1] = false
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 2, "after-loss").assertTrue()
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertTrue()
	(RAbsBJ(f.ports.memberX[1] - x) < .01).assertTrue()
	(RAbsBJ(f.ports.memberY[1] - y) < .01).assertTrue()
	let companion = f.campaign.state.rpg.heroes.heroes[1]
	companion.assignment = "governor"
	companion.regionId = "east_asia"
	f.ports.represented[1] = false
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 3, "remote").assertTrue()
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 3).assertTrue()
	f.ports.activePlayers.assertEquals(1)
	f.ports.represented[1].assertFalse()
	companion.assignment.assertEquals("governor")
	companion.regionId.assertEquals("east_asia")
	// A field assignment in a different physical region is also nonlocal.
	companion.assignment = "field"
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 4, "remote-field").assertTrue()
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 4).assertTrue()
	f.ports.represented[1].assertFalse()

@test function failedPartyReconstructionRetainsMovedMembersAuthorityAndStoredSaves()
	let f = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	f.start("england")
	deployRecordedCompanion(f)
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "candidate").assertTrue()
	let stored = f.saves.read("manual_01")
	moveRecordedMember(f, 0, 1)
	moveRecordedMember(f, 1, -1)
	let before = f.campaign.state.captureAuthoritativeState()
	let authority = f.campaign.state.authorityDocument()
	let x0 = f.ports.memberX[0]
	let y0 = f.ports.memberY[0]
	let x1 = f.ports.memberX[1]
	let y1 = f.ports.memberY[1]
	let writes = f.saves.writes
	f.ports.failAfterFirstMember = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.ports.memberX[0].assertEquals(x0)
	f.ports.memberY[0].assertEquals(y0)
	f.ports.memberX[1].assertEquals(x1)
	f.ports.memberY[1].assertEquals(y1)
	f.campaign.state.authorityDocument().assertEquals(authority)
	f.campaign.state.captureAuthoritativeState().assertEquals(before)
	f.saves.read("manual_01").assertEquals(stored)
	f.saves.writes.assertEquals(writes)
	f.campaign.state.isSaveSafe().assertTrue()
	f.ports.failAfterFirstMember = false
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()

function coordinateLessSaveSchemasUseDeterministicFallback(int firstSchema, int lastSchema)
	let f = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	f.start("england")
	moveRecordedMember(f, 1, 1)
	let saved = f.campaign.state.captureAuthoritativeState()
	let marker = saved.indexOf(";partyLocations=")
	let tail = SubString(saved, marker + 16, StringLength(saved))
	let finish = tail.indexOf(";")
	var legacy = SubString(saved, 0, marker)
	if finish >= 0
		legacy += SubString(tail, finish, StringLength(tail))
	// Actual older deployment retained the main character's authored home
	// region even when the chosen origin was on another physical map.
	f.campaign.state.rpg.heroes.heroes[1].regionId = "southeast_asia"
	legacy = replaceCampaignField(legacy, "rpg", f.campaign.state.rpg.captureState())
	f.campaign.state.rpg.heroes.heroes[1].regionId = ""
	for schema = firstSchema to lastSchema
		let payload = campaignSaveEnvelope(schema, "manual_01", SAVE_SLOT_MANUAL, 1, "old-save", legacy)
		f.saves.writeTransactional("manual_01", payload)
		f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
		f.campaign.state.rpg.heroes.heroes[1].regionId.assertEquals("")
		let origin = f.campaign.origins.find("england")
		(RAbsBJ(f.ports.memberX[1] - origin.x) < .01).assertTrue()
		(RAbsBJ(f.ports.memberY[1] - origin.y) < .01).assertTrue()
		f.saves.read("manual_01").assertEquals(payload)
		moveRecordedMember(f, 1, 1)
		let x = f.ports.memberX[1]
		let y = f.ports.memberY[1]
		f.campaign.saves.save(SAVE_SLOT_MANUAL, 2, "upgraded").assertTrue()
		f.campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertTrue()
		(RAbsBJ(f.ports.memberX[1] - x) < .01).assertTrue()
		(RAbsBJ(f.ports.memberY[1] - y) < .01).assertTrue()

@test function coordinateLessSchemasOneAndTwoUseDeterministicFallback()
	coordinateLessSaveSchemasUseDeterministicFallback(1, 2)

@test function coordinateLessSchemasThreeAndFourUseDeterministicFallback()
	coordinateLessSaveSchemasUseDeterministicFallback(3, 4)

@test function coordinateLessSchemasFiveAndSixUseDeterministicFallback()
	coordinateLessSaveSchemasUseDeterministicFallback(5, 6)

@test function malformedAndBlockedPartyLocationsRejectWithoutRelocatingAuthority()
	let f = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	f.start("england")
	moveRecordedMember(f, 1, 1)
	let before = f.campaign.state.captureAuthoritativeState()
	let locations = parsePartyLocations(lastAuthorityValue(before, "partyLocations"))
	let value = locations.entries[0]
	let validRecord = value.encode()
	let validX = value.x
	let validY = value.y
	string array[6] invalid
	value.mapId = "east_asia"
	invalid[0] = locations.encode()
	value.mapId = "europe_west"
	value.x = 999999.
	invalid[1] = locations.encode()
	value.x = validX
	value.component += 10000
	invalid[2] = locations.encode()
	value.component -= 10000
	value.id = "unknown_hero"
	invalid[3] = locations.encode()
	invalid[4] = "v1|" + validRecord + "|" + validRecord
	invalid[5] = "v1" // Cannot omit the active main character.
	for i = 0 to 5
		let document = replaceCampaignField(before, "partyLocations", invalid[i])
		let malformedPayload = campaignSaveEnvelope(7, "manual_01", SAVE_SLOT_MANUAL, 1, "malformed", document)
		f.saves.writeTransactional("manual_01", malformedPayload)
		f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
		f.saves.read("manual_01").assertEquals(malformedPayload)
		f.campaign.state.captureAuthoritativeState().assertEquals(before)
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "valid").assertTrue()
	let payload = f.saves.read("manual_01")
	f.ports.arrivalAvailable = false
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.ports.memberX[1].assertEquals(validX)
	f.ports.memberY[1].assertEquals(validY)
	f.saves.read("manual_01").assertEquals(payload)
	f.ports.arrivalAvailable = true
	f.ports.blockOnePoint = true
	f.ports.blockedX = validX
	f.ports.blockedY = validY
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	let dx = f.ports.memberX[1] - validX
	let dy = f.ports.memberY[1] - validY
	(dx * dx + dy * dy > 0. and dx * dx + dy * dy <= 512. * 512.).assertTrue()
	f.campaign.state.partyNavigation.componentAt(f.ports.memberX[1], f.ports.memberY[1]).assertEquals(f.campaign.state.partyNavigation.componentAt(validX, validY))
	f.saves.read("manual_01").assertEquals(payload)
	destroy locations

@test function transferDoesNotMaterializeAbstractCompanionAssignedToDestination()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	let remote = source.campaign.state.rpg.heroes.heroes[0]
	remote.recruited = true
	remote.assignment = "field"
	remote.regionId = "middle_east_india"
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_middle_east_india"), .37, "travel").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	destination.register()
	destination.campaign.startup().assertTrue()
	destination.ports.activePlayers.assertEquals(1)
	destination.ports.represented[0].assertFalse()
	destination.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "local-only").assertTrue()
	destination.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	destination.ports.activePlayers.assertEquals(1)
	destination.ports.represented[0].assertFalse()
	destination.campaign.state.rpg.heroes.heroes[0].assignment.assertEquals("field")
	destination.campaign.state.rpg.heroes.heroes[0].regionId.assertEquals("middle_east_india")
	// A checksummed arrival cannot enroll an abstract member whose saved
	// assignment was never on the source map. Reject before changing that
	// assignment, retaining the destination party and all source slots.
	let before = destination.campaign.state.captureAuthoritativeState()
	let transfer = destination.campaign.saves.codec.decodeMigrateAndValidate(source.saves.read("major_milestone"), "major_milestone")
	let arrival = lastAuthorityValue(transfer, "partyLocations")
	let travelers = parsePartyLocations("v1" + SubString(arrival, 7, StringLength(arrival)))
	let local = travelers.entries[0]
	travelers.add(new PartyLocation(remote.id, local.mapId, local.x, local.y, local.component, local.safeX, local.safeY))
	let records = travelers.encode()
	for attempt = 0 to 1
		var arriving = "arrival" + SubString(records, 2, StringLength(records))
		if attempt == 1
			arriving = "arrival" // Missing membership cannot mean every local field row.
		let candidate = replaceCampaignField(transfer, "partyLocations", arriving)
		let invalid = campaignSaveEnvelope(CAMPAIGN_SAVE_SCHEMA_CURRENT, "manual_02", SAVE_SLOT_MANUAL, 2, "nonlocal-traveler", candidate)
		destination.saves.writeTransactional("manual_02", invalid).assertTrue()
		let writes = destination.saves.writes
		destination.campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertFalse()
		destination.campaign.state.captureAuthoritativeState().assertEquals(before)
		destination.ports.activePlayers.assertEquals(1)
		destination.ports.represented[0].assertFalse()
		destination.saves.read("manual_02").assertEquals(invalid)
		destination.saves.writes.assertEquals(writes)
	destroy travelers

@test function productionAutosaveDelayAndRotationSurviveGeneratedDestinationStartup()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	let sourceWake = new RecordingAutosaveTimer()
	source.campaign.enableAutosaveTimer(sourceWake, null).assertFalse()
	sourceWake.starts.assertEquals(0)
	source.start("ethiopian_empire")
	source.campaign.enableAutosaveTimer(sourceWake, null).assertTrue()
	sourceWake.fire("first")
	sourceWake.elapse(127.125)
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_middle_east_india"), .37, "travel").assertTrue()
	source.campaign.autosaves.detachTimer()
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	let destinationWake = new RecordingAutosaveTimer()
	destination.register()
	destination.campaign.startup().assertTrue()
	destination.campaign.autosaves.nextSlotIndex().assertEquals(2)
	destination.campaign.autosaves.secondsUntilDue().assertEquals(172.875)
	destination.campaign.enableAutosaveTimer(destinationWake, null).assertTrue()
	destinationWake.starts.assertEquals(1)
	destinationWake.delay.assertEquals(172.875)
	destinationWake.fire("second")
	destination.campaign.autosaves.nextSlotIndex().assertEquals(3)
	let payload = destination.saves.read("autosave_02")
	destination.campaign.saves.load(SAVE_SLOT_AUTOSAVE, 2).assertTrue()
	destination.campaign.autosaves.nextSlotIndex().assertEquals(3)
	destinationWake.delay.assertEquals(300.)
	destination.saves.read("autosave_02").assertEquals(payload)
	destination.campaign.autosaves.detachTimer()
