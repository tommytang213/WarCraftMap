@test function configuredScaleOffsetAndReverseAreNotReappliedByDestinationStartup()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "middle_east_india")
	source.start("aq_qoyunlu")
	let route = source.campaign.state.boundary("middle_east_india_to_europe_central_east")
	// A configured variation of the registered route, with its generated
	// source segment and destination pathing retained.
	route.reverse = true
	route.scale = .5
	route.offset = .1
	source.campaign.travel.transition(route, .37, "fixed-time").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "europe_central_east")
	destination.register()
	let arrivalRoute = destination.campaign.state.boundary(route.id)
	arrivalRoute.reverse = true
	arrivalRoute.scale = .5
	arrivalRoute.offset = .1
	destination.campaign.startup().assertTrue()
	destination.ports.x.assertEquals(7232.)
	(RAbsBJ(destination.ports.y + 1518.08) < .01).assertTrue()

@test function reversedGeneratedBoundaryAppliesTransformOnceThenPartialReturnSegment()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "middle_east_india")
	source.start("aq_qoyunlu")
	let outward = source.campaign.state.boundary("middle_east_india_to_africa")
	source.campaign.travel.transition(outward, .75, "fixed-time").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "africa")
	destination.register()
	destination.campaign.startup().assertTrue()
	destination.ports.x.assertEquals(7232.)
	destination.ports.y.assertEquals(-3808.)
	parseBoundaryPosition(lastAuthorityValue(destination.campaign.state.authorityDocument(), "position")).assertEquals(.25)
	destination.ports.selectorIdentity = destination.campaign.identity
	let returning = destination.campaign.state.boundary("africa_to_middle_east_india")
	destination.campaign.travel.transition(returning, .37, "fixed-time").assertTrue()
	let revisited = new StartupFixture(source.cache, source.saves, "middle_east_india")
	revisited.register()
	revisited.campaign.startup().assertTrue()
	revisited.ports.x.assertEquals(-7232.)
	revisited.ports.y.assertEquals(2490.88)
	revisited.campaign.identity.originId().assertEquals("aq_qoyunlu")

@test function destinationUnavailableRetainsTransferForRetryWithoutPartyOrAutosaves()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	source.campaign.travel.transition(source.campaign.state.boundary("africa_to_middle_east_india"), .37, "fixed-time").assertTrue()
	let saved = source.saves.read("major_milestone")
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	destination.register()
	destination.ports.arrivalAvailable = false
	destination.campaign.startup().assertFalse()
	destination.ports.spawns.assertEquals(0)
