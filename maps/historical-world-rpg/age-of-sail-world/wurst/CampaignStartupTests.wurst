class StartupLoadObserver implements CampaignLoadObserver
	int calls = 0
	override function afterCampaignLoad()
		calls++

function rejectedBoundCheckpoint(string failure, boolean failProjection)
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "europe_west")
	source.choose("england")
	source.register()
	source.cache.failKey = HANDOFF_REQUEST
	source.campaign.startup().assertFalse()
	let request = source.handoff.readRequest()
	// Keep the selector binding, but populate a visibly different valid checkpoint.
	source.clock.advanceTo(source.clock.startDay + 1000).assertTrue()
	source.clock.setSpeed(1.125).assertTrue()
	source.clock.advanceElapsed(.125).assertTrue()
	let savedClock = source.clock.captureState()
	source.campaign.state.rpg.heroes.heroes[0].level = 40
	source.campaign.state.rpg.journal.currency = 321
	source.campaign.state.militarySettlements.forces[0].supply = 7
	source.campaign.countries.treasury[0] = 2345
	let checkpoint = source.campaign.saves.codec.encode(request.checkpointSlot(), SAVE_SLOT_SESSION_START, 0, "fixture", source.campaign.state.captureAuthoritativeState())
	source.cache.writeTransactional(request.checkpointSlot(), checkpoint)
	let restored = new StartupFixture(source.cache, source.saves, "europe_west")
	restored.register()
	restored.ports.expectedClock = savedClock
	let before = restored.campaign.state.captureAuthoritativeState()
	let observer = new StartupLoadObserver()
	restored.campaign.saves.setLoadObserver(observer)
	restored.ports.failProjection = failProjection
	if failure == HANDOFF_REQUEST
		restored.cache.failKey = failure
	else
		restored.saves.failKey = failure
	restored.campaign.startup().assertFalse()
	restored.campaign.state.captureAuthoritativeState().assertEquals(before)
	restored.campaign.identity.hasOrigin().assertFalse()
	restored.ports.activePlayers.assertEquals(0)
	observer.calls.assertEquals(0)
	restored.handoff.readRequest().status.assertEquals("pending")
	restored.cache.read(request.checkpointSlot()).assertEquals(checkpoint)
	restored.campaign.state.isSaveSafe().assertFalse()
	restored.ports.failProjection = false
	restored.campaign.startup().assertTrue()
	restored.clock.captureState().assertEquals(savedClock)
	restored.campaign.state.rpg.heroes.heroes[0].level.assertEquals(40)
	restored.campaign.state.rpg.journal.currency.assertEquals(321)
	restored.ports.activePlayers.assertEquals(1)
	observer.calls.assertEquals(1)
	restored.cache.read(request.checkpointSlot()).assertEquals(checkpoint)

