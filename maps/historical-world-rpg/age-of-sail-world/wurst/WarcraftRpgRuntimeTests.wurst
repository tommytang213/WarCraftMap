package WarcraftRpgRuntimeTests
import WarcraftRpgRuntime
import ScenarioData
import CampaignTimeline

class Effects implements TechnologyEffectPort
	int applied=0
	int cleared=0
	override function applyTechnology(string controllerId,string effectId,int magnitude)
		applied+=magnitude
	override function clearTechnologyLayer(string controllerId)
		cleared++

class Projections implements RpgProjectionPort
	int clears=0
	int equipmentPower=0
	int setPower=0
	int guidance=0
	int knowledge=0
	override function beginPartyLoad()
		skip
	override function rollbackPartyLoad()
		skip
	override function commitPartyLoad()
		skip
	override function clearEquipmentLayer()
		clears++
		equipmentPower=0
		setPower=0
	override function applyEquipment(string heroId,string itemId,int power)
		equipmentPower+=power
	override function applyEquipmentSet(string heroId,string setId,int power)
		setPower+=power
	override function clearGuidanceLayer()
		guidance=0
	override function applyQuestGuidance(string questId,string precision,string regionId,string destinationId)
		guidance++
	override function clearTreasureKnowledgeLayer()
		knowledge=0
	override function applyTreasureKnowledge(string treasureId,int clueStage,boolean discovered)
		knowledge+=clueStage

@test function recruitmentProgressionRecoveryAndReconstruction()
	let runtime=new WarcraftRpgRuntime(new Effects())
	runtime.heroes.clock=new CampaignClock(1,100,1,1.)
	let hero=new RpgHero("nelson","Horatio Nelson",'Hpal')
	runtime.heroes.register(hero)
	runtime.heroes.recruit("nelson").assertEquals(true)
	hero.awardExperience(100)
	hero.level.assertEquals(2)
	hero.commandExperience=400
	hero.changeLoyalty(50)
	hero.becomeOathbound()
	hero.changeLoyalty(-100)
	hero.loyalty.assertEquals(100)
	hero.wound(10,5)
	hero.advanceRecovery(14)
	hero.incapacitated.assertEquals(true)
	hero.advanceRecovery(15)
	hero.incapacitated.assertEquals(false)
	runtime.heroes.strategicRosterSize().assertEquals(1)

@test function equipmentRequirementsComparisonUniquenessAndSets()
	let runtime=new WarcraftRpgRuntime(new Effects())
	let hero=new RpgHero("hero","Hero",'Hpal')
	hero.level=20
	hero.recruited=true
	let coat=new RpgItem("coat","Coat","chest","rare",10,5)
	coat.setId="set"
	coat.unique=true
	let hat=new RpgItem("hat","Hat","head","rare",10,4)
	hat.setId="set"
	runtime.inventory.registerItem(coat)
	runtime.inventory.registerItem(hat)
	runtime.inventory.registerSet(new EquipmentSet("set",2,3,2,7))
	runtime.inventory.grant("coat").assertEquals(true)
	runtime.inventory.grant("coat").assertEquals(false)
	runtime.inventory.grant("hat")
	runtime.inventory.equip("hero","coat",hero,1600,"","").assertEquals(true)
	runtime.inventory.equip("hero","hat",hero,1600,"","").assertEquals(true)
	runtime.inventory.setBonusPower("hero").assertEquals(10)

@test function questTreasureTechnologyAndReconstruction()
	let effects=new Effects()
	let runtime=new WarcraftRpgRuntime(effects)
	let hero=new RpgHero("hero","Hero",'Hpal')
	hero.recruited=true
	let questDefinition=new RuntimeQuest("quest","A Quest","regional")
	questDefinition.objectiveTarget=2
	questDefinition.rewardExperience=100
	questDefinition.rewardCurrency=20
	questDefinition.precision="approximate"
	questDefinition.regionId="europe"
	questDefinition.destinationId="search_area"
	runtime.journal.register(questDefinition)
	runtime.journal.accept("quest").assertEquals(true)
	runtime.journal.progress("quest",2).assertEquals(true)
	runtime.journal.turnIn("quest",hero,5,10).assertEquals(true)
	hero.level.assertEquals(2)
	runtime.journal.currency.assertEquals(20)
	let relic=new RpgItem("relic","Relic","artifact","legendary",100,50)
	runtime.inventory.registerItem(relic)
	let treasure=new RuntimeTreasure("secret","europe","cave")
	treasure.clueCount=1
	treasure.rewardItemId="relic"
	runtime.treasures.register(treasure)
	runtime.treasures.advanceClue("secret")
	runtime.treasures.discover("secret","cave",runtime.inventory).assertEquals(true)
	runtime.inventory.owns("relic").assertEquals(true)
	let technology=new RuntimeTechnology("printing","Printing",1450,100)
	technology.effectId="merchant_stock"
	technology.effectMagnitude=2
	runtime.technologies.register(technology)
	runtime.technologies.unlock("england","printing",1450,100,0,0).assertEquals(true)
	effects.applied.assertEquals(2)
	runtime.technologies.reconstruct("england")
	effects.cleared.assertEquals(1)
	effects.applied.assertEquals(4)

@test function authoritativeStateRoundTripsAndReconcilesExactlyOnce()
	let effects=new Effects()
	let source=new WarcraftRpgRuntime(effects)
	source.heroes.clock=new CampaignClock(1,100,1,1.)
	let hero=new RpgHero("hero","Hero",'Hpal')
	source.heroes.register(hero)
	source.heroes.recruit("hero")
	hero.level=20
	hero.masteryPoints=4
	hero.choosePerk("navigation",1)
	hero.wound(10,5)
	let coat=new RpgItem("coat","Coat","chest","rare",10,5)
	coat.setId="set"
	coat.unique=true
	source.inventory.registerItem(coat)
	source.inventory.registerSet(new EquipmentSet("set",1,3,2,7))
	source.inventory.grant("coat")
	source.inventory.equip("hero","coat",hero,1600,"","")
	let technology=new RuntimeTechnology("printing","Printing",1450,100)
	technology.effectId="stock"
	technology.effectMagnitude=2
	source.technologies.register(technology)
	source.technologies.unlock("player","printing",1450,100,0,0)
	let questDefinition=new RuntimeQuest("quest","Quest","regional")
	questDefinition.precision="approximate"
	questDefinition.regionId="europe"
	questDefinition.destinationId="harbor"
	source.journal.register(questDefinition)
	source.journal.accept("quest")
	source.journal.progress("quest",1)
	source.journal.track("quest")
	let treasure=new RuntimeTreasure("treasure","europe","cave")
	treasure.clueCount=2
	source.treasures.register(treasure)
	source.treasures.advanceClue("treasure")
	let saved=source.captureState()
	let restored=new WarcraftRpgRuntime(effects)
	let restoredHero=new RpgHero("hero","Hero",'Hpal')
	restored.heroes.register(restoredHero)
	let restoredCoat=new RpgItem("coat","Coat","chest","rare",10,5)
	restoredCoat.setId="set"
	restoredCoat.unique=true
	restored.inventory.registerItem(restoredCoat)
	restored.inventory.registerSet(new EquipmentSet("set",1,3,2,7))
	let restoredTechnology=new RuntimeTechnology("printing","Printing",1450,100)
	restoredTechnology.effectId="stock"
	restoredTechnology.effectMagnitude=2
	restored.technologies.register(restoredTechnology)
	let restoredQuest=new RuntimeQuest("quest","Quest","regional")
	restoredQuest.precision="approximate"
	restoredQuest.regionId="europe"
	restoredQuest.destinationId="harbor"
	restored.journal.register(restoredQuest)
	let restoredTreasure=new RuntimeTreasure("treasure","europe","cave")
	restoredTreasure.clueCount=2
	restored.treasures.register(restoredTreasure)
	let projections=new Projections()
	restored.setProjectionPort(projections)
	restored.restoreState(saved).assertTrue()
	restored.captureState().assertEquals(saved)
	restored.reconcile("player")
	projections.clears.assertEquals(1)
	projections.equipmentPower.assertEquals(5)
	projections.setPower.assertEquals(3)
	projections.guidance.assertEquals(1)
	projections.knowledge.assertEquals(1)
	restored.reconcile("player")
	projections.clears.assertEquals(2)
	projections.equipmentPower.assertEquals(5)
	projections.setPower.assertEquals(3)
	projections.guidance.assertEquals(1)
	projections.knowledge.assertEquals(1)
	let before=restored.captureState()
	restored.restoreState("v99|broken").assertFalse()
	restored.captureState().assertEquals(before)

@test function rpgRewardsProjectionsAndRepeatLock()
	let effects=new Effects()
	let runtime=new WarcraftRpgRuntime(effects)
	let projections=new Projections()
	runtime.setProjectionPort(projections)
	let hero=new RpgHero("hero","Hero",'Hpal')
	hero.level=20
	hero.recruited=true
	runtime.heroes.register(hero)
	let blade=new RpgItem("blade","Blade","hand","rare",10,6)
	runtime.inventory.registerItem(blade)
	runtime.inventory.grant("blade")
	runtime.equipItem("hero","blade",1450).assertTrue()
	projections.equipmentPower.assertEquals(6)
	let technology=new RuntimeTechnology("navigation","Navigation",1450,10)
	technology.effectId="range"
	technology.effectMagnitude=2
	runtime.technologies.register(technology)
	runtime.research("player","navigation",1450,10).assertTrue()
	effects.applied.assertEquals(2)
	let questDefinition=new RuntimeQuest("harbor_task","Harbor task","regional")
	questDefinition.destinationId="london"
	questDefinition.turnInId="london"
	questDefinition.objectiveTarget=1
	questDefinition.completionCap=2
	runtime.journal.register(questDefinition)
	runtime.acceptQuest("harbor_task").assertTrue()
	runtime.journal.progress("harbor_task",1).assertTrue()
	runtime.journal.turnIn("harbor_task",hero,0,30).assertTrue()
	questDefinition.state.assertEquals(QUEST_COMPLETE)
	runtime.acceptQuest("harbor_task").assertFalse()
	runtime.journal.refill(30)
	runtime.acceptQuest("harbor_task").assertTrue()
	let treasure=new RuntimeTreasure("charts","europe","london")
	treasure.clueCount=1
	treasure.rewardItemId="blade"
	runtime.treasures.register(treasure)
	runtime.treasures.advanceClue("charts").assertTrue()
	runtime.treasures.discover("charts","london",runtime.inventory).assertTrue()
	treasure.discovered.assertTrue()
	let saved=runtime.captureState()
	runtime.restoreState(saved).assertTrue()
	runtime.captureState().assertEquals(saved)

@test function minimalOptionalRecordsHaveValidDefaultsAndReconstruct()
	let effects=new Effects()
	let runtime=new WarcraftRpgRuntime(effects)
	runtime.heroes.clock=new CampaignClock(1,100,1,1.)
	let projections=new Projections()
	runtime.setProjectionPort(projections)
	let hero=new RpgHero("hero","Hero",'Hpal')
	runtime.heroes.register(hero)
	runtime.heroes.recruit("hero").assertTrue()
	let itemDefinition=new RpgItem("plain","Plain","hand","common",1,1)
	itemDefinition.setId.assertEquals("")
	itemDefinition.source.assertEquals("")
	runtime.inventory.registerItem(itemDefinition)
	runtime.inventory.grant("plain").assertTrue()
	runtime.equipItem("hero","plain",1450).assertTrue()
	(runtime.inventory.comparison("hero","plain").indexOf("Plain")>=0).assertTrue()
	let technology=new RuntimeTechnology("basic","Basic",1450,1)
	technology.effectId.assertEquals("")
	runtime.technologies.register(technology)
	runtime.research("player","basic",1450,1).assertTrue()
	let q=new RuntimeQuest("hidden","Hidden","regional")
	runtime.journal.register(q)
	runtime.acceptQuest("hidden").assertTrue()
	runtime.journal.track("hidden").assertEquals("No destination is revealed yet.")
	runtime.worldEvent("location","unrelated",1).assertFalse()
	runtime.journal.progress("hidden",1).assertTrue()
	runtime.journal.turnIn("hidden",hero,1,30).assertTrue()
	let treasure=new RuntimeTreasure("empty_reward","region","cave")
	runtime.treasures.register(treasure)
	runtime.treasures.advanceClue("empty_reward").assertTrue()
	runtime.treasures.discover("empty_reward","cave",runtime.inventory).assertTrue()
	let saved=runtime.captureState()
	for i=1 to 2
		runtime.restoreState(saved).assertTrue()
		runtime.reconcile("player")
		runtime.captureState().assertEquals(saved)
		projections.equipmentPower.assertEquals(1)
		projections.knowledge.assertEquals(1)
	// Ordinary duplicates are inventory copies, while unique items and hero
	// authority still reject duplicate records without changing active state.
	runtime.inventory.grant("plain").assertTrue()
	let uniqueItem=new RpgItem("unique","Unique","artifact","rare",1,1)
	uniqueItem.unique=true
	runtime.inventory.registerItem(uniqueItem)
	runtime.inventory.grant("unique").assertTrue()
	let withCopies=runtime.captureState()
	runtime.restoreState(withCopies).assertTrue()
	runtime.inventory.ownedCount.assertEquals(3)
	runtime.restoreState(withCopies+"|i,unique").assertFalse()
	runtime.captureState().assertEquals(withCopies)
	runtime.restoreState(withCopies+"|h,hero").assertFalse()
	runtime.captureState().assertEquals(withCopies)

@test function snapshotRecordBoundariesRetainEmptyFieldsAndRejectMalformedSuffixes()
	let runtime = new WarcraftRpgRuntime(new Effects())
	runtime.heroes.register(new RpgHero("hero", "Hero", 'Hpal'))
	runtime.heroes.recruit("hero").assertTrue()
	runtime.journal.register(new RuntimeQuest("quest", "Quest", "regional"))
	runtime.treasures.register(new RuntimeTreasure("treasure", "region", "cave"))
	let saved = runtime.captureState()
	// Empty optional hero fields and an untracked journal are valid. Retain
	// the codec's existing support for an optional final record separator.
	runtime.restoreState(saved + "|").assertTrue()
	runtime.captureState().assertEquals(saved)
	runtime.restoreState(saved).assertTrue()
	runtime.captureState().assertEquals(saved)
	// Empty interior records and unknown final records reject atomically.
	runtime.restoreState("v2||" + SubString(saved, 3, StringLength(saved))).assertFalse()
	runtime.captureState().assertEquals(saved)
	runtime.restoreState(saved + "||").assertFalse()
	runtime.captureState().assertEquals(saved)
	runtime.restoreState(saved + "|unknown,late").assertFalse()
	runtime.captureState().assertEquals(saved)
	runtime.restoreState(saved + "|q,quest").assertFalse()
	runtime.captureState().assertEquals(saved)
	let nextRecord = saved.indexOf("|q,")
	runtime.restoreState(SubString(saved, 0, nextRecord) + ",extra" + SubString(saved, nextRecord, StringLength(saved))).assertFalse()
	runtime.captureState().assertEquals(saved)

@test function reorderedSnapshotsAndCollidingStableIdsRestoreWithoutMergingAuthority()
	let runtime = new WarcraftRpgRuntime(new Effects())
	// Warcraft's hash is case-insensitive, but stable IDs compare exactly.
	StringHash("h,hero").assertEquals(StringHash("h,HERO"))
	runtime.heroes.register(new RpgHero("hero", "First", 'Hpal'))
	runtime.heroes.register(new RpgHero("HERO", "Second", 'Hpal'))
	runtime.heroes.get("hero").level = 3
	runtime.heroes.get("HERO").level = 7
	for i = 0 to 1
		let id = i.toString()
		runtime.journal.register(new RuntimeQuest("quest" + id, "Quest", "regional"))
		runtime.journal.accept("quest" + id).assertTrue()
		let treasure = new RuntimeTreasure("treasure" + id, "region", "cave")
		treasure.clueStage = 1
		runtime.treasures.register(treasure)
	let saved = runtime.captureState()
	var reordered = "v2"
	var start = 3
	while start < StringLength(saved)
		var finish = saved.indexOf("|", start)
		if finish < 0
			finish = StringLength(saved)
		reordered = "v2|" + SubString(saved, start, finish) + SubString(reordered, 2, StringLength(reordered))
		start = finish + 1
	runtime.restoreState("v1").assertTrue()
	runtime.restoreState(reordered).assertTrue()
	runtime.captureState().assertEquals(saved)
	let firstRecord = SubString(saved, 3, saved.indexOf("|", 3))
	runtime.restoreState(reordered + "|" + firstRecord).assertFalse()
	runtime.captureState().assertEquals(saved)
	runtime.restoreState(saved).assertTrue()
	runtime.captureState().assertEquals(saved)

@test function generatedItemComparisonsCoverEveryDefinition()
	let runtime=new WarcraftRpgRuntime(new Effects())
	configureGeneratedRpg(runtime)
	let hero=runtime.heroes.heroes[0]
	runtime.heroes.recruit(hero.id).assertTrue()
	for i=0 to runtime.inventory.definitionCount-1
		let itemDefinition=runtime.inventory.definitions[i]
		(runtime.inventory.comparison(hero.id,itemDefinition.id) != "Unknown item").assertTrue()

/** Execute every generated registration and populate each authority domain. */
function generatedRpgWithProgress() returns WarcraftRpgRuntime
	let runtime=new WarcraftRpgRuntime(new Effects())
	configureGeneratedRpg(runtime)
	(runtime.heroes.count>0).assertTrue()
	(runtime.inventory.definitionCount>0).assertTrue()
	(runtime.technologies.count>0).assertTrue()
	(runtime.journal.count>0).assertTrue()
	(runtime.treasures.count>0).assertTrue()
	let hero=runtime.heroes.heroes[0]
	runtime.heroes.clock=configureCampaignTimeline()
	runtime.heroes.clock.advanceTo(hero.availabilityStartDay).assertTrue()
	runtime.heroes.recruit(hero.id).assertTrue()
	var equipped=false
	for i=0 to runtime.inventory.definitionCount-1
		let itemDefinition=runtime.inventory.definitions[i]
		if not equipped and runtime.inventory.available(itemDefinition,hero,1450,"","")
			runtime.inventory.grant(itemDefinition.id).assertTrue()
			runtime.equipItem(hero.id,itemDefinition.id,1450).assertTrue()
			equipped=true
	equipped.assertTrue()
	var researched=false
	for i=0 to runtime.technologies.count-1
		let technology=runtime.technologies.definitions[i]
		if not researched and technology.prerequisiteCount == 0
			runtime.research("player",technology.id,1450,runtime.technologies.cost(technology.id,1450,0,0)).assertTrue()
			researched=true
	researched.assertTrue()
	let q=runtime.journal.quests[0]
	runtime.acceptQuest(q.id).assertTrue()
	// Catalogue/codec unit coverage; physical commands execute in RpgInteractionTests.
	runtime.journal.progress(q.id,1).assertTrue()
	runtime.journal.turnIn(q.id,hero,1,30).assertTrue()
	q.state.assertEquals(QUEST_COMPLETE)
	let treasure=runtime.treasures.treasures[0]
	for i=1 to treasure.clueCount
		runtime.treasures.advanceClue(treasure.id).assertTrue()
	runtime.treasures.discover(treasure.id,treasure.resolvedLocationId,runtime.inventory).assertTrue()
	treasure.discovered.assertTrue()
	return runtime

/** Partition only the fixture population after production registration. The
 * intervals cover every generated hero, quest and treasure; row zero remains
 * in each batch for the populated equipment, reward and guidance relations. */
function selectGeneratedBatch(WarcraftRpgRuntime runtime, string domain, int part, int parts)
	let heroes = runtime.heroes.count
	let quests = runtime.journal.count
	let treasures = runtime.treasures.count
	runtime.heroes.count = 1
	runtime.journal.count = 1
	runtime.treasures.count = 1
	if domain == "heroes"
		for i = heroes * part div parts to heroes * (part + 1) div parts - 1
			if i > 0
				runtime.heroes.heroes[runtime.heroes.count] = runtime.heroes.heroes[i]
				runtime.heroes.count++
	else if domain == "quests"
		for i = quests * part div parts to quests * (part + 1) div parts - 1
			if i > 0
				runtime.journal.quests[runtime.journal.count] = runtime.journal.quests[i]
				runtime.journal.count++
	else
		runtime.treasures.count = treasures

function generatedBatchRoundTrips(string domain, int part, int parts)
	let runtime=generatedRpgWithProgress()
	selectGeneratedBatch(runtime, domain, part, parts)
	let saved=runtime.captureState()
	let restored=new WarcraftRpgRuntime(new Effects())
	configureGeneratedRpg(restored)
	selectGeneratedBatch(restored, domain, part, parts)
	let projections=new Projections()
	restored.setProjectionPort(projections)
	for i=1 to 2
		restored.restoreState(saved).assertTrue()
		restored.reconcile("player")
		restored.captureState().assertEquals(saved)
	projections.clears.assertEquals(2)
	projections.guidance.assertEquals(1)

@test function generatedRpgRecordsExecuteAndRestoreThroughProductionRegistration()
	generatedBatchRoundTrips("heroes", 0, 4)

@test function generatedHeroesSecondQuarterRoundTrips()
	generatedBatchRoundTrips("heroes", 1, 4)

