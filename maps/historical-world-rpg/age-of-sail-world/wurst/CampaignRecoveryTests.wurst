@test function laterOriginSelectionSupersedesPendingRecovery()
	let trip = new RecoveryTrip()
	let commands = trip.commands
	registerCampaignSaveCommands(commands, trip.active.campaign)
	commands.dispatch(null, "/load 1").assertTrue()
	let pending = trip.active.cache.read(CAMPAIGN_RECOVERY_REQUEST)
	let selected = trip.source.saves.read("manual_01")
	let fresh = new StartupFixture(trip.active.cache, trip.source.saves, "middle_east_india")
	fresh.handoff.loader = new RecoveryTravelLoader()
	fresh.start("aq_qoyunlu")
	fresh.campaign.identity.originId().assertEquals("aq_qoyunlu")
	fresh.campaign.identity.physicalMapId().assertEquals("middle_east_india")
	trip.active.cache.read(CAMPAIGN_RECOVERY_REQUEST).assertEquals(pending)
	trip.source.saves.read("manual_01").assertEquals(selected)

@test function recoverySlotParsingIsBoundedBeforeNativeIntegerConversion()
	campaignSlotNumber("2147483647").assertEquals(2147483647)
	campaignSlotNumber("2147483648").assertEquals(0)
	campaignSlotNumber("999999999999999999999999999999999").assertEquals(0)
	campaignSlotNumber("1e2").assertEquals(0)
	campaignSlotNumber("01").assertEquals(0)
	campaignSlotNumber("1junk").assertEquals(0)
	campaignSlotNumber("-1").assertEquals(0)
	campaignSlotNumber("15").assertEquals(15)

@test function recoverySupersedesInterruptedOriginEvenAfterLaterTravel()
	let source = new StartupFixture(new StartupStorage(), new StartupStorage(), "africa")
	source.start("ethiopian_empire")
	source.trade.hold.money = 4321
	source.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "older-campaign").assertTrue()
	let selected = source.saves.read("manual_01")
	let interrupted = new StartupFixture(new StartupStorage(), source.saves, "middle_east_india")
	interrupted.choose("aq_qoyunlu")
	interrupted.register()
	interrupted.cache.failKey = HANDOFF_REQUEST
	interrupted.campaign.startup().assertFalse()
	interrupted.handoff.readRequest().status.assertEquals("pending")
	let commands = recoveryCommands(interrupted)
	registerCampaignSaveCommands(commands, interrupted.campaign)
	commands.dispatch(null, "/load 1").assertTrue()
	let recovered = new StartupFixture(interrupted.cache, source.saves, "africa")
	recovered.register()
	recovered.campaign.startup().assertTrue()
	recovered.campaign.identity.originId().assertEquals("ethiopian_empire")
	recovered.campaign.travel.loader = new RecoveryTravelLoader()
	recovered.campaign.travel.transition(recovered.campaign.state.boundary("africa_to_middle_east_india"), .37, "after-recovery").assertTrue()
	let destination = new StartupFixture(interrupted.cache, source.saves, "middle_east_india")
	destination.register()
	destination.campaign.startup().assertTrue()
	destination.campaign.identity.originId().assertEquals("ethiopian_empire")
	destination.trade.hold.money.assertEquals(4321)
	source.saves.read("manual_01").assertEquals(selected)
