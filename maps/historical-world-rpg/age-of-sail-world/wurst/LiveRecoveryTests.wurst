function connectedAnchor(LiveRecoveryFixture f, string zone) returns RecoveryPoint
	for i = 0 to f.natives.service.pointCount - 1
		if f.natives.service.points[i].zoneId == zone
			return f.natives.service.points[i]
	return null

function displaceWithinComponent(LiveRecoveryFixture f, unit target, string id)
	let e = f.natives.service.entity(id)
	for distanceStep = 8 to 24
		for direction = 0 to 3
			var x = e.x
			var y = e.y
			if direction == 0
				x += distanceStep * 128.
			else if direction == 1
				x -= distanceStep * 128.
			else if direction == 2
				y += distanceStep * 128.
			else
				y -= distanceStep * 128.
			if f.natives.service.navigation.zoneAt(e.movementClass, x, y) == e.zoneId
				compatSetUnitCoordinates(target, x, y)
				return
	false.assertTrue()

@test function liveRecoveryUsesPerEntityCandidatesThenLastSafeThenConnectedAnchor()
	let f = new LiveRecoveryFixture("europe_west", "england")
	registerUnstuckCommand(f.commands, f.natives.service)
	let first = f.recruit("first", MOVE_LAND, 'hfoo')
	let second = f.recruit("second", MOVE_LAND, 'hfoo')
	f.startup.campaign.state.recovery.refresh()
	displaceWithinComponent(f, second, "force:second")
	let firstX = GetUnitX(first)
	let firstY = GetUnitY(first)
	let secondX = GetUnitX(second)
	let secondY = GetUnitY(second)
	f.natives.selection[0] = first
	f.natives.selection[1] = second
	f.natives.selectionCount = 2
	f.commands.dispatch(Player(0), "/unstuck").assertTrue()
	f.natives.moves.assertEquals(2)
	let dx1 = GetUnitX(first) - firstX
	let dy1 = GetUnitY(first) - firstY
	let dx2 = GetUnitX(second) - secondX
	let dy2 = GetUnitY(second) - secondY
	(dx1 * dx1 + dy1 * dy1).assertEquals(1024.)
	(dx2 * dx2 + dy2 * dy2).assertEquals(1024.)
	let e = f.natives.service.entity("force:first")
	let anchor = connectedAnchor(f, e.zoneId)
	(anchor != null).assertTrue()
	let safeX = e.lastSafeX
	let safeY = e.lastSafeY
	// The command's nearby search cannot reach this saved point. The
	// generated anchor is blocked, proving the last-safe fallback is live.
	displaceWithinComponent(f, first, "force:first")
	f.natives.mode = 2
	f.natives.onlyX = safeX
	f.natives.onlyY = safeY
	f.natives.selectionCount = 1
	f.commands.dispatch(Player(0), "/unstuck").assertTrue()
	GetUnitX(first).assertEquals(safeX)
	GetUnitY(first).assertEquals(safeY)
	// Now last-safe is blocked too; only the connected generated anchor works.
	displaceWithinComponent(f, first, "force:first")
	f.natives.onlyX = anchor.x
	f.natives.onlyY = anchor.y
	f.commands.dispatch(Player(0), "/unstuck").assertTrue()
	GetUnitX(first).assertEquals(anchor.x)
	GetUnitY(first).assertEquals(anchor.y)
	f.natives.moves.assertEquals(4)
	print("TRACEABILITY {\"requirement\":\"REQ-0200.01\",\"case\":\"success\",\"entryPoint\":\"live-unstuck\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"transition\",\"outcome\"]}")

@test function liveRecoveryRejectsDisconnectedLandAndDecorativeWaterEvenWhenPathable()
	let f = new LiveRecoveryFixture("europe_west", "england")
	registerUnstuckCommand(f.commands, f.natives.service)
	let land = f.recruit("island_test", MOVE_LAND, 'hfoo')
	let ship = f.recruit("lake_test", MOVE_NAVAL, 'hdes')
	f.startup.campaign.state.recovery.refresh()
	for kind = MOVE_LAND to MOVE_NAVAL
		var target = land
		var id = "force:island_test"
		if kind == MOVE_NAVAL
			target = ship
			id = "force:lake_test"
		let e = f.natives.service.entity(id)
		RecoveryPoint disconnected = null
		for i = 0 to f.natives.service.pointCount - 1
			let point = f.natives.service.points[i]
			if point.movement[kind] and point.zoneId != e.zoneId
				disconnected = point
		(disconnected != null).assertTrue()
		f.natives.mode = 2
		f.natives.onlyX = disconnected.x
		f.natives.onlyY = disconnected.y
		f.natives.selection[0] = target
		f.natives.selectionCount = 1
		let x = GetUnitX(target)
		let y = GetUnitY(target)
		f.commands.dispatch(Player(0), "/unstuck").assertTrue()
		GetUnitX(target).assertEquals(x)
		GetUnitY(target).assertEquals(y)
	f.natives.moves.assertEquals(0)
	print("TRACEABILITY {\"requirement\":\"REQ-0196.01\",\"case\":\"success\",\"entryPoint\":\"live-unstuck\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"transition\",\"outcome\"]}")
	print("TRACEABILITY {\"requirement\":\"REQ-0197.01\",\"case\":\"success\",\"entryPoint\":\"live-unstuck\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"transition\",\"outcome\"]}")
	print("TRACEABILITY {\"requirement\":\"REQ-0198.01\",\"case\":\"success\",\"entryPoint\":\"live-unstuck\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"transition\",\"outcome\"]}")
	print("TRACEABILITY {\"requirement\":\"REQ-0201.01\",\"case\":\"success\",\"entryPoint\":\"live-unstuck\",\"observed\":[\"registration\",\"adapter\",\"validation\",\"mutation\",\"transition\",\"outcome\"]}")

@test function liveRecoveryTravelRebuildsHintsInDestinationCoordinates()
	let f = new LiveRecoveryFixture("africa", "songhai_kingdom")
	registerUnstuckCommand(f.commands, f.natives.service)
	let source = f.startup
	f.commands.dispatch(Player(0), "/unstuck").assertTrue()
	let oldSafe = f.natives.service.exportLastSafe("party:" + f.main)
	(oldSafe.startsWith("party:" + f.main + "|africa:")).assertTrue()
	let route = source.campaign.state.boundary("africa_to_middle_east_india")
	source.campaign.travel.transition(route, .37, "unstuck-travel").assertTrue()
	let destination = new StartupFixture(source.cache, source.saves, "middle_east_india")
	destination.register()
	let natives = new RecoveryNatives()
	destination.campaign.state.party = new WarcraftCampaignPartyProjection()
	destination.campaign.state.militarySettlements.adapter = new RecoveryMilitaryNatives()
	configureCampaignRecovery(destination.campaign.state, natives)
	destination.campaign.startup().assertTrue()
	let commands = new CommandRegistry(false, 8, new CommandText(), new RecordingManagementPorts())
	registerUnstuckCommand(commands, natives.service)
	commands.dispatch(Player(0), "/unstuck").assertTrue()
	natives.moves.assertEquals(1)
	natives.count.assertEquals(1)
	let hero = natives.service.entity("party:" + f.main)
	(hero.zoneId.startsWith("middle_east_india:")).assertTrue()
	(natives.service.exportLastSafe(hero.stableId) != oldSafe).assertTrue()
	(destination.campaign.state.partyNavigation.componentAt(hero.x, hero.y) > 0).assertTrue()
	destination.campaign.saves.save(SAVE_SLOT_MANUAL, 2, "destination").assertTrue()
	destination.campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertTrue()
	commands.dispatch(Player(0), "/unstuck all").assertTrue()
	natives.count.assertEquals(1)
	natives.moves.assertEquals(2)

/** Make a real v2 fixture: omit the main ID and the two v4 rank fields.
 * Merely relabelling a v4 snapshot would correctly fail schema validation. */
function legacyRecoveryRpg(string current) returns string
	var result = "v2"
	var start = 3
	while start < StringLength(current)
		var finish = current.indexOf("|", start)
		if finish < 0
			finish = StringLength(current)
		let record = SubString(current, start, finish)
		if record.startsWith("h,")
			var commas = 0
			var limit = StringLength(record)
			for i = 0 to StringLength(record) - 1
				if SubString(record, i, i + 1) == ","
					commas++
					if commas == 18
						limit = i
			result += "|" + SubString(record, 0, limit)
		else if not record.startsWith("p,")
			result += "|" + record
		start = finish + 1
	return result

@test function liveRecoveryMigratesLegacyHintsAndRejectsMalformedRecords()
	let f = new LiveRecoveryFixture("europe_west", "england")
	registerUnstuckCommand(f.commands, f.natives.service)
	let state = f.startup.campaign.state
	let military = state.militarySettlements
	f.recruit("migrating", MOVE_NAVAL, 'hdes')
	state.recovery.refresh()
	let current = military.snapshot()
	military.validateSnapshot(current + "|n,migrating,europe_west,1,1,1,2").assertFalse()
	military.validateSnapshot(current + "|n,missing,europe_west,1,1,1,2").assertFalse()
	let hint = current.indexOf("|n,migrating,")
	(hint > 0).assertTrue()
	let rest = SubString(current, hint + 1, StringLength(current))
	let next = rest.indexOf("|")
	let legacy = withoutMilitarySettlementPolicy("v3" + SubString(current, 2, hint) + SubString(rest, next, StringLength(rest)))
	military.restore(legacy).assertTrue()
	military.forces[military.forceIndex("migrating")].recoveryMap.assertEquals("")
	state.recovery.refresh()
	military.forces[military.forceIndex("migrating")].recoveryMap.assertEquals("europe_west")
	let rpg = state.rpg.captureState()
	state.rpg.restoreState(legacyRecoveryRpg(rpg)).assertTrue()
	state.rpg.heroes.mainCharacterId.assertEquals(f.main)
	state.rpg.restoreState(rpg + "|p," + f.main).assertFalse()
	f.commands.dispatch(Player(0), "/unstuck all").assertTrue()
	f.natives.count.assertEquals(2)
	// Abstract reassignment retires the local registry entry and must not save
	// coordinates from the old map under the destination's location authority.
	military.forces[military.forceIndex("migrating")].regionId = "middle_east_india"
	state.recovery.refresh()
	f.natives.count.assertEquals(1)
	let reassigned = military.snapshot()
	(reassigned.indexOf("|n,migrating,") < 0).assertTrue()
	military.validateSnapshot(reassigned).assertTrue()

/** Native event installation/timers are recorded; representation and recovery
 * ownership still use the production Warcraft adapters above. */
class HeroDeathRecoveryNatives extends WarcraftMilitaryCombatNatives
	override function install(MilitaryCombatEvents events, int generation)
		this.events = events
		this.generation = generation
	override function uninstall()
		skip
	override function armTimer(real seconds, int serial)
		skip
	override function stopTimer()
		skip
	override function timerElapsed() returns real
		return 0.
	function death(int representation)
		events.onDeath(generation, representation, 0)

@test function nativeHeroDefeatRetiresRecoveryRegistrationAndKeepsPhysicalAuthority()
	let f = new LiveRecoveryFixture("europe_west", "england")
	let campaign = f.startup.campaign
	let natives = new HeroDeathRecoveryNatives()
	let pauses = new ManagementScreenPauseController(new RecordingManagementPorts(), false)
	let events = installMilitaryCombatEvents(campaign, natives, pauses)
	(events != null).assertTrue()
	f.natives.count.assertEquals(1)
	let unitBefore = f.hero()
	let token = GetHandleId(unitBefore)
	let index = campaign.state.rpg.heroes.indexOf(f.main)
	let hero = campaign.state.rpg.heroes.heroes[index]
	let day = f.startup.clock.campaignDay()
	let savedPositions = campaign.state.committedLocations
	KillUnit(unitBefore)
	natives.death(token)
	hero.incapacitated.assertTrue()
	hero.recoveryDay.assertEquals(day + 30)
	f.natives.count.assertEquals(0)
	(f.hero() == null).assertTrue()
	campaign.state.committedLocations.assertEquals(savedPositions)
	natives.death(token)
	campaign.saves.save(SAVE_SLOT_MANUAL, 1, "native-wounded").assertTrue()
	campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	(f.hero() == null).assertTrue()
	f.natives.count.assertEquals(0)
	campaign.state.committedLocations.assertEquals(savedPositions)
	// Supported pre-coordinate saves retain the original wounded character,
	// including v2's missing main ID, without invoking a recruitment grant.
	let woundedAuthority = campaign.state.captureAuthoritativeState()
	let legacy = legacyRecoveryRpg(campaign.state.rpg.captureState())
	for schema = 6 to 8
		var rpgState = legacy
		if schema == 8
			rpgState = "v3|p," + f.main + SubString(legacy, 2, StringLength(legacy))
		let authority = replaceCampaignField(replaceCampaignField(woundedAuthority, "rpg", rpgState), "partyLocations", "legacy")
		let encoded = campaignSaveEnvelope(schema, "manual_03", SAVE_SLOT_MANUAL, 3, "legacy-wounded", authority)
		f.startup.saves.writeTransactional("manual_03", encoded).assertTrue()
		campaign.saves.load(SAVE_SLOT_MANUAL, 3).assertTrue()
		hero.incapacitated.assertTrue()
		hero.recoveryDay.assertEquals(day + 30)
		campaign.state.rpg.heroes.mainCharacterId.assertEquals(f.main)
		campaign.state.rpg.heroes.strategicRosterSize().assertEquals(1)
		f.natives.count.assertEquals(0)
		(f.hero() == null).assertTrue()
		f.startup.saves.read("manual_03").assertEquals(encoded)
	f.startup.clock.advanceElapsed(30. / f.startup.clock.daysPerSecond).assertTrue()
	hero.incapacitated.assertFalse()
	hero.assignment.assertEquals("reserve")
	(f.hero() == null).assertTrue()
	campaign.saves.save(SAVE_SLOT_MANUAL, 2, "native-recovered").assertTrue()
	campaign.saves.load(SAVE_SLOT_MANUAL, 2).assertTrue()
	(f.hero() == null).assertTrue()
	f.natives.count.assertEquals(0)
	campaign.state.committedLocations.assertEquals(savedPositions)
	events.stop()
