@test function civicCatalogueLookupAndStagedForkPreserveExactDistrictIdentities()
	let ledger = new CivicLedger()
	for i = 0 to 1021
		ledger.register(new CivicDistrict("district_" + I2S(i), "province", 100, true, 0, 0, 0, 0, 0, "cloth", 1, 100), 12)
	// Warcraft hashes may fold case; district identities must remain exact.
	ledger.register(new CivicDistrict("district", "province", 100, true, 0, 0, 0, 0, 0, "cloth", 1, 100), 12)
	ledger.register(new CivicDistrict("DISTRICT", "province", 200, true, 0, 0, 0, 0, 0, "cloth", 1, 100), 12)
	ledger.register(ledger.districts[0], 99)
	ledger.count.assertEquals(1024)
	ledger.index("missing").assertEquals(-1)
	ledger.index("district").assertEquals(1022)
	ledger.index("DISTRICT").assertEquals(1023)
	let staged = ledger.fork()
	for i = 0 to ledger.count - 1
		ledger.index(ledger.districts[i].id).assertEquals(i)
		staged.index(ledger.districts[i].id).assertEquals(i)
		ledger.states[i].lastDay.assertEquals(12)
		staged.states[i].lastDay.assertEquals(0)
	staged.states[0].discussion = 50
	ledger.states[0].discussion.assertEquals(0)
	destroy ledger
	staged.index("district").assertEquals(1022)
	staged.index("DISTRICT").assertEquals(1023)
	destroy staged

class CivicTestResources implements ResearchCommandResources, CommandOutput
	string owner = "player"
	int balance = 100000
	string output = ""
	override function controllerId(player sender) returns string
		return owner
	override function year() returns int
		return 1778
	override function gold(player sender) returns int
		return balance
	override function setGold(player sender, int amount)
		balance = amount
	override function show(player recipient, string message)
		output = message

class CivicFixture
	int day = 649041 // Arbitrary committed day; fixture discussion/outbreak are explicit.
	CivicTestResources resources = new CivicTestResources()
	CivicResearchEffects research = new CivicResearchEffects(new UnboundResearchEffects())
	WarcraftRpgRuntime rpg = new WarcraftRpgRuntime(research)
	MilitarySettlementRuntime military = new MilitarySettlementRuntime(new RecordingMilitaryAdapter())
	CampaignClock clock = new CampaignClock(529237, 700000, day, 1.)
	PlayableCampaignState campaign = new PlayableCampaignState(null, clock)
	PlayableTradeRuntime trade = new PlayableTradeRuntime()
	CivicCampaignRuntime runtime
	CommandRegistry commands = new CommandRegistry(false, 8, new CommandText(), resources)
	string initial
	construct()
		let generated = new WarcraftRpgRuntime(research)
		configureGeneratedRpg(generated)
		rpg.technologies = generated.technologies
		rpg.researchResources = resources
		rpg.management.pauses = new ManagementScreenPauseController(new RecordingManagementPorts(), false)
		let definitions = new CivicLedger()
		configureGeneratedCivic(definitions, research, day)
		military.civic.transitionDays = definitions.transitionDays
		military.civic.enactmentBasisPoints = definitions.enactmentBasisPoints
		military.civic.upkeepBasisPoints = definitions.upkeepBasisPoints
		military.civic.surveyBasisPoints = definitions.surveyBasisPoints
		military.civic.responseBasisPoints = definitions.responseBasisPoints
		military.civic.responseDays = definitions.responseDays
		military.civic.cooldownDays = definitions.cooldownDays
		military.civic.tradePenaltyBasisPoints = definitions.tradePenaltyBasisPoints
		military.civic.baseTaxBasisPoints = definitions.baseTaxBasisPoints
		military.civic.municipalNode = definitions.municipalNode
		military.civic.municipalMinimumUrbanization = definitions.municipalMinimumUrbanization
		destroy definitions
		military.civic.register(new CivicDistrict("district", "province", 10001, true, day, 20, day, 365, 4, "cloth", 4, 1000), day)
		military.civic.configureAdministration("district", 20)
		military.registerSettlement(new SettlementRuntimeState("district", "player", "europe", 'htow', 'hfoo', 30, 20, 10000, 50, 0., 0.))
		military.appoint("district", new AdministratorState("clerk", "Clerk", "Administrator", "player", "europe", "district", 50, 50, 40, 1))
		campaign.setMilitarySettlementRuntime(military)
		campaign.setRpgRuntime(rpg)
		campaign.setCountryRuntime(new PlayableCountryInteractionRuntime(null))
		campaign.countries.registerPolity("player", 10000)
		campaign.countries.registerPolity("ai", 10000)
		trade.registerMarket(new RuntimeMarket("district", "cloth", 1000, 100000, 10, 10))
		trade.registerMarket(new RuntimeMarket("district", "grain", 1000, 100000, 10, 10))
		trade.civic = military
		trade.civicClock = clock
		runtime = new CivicCampaignRuntime(campaign, trade, research)
		campaign.civicRuntime = runtime
		registerRpgRuntimeCommands(commands, rpg).assertEquals("")
		registerCivicCommands(commands, runtime).assertEquals("")
		initial = rpg.captureState()
	function prerequisites()
		rpg.restoreState(initial + "|u," + resources.owner + ",professional_bureaucracy|u," + resources.owner + ",experimental_method|u," + resources.owner + ",urban_public_health").assertTrue()
		rpg.reconcile(resources.owner)
	function unlock(string id)
		commands.dispatch(Player(0), "/research " + id).assertTrue()
		resources.output.assertEquals("Action completed.")
	function action(string action)
		commands.dispatch(Player(0), "/civic " + action + " district").assertTrue()
		resources.output.startsWith("Civic action completed.").assertTrue()
	function advance(int amount)
		clock.advanceTo(day + amount).assertTrue()
	function allResearch()
		prerequisites()
		unlock("abolitionist_public_sphere")
		unlock("anatomy_and_medicine")
		unlock("cadastral_survey")
	function examinationsPrerequisites()
		// Matched controls retain exactly the same earned prerequisites, with
		// Archives absent so its independent collection source cannot confound.
		rpg.restoreState(initial + "|u," + resources.owner + ",provincial_audits|u," + resources.owner + ",fleet_victualling").assertTrue()
		rpg.reconcile(resources.owner)
		military.civic.districts[0].annualTax = 10000
	function examinations()
		examinationsPrerequisites()
		unlock("civil_service_examinations")

@test function civicRegisteredResearchAndActionsChargeOnlyTheExactAuthoritativeBills()
	let f = new CivicFixture()
	for i = 0 to 2
		var id = "abolitionist_public_sphere"
		if i == 1
			id = "anatomy_and_medicine"
		else if i == 2
			id = "cadastral_survey"
		f.commands.dispatch(Player(0), "/research " + id).assertTrue()
		f.resources.output.assertEquals("Requirements are not met here.")
	f.resources.balance.assertEquals(100000)
	f.campaign.countries.treasury[0].assertEquals(10000)
	f.allResearch()
	f.resources.balance.assertEquals(100000 - 340 - 235 - 130)
	f.commands.dispatch(Player(0), "/research cadastral_survey").assertTrue()
	f.resources.output.assertEquals("Requirements are not met here.")
	f.action("policy")
	f.campaign.countries.treasury[0].assertEquals(9899)
	f.action("survey")
	f.campaign.countries.treasury[0].assertEquals(9798)
	f.action("response")
	f.campaign.countries.treasury[0].assertEquals(9597)
	f.trade.findMarket("district", "cloth").stock.assertEquals(996)
	f.military.civic.states[0].discussion.assertEquals(0)
	f.military.civic.states[0].surveyed.assertFalse()
	let before = f.military.snapshot()
	f.commands.dispatch(Player(0), "/civic policy district").assertTrue()
	f.resources.output.contains("cannot stack").assertTrue()
	f.military.snapshot().assertEquals(before)
	f.advance(89)
	f.military.civic.states[0].surveyed.assertFalse()
	f.military.civic.states[0].discussion.assertEquals(1780)
	f.military.settlements[0].manpower.assertEquals(10000 - 89 * 3)
	f.advance(90)
	f.military.civic.states[0].surveyed.assertTrue()
	f.military.civic.states[0].discussion.assertEquals(1800)
	f.campaign.countries.treasury[0].assertEquals(9546) // ceil(10001 * 0.005)
	f.military.settlements[0].manpower.assertEquals(10000 - 90 * 3)
	f.military.civic.states[0].diseaseAvoided.assertEquals(90)
	f.commands.dispatch(Player(0), "/technology").assertTrue()
	f.resources.output.contains("+2500 bp epidemic_losses_avoided").assertTrue()
	f.resources.output.contains("+500 bp civic_reform_diffusion").assertTrue()

@test function civicActionsRejectOccupationMissingInstitutionsSuppliesAndCooldownAtomically()
	let f = new CivicFixture()
	f.commands.dispatch(Player(0), "/civic survey district").assertTrue()
	f.resources.output.contains("Requires earned survey").assertTrue()
	f.allResearch()
	let before = f.military.snapshot()
	f.campaign.countries.treasury[0] = 100
	f.commands.dispatch(Player(0), "/civic policy district").assertTrue()
	f.resources.output.contains("insufficient").assertTrue()
	f.military.snapshot().assertEquals(before)
	f.campaign.countries.treasury[0] = 10000
	let cloth = f.trade.findMarket("district", "cloth")
	cloth.stock = 3
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("insufficient").assertTrue()
	f.military.snapshot().assertEquals(before)
	cloth.stock = 1000
	cloth.blockaded = true
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("insufficient").assertTrue()
	cloth.blockaded = false
	f.military.settlements[0].legalOwnerId = "foreign"
	f.commands.dispatch(Player(0), "/civic survey district").assertTrue()
	f.resources.output.contains("lawfully controlled").assertTrue()
	f.military.settlements[0].legalOwnerId = "player"
	f.military.administrators[0].controllerId = "foreign"
	f.commands.dispatch(Player(0), "/civic policy district").assertTrue()
	f.resources.output.contains("lawfully controlled").assertTrue()
	f.military.administrators[0].controllerId = "player"
	f.action("response")
	f.advance(179)
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("expired cooldown").assertTrue()
	f.advance(180)
	f.action("response")
	f.advance(365)
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("active outbreak").assertTrue()

@test function civicFixedPointSourcesDeduplicateAndTaxesTransferOnlyExistingEconomicCapacity()
	let f = new CivicFixture()
	f.allResearch()
	let peer = new RuntimeTechnology("peer", "Peer source", 1450, 1)
	peer.addUnlock("peer", "modifier", "progression_cadastral_survey")
	f.rpg.technologies.register(peer).assertTrue()
	f.unlock("peer")
	f.research.rate("player", "land_tax_collection_efficiency").assertEquals(500)
	f.research.register(new CivicEffect("modifier", "progression_cadastral_survey", "land_tax_collection_efficiency", 500))
	f.research.rate("player", "land_tax_collection_efficiency").assertEquals(500)
	f.research.register(new CivicEffect("modifier", "additional_survey", "land_tax_collection_efficiency", 250))
	let second = new RuntimeTechnology("second", "Distinct source", 1450, 1)
	second.addUnlock("second", "modifier", "additional_survey")
	f.rpg.technologies.register(second).assertTrue()
	f.unlock("second")
	f.research.rate("player", "land_tax_collection_efficiency").assertEquals(750)
	f.research.rate("ai", "land_tax_collection_efficiency").assertEquals(0)
	f.action("survey")
	f.advance(90)
	let untilTax = 365 - ((f.day + 90) mod 365)
	f.trade.findMarket("district", "cloth").money = 1
	f.trade.findMarket("district", "grain").money = 1
	let treasury = f.campaign.countries.treasury[0]
	f.advance(90 + untilTax)
	f.campaign.countries.treasury[0].assertEquals(treasury + 2)
	f.military.civic.states[0].taxesCollected.assertEquals(2)
	civicScale(2147483647, 500).assertEquals(107374182)
	civicBill(2147483647, 100).assertEquals(21474837)
	// Medicine never avoids more people than are actually exposed.
	f.military.settlements[0].manpower = 1
	f.military.civic.districts[0].outbreakFirstDay = f.clock.currentDay
	f.action("response")
	let lost = f.military.civic.states[0].diseaseLost
	f.advance(91 + untilTax)
	f.military.civic.states[0].diseaseLost.assertEquals(lost + 1)

@test function civicSaveMigrationCaptureAndFailedRestorePreserveLocalAuthorityWithoutReplay()
	let f = new CivicFixture()
	f.allResearch()
	f.action("policy")
	f.action("survey")
	f.action("response")
	f.advance(90)
	let saved = f.military.snapshot()
	let rpg = f.rpg.captureState()
	let treasury = f.campaign.countries.treasury[0]
	for repeat = 1 to 3
		f.military.restore(saved, false).assertTrue()
		f.rpg.restoreState(rpg).assertTrue()
		f.rpg.reconcile("player")
		f.research.rate("player", "land_tax_collection_efficiency").assertEquals(500)
		f.military.snapshot().assertEquals(saved)
		f.campaign.countries.treasury[0].assertEquals(treasury)
	f.military.restore(saved + "|g,district,", false).assertFalse()
	f.military.snapshot().assertEquals(saved)
	// Capture preserves a completed survey and cancels opt-in government actions.
	f.military.transferSettlement("district", "ai")
	f.military.civic.states[0].surveyed.assertTrue()
	f.military.civic.states[0].policyOwner.assertEquals("")
	f.research.rate("ai", "land_tax_collection_efficiency").assertEquals(0)
	f.military.transferSettlement("district", "player")
	f.military.civic.states[0].policyOwner.assertEquals("")
	// v1-v10 contain no civic ledger; migration never grants completed projects.
	let cut = saved.indexOf("|u,")
	let legacy = "v10" + SubString(saved, saved.indexOf("|"), cut)
	f.military.restore(legacy, false).assertTrue()
	f.military.civic.states[0].surveyed.assertFalse()
	f.military.civic.states[0].policyOwner.assertEquals("")
	f.military.civic.states[0].lastDay.assertEquals(0)
	f.runtime.advance(f.clock.currentDay)
	f.campaign.countries.treasury[0].assertEquals(treasury)

@test function civicQuarantineBudgetCannotBeBypassedBySplitTransactionsAndSurvivesReload()
	let f = new CivicFixture()
	f.allResearch()
	f.action("response")
	let hold = new TradeStore("hold", 10000, 10000000)
	let controller = f.trade.tradeController()
	let cloth = f.trade.findMarket("district", "cloth")
	let grain = f.trade.findMarket("district", "grain")
	controller.buy("first", cloth, hold, 500).startsWith("Bought").assertTrue()
	controller.buy("second", grain, hold, 400).startsWith("Bought").assertTrue()
	let saved = f.military.snapshot()
	controller.buy("third", grain, hold, 1).contains("quarantine").assertTrue()
	controller.sell("split-sale", cloth, hold, 1, 1000).contains("quarantine").assertTrue()
	f.military.restore(saved, false).assertTrue()
	controller.buy("fourth", grain, hold, 1).contains("quarantine").assertTrue()
	f.advance(1)
	controller.buy("fifth", grain, hold, 1).startsWith("Bought").assertTrue()
	f.military.civic.states[0].tradedUnits.assertEquals(1)

@test function civicPlayerAndAiUseIdenticalActionsAndActiveAbstractReplayArithmetic()
	let human = new CivicFixture()
	human.allResearch()
	let ai = new CivicFixture()
	ai.resources.owner = "ai"
	ai.military.transferSettlement("district", "ai")
	ai.military.settlements[0].legalOwnerId = "ai"
	ai.allResearch()
	human.action("policy")
	human.action("survey")
	human.action("response")
	ai.runtime.act("ai", "policy", "district").assertEquals("")
	ai.runtime.act("ai", "survey", "district").assertEquals("")
	ai.runtime.act("ai", "response", "district").assertEquals("")
	human.military.activeRegionId = "europe"
	ai.military.activeRegionId = "unloaded"
	for elapsed = 1 to 100
		human.advance(elapsed)
	ai.advance(100)
	human.military.civic.states[0].discussion.assertEquals(ai.military.civic.states[0].discussion)
	human.military.civic.states[0].diseaseLost.assertEquals(ai.military.civic.states[0].diseaseLost)
	human.campaign.countries.treasury[0].assertEquals(ai.campaign.countries.treasury[1])
	human.trade.findMarket("district", "cloth").stock.assertEquals(ai.trade.findMarket("district", "cloth").stock)

@test function civicSurveyUsesExactRelativeCollectionAndPolicyNeedsActualLocalDiscussion()
	let base = new CivicFixture()
	base.allResearch()
	let surveyed = new CivicFixture()
	surveyed.allResearch()
	surveyed.action("survey")
	let taxDay = 365 - (base.day mod 365)
	base.advance(taxDay)
	surveyed.advance(taxDay)
	base.military.civic.states[0].taxesCollected.assertEquals(9000)
	surveyed.military.civic.states[0].taxesCollected.assertEquals(9450)
	let f = new CivicFixture()
	f.allResearch()
	f.military.civic.districts[0].civicCenter = false
	f.commands.dispatch(Player(0), "/civic policy district").assertTrue()
	f.resources.output.contains("reform discussion").assertTrue()
	f.military.civic.districts[0].civicCenter = true
	f.military.civic.districts[0].discussionFirstDay = f.day + 1
	f.commands.dispatch(Player(0), "/civic policy district").assertTrue()
	f.resources.output.contains("reform discussion").assertTrue()
	f.military.civic.districts[0].outbreakFirstDay = f.day + 1
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("active outbreak").assertTrue()
	f.campaign.countries.treasury[0].assertEquals(10000)
	f.military.civic.states[0].discussion.assertEquals(0)
	f.military.civic.states[0].diseaseAvoided.assertEquals(0)

@test function combinedCivicAndVoyageDayReplayAndSnapshotMigrationPreserveBothDomains()
	let f = new CivicFixture()
	f.allResearch()
	f.action("survey")
	f.action("response")
	f.military.voyages = createGeneratedVoyageContract()
	f.military.setRpgRuntime(f.rpg)
	let ship = new RuntimeForce("english_patrol_ship", "player", "europe_west", "sailing_naval", FORCE_FLEET, 'hbot', 1, 70, 4160., -6720.)
	f.military.registerForce(ship)
	f.military.setNavigationEquipment(ship.id, "player", true, f.day).assertTrue()
	f.military.startVoyage(ship.id, "channel_position_finding_circuit", "player", f.day, true).assertTrue()
	f.advance(3)
	ship.navigation.elapsedDays.assertEquals(3)
	f.military.civic.states[0].diseaseAvoided.assertEquals(3)
	let saved = f.military.snapshot()
	saved.startsWith("v20|").assertTrue()
	f.military.restore(saved, false).assertTrue()
	f.military.snapshot().assertEquals(saved)
	let cut = saved.indexOf("|u,")
	// Truncated current saves cannot silently discard paid civic projects.
	f.military.restore(SubString(saved, 0, cut), false).assertFalse()
	f.military.snapshot().assertEquals(saved)
	// Main's v10 voyage saves migrate with their paid kit/reservation intact.
	let legacy = "v10" + SubString(saved, saved.indexOf("|"), cut)
	f.military.restore(legacy, false).assertTrue()
	let restored = f.military.forces[f.military.forceIndex("english_patrol_ship")]
	restored.navigation.equipment.assertTrue()
	restored.navigation.elapsedDays.assertEquals(3)
	restored.navigation.reserved.assertEquals(35)
	f.military.civic.states[0].surveyed.assertFalse()
	f.military.civic.states[0].responseOwner.assertEquals("")
	f.military.restore(saved, false).assertTrue()
	f.advance(10)
	f.military.forces[f.military.forceIndex("english_patrol_ship")].navigation.pending().assertFalse()
	f.military.civic.states[0].diseaseAvoided.assertEquals(10)

// Archives must earn a real economic result before any municipal enactment.
@test function administrativeRegisteredArchivesThenAdoptionAndMunicipalPolicyProduceConservedTaxDifferences()
	let base = new CivicFixture()
	let archives = new CivicFixture()
	let municipal = new CivicFixture()
	archives.unlock("professional_bureaucracy")
	archives.unlock("chancery_archives")
	municipal.unlock("professional_bureaucracy")
	municipal.unlock("chancery_archives")
	municipal.unlock("chartered_municipalities")
	municipal.military.civic.states[0].municipalOwner.assertEquals("")
	let control = municipal.military.settlements[0].controllerId
	let legal = municipal.military.settlements[0].legalOwnerId
	let loyalty = municipal.military.administrators[0].loyalty
	municipal.action("municipal")
	municipal.military.civic.states[0].municipalReady.assertEquals(municipal.day + 90)
	let taxDay = 365 - (base.day mod 365)
	base.advance(taxDay)
	archives.advance(taxDay)
	municipal.advance(taxDay)
	base.military.civic.states[0].taxesCollected.assertEquals(9000)
	archives.military.civic.states[0].taxesCollected.assertEquals(9225)
	municipal.military.civic.states[0].taxesCollected.assertEquals(9585)
	archives.campaign.countries.treasury[0].assertEquals(10000 - 26 + 9225)
	municipal.campaign.countries.treasury[0].assertEquals(10000 - 101 - 51 - 26 + 9585)
	municipal.trade.findMarket("district", "cloth").money.assertEquals(100000 - 9585)
	municipal.military.administrators[0].loyalty.assertEquals(loyalty)
	municipal.military.settlements[0].controllerId.assertEquals(control)
	municipal.military.settlements[0].legalOwnerId.assertEquals(legal)
	let before = municipal.military.snapshot()
	let money = municipal.campaign.countries.treasury[0]
	municipal.commands.dispatch(Player(0), "/civic municipal district").assertTrue()
	municipal.resources.output.contains("cannot stack").assertTrue()
	municipal.military.snapshot().assertEquals(before)
	municipal.campaign.countries.treasury[0].assertEquals(money)
	municipal.rpg.reconcile("player")
	municipal.research.rate("player", "archive_tax_collection_efficiency").assertEquals(500)
	municipal.advance(taxDay)
	municipal.military.snapshot().assertEquals(before)

@test function administrativePrerequisitesUrbanizationResourcesAndForeignJurisdictionRejectWithoutMutation()
	let f = new CivicFixture()
	let initial = f.military.snapshot()
	let rpg = f.rpg.captureState()
	f.commands.dispatch(Player(0), "/research chartered_municipalities").assertTrue()
	f.rpg.captureState().assertEquals(rpg)
	f.resources.balance.assertEquals(100000)
	f.commands.dispatch(Player(0), "/civic municipal district").assertTrue()
	f.military.snapshot().assertEquals(initial)
	f.unlock("professional_bureaucracy")
	f.unlock("chancery_archives")
	f.military.civic.states[0].urbanization = 10
	let research = f.rpg.captureState()
	let balance = f.resources.balance
	f.commands.dispatch(Player(0), "/research chartered_municipalities").assertTrue()
	f.rpg.captureState().assertEquals(research)
	f.resources.balance.assertEquals(balance)
	f.military.civic.states[0].urbanization = 11
	f.resources.balance = 0
	f.commands.dispatch(Player(0), "/research chartered_municipalities").assertTrue()
	f.rpg.captureState().assertEquals(research)
	f.resources.balance = balance
	f.military.administrators[0].jurisdiction = "foreign"
	f.commands.dispatch(Player(0), "/research chartered_municipalities").assertTrue()
	f.rpg.captureState().assertEquals(research)
	f.military.administrators[0].jurisdiction = "district"
	f.unlock("chartered_municipalities")
	f.campaign.countries.treasury[0] = 100
	let before = f.military.snapshot()
	f.commands.dispatch(Player(0), "/civic municipal district").assertTrue()
	f.military.snapshot().assertEquals(before)
	f.campaign.countries.treasury[0].assertEquals(100)
	f.campaign.countries.treasury[0] = 10000
	f.runtime.act("ai", "municipal", "district").contains("lawfully controlled").assertTrue()
	f.military.snapshot().assertEquals(before)
	f.military.civic.states[0].urbanization = 10
	let low = f.military.snapshot()
	f.commands.dispatch(Player(0), "/civic municipal district").assertTrue()
	f.military.snapshot().assertEquals(low)

@test function administrativeOfficeReplacementOperatingConditionsAndSurveySourcesCompose()
	let f = new CivicFixture()
	f.unlock("professional_bureaucracy")
	f.unlock("chancery_archives")
	f.unlock("chartered_municipalities")
	f.action("municipal")
	// Existing #512 survey is an independent named contribution.
	f.unlock("cadastral_survey")
	f.action("survey")
	f.military.appoint("district", new AdministratorState("expert", "Expert", "Administrator", "player", "absent_region", "district", 50, 100, 40, 1)).assertEquals("Administrator appointed.")
	let taxDay = 365 - (f.day mod 365)
	f.advance(taxDay)
	f.military.civic.states[0].taxesCollected.assertEquals(10001) // capped taxable capacity
	// A replacement's current skill changes the next result; no permanent bonus.
	f.military.appoint("district", new AdministratorState("novice", "Novice", "Administrator", "player", "europe", "district", 50, 10, 40, 1)).assertEquals("Administrator appointed.")
	f.advance(taxDay + 365)
	f.military.civic.states[0].taxesCollected.assertEquals(10001 + 9450)
	f.military.administrators[0].administration = 100
	f.military.administrators[0].jurisdiction = "foreign"
	f.advance(taxDay + 730)
	f.military.civic.states[0].taxesCollected.assertEquals(10001 + 9450)
	f.military.settlements[0].underAttack = true
	f.advance(taxDay + 1095)
	f.military.civic.states[0].taxesCollected.assertEquals(10001 + 9450)

@test function administrativeActiveAbstractParityCaptureMigrationAndFailedLoadRollback()
	let active = new CivicFixture()
	let inactive = new CivicFixture()
	active.unlock("professional_bureaucracy")
	active.unlock("chancery_archives")
	active.unlock("chartered_municipalities")
	inactive.unlock("professional_bureaucracy")
	inactive.unlock("chancery_archives")
	inactive.unlock("chartered_municipalities")
	active.action("municipal")
	inactive.action("municipal")
	active.military.activeRegionId = "europe"
	inactive.military.activeRegionId = "unloaded"
	// Lost Warcraft representations do not own project or treasury state.
	inactive.military.settlements[0].projectMilitary = false
	let taxDay = 365 - (active.day mod 365)
	for elapsed = 1 to taxDay
		active.advance(elapsed)
	inactive.advance(taxDay)
	active.military.civic.states[0].taxesCollected.assertEquals(inactive.military.civic.states[0].taxesCollected)
	active.campaign.countries.treasury[0].assertEquals(inactive.campaign.countries.treasury[0])
	let saved = active.military.snapshot()
	let money = active.campaign.countries.treasury[0]
	active.military.restore(saved, false).assertTrue()
	active.military.snapshot().assertEquals(saved)
	active.campaign.countries.treasury[0].assertEquals(money)
	let record = "|u,district,player," + I2S(active.day + 90) + "," + I2S(active.day + 90 + 365) + ",20"
	active.military.restore(saved.replace(record, ""), false).assertFalse()
	active.military.restore(saved + record, false).assertFalse()
	active.military.restore(saved.replace(record, "|u,district,foreign,1,1,20"), false).assertFalse()
	active.military.snapshot().assertEquals(saved)
	let legacy = saved.replace("v20|", "v17|").replace(record, "")
	active.military.restore(legacy, false).assertTrue()
	active.military.civic.states[0].municipalOwner.assertEquals("")
	active.military.civic.states[0].urbanization.assertEquals(20)
	active.military.civic.states[0].taxesCollected.assertEquals(9585)
	active.campaign.countries.treasury[0].assertEquals(money)
	active.military.restore(saved, false).assertTrue()
	active.military.transferSettlement("district", "ai")
	active.military.civic.states[0].municipalOwner.assertEquals("")
	active.research.rate("ai", "archive_tax_collection_efficiency").assertEquals(0)
	active.military.transferSettlement("district", "player")
	active.military.civic.states[0].municipalOwner.assertEquals("")

@test function administrativeUpkeepLossDuplicatesAndReenactmentNeverCreatePermanentBenefits()
	let f = new CivicFixture()
	f.unlock("professional_bureaucracy")
	f.unlock("chancery_archives")
	f.unlock("chartered_municipalities")
	let loyalty = f.military.administrators[0].loyalty
	// A second provenance for the same identity still contributes once.
	let duplicate = new RuntimeTechnology("archive_peer", "Archive peer", 1450, 1)
	duplicate.addUnlock("archive_peer", "modifier", "progression_chancery_archives")
	f.rpg.technologies.register(duplicate).assertTrue()
	f.unlock("archive_peer")
	f.research.rate("player", "archive_tax_collection_efficiency").assertEquals(500)
	for repeat = 1 to 3
		f.action("municipal")
		f.action("municipal-repeal")
	f.campaign.countries.treasury[0].assertEquals(10000 - 303)
	f.military.administrators[0].loyalty.assertEquals(loyalty)
	f.military.civic.states[0].taxesCollected.assertEquals(0)
	f.action("municipal")
	f.campaign.countries.treasury[0] = 0
	let taxDay = 365 - (f.day mod 365)
	f.advance(taxDay)
	// No funded charter or archives: only ordinary collection is possible.
	f.military.civic.states[0].taxesCollected.assertEquals(9000)
	f.campaign.countries.treasury[0].assertEquals(9000)
	f.military.civic.states[0].municipalThrough.assertEquals(f.day + 90)
	f.military.civic.states[0].urbanization = 10
	f.advance(taxDay + 365)
	// Archives can resume after funding; municipality still fails current eligibility.
	f.military.civic.states[0].taxesCollected.assertEquals(9000 + 9225)

// #567: isolate paid survey collection from archives, municipal policy and
// sibling civic effects. Research without the local action is a control.
@test function civicSurveyMatchedControlProvesPaidCompletionAndConservedAnnualCollection()
	let base = new CivicFixture()
	let optional = new CivicFixture()
	let surveyed = new CivicFixture()
	base.military.civic.districts[0].annualTax = 10000
	optional.military.civic.districts[0].annualTax = 10000
	surveyed.military.civic.districts[0].annualTax = 10000
	optional.prerequisites()
	surveyed.prerequisites()
	optional.unlock("cadastral_survey")
	surveyed.unlock("cadastral_survey")
	surveyed.research.rate("player", "land_tax_collection_efficiency").assertEquals(500)
	surveyed.action("survey")
	surveyed.campaign.countries.treasury[0].assertEquals(9900)
	surveyed.military.civic.states[0].surveyReady.assertEquals(surveyed.day + 90)
	surveyed.advance(89)
	surveyed.military.civic.states[0].surveyed.assertFalse()
	surveyed.military.civic.states[0].taxesCollected.assertEquals(0)
	surveyed.advance(90)
	surveyed.military.civic.states[0].surveyed.assertTrue()
	surveyed.campaign.countries.treasury[0].assertEquals(9900)
	let taxDay = 365 - (base.day mod 365)
	base.advance(taxDay)
	optional.advance(taxDay)
	surveyed.advance(taxDay)
	base.military.civic.states[0].taxesCollected.assertEquals(9000)
	optional.military.civic.states[0].taxesCollected.assertEquals(9000)
	optional.military.civic.states[0].surveyed.assertFalse()
	surveyed.military.civic.states[0].taxesCollected.assertEquals(9450)
	base.campaign.countries.treasury[0].assertEquals(19000)
	optional.campaign.countries.treasury[0].assertEquals(19000)
	surveyed.campaign.countries.treasury[0].assertEquals(19350)
	base.trade.findMarket("district", "cloth").money.assertEquals(91000)
	surveyed.trade.findMarket("district", "cloth").money.assertEquals(90550)
	surveyed.trade.findMarket("district", "grain").money.assertEquals(100000)
	let saved = surveyed.military.snapshot()
	surveyed.advance(taxDay)
	surveyed.military.snapshot().assertEquals(saved)
	surveyed.campaign.countries.treasury[0].assertEquals(19350)
	surveyed.trade.findMarket("district", "cloth").money.assertEquals(90550)

// Research alone remains optional. Compare actual local meters and persisted
// government bills at the transition, first operating day and annual renewal.
@test function civicPolicyMatchedControlProvesOptionalTransitionFundedDiffusionAndRenewal()
	let base = new CivicFixture()
	let optional = new CivicFixture()
	let funded = new CivicFixture()
	let unpaid = new CivicFixture()
	let renewal = new CivicFixture()
	optional.allResearch()
	funded.allResearch()
	unpaid.allResearch()
	renewal.allResearch()
	funded.action("policy")
	unpaid.action("policy")
	renewal.action("policy")
	funded.military.civic.states[0].policyReady.assertEquals(funded.day + 90)
	funded.campaign.countries.treasury[0].assertEquals(9899)
	unpaid.campaign.countries.treasury[0] = 50 // one short of first upkeep
	// Remove tax liquidity so renewal is funded only by the stated treasury.
	for i = 0 to 1
		funded.trade.markets[i].money = 0
		unpaid.trade.markets[i].money = 0
		renewal.trade.markets[i].money = 0
	base.advance(89)
	optional.advance(89)
	funded.advance(89)
	unpaid.advance(89)
	renewal.advance(89)
	funded.military.civic.states[0].discussion.assertEquals(1780)
	funded.campaign.countries.treasury[0].assertEquals(9899)
	funded.advance(90)
	funded.military.civic.states[0].discussion.assertEquals(1800)
	funded.campaign.countries.treasury[0].assertEquals(9848)
	funded.advance(100)
	base.advance(100)
	optional.advance(100)
	unpaid.advance(100)
	renewal.advance(100)
	base.military.civic.states[0].discussion.assertEquals(2000)
	optional.military.civic.states[0].discussion.assertEquals(2000)
	optional.military.civic.states[0].policyOwner.assertEquals("")
	funded.military.civic.states[0].discussion.assertEquals(2010) // 20 * 1.05 per day, after transition
	unpaid.military.civic.states[0].discussion.assertEquals(2000)
	unpaid.military.civic.states[0].policyOwner.assertEquals("")
	unpaid.campaign.countries.treasury[0].assertEquals(50)
	let saved = funded.military.snapshot()
	for repeat = 1 to 3
		funded.military.restore(saved, false).assertTrue()
		funded.advance(100)
		funded.military.snapshot().assertEquals(saved)
		funded.campaign.countries.treasury[0].assertEquals(9848)
	renewal.campaign.countries.treasury[0] = 50
	funded.advance(455)
	renewal.advance(455)
	funded.military.civic.states[0].discussion.assertEquals(9465)
	funded.campaign.countries.treasury[0].assertEquals(9797)
	renewal.military.civic.states[0].discussion.assertEquals(9464)
	renewal.military.civic.states[0].policyOwner.assertEquals("")
	renewal.campaign.countries.treasury[0].assertEquals(50)
	// Repeal is explicit and cannot refund a paid bill or retain its benefit.
	funded.action("repeal")
	funded.advance(456)
	funded.military.civic.states[0].discussion.assertEquals(9485)
	funded.campaign.countries.treasury[0].assertEquals(9797)

@test function civicResponseMatchedControlProvesActualLossesBillsThroughputAndCooldown()
	let base = new CivicFixture()
	let treated = new CivicFixture()
	base.allResearch()
	treated.allResearch()
	treated.action("response")
	treated.campaign.countries.treasury[0].assertEquals(9799)
	treated.trade.findMarket("district", "cloth").stock.assertEquals(996)
	base.campaign.countries.treasury[0].assertEquals(10000)
	base.trade.findMarket("district", "cloth").stock.assertEquals(1000)
	let hold = new TradeStore("treated", 10000, 10000000)
	let controlHold = new TradeStore("control", 10000, 10000000)
	let controller = treated.trade.tradeController()
	let control = base.trade.tradeController()
	controller.buy("cloth", treated.trade.findMarket("district", "cloth"), hold, 500).startsWith("Bought").assertTrue()
	controller.buy("grain", treated.trade.findMarket("district", "grain"), hold, 400).startsWith("Bought").assertTrue()
	control.buy("cloth", base.trade.findMarket("district", "cloth"), controlHold, 500).startsWith("Bought").assertTrue()
	control.buy("grain", base.trade.findMarket("district", "grain"), controlHold, 500).startsWith("Bought").assertTrue()
	let before = treated.military.snapshot()
	controller.buy("overflow", treated.trade.findMarket("district", "grain"), controlHold, 1).contains("quarantine").assertTrue()
	treated.military.snapshot().assertEquals(before)
	treated.trade.registerMarket(new RuntimeMarket("district", "spice", 1000, 100000, 10, 10))
	treated.advance(89)
	base.advance(89)
	treated.military.settlements[0].manpower.assertEquals(9733)
	base.military.settlements[0].manpower.assertEquals(9644)
	controller.buy("still-active", treated.trade.findMarket("district", "spice"), hold, 901).contains("quarantine").assertTrue()
	treated.advance(90)
	base.advance(90)
	treated.military.settlements[0].manpower.assertEquals(9730)
	base.military.settlements[0].manpower.assertEquals(9640)
	treated.military.civic.states[0].diseaseLost.assertEquals(270)
	treated.military.civic.states[0].diseaseAvoided.assertEquals(90)
	base.military.civic.states[0].diseaseLost.assertEquals(360)
	base.military.civic.states[0].diseaseAvoided.assertEquals(0)
	// Throughput resumes at day 90, after exactly 90 loss intervals.
	controller.buy("expired", treated.trade.findMarket("district", "spice"), hold, 1000).startsWith("Bought").assertTrue()
	treated.advance(91)
	treated.military.settlements[0].manpower.assertEquals(9726)
	treated.military.civic.states[0].diseaseAvoided.assertEquals(90)
	treated.advance(179)
	let saved = treated.military.snapshot()
	treated.commands.dispatch(Player(0), "/civic response district").assertTrue()
	treated.resources.output.contains("expired cooldown").assertTrue()
	treated.military.snapshot().assertEquals(saved)
	treated.campaign.countries.treasury[0].assertEquals(9799)
	treated.trade.findMarket("district", "cloth").stock.assertEquals(496)
	treated.advance(180)
	treated.action("response")
	treated.campaign.countries.treasury[0].assertEquals(9598)
	treated.trade.findMarket("district", "cloth").stock.assertEquals(492)

@test function civicPolicyAndResponseRequireCurrentLocalJurisdictionAndMedicalStock()
	let f = new CivicFixture()
	let initial = f.military.snapshot()
	for index = 0 to 1
		var action = "policy"
		if index == 1
			action = "response"
		f.commands.dispatch(Player(0), "/civic " + action + " district").assertTrue()
		f.military.snapshot().assertEquals(initial)
	f.allResearch()
	for invalid = 1 to 3
		f.military.administrators[0].jurisdiction = "district"
		f.military.administrators[0].capacity = 1
		f.military.settlements[0].legalOwnerId = "player"
		if invalid == 1
			f.military.administrators[0].jurisdiction = "foreign"
		else if invalid == 2
			f.military.administrators[0].capacity = 0
		else
			f.military.settlements[0].legalOwnerId = "foreign"
		let before = f.military.snapshot()
		for index = 0 to 1
			var action = "policy"
			if index == 1
				action = "response"
			f.commands.dispatch(Player(0), "/civic " + action + " district").assertTrue()
			f.resources.output.contains("lawfully controlled").assertTrue()
			f.military.snapshot().assertEquals(before)
			f.campaign.countries.treasury[0].assertEquals(10000)
			f.trade.findMarket("district", "cloth").stock.assertEquals(1000)
	f.military.settlements[0].legalOwnerId = "player"
	f.military.civic.districts[0].medicalGood = "unavailable"
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("insufficient").assertTrue()
	f.military.snapshot().assertEquals(initial)
	f.campaign.countries.treasury[0].assertEquals(10000)
	f.military.civic.districts[0].medicalGood = "cloth"
	f.action("policy")
	f.action("response")
	let paid = f.military.snapshot()
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("expired cooldown").assertTrue()
	f.military.snapshot().assertEquals(paid)
	f.campaign.countries.treasury[0].assertEquals(9698)
	f.trade.findMarket("district", "cloth").stock.assertEquals(996)
	// Loss of the serving local office suspends both effects during replay.
	f.military.administrators[0].jurisdiction = "foreign"
	f.advance(10)
	f.military.settlements[0].manpower.assertEquals(9960)
	f.military.civic.states[0].discussion.assertEquals(0)
	f.military.civic.states[0].diseaseAvoided.assertEquals(0)
	f.military.administrators[0].jurisdiction = "district"
	f.military.transferSettlement("district", "ai")
	f.military.transferSettlement("district", "player")
	f.military.civic.states[0].policyOwner.assertEquals("")
	f.military.civic.states[0].responseOwner.assertEquals("")
	f.military.civic.states[0].cooldownEnd.assertEquals(f.day + 180)
	f.commands.dispatch(Player(0), "/civic response district").assertTrue()
	f.resources.output.contains("expired cooldown").assertTrue()
	f.advance(100)
	f.military.settlements[0].manpower.assertEquals(9600)
	f.military.civic.states[0].diseaseAvoided.assertEquals(0)


@test function civicSurveyRejectsUnknownOccupationJurisdictionAndInsufficientFundsWithoutMutation()
	let f = new CivicFixture()
	f.military.civic.districts[0].annualTax = 10000
	f.prerequisites()
	f.unlock("cadastral_survey")
	let original = f.military.snapshot()
	f.runtime.act("player", "survey", "unknown").contains("known, lawfully controlled").assertTrue()
	f.military.snapshot().assertEquals(original)
	f.campaign.countries.treasury[0] = 99
	f.commands.dispatch(Player(0), "/civic survey district").assertTrue()
	f.resources.output.contains("insufficient").assertTrue()
	f.campaign.countries.treasury[0].assertEquals(99)
	f.military.snapshot().assertEquals(original)
	f.campaign.countries.treasury[0] = 10000
	for invalid = 1 to 4
		f.military.administrators[0].jurisdiction = "district"
		f.military.administrators[0].capacity = 1
		f.military.settlements[0].legalOwnerId = "player"
		f.military.settlements[0].occupationConflictId = ""
		if invalid == 1
			f.military.administrators[0].jurisdiction = "foreign"
		else if invalid == 2
			f.military.administrators[0].capacity = 0
		else if invalid == 3
			f.military.settlements[0].legalOwnerId = "foreign"
		else
			f.military.settlements[0].occupationConflictId = "occupation"
		let before = f.military.snapshot()
		f.commands.dispatch(Player(0), "/civic survey district").assertTrue()
		f.resources.output.contains("lawfully controlled").assertTrue()
		f.military.snapshot().assertEquals(before)
		f.campaign.countries.treasury[0].assertEquals(10000)
		f.trade.findMarket("district", "cloth").money.assertEquals(100000)

@test function civicSurveyUnfinishedLiquidityAndCapacityBoundsUseActualCollection()
