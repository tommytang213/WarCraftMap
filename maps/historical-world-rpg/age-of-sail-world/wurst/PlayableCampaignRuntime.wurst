/** Stable-domain extensions participate in every campaign lifecycle without
 * making their Warcraft projections part of the save authority. */
public interface CampaignRuntimeExtension
	function newCampaign(string settlementId)
	function reconstruct(string authorityDocument) returns boolean
	function capture() returns string

public constant string CAMPAIGN_CACHE_FILE = "AgeOfSailCampaign.w3v"
public constant real CAMPAIGN_AUTOSAVE_SECONDS = 300.
ReligionRuntime religionMigrationRuntime = null

function logicalRegionForPhysicalMap(string mapId) returns string
	if mapId == "bootstrap_runtime_validation"
		return "bootstrap"
	if mapId == "europe_west" or mapId == "europe_central_east"
		return "europe"
	if mapId == "africa" or mapId == "middle_east_india" or mapId == "southeast_asia" or mapId == "east_asia"
		return mapId
	if mapId == "americas_north_central" or mapId == "americas_caribbean" or mapId == "americas_south" or mapId == "americas_pacific_transition"
		return "americas_caribbean"
	if mapId == "pacific_north" or mapId == "pacific_west" or mapId == "pacific_melanesia" or mapId == "pacific_polynesia" or mapId == "pacific_new_zealand" or mapId == "pacific_open_ocean_encounter"
		return "pacific"
	return ""

function lastAuthorityValue(string document, string key) returns string
	let marker = ";" + key + "="
	var found = -1
	var search = 0
	while search < StringLength(document)
		let relative = SubString(document, search, StringLength(document)).indexOf(marker)
		if relative < 0
			search = StringLength(document)
		else
			found = search + relative + StringLength(marker)
			search = found
	if found < 0
		return ""
	let tail = SubString(document, found, StringLength(document))
	let finish = tail.indexOf(";")
	if finish < 0
		return tail
	return SubString(tail, 0, finish)

function playerAuthorityValue(string document, string key) returns string
	let players = lastAuthorityValue(document, "players")
	let marker = key + ":"
	let position = players.indexOf(marker)
	if position < 0
		return ""
	let tail = SubString(players, position + StringLength(marker), StringLength(players))
	let finish = tail.indexOf(",")
	if finish < 0
		return tail
	return SubString(tail, 0, finish)

function withoutCountryAuthority(string document) returns string
	let cut = document.indexOf(";diplomacy=")
	if cut < 0
		return document
	return SubString(document, 0, cut)

/** Replaces the location tuple instead of accumulating stale transition keys
 * over repeated multi-hop travel. Other authoritative domains are untouched. */
function withoutTravelAuthority(string document) returns string
	let first = document.indexOf(";")
	if first < 0
		return document
	var result = SubString(document, 0, first)
	var remaining = SubString(document, first + 1, StringLength(document))
	while remaining != ""
		let separator = remaining.indexOf(";")
		var field = remaining
		if separator >= 0
			field = SubString(remaining, 0, separator)
			remaining = SubString(remaining, separator + 1, StringLength(remaining))
		else
			remaining = ""
		if not field.startsWith("map=") and not field.startsWith("region=") and not field.startsWith("boundary=") and not field.startsWith("position=") and not field.startsWith("transition=") and not field.startsWith("arrival=")
			result += ";" + field
	return result

/**
 * The compact runtime authority uses stable IDs only. Domain payloads are supplied by the
 * gameplay systems (quests, settlements, inventory, fleets, orders and discovery); Warcraft
 * handles and UI state never enter this document.
 */
public class PlayableCampaignState implements CampaignStatePort
	string authority = "v2;map=world-map;region=europe;boundary=;position=0.5;world=;players=;quests=;discovery=;orders=;trade="
	string staged = ""
	boolean transitionOpen = false
	string lastDiagnostic = ""
	WarcraftRegionalAdapter regional
	CampaignRuntimeExtension extension = null
	PlayableCountryInteractionRuntime countries = null
	WarcraftRpgRuntime rpg = null
	MilitarySettlementRuntime militarySettlements = null
	ReligionRuntime religion = null
	construct(WarcraftRegionalAdapter regional)
		this.regional = regional
	function replaceAuthority(string value)
		authority = value
	function setExtension(CampaignRuntimeExtension value)
		extension = value
	function setCountryRuntime(PlayableCountryInteractionRuntime runtime)
		countries = runtime
	function setRpgRuntime(WarcraftRpgRuntime runtime)
		rpg = runtime
	function setMilitarySettlementRuntime(MilitarySettlementRuntime runtime)
		militarySettlements = runtime
	function setReligionRuntime(ReligionRuntime runtime)
		religion = runtime
	function authorityDocument() returns string
		return authority
	function beginTransition()
		transitionOpen = true
	function finishTransition()
		transitionOpen = false
	function cancelTransition()
		transitionOpen = false
	override function isSaveSafe() returns boolean
		return not transitionOpen
	override function captureAuthoritativeState() returns string
		var result = authority
		if countries != null
			result = withoutCountryAuthority(result) + ";diplomacy=" + countries.captureState() + ";rewards=" + countries.captureState()
		if rpg != null
			result += ";rpg=" + rpg.captureState()
		if militarySettlements != null
			result += ";militarySettlements=" + militarySettlements.snapshot()
		if religion != null
			result += ";religion=" + religion.captureState()
		if extension != null
			result += ";trade=" + extension.capture()
		return result
	override function validateAuthoritativeState(string candidate) returns boolean
		if (not candidate.startsWith("v2;") and not candidate.startsWith("v1;")) or candidate.indexOf(";map=") < 0 or candidate.indexOf(";region=") < 0 or candidate.indexOf(";quests=") < 0 or candidate.indexOf(";discovery=") < 0 or candidate.indexOf(";orders=") < 0 or candidate.indexOf(";diplomacy=") < 0 or candidate.indexOf(";rewards=") < 0 or (rpg != null and candidate.indexOf(";rpg=") < 0)
			lastDiagnostic = "missing or incompatible authoritative campaign domains"
			return false
		if rpg != null and not rpg.validateState(lastAuthorityValue(candidate,"rpg"))
			lastDiagnostic=rpg.diagnostic()
			return false
		if militarySettlements != null and candidate.indexOf(";militarySettlements=") < 0
			lastDiagnostic = "missing military/settlement authority"
			return false
		if religion != null and candidate.indexOf(";religion=") < 0
			lastDiagnostic = "missing religion authority"
			return false
		if militarySettlements != null and not militarySettlements.validateSnapshot(lastAuthorityValue(candidate, "militarySettlements"))
			lastDiagnostic = "military/settlement authority is invalid"
			return false
		// Saves produced before playable trade remain compatible.
		staged = candidate
		if staged.indexOf(";trade=") < 0
			staged += ";trade="
		lastDiagnostic = ""
		return true
	override function reconstructRuntime(string candidate) returns boolean
		// Stable representation definitions already contain the authoritative coordinates.
		// Missing Warcraft objects are recreated; unrelated regions remain abstract.
		if rpg != null and not rpg.restoreState(lastAuthorityValue(candidate,"rpg"))
			lastDiagnostic=rpg.diagnostic()
			return false
		if countries != null and not countries.restoreState(lastAuthorityValue(candidate, "diplomacy"))
			lastDiagnostic = countries.diagnostic()
			return false
		regional.recoverActiveRegion()
		if rpg != null
			rpg.reconstruct(Player(0),0.,0.,"player")
		if militarySettlements != null and not militarySettlements.restore(lastAuthorityValue(candidate, "militarySettlements"))
			lastDiagnostic = "military/settlement reconstruction failed"
			return false
		if religion != null and not religion.restoreState(lastAuthorityValue(candidate, "religion"))
			lastDiagnostic = religion.lastDiagnostic
			return false
		if extension != null and not extension.reconstruct(lastAuthorityValue(candidate, "trade"))
			lastDiagnostic = "trade runtime reconstruction failed"
			return false
		return true
	override function activateAuthoritativeState(string candidate)
		authority = withoutCountryAuthority(staged)
		staged = ""
	override function diagnostic() returns string
		return lastDiagnostic

function runtimeChecksum(string value) returns int
	var result = 5381
	for i = 0 to StringLength(value) - 1
		result = ModuloInteger(result * 33 + StringHash(SubString(value, i, i + 1)), 2147483000)
	return result

/** Versioned envelope with slot binding and integrity metadata. Failed loads return no candidate. */
public class PlayableCampaignCodec implements CampaignSaveCodec
	string lastDiagnostic = ""
	override function encode(string slotId, int slotKind, int slotIndex, string createdAt, string authoritativeState) returns string
		let body = "schema=2|slot=" + slotId + "|kind=" + slotKind.toString() + "|index=" + slotIndex.toString() + "|created=" + createdAt + "|state=" + authoritativeState
		return "integrity=" + runtimeChecksum(body).toString() + "|" + body
	override function decodeMigrateAndValidate(string payload, string expectedSlotId) returns string
		let marker = "|schema="
		let cut = payload.indexOf(marker)
		if not payload.startsWith("integrity=") or cut < 0
			lastDiagnostic = "save envelope is malformed"
			return ""
		let expected = S2I(SubString(payload, 10, cut))
		let body = SubString(payload, cut + 1, StringLength(payload))
		if runtimeChecksum(body) != expected
			lastDiagnostic = "save integrity check failed"
			return ""
		let currentPrefix = "schema=2|slot=" + expectedSlotId + "|"
		let priorPrefix = "schema=1|slot=" + expectedSlotId + "|"
		let legacyPrefix = "schema=0|slot=" + expectedSlotId + "|"
		if body.indexOf(currentPrefix) != 0 and body.indexOf(priorPrefix) != 0 and body.indexOf(legacyPrefix) != 0
			lastDiagnostic = "save schema or slot is incompatible"
			return ""
		let stateMarker = "|state="
		let stateCut = body.indexOf(stateMarker)
		if stateCut < 0
			lastDiagnostic = "save has no authoritative state"
			return ""
		var decoded = SubString(body, stateCut + StringLength(stateMarker), StringLength(body))
		if body.indexOf(legacyPrefix) == 0
			// Schema 0 predates explicit remote-order and discovery domains.
			if decoded.startsWith("v0;")
				decoded = "v1;" + SubString(decoded, 3, StringLength(decoded))
			if decoded.indexOf(";discovery=") < 0
				decoded += ";discovery="
			if decoded.indexOf(";orders=") < 0
				decoded += ";orders="
			if decoded.indexOf(";trade=") < 0
				decoded += ";trade="
		// Saves produced before country integration remain release-schema compatible.
		if decoded.indexOf(";diplomacy=") < 0
			decoded += ";diplomacy=v1"
		if decoded.indexOf(";rewards=") < 0
			decoded += ";rewards=v1"
		if decoded.startsWith("v0;") or decoded.startsWith("v1;")
			decoded = "v2;" + SubString(decoded,3,StringLength(decoded))
		if body.indexOf(currentPrefix) != 0 and decoded.indexOf(";rpg=") < 0
			decoded += ";rpg=v1"
		// Schema 2 adds stable Warcraft military/settlement authority. Older saves
		// migrate transactionally from the scenario-configured initial authority.
		if decoded.indexOf(";militarySettlements=") < 0
			decoded += ";militarySettlements=" + militarySettlementRuntime.snapshot()
		if decoded.indexOf(";religion=") < 0 and religionMigrationRuntime != null
			decoded += ";religion=" + religionMigrationRuntime.captureState()
		lastDiagnostic = ""
		return decoded
	override function diagnostic() returns string
		return lastDiagnostic

public class BoundaryCorrespondence
	string id
	string sourceMapId
	string destinationMapId
	string destinationPath
	string destinationRegionId
	boolean reverse
	real scale
	real offset
	construct(string id, string sourceMapId, string destinationMapId, string destinationPath, string destinationRegionId, boolean reverse, real scale, real offset)
		this.id = id
		this.sourceMapId = sourceMapId
		this.destinationMapId = destinationMapId
		this.destinationPath = destinationPath
		this.destinationRegionId = destinationRegionId
		this.reverse = reverse
		this.scale = scale
		this.offset = offset
	function destinationPosition(real normalized) returns real
		var value = normalized
		if reverse
			value = 1. - value
		value = value * scale + offset
		if value < 0.
			return 0.
		if value > 1.
			return 1.
		return value

public interface PhysicalMapLoader
	function load(string packagePath)

public class WarcraftPhysicalMapLoader implements PhysicalMapLoader
	override function load(string packagePath)
		compatLoadPhysicalMap(packagePath)

/** Commit-first transition coordinator. Loading is the sole irreversible step. */
public class CampaignTravelRuntime
	PlayableCampaignState state
	CampaignSaveManager saves
	CampaignAutosaveScheduler autosaves
	PhysicalMapLoader loader
	string currentMapId
	string currentRegionId
	string lastDiagnostic = ""
	construct(PlayableCampaignState state, CampaignSaveManager saves, CampaignAutosaveScheduler autosaves, PhysicalMapLoader loader, string mapId, string regionId)
		this.state = state
		this.saves = saves
		this.autosaves = autosaves
		this.loader = loader
		currentMapId = mapId
		currentRegionId = regionId
	function physicalMapId() returns string
		return currentMapId
	function physicalRegionId() returns string
		return currentRegionId
	function startAt(string mapId, string regionId)
		currentMapId = mapId
		currentRegionId = regionId
	function transition(BoundaryCorrespondence boundary, real normalized, string createdAt) returns boolean
		if boundary == null or boundary.sourceMapId != currentMapId or normalized < 0. or normalized > 1.
			lastDiagnostic = "transition is not adjacent to the active physical map"
			return false
		let previous = state.authorityDocument()
		let arrival = boundary.destinationPosition(normalized)
		state.beginTransition()
		state.replaceAuthority(withoutTravelAuthority(previous) + ";map=" + boundary.destinationMapId + ";region=" + boundary.destinationRegionId + ";boundary=" + boundary.id + ";position=" + arrival.toString() + ";transition=" + boundary.id + ";arrival=" + arrival.toString())
		state.finishTransition()
		if not saves.save(SAVE_SLOT_MAJOR_MILESTONE, 0, createdAt)
			state.replaceAuthority(previous)
			state.cancelTransition()
			lastDiagnostic = saves.diagnostic()
			return false
		currentMapId = boundary.destinationMapId
		currentRegionId = boundary.destinationRegionId
		if saves.hasDeferredSave()
			saves.retryDeferred()
		loader.load(boundary.destinationPath)
		lastDiagnostic = ""
		return true
	function diagnostic() returns string
		return lastDiagnostic

/** Map-local edge triggers are projections of scenario-owned correspondence
 * records. They contain no campaign authority and are rebuilt on every map. */
public class PhysicalBoundaryRegistry
	CampaignTravelRuntime travel
	PlayableRegionAccess access
	BoundaryCorrespondence array[64] boundaries
	trigger array[64] listeners
	string array[64] edges
	real array[64] intervalStarts
	real array[64] intervalEnds
	boolean array[64] discoveryRequired
	int count = 0
	boolean transitioning = false
	construct(CampaignTravelRuntime travel, PlayableRegionAccess access)
		this.travel = travel
		this.access = access
	function add(string id, string sourceMapId, string destinationMapId, string destinationPath, string destinationRegionId, string sourceEdge, real intervalStart, real intervalEnd, boolean reverse, real scale, real offset, boolean requiresDiscovery)
		boundaries[count] = new BoundaryCorrespondence(id, sourceMapId, destinationMapId, destinationPath, destinationRegionId, reverse, scale, offset)
		edges[count] = sourceEdge
		intervalStarts[count] = intervalStart
		intervalEnds[count] = intervalEnd
		discoveryRequired[count] = requiresDiscovery
		count++
	function normalizedPosition(int index, unit entering) returns real
		let world = GetPlayableMapRect()
		if edges[index] == "east" or edges[index] == "west"
			return (GetUnitY(entering) - GetRectMinY(world)) / (GetRectMaxY(world) - GetRectMinY(world))
		return (GetUnitX(entering) - GetRectMinX(world)) / (GetRectMaxX(world) - GetRectMinX(world))
	function entered()
		if transitioning
			return
		let entering = GetEnteringUnit()
		if entering == null or GetOwningPlayer(entering) != Player(0)
			return
		let fired = GetTriggeringTrigger()
		for i = 0 to count - 1
			if listeners[i] == fired
				if discoveryRequired[i] and not access.regionIsKnown(Player(0), boundaries[i].destinationRegionId)
					print("This route has not been discovered.")
					return
				let position = normalizedPosition(i, entering)
				let local = (position - intervalStarts[i]) / (intervalEnds[i] - intervalStarts[i])
				transitioning = true
				if not travel.transition(boundaries[i], local, I2S(R2I(TimerGetElapsed(bj_gameStartedTimer))))
					transitioning = false
					print(travel.diagnostic())
				return
	function install()
		installPhysicalBoundaryRegistry(this)
		let world = GetPlayableMapRect()
		let minX = GetRectMinX(world)
		let maxX = GetRectMaxX(world)
		let minY = GetRectMinY(world)
		let maxY = GetRectMaxY(world)
		for i = 0 to count - 1
			var area = world
			if edges[i] == "west"
				area = Rect(minX, minY + (maxY-minY)*intervalStarts[i], minX+128., minY + (maxY-minY)*intervalEnds[i])
			else if edges[i] == "east"
				area = Rect(maxX-128., minY + (maxY-minY)*intervalStarts[i], maxX, minY + (maxY-minY)*intervalEnds[i])
			else if edges[i] == "south"
				area = Rect(minX + (maxX-minX)*intervalStarts[i], minY, minX + (maxX-minX)*intervalEnds[i], minY+128.)
			else
				area = Rect(minX + (maxX-minX)*intervalStarts[i], maxY-128., minX + (maxX-minX)*intervalEnds[i], maxY)
			listeners[i] = CreateTrigger()
			TriggerRegisterEnterRectSimple(listeners[i], area)
			TriggerAddAction(listeners[i], function physicalBoundaryEntered)

PhysicalBoundaryRegistry installedPhysicalBoundaries = null

function installPhysicalBoundaryRegistry(PhysicalBoundaryRegistry registry)
	installedPhysicalBoundaries = registry

function physicalBoundaryEntered()
	if installedPhysicalBoundaries != null
		installedPhysicalBoundaries.entered()

public class SaveCommand implements CommandHandler
	CampaignSaveManager saves
	CommandOutput output
	boolean loading
	construct(CampaignSaveManager saves, CommandOutput output, boolean loading)
		this.saves = saves
		this.output = output
		this.loading = loading
	override function execute(player sender, string arguments)
		var ok = false
		if loading
			ok = saves.load(SAVE_SLOT_MANUAL, S2I(arguments))
		else
			ok = saves.save(SAVE_SLOT_MANUAL, S2I(arguments), I2S(R2I(TimerGetElapsed(bj_gameStartedTimer))))
		if ok
			output.show(sender, "Campaign save operation completed.")
		else
			output.show(sender, saves.diagnostic())

public function registerCampaignSaveCommands(CommandRegistry commands, CampaignSaveManager saves)
	commands.register("save", "", "save <slot>", "Save the campaign.", "Write authoritative campaign state to a manual slot.", 1, 1, COMMAND_RELEASE, new SaveCommand(saves, new WarcraftOutput(), false))
	commands.register("load", "", "load <slot>", "Load the campaign.", "Validate, migrate, reconstruct, then activate a manual save without damaging the active campaign on rejection.", 1, 1, COMMAND_RELEASE, new SaveCommand(saves, new WarcraftOutput(), true))

/** Knowledge and command rights are explicit runtime facts, never inferred from object presence. */
public class PlayableRegionAccess implements RegionAccessPolicy
	string array[64] ids
	boolean array[64] known
	boolean array[64] authorized
	int count = 0
	function add(string id, boolean isKnown, boolean mayCommand)
		ids[count] = id
		known[count] = isKnown
		authorized[count] = mayCommand
		count++
	function find(string id) returns int
		for i = 0 to count - 1
			if ids[i] == id
				return i
		return -1
	function revealAndAuthorize(string id)
		let i = find(id)
		if i >= 0
			known[i] = true
			authorized[i] = true
	override function regionExists(string regionId) returns boolean
		return find(regionId) >= 0
	override function regionIsKnown(player whichPlayer, string regionId) returns boolean
		let i = find(regionId)
		return i >= 0 and known[i]
	override function mayCommandRegion(player whichPlayer, string regionId) returns boolean
		let i = find(regionId)
		return i >= 0 and authorized[i]

public class PlayableRegionCommandRuntime implements RegionCommandRuntime
	WarcraftRegionalAdapter regional
	string previousRegion = ""
	string lastDiagnostic = ""
	construct(WarcraftRegionalAdapter regional)
		this.regional = regional
	override function snapshotRuntime() returns string
		return previousRegion
	override function restoreRuntime(string snapshot)
		if snapshot != ""
			regional.activateRegion(snapshot)
	override function retireCommandRegion(string regionId)
		previousRegion = regionId
		regional.retireRegion(regionId)
	override function reconstructCommandRegion(player whichPlayer, string regionId) returns boolean
		regional.reconstructRegion(regionId)
		return true
	override function focusCommandRegion(player whichPlayer, string regionId)
		// Each representation retains authoritative coordinates; activating it cannot move the party.
		regional.activateRegion(regionId)
	override function diagnostic() returns string
		return lastDiagnostic

public class WarcraftMapPresentation implements MapPresentationRuntime
	CommandOutput output
	string knownRegions = "europe"
	string knownLocations = ""
	string knownSearchAreas = ""
	string knownBreadcrumbs = ""
	construct(CommandOutput output)
		this.output = output
	function setKnowledge(string regions, string locations, string searchAreas, string breadcrumbs)
		knownRegions = regions
		knownLocations = locations
		knownSearchAreas = searchAreas
		knownBreadcrumbs = breadcrumbs
	override function showWorldMap(string physicalRegionId, string commandRegionId)
		output.show(Player(0), "World map\nKnown regions: " + knownRegions + "\nKnown routes: " + knownBreadcrumbs + "\nPhysical: " + physicalRegionId + "  Command: " + commandRegionId)
	override function showRegionalMap(string regionId, string physicalRegionId, string commandRegionId)
		output.show(Player(0), "Regional map: " + regionId + "\nKnown locations: " + knownLocations + "\nKnown search areas: " + knownSearchAreas + "\nRoute: " + knownBreadcrumbs)
	override function focusExact(string locationId)
		output.show(Player(0), "Exact known location: " + locationId)
	override function focusSearchArea(string searchAreaId)
		output.show(Player(0), "Known search area: " + searchAreaId)
	override function hideMap()
		skip

public class CampaignMapCommand implements CommandHandler
	MapDiscoveryScreenController maps
	construct(MapDiscoveryScreenController maps)
		this.maps = maps
	override function execute(player sender, string arguments)
		if arguments == "close"
			maps.close()
		else if arguments == "world"
			maps.openWorldMap()
		else
			maps.openRegionalMap(arguments)

public function registerCampaignMapCommand(CommandRegistry commands, MapDiscoveryScreenController maps)
	commands.register("map", "worldmap", "map <world|region-id|close>", "Open a discovered campaign map.", "Show legitimately known geography, locations, search areas, and route breadcrumbs without moving the physical character.", 1, 1, COMMAND_RELEASE, new CampaignMapCommand(maps))

public class PlayableCampaignServices implements OriginSelectionObserver, CampaignLoadObserver
	PlayerCampaignIdentity identity
	PlayableCampaignState state
	CampaignSaveManager saves
	CampaignAutosaveScheduler autosaves
	CampaignTravelRuntime travel
	PlayableRegionAccess regionAccess
	RegionSelector regionSelector
	MapDiscoveryScreenController maps
	WarcraftMapPresentation mapPresentation
	CampaignRuntimeExtension extension = null
	PlayableCountryInteractionRuntime countries
	CountryDiplomacyController countryScreen
	construct(WarcraftRegionalAdapter regional, string physicalMapId, ReligionRuntime religion)
		identity = new PlayerCampaignIdentity()
		state = new PlayableCampaignState(regional)
		countries = new PlayableCountryInteractionRuntime(identity)
		countryScreen = new CountryDiplomacyController(countries, new WarcraftCountryDiplomacyPresentation())
		state.setCountryRuntime(countries)
		state.setReligionRuntime(religion)
		saves = new CampaignSaveManager(new WarcraftCampaignSaveStorage(CAMPAIGN_CACHE_FILE), new PlayableCampaignCodec(), state)
		autosaves = new CampaignAutosaveScheduler(saves, CAMPAIGN_AUTOSAVE_SECONDS)
		let logicalRegion = logicalRegionForPhysicalMap(physicalMapId)
		travel = new CampaignTravelRuntime(state, saves, autosaves, new WarcraftPhysicalMapLoader(), physicalMapId, logicalRegion)
		regionAccess = new PlayableRegionAccess()
		regionAccess.add("europe", true, true)
		regionAccess.add("africa", false, false)
		regionAccess.add("middle_east_india", false, false)
		regionAccess.add("southeast_asia", false, false)
		regionAccess.add("east_asia", false, false)
		regionAccess.add("americas_caribbean", false, false)
		regionAccess.add("pacific", false, false)
		regionAccess.revealAndAuthorize(logicalRegion)
		regionSelector = new RegionSelector(regionAccess, new PlayableRegionCommandRuntime(regional), logicalRegion)
		mapPresentation = new WarcraftMapPresentation(new WarcraftOutput())
		mapPresentation.setKnowledge(logicalRegion, "", "", "")
		maps = new MapDiscoveryScreenController(getManagementScreenPauseController(), mapPresentation, logicalRegion, logicalRegion)
		saves.setLoadObserver(this)
		// Destination maps resume the last commit. Rejection is intentionally non-destructive.
		if physicalMapId != "bootstrap_runtime_validation"
			saves.load(SAVE_SLOT_MAJOR_MILESTONE, 0)
	function registerExtension(CampaignRuntimeExtension value)
		extension = value
		state.setExtension(value)
		// Registration follows service construction, so reconstruct the commit
		// already loaded by a destination map before exposing any commands.
		value.reconstruct(lastAuthorityValue(state.authorityDocument(), "trade"))
	function sessionStart(string createdAt)
		saves.save(SAVE_SLOT_SESSION_START, 0, createdAt)
	function majorMilestone(string createdAt)
		saves.save(SAVE_SLOT_MAJOR_MILESTONE, 0, createdAt)
	override function campaignStarted(string polityId, string physicalMapId, string packagePath, string regionalInstanceId, string settlementId)
		let logicalRegion = logicalRegionForPhysicalMap(physicalMapId)
		if extension != null
			extension.newCampaign(settlementId)
		countries.discover(polityId)
		state.replaceAuthority("v2;map=" + physicalMapId + ";region=" + logicalRegion + ";boundary=;position=0.5;world=instance:" + regionalInstanceId + ";players=origin:" + polityId + ",allegiance:" + polityId + ",settlement:" + settlementId + ";quests=;discovery=" + settlementId + ";orders=;trade=")
		travel.startAt(physicalMapId, logicalRegion)
		regionAccess.revealAndAuthorize(logicalRegion)
		regionSelector.setPhysicalRegionId(logicalRegion)
		mapPresentation.setKnowledge(logicalRegion, settlementId, "", "")
		maps.setPhysicalRegion(logicalRegion)
		maps.setCommandRegion(logicalRegion)
		// The cache commit must precede the irreversible cross-map handoff.
		if saves.save(SAVE_SLOT_SESSION_START, 0, "campaign-start")
			travel.loader.load(packagePath)
	override function afterCampaignLoad()
		let loadedMap = lastAuthorityValue(state.authorityDocument(), "map")
		let loadedRegion = lastAuthorityValue(state.authorityDocument(), "region")
		if loadedMap != "" and loadedRegion != ""
			let loadedOrigin = playerAuthorityValue(state.authorityDocument(), "origin")
			var loadedAllegiance = playerAuthorityValue(state.authorityDocument(), "allegiance")
			let loadedSettlement = playerAuthorityValue(state.authorityDocument(), "settlement")
			if loadedAllegiance == ""
				loadedAllegiance = loadedOrigin
			identity.restore(loadedOrigin, loadedAllegiance, loadedMap, loadedRegion, loadedSettlement)
			travel.startAt(loadedMap, loadedRegion)
			regionAccess.revealAndAuthorize(loadedRegion)
			regionSelector.setPhysicalRegionId(loadedRegion)
			maps.setPhysicalRegion(loadedRegion)
			maps.setCommandRegion(loadedRegion)

public PlayableCampaignServices campaignServices = null
timer campaignAutosaveTimer = null

function campaignAutosaveTick()
	if campaignServices != null
		campaignServices.autosaves.advance(CAMPAIGN_AUTOSAVE_SECONDS, I2S(R2I(TimerGetElapsed(bj_gameStartedTimer))))

public function initializePlayableCampaignRuntime(CommandRegistry commands, string physicalMapId, ReligionRuntime religion) returns PlayableCampaignServices
	religionMigrationRuntime = religion
	campaignServices = new PlayableCampaignServices(regionalRuntime, physicalMapId, religion)
	registerCampaignSaveCommands(commands, campaignServices.saves)
	registerRegionCommand(commands, campaignServices.regionSelector, new WarcraftOutput())
	registerCampaignMapCommand(commands, campaignServices.maps)
	registerGovernmentRewards(commands, campaignServices.countryScreen)
	campaignAutosaveTimer = CreateTimer()
	TimerStart(campaignAutosaveTimer, CAMPAIGN_AUTOSAVE_SECONDS, true, function campaignAutosaveTick)
	return campaignServices
