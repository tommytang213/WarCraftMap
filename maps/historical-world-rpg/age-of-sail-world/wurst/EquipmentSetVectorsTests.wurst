package EquipmentSetVectorsTests
import EquipmentSetTests
import WarcraftRpgRuntime

// Generated by test_equipment_sets.py --write-vectors. Expected identities come
// from inventory.resolve_equipment_bonuses; commands and projection are live.

@test function equipmentSetParity_cumulative_false()
	let f = new SetParityFixture()
	f.addHero("alpha")
	f.addHero("beta")
	let equipmentSet0=new EquipmentSet("fixture")
	equipmentSet0.allowDuplicatePieces=false
	let equipmentSet0Piece0=new EquipmentSetPiece("coat_piece")
	equipmentSet0Piece0.addItem("coat")
	equipmentSet0.addPiece(equipmentSet0Piece0)
	let equipmentSet0Piece1=new EquipmentSetPiece("hat_piece")
	equipmentSet0Piece1.addItem("hat")
	equipmentSet0Piece1.addItem("wrong_slot")
	equipmentSet0Piece1.addSlot("head")
	equipmentSet0.addPiece(equipmentSet0Piece1)
	let equipmentSet0Piece2=new EquipmentSetPiece("ring_piece")
	equipmentSet0Piece2.addItem("left_ring")
	equipmentSet0Piece2.addItem("right_ring")
	equipmentSet0.addPiece(equipmentSet0Piece2)
	let equipmentSet0Tier0=new EquipmentSetThreshold("three",3,"cumulative")
	equipmentSet0Tier0.addEffect("mastery")
	equipmentSet0.addThreshold(equipmentSet0Tier0)
	let equipmentSet0Tier1=new EquipmentSetThreshold("two",2,"cumulative")
	equipmentSet0Tier1.addEffect("mobility")
	equipmentSet0Tier1.addEffect("guard")
	equipmentSet0.addThreshold(equipmentSet0Tier1)
	let equipmentSet0Tier2=new EquipmentSetThreshold("one",1,"cumulative")
	equipmentSet0Tier2.addEffect("guard")
	equipmentSet0.addThreshold(equipmentSet0Tier2)
	f.rpg.inventory.registerSet(equipmentSet0)
	f.rpg.inventory.registerItem(new RpgItem("coat","Item","chest","common",1,0))
	f.rpg.inventory.grant("coat").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("hat","Item","head","common",1,0))
	f.rpg.inventory.grant("hat").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("left_ring","Item","left","common",1,0))
	f.rpg.inventory.grant("left_ring").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("right_ring","Item","right","common",1,0))
	f.rpg.inventory.grant("right_ring").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("wrong_slot","Item","other","common",1,0))
	f.rpg.inventory.grant("wrong_slot").assertTrue()
	f.action("/equip alpha coat")
	f.check("alpha", "fixture", 1, "alpha|fixture|one|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/equip beta hat")
	f.check("alpha", "fixture", 1, "alpha|fixture|one|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/equip alpha left_ring")
	f.check("alpha", "fixture", 2, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/equip alpha right_ring")
	f.check("alpha", "fixture", 2, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/equip alpha wrong_slot")
	f.check("alpha", "fixture", 2, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/unequip beta head")
	f.check("alpha", "fixture", 2, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/equip alpha hat")
	f.check("alpha", "fixture", 3, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;alpha|fixture|three|mastery;")
	f.check("beta", "fixture", 0, "")
	f.inspect("alpha", "one (1 pieces): active | Effects: guard")
	f.rpg.reconcile("player")
	f.action("/unequip alpha chest")
	f.check("alpha", "fixture", 2, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha left")
	f.check("alpha", "fixture", 2, "alpha|fixture|one|guard;alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha right")
	f.check("alpha", "fixture", 1, "alpha|fixture|one|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha head")
	f.check("alpha", "fixture", 0, "")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha other")
	f.check("alpha", "fixture", 0, "")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.natives.totalWrites.assertEquals(0)
	f.rpg.inventory.ownedCount.assertEquals(5)

@test function equipmentSetParity_exclusive_false()
	let f = new SetParityFixture()
	f.addHero("alpha")
	f.addHero("beta")
	let equipmentSet0=new EquipmentSet("fixture")
	equipmentSet0.allowDuplicatePieces=false
	let equipmentSet0Piece0=new EquipmentSetPiece("coat_piece")
	equipmentSet0Piece0.addItem("coat")
	equipmentSet0.addPiece(equipmentSet0Piece0)
	let equipmentSet0Piece1=new EquipmentSetPiece("hat_piece")
	equipmentSet0Piece1.addItem("hat")
	equipmentSet0Piece1.addItem("wrong_slot")
	equipmentSet0Piece1.addSlot("head")
	equipmentSet0.addPiece(equipmentSet0Piece1)
	let equipmentSet0Piece2=new EquipmentSetPiece("ring_piece")
	equipmentSet0Piece2.addItem("left_ring")
	equipmentSet0Piece2.addItem("right_ring")
	equipmentSet0.addPiece(equipmentSet0Piece2)
	let equipmentSet0Tier0=new EquipmentSetThreshold("three",3,"exclusive")
	equipmentSet0Tier0.addEffect("mastery")
	equipmentSet0.addThreshold(equipmentSet0Tier0)
	let equipmentSet0Tier1=new EquipmentSetThreshold("two",2,"exclusive")
	equipmentSet0Tier1.addEffect("mobility")
	equipmentSet0Tier1.addEffect("guard")
	equipmentSet0.addThreshold(equipmentSet0Tier1)
	let equipmentSet0Tier2=new EquipmentSetThreshold("one",1,"exclusive")
	equipmentSet0Tier2.addEffect("guard")
	equipmentSet0.addThreshold(equipmentSet0Tier2)
	f.rpg.inventory.registerSet(equipmentSet0)
	f.rpg.inventory.registerItem(new RpgItem("coat","Item","chest","common",1,0))
	f.rpg.inventory.grant("coat").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("hat","Item","head","common",1,0))
	f.rpg.inventory.grant("hat").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("left_ring","Item","left","common",1,0))
	f.rpg.inventory.grant("left_ring").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("right_ring","Item","right","common",1,0))
	f.rpg.inventory.grant("right_ring").assertTrue()
	f.rpg.inventory.registerItem(new RpgItem("wrong_slot","Item","other","common",1,0))
	f.rpg.inventory.grant("wrong_slot").assertTrue()
	f.action("/equip alpha coat")
	f.check("alpha", "fixture", 1, "alpha|fixture|one|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/equip beta hat")
	f.check("alpha", "fixture", 1, "alpha|fixture|one|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/equip alpha left_ring")
	f.check("alpha", "fixture", 2, "alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/equip alpha right_ring")
	f.check("alpha", "fixture", 2, "alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/equip alpha wrong_slot")
	f.check("alpha", "fixture", 2, "alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 1, "beta|fixture|one|guard;")
	f.rpg.reconcile("player")
	f.action("/unequip beta head")
	f.check("alpha", "fixture", 2, "alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/equip alpha hat")
	f.check("alpha", "fixture", 3, "alpha|fixture|three|mastery;")
	f.check("beta", "fixture", 0, "")
	f.inspect("alpha", "one (1 pieces): superseded | Effects: guard")
	f.rpg.reconcile("player")
	f.action("/unequip alpha chest")
	f.check("alpha", "fixture", 2, "alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha left")
	f.check("alpha", "fixture", 2, "alpha|fixture|two|mobility;alpha|fixture|two|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha right")
	f.check("alpha", "fixture", 1, "alpha|fixture|one|guard;")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha head")
	f.check("alpha", "fixture", 0, "")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.action("/unequip alpha other")
	f.check("alpha", "fixture", 0, "")
	f.check("beta", "fixture", 0, "")
	f.rpg.reconcile("player")
	f.natives.totalWrites.assertEquals(0)
	f.rpg.inventory.ownedCount.assertEquals(5)

@test function equipmentSetParity_replacement_false()
	let f = new SetParityFixture()
	f.addHero("alpha")
	f.addHero("beta")
	let equipmentSet0=new EquipmentSet("fixture")
	equipmentSet0.allowDuplicatePieces=false
	let equipmentSet0Piece0=new EquipmentSetPiece("coat_piece")
	equipmentSet0Piece0.addItem("coat")
	equipmentSet0.addPiece(equipmentSet0Piece0)
	let equipmentSet0Piece1=new EquipmentSetPiece("hat_piece")
