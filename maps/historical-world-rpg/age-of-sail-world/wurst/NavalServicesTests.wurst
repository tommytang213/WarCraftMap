@test function combinedNavalAndLandSnapshotsPreserveBothHRecordsAndMigrateEitherVersion13Branch()
	let f = new NavalFixture(false, false)
	f.military.land.register("london", f.day)
	let arsenal = f.military.land.arsenals[0]
	arsenal.projectOwner = "player"
	arsenal.work = 12345
	arsenal.serial = 1
	let ship = f.military.forces[f.military.forceIndex("ship")]
	ship.nextFireAt = 1.285
	ship.hull.integrity = 5432
	ship.hull.repairCredit = 3456
	let hullRecord = "|h,ship," + ship.hull.record()
	let fireRecord = "|h,ship," + clockReal(1.285)
	let landRecord = "|l,london,,0,0,player,12345,0,1," + I2S(f.day)
	let saved = f.military.snapshot()
	saved.startsWith("v22|").assertTrue()
	saved.contains(hullRecord).assertTrue()
	saved.contains(fireRecord).assertTrue()
	saved.contains(landRecord).assertTrue()
	f.military.restore(saved, false).assertTrue()
	f.military.snapshot().assertEquals(saved)
	f.military.restore(saved + hullRecord, false).assertFalse()
	f.military.restore(saved + fireRecord, false).assertFalse()
	f.military.restore(saved + landRecord, false).assertFalse()
	f.military.restore(saved.replace(hullRecord, ""), false).assertFalse()
	f.military.restore(saved.replace(landRecord, ""), false).assertFalse()
	f.military.snapshot().assertEquals(saved)
	var main13 = saved.replace("v22|", "v13|")
	for i = 0 to f.military.forceCount - 1
		let fleet = f.military.forces[i]
		if fleet.kind == FORCE_FLEET
			main13 = main13.replace("|h," + fleet.id + "," + fleet.hull.record(), "")
	for i = 0 to f.military.naval.count - 1
		main13 = main13.replace("|y," + f.military.naval.yards[i].id + "," + f.military.naval.states[i].record(), "")
	f.military.restore(main13, false).assertTrue()
	f.military.forces[f.military.forceIndex("ship")].nextFireAt.assertEquals(1.285)
	f.military.forces[f.military.forceIndex("ship")].hull.integrity.assertEquals(10000)
	f.military.land.arsenals[0].work.assertEquals(12345)
	f.military.naval.states[0].ready.assertEquals(0)
	let naval13 = saved.replace("v22|", "v13|").replace(landRecord, "").replace(fireRecord, "")
	f.military.restore(naval13, false).assertTrue()
	f.military.forces[f.military.forceIndex("ship")].hull.integrity.assertEquals(5432)
	f.military.forces[f.military.forceIndex("ship")].hull.repairCredit.assertEquals(3456)
	f.military.forces[f.military.forceIndex("ship")].nextFireAt.assertEquals(0.)
	f.military.land.arsenals[0].projectOwner.assertEquals("")
	f.military.restore(saved, false).assertTrue()
	f.military.snapshot().assertEquals(saved)

/** Both arms purchase identical gear under the same historical authorization.
 * Removing completed research afterwards isolates its ongoing combat benefit;
 * it does not grant free equipment to the control. */
function paidCarronadeControl(boolean ai, boolean active) returns NavalFixture
	let f = new NavalFixture(ai, active)
	f.unlock("carronade_batteries")
	f.dock()
	let ledger = f.military.naval
	ledger.mountCost.assertEquals(200)
	ledger.mountWood.assertEquals(2)
	ledger.mountIron.assertEquals(10)
	ledger.mountDays.assertEquals(7)
	ledger.closeRange.assertEquals(300.)
	let treasury = f.campaign.countries.treasury[0]
	let wood = f.trade.markets[0].stock
	let iron = f.trade.markets[1].stock
	let start = f.clock.currentDay
	f.action("mount", " ship")
	f.campaign.countries.treasury[0].assertEquals(treasury - 200)
	f.trade.markets[0].stock.assertEquals(wood - 2)
	f.trade.markets[1].stock.assertEquals(iron - 10)
	f.clock.advanceTo(start + 6).assertTrue()
	f.military.forces[f.military.forceIndex("ship")].hull.carronades.assertFalse()
	let pending = f.military.snapshot()
	f.military.restore(pending).assertTrue()
	f.clock.advanceTo(start + 7).assertTrue()
	f.military.forces[f.military.forceIndex("ship")].hull.carronades.assertTrue()
	f.rpg.restoreState(f.rpg.captureState().replace("|u," + f.resources.owner + ",carronade_batteries", "")).assertTrue()
	f.rpg.technologies.reconstructAll()
	f.effects.rate(f.resources.owner, "close_range_naval_gunfire_damage").assertEquals(0)
	return f

function installedCarronadeHit(NavalFixture f, string attack, string nativeAttack) returns string
	let representations = new CombatRepresentations()
	f.military.adapter = representations
	f.military.activateRegion("europe_west")
	let identity = new PlayerCampaignIdentity()
	identity.restore("player", "player", "europe_west", "europe", "london")
	let events = new MilitaryCombatEvents(f.military, identity, f.rpg.management.pauses, new RecordingCombatNatives())
	events.install()
	let hit = new CombatHit(attack, new ExactRational("100", "1", "1"))
	let source = representations.representationId("ship")
	let target = representations.representationId("enemy")
	events.onWeaponDamage(events.generation, target, source, nativeAttack, hit).assertEquals(1)
	let result = hit.damage.display()
	let authority = f.military.snapshot()
	events.onWeaponDamage(events.generation, target, source, nativeAttack, hit).assertEquals(1)
	hit.damage.display().assertEquals(result)
	f.military.snapshot().assertEquals(authority)
	events.stop()
	destroy hit
	return result

@test function carronadeOnlyPaidMatchedVesselsUseInstalledAndAbstractDamage()
	let f = paidCarronadeControl(false, true)
	let control = paidCarronadeControl(false, true)
	f.authority().assertEquals(control.authority())
	f.hit(true).assertEquals("100")
	f.unlock("carronade_batteries")
	f.effects.rate("player", "close_range_naval_gunfire_damage").assertEquals(1000)
	f.effects.earned("player", "hull_repair_throughput").assertFalse()
	f.effects.earned("player", "voyage_hull_weather_resilience").assertFalse()
	f.effects.entitled("player", "ship_of_the_line").assertFalse()
	f.military.snapshot().assertEquals(control.military.snapshot())
	f.trade.capture().assertEquals(control.trade.capture())
	f.campaign.countries.treasury[0].assertEquals(control.campaign.countries.treasury[0])
	installedCarronadeHit(f, "naval_gunfire", "siege").assertEquals("110")
	installedCarronadeHit(control, "naval_gunfire", "siege").assertEquals("100")
	f.military.activateRegion("africa")
	control.military.activateRegion("africa")
	f.hit(true).assertEquals("110")
	control.hit(true).assertEquals("100")

@test function carronadeMountAndDamageRejectEachMissingQualification()
	let f = new NavalFixture(false, true)
	f.dock()
	let baseline = f.authority()
	f.runtime.act("player", "mount", "london", "ship").startsWith("Requires").assertTrue()
	f.authority().assertEquals(baseline)
	f.unlock("carronade_batteries")
	let ship = f.military.forces[f.military.forceIndex("ship")]
	let ledger = f.military.naval
	for condition = 0 to 6
		let first = ledger.mountFirstDay
		let originalProfile = ship.combatProfileId
		let rawcode = ship.unitTypeId
		let funds = f.campaign.countries.treasury[0]
		let wood = f.trade.markets[0].stock
		let iron = f.trade.markets[1].stock
		if condition == 0
			ledger.mountFirstDay = f.clock.currentDay + 1
		else if condition == 1
			ship.combatProfileId = "indigenous_war_canoe"
		else if condition == 2
			ship.unitTypeId = 'hfoo'
		else if condition == 3
			f.campaign.countries.treasury[0] = 199
		else if condition == 4
			f.trade.markets[0].stock = 1
		else if condition == 5
			f.trade.markets[1].stock = 9
		else
			ship.combatProfileId = "unknown"
		let before = f.authority()
		(f.runtime.act("player", "mount", "london", "ship") != "").assertTrue()
		f.authority().assertEquals(before)
		ledger.mountFirstDay = first
		ship.combatProfileId = originalProfile
		ship.unitTypeId = rawcode
		f.campaign.countries.treasury[0] = funds
		f.trade.markets[0].stock = wood
		f.trade.markets[1].stock = iron
	f.hit(true).assertEquals("100") // Research without equipment.
	f.action("mount", " ship")
	f.clock.advanceTo(f.clock.currentDay + 7).assertTrue()
	let enemy = f.military.forces[f.military.forceIndex("enemy")]
	for boundary = 0 to 2
		enemy.x = ship.x + 299.99 + boundary * 0.01
		if boundary < 2
			f.hit(true).assertEquals("110")
			installedCarronadeHit(f, "naval_gunfire", "siege").assertEquals("110")
		else
			f.hit(true).assertEquals("100")
			installedCarronadeHit(f, "naval_gunfire", "siege").assertEquals("100")
	enemy.x = ship.x + 300.
	installedCarronadeHit(f, "naval_gunfire", "").assertEquals("100")
	installedCarronadeHit(f, "naval_gunfire", "normal").assertEquals("100")
	installedCarronadeHit(f, "boarding", "siege").assertEquals("100")
	installedCarronadeHit(f, "spell", "siege").assertEquals("100")
	f.hit(false).assertEquals("100")
	let profile = ship.combatProfileId
	ship.combatProfileId = ""
	f.hit(true).assertEquals("100")
	ship.combatProfileId = "unknown"
	f.hit(true).assertEquals("100")
	ship.combatProfileId = "indigenous_war_canoe"
	f.hit(true).assertEquals("100")
	ship.combatProfileId = profile
	ship.unitTypeId = 'hfoo'
	f.hit(true).assertEquals("100")
	ship.unitTypeId = 'hbsh'
	ledger.mountFirstDay = f.clock.currentDay + 1
	f.hit(true).assertEquals("100")

@test function carronadeCaptureReconstructionAndMaintenanceUseCurrentAuthority()
	let f = paidCarronadeControl(false, true)
	f.unlock("carronade_batteries")
	let duplicate = new RuntimeTechnology("duplicate_carronade", "Duplicate source", 1780, 1)
	duplicate.addUnlock("duplicate_carronade", "modifier", "progression_carronade_batteries")
	f.rpg.technologies.register(duplicate).assertTrue()
	f.unlock("duplicate_carronade")
	let saved = f.military.snapshot()
	f.military.restore(saved).assertTrue()
	f.rpg.technologies.reconstructAll()
	f.rpg.technologies.reconstructAll()
	f.effects.rate("player", "close_range_naval_gunfire_damage").assertEquals(1000)
	f.hit(true).assertEquals("110")
	f.military.transferControl("ship", "ai", f.clock.currentDay)
	f.military.setWar("ai", "enemy", true)
	installedCarronadeHit(f, "naval_gunfire", "siege").assertEquals("100")
	f.resources.owner = "ai"
	f.rpg.restoreState(f.rpg.captureState() + "|u,ai,rated_warships").assertTrue()
	f.unlock("carronade_batteries")
	installedCarronadeHit(f, "naval_gunfire", "siege").assertEquals("110")
	let ship = f.military.forces[f.military.forceIndex("ship")]
	ship.hull.carronades.assertTrue()
	f.military.transferControl("ship", "player", f.clock.currentDay)
	f.resources.owner = "player"
	f.campaign.countries.treasury[0] = 0
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	ship.hull.maintained.assertFalse()
	f.hit(true).assertEquals("0")
	f.campaign.countries.treasury[0] = 10000
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	ship.hull.maintained.assertTrue()
	f.hit(true).assertEquals("110")
	let current = f.military.snapshot()
	let record = "|h,ship," + ship.hull.record()
	var legacy = current.replace("v22|", "v13|")
	for i = 0 to f.military.forceCount - 1
		let fleet = f.military.forces[i]
		if fleet.kind == FORCE_FLEET
			legacy = legacy.replace("|h," + fleet.id + "," + fleet.hull.record(), "")
	for i = 0 to f.military.naval.count - 1
		legacy = legacy.replace("|y," + f.military.naval.yards[i].id + "," + f.military.naval.states[i].record(), "")
	legacy.contains(record).assertFalse()
	f.military.restore(legacy).assertTrue()
	f.military.forces[f.military.forceIndex("ship")].hull.carronades.assertFalse()
	f.hit(true).assertEquals("100")
	f.military.restore(current).assertTrue()
	f.hit(true).assertEquals("110")

@test function carronadePlayerAiActiveAbstractAndAdditiveLayersPreserveUnboundedXp()
	for variant = 0 to 3
		let variantFixture = paidCarronadeControl(variant >= 2, variant mod 2 == 0)
		variantFixture.hit(true).assertEquals("100")
		variantFixture.unlock("carronade_batteries")
		variantFixture.hit(true).assertEquals("110")
	// Independent sources add before a single final calculation. Earned XP stays
	// an exact unbounded natural even when its rating exceeds native integers.
	let f = paidCarronadeControl(false, true)
	f.unlock("carronade_batteries")
	f.military.setRpgRuntime(f.rpg)
	f.commands.dispatch(Player(0), "/research water_powered_machinery").assertTrue()
	f.resources.output.assertEquals("Action completed.")
	f.unlock("cast_cannon")
	configureGeneratedMilitaryTraditions(f.military, true).assertTrue()
	let xp = "9007199254740993"
	f.military.awardTradition("player", "sailing_naval", xp)
	let ship = f.military.forces[f.military.forceIndex("ship")]
	let enemy = f.military.forces[f.military.forceIndex("enemy")]
	let layer = f.military.resolveTradition(ship)
	let sources = f.military.navalCombatSources(ship, enemy, true)
	let rating = f.military.combatBindings.rating(layer, f.military.combatProfile(ship), "naval_gunfire", "damage")
	// Cast Cannon 500, Carronades 1000, independent doctrine/refit 300/200.
	let expected = new ExactRational("12000", "1", "1")
	expected.add(rating)
	expected.multiply(new ExactRational("1", "1", "100"))
	sources.replace("doctrine:fixture", "naval_gunfire", "damage", new ExactRational("300", "1", "1"))
	sources.replace("refit:fixture", "naval_gunfire", "damage", new ExactRational("200", "1", "1"))
	sources.replace("refit:fixture", "naval_gunfire", "damage", new ExactRational("200", "1", "1"))
	let hit = new CombatHit("naval_gunfire", new ExactRational("100", "1", "1"))
	f.military.combatBindings.applyForCombatants(hit, true, layer, f.military.combatProfile(ship), null, f.military.combatProfile(enemy), sources, null, "player", "sailing_naval", "enemy", "sailing_naval")
	hit.damage.display().assertEquals(expected.display())
	let active = installedCarronadeHit(f, "naval_gunfire", "siege")
	f.military.activateRegion("africa")
	f.hit(true).assertEquals(active)
	f.military.traditions[f.military.traditionIndex("player", "sailing_naval")].experience.assertEquals(xp)
	let saved = f.military.snapshot()
	f.military.restore(saved).assertTrue()
	f.military.traditions[f.military.traditionIndex("player", "sailing_naval")].experience.assertEquals(xp)
	f.hit(true).assertEquals(active)
	destroy hit
	destroy sources
	destroy layer
	destroy rating
	destroy expected

@test function carronadeLateLoadRollbackRestoresResearchMountWorkAndResources()
	let f = new LoadFixture()
	let effects = new NavalResearchEffects(f.rpg.technologies.effects)
	f.rpg.technologies.effects = effects
	f.military.setRpgRuntime(f.rpg)
	f.military.navalResearch = effects
	f.military.combatBindings = createGeneratedCombatBindings()
	configureGeneratedNaval(f.military.naval, effects)
	let d = f.military.naval.yards[0]
	d.id = "port"
	d.mapId = "europe_west"
	d.prerequisite = "carronade_batteries"
	f.military.naval.mountFirstDay = 0
	f.military.naval.states[0].ready = 1
	f.military.naval.states[0].lastDay = f.clock.currentDay
	f.military.appoint("port", new AdministratorState("clerk", "Clerk", "Administrator", "england", "europe_west", "port", 50, 50, 40, 1))
	let ship = f.military.forces[f.military.forceIndex("fleet")]
	ship.unitTypeId = d.unitTypeId
	ship.combatProfileId = d.profileId
	ship.categoryId = "sailing_naval"
	ship.x = d.x
	ship.y = d.y
	ship.hull.lastDay = f.clock.currentDay
	f.campaign.countries.treasury[0] = 100000
	f.extension.trade.registerMarket(new RuntimeMarket("port", "timber", 10000, 100000, 10, 10))
	f.extension.trade.registerMarket(new RuntimeMarket("port", "iron", 10000, 100000, 10, 10))
	f.extension.trade.registerMarket(new RuntimeMarket("port", "ship_provisions", 10000, 100000, 10, 10))
	let technology = new RuntimeTechnology("carronade_batteries", "Carronade Batteries", 1, 1)
	technology.addUnlock("carronade_batteries", "modifier", "progression_carronade_batteries")
	f.rpg.technologies.register(technology).assertTrue()
	let runtime = new NavalCampaignRuntime(f.campaign.state, f.extension.trade, effects)
	f.campaign.state.navalRuntime = runtime
	let savedClock = f.clock.captureState()
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "before mounts").assertTrue()
	f.rpg.research("england", "carronade_batteries", 1, 1).assertTrue()
	runtime.act("england", "mount", "port", "fleet").assertEquals("")
	f.clock.advanceTo(f.clock.currentDay + 6).assertTrue()
	f.military.naval.states[0].work.assertEquals(6)
	let partial = f.military.snapshot()
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.military.forces[f.military.forceIndex("fleet")].hull.carronades.assertTrue()
	let completed = f.military.snapshot()
	let research = f.rpg.captureState()
	let stocks = f.extension.trade.capture()
	let treasury = f.campaign.countries.treasury[0]
	f.recordingTimer.expected = f.clock.captureState()
	f.extension.fail = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.military.snapshot().assertEquals(completed)
	f.rpg.captureState().assertEquals(research)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	effects.rate("england", "close_range_naval_gunfire_damage").assertEquals(1000)
	f.military.restore(partial).assertTrue()
	f.military.naval.states[0].work.assertEquals(6)
	f.military.forces[f.military.forceIndex("fleet")].hull.carronades.assertFalse()
	runtime.advance(f.clock.currentDay)
	f.military.forces[f.military.forceIndex("fleet")].hull.carronades.assertTrue()
	f.extension.fail = false
	f.recordingTimer.expected = ""
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertTrue()
	f.clock.captureState().assertEquals(savedClock)
	f.military.forces[f.military.forceIndex("fleet")].hull.carronades.assertFalse()
	effects.rate("england", "close_range_naval_gunfire_damage").assertEquals(0)
