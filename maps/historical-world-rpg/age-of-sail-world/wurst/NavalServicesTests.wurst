@test function navalNegativeConditionsRejectWithoutPaymentAndSaveMigrationAndLateRollbackAreAtomic()
	let f = new NavalFixture(false, true)
	f.dock()
	let paid = f.campaign.countries.treasury[0]
	f.runtime.act("ai", "board", "london", "").startsWith("Requires").assertTrue()
	f.runtime.act("player", "build", "london", "").startsWith("Requires").assertTrue()
	f.runtime.act("player", "mount", "london", "ship").startsWith("Requires").assertTrue()
	f.campaign.countries.treasury[0].assertEquals(paid)
	f.allResearch()
	f.trade.markets[0].blockaded = true
	f.runtime.act("player", "board", "london", "").startsWith("Requires").assertTrue()
	f.trade.markets[0].blockaded = false
	f.military.forces[f.military.forceIndex("ship")].x += 256.
	f.runtime.act("player", "repair", "london", "ship").startsWith("Requires").assertTrue()
	f.military.forces[f.military.forceIndex("ship")].x -= 256.
	f.military.forces[f.military.forceIndex("ship")].hull.integrity = 5000
	f.trade.markets[0].stock = 0
	f.runtime.act("player", "repair", "london", "ship").startsWith("Treasury").assertTrue()
	f.trade.markets[0].stock = 10000
	f.action("repair", " ship")
	f.clock.advanceTo(f.day + 93).assertTrue()
	let saved = f.military.snapshot()
	f.military.restore(saved + "|y,unknown,0,,,,,0,0,0").assertFalse()
	f.military.snapshot().assertEquals(saved)
	f.military.validateSnapshot(saved, f.day + 92).assertFalse()
	f.military.restore(saved).assertTrue()
	f.military.snapshot().assertEquals(saved)
	var legacy = saved.replace("v22|", "v12|")
	for i = 0 to f.military.naval.count - 1
		legacy = legacy.replace("|y," + f.military.naval.yards[i].id + "," + f.military.naval.states[i].record(), "")
	f.military.restore(legacy).assertTrue()
	f.military.naval.states[0].ready.assertEquals(0)
	let load = new LoadFixture()
	configureGeneratedNaval(load.military.naval, f.effects)
	load.military.naval.states[0].ready = 10
	load.military.naval.states[0].lastDay = 10
	load.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "naval").assertTrue()
	load.military.naval.states[0].ready = 20
	load.military.naval.states[0].lastDay = 20
	let before = load.military.snapshot()
	load.extension.fail = true
	load.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	load.military.snapshot().assertEquals(before)

@test function paidCarronadesUseInstalledProductionWeaponCallbacksAndRejectStaleAndIncompatibleHits()
	let f = new NavalFixture(true, true)
	f.allResearch()
	f.dock()
	f.action("mount", " ship")
	f.clock.advanceTo(f.day + 97).assertTrue()
	let representations = new CombatRepresentations()
	f.military.adapter = representations
	f.military.activateRegion("europe_west")
	let natives = new RecordingCombatNatives()
	let identity = new PlayerCampaignIdentity()
	let events = new MilitaryCombatEvents(f.military, identity, f.rpg.management.pauses, natives)
	events.install()
	let hit = new CombatHit("naval_gunfire", new ExactRational("100", "1", "1"))
	events.onWeaponDamage(events.generation, representations.representationId("enemy"), representations.representationId("ship"), "siege", hit).assertEquals(1)
	hit.damage.display().assertEquals("110")
	events.onWeaponDamage(events.generation, representations.representationId("enemy"), representations.representationId("ship"), "siege", hit).assertEquals(1)
	hit.damage.display().assertEquals("110")
	let invalid = new CombatHit("naval_gunfire", new ExactRational("100", "1", "1"))
	events.onWeaponDamage(events.generation, representations.representationId("enemy"), representations.representationId("ship"), "normal", invalid).assertEquals(1)
	invalid.damage.display().assertEquals("100")
	events.onWeaponDamage(events.generation - 1, representations.representationId("enemy"), representations.representationId("ship"), "siege", invalid).assertEquals(-1)
	events.stop()

@test function navalSourcesReconstructOnceAndLongCampaignFractionsConserveActualHullInputs()
	let f = new NavalFixture(true, false)
	f.allResearch()
	let duplicate = new RuntimeTechnology("duplicate_naval", "Duplicate naval", 1450, 1)
	duplicate.addUnlock("duplicate_naval", "modifier", "progression_careening_stations")
	f.rpg.technologies.register(duplicate).assertTrue()
	f.unlock("duplicate_naval")
	f.rpg.technologies.reconstructAll()
	f.rpg.technologies.reconstructAll()
	f.effects.rate("ai", "hull_repair_throughput").assertEquals(1500)
	f.effects.rate("player", "hull_repair_throughput").assertEquals(0)
	let hull = new NavalHull()
	hull.integrity = 1
	for i = 0 to 99
		hull.repair(1, 1500)
	hull.integrity.assertEquals(116)
	// 50 years of bounded weekly weather exposure and paid repair inputs.
	// Each avoidance is limited to actual damage; maintenance never mints hulls.
	for i = 0 to 2599
		hull.integrity = 10000
		hull.weather(10, 800)
		(hull.integrity >= 9990 and hull.integrity <= 9991).assertTrue()
		hull.repair(10, 1500)
		hull.integrity.assertEquals(10000)

