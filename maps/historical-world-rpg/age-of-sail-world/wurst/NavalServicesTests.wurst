@test function carvelVoyagesLateLoadRollbackRestoresHullGearResearchAndResources()
	let f = new LoadFixture()
	let effects = new NavalResearchEffects(f.rpg.technologies.effects)
	f.rpg.technologies.effects = effects
	f.military.setRpgRuntime(f.rpg)
	f.military.navalResearch = effects
	f.military.combatBindings = createGeneratedCombatBindings()
	configureGeneratedNaval(f.military.naval, effects)
	let d = f.military.naval.yards[0]
	d.id = "port"
	d.mapId = "europe_west"
	d.x = 40.
	d.y = 50.
	d.prerequisite = "carvel_hull_construction"
	d.profileId = "armed_sailing_warship"
	f.military.naval.carvelFirstDay = 1 // Bounded transaction fixture calendar.
	f.military.naval.states[0].ready = 1
	f.military.naval.states[0].lastDay = f.clock.currentDay
	let fleet = f.military.forces[f.military.forceIndex("fleet")]
	fleet.unitTypeId = d.unitTypeId
	fleet.combatProfileId = d.profileId
	fleet.hull.lastDay = f.clock.currentDay
	fleet.supply = 1000
	f.military.appoint("port", new AdministratorState("clerk", "Clerk", "Administrator", "england", "europe_west", "port", 50, 50, 40, 1))
	for i = 0 to 2
		var good = "timber"
		if i == 1
			good = "iron"
		else if i == 2
			good = "ship_provisions"
		f.extension.trade.registerMarket(new RuntimeMarket("port", good, 10000, 100000, 10, 10))
	let technology = new RuntimeTechnology("carvel_hull_construction", "Carvel Hull Construction", 1, 1)
	technology.addUnlock("carvel_hull_construction", "modifier", "progression_carvel_hull_construction")
	f.rpg.technologies.register(technology).assertTrue()
	let runtime = new NavalCampaignRuntime(f.campaign.state, f.extension.trade, effects)
	f.campaign.state.navalRuntime = runtime
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "before carvel").assertTrue()
	f.rpg.research("england", "carvel_hull_construction", 1, 1).assertTrue()
	runtime.act("england", "carvel", "port", "fleet").assertEquals("")
	f.clock.advanceTo(f.clock.currentDay + 30).assertTrue()
	f.military.voyages = createGeneratedVoyageContract()
	f.military.naval.stormLoss = 1
	f.military.startVoyage("fleet", f.military.voyages.routes.id, "england", f.clock.currentDay, true).assertTrue()
	f.clock.advanceTo(f.clock.currentDay + 5).assertTrue()
	f.military.forces[f.military.forceIndex("fleet")].hull.carvel.assertTrue()
	f.military.forces[f.military.forceIndex("fleet")].hull.weatherCredit.assertEquals(1600)
	let before = f.military.snapshot()
	let research = f.rpg.captureState()
	let stocks = f.extension.trade.capture()
	let treasury = f.campaign.countries.treasury[0]
	f.recordingTimer.expected = f.clock.captureState()
	f.extension.fail = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.extension.applications.assertEquals(1)
	f.military.snapshot().assertEquals(before)
	f.rpg.captureState().assertEquals(research)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	effects.rate("england", "voyage_hull_weather_resilience").assertEquals(800)
	effects.rate("portugal", "voyage_hull_weather_resilience").assertEquals(0)
	runtime.advance(f.clock.currentDay)
	f.military.snapshot().assertEquals(before)

