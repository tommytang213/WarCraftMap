public class NavalTestResources implements ResearchCommandResources, CommandOutput
	string owner = "player"
	int balance = 100000
	string output = ""
	override function controllerId(player sender) returns string
		return owner
	override function year() returns int
		return 1787
	override function gold(player sender) returns int
		return balance
	override function setGold(player sender, int amount)
		balance = amount
	override function show(player recipient, string message)
		output = message

public class NavalFixture
	int day = 652436 // 1787; all physical gear eras are open.
	NavalTestResources resources = new NavalTestResources()
	NavalResearchEffects effects = new NavalResearchEffects(new UnboundResearchEffects())
	WarcraftRpgRuntime rpg = new WarcraftRpgRuntime(effects)
	MilitarySettlementRuntime military = new MilitarySettlementRuntime(new RecordingMilitaryAdapter())
	CampaignClock clock = new CampaignClock(529237, 700000, day, 1.)
	PlayableCampaignState campaign = new PlayableCampaignState(null, clock)
	PlayableTradeRuntime trade = new PlayableTradeRuntime()
	NavalCampaignRuntime runtime
	CommandRegistry commands = new CommandRegistry(false, 8, new CommandText(), resources)
	construct(boolean ai, boolean active)
		if ai
			resources.owner = "ai"
		let generated = new WarcraftRpgRuntime(effects)
		configureGeneratedRpg(generated)
		rpg.technologies = generated.technologies
		rpg.researchResources = resources
		rpg.management.pauses = new ManagementScreenPauseController(new RecordingManagementPorts(), false)
		configureGeneratedNaval(military.naval, effects)
		military.combatBindings = createGeneratedCombatBindings()
		military.voyages = createGeneratedVoyageContract()
		military.navalResearch = effects
		let d = military.naval.yards[0]
		military.registerSettlement(new SettlementRuntimeState(d.id, resources.owner, d.mapId, 'htow', 'hfoo', 30, 20, 10000, 10000, 0., 0.))
		military.appoint(d.id, new AdministratorState("clerk", "Clerk", "Administrator", resources.owner, d.mapId, d.id, 50, 50, 40, 1))
		let ship = new RuntimeForce("ship", resources.owner, d.mapId, "sailing_naval", FORCE_FLEET, d.unitTypeId, 1050, 10000, d.x, d.y)
		ship.combatProfileId = d.profileId
		ship.hull.lastDay = day
		military.registerForce(ship)
		let enemy = new RuntimeForce("enemy", "enemy", d.mapId, "sailing_naval", FORCE_FLEET, d.unitTypeId, 1050, 10000, d.x + 300., d.y)
		enemy.combatProfileId = d.profileId
		military.registerForce(enemy)
		military.setWar(resources.owner, "enemy", true)
		campaign.setMilitarySettlementRuntime(military)
		campaign.setRpgRuntime(rpg)
		military.setRpgRuntime(rpg)
		campaign.setCountryRuntime(new PlayableCountryInteractionRuntime(null))
		campaign.countries.registerPolity(resources.owner, 100000)
		trade.registerMarket(new RuntimeMarket(d.id, "timber", 10000, 100000, 10, 10))
		trade.registerMarket(new RuntimeMarket(d.id, "iron", 10000, 100000, 10, 10))
		trade.registerMarket(new RuntimeMarket(d.id, "ship_provisions", 10000, 100000, 10, 10))
		runtime = new NavalCampaignRuntime(campaign, trade, effects)
		campaign.navalRuntime = runtime
		registerRpgRuntimeCommands(commands, rpg).assertEquals("")
		registerNavalCommands(commands, runtime).assertEquals("")
		registerVoyageCommands(commands, campaign).assertEquals("")
		campaign.knowledge.revealRegion("europe")
		if active
			military.activateRegion(d.mapId)
		else
			military.activateRegion("africa")
		let owner = resources.owner
		rpg.restoreState(rpg.captureState() + "|u," + owner + ",dockyard_logistics|u," + owner + ",galleon_design|u," + owner + ",naval_gunnery|u," + owner + ",public_credit|u," + owner + ",copper_sheathing|u," + owner + ",oceanic_seamanship|u," + owner + ",rated_warships").assertTrue()
		rpg.technologies.reconstructAll()
	function unlock(string id)
		commands.dispatch(Player(0), "/research " + id).assertTrue()
		resources.output.assertEquals("Action completed.")
		let definition = rpg.technologies.get(id)
		for i = 0 to definition.unlockCount - 1
			rpg.technologies.bindingStatus(definition.unlocks[i]).assertEquals(RESEARCH_BOUND)
	function action(string verb, string target)
		commands.dispatch(Player(0), "/naval " + verb + " london" + target).assertTrue()
		resources.output.assertEquals("Naval action completed.")
	function dock()
		action("dock", "")
		clock.advanceTo(day + 90).assertTrue()
	function allResearch()
		unlock("battlefleet_doctrine")
		unlock("careening_stations")
		unlock("carronade_batteries")
		unlock("carvel_hull_construction")
	function commissioningReady()
		action("dock", "")
		clock.advanceTo(day + military.naval.dockDays).assertTrue()
		action("board", "")
		clock.advanceTo(day + military.naval.dockDays + military.naval.boardDays).assertTrue()
	function authority() returns string
		return military.snapshot() + "#" + rpg.captureState() + "#" + trade.capture() + "#" + I2S(campaign.countries.treasury[0]) + "#" + I2S(resources.balance)
	function rejectedBuild()
		let before = authority()
		commands.dispatch(Player(0), "/naval build london").assertTrue()
		(resources.output != "Naval action completed.").assertTrue()
		authority().assertEquals(before)
	function rejectedRepair()
		let before = authority()
		commands.dispatch(Player(0), "/naval repair london ship").assertTrue()
		(resources.output != "Naval action completed.").assertTrue()
		authority().assertEquals(before)
	function rejectedCarvel()
		let before = authority()
		commands.dispatch(Player(0), "/naval carvel london ship").assertTrue()
		(resources.output != "Naval action completed.").assertTrue()
		authority().assertEquals(before)
	function recipient() returns RuntimeForce
		return military.forces[military.forceIndex("ship")]
	function voyage(boolean success)
		commands.dispatch(Player(0), "/voyage ship " + military.voyages.routes.id).assertTrue()
		if success
			resources.output.assertEquals("Voyage action completed.")
		else
			resources.output.assertEquals("Voyage requirements are not met.")
	/** Select another generated hull in the bounded station fixture. Route,
	 * provision reservation and maintenance still use production authority. */
	function useProfile(string id)
		var profile = military.naval.profiles
		while profile != null and profile.id != id
			profile = profile.next
		(profile != null).assertTrue()
		recipient().combatProfileId = profile.id
		recipient().unitTypeId = profile.unitTypeId
		military.naval.yards[0].profileId = profile.id
		military.naval.yards[0].unitTypeId = profile.unitTypeId
	function beginRepair()
		let money = campaign.countries.treasury[0]
		let wood = trade.markets[0].stock
		let food = trade.markets[2].stock
		let supply = military.settlements[0].supply
		let integrity = recipient().hull.integrity
		action("repair", " ship")
		campaign.countries.treasury[0].assertEquals(money - 2)
		trade.markets[0].stock.assertEquals(wood - 1)
		trade.markets[2].stock.assertEquals(food - 1)
		military.settlements[0].supply.assertEquals(supply - 1)
		recipient().hull.integrity.assertEquals(integrity)
	function repairDay(int gain, boolean prepaid)
		let ship = recipient()
		let integrity = ship.hull.integrity
		let money = campaign.countries.treasury[0]
		let maintenance = (ship.hull.upkeepCredit + military.naval.yards[0].upkeep) div 30
		let provisions = ship.supply
		let wood = trade.markets[0].stock
		let food = trade.markets[2].stock
		let supply = military.settlements[0].supply
		var bill = 1
		if prepaid
			bill = 0
		clock.advanceTo(clock.currentDay + 1).assertTrue()
		ship.hull.integrity.assertEquals(integrity + gain)
		campaign.countries.treasury[0].assertEquals(money - maintenance - 2 * bill)
		ship.supply.assertEquals(provisions - 1)
		ship.hull.maintained.assertTrue()
		trade.markets[0].stock.assertEquals(wood - bill)
		trade.markets[2].stock.assertEquals(food - bill)
		military.settlements[0].supply.assertEquals(supply - bill)
	function hit(boolean weapon) returns string
		let h = new CombatHit("naval_gunfire", new ExactRational("100", "1", "1"))
		military.applyCombatHit(h, military.forceIndex("ship"), military.forceIndex("enemy"), resources.owner, "enemy", weapon)
		let result = h.damage.display()
		military.applyCombatHit(h, military.forceIndex("ship"), military.forceIndex("enemy"), resources.owner, "enemy", weapon)
		h.damage.display().assertEquals(result)
		destroy h
		return result

@test function careeningOnlyRegisteredRepairsChargeEachDayAgainstMatchedControl()
	let f = new NavalFixture(false, true)
	let control = new NavalFixture(false, true)
	f.authority().assertEquals(control.authority())
	f.dock()
	control.dock()
	f.authority().assertEquals(control.authority())
	f.unlock("careening_stations")
	f.effects.rate("player", "hull_repair_throughput").assertEquals(1500)
	control.effects.rate("player", "hull_repair_throughput").assertEquals(0)
	f.effects.entitled("player", "ship_of_the_line").assertFalse()
	f.effects.earned("player", "close_range_naval_gunfire_damage").assertFalse()
	f.effects.earned("player", "voyage_hull_weather_resilience").assertFalse()
	f.recipient().hull.integrity = 5000
	control.recipient().hull.integrity = 5000
	f.beginRepair()
	control.beginRepair()
	for day = 0 to 9
		f.repairDay(115, day == 0)
		control.repairDay(100, day == 0)
		// Reconstruct and restore in the isolated comparison itself. Repeated
		// calendar delivery must preserve both output and the complete bill.
		let saved = f.military.snapshot()
		f.military.restore(saved).assertTrue()
		f.rpg.technologies.reconstructAll()
		f.rpg.technologies.reconstructAll()
		let before = f.authority()
		f.runtime.advance(f.clock.currentDay)
		f.runtime.advance(f.clock.currentDay)
		f.authority().assertEquals(before)
	f.recipient().hull.integrity.assertEquals(6150)
	control.recipient().hull.integrity.assertEquals(6000)
	f.trade.capture().assertEquals(control.trade.capture())
	f.campaign.countries.treasury[0].assertEquals(control.campaign.countries.treasury[0])
	f.military.forceCount.assertEquals(control.military.forceCount)

@test function careeningRepairsBoundFullHullAndPreserveLegacyHullFractions()
	let f = new NavalFixture(false, false)
	f.unlock("careening_stations")
	f.dock()
	f.rejectedRepair() // Full hull cannot prepay another day.
	f.recipient().hull.integrity = 9999
	f.recipient().hull.repairCredit = 9999
	f.beginRepair()
	f.repairDay(1, true)
	f.recipient().hull.repairCredit.assertEquals(0)
	f.military.naval.states[0].job.assertEquals("")
	let saved = f.military.snapshot()
	f.military.restore(saved).assertTrue()
	f.repairDay(0, true) // Only independent maintenance is charged now.
	f.rejectedRepair()
	// A supported Warcraft hull with unknown legacy armament stays repairable.
	// Lower base output only here to expose fractional accounting every day.
	f.recipient().combatProfileId = ""
	f.recipient().hull.integrity = 5000
	f.military.naval.repairOutput = 1
	f.beginRepair()
	f.clock.advanceTo(f.clock.currentDay + 3).assertTrue()
	f.recipient().hull.integrity.assertEquals(5003)
	f.recipient().hull.repairCredit.assertEquals(4500)
	let fractional = f.military.snapshot()
	f.military.restore(fractional).assertTrue()
	f.rpg.technologies.reconstructAll()
	f.runtime.advance(f.clock.currentDay)
	f.military.snapshot().assertEquals(fractional)
	f.clock.advanceTo(f.clock.currentDay + 7).assertTrue()
	f.recipient().hull.integrity.assertEquals(5011)
	f.recipient().hull.repairCredit.assertEquals(5000)
	f.recipient().combatProfileId.assertEquals("")
	f.recipient().hull.carronades.assertFalse()

@test function careeningRepairsRejectMissingInputsAndInaccessibleRecipientsWithoutMutation()
	let f = new NavalFixture(false, false)
	f.unlock("careening_stations")
	f.recipient().hull.integrity = 5000
	f.rejectedRepair() // No free dock from research.
	f.dock()
	let state = f.military.naval.states[0]
	let ready = state.ready
	state.ready = f.clock.currentDay + 1
	f.rejectedRepair()
	state.ready = ready
	let money = f.campaign.countries.treasury[0]
	f.campaign.countries.treasury[0] = 1
	f.rejectedRepair()
	f.campaign.countries.treasury[0] = money
	let supply = f.military.settlements[0].supply
	f.military.settlements[0].supply = 0
	f.rejectedRepair()
	f.military.settlements[0].supply = supply
	for i = 0 to 2
		if i != 1 // Iron is access infrastructure, not a repair input.
			let stock = f.trade.markets[i].stock
			f.trade.markets[i].stock = 0
			f.rejectedRepair()
			f.trade.markets[i].stock = stock
		f.trade.markets[i].blockaded = true
		f.rejectedRepair()
		f.trade.markets[i].blockaded = false
		f.trade.markets[i].occupiedByHostile = true
		f.rejectedRepair()
		f.trade.markets[i].occupiedByHostile = false
	f.military.settlements[0].underAttack = true
	f.rejectedRepair()
	f.military.settlements[0].underAttack = false
	f.military.settlements[0].occupationConflictId = "hostile"
	f.rejectedRepair()
	f.military.settlements[0].occupationConflictId = ""
	let ship = f.recipient()
	ship.controllerId = "ai"
	f.rejectedRepair()
	ship.controllerId = "player"
	ship.x += 129.
	f.rejectedRepair()
	ship.x -= 129.
	ship.regionId = "africa"
	f.rejectedRepair()
	ship.regionId = f.military.naval.yards[0].mapId
	ship.active = false
	f.rejectedRepair()
	ship.active = true
	ship.unitTypeId = 'hfoo'
	f.rejectedRepair()
	ship.unitTypeId = f.military.naval.yards[0].unitTypeId
	f.military.startVoyage("ship", f.military.voyages.routes.id, "player", f.clock.currentDay, true).assertTrue()
	f.rejectedRepair()

@test function careeningRepairsSuspendUnfundedDaysAndCancelOnLostAccess()
	for condition = 0 to 4
		let f = new NavalFixture(false, false)
		f.unlock("careening_stations")
		f.dock()
		f.recipient().hull.integrity = 5000
		f.beginRepair()
		f.repairDay(115, true)
		if condition == 0
			f.campaign.countries.treasury[0] = 0
		else if condition == 1
			f.trade.markets[0].stock = 0
		else if condition == 2
			f.trade.markets[2].stock = 0
		else if condition == 3
			f.military.settlements[0].supply = 0
		else
			f.trade.markets[0].blockaded = true
		let stock = f.trade.capture()
		let supply = f.military.settlements[0].supply
		let treasury = f.campaign.countries.treasury[0]
		let maintenance = (f.recipient().hull.upkeepCredit + 2 * f.military.naval.yards[0].upkeep) div 30
		f.clock.advanceTo(f.clock.currentDay + 2).assertTrue()
		f.recipient().hull.integrity.assertEquals(5115)
		f.trade.capture().assertEquals(stock)
		f.military.settlements[0].supply.assertEquals(supply)
		if condition == 0
			f.campaign.countries.treasury[0].assertEquals(0)
		else
			f.campaign.countries.treasury[0].assertEquals(treasury - maintenance)
		if condition == 4
			f.military.naval.states[0].job.assertEquals("")
		else
			f.military.naval.states[0].job.assertEquals("repair")
		f.campaign.countries.treasury[0] = 10000
		f.trade.markets[0].stock = 10000
		f.trade.markets[2].stock = 10000
		f.military.settlements[0].supply = 10000
		f.trade.markets[0].blockaded = false
		if condition == 4
			f.beginRepair()
		f.repairDay(115, condition == 4) // No catch-up for unfunded days.

@test function careeningRepairsCaptureAndControllerTransferCancelPaidWork()
	let f = new NavalFixture(false, false)
	f.unlock("careening_stations")
	f.dock()
	f.recipient().hull.integrity = 5000
	f.recipient().hull.repairCredit = 4500
	f.beginRepair()
	let stocks = f.trade.capture()
	f.military.transferControl("ship", "ai", f.clock.currentDay)
	f.military.naval.states[0].job.assertEquals("")
	f.recipient().hull.repairCredit.assertEquals(0)
	f.effects.rate("ai", "hull_repair_throughput").assertEquals(0)
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.recipient().hull.integrity.assertEquals(5000)
	f.trade.capture().assertEquals(stocks)
	f.military.transferControl("ship", "player", f.clock.currentDay)
	f.beginRepair()
	f.military.transferSettlement("london", "ai")
	f.military.naval.states[0].job.assertEquals("")
	(f.military.naval.states[0].ready > 0).assertTrue()
	let captured = f.military.snapshot()
	f.military.restore(captured).assertTrue()
	f.rpg.technologies.reconstructAll()
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.recipient().hull.integrity.assertEquals(5000)
	f.rejectedRepair()

@test function careeningRepairsPlayerAiAndActiveInactiveUseIdenticalAuthority()
	var expected = ""
	for variant = 0 to 3
		let f = new NavalFixture(variant >= 2, variant mod 2 == 0)
		f.unlock("careening_stations")
		f.dock()
		f.recipient().hull.integrity = 5000
		f.beginRepair()
		for day = 0 to 9
			f.repairDay(115, day == 0)
		let saved = f.military.snapshot()
		f.military.restore(saved).assertTrue()
		f.rpg.technologies.reconstructAll()
		f.runtime.advance(f.clock.currentDay)
		f.military.snapshot().assertEquals(saved)
		let outcome = I2S(f.campaign.countries.treasury[0]) + "#" + I2S(f.military.settlements[0].supply) + "#" + f.trade.capture() + "#" + f.recipient().hull.record()
		if variant == 0
			expected = outcome
		else
			outcome.assertEquals(expected)

@test function careeningRepairsLateLoadRollbackRestoresPaidWorkAndResources()
	let f = new LoadFixture()
	let effects = new NavalResearchEffects(f.rpg.technologies.effects)
	f.rpg.technologies.effects = effects
	f.military.setRpgRuntime(f.rpg)
	f.military.navalResearch = effects
	configureGeneratedNaval(f.military.naval, effects)
	let d = f.military.naval.yards[0]
	d.id = "port"
	d.mapId = "europe_west"
	d.x = 40.
	d.y = 50.
	d.prerequisite = "careening_stations"
	f.military.naval.states[0].ready = 1
	f.military.naval.states[0].lastDay = f.clock.currentDay
	f.military.forces[f.military.forceIndex("fleet")].unitTypeId = d.unitTypeId
	f.military.forces[f.military.forceIndex("fleet")].hull.integrity = 5000
	f.military.forces[f.military.forceIndex("fleet")].hull.repairCredit = 4500
	f.military.forces[f.military.forceIndex("fleet")].hull.lastDay = f.clock.currentDay
	f.military.appoint("port", new AdministratorState("clerk", "Clerk", "Administrator", "england", "europe_west", "port", 50, 50, 40, 1))
	for i = 0 to 2
		var good = "timber"
		if i == 1
			good = "iron"
		else if i == 2
			good = "ship_provisions"
		f.extension.trade.registerMarket(new RuntimeMarket("port", good, 10000, 100000, 10, 10))
	let technology = new RuntimeTechnology("careening_stations", "Careening Stations", 1, 1)
	technology.addUnlock("careening_stations", "modifier", "progression_careening_stations")
	f.rpg.technologies.register(technology).assertTrue()
	let runtime = new NavalCampaignRuntime(f.campaign.state, f.extension.trade, effects)
	f.campaign.state.navalRuntime = runtime
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "before careening").assertTrue()
	f.rpg.research("england", "careening_stations", 1, 1).assertTrue()
	runtime.act("england", "repair", "port", "fleet").assertEquals("")
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.military.forces[f.military.forceIndex("fleet")].hull.integrity.assertEquals(5115)
	// Keep a prepaid day in the live state, as well as repaired hull/fractions.
	runtime.act("england", "stop", "port", "").assertEquals("")
	runtime.act("england", "repair", "port", "fleet").assertEquals("")
	let before = f.military.snapshot()
	let research = f.rpg.captureState()
	let stocks = f.extension.trade.capture()
	let treasury = f.campaign.countries.treasury[0]
	f.recordingTimer.expected = f.clock.captureState()
	f.extension.fail = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.extension.applications.assertEquals(1)
	f.military.snapshot().assertEquals(before)
	f.rpg.captureState().assertEquals(research)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	effects.rate("england", "hull_repair_throughput").assertEquals(1500)
	runtime.advance(f.clock.currentDay)
	f.military.snapshot().assertEquals(before)

@test function doctrineOnlyRegisteredCommissioningRequiresPaidWorkAgainstMatchedControl()
	let f = new NavalFixture(false, true)
	let control = new NavalFixture(false, true)
	f.authority().assertEquals(control.authority())
	f.commissioningReady()
	control.commissioningReady()
	let before = f.military.forceCount
	f.unlock("battlefleet_doctrine")
	f.military.forceCount.assertEquals(before)
	f.effects.earned("player", "hull_repair_throughput").assertFalse()
	f.effects.earned("player", "close_range_naval_gunfire_damage").assertFalse()
	f.effects.earned("player", "voyage_hull_weather_resilience").assertFalse()
	control.rejectedBuild()
	let d = f.military.naval.yards[0]
	let ledger = f.military.naval
	let buildDays = ledger.buildDays
	let city = f.military.settlements[0]
	let treasury = f.campaign.countries.treasury[0]
	let crew = city.manpower
	let supply = city.supply
	let wood = f.trade.markets[0].stock
	let iron = f.trade.markets[1].stock
	let food = f.trade.markets[2].stock
	let start = f.clock.currentDay
	f.action("build", "")
	f.campaign.countries.treasury[0].assertEquals(treasury - d.price)
	city.manpower.assertEquals(crew - d.crew)
	city.supply.assertEquals(supply - d.supply)
	f.trade.markets[0].stock.assertEquals(wood - ledger.buildWood)
	f.trade.markets[1].stock.assertEquals(iron - ledger.buildIron)
	f.trade.markets[2].stock.assertEquals(food - d.supply)
	f.military.forceCount.assertEquals(before)
	f.rejectedBuild()
	f.clock.advanceTo(start + buildDays - 1).assertTrue()
	f.military.forceCount.assertEquals(before)
	f.military.naval.states[0].work.assertEquals(buildDays - 1)
	let pending = f.military.snapshot()
	f.military.restore(pending).assertTrue()
	f.rpg.technologies.reconstructAll()
	f.rpg.technologies.reconstructAll()
	f.clock.advanceTo(start + buildDays).assertTrue()
	f.military.forceCount.assertEquals(before + 1)
	let ship = f.military.forces[before]
	ship.combatProfileId.assertEquals(d.profileId)
	ship.unitTypeId.assertEquals(d.unitTypeId)
	ship.strength.assertEquals(d.strength)
	ship.supply.assertEquals(d.supply)
	let completed = f.military.snapshot()
	f.military.restore(completed).assertTrue()
	f.runtime.advance(f.clock.currentDay)
	f.runtime.advance(f.clock.currentDay)
	f.military.snapshot().assertEquals(completed)
	f.military.forceCount.assertEquals(before + 1)
	// Existing roster maintenance is charged after completion, without new hulls.
	let maintenance = f.campaign.countries.treasury[0]
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.military.forces[before].supply.assertEquals(d.supply - 1)
	f.military.forces[before].hull.upkeepCredit.assertEquals(d.upkeep mod 30)
	// The pre-existing owned ship also pays the same roster maintenance.
	f.campaign.countries.treasury[0].assertEquals(maintenance - (d.upkeep div 30) - ((d.upkeep + ((start - f.day + buildDays) * d.upkeep) mod 30) div 30))
	f.military.forceCount.assertEquals(before + 1)

@test function doctrineCommissioningRejectsEachMissingConditionWithoutMutation()
	let f = new NavalFixture(false, false)
	f.commissioningReady()
	f.rejectedBuild() // Missing doctrine, with every other condition present.
	f.unlock("battlefleet_doctrine")
	let d = f.military.naval.yards[0]
	let state = f.military.naval.states[0]
	let ready = state.ready
	state.ready = 0
	f.rejectedBuild()
	state.ready = ready
	state.boardOwner = ""
	f.rejectedBuild()
	state.boardOwner = "player"
	let first = d.firstDay
	d.firstDay = f.clock.currentDay + 1
	f.rejectedBuild()
	d.firstDay = first
	let last = d.lastDay
	d.lastDay = f.clock.currentDay - 1
	f.rejectedBuild()
	d.lastDay = last
	let research = f.rpg.captureState()
	f.rpg.restoreState(research.replace("|u,player,public_credit", "")).assertTrue()
	f.rejectedBuild()
	f.rpg.restoreState(research).assertTrue()
	f.rpg.restoreState(research.replace("|u,player,dockyard_logistics", "")).assertTrue()
	f.rejectedBuild()
	f.rpg.restoreState(research).assertTrue()
	let funds = f.campaign.countries.treasury[0]
	f.campaign.countries.treasury[0] = d.price - 1
	f.rejectedBuild()
	f.campaign.countries.treasury[0] = funds
	let city = f.military.settlements[0]
	let manpower = city.manpower
	city.manpower = d.crew // One local worker must remain.
	f.rejectedBuild()
	city.manpower = manpower
	let supply = city.supply
	city.supply = d.supply - 1
	f.rejectedBuild()
	city.supply = supply
	for i = 0 to 2
		let stock = f.trade.markets[i].stock
		f.trade.markets[i].stock = 0
		f.rejectedBuild()
		f.trade.markets[i].stock = stock
		f.trade.markets[i].blockaded = true
		f.rejectedBuild()
		f.trade.markets[i].blockaded = false
	let before = f.authority()
	(f.runtime.act("ai", "build", "london", "") != "").assertTrue()
	f.authority().assertEquals(before)
	f.action("build", "") // Restoring each missing condition restores eligibility.

@test function doctrineCommissioningCaptureCancelsAndReconstructionNeverRepeatsCompletion()
	let f = new NavalFixture(false, false)
	f.unlock("battlefleet_doctrine")
	f.commissioningReady()
	let count = f.military.forceCount
	f.action("build", "")
	f.clock.advanceTo(f.clock.currentDay + f.military.naval.buildDays - 1).assertTrue()
	let paid = f.campaign.countries.treasury[0]
	let stock = f.trade.capture()
	f.military.transferSettlement("london", "ai")
	f.military.naval.states[0].job.assertEquals("")
	f.military.naval.states[0].boardOwner.assertEquals("")
	f.effects.entitled("ai", "ship_of_the_line").assertFalse()
	let captured = f.military.snapshot()
	f.military.restore(captured).assertTrue()
	f.rpg.technologies.reconstructAll()
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.military.forceCount.assertEquals(count)
	f.trade.capture().assertEquals(stock)
	(f.campaign.countries.treasury[0] <= paid).assertTrue()
	(f.military.naval.states[0].ready > 0).assertTrue()

@test function doctrineCommissioningPlayerAiAndActiveInactiveUseIdenticalAuthority()
	var expected = ""
	for variant = 0 to 3
		let f = new NavalFixture(variant >= 2, variant mod 2 == 0)
		f.unlock("battlefleet_doctrine")
		f.commissioningReady()
		let count = f.military.forceCount
		f.action("build", "")
		let start = f.clock.currentDay
		f.clock.advanceTo(start + f.military.naval.buildDays - 1).assertTrue()
		f.military.forceCount.assertEquals(count)
		let pending = f.military.snapshot()
		f.military.restore(pending).assertTrue()
		f.rpg.technologies.reconstructAll()
		f.clock.advanceTo(start + f.military.naval.buildDays).assertTrue()
		f.military.forceCount.assertEquals(count + 1)
		f.military.forces[count].controllerId.assertEquals(f.resources.owner)
		f.military.forces[count].combatProfileId.assertEquals("ship_of_the_line_generic")
		let completed = f.military.snapshot()
		f.runtime.advance(f.clock.currentDay)
		f.military.restore(completed).assertTrue()
		f.runtime.advance(f.clock.currentDay)
		f.military.snapshot().assertEquals(completed)
		let outcome = I2S(f.campaign.countries.treasury[0]) + "#" + I2S(f.military.settlements[0].manpower) + "#" + I2S(f.military.settlements[0].supply) + "#" + f.trade.capture() + "#" + f.military.forces[count].hull.record()
		if variant == 0
			expected = outcome
		else
			outcome.assertEquals(expected)

@test function doctrineCommissioningLateLoadRollbackRestoresPaidWorkAndResources()
	let f = new LoadFixture()
	let effects = new NavalResearchEffects(f.rpg.technologies.effects)
	f.rpg.technologies.effects = effects
	f.military.setRpgRuntime(f.rpg)
	f.military.navalResearch = effects
	f.military.combatBindings = createGeneratedCombatBindings()
	configureGeneratedNaval(f.military.naval, effects)
	let d = f.military.naval.yards[0]
	// Adapt only this bounded load fixture's location/calendar and supporting
	// research. Production roster bill and construction work remain generated.
	d.id = "port"
	d.mapId = "europe_west"
	d.prerequisite = "battlefleet_doctrine"
	d.researchRequirements = "|battlefleet_doctrine|"
	d.firstDay = 0
	d.lastDay = 1000
	f.military.naval.states[0].ready = 1
	f.military.naval.states[0].lastDay = f.clock.currentDay
	f.military.naval.states[0].boardOwner = "england"
	f.military.settlements[0].manpower = 10000
	f.military.settlements[0].supply = 10000
	f.military.appoint("port", new AdministratorState("clerk", "Clerk", "Administrator", "england", "europe_west", "port", 50, 50, 40, 1))
	f.campaign.countries.treasury[0] = 100000
	for i = 0 to 2
		var good = "timber"
		if i == 1
			good = "iron"
		else if i == 2
			good = "ship_provisions"
		f.extension.trade.registerMarket(new RuntimeMarket("port", good, 10000, 100000, 10, 10))
	let technology = new RuntimeTechnology("battlefleet_doctrine", "Battlefleet Doctrine", 1, 1)
	technology.addUnlock("battlefleet_doctrine", "unit", "ship_of_the_line")
	f.rpg.technologies.register(technology).assertTrue()
	let runtime = new NavalCampaignRuntime(f.campaign.state, f.extension.trade, effects)
	f.campaign.state.navalRuntime = runtime
	f.campaign.saves.save(SAVE_SLOT_MANUAL, 1, "before doctrine").assertTrue()
	f.rpg.research("england", "battlefleet_doctrine", 1, 1).assertTrue()
	runtime.act("england", "build", "port", "").assertEquals("")
	f.clock.advanceTo(f.clock.currentDay + 1).assertTrue()
	f.military.naval.states[0].work.assertEquals(1)
	let before = f.military.snapshot()
	let research = f.rpg.captureState()
	let stocks = f.extension.trade.capture()
	let treasury = f.campaign.countries.treasury[0]
	f.recordingTimer.expected = f.clock.captureState()
	f.extension.fail = true
	f.campaign.saves.load(SAVE_SLOT_MANUAL, 1).assertFalse()
	f.extension.applications.assertEquals(1)
	f.military.snapshot().assertEquals(before)
	f.rpg.captureState().assertEquals(research)
	f.extension.trade.capture().assertEquals(stocks)
	f.campaign.countries.treasury[0].assertEquals(treasury)
	effects.entitled("england", "ship_of_the_line").assertTrue()

@test function registeredNavalResearchUnlocksPaidHistoricalRosterWithoutFreeShipsAndRepairsConsumeRealInputs()
	let f = new NavalFixture(false, true)
	let control = new NavalFixture(false, false)
	let before = f.military.forceCount
	f.allResearch()
	f.military.forceCount.assertEquals(before)
	f.runtime.act("player", "build", "london", "").startsWith("Commission").assertTrue()
	f.dock()
	control.dock()
	f.action("board", "")
	control.action("board", "")
	f.clock.advanceTo(f.day + 180).assertTrue()
	control.clock.advanceTo(control.day + 180).assertTrue()
	control.runtime.act("player", "build", "london", "").startsWith("Requires").assertTrue()
	let historical = f.military.naval.yards[0].firstDay
	f.military.naval.yards[0].firstDay = f.day + 1000
	f.runtime.act("player", "build", "london", "").startsWith("Requires").assertTrue()
	f.military.naval.yards[0].firstDay = historical
	let funds = f.campaign.countries.treasury[0]
	let manpower = f.military.settlements[0].manpower
	f.action("build", "")
	f.campaign.countries.treasury[0].assertEquals(funds - 1540)
	f.military.settlements[0].manpower.assertEquals(manpower - 700)
	f.military.forceCount.assertEquals(before)
	f.clock.advanceTo(f.day + 359).assertTrue()
	f.military.forceCount.assertEquals(before)
	f.clock.advanceTo(f.day + 360).assertTrue()
	f.military.forceCount.assertEquals(before + 1)
	f.military.forces[before].combatProfileId.assertEquals("ship_of_the_line_generic")
	f.military.forces[f.military.forceIndex("ship")].hull.integrity = 5000
	control.military.forces[control.military.forceIndex("ship")].hull.integrity = 5000
	f.action("repair", " ship")
	control.action("repair", " ship")
	f.clock.advanceTo(f.day + 370).assertTrue()
	control.clock.advanceTo(control.day + 190).assertTrue()
	f.military.forces[f.military.forceIndex("ship")].hull.integrity.assertEquals(6150)
	control.military.forces[control.military.forceIndex("ship")].hull.integrity.assertEquals(6000)
	f.effects.rate("player", "hull_repair_throughput").assertEquals(1500)

@test function paidCarronadesOnlyModifyCloseVerifiedCannonHitsAndPreserveOtherRatingsOnCaptureAndReload()
	let f = new NavalFixture(false, true)
	f.allResearch()
