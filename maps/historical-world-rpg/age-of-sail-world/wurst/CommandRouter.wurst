package CommandRouter
import ErrorHandling
public constant int COMMAND_RELEASE=0
public constant int COMMAND_DEBUG=1
public constant int COMMAND_INTERNAL=2
public interface CommandHandler
	function execute(player sender,string arguments)
public interface CommandOutput
	function show(player recipient,string message)
public class WarcraftOutput implements CommandOutput
	override function show(player p,string message)
		DisplayTimedTextToPlayer(p,0.,0.,12.,message)
public class CommandText
	string heading="Available commands"
	string invalidPage="Invalid help page. Enter a page number between 1 and {pages}."
	string unknownTopic="Unknown help topic: {topic}. Enter /help to list available commands."
	string malformedHelp="Malformed help request. Use /help, /help <page>, or /help <command>."
	string unavailable="That command is unavailable in this build."
	string unknown="Unknown command. Enter /help to list available commands."
	string invalidArguments="Invalid arguments. Usage: /"
	string conflict="Ambiguous command registration: '{token}' is already registered."
class Command
	string name
	string aliases
	string usage
	string summary
	string details
	int minimum
	int maximum
	int visibility
	CommandHandler handler
	construct(string n,string a,string u,string s,string d,int mi,int ma,int v,CommandHandler h)
		name=n
		aliases=a
		usage=u
		summary=s
		details=d
		minimum=mi
		maximum=ma
		visibility=v
		handler=h
function lower(string s) returns string
	return StringCase(s,false)
function firstSpace(string s) returns int
	for i=0 to StringLength(s)-1
		if SubString(s,i,i+1)==" "
			return i
	return -1
public function normalizeCommandLine(string input) returns string
	var result=""
	var pending=false
	var started=false
	for i=0 to StringLength(input)-1
		let c=SubString(input,i,i+1)
		if c==" " or c=="\t" or c=="\n" or c=="\r"
			if started
				pending=true
		else
			if pending
				result+=" "
			if not started and c=="/"
				skip
			else
				result+=c
				started=true
			pending=false
	let cut=firstSpace(result)
	if cut<0
		return lower(result)
	return lower(SubString(result,0,cut))+SubString(result,cut,StringLength(result))
function token(string s) returns string
	let cut=firstSpace(s)
	if cut<0
		return s
	return SubString(s,0,cut)
function args(string s) returns string
	let cut=firstSpace(s)
	if cut<0
		return ""
	return SubString(s,cut+1,StringLength(s))
public function countArguments(string s) returns int
	if s==""
		return 0
	var n=1
	for i=0 to StringLength(s)-1
		if SubString(s,i,i+1)==" "
			n++
	return n
function replace(string source,string wanted,string value) returns string
	var result=""
	var i=0
	while i<StringLength(source)
		if i+StringLength(wanted)<=StringLength(source) and SubString(source,i,i+StringLength(wanted))==wanted
			result+=value
			i+=StringLength(wanted)
		else
			result+=SubString(source,i,i+1)
			i++
	return result
function positiveInt(string s) returns boolean
	if s==""
		return false
	for i=0 to StringLength(s)-1
		let c=SubString(s,i,i+1)
		if c!="0" and c!="1" and c!="2" and c!="3" and c!="4" and c!="5" and c!="6" and c!="7" and c!="8" and c!="9"
			return false
	return true
function hasAlias(string aliases,string wanted) returns boolean
	var start=0
	for i=0 to StringLength(aliases)
		if i==StringLength(aliases) or SubString(aliases,i,i+1)==","
			if lower(SubString(aliases,start,i))==wanted
				return true
			start=i+1
	return false
public class CommandRegistry
	Command array[64] commands
	int size=0
	boolean debug
	int pageSize
	CommandText text
	CommandOutput output
	construct(boolean d,int p,CommandText t,CommandOutput o)
		debug=d
		pageSize=p
		text=t
		output=o
		if pageSize<1
			pageSize=6
	function visible(Command c) returns boolean
		return c.visibility==COMMAND_RELEASE or debug
	function find(string name) returns Command
		let wanted=lower(name)
		for i=0 to size-1
			if commands[i].name==wanted or hasAlias(commands[i].aliases,wanted)
				return commands[i]
		return null
	function register(string name,string aliases,string usage,string summary,string details,int minimum,int maximum,int visibility,CommandHandler handler) returns string
		let n=lower(normalizeCommandLine(name))
		if n=="" or firstSpace(n)>=0
			return "Malformed command registration: command names must be one token."
		if minimum<0 or maximum<minimum
			return "Malformed command registration: invalid argument bounds for '"+n+"'."
		if find(n)!=null
			return replace(text.conflict,"{token}",n)
		var start=0
		for i=0 to StringLength(aliases)
			if i==StringLength(aliases) or SubString(aliases,i,i+1)==","
				let a=lower(normalizeCommandLine(SubString(aliases,start,i)))
				if a!="" and (firstSpace(a)>=0 or a==n or find(a)!=null or hasAlias(SubString(aliases,0,start),a))
					return replace(text.conflict,"{token}",a)
				start=i+1
		commands[size]=new Command(n,lower(aliases),usage,summary,details,minimum,maximum,visibility,handler)
		size++
		return ""
	function visibleCount() returns int
		var n=0
		for i=0 to size-1
			if visible(commands[i])
				n++
		return n
	function pages() returns int
		let n=(visibleCount()+pageSize-1) div pageSize
		if n<1
			return 1
		return n
	function helpPage(player sender,int page)
		if page<1 or page>pages()
			output.show(sender,replace(text.invalidPage,"{pages}",pages().toString()))
			return
		var message=text.heading+" - Page "+page+"/"+pages()
		var shown=0
		for i=0 to size-1
			let c=commands[i]
			if visible(c)
				if shown>=(page-1)*pageSize and shown<page*pageSize
					message+="\n/"+c.usage+" - "+c.summary
				shown++
		output.show(sender,message)
	function help(player sender,string a)
		if countArguments(a)>1
			output.show(sender,text.malformedHelp)
		else if a==""
			helpPage(sender,1)
		else if positiveInt(a)
			helpPage(sender,S2I(a))
		else
			let c=find(lower(a))
			if c==null
				output.show(sender,replace(text.unknownTopic,"{topic}",a))
			else if not visible(c)
				output.show(sender,text.unavailable)
			else
				output.show(sender,"Usage: /"+c.usage+"\n"+c.details)
	function dispatch(player sender,string input) returns boolean
		let line=normalizeCommandLine(input)
		if line==""
			return false
		let c=find(token(line))
		if c==null
			output.show(sender,text.unknown)
			return false
		if not visible(c)
			output.show(sender,text.unavailable)
			return false
		let a=args(line)
		let n=countArguments(a)
		if c.name!="help" and (n<c.minimum or n>c.maximum)
			output.show(sender,text.invalidArguments+c.usage)
			return false
		if c.name=="help"
			help(sender,a)
		else
			c.handler.execute(sender,a)
		return true
CommandRegistry active=null
function routeChat()
	active.dispatch(GetTriggerPlayer(),GetEventPlayerChatString())
public function installCommandRegistry(CommandRegistry registry)
	active=registry
	let listener=CreateTrigger()
	for i=0 to bj_MAX_PLAYERS-1
		TriggerRegisterPlayerChatEvent(listener,Player(i),"/",false)
	TriggerAddAction(listener,function routeChat)
public function createCommandRegistry(boolean debug) returns CommandRegistry
	let registry=new CommandRegistry(debug,6,new CommandText(),new WarcraftOutput())
	let problem=registry.register("help","commands","help [page|command]","Show command help.","List available commands or show help for one command.",0,1,COMMAND_RELEASE,null)
	if problem!=""
		error(problem)
	return registry

/** Player identity authority. Origin and its starting location are write-once. */
public class PlayerCampaignIdentity
	string originPolityId = ""
	string currentAllegiancePolityId = ""
	string startingPhysicalMapId = ""
	string startingRegionalInstanceId = ""
	string startingSettlementId = ""

	function hasOrigin() returns boolean
		return originPolityId != ""

	function startCampaign(string polityId, string physicalMapId, string regionalInstanceId, string settlementId) returns boolean
		if hasOrigin() or polityId == "" or physicalMapId == "" or regionalInstanceId == "" or settlementId == ""
			return false
		originPolityId = polityId
		currentAllegiancePolityId = polityId
		startingPhysicalMapId = physicalMapId
		startingRegionalInstanceId = regionalInstanceId
		startingSettlementId = settlementId
		return true

	function changeAllegiance(string polityId) returns boolean
		if not hasOrigin() or polityId == ""
			return false
		currentAllegiancePolityId = polityId
		return true

	function physicalMapId() returns string
		return startingPhysicalMapId
	function regionalInstanceId() returns string
		return startingRegionalInstanceId
	function settlementId() returns string
		return startingSettlementId
	function originId() returns string
		return originPolityId
	function allegianceId() returns string
		return currentAllegiancePolityId
	/** Save reconstruction hook. Validation is deliberately performed by the state port first. */
	function restore(string origin, string allegiance, string mapId, string regionId, string settlement)
		originPolityId = origin
		currentAllegiancePolityId = allegiance
		startingPhysicalMapId = mapId
		startingRegionalInstanceId = regionId
		startingSettlementId = settlement

public interface OriginSelectionPresentation
	function show(string heading, string rows, int page, int pages)
	function showError(string message)
	function close()

public interface OriginSelectionObserver
	function commitSelection(string polityId, string physicalMapId, string regionalInstanceId, string settlementId) returns boolean
	function campaignStarted(string polityId, string physicalMapId, string packagePath, string regionalInstanceId, string settlementId)

public class WarcraftOriginPresentation implements OriginSelectionPresentation
	override function show(string heading, string rows, int page, int pages)
		DisplayTimedTextToPlayer(Player(0), 0., 0., 30., heading + "\nPage " + page.toString() + "/" + pages.toString() + "\n" + rows + "\nUse /origin page N, /origin search WORDS, or /origin choose ID.")
	override function showError(string message)
		DisplayTimedTextToPlayer(Player(0), 0., 0., 12., message)
	override function close()
		DisplayTimedTextToPlayer(Player(0), 0., 0., 12., "Origin confirmed. Your current allegiance begins there, but may change later.")
		PauseGame(false)

public class OriginDefinition
	real x = 0.
	real y = 0.
	string polityId
	string name
	string physicalMapId
	string packagePath
	string regionalInstanceId
	string settlementId
	construct(string polityId, string name, string physicalMapId, string packagePath, string regionalInstanceId, string settlementId)
		this.polityId = polityId
		this.name = name
		this.physicalMapId = physicalMapId
		this.packagePath = packagePath
		this.regionalInstanceId = regionalInstanceId
		this.settlementId = settlementId

/** Generated onboarding records shared by the selector and destination validator. */
public class OriginCatalog
	OriginDefinition array[256] definitions
	int count = 0
	function find(string polityId) returns OriginDefinition
		for i = 0 to count - 1
			if definitions[i].polityId == polityId
				return definitions[i]
		return null
	function setPosition(string polityId, real x, real y)
		let row = find(polityId)
		if row != null
			row.x = x
			row.y = y
	function accepts(string polityId, string mapId, string instanceId, string settlementId) returns boolean
		let row = find(polityId)
		return row != null and row.physicalMapId == mapId and row.regionalInstanceId == instanceId and row.settlementId == settlementId
	function add(string polityId, string name, string physicalMapId, string packagePath, string regionalInstanceId, string settlementId)
		if polityId == "" or name == "" or physicalMapId == "" or packagePath == "" or regionalInstanceId == "" or settlementId == "" or find(polityId) != null or count >= 256
			return
		definitions[count] = new OriginDefinition(polityId, name, physicalMapId, packagePath, regionalInstanceId, settlementId)
		count++

/** Searchable/paged pre-game selector; gameplay remains locked until choose succeeds. */
public class NewCampaignOriginController extends OriginCatalog
	int pageSize
	string query = ""
	OriginSelectionPresentation presentation
	PlayerCampaignIdentity identity
	OriginSelectionObserver observer = null

	construct(int pageSize, OriginSelectionPresentation presentation, PlayerCampaignIdentity identity)
		this.pageSize = pageSize
		if this.pageSize < 1
			this.pageSize = 8
		this.presentation = presentation
		this.identity = identity

	function setObserver(OriginSelectionObserver observer)
		this.observer = observer

	function matches(OriginDefinition row) returns boolean
		let wanted = StringCase(query, false)
		return wanted == "" or StringCase(row.name, false).indexOf(wanted) >= 0 or StringCase(row.polityId, false).indexOf(wanted) >= 0

	function matchCount() returns int
		var result = 0
		for i = 0 to count - 1
			if matches(definitions[i])
				result++
		return result

	function pages() returns int
		let result = (matchCount() + pageSize - 1) div pageSize
		if result < 1
			return 1
		return result

	function showPage(int page)
		if identity.hasOrigin()
			return
		if page < 1 or page > pages()
			presentation.showError("That origin page is not available.")
			return
		var rows = ""
		var matched = 0
		for i = 0 to count - 1
			let row = definitions[i]
			if matches(row)
				if matched >= (page - 1) * pageSize and matched < page * pageSize
					if rows != ""
						rows += "\n"
					rows += row.name + " [" + row.polityId + "]"
				matched++
		presentation.show("Which country or polity are you from at the start? You play an individual, not the country.", rows, page, pages())

	function search(string playerQuery)
		query = playerQuery
		showPage(1)

	function choose(string polityId) returns boolean
		if identity.hasOrigin()
			presentation.showError("Your campaign origin is already part of your history.")
			return false
		for i = 0 to count - 1
			let row = definitions[i]
			if row.polityId == polityId
				if observer != null and not observer.commitSelection(row.polityId, row.physicalMapId, row.regionalInstanceId, row.settlementId)
					presentation.showError("Campaign start could not be committed. Please choose the origin again.")
					return false
				if identity.startCampaign(row.polityId, row.physicalMapId, row.regionalInstanceId, row.settlementId)
					presentation.close()
					if observer != null
						observer.campaignStarted(row.polityId, row.physicalMapId, row.packagePath, row.regionalInstanceId, row.settlementId)
					return true
		presentation.showError("That polity is not active in the authoritative 1450 world.")
		return false

function splitOriginArgument(string arguments) returns int
	for i = 0 to StringLength(arguments) - 1
		if SubString(arguments, i, i + 1) == " "
			return i
	return -1

public class OriginCommandHandler implements CommandHandler
	NewCampaignOriginController controller
	construct(NewCampaignOriginController controller)
		this.controller = controller
	override function execute(player sender, string arguments)
		let cut = splitOriginArgument(arguments)
		var action = arguments
		var value = ""
		if cut >= 0
			action = SubString(arguments, 0, cut)
			value = SubString(arguments, cut + 1, StringLength(arguments))
		if action == "page" and value != ""
			controller.showPage(S2I(value))
		else if action == "search"
			controller.search(value)
		else if action == "choose" and value != ""
			controller.choose(value)
		else
			controller.showPage(1)

public function registerOriginSelection(CommandRegistry commands, NewCampaignOriginController controller)
	commands.register("origin", "citizenship", "origin [page N|search WORDS|choose ID]", "Choose where your individual character is from.", "Search and page through every active 1450 polity, then confirm one immutable origin. This does not give direct control of that country.", 0, 99, COMMAND_RELEASE, new OriginCommandHandler(controller))
