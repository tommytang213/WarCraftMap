package CommandRouter
import ErrorHandling
public constant int COMMAND_RELEASE=0
public constant int COMMAND_DEBUG=1
public constant int COMMAND_INTERNAL=2
public interface CommandHandler
	function execute(player sender,string arguments)
public interface CommandOutput
	function show(player recipient,string message)
public class WarcraftOutput implements CommandOutput
	override function show(player p,string message)
		DisplayTimedTextToPlayer(p,0.,0.,12.,message)
public class CommandText
	string heading="Available commands"
	string invalidPage="Invalid help page. Enter a page number between 1 and {pages}."
	string unknownTopic="Unknown help topic: {topic}. Enter /help to list available commands."
	string malformedHelp="Malformed help request. Use /help, /help <page>, or /help <command>."
	string unavailable="That command is unavailable in this build."
	string unknown="Unknown command. Enter /help to list available commands."
	string invalidArguments="Invalid arguments. Usage: /"
	string conflict="Ambiguous command registration: '{token}' is already registered."
class Command
	string name
	string aliases
	string usage
	string summary
	string details
	int minimum
	int maximum
	int visibility
	CommandHandler handler
	construct(string n,string a,string u,string s,string d,int mi,int ma,int v,CommandHandler h)
		name=n
		aliases=a
		usage=u
		summary=s
		details=d
		minimum=mi
		maximum=ma
		visibility=v
		handler=h
function lower(string s) returns string
	return StringCase(s,false)
function firstSpace(string s) returns int
	for i=0 to StringLength(s)-1
		if SubString(s,i,i+1)==" "
			return i
	return -1
public function normalizeCommandLine(string input) returns string
	var result=""
	var pending=false
	var started=false
	for i=0 to StringLength(input)-1
		let c=SubString(input,i,i+1)
		if c==" " or c=="\t" or c=="\n" or c=="\r"
			if started
				pending=true
		else
			if pending
				result+=" "
			if not started and c=="/"
				skip
			else
				result+=c
				started=true
			pending=false
	let cut=firstSpace(result)
	if cut<0
		return lower(result)
	return lower(SubString(result,0,cut))+SubString(result,cut,StringLength(result))
function token(string s) returns string
	let cut=firstSpace(s)
	if cut<0
		return s
	return SubString(s,0,cut)
function args(string s) returns string
	let cut=firstSpace(s)
	if cut<0
		return ""
	return SubString(s,cut+1,StringLength(s))
public function countArguments(string s) returns int
	if s==""
		return 0
	var n=1
	for i=0 to StringLength(s)-1
		if SubString(s,i,i+1)==" "
			n++
	return n
function replace(string source,string wanted,string value) returns string
	var result=""
	var i=0
	while i<StringLength(source)
		if i+StringLength(wanted)<=StringLength(source) and SubString(source,i,i+StringLength(wanted))==wanted
			result+=value
			i+=StringLength(wanted)
		else
			result+=SubString(source,i,i+1)
			i++
	return result
function positiveInt(string s) returns boolean
	if s==""
		return false
	for i=0 to StringLength(s)-1
		let c=SubString(s,i,i+1)
		if c!="0" and c!="1" and c!="2" and c!="3" and c!="4" and c!="5" and c!="6" and c!="7" and c!="8" and c!="9"
			return false
	return true
function hasAlias(string aliases,string wanted) returns boolean
	var start=0
	for i=0 to StringLength(aliases)
		if i==StringLength(aliases) or SubString(aliases,i,i+1)==","
			if lower(SubString(aliases,start,i))==wanted
				return true
			start=i+1
	return false
public class CommandRegistry
	Command array[64] commands
	int size=0
	boolean debug
	int pageSize
	CommandText text
	CommandOutput output
	construct(boolean d,int p,CommandText t,CommandOutput o)
		debug=d
		pageSize=p
		text=t
		output=o
		if pageSize<1
			pageSize=6
	function visible(Command c) returns boolean
		return c.visibility==COMMAND_RELEASE or debug
	function find(string name) returns Command
		let wanted=lower(name)
		for i=0 to size-1
			if commands[i].name==wanted or hasAlias(commands[i].aliases,wanted)
				return commands[i]
		return null
	function register(string name,string aliases,string usage,string summary,string details,int minimum,int maximum,int visibility,CommandHandler handler) returns string
		let n=lower(normalizeCommandLine(name))
		if n=="" or firstSpace(n)>=0
			return "Malformed command registration: command names must be one token."
		if minimum<0 or maximum<minimum
			return "Malformed command registration: invalid argument bounds for '"+n+"'."
		if find(n)!=null
			return replace(text.conflict,"{token}",n)
		var start=0
		for i=0 to StringLength(aliases)
			if i==StringLength(aliases) or SubString(aliases,i,i+1)==","
				let a=lower(normalizeCommandLine(SubString(aliases,start,i)))
				if a!="" and (firstSpace(a)>=0 or a==n or find(a)!=null or hasAlias(SubString(aliases,0,start),a))
					return replace(text.conflict,"{token}",a)
				start=i+1
		commands[size]=new Command(n,lower(aliases),usage,summary,details,minimum,maximum,visibility,handler)
		size++
		return ""
	function visibleCount() returns int
		var n=0
		for i=0 to size-1
			if visible(commands[i])
				n++
		return n
	function pages() returns int
		let n=(visibleCount()+pageSize-1) div pageSize
		if n<1
			return 1
		return n
	function helpPage(player sender,int page)
		if page<1 or page>pages()
			output.show(sender,replace(text.invalidPage,"{pages}",pages().toString()))
			return
		var message=text.heading+" - Page "+page+"/"+pages()
		var shown=0
		for i=0 to size-1
			let c=commands[i]
			if visible(c)
				if shown>=(page-1)*pageSize and shown<page*pageSize
					message+="\n/"+c.usage+" - "+c.summary
				shown++
		output.show(sender,message)
	function help(player sender,string a)
		if countArguments(a)>1
			output.show(sender,text.malformedHelp)
		else if a==""
			helpPage(sender,1)
		else if positiveInt(a)
			helpPage(sender,S2I(a))
		else
			let c=find(lower(a))
			if c==null
				output.show(sender,replace(text.unknownTopic,"{topic}",a))
			else if not visible(c)
				output.show(sender,text.unavailable)
			else
				output.show(sender,"Usage: /"+c.usage+"\n"+c.details)
	function dispatch(player sender,string input) returns boolean
		let line=normalizeCommandLine(input)
		if line==""
			return false
		let c=find(token(line))
		if c==null
			output.show(sender,text.unknown)
			return false
		if not visible(c)
			output.show(sender,text.unavailable)
			return false
		let a=args(line)
		let n=countArguments(a)
		if c.name!="help" and (n<c.minimum or n>c.maximum)
			output.show(sender,text.invalidArguments+c.usage)
			return false
		if c.name=="help"
			help(sender,a)
		else
			c.handler.execute(sender,a)
		return true
CommandRegistry active=null
function routeChat()
	active.dispatch(GetTriggerPlayer(),GetEventPlayerChatString())
public function installCommandRegistry(CommandRegistry registry)
	active=registry
	let listener=CreateTrigger()
	for i=0 to bj_MAX_PLAYERS-1
		TriggerRegisterPlayerChatEvent(listener,Player(i),"/",false)
	TriggerAddAction(listener,function routeChat)
public function createCommandRegistry(boolean debug) returns CommandRegistry
	let registry=new CommandRegistry(debug,6,new CommandText(),new WarcraftOutput())
	let problem=registry.register("help","commands","help [page|command]","Show command help.","List available commands or show help for one command.",0,1,COMMAND_RELEASE,null)
	if problem!=""
		error(problem)
	return registry
