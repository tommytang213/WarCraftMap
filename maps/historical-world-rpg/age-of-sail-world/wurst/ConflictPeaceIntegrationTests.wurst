package ConflictPeaceIntegrationTests

import Wurstunit
import CommandRouter
import CountryDiplomacyScreen
import PlayableCountryInteractions
import CampaignRegistration
import CampaignSaveManager
import PlayableCampaignRuntime
import CampaignTimeline
import WarcraftRegionalRuntime
import MilitarySettlementRuntime
import MilitarySettlementRuntimeTests
import ScenarioData

class PeacePresentation implements CountryDiplomacyPresentation, CommandOutput
	string last = ""
	override function show(player viewer, string message)
		last = message
	override function showCountry(string polityId, string summary, string interactions)
		last = summary
	override function showPeace(string offerId, string terms, string explanation)
		last = offerId
	override function showResult(string message)
		last = message

class ConflictFixture
	PlayerCampaignIdentity identity = new PlayerCampaignIdentity()
	MilitarySettlementRuntime military = new MilitarySettlementRuntime(new RecordingMilitaryAdapter())
	PlayableCountryInteractionRuntime countries = new PlayableCountryInteractionRuntime(identity)
	PeacePresentation presentation = new PeacePresentation()
	CountryDiplomacyController screen = new CountryDiplomacyController(countries, presentation)
	CommandRegistry commands = new CommandRegistry(false, 8, new CommandText(), presentation)
	construct()
		identity.startCampaign("england", "europe_west", "europe", "london")
		configureGeneratedConflicts(military)
		countries.registerPolity("england", 100)
		countries.registerPolity("france", 100)
		countries.registerPolity("portugal", 100)
		countries.discover("france")
		countries.discover("portugal")
		countries.setMilitaryAuthority(military)
		countries.setPeaceAuthority(new CampaignCountryPeaceAuthority(military))
		registerGovernmentRewards(commands, screen)
		military.registerSettlement(new SettlementRuntimeState("london", "england", "europe_west", 'htow', 'hfoo', 40, 40, 40, 40, 0., 0.))
		military.registerSettlement(new SettlementRuntimeState("paris", "france", "europe_west", 'htow', 'hfoo', 40, 40, 40, 40, 10., 10.))
		military.registerForce(new RuntimeForce("defense:paris:gate", "france", "europe_west", "siege", FORCE_DEFENSE, 'hgtw', 40, 40, 12., 10.))
	function offer() returns string
		commands.dispatch(null, "/peace france ceasefire").assertTrue()
		return presentation.last
	function addWar(string id)
		military.registerConflictMember(id, "england", 1).assertTrue()
		military.registerConflictMember(id, "france", 2).assertTrue()

function firstSettlement(MilitarySettlementRuntime military, string controller) returns string
	for i = 0 to military.settlementCount - 1
		if military.settlements[i].controllerId == controller
			return military.settlements[i].id
	return ""

@test function registeredCountryAndRewardCommandsUsePersistentAuthority()
	let f = new ConflictFixture()
	f.countries.registerRewardProfile(new GovernmentRewardProfile("england", "commission", "office", 20, 5, 30, false))
	let initial = f.countries.captureState()
	f.commands.dispatch(null, "/country england").assertTrue()
	f.presentation.last.assertEquals("You have not discovered enough about that country.")
	f.commands.dispatch(null, "/reward england commission").assertTrue()
	f.presentation.last.assertEquals("You cannot request a reward from an undiscovered government.")
	f.countries.captureState().assertEquals(initial)
	f.countries.discover("england").assertTrue()
	f.countries.setStanding("england", 5, 5)
	f.countries.recordContribution("england", 10).assertTrue()
	f.commands.dispatch(null, "/country england").assertTrue()
	f.presentation.last.assertEquals("Allegiance: england; reputation 5; favor 5; contribution 10")
	f.commands.dispatch(null, "/reward england commission").assertTrue()
	f.presentation.last.assertEquals("Reward granted: commission (office).")
	f.countries.treasury[f.countries.polityIndex("england")].assertEquals(70)
	let granted = f.countries.captureState()
	f.commands.dispatch(null, "/reward england commission").assertTrue()
	f.presentation.last.assertEquals("Reward rejected: reward was already granted.")
	f.countries.captureState().assertEquals(granted)
	let restored = new ConflictFixture()
	restored.countries.registerRewardProfile(new GovernmentRewardProfile("england", "commission", "office", 20, 5, 30, false))
	restored.countries.restoreState(granted).assertTrue()
	restored.commands.dispatch(null, "/government-reward england commission").assertTrue()
	restored.presentation.last.assertEquals("Reward rejected: reward was already granted.")
	restored.countries.captureState().assertEquals(granted)

@test function generatedPoliticalSidesAuthorizeCaptureAndRegisteredPeaceStopsIt()
	let f = new ConflictFixture()
	configureGeneratedCountryInteractions(f.countries)
	configureMilitarySettlementScenario(f.military)
	f.military.activeOpponents("hundred_years_war", "england", "france").assertTrue()
	f.military.atWar("france", "england").assertTrue()
	f.military.atWar("mexica_tenochtitlan", "chalco_confederation").assertTrue()
	f.military.atWar("acolhua_texcoco", "chalco_confederation").assertTrue()
	f.military.atWar("tepanec_tlacopan", "chalco_confederation").assertTrue()
	f.military.atWar("mexica_tenochtitlan", "acolhua_texcoco").assertFalse()
	f.military.atWar("acolhua_texcoco", "tepanec_tlacopan").assertFalse()
	f.military.atWar("mexica_tenochtitlan", "tepanec_tlacopan").assertFalse()
	let before = f.military.conflictSnapshot()
	configureGeneratedConflicts(f.military)
	f.military.conflictSnapshot().assertEquals(before)
	f.military.beginSettlementAttack("paris", "england", 10.).assertTrue()
	f.military.capture("paris", "england", 10.).assertTrue()
	let chalco = firstSettlement(f.military, "chalco_confederation")
	(chalco != "").assertTrue()
	f.military.beginSettlementAttack(chalco, "acolhua_texcoco", 10.).assertTrue()
	f.military.capture(chalco, "mexica_tenochtitlan", 10.).assertTrue()
	f.military.capture(chalco, "tepanec_tlacopan", 20.).assertFalse()
	let offer = f.offer()
	f.screen.respond(offer, true, true)
	f.presentation.last.assertEquals("Peace concluded under the negotiated terms.")
	f.countries.activeConflictWith("france").assertEquals("")
	f.military.atWar("england", "france").assertFalse()
	f.military.beginSettlementAttack("paris", "england", 30.).assertFalse()
	f.military.capture("paris", "england", 30.).assertFalse()
	f.military.settlements[f.military.settlementIndex("paris")].controllerId.assertEquals("france")
	f.military.atWar("mexica_tenochtitlan", "chalco_confederation").assertTrue()

@test function overlappingWarsKeepHostilityAndSiegesUntilTheirOwnPeace()
	let f = new ConflictFixture()
	let oldOffer = f.offer()
	let staleOffer = f.offer()
	f.addWar("second_war")
	f.military.beginSettlementAttack("london", "france", 10.).assertTrue()
	f.countries.respondToOffer(oldOffer, true, true).assertEquals("Peace concluded under the negotiated terms.")
	f.military.atWar("england", "france").assertTrue()
	f.military.settlements[0].underAttack.assertTrue()
	f.countries.activeConflictWith("france").assertEquals("second_war")
	let countries = f.countries.captureState()
	let military = f.military.snapshot()
	f.countries.respondToOffer(staleOffer, true, true).assertEquals("The conflict state no longer permits this treaty.")
	f.countries.respondToOffer(oldOffer, true, true).assertEquals("Offer is not pending.")
	f.countries.captureState().assertEquals(countries)
	f.military.snapshot().assertEquals(military)
	f.military.capture("paris", "england", 20.).assertTrue()
	let second = f.offer()
	f.countries.respondToOffer(second, true, true).assertEquals("Peace concluded under the negotiated terms.")
	f.military.atWar("england", "france").assertFalse()
	f.military.settlements[0].underAttack.assertFalse()
	f.military.beginSettlementAttack("london", "france", 40.).assertFalse()
	f.military.capture("london", "france", 40.).assertFalse()
	configureGeneratedConflicts(f.military)
	f.military.atWar("england", "france").assertFalse()
	f.addWar("replacement_war")
	f.countries.respondToOffer(staleOffer, true, true).assertEquals("The conflict state no longer permits this treaty.")
	f.military.atWar("england", "france").assertTrue()

@test function unconfirmedRejectedAndUnrelatedOffersDoNotChangeWarOrTerritory()
	let f = new ConflictFixture()
	f.screen.propose("portugal", "ceasefire").assertFalse()
	f.countries.createOffer("hundred_years_war", "portugal", "ceasefire").assertEquals("")
	let offer = f.offer()
	f.military.beginSettlementAttack("paris", "england", 10.)
	let military = f.military.snapshot()
	let countries = f.countries.captureState()
	f.countries.respondToOffer(offer, true, false).assertEquals("Confirmation required.")
	f.military.snapshot().assertEquals(military)
	f.countries.captureState().assertEquals(countries)
	f.identity.changeAllegiance("portugal")
	f.countries.respondToOffer(offer, true, true).assertEquals("The conflict state no longer permits this treaty.")
	f.military.snapshot().assertEquals(military)
	f.countries.captureState().assertEquals(countries)
	f.identity.changeAllegiance("england")
	f.countries.respondToOffer(offer, false, false).assertEquals("Peace offer rejected.")
	f.military.snapshot().assertEquals(military)
	f.countries.respondToOffer(offer, true, true).assertEquals("Offer is not pending.")
	f.screen.propose("france", "cede:paris:portugal:england").assertTrue()
	let invalid = f.presentation.last
	let pending = f.countries.captureState()
	f.countries.respondToOffer(invalid, true, true).assertEquals("The conflict or territorial authority rejected these terms.")
	f.countries.captureState().assertEquals(pending)
	f.military.snapshot().assertEquals(military)
	f.screen.propose("france", "unsupported_outcome").assertTrue()
	f.countries.respondToOffer(f.presentation.last, true, true).assertEquals("The conflict or territorial authority rejected these terms.")
	f.military.snapshot().assertEquals(military)

@test function treatyTerritoryReconcilesTitleDefensesAndOffices()
	let f = new ConflictFixture()
	f.military.capture("paris", "england", 10.).assertTrue()
	f.military.settlements[1].legalOwnerId.assertEquals("france")
	f.screen.propose("france", "cede:paris:france:portugal").assertTrue()
	f.countries.respondToOffer(f.presentation.last, true, true).assertEquals("The conflict or territorial authority rejected these terms.")
	f.screen.propose("france", "cede:paris:france:england").assertTrue()
	f.countries.respondToOffer(f.presentation.last, true, true).assertEquals("Peace concluded under the negotiated terms.")
	f.military.settlements[1].legalOwnerId.assertEquals("england")
	f.military.settlements[1].controllerId.assertEquals("england")
	f.military.settlements[1].occupationConflictId.assertEquals("")
	f.military.forces[f.military.forceIndex("core:paris")].controllerId.assertEquals("england")
	f.military.forces[f.military.forceIndex("defense:paris:gate")].controllerId.assertEquals("england")
	f.military.administrators[f.military.administratorIndex("paris")].controllerId.assertEquals("england")
	f.military.atWar("england", "france").assertFalse()

function roundTripConflicts(ConflictFixture f)
	let state = new PlayableCampaignState(new WarcraftRegionalAdapter(), new CampaignClock(1, 100, 1, 1.))
	state.setCountryRuntime(f.countries)
	state.setMilitarySettlementRuntime(f.military)
	let codec = new PlayableCampaignCodec(state.clock)
	// Other domains are empty initialized fixtures; the live authorities under
	// test are captured, validated and reconstructed through production ports.
	let document = state.captureAuthoritativeState() + ";rpg=v1;religion=v1;piracy=v1"
	let payload = codec.encode("manual_01", SAVE_SLOT_MANUAL, 1, "fixture", document)
	let decoded = codec.decodeMigrateAndValidate(payload, "manual_01")
	(decoded != "").assertTrue()
	let countries = f.countries.captureState()
	let military = f.military.snapshot()
	state.validateAuthoritativeState(decoded).assertTrue()
	state.reconstructRuntime(decoded).assertTrue()
	state.activateAuthoritativeState(decoded)
	f.countries.captureState().assertEquals(countries)
	f.military.snapshot().assertEquals(military)
	state.reconstructRuntime(decoded).assertTrue()
	state.activateAuthoritativeState(decoded)
	configureGeneratedConflicts(f.military)
	f.military.snapshot().assertEquals(military)

@test function liveCodecReconstructionPreservesActiveSettledAndBoundPendingOffers()
	let f = new ConflictFixture()
	let offer = f.offer()
	f.addWar("overlap")
	f.military.beginSettlementAttack("london", "france", 10.)
	roundTripConflicts(f)
	f.military.atWar("england", "france").assertTrue()
	f.countries.offerConflicts[0].assertEquals("hundred_years_war")
	f.countries.respondToOffer(offer, true, true).assertEquals("Peace concluded under the negotiated terms.")
	roundTripConflicts(f)
	f.military.activeOpponents("hundred_years_war", "england", "france").assertFalse()
	f.military.atWar("england", "france").assertTrue()
	f.countries.respondToOffer(f.offer(), true, true).assertEquals("Peace concluded under the negotiated terms.")
	roundTripConflicts(f)
	f.military.atWar("england", "france").assertFalse()
	f.military.capture("paris", "england", 30.).assertFalse()

@test function legacyMigrationRebuildsAuthoredSidesRetiresUnboundOffersAndKeepsPeace()
	let f = new ConflictFixture()
	let legacy = "v1|p,france,1,0,0,0,100|c,england,hundred_years_war|c,france,hundred_years_war|o,player_offer_7,france,0,ceasefire"
	f.military.restore("v1|a,|w,england,france").assertTrue()
	f.countries.restoreState(legacy).assertTrue()
	f.military.atWar("england", "france").assertTrue()
	f.military.conflictIndex("legacy:england:france").assertEquals(-1)
	f.countries.respondToOffer("player_offer_7", true, true).assertEquals("Offer is not pending.")
	f.countries.createOffer("hundred_years_war", "france", "ceasefire").assertEquals("player_offer_8")
	f.military.restore("v1|a,|w,england,france").assertTrue()
	f.countries.restoreState("v1|p,france,1,0,0,0,100|c,england,|c,france,").assertTrue()
	f.military.atWar("england", "france").assertFalse()
	configureGeneratedConflicts(f.military)
	f.military.atWar("england", "france").assertFalse()
	roundTripConflicts(f)
	f.military.atWar("england", "france").assertFalse()

@test function explicitOfferSettlesItsBoundOverlapEvenWhenAnotherWarIsListedFirst()
	let f = new ConflictFixture()
	f.addWar("overlap")
	let offer = f.countries.createOffer("overlap", "france", "ceasefire")
	(offer != "").assertTrue()
	f.countries.activeConflictWith("france").assertEquals("hundred_years_war")
	f.countries.respondToOffer(offer, true, true).assertEquals("Peace concluded under the negotiated terms.")
	f.military.activeOpponents("overlap", "england", "france").assertFalse()
	f.military.activeOpponents("hundred_years_war", "england", "france").assertTrue()

@test function peaceRetiresUnsupportedSiegesWithoutSpendingMoreReserves()
	let f = new ConflictFixture()
	f.military.beginSettlementAttack("london", "france", 10.).assertTrue()
	f.military.tick(10.)
	let reserves = f.military.settlements[0].reserves
	let offer = f.offer()
	f.countries.respondToOffer(offer, true, true).assertEquals("Peace concluded under the negotiated terms.")
	f.military.forces[f.military.forceIndex("garrison:london:10")].active.assertFalse()
	f.military.settlements[0].underAttack.assertFalse()
	f.military.tick(30.)
	f.military.settlements[0].reserves.assertEquals(reserves)
	roundTripConflicts(f)
	f.military.forces[f.military.forceIndex("garrison:london:10")].active.assertFalse()

@test function invalidConflictAndOfferSnapshotsRejectWithoutMutatingAuthority()
	let f = new ConflictFixture()
	f.offer()
	let military = f.military.snapshot()
	let countries = f.countries.captureState()
	f.military.restore(military + "|m,hundred_years_war,england,2").assertFalse()
	f.military.restore(military + "|c,one_sided,0|m,one_sided,england,1").assertFalse()
	f.military.restore(military + "|c,hundred_years_war,0").assertFalse()
	f.military.restore(military + "|c,invalid_status,7").assertFalse()
	f.military.snapshot().assertEquals(military)
	f.countries.restoreState("v2|o,player_offer_4,france,0,ceasefire,missing_war,england").assertFalse()
	f.countries.restoreState("v2|o,player_offer_4,france,0,ceasefire,hundred_years_war,portugal").assertFalse()
	f.countries.captureState().assertEquals(countries)
	f.military.snapshot().assertEquals(military)

@test function legacyPeaceAppliesToSynthesizedMilitaryDefaultsAndCoalitionsKeepSides()
	let f = new ConflictFixture()
	// Pre-military saves receive current defaults from the live codec. Their
	// older country ledger must still override an authored conflict's status.
	let defaults = f.military.snapshot()
	f.military.restore(defaults).assertTrue()
	f.countries.restoreState("v1|c,england,|c,france,").assertTrue()
	f.military.atWar("england", "france").assertFalse()
	f.countries.registerPolity("chalco_confederation", 100)
	f.military.restore("v1|a,").assertTrue()
	f.countries.restoreState("v1|c,chalco_confederation,mexica_chalco_war").assertTrue()
	f.military.atWar("mexica_tenochtitlan", "chalco_confederation").assertTrue()
	f.military.atWar("acolhua_texcoco", "chalco_confederation").assertTrue()
	f.military.atWar("tepanec_tlacopan", "chalco_confederation").assertTrue()
	f.military.atWar("mexica_tenochtitlan", "acolhua_texcoco").assertFalse()
	roundTripConflicts(f)
