package CampaignSaveManager
import WC3Compatibility

public constant int SAVE_SLOT_AUTOSAVE = 0
public constant int SAVE_SLOT_MANUAL = 1
public constant int SAVE_SLOT_SESSION_START = 2
public constant int SAVE_SLOT_MAJOR_MILESTONE = 3
public constant int CAMPAIGN_AUTOSAVE_SLOT_COUNT = 15

public interface CampaignSaveStorage
	function contains(string slotId) returns boolean
	function read(string slotId) returns string
	function writeTransactional(string slotId, string payload) returns boolean
	function diagnostic() returns string

public interface CampaignSaveCodec
	function encode(string slotId, int slotKind, int slotIndex, string createdAt, string authoritativeState) returns string
	function decodeMigrateAndValidate(string payload, string expectedSlotId) returns string
	function diagnostic() returns string

public interface CampaignStatePort
	function isSaveSafe() returns boolean
	function captureAuthoritativeState() returns string
	function validateAuthoritativeState(string candidate) returns boolean
	function reconstructRuntime(string candidate) returns boolean
	function activateAuthoritativeState(string candidate)
	function diagnostic() returns string

function paddedSlotIndex(int index) returns string
	if index < 10
		return "0" + index
	return index.toString()

public function campaignSlotId(int kind, int index) returns string
	if kind == SAVE_SLOT_AUTOSAVE and index >= 1 and index <= CAMPAIGN_AUTOSAVE_SLOT_COUNT
		return "autosave_" + paddedSlotIndex(index)
	if kind == SAVE_SLOT_MANUAL and index >= 1
		return "manual_" + paddedSlotIndex(index)
	if kind == SAVE_SLOT_SESSION_START and index == 0
		return "session_start"
	if kind == SAVE_SLOT_MAJOR_MILESTONE and index == 0
		return "major_milestone"
	return ""

public class CampaignSaveManager
	CampaignSaveStorage storage
	CampaignSaveCodec codec
	CampaignStatePort state
	boolean deferred = false
	int deferredKind = -1
	int deferredIndex = -1
	string deferredCreatedAt = ""
	string lastDiagnostic = ""

	construct(CampaignSaveStorage saveStorage, CampaignSaveCodec saveCodec, CampaignStatePort statePort)
		storage = saveStorage
		codec = saveCodec
		state = statePort

	function isSaveSafe() returns boolean
		return state.isSaveSafe()

	function hasDeferredSave() returns boolean
		return deferred

	function diagnostic() returns string
		return lastDiagnostic

	function save(int kind, int index, string createdAt) returns boolean
		let slotId = campaignSlotId(kind, index)
		if slotId == ""
			lastDiagnostic = "invalid campaign save slot"
			return false
		if not state.isSaveSafe()
			deferred = true
			deferredKind = kind
			deferredIndex = index
			deferredCreatedAt = createdAt
			lastDiagnostic = "save deferred: authoritative state is transitional"
			return false
		let payload = codec.encode(slotId, kind, index, createdAt, state.captureAuthoritativeState())
		if payload == ""
			lastDiagnostic = "save serialization failed: " + codec.diagnostic()
			return false
		if not storage.writeTransactional(slotId, payload)
			lastDiagnostic = "transactional save failed: " + storage.diagnostic()
			return false
		deferred = false
		lastDiagnostic = ""
		return true

	function retryDeferred() returns boolean
		if not deferred
			lastDiagnostic = "no deferred save"
			return false
		return save(deferredKind, deferredIndex, deferredCreatedAt)

	function load(int kind, int index) returns boolean
		let slotId = campaignSlotId(kind, index)
		if slotId == "" or not storage.contains(slotId)
			lastDiagnostic = "campaign save slot is missing"
			return false
		let candidate = codec.decodeMigrateAndValidate(storage.read(slotId), slotId)
		if candidate == ""
			lastDiagnostic = "campaign save rejected: " + codec.diagnostic()
			return false
		if not state.validateAuthoritativeState(candidate)
			lastDiagnostic = "authoritative state rejected: " + state.diagnostic()
			return false
		if not state.reconstructRuntime(candidate)
			lastDiagnostic = "runtime reconstruction failed: " + state.diagnostic()
			return false
		state.activateAuthoritativeState(candidate)
		lastDiagnostic = ""
		return true



public class WarcraftCampaignSaveStorage implements CampaignSaveStorage
	gamecache cache
	string mission = "campaign"
	string lastDiagnostic = ""

	construct(string fileName)
		cache = compatInitGameCache(fileName)

	override function contains(string slotId) returns boolean
		return compatHaveStoredString(cache, mission, slotId)

	override function read(string slotId) returns string
		return compatGetStoredString(cache, mission, slotId)

	override function writeTransactional(string slotId, string payload) returns boolean
		let existed = contains(slotId)
		var previous = ""
		if existed
			previous = read(slotId)
		compatStoreString(cache, mission, slotId, payload)
		if compatSaveGameCache(cache)
			lastDiagnostic = ""
			return true
		if existed
			compatStoreString(cache, mission, slotId, previous)
		else
			compatFlushStoredString(cache, mission, slotId)
		if compatSaveGameCache(cache)
			lastDiagnostic = "game cache commit failed; previous slot restored"
		else
			lastDiagnostic = "game cache commit and rollback both failed"
		return false

	override function diagnostic() returns string
		return lastDiagnostic

