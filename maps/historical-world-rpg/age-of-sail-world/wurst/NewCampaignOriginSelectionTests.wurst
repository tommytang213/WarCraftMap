package NewCampaignOriginSelectionTests

import CommandRouter

class OriginPresentation implements OriginSelectionPresentation
	string heading = ""
	string rows = ""
	string error = ""
	boolean closed = false
	override function show(string heading, string rows, int page, int pages)
		this.heading = heading
		this.rows = rows
	override function showError(string message)
		error = message
	override function close()
		closed = true

@test function searchablePagedOriginSelectionCreatesImmutableHistory()
	let view = new OriginPresentation()
	let identity = new PlayerCampaignIdentity()
	let subject = new NewCampaignOriginController(2, view, identity)
	subject.add("england", "Kingdom of England", "europe_west", "europe_atlantic_isles", "london")
	subject.add("ming_empire", "Great Ming", "east_asia", "east_asia_china_north", "beijing")
	subject.add("songhai_kingdom", "Songhai Kingdom", "africa", "africa_sahara_sahel", "gao")
	subject.showPage(1)
	(view.rows.indexOf("Great Ming") >= 0).assertTrue()
	subject.showPage(2)
	(view.rows.indexOf("Songhai Kingdom") >= 0).assertTrue()
	subject.search("ming")
	(view.rows.indexOf("Great Ming") >= 0).assertTrue()
	subject.choose("ming_empire").assertEquals(true)
	identity.originPolityId.assertEquals("ming_empire")
	identity.currentAllegiancePolityId.assertEquals("ming_empire")
	identity.changeAllegiance("england").assertEquals(true)
	identity.originPolityId.assertEquals("ming_empire")
	identity.startingSettlementId.assertEquals("beijing")
	subject.choose("england").assertEquals(false)

@test function invalidOriginNeverFallsBack()
	let view = new OriginPresentation()
	let identity = new PlayerCampaignIdentity()
	let subject = new NewCampaignOriginController(8, view, identity)
	subject.add("england", "Kingdom of England", "europe_west", "europe_atlantic_isles", "london")
	subject.choose("missing_polity").assertEquals(false)
	identity.hasOrigin().assertEquals(false)
	view.error.assertEquals("That polity is not active in the authoritative 1450 world.")
