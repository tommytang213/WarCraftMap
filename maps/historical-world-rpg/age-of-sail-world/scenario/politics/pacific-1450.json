  "historicalEvidence": [
    {"id":"evidence_hawaii","scope":"hawaiian_chiefdoms","citation":"Patrick Vinton Kirch, A Shark Going Inland Is My Chief: The Island Civilization of Ancient Hawai‘i (2012).","note":"Supports separate island chiefdoms before Kamehameha-era unification and chiefly centers rather than modern boundaries."},
    {"id":"evidence_micronesia","scope":"micronesian_systems","citation":"Glenn Petersen, Traditional Micronesian Societies: Adaptation, Integration, and Political Organization (2009).","note":"Supports Chamorro, Palauan, Yapese, Caroline, Marshallese, and Kiribati community-scale political organization."},
    {"id":"evidence_saudeleur","scope":"pohnpei_saudeleur","citation":"William R. Ayres, Pohnpei's Position in Eastern Micronesian Prehistory, Micronesica 25 (1992).","note":"Supports Saudeleur authority centered on Nan Madol in the fifteenth-century baseline."},
    {"id":"evidence_melanesia","scope":"melanesian_communities","citation":"Patrick Vinton Kirch, On the Road of the Winds: An Archaeological History of the Pacific Islands before European Contact, revised edition (2017).","note":"Supports decentralized New Guinea, Bismarck, Solomon, Vanuatu, and Kanak political communities and inter-island exchange."},
    {"id":"evidence_tonga","scope":"tonga_samoa_fiji","citation":"Geoffrey Clark, The Tongan State: The Origins of a Pacific Polity (2016), and Patrick Vinton Kirch, The Evolution of the Polynesian Chiefdoms (1984).","note":"Supports the Tu‘i Tonga state, independent Samoan chiefly districts, and Fiji's linked but locally governed chiefdoms without imposing later confederacies."},
    {"id":"evidence_east_polynesia","scope":"east_polynesian_chiefdoms","citation":"Patrick Vinton Kirch, On the Road of the Winds, revised edition (2017), chapters on Ancestral Polynesian and late prehistoric societies.","note":"Supports Society, Marquesas, Tuamotu, and Rapa Nui political communities at island-group granularity."},
    {"id":"evidence_aotearoa","scope":"aotearoa_iwi_hapu","citation":"Atholl Anderson, Judith Binney, and Aroha Harris, Tangata Whenua: An Illustrated History (2014).","note":"Supports autonomous iwi and hapū networks in fifteenth-century Aotearoa, with no singular capital or pan-island sovereign."},
    {"id":"evidence_aleut","scope":"aleutian_communities","citation":"William S. Laughlin, Aleuts: Survivors of the Bering Land Bridge (1980).","note":"Supports autonomous Unangan island communities across the Aleutian chain."}
