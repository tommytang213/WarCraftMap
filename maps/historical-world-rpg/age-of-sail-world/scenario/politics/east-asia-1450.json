{
  "schemaVersion": 1,
  "id": "east_asia_political_baseline_1450",
  "campaignStartDate": "1450-01-01",
  "coverageRule": {
    "kind": "exclusive_authoritative_provinces",
    "exceptions": [
      "Pastoral, forest, and island communities without a single durable territorial government in 1450 are retained as preserved entities or autonomous frontier provinces rather than assigned fictitious borders.",
      "Fine Ming prefectural, Japanese shugo-domain, Tibetan estate, Jurchen federation, and Ainu community boundaries are compressed into historically meaningful playable regions while their important constituent powers remain authoritative metadata."
    ]
  },
  "historicalEvidence": [
    {
      "id": "evidence_ming_oirat_1450",
      "scope": "ming_oirat_crisis",
      "citation": "The Cambridge History of China, volume 7: The Ming Dynasty, 1368–1644, part 1 (Twitchett and Mote, eds.), chapters on the Zhengtong reign and the Tumu Crisis.",
      "note": "Supports Ming administration, the Oirat ascendancy, and the still-unresolved Ming-Oirat conflict on 1 January 1450 without presuming its later settlement."
    },
    {
      "id": "evidence_mongolia_frontier",
      "scope": "mongolia_jurchen_hami",
      "citation": "The Cambridge History of Inner Asia: The Chinggisid Age (Di Cosmo, Frank, and Golden, eds.), late medieval Mongolia and Ming frontier chapters.",
      "note": "Supports separate Oirat and eastern Mongol authority, the Hami tributary frontier, and distinct Jurchen groupings."
    },
    {
      "id": "evidence_tibet",
      "scope": "tibetan_polities",
      "citation": "Luciano Petech, Central Tibet and the Mongols: The Yüan-Sa-skya Period of Tibetan History (1990), with later chronology from The History of Tibet, volume 2 (McKay, ed.).",
      "note": "Supports the Phagmodrupa polity, rising Rinpungpa autonomy, and preservation of Guge and monastic powers without modern boundaries."
    },
    {
      "id": "evidence_joseon",
      "scope": "joseon_korea",
      "citation": "The Cambridge History of Korea, volume 2: The Chosŏn Dynasty, 1392–1910 (Lee and de Bary, eds.), early Chosŏn institutions and frontier chapters.",
      "note": "Supports Joseon provincial granularity, the Ming tributary relationship, Jeju, and the northern frontier in 1450."
    },
    {
      "id": "evidence_japan",
      "scope": "muromachi_japan",
      "citation": "The Cambridge History of Japan, volume 3: Medieval Japan (Yamamura, ed.), Muromachi bakufu and provincial governance chapters.",
      "note": "Supports Ashikaga legal authority alongside powerful shugo, the Ryukyu kingdom, and the absence of a falsely unified modern administrative geography."
    },
    {
      "id": "evidence_ryukyu",
      "scope": "ryukyu_ming_trade",
      "citation": "George H. Kerr, Okinawa: The History of an Island People, revised edition (2000), early Shō dynasty chapters.",
      "note": "Supports independent Ryukyuan kingship, Shuri as capital, and tributary trade with Ming China."
    },
    {
      "id": "evidence_ainu_northeast",
      "scope": "ainu_sakhalin_frontier",
      "citation": "Brett L. Walker, The Conquest of Ainu Lands (2001), chapters on medieval Ezo and northern exchange networks.",
      "note": "Supports preserving autonomous Ainu communities in Ezo and Sakhalin rather than retrojecting later Japanese or Russian borders."
    }
  ],
