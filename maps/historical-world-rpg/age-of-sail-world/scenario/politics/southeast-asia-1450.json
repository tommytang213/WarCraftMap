  "historicalEvidence": [
    {"id":"evidence_mainland_1450","scope":"mainland_mandalas","citation":"The Cambridge History of Southeast Asia, volume 1, part 1 (Tarling, ed.), chapters on the classical mainland states.","note":"Supports the Ava, Hanthawaddy, Arakan, Lan Na, Lan Xang, Ayutthaya, Khmer, Dai Viet, and Champa baseline and the use of mandala-era divisions."},
    {"id":"evidence_maritime_1450","scope":"maritime_trade_states","citation":"The Cambridge History of Southeast Asia, volume 1, part 1 (Tarling, ed.), chapters on the maritime states from c. 1400.","note":"Supports Malacca, the Sumatran successor states, Java, Sunda, Bali, Brunei, and the eastern archipelago baseline."},
    {"id":"evidence_philippines_1450","scope":"philippine_port_polities","citation":"William Henry Scott, Barangay: Sixteenth-Century Philippine Culture and Society (1994), used cautiously for late precolonial political forms.","note":"Supports preserving the Manila-Tondo, Cebu, Butuan, Maguindanao, and Sulu port-polity traditions without projecting later colonial boundaries."},
    {"id":"evidence_burma_1450","scope":"ava_hanthawaddy_toungoo","citation":"G. E. Harvey, History of Burma (1925), Ava and Pegu dynastic chronology.","note":"Supports Toungoo's subordinate relationship to Ava and the distinct Arakanese and Mon realms."},
    {"id":"evidence_vietnam_champa_1450","scope":"dai_viet_champa","citation":"Keith W. Taylor, A History of the Vietnamese (2013), Later Le and fifteenth-century Champa chapters.","note":"Supports separate Dai Viet and Champa authority in 1450 without hardcoding the conquest of 1471."},
    {"id":"evidence_java_1450","scope":"java_sunda_bali","citation":"M. C. Ricklefs, A History of Modern Indonesia since c. 1200, third edition (2001), fifteenth-century Java chapters.","note":"Supports Majapahit, Sunda, and Bali and preserves the north-coast ports whose later expansion is not predetermined."},
    {"id":"evidence_spice_islands_1450","scope":"moluccas_sulawesi","citation":"Leonard Y. Andaya, The World of Maluku (1993), early political and trading networks.","note":"Supports distinct Ternate and Tidore and preservation of Bacan, Jailolo, and neighboring maritime communities."}
  ],
