{
  "formatVersion": 2,
  "projectRoot": ".",
  "sourceMap": "map/AgeOfSailWorld.w3x",
  "sourceManifest": "map/map-source.json",
  "wurstSource": "wurst",
  "scenario": {
    "data": "scenario/world/world.json",
    "validator": "../_shared/tooling/validate_world.py",
    "wurstPackage": "ScenarioData",
    "custom2d": {
      "source": "scenario/visuals/custom-2d-assets.json",
      "builder": "tooling/build_custom_2d.py"
    },
    "regionalTerrain": [
      {"id": "europe", "source": "scenario/terrain/europe.json"},
      {"id": "africa", "source": "scenario/terrain/africa.json"},
      {"id": "middle_east_india", "source": "scenario/terrain/middle-east-india.json"},
      {"id": "southeast_asia", "source": "scenario/terrain/southeast-asia.json"},
      {"id": "east_asia", "source": "scenario/terrain/east-asia.json"},
      {"id": "americas_caribbean", "source": "scenario/terrain/americas-caribbean.json"},
      {"id": "pacific", "source": "scenario/terrain/pacific.json"}
    ]
  },
  "outputDirectory": "_build/release",
  "release": {
    "fileName": "AgeOfSailWorld",
    "metadata": {
      "name": "Age of Sail: The World",
      "author": "WarCraftMap Project",
      "scriptBackend": "lua",
      "wc3Patch": "v3.0"
    },
    "bootstrapMarkers": [
      "Age of Sail: The World - development bootstrap loaded.",
      "WC3Compatibility: required Warcraft III",
      "v3.0"
    ]
  }
}
