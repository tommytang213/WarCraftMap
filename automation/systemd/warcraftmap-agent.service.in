[Unit]
Description=Low-priority WarCraftMap autonomous development worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
ExecStart=@REPO_ROOT@/automation/run_agent.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=19
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=warcraftmap-agent
ReadWritePaths=%h/.local/state/warcraftmap-agent @REPO_ROOT@
TimeoutStartSec=55min
