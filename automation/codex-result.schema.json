{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "question"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "complete",
        "needs_design",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "question": {
      "type": "string"
    }
  }
}
