# Values are parsed as data, not executed as shell.
WARCRAFTMAP_AGENT_MODEL=gpt-5.6-sol

# Primary budget: actual Codex token telemetry from codex exec --json.
WARCRAFTMAP_AGENT_MAX_DAILY_TOKENS=100000000
WARCRAFTMAP_AGENT_MAX_WEEKLY_TOKENS=500000000

# Emergency failsafe if token telemetry is missing or unexpectedly cheap.
WARCRAFTMAP_AGENT_MAX_DAILY_RUNS=10
WARCRAFTMAP_AGENT_MAX_WEEKLY_RUNS=50

WARCRAFTMAP_AGENT_TIMEOUT_MINUTES=45
WARCRAFTMAP_AGENT_MAX_ATTEMPTS_PER_ISSUE=3
WARCRAFTMAP_AGENT_ISSUE_LIMIT=100
WARCRAFTMAP_AGENT_CHECKS_COMMAND=./automation/run_checks.sh
# WARCRAFTMAP_AGENT_STATE_DIR=~/.local/state/warcraftmap-agent
